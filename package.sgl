;;; Crash The Stack - cyberpunk takes on the classics, in Sigil.
;;;
;;; One source tree, two targets. The rules live under (crash stack ...) and
;;; import nothing from graphics or windowing (test/test-imports.sgl asserts
;;; the allowlist); (crash render) draws with sigil-graphics on both targets;
;;; (crash main) is a two-line seam that picks the shell: (crash shell native) over
;;; sigil-desktop for the dev/release configs, (crash shell web) over the browser's
;;; requestAnimationFrame for the web config.
;;;
;;;   scripts/dev sigil build                            native
;;;   scripts/dev sigil build --config web               browser (manifest has binaryen)
;;;                                                      (and the tracker's own wasm into build/web/tracker/)
;;;   scripts/serve-web                                  host build/web on wg0

(import (sigil process) (sigil string) (sigil time) (sigil math) (sigil fs))

(define sigil-repo "codeberg:sigil/sigil")
(define app-repo "codeberg:sigil/sigil-desktop")
(define graphics-repo "codeberg:sigil/sigil-graphics")
(define audio-repo "codeberg:sigil/sigil-audio")
(define motif-repo "codeberg:sigil/motif")

;; The web build's version, for the service worker and the page: the git
;; commit, plus the build's second when the tree was dirty so two dirty
;; builds of one commit are still two versions (ruling D14: the installed
;; PWA prompts when a NEW version is waiting, so a version must change
;; whenever the files might have).
(define (web-version)
  (let* ((sha (string-trim (process-output->string "git" "rev-parse" "--short=12" "HEAD")))
         (dirty (string-trim (process-output->string "git" "status" "--porcelain" "--untracked-files=no")))
         (sha (if (string=? sha "") "unversioned" sha)))
    (if (string=? dirty "")
        sha
        (string-append sha "-dirty-" (number->string (exact (floor (current-second))))))))

;; The last step: assets/refs/ (raw generator outputs and prompts, P3) is
;; provenance evidence the manifest does not cover and the page never
;; fetches; it is not shipped, so it leaves the build's assets/ again.
;; Last: a drop placed right after link-assets ran before the copy landed
;; (measured 2026-09-18), so it goes after everything.
(define (drop-refs ctx)
  (let ((refs (path-join (context-workspace-dir ctx)
                         (config-output-dir (context-config ctx))
                         "assets/refs")))
    (when (directory-exists? refs)
      (process-run "rm" "-rf" refs)
      (display "  dropped ") (display refs) (newline))
    ctx))

;; --- the tracker's wasm (David, 2026-09-21) --------------------------------

;; Before the tracker link: the package entry becomes (crash tracker main),
;; so link-web-application's "modules reachable from the entry" is the
;; tracker family, motif and the sigil runtime and nothing of the game.
;; The context and the package are immutable records; a copy with the one
;; field changed is the whole step.
(define (tracker-entry ctx)
  (context ctx package: (package (context-package ctx) entry: '(crash tracker main))))

;; The tracker's page: tracker.template.html with the loader's mount and
;; script tag where the marker is (the html: 'manual mode leaves the page
;; to us; the template file name is fixed to index.template.html otherwise).
(define (tracker-page ctx)
  (let* ((out (path-join (config-output-dir (context-config ctx)) "tracker"))
         (tmpl (read-file-string "tracker.template.html"))
         (mount "<div id=\"status\"></div>\n    <script src=\"assets/sigil-web-app.js\" data-wasm=\"crash-tracker\" data-base=\"\" data-mount=\"status\"></script>")
         (page (string-replace (string-replace tmpl "<!--sigil:app-->" mount) "__VERSION__" (web-version))))
    ;; the link copied every asset artifact under tracker/assets/ too (the
    ;; game's textures, refs, tunes): only the loader's scripts belong here;
    ;; the tunes are fetched from ../assets/tunes/
    (process-run "sh" "-c" (string-append "cd " out "/assets && find . -mindepth 1 -maxdepth 1 ! -name 'sigil-*.js' -exec rm -rf {} +"))
    ;; styles.css stays (the link copies it): the game page, landed here by
    ;; the service worker, speculatively fetches tracker/styles.css before
    ;; its guard script runs, and a copy answers 200 instead of a 404
    (process-run "rm" "-f" (path-join out "asyncify-onlylist.generated.txt"))
    (write-file-string (path-join out "index.html") page)
    (display "  tracker page ") (display (path-join out "index.html")) (newline)
    ctx))

;; After link-web-application on a wasm target: copy web/sw.js into the
;; build with its version stamped, web/_headers as it is, and stamp the
;; page's __VERSION__ too.
(define (stamp-web-version ctx)
  (let* ((out (config-output-dir (context-config ctx)))
         (version (web-version))
         (stamp (lambda (text)
                  (string-replace text "__VERSION__" version)))
         (sw (read-file-string "web/sw.js"))
         (page-path (path-join out "index.html"))
         (page (read-file-string page-path)))
    (write-file-string (path-join out "sw.js") (stamp sw))
    ;; the Pages edge headers (COOP/COEP for the audio worklet), copied
    ;; as they are; sigil serve ignores the file and sw.js does the same
    ;; job on the dev host from the second visit on
    (write-file-string (path-join out "_headers") (read-file-string "web/_headers"))
    (write-file-string page-path (stamp page))
    (display "  web version ") (display version) (newline)
    ctx))

(package
  name: "crash-the-stack"
  version: "0.0.1"
  sigil: "0.22.5"   ; the tail-call rooting fix (t-409696, the phantom) and the shadow-stack fix; 0.22.4 was the WebAudio bridge that drains off the main thread without cross-origin isolation (M1's cue starvation on a phone)
  description: "Cyberpunk takes on the classics: Mahjongg solitaire, Klondike, and more"
  license: "GPL-3.0-or-later"
  authors: (list "David Wilson <david@daviwil.com>")

  entry: '(crash main)
  bundle-name: "crash-the-stack"

  configs: (list
    (config
      name: 'dev
      output-dir: "build/dev"
      debug?: #t
      optimize: 0
      bundle?: #t)
    (config
      name: 'release
      output-dir: "build/release"
      debug?: #f
      optimize: 2
      ;; A fully native binary, as cinder-cadence ships; without backend: 'native
      ;; the release bundles a bytecode image the runtime cannot locate the entry
      ;; module for when run directly.
      backend: 'native
      bundle?: #t)
    ;; The browser build: wasm32-wasi through zig, native codegen (no
    ;; coroutines, no eval-by-name: the shell drives one frame per
    ;; requestAnimationFrame dispatch). Shape from
    ;; cinder-cadence/examples/web-game/package.sgl.
    (config
      name: 'web
      output-dir: "build/web"
      toolchain: 'zig
      target: "wasm32-wasi"
      backend: 'native
      debug?: #f
      optimize: 2
      bundle?: #t
      features: '(web wasm graphics))
    ;; Windows x86_64 through zig (P4b, D37: a Windows artifact every
    ;; release). The release config's shape (native backend, optimize 2,
    ;; the bundle) on the x86_64-windows-gnu target; the same config name
    ;; sigil-desktop, sigil-graphics and sigil-audio carry, so the
    ;; dependency gates below match it. Built from Linux:
    ;;   scripts/dev sigil build --config windows-amd64
    ;; and run under Wine or on Windows; docs/windows/README.md.
    (config
      name: 'windows-amd64
      output-dir: "build/windows-amd64"
      toolchain: 'zig
      target: "x86_64-windows-gnu"
      static?: #t
      backend: 'native
      debug?: #f
      optimize: 2
      bundle?: #t
      ;; A GUI-subsystem program: no console window beside the game when
      ;; Explorer starts it (David, 2026-09-22); crash-native.c attaches
      ;; to a parent console so a launch from a terminal still prints.
      ;; A config's link-flags reach every bundle of the config, and every
      ;; bundle links every native archive, so motif.exe (a CLI, bundled
      ;; beside the game because motif declares an entry) is GUI too; it
      ;; is not part of the artifact (docs/windows/README.md).
      link-flags: '("-Wl,--subsystem,windows")
      ;; The exe's icon and its Properties -> Details strings (sigil 0.22.5:
      ;; the .rc is written from this package's metadata and compiled with
      ;; the toolchain's zig rc). assets/src/windows/crash-the-stack.ico
      ;; (under src/ because it is a build input the exe embeds, not a file
      ;; the game reads at runtime) holds 16, 32, 48 and 256, all exact
      ;; multiples of assets/src/icon.txt's
      ;; 16x16 art, so Explorer never resamples it. Like link-flags, these
      ;; reach every bundle of the config: motif.exe carries the same icon
      ;; and the same ProductName. It is not part of the artifact (the
      ;; Windows archive ships crash-the-stack.exe alone,
      ;; scripts/release-archives), so nothing a player sees is wrong.
      icon: "assets/src/windows/crash-the-stack.ico"
      product-name: "Crash The Stack"
      features: '(release cross windows)))

  dependencies: (list
    ;; Windowing and input (sigil-desktop, GLFW: a Wayland or X11 window,
    ;; picked at startup). Native only: its C cannot build
    ;; for wasm32-wasi, so it is gated to the native configs.
    (from-git url: app-repo version: "^0.10.2" configs: '(dev release windows-amd64))
    ;; Drawing, both targets (its own web config excludes sigil-desktop the same way).
    (from-git url: graphics-repo version: "^0.11.4")
    ;; Web only: the wasm runtime (the generic loader sigil-web-app.js and
    ;; the sigil_wasm_* entry ABI) and the raw-WebGL2 binding sigil-graphics'
    ;; sokol backend draws through, plus its (sigil browser gles3) app shell.
    (from-git url: sigil-repo package: "sigil-wasm-runtime" version: ">=0.22.5" configs: '(web))
    (from-git url: sigil-repo package: "sigil-wasm-gles3" version: ">=0.22.5" configs: '(web))
    ;; Web only: localStorage for the saved board ((crash store)).
    (from-git url: sigil-repo package: "sigil-browser" version: ">=0.22.5" configs: '(web))
    ;; Sound (P3, ruling D9: sigil-audio at its current tag). The facade
    ;; (sigil audio sink) is sigil-audio's on both targets; its C (miniaudio,
    ;; vorbis) is skipped on wasm by its own package, and the web
    ;; backend is the monorepo's WebAudio bridge.
    (from-git url: audio-repo version: "^0.12.2")
    ;; The tracker (P3b, (crash tracker ...)): the .cts tune model and the
    ;; tick engine and live player on both targets. Motif 0.6.6 includes
    ;; live section marks and preserves instrument gain independently of velocity.
    (from-git url: motif-repo version: "^0.6.6")
    (from-git url: sigil-repo package: "sigil-wasm-audio" version: ">=0.22.5" configs: '(web)))

  ;; Built only when tests are built (sigil 0.22.2), so a plain
  ;; `build --config web` no longer compiles the runner's closure for wasm.
  dev-dependencies: (list
    (from-git url: sigil-repo package: "sigil-test" version: ">=0.22.5")
    (from-git url: sigil-repo package: "sigil-test-runner" version: ">=0.22.5"))


  ;; The game's own C ((crash native): the music mixer's inner loop and
  ;; the OGG decoder over sigil-audio's stb_vorbis, P4) is linked into the custom runtime on every
  ;; target through this library entry (sigil-build collects native-init
  ;; from the root package too) and compiled by the build task below.
  libraries: (list
    (library
      name: 'crash-native
      c-sources: '("src/c/crash-native.c")
      c-include-dirs: '()
      native-init: "sigil__init_crash_native_module"))

  ;; One build task for every config; the steps that differ by target
  ;; are lambdas over the context (sigil-build threads ctx through the
  ;; steps). Native: the game's C, the modules, the docs, the assets
  ;; (sigil-build's default task plus the C). Web: the same C (the decoder
  ;; answers #f under __wasm__: the page decodes there) plus sigil-audio's
  ;; native-init stub, then the link and the version stamp.
  tasks: (list
    (task
      name: 'build
      description: "Compile the game (and, on the web config, link the browser app)"
      steps: (list
        (lambda (ctx)
          (if (memq (target-os ctx) '(wasm wasi))
              ;; sigil-audio's native-init has no C behind it on wasm (its package
              ;; skips miniaudio there), and the generated register below calls
              ;; it anyway: an empty definition, web config only.
              ((compile-c-sources sources: (list "src/c/wasm-audio-stub.c" "src/c/crash-native.c")
                                  flags: (with-sigil-c-flags '("-std=c99" "-Wno-unused-function"))) ctx)
              ((compile-c-sources sources: (list "src/c/crash-native.c")
                                  flags: (with-sigil-c-flags (quote ("-std=c99" "-D_GNU_SOURCE")))) ctx)))
        ;; the objects into an archive the custom runtime links (a native package's shape)
        (create-static-library name: "crash-the-stack")
        (compile-sigil-modules sources: "src/**/*.sgl")
        (copy-package-docs)
        ;; the whole assets/ tree -> build/<config>/assets/ (license, manifest
        ;; and the art sources included), so the web page fetches every
        ;; texture from assets/ next to the wasm; then the generator
        ;; references come back out: provenance, not shipped.
        (link-assets)
        (lambda (ctx)
          (if (memq (target-os ctx) '(wasm wasi))
              ;; link-web-application generates the sigil_wasm_app_register that
              ;; calls sigil-graphics' native-init (sigil 0.22.2), so the sokol C
              ;; is linked in and the wasm imports `gl`. Then the tracker's wasm
              ;; (David, 2026-09-21): a second link from the same compiled
              ;; modules with (crash tracker main) as the entry
              ;; (link-web-application takes "the modules reachable from the
              ;; package entry"), its own page, into build/web/tracker/ where
              ;; /tracker/ serves it. The same task and config because a
              ;; dependency's config is matched by NAME (a second config built
              ;; the deps' native arms) and `sigil run -t` runs a task without
              ;; the build context a link needs. No assets of its own: the
              ;; tunes are the game's.
              (drop-refs
                (tracker-page
                  ((link-web-application name: "crash-tracker" html: 'manual output-dir: "build/web/tracker")
                   (tracker-entry
                     (stamp-web-version
                       ((link-web-application name: "crash-the-stack" html-mount-id: "status") ctx))))))
              ctx)))))   ; native: the bundle wants every linked asset in place, refs included
)
