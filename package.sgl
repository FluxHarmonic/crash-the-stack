;;; Crash The Stack - cyberpunk takes on the classics, in Sigil.
;;;
;;; One source tree, two targets. The rules live under (crash stack ...) and
;;; import nothing from graphics or windowing (test/test-imports.sgl asserts
;;; the allowlist); (crash render) draws with sigil-graphics on both targets;
;;; (crash main) is a two-line seam that picks the shell: (crash shell native) over
;;; sigil-app for the dev/release configs, (crash shell web) over the browser's
;;; requestAnimationFrame for the web config.
;;;
;;;   scripts/dev sigil build                            native
;;;   scripts/dev sigil build --config web               browser (manifest has binaryen)
;;;   scripts/serve-web                                  host build/web on wg0

(import (sigil process) (sigil string) (sigil time) (sigil math) (sigil fs))

(define sigil-repo "codeberg:sigil/sigil")
(define app-repo "codeberg:sigil/sigil-app")
(define graphics-repo "codeberg:sigil/sigil-graphics")
(define audio-repo "codeberg:sigil/sigil-audio")

;; The web build's version, for the service worker and the page: the git
;; commit, plus the build's second when the tree was dirty so two dirty
;; builds of one commit are still two versions (ruling D14: the installed
;; PWA prompts when a NEW version is waiting, so a version must change
;; whenever the files might have).
(define (web-version)
  (let* ((sha (string-trim (process-output->string "git" "rev-parse" "--short=12" "HEAD")))
         (dirty (string-trim (process-output->string "git" "status" "--porcelain" "--untracked-files=no")))
         (sha (if (string=? sha "") "unversioned" sha)))
    (if (string=? dirty "")
        sha
        (string-append sha "-dirty-" (number->string (exact (floor (current-second))))))))

;; The last step: assets/refs/ (raw generator outputs and prompts, P3) is
;; provenance evidence the manifest does not cover and the page never
;; fetches; it is not shipped, so it leaves the build's assets/ again.
;; Last: a drop placed right after link-assets ran before the copy landed
;; (measured 2026-09-18), so it goes after everything.
(define (drop-refs ctx)
  (let ((refs (path-join (context-workspace-dir ctx)
                         (config-output-dir (context-config ctx))
                         "assets/refs")))
    (when (directory-exists? refs)
      (process-run "rm" "-rf" refs)
      (display "  dropped ") (display refs) (newline))
    ctx))

;; After link-web-application on a wasm target: copy web/sw.js into the
;; build with its version stamped, web/_headers as it is, and stamp the
;; page's __VERSION__ too.
(define (stamp-web-version ctx)
  (let* ((out (config-output-dir (context-config ctx)))
         (version (web-version))
         (stamp (lambda (text)
                  (string-replace text "__VERSION__" version)))
         (sw (read-file-string "web/sw.js"))
         (page-path (path-join out "index.html"))
         (page (read-file-string page-path)))
    (write-file-string (path-join out "sw.js") (stamp sw))
    ;; the Pages edge headers (COOP/COEP for the audio worklet), copied
    ;; as they are; sigil serve ignores the file and sw.js does the same
    ;; job on the dev host from the second visit on
    (write-file-string (path-join out "_headers") (read-file-string "web/_headers"))
    (write-file-string page-path (stamp page))
    (display "  web version ") (display version) (newline)
    ctx))

(package
  name: "crash-the-stack"
  version: "0.0.1"
  sigil: "0.22"
  description: "Cyberpunk takes on the classics: Mahjongg solitaire, Klondike, and more"
  license: "GPL-3.0-or-later"
  authors: (list "David Wilson <david@daviwil.com>")

  entry: '(crash main)
  bundle-name: "crash-the-stack"

  configs: (list
    (config
      name: 'dev
      output-dir: "build/dev"
      debug?: #t
      optimize: 0
      bundle?: #t)
    (config
      name: 'release
      output-dir: "build/release"
      debug?: #f
      optimize: 2
      ;; A fully native binary, as cinder-cadence ships; without backend: 'native
      ;; the release bundles a bytecode image the runtime cannot locate the entry
      ;; module for when run directly.
      backend: 'native
      bundle?: #t)
    ;; The browser build: wasm32-wasi through zig, native codegen (no
    ;; coroutines, no eval-by-name: the shell drives one frame per
    ;; requestAnimationFrame dispatch). Shape from
    ;; cinder-cadence/examples/web-game/package.sgl.
    (config
      name: 'web
      output-dir: "build/web"
      toolchain: 'zig
      target: "wasm32-wasi"
      backend: 'native
      debug?: #f
      optimize: 2
      bundle?: #t
      features: '(web wasm graphics)))

  dependencies: (list
    ;; Windowing and input. Native only: its C (sokol_app + X11) cannot build
    ;; for wasm32-wasi, so it is gated to the native configs.
    (from-git url: app-repo version: "^0.9.0" configs: '(dev release))
    ;; Drawing, both targets (its own web config excludes sigil-app the same way).
    (from-git url: graphics-repo version: "^0.11.2")
    ;; Web only: the wasm runtime (the generic loader sigil-web-app.js and
    ;; the sigil_wasm_* entry ABI) and the raw-WebGL2 binding sigil-graphics'
    ;; sokol backend draws through, plus its (sigil browser gles3) app shell.
    (from-git url: sigil-repo package: "sigil-wasm-runtime" version: ">=0.22" configs: '(web))
    (from-git url: sigil-repo package: "sigil-wasm-gles3" version: ">=0.22" configs: '(web))
    ;; Web only: localStorage for the saved board ((crash store)).
    (from-git url: sigil-repo package: "sigil-browser" version: ">=0.22" configs: '(web))
    ;; Sound (P3, ruling D9: sigil-audio at its current tag). The facade
    ;; (sigil audio sink) is sigil-audio's on both targets; its C (sokol
    ;; audio, vorbis) is skipped on wasm by its own package, and the web
    ;; backend is the monorepo's WebAudio bridge.
    (from-git url: audio-repo version: "^0.12.1")
    (from-git url: sigil-repo package: "sigil-wasm-audio" version: ">=0.22" configs: '(web)))

  ;; Built only when tests are built (sigil 0.22.2), so a plain
  ;; `build --config web` no longer compiles the runner's closure for wasm.
  dev-dependencies: (list
    (from-git url: sigil-repo package: "sigil-test" version: ">=0.22")
    (from-git url: sigil-repo package: "sigil-test-runner" version: ">=0.22"))

  ;; The web build's task. The native configs take sigil-build's default
  ;; build task, which is the same first three steps (a task's configs:
  ;; gate is honored since sigil 0.22.2).
  tasks: (list
    (task
      name: 'build
      configs: '(web)
      description: "Compile the game and link the browser app"
      steps: (list
        (compile-sigil-modules sources: "src/**/*.sgl")
        (copy-package-docs)
        ;; the whole assets/ tree -> build/web/assets/ (license, manifest
        ;; and the tile sources included), so the web page fetches the test
        ;; tile from assets/test-tile.png next to the wasm; then the
        ;; generator references come back out: provenance, not shipped.
        (link-assets)
        ;; link-web-application generates the sigil_wasm_app_register that
        ;; calls sigil-graphics' native-init (sigil 0.22.2), so the sokol C
        ;; is linked in and the wasm imports `gl`.
        (link-web-application name: "crash-the-stack" html-mount-id: "status")
        stamp-web-version
        drop-refs))))
