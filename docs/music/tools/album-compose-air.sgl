#!/usr/bin/env sigil
;;; Finite album frames for Blind Spot and Sector Drift.
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define (source-sections source ids label offset)
  (map (lambda (id)
         (list (str label (+ id offset)) (pattern source id)))
       ids))

(define (blind-spot source)
  (let ((intro
          (phrase 4
            '((0 7 "D-3" 10 11 40)
              (8 5 "D-3" 6 15 14)
              (40 6 "A-3" 8 14 4)
              (64 4 "D-2" 4 24 9)
              (88 6 "F-4" 8 14 4)
              (96 1 "D-2" 1 28 5)
              (100 3 "C-7" 3 9 2)
              (104 6 "E-4" 8 13 4)
              (112 2 "C-5" 2 14 2))))
        (ending
          (phrase 4
            '((0 1 "D-2" 1 29 5)
              (0 4 "D-2" 4 25 9)
              (0 7 "D-3" 10 10 40)
              (8 5 "D-3" 6 15 14)
              (8 6 "F-4" 8 15 4)
              (16 2 "C-5" 2 13 2)
              (20 3 "C-7" 3 8 2)
              (36 4 "D-2" 4 22 8)
              (48 6 "E-4" 8 13 4)
              (64 4 "D-2" 4 18 9)
              (72 5 "D-3" 6 12 14)
              (88 6 "D-4" 8 12 6)))))
    (append
      (list (list "Room edge / three-note signal" intro))
      (source-sections source '(0 1 2 3) "Calm watch " 1)
      (list (list "Quiet crossing" (pattern source 4)))
      (source-sections source '(5 6 7 8) "Watchful pulse " -4)
      (list (list "Footsteps recede / D-minor withdrawal" ending)
            (list "Released room tail" (empty-pattern 2))))))

(define (sector-drift source)
  (let* ((intro
           (phrase 4
             '((0 4 "G-1" 4 26 9)
               (4 5 "G-3" 6 18 16)
               (4 6 "D-4" 8 19 7)
               (16 6 "F-4" 8 16 7)
               (24 6 "D-4" 8 16 7)
               (40 6 "A#3" 8 19 11)
               (56 6 "A-3" 8 16 6)
               (64 1 "C-2" 1 35 5)
               (64 4 "G-1" 4 28 9)
               (68 3 "C-8" 3 12 2)
               (72 2 "F#4" 2 25 3)
               (80 7 "G-3" 9 13 10)
               (84 3 "C-8" 3 12 2)
               (96 1 "C-2" 1 35 5)
               (96 4 "D-2" 4 24 7)
               (100 3 "C-8" 3 12 2)
               (104 2 "F#4" 2 25 3)
               (112 7 "D-4" 9 12 10)
               (116 3 "C-8" 3 11 2))))
         (break
           (add-notes
             (set-field
               (transform (pattern source 0)
                 (lambda (row cell)
                   (and (< row 128)
                        (not (member (car cell) '(5 6 7)))
                        (level cell
                               (if (member (car cell) '(1 2 3)) 0.8 1)))))
               rows:
               128)
             '((72 7 "G-4" 9 13 8)
               (88 7 "D#4" 9 14 8)
               (104 7 "D-4" 9 13 8)
               (120 7 "C-4" 9 12 6))))
         (reprise
           (transform (pattern source 0)
             (lambda (row cell)
               (level cell
                      (if (member (car cell) '(1 2 3 8)) 0.75 0.95)))))
         (ending
           (phrase 4
             '((0 1 "C-2" 1 31 5)
               (0 4 "G-1" 4 27 9)
               (4 5 "G-3" 6 18 16)
               (4 6 "D-4" 8 18 7)
               (8 2 "F#4" 2 21 3)
               (20 3 "C-8" 3 10 2)
               (32 4 "G-1" 4 23 7)
               (40 6 "A#3" 8 16 9)
               (56 6 "A-3" 8 14 6)
               (64 4 "G-1" 4 21 9)
               (68 5 "G-2" 6 15 18)
               (80 6 "G-3" 8 15 10)
               (104 7 "D-4" 9 11 12)))))
    (append
      (list (list "Tine signal / dusty groove emerges" intro))
      (source-sections source '(0 1 2 3) "Reflective theme " 1)
      (list (list "Accepted transition" (pattern source 4)))
      (source-sections source '(5 6) "Focused drift " -4)
      (list (list "Bass and dust / descending bell response" break))
      (source-sections source '(7 8) "Focused return " -6)
      (list (list "Complete calm theme reprise" reprise)
            (list "G-minor landing" ending)
            (list "Released room tail" (empty-pattern 2))))))

(cli "album-compose-air" (script-args) '()
  (lambda (options)
    (let ((motif (require-tool (option-ref options 'motif)))
          (output (option-ref options 'output)))
      (check (not (option-ref options 'tracks))
             "This composer produces both air/dust tracks")
      (each spec (list (list "blind-spot" "Blind Spot" blind-spot)
                       (list "sector-drift" "Sector Drift" sector-drift))
        (let* ((slug (car spec))
               (reference (str "assets/tunes/" slug ".cts"))
               (source (read-score (path (root) reference))))
          (write-album
            motif
            output
            slug
            (cadr spec)
            source
            ((caddr spec) source)
            (list reference)
            "Album air/dust pair I: finite entrance, complete calm and focused phrases, composed withdrawal. Accepted instrument bank and bus remain unchanged; game sources are protected."
            "Original onset grid retained with explicit final gates and two tail bars. Section map accompanies this score. Arranged with album-compose-air.sgl."))))))
