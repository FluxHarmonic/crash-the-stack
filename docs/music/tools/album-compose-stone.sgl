#!/usr/bin/env sigil
;;; Finite mystery and pedal-led album arrangements.
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define (sections source ids label offset)
  (map (lambda (id)
         (list (str label (+ id offset)) (pattern source id)))
       ids))

(define (dead-sector source)
  (let ((intro
          (phrase 4
            '((0 4 "C#2" 4 25 9)
              (4 5 "C#3" 6 16 24)
              (8 6 "G#3" 8 19 5)
              (36 3 "G#5" 3 9 1)
              (48 6 "D-4" 8 17 5)
              (64 1 "C#2" 1 31 5)
              (64 4 "C#2" 4 27 9)
              (72 6 "C#4" 8 19 5)
              (84 3 "G#5" 3 9 1)
              (96 2 "C#4" 2 16 2)
              (104 6 "B-3" 8 16 5)
              (122 8 "C-5" 26 8 2))))
        (bridge
          (phrase 4
            '((4 5 "C#3" 7 13 24)
              (12 6 "D-4" 8 17 5)
              (36 3 "G#5" 3 8 1)
              (44 7 "C#4" 9 10 3)
              (64 4 "C#2" 4 25 9)
              (72 6 "C#4" 8 18 5)
              (90 8 "C-5" 26 8 2)
              (96 1 "C#2" 1 30 5)
              (96 4 "C#2" 4 25 7)
              (104 6 "G#3" 8 16 5)
              (116 3 "G#5" 3 9 1))))
        (ending
          (transform (pattern source 3)
            (lambda (row cell)
              (and (or (< row 128)
                       (not (member (car cell) '(1 2 3 8))))
                   (level cell
                          (cond
                            ((member (car cell) '(1 2 3 8)) 0.7)
                            ((= (car cell) 4) (if (< row 128) 0.85 0.65))
                            (else 0.9))))))))
    (append
      (list (list "First probe / sealed pulse emerges" intro))
      (sections source '(0 1) "Watchful theme " 1)
      (list (list "Suspended contact / pulse returns" bridge))
      (sections source '(2 3) "Calm return " -1)
      (list (list "Accepted quiet transition" (pattern source 4)))
      (sections source '(5 6 7 8) "Live sector " -4)
      (list (list "Probe reprise / low C-sharp withdrawal" ending)
            (list "Released room tail" (empty-pattern 2))))))

(define (obsidian-index source)
  (let ((intro
          (phrase 4
            '((0 4 "E-2" 4 25 24)
              (0 5 "E-3" 6 19 122)
              (0 8 "E-3" 16 18 122)
              (32 4 "E-2" 4 25 24)
              (64 1 "E-2" 1 28 5)
              (64 4 "E-2" 4 27 24)
              (64 6 "E-3" 8 20 7)
              (76 6 "B-3" 8 18 17)
              (88 2 "B-2" 2 16 3)
              (96 4 "E-2" 4 25 24)
              (104 6 "A-3" 8 19 17)
              (108 3 "C-6" 3 8 2))))
        (reprise
          (transform (pattern source 0)
            (lambda (row cell)
              (and (or (< row 128)
                       (not (member (car cell) '(1 2 3))))
                   (level cell
                          (if (member (car cell) '(1 2 3)) 0.7 1))))))
        (ending
          (phrase 4
            '((0 1 "E-2" 1 26 5)
              (0 4 "E-2" 4 25 24)
              (0 5 "E-3" 6 19 104)
              (0 8 "E-3" 16 18 104)
              (0 6 "B-3" 8 19 12)
              (16 7 "B-2" 9 11 8)
              (24 2 "B-2" 2 14 3)
              (32 1 "E-2" 1 23 5)
              (32 4 "E-2" 4 23 24)
              (32 6 "G-3" 8 18 12)
              (56 6 "F#3" 8 16 7)
              (64 4 "E-2" 4 21 40)
              (80 6 "E-3" 8 18 16)
              (96 7 "E-3" 9 10 8)))))
    (append
      (list (list "E pedal and wide veil / glass emerges" intro))
      (sections source '(0 1 2 3) "Unfolding glass theme " 1)
      (list (list "Accepted suspended transition" (pattern source 4)))
      (sections source '(5 6 7 8) "Focused glass and lower answers " -4)
      (list (list "Complete opening theme / accompaniment thins" reprise)
            (list "E-minor landing / pedal lingers" ending)
            (list "Released room tail" (empty-pattern 2))))))

(cli "album-compose-stone" (script-args) '()
  (lambda (options)
    (let ((motif (require-tool (option-ref options 'motif)))
          (output (option-ref options 'output)))
      (check (not (option-ref options 'tracks))
             "This composer produces both mystery/pedal tracks")
      (each spec (list (list "dead-sector" "Dead Sector" dead-sector)
                       (list "obsidian-index" "Obsidian Index" obsidian-index))
        (let* ((slug (car spec))
               (reference (str "assets/tunes/" slug ".cts"))
               (source (read-score (path (root) reference))))
          (write-album
            motif
            output
            slug
            (cadr spec)
            source
            ((caddr spec) source)
            (list reference)
            "Album mystery/pedal pair I: finite entrance, complete calm and focused material, returning motif and composed withdrawal. Accepted game sources, instrument bank and bus remain unchanged."
            "Preserve deliberate spaces, original onset grid, Obsidian Waves IV pedal and audible side pads. Explicit final gates and two tail bars. Arranged with album-compose-stone.sgl."))))))
