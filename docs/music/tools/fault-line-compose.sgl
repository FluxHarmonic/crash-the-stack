#!/usr/bin/env sigil
;;; Initial full composition; afterwards edit the shared parts in the tracker.
(import (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(load (path (script-dir) "lib/song-source.sgl"))
(import (crash soundtrack tools)
        (crash soundtrack album arrangement)
        (crash soundtrack songs))
(initialize (path (script-dir) "../../.."))

(define BASELINE "docs/music/alternates/fault-line-bass-lock-vii/fault-line-after.cts")
;;; Bass root, pad root, fifth, pad instrument, complete two-bar clean phrase.
(define CHORDS
  '(("D-2" "D-3" "A-1" 14 ("D-4" "E-4" "F-4" "A-4" "F-4" "E-4" "D-4"))
    ("A#1" "A#2" "F-2" 15 ("F-4" "D-4" "C-4" "A-3" "A#3" "D-4" "F-4"))
    ("G-1" "G-2" "D-2" 14 ("D-4" "A#3" "A-3" "G-3" "A#3" "D-4" "F-4"))
    ("A-1" "A-2" "E-2" 14 ("E-4" "G-4" "E-4" "C-4" "D-4" "C-4" "A-3"))))
(define MOTIF '((0 6) (10 3) (16 8) (28 3) (38 6) (48 4) (56 6)))

(define CLEAN
  '(instrument id: 13 name: "glass-wire-guitar"
     patch: (fm4-bass alg: 4 fb: 0.08 index: 0.85 drive: 0.16
              op1: (1 0.65 0.002 0.32 0.18 0.12)
              op2: (2 0.3 0.001 0.06 0.08 0.06)
              op3: (3 0.09 0.002 0.2 0.08 0.09)
              op4: (3 0.15 0.001 0.04 0 0.04)
              amp-attack: 0.002 amp-decay: 0.32
              amp-sustain: 0.22 amp-release: 0.12)
     volume: 40 gain: 0.55 send: 0.18 pan: -0.24))

(define (veil ident major?)
  (let ((third (if major? 1.25992105 1.189207115)))
    (list 'instrument id: ident name: (if major? "major-side-veil" "minor-side-veil")
      patch:
      (list 'fm4-bass alg: 4 fb: 0.015 index: 0.35 drive: 0.04
        op1: '(1 0.38 0.35 0.7 0.55 0.4)
        op2: '(1 0.12 0.3 0.5 0.35 0.4)
        op3: (list third 0.25 0.4 0.7 0.5 0.4)
        op4: (list (* third 2) 0.1 0.3 0.5 0.3 0.4)
        amp-attack: 0.35 amp-decay: 0.7 amp-sustain: 0.6 amp-release: 0.4)
      volume: 32 gain: 0.48 send: 0.24 pan: 0.2)))

(define SIGNAL
  '(instrument id: 16 name: "terminal-glint"
     patch: (fm4-bell amp-attack: 0.001 amp-decay: 0.11
              amp-sustain: 0 amp-release: 0.06 index: 0.55)
     volume: 22 gain: 0.38 send: 0.16 pan: 0.32))

(define (selected p channels)
  (transform p (lambda (row cell) (and (member (car cell) channels) cell))))

(define (calm order variant drums?)
  (let ((p (empty-pattern 8)) (pair-index 0))
    (each chord-id order
      (let* ((chord (list-ref CHORDS chord-id))
             (base (* pair-index 64))
             (melody (list-ref chord 4)))
        (set! p
          (add-notes p
            (list (list base 7 (cadr chord) (list-ref chord 3) 21 52))))
        (each spec '((0 0 6 28) (16 0 5 25) (32 0 6 27) (48 2 4 22) (56 0 6 25))
          (set! p
            (add-notes p
              (list (list (+ base (car spec)) 4 (list-ref chord (cadr spec))
                          4 (list-ref spec 3) (caddr spec))))))
        (let loop ((notes melody) (rhythm MOTIF) (n 0))
          (unless (null? notes)
            (set! p
              (add-notes p
                (list (list (+ base (caar rhythm)) 5 (car notes) 13
                            (if (member n '(0 2 6)) 28 24) (cadar rhythm)))))
            (loop (cdr notes) (cdr rhythm) (+ n 1))))
        (when variant
          ;; A small answering harmonic leaves the main melody intact.
          (set! p
            (add-notes p
              (list (list (+ base 46) 6 (list-ref melody 2) 13 13 8)
                    (list (+ base 54) 8 (list-ref melody 0) 16 10 2)))))
        (when drums?
          (each bar '(0 32)
            (each row '(0 16)
              (set! p
                (add-notes p (list (list (+ base bar row) 1 "C-2" 1 28 3)))))
            (set! p
              (add-notes p (list (list (+ base bar 24) 2 "F#3" 2 19 3))))
            (each row '(4 12 20 28)
              (set! p
                (add-notes p
                  (list (list (+ base bar row) 3 "C-8" 3
                              (if (= row 4) 12 9) 2))))))))
      (set! pair-index (+ pair-index 1)))
    p))

(define (intro calm-p)
  (transform calm-p
    (lambda (row cell)
      (let ((ch (car cell)))
        (cond ((= ch 7) (level cell 0.85))
              ((and (= ch 5) (>= row 128)) (level cell 0.75))
              ((and (= ch 4) (>= row 192)) (level cell 0.8))
              ((and (= ch 8) (>= row 128)) cell)
              (else #f))))))

(define (hook p stronger?)
  (let ((result (transform p (lambda (row cell) (and (not (= (car cell) 7)) cell))))
        (index 0))
    (each chord CHORDS
      ;; A compact version of the clean motif, with breathing room per pair.
      (let ((melody (list-ref chord 4)) (base (* index 64)))
        (each spec '((0 0 6) (10 1 3) (16 2 8) (38 4 6) (48 5 4) (56 6 6))
          (set! result
            (add-notes result
              (list (list (+ base (car spec)) 7 (list-ref melody (cadr spec))
                          9 (if stronger? 27 23) (caddr spec)))))))
      (set! index (+ index 1)))
    result))

(define (build calm-p)
  (let* ((p (set-field (empty-pattern 4) id: 0))
         (source (selected calm-p '(4 5 7))))
    (each row (filter (lambda (r) (>= (cadr r) 128)) (skip source 5))
      (each cell (cddr row)
        (set! p (put-cell p (- (cadr row) 128) cell))))
    (set! p (transform p unchanged))
    (each bar '(0 32 64 96)
      (each row '(0 10 16 28)
        (set! p
          (add-notes p
            (list (list (+ bar row) 1 "C-2" 1 (+ 30 (quotient bar 16)) 3)))))
      (each row '(8 24)
        (set! p
          (add-notes p
            (list (list (+ bar row) 2 "F#3" 2 (+ 22 (quotient bar 16)) 3)))))
      (each row '(4 12 20 28)
        (set! p
          (add-notes p (list (list (+ bar row) 3 "C-8" 3 13 2))))))
    p))

(define (outro calm-p)
  (let ((p (set-field (empty-pattern 4) id: 0)))
    (each row (filter (lambda (r) (< (cadr r) 128)) (skip calm-p 5))
      (each cell (cddr row)
        (when (member (car cell) '(4 5 6 7 8))
          (set! p
            (put-cell p (cadr row)
              (level cell (if (< (cadr row) 64) 0.85 0.65)))))))
    p))

(define (ending)
  (add-notes (empty-pattern 4)
    '((0 4 "D-2" 4 24 22)
      (0 7 "D-3" 14 18 80)
      (0 5 "D-4" 13 24 12)
      (16 5 "E-4" 13 19 6)
      (28 5 "F-4" 13 18 12)
      (48 5 "E-4" 13 15 8)
      (64 5 "D-4" 13 13 16)
      (72 6 "A-4" 13 8 8))))

(define (strip-entry p)
  (append (take p 5)
    (filter (lambda (r) (pair? (cddr r)))
      (map (lambda (r)
             (append (take r 2)
               (filter (lambda (c)
                         (not (and (= (cadr r) 0) (equal? (cadr c) "==="))))
                       (cddr r))))
           (skip p 5)))))

(define (flat value) (trim (score-text value)))
(define (format-layout phrases arrangements)
  (str "(song version: 1\n  " (flat (cons 'phrases phrases)) "\n  (arrangements\n"
    (string-join
      (map (lambda (a)
             (str "    (" (symbol->string (car a)) " destination: "
                  (flat (field a destination:)) "\n"
                  (string-join (map (lambda (s) (str "      " (flat s))) (skip a 3)) "\n")
                  ")"))
           arrangements)
      "\n")
    "))\n"))

(cli "fault-line-compose" (script-args) '()
  (lambda (options)
    (let* ((motif (require-tool (option-ref options 'motif)))
           (output (option-ref options 'output))
           (original (read-score (path (root) BASELINE)))
           (base
             (replace-child
               (replace-child original 'bus (set-field (child original 'bus) makeup: -3))
               'instruments
               (append (child original 'instruments)
                       (list CLEAN (veil 14 #f) (veil 15 #t) SIGNAL))))
           (calm-a (calm '(0 1 2 3) #f #t))
           (calm-b (calm '(0 1 2 3) #t #t))
           (bridge-a (calm '(2 1 0 3) #f #f))
           (bridge-b (calm '(2 1 0 3) #t #t))
           (riff (pattern original 1))
           (solo (pattern original 3))
           (phrases
             (list (list "Signal in the dark" (intro calm-b))
                   (list "Calm theme" calm-a)
                   (list "Calm answer" calm-b)
                   (list "Main riff" riff)
                   (list "Electric theme" (hook riff #f))
                   (list "Exposed harmonic middle" bridge-a)
                   (list "Pulse returns" bridge-b)
                   (list "Pressure rises" (build calm-a))
                   (list "Moving entrance" (pattern original 2))
                   (list "Bent solo" solo)
                   (list "Theme in full" (hook solo #t))
                   (list "Final riff" (hook riff #t))
                   (list "Clean afterimage" (outro calm-b))
                   (list "D minor landing" (ending))
                   (list "Room tail" (empty-pattern 2))))
           (named '())
           (pool '())
           (refs '())
           (labels '())
           (id 0))
      (ensure-directory output)
      (each spec phrases
        (let* ((p (set-field (cadr spec) id: id))
               (row0 (list-find (lambda (r) (= (cadr r) 0)) (skip p 5)))
               (offs (if row0 (filter (lambda (c) (equal? (cadr c) "===")) (cddr row0)) '())))
          (set! named (append named (list (list (car spec) id))))
          (set! pool (append pool (list (strip-entry p))))
          (set! refs
            (append refs (list (list id (car spec) (cons 'entry-offs offs) '(effects)))))
          (set! labels (append labels (list (list id (car spec)))))
          (set! id (+ id 1))))
      (let* ((parts
               (replace-child
                 (replace-child
                   (replace-child base 'patterns (cons 'patterns pool))
                   'order (cons 'order (map car labels)))
                 'history
                 '(history ("codex" "2026-09-23"
                    "Fault Line shared composition I; edit phrases here and forms in arrangements.sgl."))))
             (template
               (replace-child
                 (replace-child
                   (replace-child base 'instruments '(instruments))
                   'patterns '(patterns))
                 'history
                 '(history ("codex" "2026-09-23"
                    "Fault Line full composition I: clean/electric recurring motif, exposed harmonic middle, delayed bent solo, finite ending. Shared with draft calm/fill/tense game arrangement."))))
             (bank (cons 'bank (map (lambda (i) (list (field i id:) (field i id:)))
                                    (cdr (child parts 'instruments)))))
             (album
               (list 'album destination: "docs/music/album/fault-line.cts"
                     (list 'template (replace-child template 'order (cons 'order (map car labels))))
                     bank (cons 'patterns refs) (cons 'labels labels)))
             (game-ids '(1 2 8 3 4 9))
             (game-refs
               (map (lambda (index source-id)
                      (let ((ref (list-ref refs source-id)))
                        (list index (cadr ref) (child ref 'entry-offs)
                          (cond ((= index 1) '(effects (255 8 "B00")))
                                ((= index 5) '(effects (255 8 "B03")))
                                (else '(effects))))))
                    '(0 1 2 3 4 5) game-ids))
             (game
               (list 'game destination: "docs/music/alternates/fault-line-game.cts"
                     (list 'template
                       (replace-child template 'order '(order 0 1 2 3 4 5)))
                     bank (cons 'patterns game-refs)))
             (layout (list 'song version: 1 (cons 'phrases named)
                           (list 'arrangements game album))))
        (write-canonical motif (path output "parts.cts") parts)
        (write-text (path output "arrangements.sgl") (format-layout named (list game album)))
        (write-canonical motif (path output "fault-line.cts") (build-song-score parts layout album))
        (write-canonical motif (path output "fault-line-game.cts") (build-song-score parts layout game))
        (println "Full composition and shared game draft ready in ~a" output)))))
