#!/usr/bin/env sigil
;;; Style VI: a simpler root-led bass motif with clearer picked harmonics.
(import (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack tools) (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define BASELINE "docs/music/alternates/fault-line-flow-v/fault-line-after.cts")
(define ROOTS '(("D-2" "A-1") ("A#1" "F-2") ("G-1" "D-2") ("A-1" "E-2")))
;;; Row, fifth instead of root?, held rows, note level. One fifth per two bars.
(define CALL '((0 #f 5 34) (10 #f 3 32) (18 #t 3 28) (26 #f 5 32)))
(define REPLY '((0 #f 5 34) (12 #f 5 32) (22 #f 3 30) (28 #f 3 31)))

(define (clear-bass p)
  (transform p (lambda (row cell) (and (not (= (car cell) 4)) cell))))

(define (bass-section p heavy?)
  (let ((result (clear-bass p)))
    (let loop ((bar 0))
      (when (< bar (quotient (field p rows:) 32))
        (let ((notes (list-ref ROOTS (quotient bar 2))))
          (each spec (if (even? bar) CALL REPLY)
            (set! result
              (add-notes result
                (list
                  (list (+ (* bar 32) (car spec))
                        4 (if (cadr spec) (cadr notes) (car notes)) 4
                        (+ (list-ref spec 3) (if heavy? 1 0))
                        (caddr spec)))))))
        (loop (+ bar 1))))
    result))

(define (picked-character inst)
  (let ((patch
          '(fm4-bass
             alg: 4 fb: 0.14 index: 1.65 drive: 0.65
             op1: (1 0.7 0.001 0.2 0.45 0.03)
             op2: (2 0.55 0.001 0.07 0.16 0.025)
             op3: (2 0.32 0.001 0.16 0.4 0.03)
             op4: (4 0.22 0.001 0.055 0.08 0.02)
             amp-attack: 0.001 amp-decay: 0.16
             amp-sustain: 0.45 amp-release: 0.03)))
    (set-field
      (set-field inst patch: patch)
      layers:
      '((chip-sub
          osc-amp: 0.7 drive: 0.06
          attack: 0.003 decay: 0.1 sustain: 0.45 release: 0.03
          octave: 0 volume: 0.12)))))

(define (transition-bass p)
  (add-notes (clear-bass p)
    '((0 4 "A-1" 4 34 5) (10 4 "A-1" 4 32 3)
      (18 4 "E-2" 4 28 3) (28 4 "A-1" 4 32 3)
      (32 4 "A-1" 4 35 5) (42 4 "A-1" 4 33 3)
      (50 4 "A-1" 4 32 3) (58 4 "D-2" 4 32 3)
      (62 4 "D-2" 4 30 1))))

(define (revise before)
  (let* ((bank
           (map (lambda (inst)
                  (if (= (field inst id:) 4) (picked-character inst) inst))
                (cdr (child before 'instruments))))
         (patterns
           (map
             (lambda (p)
               (case (field p id:)
                 ((0 1) (bass-section p #f))
                 ((2) (transition-bass p))
                 ((3) (bass-section p #t))
                 ((4) (add-notes (clear-bass p) '((0 4 "D-2" 4 35 22))))
                 (else p)))
             (cdr (child before 'patterns))))
         (after (replace-child before 'instruments (cons 'instruments bank)))
         (after (replace-child after 'patterns (cons 'patterns patterns))))
    (each p (cdr (child before 'patterns))
      (check (equal? (clear-bass p) (clear-bass (pattern after (field p id:))))
             "Non-bass performance changed"
             (field p id:)))
    (check (equal? (child before 'bus) (child after 'bus)) "Bus changed")
    (replace-child after 'history
      (append (child after 'history)
        '(("codex" "2026-09-23"
           "Style VI: root-led two-bar bass motif, one fifth response per pair, D2 instead of D1 anchors, reduced sine layer and stronger picked harmonics. Non-bass groove, moving entrance and bent solo preserved."))))))

(define (slice p start rows)
  (append (list 'pattern id: 0 rows: rows)
    (map (lambda (row) (append (list 'row (- (cadr row) start)) (cddr row)))
         (filter (lambda (row) (and (>= (cadr row) start) (< (cadr row) (+ start rows))))
                 (skip p 5)))))

(define (context score)
  (list (list "Four pocket bars" (slice (pattern score 1) 128 128))
        (list "Moving solo entrance" (pattern score 2))
        (list "First two solo bars" (slice (pattern score 3) 0 64))
        (list "Released room" (empty-pattern 2))))

(cli "fault-line-bass-focus" (script-args) '()
  (lambda (options)
    (let* ((motif (require-tool (option-ref options 'motif)))
           (output (option-ref options 'output))
           (before (read-score (path (root) BASELINE)))
           (after (revise before)))
      (each variant (list (list "before" before) (list "after" after))
        (write-canonical motif (path output (str "fault-line-" (car variant) ".cts"))
                         (cadr variant))
        (write-album
          motif output (str "fault-line-context-" (car variant)) "Fault Line"
          (cadr variant) (context (cadr variant))
          (list BASELINE "docs/music/tools/fault-line-bass-focus.sgl")
          "Style VI: simpler rooted bass and clearer picked character."
          "Before is Style V; guitar groove, moving entrance and bent solo stay fixed."
          "2026-09-23"))
      (write-json-file (path output "comparison.json")
        (dict slug: "fault-line"
              title: "Fault Line"
              audition: "style-vi"
              full_duration_seconds: (/ (* 26 32 7.5) 126)
              comment: "BEFORE Style V, then AFTER Style VI: simpler root/fifth bass, less sub, clearer picked harmonics. Other parts unchanged. Equal gain."
              clips:
                (list->array
                  (map (lambda (variant)
                         (dict stem: (str "fault-line-context-" variant)
                               label: variant
                               duration_seconds: (/ (* 10 32 7.5) 126)))
                       '("before" "after"))))))))
