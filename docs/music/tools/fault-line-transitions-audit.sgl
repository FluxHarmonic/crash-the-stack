#!/usr/bin/env sigil
;;; Focused timing, transition and patch scope checks for composition III.
(import (sigil list) (sigil math))
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack tools)
        (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define (onsets p channel)
  (filter (lambda (r)
            (let ((cell (assoc channel (cddr r)))) (and cell (attack? cell)
                   (not (starts-with? (list-ref cell 4) "3")))))
          (skip p 5)))
(define (sample row tick) (* 875 (+ (* row 3) tick)))
(define (at-or-before ts sample)
  (fold-left (lambda (state t) (if (<= (car t) sample) t state)) #f ts))

(cli "fault-line-transitions-audit" (script-args) '()
  (lambda (options)
    (let* ((old (read-score
                  (path (root) "docs/music/alternates/fault-line-composition-ii/parts.cts")))
           (parts (read-score (path (root) "docs/music/songs/fault-line/parts.cts")))
           (old-solo (onsets (pattern old 17) 7))
           (new-solo (onsets (pattern parts 17) 7))
           (moved 0)
           (motif (require-tool (option-ref options 'motif)))
           (lead (ticks motif (path (root) "docs/music/album/fault-line.cts") 7)))
      (check (= (length old-solo) (length new-solo)) "Solo note count changed")
      (each pair (map list old-solo new-solo)
        (let ((a (car pair)) (b (cadr pair)))
        (check (equal? (assoc 7 (cddr a)) (assoc 7 (cddr b))) "Solo pitch/velocity changed")
        (check (and (<= (cadr b) (cadr a)) (= (modulo (cadr b) 4) 0))
               "Solo note is late or off the eighth-note grid")
        (unless (= (cadr a) (cadr b)) (set! moved (+ moved 1)))))
      (check (= moved 8) "Unexpected number of moved solo notes" moved)
      (each p (cdr (child old 'patterns))
        (unless (member (field p id:) '(5 8 17))
          (check (equal? p (pattern parts (field p id:)))
                 "Unrelated phrase changed" (field p id:))))
      (each inst (cdr (child old 'instruments))
        (let ((new (list-find (lambda (i) (= (field i id:) (field inst id:)))
                              (cdr (child parts 'instruments)))))
          (if (member (field inst id:) '(5 6 7 8))
              (check (and (= (field (field new patch:) drive:) 4.4)
                          (< (abs (- (field new gain:) (* 0.94 (field inst gain:)))) 0.000001))
                     "Guitar fuzz compensation differs")
              (check (equal? inst new) "Non-rhythm patch changed" (field inst id:)))))
      (check (equal? (child old 'bus) (child parts 'bus)) "Bus changed")
      ;; The whole-tone G4 -> A4 rise still completes without retriggering.
      (let* ((start (sample 914 0))
             (end (sample 918 0))
             (changes (filter (lambda (t) (<= start (car t) (- end 1))) lead))
             (held (at-or-before lead end)))
        (check (and (= (length changes) 8)
                    (every (lambda (t) (and (= (list-ref t 4) 1) (= (list-ref t 5) 0))) changes)
                    (= (list-ref held 4) 1)
                    (< (abs (- (list-ref held 2) 440)) 0.01))
               "Retimed solo loses its held whole-tone bend"))
      (each spec '((23 240 (240 244 248 252)) (5 232 (232 236 240 244 248 252)))
        (let ((rows
                (filter (lambda (r)
                          (and (>= (cadr r) (cadr spec))
                               (any (lambda (c) (and (member (car c) '(2 8)) (attack? c)))
                                    (cddr r))))
                        (skip (pattern parts (car spec)) 5))))
          (check (equal? (map cadr rows) (caddr spec)) "Fill grid differs" spec)))
      (ensure-directory (option-ref options 'output))
      (write-json-file (path (option-ref options 'output) "transition-checks.json")
        (dict solo_attacks: (length new-solo) solo_notes_moved_earlier: moved
              solo_eighth_note_grid: #t held_whole_tone_bend_verified: #t
              rhythm_guitar_gain_factor: 0.94 other_patches_preserved: #t
              other_melodies_preserved: #t descending_and_rising_fills: #t))
      (println "Focused solo timing, verified bend, fill and patch-scope checks passed."))))
