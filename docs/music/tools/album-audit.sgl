#!/usr/bin/env sigil
;;; Finite album playback audit; game-loop audits deliberately require Bxx.
(import (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(initialize (path (script-dir) "../../.."))

(define CHANNELS '(1 2 3 4 5 6 7 8))
(define POLICIES
  '(("cold-boot" "Cold Boot" 7 (7))
    ("relay-ghost" "Relay Ghost" 7 (6 7))
    ("black-glass" "Black Glass" #f ())
    ("quiet-array" "Quiet Array" #f (6 7))
    ("closed-loop" "Closed Loop" #f (6 7))
    ("shadow-protocol" "Shadow Protocol" #f (5 6))
    ("blind-spot" "Blind Spot" #f (6))
    ("sector-drift" "Sector Drift" #f (6 7))
    ("dirty-cache" "Dirty Cache" #f (7))
    ("basement-circuit" "Basement Circuit" 7 (7))
    ("dead-sector" "Dead Sector" #f (6 7))
    ("obsidian-index" "Obsidian Index" #f (6 7))
    ("breach-vector" "Breach Vector" #f ())
    ("clock-edge" "Clock Edge" #f (7))
    ("glass-current" "Glass Current" 9 (6 7))))
(define (attack? cell)
  (not (member (cadr cell) '("..." "==="))))

;;; Obsidian's side pad must follow the main harmony and release before changes.
(define (audit-veil-row row position previous-off)
  (let ((left (assoc 5 (cddr row)))
        (right (assoc 8 (cddr row))))
    (check (equal? (if left (cadr left) #f)
                   (if right (cadr right) #f))
           "Obsidian pad root/gate mismatch"
           position)
    (cond
      ((not left) previous-off)
      ((equal? (cadr left) "===") position)
      (else
       (check (and previous-off (>= (- position previous-off) 6))
              "Obsidian pad release gap below six rows"
              position)
       (check (= (caddr right)
                 (cond ((= (caddr left) 6) 16)
                       ((= (caddr left) 7) 17)
                       ((= (caddr left) 10) 18)
                       (else -1)))
              "Obsidian pad voicing mismatch"
              position)
       #f))))

(define (audit motif slug)
  (let* ((file (path (root) "docs/music/album" (str slug ".cts")))
         (policy (or (assoc slug POLICIES) (error "Missing review policy" slug)))
         (score (read-score file))
         (legacy? (member slug '("shadow-protocol" "dirty-cache" "breach-vector")))
         (grid (if (member meter: score) (field score meter:) '(4 4)))
         (bar-rows (apply * grid))
         (patterns (cdr (child score 'patterns)))
         (orders (cdr (child score 'order)))
         (expected (make-vector 9 '()))
         (gated (make-vector 9 #f))
         (instruments (make-vector 9 '()))
         (numerator (* 44100 5 (field score speed:)))
         (denominator (* 2 (field score tempo:)))
         (offset 0)
         (pad-off -6)
         (count 0)
         (worst 0)
         (odd-onsets '()))
    (check (equal? (read-text file) (canonical motif file)) "Noncanonical source" file)
    ($ ,motif tune check ,file)
    (check (and (= (field score speed:) (if (equal? slug "breach-vector") 4 (if legacy? 6 3)))
                (= (field score channels:) 8)
                (equal? grid (if legacy? '(4 4) '(8 4))))
           "Unexpected grid" slug)
    (check (equal? (field score name:)
                  (cadr policy))
           "Album title mismatch" slug)
    (each ident orders
      (let ((p (list-find (lambda (p) (= (field p id:) ident)) patterns)))
        (check p "Missing ordered pattern" ident)
        (each r (skip p 5)
          (when (equal? slug "obsidian-index")
            (set! pad-off (audit-veil-row r (+ offset (cadr r)) pad-off)))
          (each c (cddr r)
            (let ((ch (car c))
                  (fx (list-ref c 4)))
              (check (not (any (lambda (prefix) (starts-with? fx prefix)) '("B" "D" "F")))
                     "Album must be finite with a fixed clock" slug ident (cadr r) fx)
              (cond
                ((equal? (cadr c) "===") (vector-set! gated ch #f))
                ((attack? c)
                 (when (and (not legacy?) (odd? (cadr r)))
                   (set! odd-onsets (cons (list ident (cadr r) ch) odd-onsets)))
                 (when (member ch (list-ref policy 3))
                   (check (= (modulo (cadr r) (if legacy? 2 4)) 0) "Mallet/bell off eighth grid" ident r))
                 (unless (and (starts-with? fx "3") (vector-ref gated ch))
                   (vector-set! expected ch
                     (cons (quotient (+ (* 2 (+ offset (cadr r)) numerator) denominator)
                                     (* 2 denominator))
                           (vector-ref expected ch))))
                 (vector-set! gated ch #t)
                 (unless (member (caddr c) (vector-ref instruments ch))
                   (vector-set! instruments ch
                     (cons (caddr c) (vector-ref instruments ch)))))))))
        (set! offset (+ offset (field p rows:)))))
    ;; Only the declared original transition may retain its four 32nd hits.
    (check (if (caddr policy)
               (equal? (reverse odd-onsets)
                       (map (lambda (row) (list (caddr policy) row 2))
                            '(121 123 125 127)))
               (null? odd-onsets))
           "Unexpected off-sixteenth attacks" slug odd-onsets)
    (each ch CHANNELS
      (check (not (vector-ref gated ch)) "Channel remains gated at end" slug ch)
      (let* ((actual (filter (lambda (t) (= (list-ref t 5) 1)) (ticks motif file ch)))
             (times (reverse (vector-ref expected ch)))
             (voices
               (fold-left
                 (lambda (total id)
                   (let* ((inst (list-find (lambda (i) (= (field i id:) id))
                                          (cdr (child score 'instruments))))
                          (layers (member layers: inst)))
                     (+ total 1 (if layers (length (cadr layers)) 0))))
                 0 (vector-ref instruments ch))))
        (check (<= voices 8) "Voice budget exceeded" slug ch voices)
        (check (= (length actual) (length times)) "Missing/extra compiled attack" slug ch)
        (list-for-each
          (lambda (tick expected-sample)
            (let ((delta (abs (- (car tick) expected-sample))))
              (check (<= delta 1) "Compiled attack drift" slug ch delta)
              (set! worst (max worst delta))))
          actual times)
        (set! count (+ count (length actual)))))
    (let* ((last (list-find (lambda (p) (= (field p id:) (car (reverse orders)))) patterns))
           (rows (skip last 5)))
      (check (and (= (field last rows:) (* 2 bar-rows))
                  (= (length rows) 1)
                  (= (length (cddr (car rows))) 8)
                  (every (lambda (c) (equal? (cadr c) "===")) (cddr (car rows))))
             "Missing two-bar release tail" slug))
    (dict title: (field score name:)
          attacks: count
          maximum_clock_error_samples: worst
          intentional_32nd_snare_hits: (length odd-onsets)
          duration_seconds: (/ (* offset numerator) (* denominator 44100.0))
          all_final_gates_released: #t)))

(cli "album-audit" (script-args) '()
  (lambda (options)
    (let* ((motif (require-tool (option-ref options 'motif)))
           (output (option-ref options 'output))
           (tracks (or (option-ref options 'tracks) '("cold-boot" "relay-ghost"))))
      (ensure-directory output)
      (write-json-file (path output "album-score-check.json")
        (list->array (map (lambda (slug) (audit motif slug)) tracks)))
      (println "Album scores and compiled clocks passed."))))
