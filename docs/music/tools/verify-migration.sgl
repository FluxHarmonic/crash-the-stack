#!/usr/bin/env sigil
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/audit.sgl"))
(import (crash soundtrack tools) (crash soundtrack audit) (sigil json) (sigil list))
(initialize (path (script-dir) "../../.."))
(requires (tools sha256sum))

(cli "verify-migration" (script-args) '()
  (lambda (opts)
    (let ((motif (require-tool (option-ref opts 'motif)))
          (results '()))
      (each slug (source-slugs)
        (let* ((entry (dict-ref (historical) (string->keyword slug)))
               (file (source-path slug))
               (actual (car (split (out sha256sum ,file) " "))))
          (check (equal? actual (dict-ref entry sha256:)) "Historical source hash changed" slug)))
      (each key (dict-keys (accepted))
        (let* ((entry (dict-ref (accepted) key))
               (source (dict-ref entry source:))
               (file (path (root) (dict-ref entry path:)))
               (original (read-score (source-path source)))
               (shipped (read-score file))
               (layout (dict-ref entry sections: #f))
               (jump (if layout (array-ref layout 1) (dict-ref entry intro_loop:))))
          (check (equal? shipped (set-field original name: (dict-ref entry title:)))
                 "Shipping source changed beyond its display title" file)
          (check (equal? (canonical motif file) (read-text file)) "Noncanonical shipping source" file)
          ($ ,motif tune check ,file)
          (let ((result (if (and layout (not (contains? source "adaptive")))
                            (grid-audit source file motif)
                            (clock-audit file motif jump))))
            (set! results (append results (list result)))
            (println "~a" (json-encode result)))))
      (ensure-directory (option-ref opts 'output))
      (write-json-file (path (option-ref opts 'output) "migration-audit.json") (list->array results))
      (println "Verified ~a historical sources and ~a shipping scores."
               (length (source-slugs)) (length results)))))
