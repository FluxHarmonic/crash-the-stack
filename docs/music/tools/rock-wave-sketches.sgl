      0.65 0.22 0.05)))

(define (wave-pad right? major?)
  (let ((a (if right? (if major? 1.259921 1.1892071) 1.0))
        (b (if right? (if major? 1.8877486 1.7817974) 1.4983071)))
    (list 'fm4-pad alg: 4 fb: 0.15 index: 0.95 vel-depth: 0.12
          op1: (list a 0.42 0.09 0.65 0.72 0.35)
          op2: (list a 0.35 0.12 0.8 0.45 0.35)
          op3: (list b 0.28 0.1 0.7 0.7 0.35)
          op4: (list b 0.3 0.14 0.8 0.4 0.35)
          amp-attack: 0.12 amp-decay: 0.6 amp-sustain: 0.75 amp-release: 0.4
          unison: 2 spread: 11 chorus-mix: 0.24 chorus-depth: 2.8 chorus-rate: 0.35)))

(define WAVE-BANK
  (list
    (instrument 1 "wide-kick"
      '(chip-kick decay: 0.28 drive: 0.5 index: 1.7 sweep: 2.5 sweep-decay: 0.032)
      0.85 0 0.02)
    (instrument 2 "big-snare"
      '(chip-snare body: 0.65 noise: 0.42 noise-decay: 0.17 hp: 1600 crush-bits: 14)
      0.82 0 0.14)
    (instrument 3 "bright-hat"
      '(chip-hat decay: 0.04 hp: 6000 metal: 0.22 noise: 0.17 crush-bits: 15)
      0.65 0.2 0.04)
    (instrument 4 "octave-pulse"
      '(chip-saw osc-amp: 0.36 unison: 2 spread: 4 cutoff: 750 drive: 0.25
        attack: 0.002 decay: 0.11 sustain: 0.32 release: 0.03)
      0.75 0 0)
    (instrument 5 "pad-root-fifth" (wave-pad #f #f) 0.75 -0.58 0.2)
    (instrument 6 "pad-minor-color" (wave-pad #t #f) 0.75 0.58 0.2)
    (instrument 7 "pad-major-color" (wave-pad #t #t) 0.75 0.58 0.2)
    (instrument 8 "night-lead"
      '(chip-saw osc-amp: 0.3 unison: 2 spread: 9 cutoff: 2600 drive: 0.12
        attack: 0.003 decay: 0.24 sustain: 0.58 release: 0.14)
      0.75 0.04 0.18)
    (instrument 9 "crash"
      '(chip-hat decay: 0.75 hp: 4600 metal: 0.24 noise: 0.13 crush-bits: 15)
      0.6 -0.22 0.16)
