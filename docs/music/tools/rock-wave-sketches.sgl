#!/usr/bin/env sigil
;;; Two finite style demos. Full game/album arrangements follow listening review.
(import (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack tools) (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define (instrument id name patch gain pan send)
  (list 'instrument id: id name: name patch: patch
        gain: gain volume: 40 pan: pan send: send))

(define (guitar open? right?)
  (let ((root (if right? 1.002 1.0))
        (fifth (if right? 1.5013 1.4983071)))
    (list 'fm4-bass alg: 4 fb: 0.34 index: (if open? 1.9 1.6)
          vel-depth: 0.25 drive: 0.65
          op1: (list root 0.7 0.002 0.22 0.68 0.055)
          op2: (list root 0.52 0.001 0.065 0.24 0.04)
          op3: (list fifth 0.42 0.002 0.2 0.6 0.055)
          op4: (list fifth 0.42 0.001 0.06 0.2 0.04)
          amp-attack: 0.002 amp-decay: (if open? 0.22 0.085)
          amp-sustain: (if open? 0.65 0.08)
          amp-release: (if open? 0.07 0.018))))

(define ROCK-BANK
  (list
    (instrument 1 "rock-kick"
      '(chip-kick decay: 0.19 drive: 0.35 index: 1.4 sweep: 2.0 sweep-decay: 0.025)
      0.9 0 0.02)
    (instrument 2 "rock-snare"
      '(chip-snare body: 0.55 noise: 0.35 noise-decay: 0.095 hp: 1700 crush-bits: 15)
      0.85 0 0.08)
    (instrument 3 "closed-metal-hat"
      '(chip-hat decay: 0.04 hp: 5200 metal: 0.3 noise: 0.15 crush-bits: 15)
      0.7 0.22 0.025)
    (instrument 4 "picked-bass"
      '(fm4-bass alg: 4 fb: 0.08 index: 1.15 drive: 0.2
        op1: (1 0.75 0.002 0.22 0.5 0.04)
        op2: (1 0.32 0.001 0.045 0.04 0.025)
        op3: (2 0.12 0.002 0.15 0.3 0.04)
        op4: (2 0.12 0.001 0.04 0.02 0.025)
        amp-attack: 0.002 amp-decay: 0.2 amp-sustain: 0.5 amp-release: 0.035)
      0.9 0 0)
    (instrument 5 "muted-guitar-left" (guitar #f #f) 0.6 -0.48 0.025)
    (instrument 6 "open-guitar-left" (guitar #t #f) 0.6 -0.48 0.055)
    (instrument 7 "muted-guitar-right" (guitar #f #t) 0.56 0.48 0.025)
    (instrument 8 "open-guitar-right" (guitar #t #t) 0.56 0.48 0.055)
    (instrument 9 "fm-guitar-lead"
      '(fm4-bass alg: 4 fb: 0.3 index: 2.0 drive: 0.55
        op1: (1 0.65 0.002 0.3 0.65 0.09)
        op2: (1 0.55 0.001 0.09 0.28 0.06)
        op3: (2.002 0.13 0.003 0.25 0.5 0.09)
        op4: (2 0.35 0.001 0.08 0.1 0.05)
        amp-attack: 0.003 amp-decay: 0.25 amp-sustain: 0.62 amp-release: 0.085)
      0.6 0.06 0.12)
    (instrument 10 "crash"
      '(chip-hat decay: 0.65 hp: 4200 metal: 0.25 noise: 0.13 crush-bits: 15)
      0.65 -0.16 0.12)
    (instrument 11 "fm-tom"
      '(chip-kick decay: 0.22 drive: 0.1 index: 0.8 sweep: 0.45 sweep-decay: 0.028)
