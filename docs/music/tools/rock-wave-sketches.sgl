(define (base title bpm bank rock?)
  (list 'tune version: 1 name: title tempo: bpm speed: 3 channels: 8 meter: '(8 4)
        (list 'bus reverb: 'zitarev size: (if rock? 0.38 0.55)
              damp: 0.65 mix: (if rock? 0.12 0.2)
              comp: 'on threshold: -12 ratio: 2 attack: 12 release: 110 makeup: 1)
        (cons 'instruments bank)
        '(patterns) '(order) '(history)))

;;; Bar-local notes remain on the straight eighth/sixteenth grid.
(define (hit p bar row channel pitch instrument volume held)
  (add-notes p (list (list (+ (* bar 32) row) channel pitch instrument volume held))))

(define (drums p bar heavy? rock? fill?)
  (each row (if rock? '(0 12 16 28) '(0 16))
    (set! p (hit p bar row 1 "C-2" 1 (if heavy? 48 38) 3)))
  (each row '(8 24)
    (set! p (hit p bar row 2 "F#3" 2 (if heavy? 45 32) 4)))
  (each row '(0 4 8 12 16 20 24 28)
    (set! p (hit p bar row 3 "C-8"
                (if (and heavy? (= row 28)) (if rock? 12 10) 3)
                (if (= (modulo row 8) 0) 19 14) 2)))
  (when (and heavy? (odd? bar) (not fill?))
    (set! p (hit p bar 22 2 "F#3" 2 15 1)))
  (when fill?
    (each spec '((16 "G-3") (20 "F-3") (24 "D-3") (28 "A-2"))
      (set! p (hit p bar (car spec) 8 (cadr spec) 11 29 3))))
  p)

;;; (power root, bass root, diatonic third, fourth, lower pickup).
(define ROCK-CHORDS
  '(("D-3" "D-2" "F-3" "G-3" "C-3")
    ("A#2" "A#1" "D-3" "D#3" "A-2")
    ("G-2" "G-1" "A#2" "C-3" "F-2")
    ("A-2" "A-1" "C-3" "D-3" "G-2")))

(define (rock-band bars heavy?)
  (let ((p (empty-pattern bars)))
    (let loop ((bar 0))
      (when (< bar bars)
        (let* ((chord (list-ref ROCK-CHORDS (quotient bar 2)))
               (root (car chord))
               (bass (cadr chord)))
          (set! p (drums p bar heavy? #t (= bar (- bars 1))))
          (each row '(0 4 12 16 24 28)
            (set! p (hit p bar row 4 bass 4 (if (= row 0) 37 31) 3)))
          (if heavy?
              (begin
                (each spec (list (list 0 root 5 3) (list 4 root 5 2)
                                 (list 12 (caddr chord) 5 2)
                                 (list 16 (list-ref chord 3) 6 6)
                                 (list 24 root 5 2)
                                 (list 28 (if (odd? bar) root (list-ref chord 4)) 5 3))
                  (set! p (hit p bar (car spec) 5 (cadr spec)
                              (caddr spec) (if (= (car spec) 16) 38 34)
                              (list-ref spec 3))))
                (each row '(0 16)
                  (set! p (hit p bar row 6 root 8 27 12))))
              (begin
                (each row '(0 4 16 20)
                  (set! p (hit p bar row 5 root 5 29 2)))
                (set! p (hit p bar 8 6 root 8 18 10))
                (set! p (hit p bar 24 6 root 7 20 3))))
          (when (and heavy? (= bar 0))
            (set! p (hit p bar 0 8 "C-8" 10 28 12))))
        (loop (+ bar 1))))
    (if heavy?
        (add-notes p
          '((32 7 "A-3" 9 29 12) (44 7 "C-4" 9 25 4)
            (48 7 "D-4" 9 28 12)
            (96 7 "F-4" 9 27 8) (104 7 "D-4" 9 25 8)
            (112 7 "C-4" 9 24 12)
            (160 7 "D-4" 9 28 12) (172 7 "A#3" 9 25 4)
            (176 7 "G-3" 9 27 12)
            (224 7 "E-4" 9 28 8) (232 7 "D-4" 9 24 8)
            (240 7 "C-4" 9 25 8) (248 7 "A-3" 9 23 6)))
        p)))

;;; (pad root, low root, octave root, major color?).
(define WAVE-CHORDS
  '(("F-3" "F-2" "F-3" #f)
    ("C#3" "C#2" "C#3" #t)
    ("A#2" "A#1" "A#2" #f)
    ("C-3" "C-2" "C-3" #f)))

(define (wave-band bars heavy? intro?)
  (let ((p (empty-pattern bars)))
    (let loop ((bar 0))
      (when (< bar bars)
        (let* ((chord (list-ref WAVE-CHORDS (quotient bar 2)))
               (root (car chord)))
          (when (or (not intro?) (>= bar 2))
            (set! p (drums p bar heavy? #f #f)))
          (each row '(0 4 8 12 16 20 24 28)
            (set! p (hit p bar row 4
                        (if (= (modulo row 8) 0) (cadr chord) (caddr chord))
                        4 (if heavy? 34 27) 3)))
          (when (even? bar)
            (set! p (hit p bar 0 5 root 5 (if heavy? 32 23) 56))
            (set! p (hit p bar 0 6 root (if (list-ref chord 3) 7 6)
                        (if heavy? 30 21) 56)))
          (when (and heavy? (= bar 0))
            (set! p (hit p bar 0 8 "C-8" 9 27 12))))
        (loop (+ bar 1))))
    (if heavy?
        (add-notes p
          '((0 7 "C-5" 8 32 12) (12 7 "A#4" 8 27 4)
            (16 7 "G#4" 8 29 12) (40 7 "G-4" 8 27 8)
            (48 7 "F-4" 8 30 12)
            (64 7 "G#4" 8 31 16) (88 7 "F-4" 8 27 8)
            (96 7 "D#4" 8 28 12) (112 7 "F-4" 8 29 12)
            (128 7 "F-5" 8 31 12) (140 7 "D#5" 8 27 4)
            (144 7 "C#5" 8 29 12) (168 7 "C-5" 8 27 8)
            (176 7 "A#4" 8 30 12)
            (192 7 "G-4" 8 30 16) (216 7 "D#4" 8 27 8)
            (224 7 "F-4" 8 29 8) (232 7 "G-4" 8 27 8)
            (240 7 "C-5" 8 29 12)))
        p)))

(define (transition rock?)
  (let ((p (empty-pattern 2)))
    (set! p (drums p 0 #f rock? #f))
    (set! p (drums p 1 #t rock? #t))
    (each row '(0 16 32 40 48 56)
      (set! p (add-notes p
        (list (list row 4 (if rock? "A-1" "C-2") 4 31 3)))))
    (if rock?
        (add-notes p
          '((0 5 "A-2" 6 29 20) (0 6 "A-2" 8 23 20)
            (32 5 "A-2" 5 30 3) (40 5 "A-2" 5 28 3)
            (48 5 "A-2" 5 31 3) (56 5 "A-2" 5 27 3)))
        (add-notes p
          '((0 5 "C-3" 5 26 52) (0 6 "C-3" 6 24 52)
            (32 7 "D#4" 8 23 8) (40 7 "G-4" 8 25 8)
            (48 7 "A#4" 8 26 8))))))

(cli "rock-wave-sketches" (script-args) '()
  (lambda (options)
    (let ((motif (require-tool (option-ref options 'motif)))
          (output (option-ref options 'output)))
      (write-album motif output "fault-line" "Fault Line"
        (base "Fault Line" 126 ROCK-BANK #t)
        (list
          (list "Guitar riff exposed / kit enters"
            (transform
              (set-field
                (append (take (rock-band 8 #f) 5)
                  (filter (lambda (row) (< (cadr row) 128))
                          (skip (rock-band 8 #f) 5)))
                rows: 128)
              (lambda (row cell)
                (and (or (>= row 64) (member (car cell) '(4 5 6))) cell))))
          (list "Muted guitar pocket" (rock-band 8 #f))
          (list "Tom fill / held tension" (transition #t))
          (list "Open guitars / lead answer" (rock-band 8 #t))
          (list "D-minor landing"
            (phrase 2
              '((0 1 "C-2" 1 44 4) (0 2 "F#3" 2 32 4)
                (0 4 "D-2" 4 35 22) (0 5 "D-3" 6 33 28)
                (0 6 "D-3" 8 27 28) (0 8 "C-8" 10 24 12)
                (8 7 "F-4" 9 24 12) (24 7 "D-4" 9 25 16))))
          (list "Released room" (empty-pattern 2)))
        '("docs/music/tools/rock-wave-sketches.sgl")
        "Style demo I: guitar-led FM rock, picked bass and a rock kit."
        "Muted/open guitar articulation, straight timing and explicit release. No existing track changed."
        "2026-09-23")
      (write-album motif output "after-image" "After Image"
        (base "After Image" 108 WAVE-BANK #f)
        (list
          (list "Wide pads / pulse emerges" (wave-band 4 #f #t))
          (list "Low-pressure neon theme" (wave-band 8 #f #f))
          (list "Snare and tom lift" (transition #f))
          (list "Big kit / full pad and lead theme" (wave-band 8 #t #f))
          (list "F-minor resolution"
            (phrase 2
              '((0 1 "C-2" 1 44 4) (0 2 "F#3" 2 34 4)
                (0 4 "F-2" 4 31 16) (0 5 "F-3" 5 28 40)
                (0 6 "F-3" 6 26 40) (0 8 "C-8" 9 24 12)
                (0 7 "G#4" 8 28 12) (16 7 "G-4" 8 25 8)
                (24 7 "F-4" 8 27 18))))
          (list "Released room" (empty-pattern 2)))
        '("docs/music/tools/rock-wave-sketches.sgl")
        "Style demo I: dark retrowave with large drums, octave pulse and wide harmonic pads."
        "Minor/major chord colors, a sustained theme and explicit release. No existing track changed."
        "2026-09-23"))))
