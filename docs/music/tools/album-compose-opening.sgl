#!/usr/bin/env sigil
;;; Cold Boot and Relay Ghost: standalone album arrangements, not game loops.
(import (sigil args) (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define (cold-boot source)
  (let* ((intro
           (transform (pattern source 0)
             (lambda (row cell)
               (cond
                 ((and (< row 64) (member (car cell) '(3 6))) #f)
                 ((and (< row 128) (member (car cell) '(2 5))) #f)
                 ((= (car cell) 6) (level cell 0.9))
                 (else cell)))))
         (bridge
           (add-notes
             (transform (pattern source 2)
               (lambda (row cell)
                 (cond
                   ((member (car cell) '(6 7)) #f)
                   ((and (< row 128) (= (car cell) 2)) #f)
                   ((and (< row 128) (= (car cell) 1)
                         (not (= (modulo row 32) 0))) #f)
                   ((member (car cell) '(3 5)) (level cell 0.75))
                   (else cell))))
             '((0 7 "G-3" 9 12 15)
               (32 7 "D#4" 9 13 19)
               (68 7 "D-4" 9 11 11)
               (96 7 "C-4" 9 12 19)
               (128 7 "G-3" 9 12 15)
               (160 7 "A#3" 9 13 19)
               (196 7 "D#4" 9 12 15)
               (224 7 "C-4" 9 13 19))))
         (development
           (add-notes
             (transform (pattern source 7)
               (lambda (row cell)
                 (cond
                   ((= (car cell) 7) #f)
                   ((and (= (car cell) 6) (attack? cell)
                         (member row '(76 124 252)))
                    (append (list 6 (cond ((= row 76) "G-2")
                                         ((= row 124) "A#2")
                                         (else "C-3")))
                            (skip cell 2)))
                   (else cell))))
             '((32 7 "C-4" 9 13 15)
               (80 7 "D#4" 9 14 15)
               (144 7 "G-3" 9 12 15)
               (192 7 "A#3" 9 13 15)
               (224 7 "C-4" 9 14 19))))
         (ending
           (add-notes
             (transform (pattern source 0)
               (lambda (row cell)
                 (cond
                   ((>= row 128) #f)
                   ((member (car cell) '(2 3 5 6)) (level cell 0.75))
                   (else cell))))
             '((128 1 "C-2" 1 38 7)
               (132 4 "C-2" 4 25 7)
               (134 5 "C-3" 6 18 11)
               (144 7 "G-4" 9 13 15)
               (176 7 "D#4" 9 12 19)
               (192 4 "C-2" 4 22 7)
               (198 5 "C-3" 6 15 11)
               (208 7 "C-4" 9 12 23)))))
    (list
      (list "Pulse assembles: kick/sub, grain, pressure, knock" intro)
      (list "Machine theme" (pattern source 0))
      (list "First distant reply" (pattern source 1))
      (list "Friction and drum space" (pattern source 2))
      (list "Exposed mechanism / new bell answer" bridge)
      (list "Groove reassembles" (pattern source 3))
      (list "Calm turnaround" (pattern source 4))
      (list "Accepted integrated machine fill" (pattern source 5))
      (list "Pressure opens" (pattern source 6))
      (list "Darker pressure answer" (pattern source 7))
      (list "Chromatic pressure / drum break" (pattern source 8))
      (list "New low-register pressure response" development)
      (list "Final pressure statement" (pattern source 9))
      (list "Pressure turnaround" (pattern source 10))
      (list "Stripped return / G-Eb-C shutdown" ending)
      (list "Released room tail" (empty-pattern 2)))))

(define (relay-ghost source)
  (let ((intro
          (phrase 4
            '((0 7 "E-4" 9 19 11)
              (4 5 "E-3" 6 18 11)
              (12 7 "B-3" 9 18 7)
              (24 7 "D-4" 9 17 15)
              (44 7 "F#4" 9 17 7)
              (56 7 "E-4" 9 18 11)
              (64 4 "E-2" 4 27 5)
              (68 3 "C-8" 3 14 3)
              (68 6 "B-4" 8 17 7)
              (80 6 "G-4" 8 17 7)
              (84 3 "C-8" 3 14 3)
              (92 6 "F#4" 8 17 7)
              (96 4 "E-2" 4 26 5)
              (100 3 "C-8" 3 14 3)
              (104 6 "E-4" 8 18 11)
              (116 3 "C-8" 3 14 3)
              (116 6 "B-3" 8 16 7))))
        (bridge
          (phrase 8
            '((0 4 "E-2" 4 27 7)
              (4 5 "E-3" 6 20 15)
              (8 7 "B-3" 9 17 11)
              (24 7 "D-4" 9 16 11)
              (40 7 "F#4" 9 17 7)
              (52 7 "E-4" 9 18 11)
              (64 4 "A-1" 4 26 7)
              (68 5 "A-2" 6 20 15)
              (72 7 "E-4" 9 17 11)
              (88 7 "C-4" 9 16 11)
              (104 7 "B-3" 9 16 7)
              (116 7 "A-3" 9 18 11)
              (128 1 "C-2" 1 35 5)
              (128 4 "B-1" 4 27 7)
              (132 5 "B-2" 6 20 15)
              (136 6 "F#4" 8 18 11)
              (152 6 "D-4" 8 17 11)
              (168 6 "C#4" 8 17 7)
              (180 6 "B-3" 8 19 11)
              (192 1 "C-2" 1 37 5)
              (192 4 "E-2" 4 28 7)
              (196 5 "E-3" 6 21 15)
              (196 3 "C-8" 3 16 3)
              (200 7 "G-3" 9 17 11)
              (212 3 "C-8" 3 16 3)
              (216 7 "B-3" 9 17 11)
              (228 3 "C-8" 3 16 3)
              (232 7 "E-4" 9 18 19)
              (244 3 "C-8" 3 16 3))))
        (ending
          (phrase 8
            '((0 1 "C-2" 1 38 5)
              (0 4 "E-2" 4 28 7)
              (0 7 "E-4" 9 19 11)
              (4 5 "E-3" 6 19 11)
              (12 7 "B-3" 9 18 7)
              (24 7 "D-4" 9 17 15)
              (44 7 "F#4" 9 17 7)
              (56 7 "E-4" 9 18 11)
              (64 4 "A-1" 4 26 7)
              (68 5 "A-2" 6 18 11)
              (72 6 "E-4" 8 17 11)
              (88 6 "C-4" 8 16 11)
              (104 6 "B-3" 8 16 7)
              (116 6 "A-3" 8 18 11)
              (128 4 "B-1" 4 24 7)
              (132 5 "B-2" 6 17 11)
              (136 7 "F#4" 9 17 11)
              (156 7 "D-4" 9 16 15)
              (176 7 "B-3" 9 16 11)
              (192 4 "E-2" 4 23 7)
              (196 5 "E-3" 6 17 15)
              (200 7 "G-3" 9 16 15)
              (224 7 "E-3" 9 17 19)))))
    (append
      (list (list "Opening signal / pluck reflection" intro))
      (map (lambda (id)
             (list (str "Calm phrase " (+ id 1)) (pattern source id)))
           '(0 1 2))
      (list (list "Exposed E-A-B-E signal bridge" bridge))
      (map (lambda (id)
             (list (str "Calm return " (- id 2)) (pattern source id)))
           '(3 4))
      (list (list "Original rising transition" (pattern source 5)))
      (map (lambda (id)
             (list (str "Focused phrase " (- id 5)) (pattern source id)))
           '(6 7 8 9 10))
      (list
        (list "Bell returns as pressure recedes"
          (transform (pattern source 3)
            (lambda (row cell)
              (cond
                ((= (car cell) 8) #f)
                ((member (car cell) '(1 2 3)) (level cell 0.8))
                (else cell)))))
        (list "Final call and answer / E-minor resolution" ending)
        (list "Released room tail" (empty-pattern 2))))))

(cli "album-compose-opening" (script-args)
  (list (option name: 'relay-revision long: "relay-revision" value: "REVISION"
                choices: '("i" "ii") default: "ii"))
  (lambda (options)
    (let ((motif (require-tool (option-ref options 'motif)))
          (output (option-ref options 'output)))
      (check (not (option-ref options 'tracks)) "This composer produces both opening tracks")
      (each spec (list (list "cold-boot" "Cold Boot" cold-boot)
                       (list "relay-ghost" "Relay Ghost" relay-ghost))
        (let* ((slug (car spec))
               (reference (str "assets/tunes/" slug ".cts"))
               (source (read-score (path (root) reference)))
               (revised? (and (equal? slug "relay-ghost")
                              (equal? (option-ref options 'relay-revision) "ii")))
               (mix-reference "docs/music/alternates/relay-bass-balance-i/gritty-bass-down.cts")
               (base
                 (if revised?
                     (replace-child source 'instruments
                       (child (read-score (path (root) mix-reference)) 'instruments))
                     source)))
          (apply write-album
            (append
              (list motif output slug (cadr spec) base ((caddr spec) source)
                    (if revised? (list reference mix-reference) (list reference)))
              (if revised?
                  '("Relay Ghost album II: approved contact/dust drums, original bell and pluck, gritty bass output 2 dB lower."
                    "Album-I arrangement and note dynamics retained. Selected mix is pinned to the gritty-bass-down audition; requires Motif instrument gain support."
                    "2026-09-22")
                  '())))
          (when revised?
            (let* ((written (read-score (path output "relay-ghost.cts")))
                   (bass (list-find (lambda (i) (= (field i id:) 19))
                                    (cdr (child written 'instruments)))))
              (check (and (member gain: bass)
                          (< (abs (- (field bass gain:) 0.7943282347242815)) 0.00000001))
                     "Album II requires a Motif renderer with instrument gain support"))))))))
