#!/usr/bin/env sigil
;;; Check bass/guitar agreement and preserve the accepted sound and other parts.
(import (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack tools)
        (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define DIRECTORY "docs/music/alternates/fault-line-bass-lock-vii")
(define (attacks ts)
  (filter (lambda (t) (= (list-ref t 5) 1)) ts))
(define (aligned bass guitar)
  (filter (lambda (b) (any (lambda (g) (= (car b) (car g))) guitar)) bass))

(cli "fault-line-bass-lock-audit" (script-args) '()
  (lambda (options)
    (let* ((motif (require-tool (option-ref options 'motif)))
           (before (path (root) DIRECTORY "fault-line-before.cts"))
           (after (path (root) DIRECTORY "fault-line-after.cts"))
           (old (read-score before))
           (new (read-score after))
           (a (attacks (ticks motif before 4)))
           (b (attacks (ticks motif after 4)))
           (guitar (attacks (ticks motif after 5)))
           (old-aligned (aligned a guitar))
           (new-aligned (aligned b guitar)))
      (check (equal? (child old 'instruments) (child new 'instruments))
             "Instrument patch or level changed")
      (check (equal? (child old 'bus) (child new 'bus)) "Bus changed")
      (each channel '(1 2 3 5 6 7 8)
        (check (equal? (ticks motif before channel) (ticks motif after channel))
               "Non-bass performance changed" channel))
      (check (and (> (/ (length new-aligned) (length b)) 0.9)
                  (> (/ (length new-aligned) (length b))
                     (/ (length old-aligned) (length a))))
             "Bass does not share more guitar attacks")
      ;; Shared attacks use exactly the guitar pitch one octave below it.
      (each bass new-aligned
        (let ((g (list-find (lambda (t) (= (car t) (car bass))) guitar)))
          (check (< (abs (- (/ (list-ref g 2) (list-ref bass 2)) 2)) 0.0001)
                 "Bass and guitar pitch disagree" (car bass))))
      ;; Check corresponding release cells in the revised riff and entrance.
      (each p (filter (lambda (p) (< (field p id:) 4))
                     (cdr (child new 'patterns)))
        (each row (skip p 5)
          (let ((bass (assoc 4 (cddr row)))
                (guitar (assoc 5 (cddr row))))
            (when (and bass guitar (attack? bass) (attack? guitar))
              (let* ((later (filter (lambda (r) (> (cadr r) (cadr row))) (skip p 5)))
                     (bass-end (list-find (lambda (r) (assoc 4 (cddr r))) later))
                     (guitar-end (list-find (lambda (r) (assoc 5 (cddr r))) later)))
                (check (and bass-end guitar-end
                            (= (cadr bass-end) (cadr guitar-end)))
                       "Shared accent releases disagree"
                       (field p id:) (cadr row)))))))
      (ensure-directory (option-ref options 'output))
      (write-json-file (path (option-ref options 'output) "bass-lock-checks.json")
        (dict old_attacks: (length a)
              new_attacks: (length b)
              old_attacks_with_guitar: (length old-aligned)
              new_attacks_with_guitar: (length new-aligned)
              shared_attacks_agree_in_pitch_and_gate: #t
              patches_bus_and_non_bass_ticks_preserved: #t))
      (println "Bass/guitar accent, harmony, release and preservation checks passed."))))
