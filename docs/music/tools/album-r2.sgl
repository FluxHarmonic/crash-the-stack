#!/usr/bin/env sigil
;;; Separate the listening page from resumable, versioned public audio uploads.
(import (sigil args) (sigil json))
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(initialize (path (script-dir) "../../.."))

(cli "album-r2" (script-args)
  (list (option name: 'stage long: "stage" value: "STAGE"
                default: "prepare" choices: '("prepare" "upload"))
        (option name: 'bundle long: "bundle" value: "DIR")
        (option name: 'bucket long: "bucket" value: "NAME")
        (option name: 'prefix long: "prefix" value: "PREFIX"
                default: "soundtrack/preview-i")
        (option name: 'asset-base long: "asset-base" value: "URL"))
  (lambda (options)
    (let* ((output (option-ref options 'output))
           (stage (option-ref options 'stage))
           (plan-file (path output "upload-plan.json")))
      (check (and (starts-with? output "/")
                  (not (starts-with? output (str (root) "/"))))
             "Supply an external absolute output directory")
      (if (equal? stage "prepare")
          (let* ((bundle (option-ref options 'bundle))
                 (base (option-ref options 'asset-base))
                 (prefix (option-ref options 'prefix))
                 (bucket (option-ref options 'bucket))
                 (album (json-decode (read-text (path bundle "album.json"))))
                 (tracks (array->list (dict-ref album tracks:)))
                 (site (path output "soundtrack"))
                 (uploads '())
                 (public-tracks '()))
            (check (and base (starts-with? base "https://") (ends-with? base "/"))
                   "Supply an HTTPS --asset-base URL ending in /; it must include the prefix")
            (check (and bucket (not (equal? prefix ""))
                        (not (contains? prefix ".."))
                        (not (starts-with? prefix "/")))
                   "Supply a bucket and relative object prefix")
            (check (not (file-exists? output)) "Use a fresh output directory")
            (ensure-directory site)
            (check (not (starts-with? (str (realpath output) "/") (str (root) "/")))
                   "Output resolves inside the repository")
            (each track tracks
              (let* ((relative (dict-ref track mp3:))
                     (filename (basename relative))
                     (source (path bundle relative))
                     (key (str prefix "/" filename))
                     (hash (car (split (out sha256sum ,source) " "))))
                (set! uploads
                  (append uploads
                    (list (dict source: source
                                key: key
                                sha256: hash
                                bytes: (file-size source)
                                type: "audio/mpeg"))))
                (set! public-tracks
                  (append public-tracks
                    (list (dict title: (dict-ref track title:)
                                duration_seconds: (dict-ref track duration_seconds:)
                                mp3: (str base filename)))))))
            (each filename '("index.html" "style.css" "player.js")
              (copy-file
                (path (root) "docs/music/album/listen" filename)
                (path site filename)))
            (write-json-file (path site "album.json")
              (dict title: (dict-ref album title:)
                    version: (dict-ref album version:)
                    duration_seconds: (dict-ref album duration_seconds:)
                    tracks: (list->array public-tracks)))
            (write-json-file plan-file
              (dict bucket: bucket
                    asset_base: base
                    uploads: (list->array uploads)))
            (display (str "Prepared page and upload plan in " output "\n")))
          ;; Uploads go through R2's S3 API (scripts/r2-s3): Crash's token holds
          ;; Bucket Item Read/Write on its own buckets only, and wrangler's
          ;; `r2 object` REST path refuses such a token. Each key is read first:
          ;; absent (r2-s3 exit 3) is put, read back and compared; present is
          ;; compared and never overwritten; anything else stops the upload.
          ;; A receipt is written only once R2 is known to hold these bytes.
          (let* ((plan (json-decode (read-text plan-file)))
                 (bucket (dict-ref plan bucket:))
                 (receipts (path output "receipts"))
                 (r2 (path (root) "scripts/r2-s3"))
                 (sha (lambda (file) (car (split (out sha256sum ,file) " "))))
                 (set? (lambda (name)
                         (let ((v (getenv name))) (and v (not (equal? v "")))))))
            (check (file? r2) "scripts/r2-s3 is missing" r2)
            (check (and (set? "CLOUDFLARE_API_TOKEN") (set? "CLOUDFLARE_ACCOUNT_ID"))
                   "Set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID: eval \"$(~/Ops/scripts/cf-env crash)\"")
            (ensure-directory receipts)
            (with-temp-dir work
              (each item (array->list (dict-ref plan uploads:))
                (let* ((source (dict-ref item source:))
                       (key (dict-ref item key:))
                       (hash (dict-ref item sha256:))
                       (back (path work "back"))
                       (receipt (path receipts (str (basename key) ".sha256"))))
                  (check (equal? hash (sha source))
                         "Source changed since preparation" source)
                  (if (and (file? receipt) (equal? (trim (read-text receipt)) hash))
                      (display (str "Already uploaded " key "\n"))
                      (let* ((found ($? ,r2 get ,bucket ,key ,back))
                             (status (exit-status found)))
                        (cond
                          ((equal? status 0)
                           (check (equal? hash (sha back))
                                  "Refusing: the bucket already holds OTHER bytes at this key; use a new prefix"
                                  (str bucket "/" key))
                           (display (str "Already in " bucket ", identical: " key "\n")))
                          ((equal? status 3)
                           (display (str "Uploading " key "\n"))
                           (let ((put ($? ,r2 put ,bucket ,key ,source ,(dict-ref item type:)
                                          "public, max-age=31536000, immutable")))
                             (check (ok? put) "R2 upload failed" key (stderr-of put)))
                           (let ((again ($? ,r2 get ,bucket ,key ,back)))
                             (check (ok? again) "R2 read-back failed" key (stderr-of again)))
                           (check (equal? hash (sha back))
                                  "R2 read-back differs from the source" key))
                          (else
                           (error "Could not read the key from R2 (refused or failed, not absent)"
                                  (str bucket "/" key) status (stderr-of found))))
                        (write-text receipt (str hash "\n"))))))))))))
