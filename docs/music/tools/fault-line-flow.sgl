#!/usr/bin/env sigil
;;; Style V: independent picked bass and a moving, riff-led solo entrance.
(import (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack tools) (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define BASELINE "docs/music/alternates/fault-line-groove-iv/fault-line-after.cts")
;;; Each bar: (row pitch held-rows level). Repeated motifs develop over harmony.
(define BASS-BARS
  '(((0 "D-1" 5 35) (8 "A-1" 2 29) (12 "D-2" 6 32)
     (20 "F-2" 2 29) (24 "E-2" 2 26) (28 "D-2" 3 33))
    ((0 "D-1" 5 34) (6 "C-2" 2 28) (10 "A-1" 4 31)
     (16 "C-2" 2 28) (22 "D-2" 3 32) (28 "A-1" 3 28))
    ((0 "A#1" 5 35) (8 "F-1" 2 29) (12 "A#1" 6 32)
     (20 "D-2" 2 29) (24 "C-2" 2 26) (28 "A#1" 3 33))
    ((0 "A#1" 6 34) (8 "D-2" 3 29) (14 "F-2" 4 30)
     (22 "D-2" 3 31) (28 "A-1" 3 28))
    ((0 "G-1" 5 35) (8 "D-2" 2 29) (12 "G-1" 6 32)
     (20 "A#1" 2 29) (24 "A-1" 2 26) (28 "G-1" 3 33))
    ((0 "G-1" 5 34) (6 "F-1" 2 28) (10 "D-1" 4 31)
     (16 "F-1" 2 28) (22 "G-1" 3 32) (28 "G-1" 3 28))
    ((0 "A-1" 5 35) (8 "E-2" 2 29) (12 "A-1" 6 32)
     (20 "C-2" 2 29) (24 "A#1" 2 26) (28 "A-1" 3 33))
    ((0 "A-1" 6 34) (8 "C-2" 2 29) (12 "E-2" 3 30)
     (18 "G-2" 2 28) (22 "E-2" 3 31) (28 "C-2" 3 28))))

(define (clear-channels p channels)
  (transform p
    (lambda (row cell) (and (not (member (car cell) channels)) cell))))

(define (bass-section p heavy?)
  (let ((result (clear-channels p '(4))))
    (let loop ((bar 0))
      (when (< bar (quotient (field p rows:) 32))
        (each spec (list-ref BASS-BARS bar)
          (set! result
            (add-notes result
              (list (list (+ (* bar 32) (car spec))
                          4 (cadr spec) 4
                          (+ (list-ref spec 3) (if heavy? 1 0))
                          (caddr spec))))))
        (loop (+ bar 1))))
    result))

(define (bass-body inst)
  (let* ((patch (field inst patch:))
         (patch (set-field patch op1: '(1 0.8 0.002 0.25 0.68 0.045)))
         (patch (set-field patch amp-decay: 0.24))
         (patch (set-field patch amp-sustain: 0.65))
         (patch (set-field patch amp-release: 0.045)))
    (append
      (set-field inst patch: patch)
      '(layers:
         ((chip-sub
            osc-amp: 0.7 drive: 0.06
            attack: 0.003 decay: 0.18 sustain: 0.72 release: 0.04
            octave: 0 volume: 0.5))))))

(define (moving-transition p)
  (let ((result (clear-channels p '(1 4 5 6))))
    ;; Keep the riff's accents moving; no long opening chord or empty half-bar.
    (each spec '((0 "A-2" 3 #f) (6 "A-2" 1 #f) (10 "A-2" 3 #f)
                 (16 "A-2" 2 #t) (20 "C-3" 1 #f) (22 "D-3" 1 #f)
                 (28 "A-2" 3 #f) (32 "A-2" 2 #f) (36 "A-2" 2 #f)
                 (42 "C-3" 2 #f) (46 "A-2" 2 #f) (50 "E-3" 2 #t)
                 (54 "D-3" 2 #f) (58 "D-3" 1 #f) (62 "D-3" 1 #f))
      (let ((row (car spec))
            (pitch (cadr spec))
            (held (caddr spec))
            (open? (list-ref spec 3)))
        (set! result
          (add-notes result
            (list
              (list row 5 pitch (if open? 6 5) (if (< row 32) 31 33) held)
              (list row 6 pitch (if open? 8 7) (if (< row 32) 23 25) held))))))
    (each spec '((0 "A-1" 5 34) (8 "E-2" 2 29) (12 "A-1" 4 32)
                 (18 "C-2" 3 30) (24 "A#1" 2 27) (28 "A-1" 3 33)
                 (32 "A-1" 5 35) (38 "C-2" 2 30) (42 "E-2" 3 32)
                 (46 "F-2" 2 30) (50 "E-2" 2 33) (54 "G-1" 2 30)
                 (58 "A-1" 2 32) (62 "C-2" 1 31))
      (set! result
        (add-notes result
          (list (list (car spec) 4 (cadr spec) 4 (list-ref spec 3) (caddr spec))))))
    (each row '(0 10 16 28 32 42 50 58 62)
      (set! result
        (add-notes result
          (list (list row 1 "C-2" 1 (if (< row 32) 42 46)
                      (if (= row 62) 1 3))))))
    result))

(define (revise before)
  (let* ((bank
           (map (lambda (i) (if (= (field i id:) 4) (bass-body i) i))
                (cdr (child before 'instruments))))
         (patterns
           (map
             (lambda (p)
               (case (field p id:)
                 ((0 1) (bass-section p #f))
                 ((2) (moving-transition p))
                 ((3) (bass-section p #t))
                 ((4)
                  (add-notes (clear-channels p '(4)) '((0 4 "D-1" 4 35 22))))
                 (else p)))
             (cdr (child before 'patterns))))
         (after (replace-child before 'instruments (cons 'instruments bank)))
         (after (replace-child after 'patterns (cons 'patterns patterns))))
    (each p (cdr (child before 'patterns))
      (let ((allowed (if (= (field p id:) 2) '(1 4 5 6) '(4))))
        (check (equal? (clear-channels p allowed)
                      (clear-channels (pattern after (field p id:)) allowed))
               "Accepted groove, lead or kit changed outside the revision"
               (field p id:))))
    (check (equal? (child before 'bus) (child after 'bus)) "Bus changed")
    (replace-child after 'history
      (append (child after 'history)
        '(("codex" "2026-09-23"
           "Style V: independent picked bass with low D anchors and a clean fundamental layer; continuously moving two-bar solo entrance. Accepted rhythm guitar writing outside the entrance, lead bends and kit timbres retained."))))))

(define (slice p start rows)
  (append (list 'pattern id: 0 rows: rows)
    (map (lambda (row) (append (list 'row (- (cadr row) start)) (cddr row)))
         (filter (lambda (row) (and (>= (cadr row) start) (< (cadr row) (+ start rows))))
                 (skip p 5)))))

(define (context score)
  (list (list "Four pocket bars with independent bass" (slice (pattern score 1) 128 128))
        (list "Two-bar solo entrance" (pattern score 2))
        (list "First two solo bars" (slice (pattern score 3) 0 64))
        (list "Released room" (empty-pattern 2))))

(cli "fault-line-flow" (script-args) '()
  (lambda (options)
    (let* ((motif (require-tool (option-ref options 'motif)))
           (output (option-ref options 'output))
           (before (read-score (path (root) BASELINE)))
           (after (revise before)))
      (each variant (list (list "before" before) (list "after" after))
        (write-canonical motif (path output (str "fault-line-" (car variant) ".cts"))
                         (cadr variant))
        (write-album
          motif output (str "fault-line-context-" (car variant)) "Fault Line"
          (cadr variant) (context (cadr variant))
          (list BASELINE "docs/music/tools/fault-line-flow.sgl")
          "Style V: four pocket bars, moving entrance, two solo bars and two release bars."
          "Before is Style IV; after adds an independent bass line/body and removes the transition pause."
          "2026-09-23"))
      (write-json-file (path output "comparison.json")
        (dict slug: "fault-line"
              title: "Fault Line"
              audition: "style-v"
              full_duration_seconds: (/ (* 26 32 7.5) 126)
              comment: "BEFORE Style IV, then AFTER Style V: independent bass/body and moving solo entrance. Same solo and established guitar groove. Equal gain."
              clips:
                (list->array
                  (map (lambda (variant)
                         (dict stem: (str "fault-line-context-" variant)
                               label: variant
                               duration_seconds: (/ (* 10 32 7.5) 126)))
                       '("before" "after"))))))))
