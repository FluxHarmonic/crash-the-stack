#!/usr/bin/env sigil
;;; Package the selected album auditions beneath soundtrack/ in an external tree.
(import (sigil args) (sigil json))
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(initialize (path (script-dir) "../../.."))
(requires (tools ffmpeg ffprobe sha256sum))

(define TRACKS
  '(("black-glass" "master-trial-i")
    ("cold-boot" "opening-pair-i")
    ("relay-ghost" "opening-pair-i")
    ("closed-loop" "signals-pair-i")
    ("shadow-protocol" "signals-pair-i")
    ("blind-spot" "air-pair-i")
    ("quiet-array" "master-trial-i")
    ("sector-drift" "air-pair-i")
    ("dirty-cache" "pocket-pair-i")
    ("basement-circuit" "pocket-pair-i")
    ("dead-sector" "stone-pair-i")
    ("obsidian-index" "stone-pair-i")
    ("breach-vector" "edge-pair-i")
    ("clock-edge" "edge-pair-i")
    ("glass-current" "closer-i")))
(define MAX-ASSET-BYTES (* 25 1024 1024))

(define (probe file)
  (json ffprobe -v error -show_format -show_streams -of json ,file))

(define (check-audio file duration)
  (let* ((data (probe file))
         (stream (array-ref (dict-ref data streams:) 0))
         (actual (string->number (dict-ref (dict-ref data format:) duration:))))
    (check (and (= 2 (dict-ref stream channels:))
                (equal? "44100" (dict-ref stream sample_rate:))
                (< (abs (- actual duration)) 0.1))
           "Unexpected audio format or duration" file)
    (check (< 0 (file-size file) MAX-ASSET-BYTES)
           "Audio exceeds Pages asset limit" file)))

(cli "album-listening-site" (script-args)
  (list (option name: 'artifacts long: "artifacts" value: "DIR"))
  (lambda (options)
    (let* ((artifacts (option-ref options 'artifacts))
           (output (option-ref options 'output))
           (site (path output "soundtrack"))
           (audio (path site "audio"))
           (report (path output "build-report.json"))
           (manifest '())
           (provenance '())
           (duration 0)
           (mp3-bytes 0))
      (check (and artifacts (directory? artifacts))
             "Supply --artifacts with the existing album render root")
      (check (and (starts-with? output "/")
                  (not (file-exists? output)))
             "Supply a fresh absolute --output directory")
      (ensure-directory output)
      (check (not (starts-with? (str (realpath output) "/")
                                (str (root) "/")))
             "Output must remain outside the repository")
      (ensure-directory audio)
      (each spec TRACKS
        (let* ((slug (car spec))
               (directory (path artifacts (cadr spec)))
               (suffix (if (equal? (cadr spec) "master-trial-i")
                           "-master-trial-i-album-level"
                           "-album-i"))
               (stem (str slug suffix))
               (wav (path directory (str stem ".wav")))
               (mp3-target (path audio (str slug ".mp3")))
               (source (path (root) "docs/music/album" (str slug ".cts")))
               (snapshot (path directory (str slug ".cts")))
               (section-map
                 (json-decode
                   (read-text
                     (path (root) "docs/music/album" (str slug "-map.json")))))
               (title (dict-ref section-map title:))
               (seconds (dict-ref section-map duration_seconds:))
               (argv (list "ffmpeg" "-v" "error" "-nostdin" "-n"
                           "-i" wav "-map" "0:a:0" "-c:a" "libmp3lame"
                           "-b:a" "256k" "-metadata" (str "title=" title)
                           mp3-target)))
          (check (equal? (read-text source) (read-text snapshot))
                 "Album source has changed since this render" slug)
          (check (file? wav) "Missing master WAV" wav)
          (run-tool argv)
          (check-audio mp3-target seconds)
          (set! duration (+ duration seconds))
          (set! mp3-bytes (+ mp3-bytes (file-size mp3-target)))
          (set! manifest
            (append manifest
              (list (dict title: title
                          duration_seconds: seconds
                          mp3: (str "audio/" slug ".mp3")))))
          (set! provenance
            (append provenance
              (list (dict slug: slug
                          source_sha256: (out sha256sum ,source)
                          wav_sha256: (out sha256sum ,wav)
                          mp3_sha256: (out sha256sum ,mp3-target)
                          mp3_command: (list->array argv)))))
          (display (str "Packaged " title "\n"))))
      (each filename '("index.html" "style.css" "player.js")
        (copy-file
          (path (root) "docs/music/album/listen" filename)
          (path site filename)))
      (write-json-file (path site "album.json")
        (dict title: "Crash The Stack — Original Soundtrack"
              version: "Preview I"
              duration_seconds: duration
              tracks: (list->array manifest)))
      ;; This private provenance report lives outside soundtrack/, the public set.
      (write-json-file report
        (dict duration_seconds: duration
              mp3_bytes: mp3-bytes
              tracks: (list->array provenance)))
      (display (str "Built " site "\n"))
      (display (str "MP3 bytes: " mp3-bytes "\n"))
      (print "Publish soundtrack/ only; build-report.json is private provenance."))))
