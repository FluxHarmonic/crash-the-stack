#!/usr/bin/env sigil
;;; Exercise source propagation and tracker-edit protection in an isolated tree.
(import (sigil json) (sigil list))
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(load (path (script-dir) "lib/song-source.sgl"))
(import (crash soundtrack tools)
        (crash soundtrack album arrangement)
        (crash soundtrack songs))
(initialize (path (script-dir) "../../.."))

(define (fails? thunk)
  (guard (condition (else #t))
    (thunk)
    #f))

(cli "songs-test" (script-args) '()
  (lambda (options)
    (let ((repository (root))
          (motif (require-tool (option-ref options 'motif)))
          (slugs '("relay-ghost" "breach-vector")))
      (with-temp-dir fixture
        (define (copy-relative file)
          (ensure-directory (dirname (path fixture file)))
          (copy-file (path repository file) (path fixture file)))
        (copy-relative "docs/music/catalog.json")
        (each slug slugs
          (let* ((directory (str "docs/music/songs/" slug))
                 (receipt (str directory "/generated.json"))
                 (baseline (json-decode (read-text (path repository receipt)))))
            (copy-relative (str directory ".sgl"))
            (each file '("parts.cts" "arrangements.sgl" "generated.json")
              (copy-relative (str directory "/" file)))
            (each output (array->list (dict-ref baseline outputs:))
              (copy-relative (dict-ref output path:)))))
        (initialize fixture)
        (define (plans) (map (lambda (slug) (song-plan slug motif)) slugs))
        (apply-song-plans (plans) "write" #f)
        (apply-song-plans (plans) "check" #f)
        (let* ((source-file (path fixture "docs/music/songs/relay-ghost/parts.cts"))
               (source (read-score source-file))
               (edited
                 (replace-child source 'instruments
                   (cons 'instruments
                     (map (lambda (i)
                            (if (= (field i id:) 2)
                                (set-field i name: "shared-test-snare") i))
                          (cdr (child source 'instruments))))))
               (game-file (path fixture "assets/tunes/relay-ghost.cts"))
               (album-file (path fixture "docs/music/album/relay-ghost.cts"))
               (tracker-file (path fixture "docs/music/album/breach-vector.cts"))
               (tracker-original (read-text tracker-file))
               (old-game (read-text game-file))
               (old-album (read-text album-file)))
          ;; A shared phrase edit must reach both game pattern 0 and album 1.
          (let* ((p (pattern edited 0))
                 (row (list-find
                        (lambda (r) (let ((c (assoc 7 (cddr r)))) (and c (attack? c))))
                        (skip p 5)))
                 (cell (assoc 7 (cddr row)))
                 (changed (append '(7 "F#4") (skip cell 2))))
            (set! edited
              (replace-child edited 'patterns
                (cons 'patterns
                  (map (lambda (p)
                         (if (= (field p id:) 0) (put-cell p (cadr row) changed) p))
                       (cdr (child edited 'patterns))))))
            (write-text source-file (score-text edited))
            (check (fails? (lambda () (apply-song-plans (plans) "check" #f)))
                   "Source drift check unexpectedly passed")
            ;; Edit the final song in the batch: the earlier song must not write.
            (write-text tracker-file (str tracker-original "; tracker edit must survive\n"))
            (let ((tracker-edit (read-text tracker-file)))
              (check (fails? (lambda () (apply-song-plans (plans) "write" #f)))
                     "Tracker edit did not block generation")
              (check (and (equal? old-game (read-text game-file))
                          (equal? old-album (read-text album-file))
                          (equal? tracker-edit (read-text tracker-file)))
                     "Failed preflight modified an output"))
            (write-text tracker-file tracker-original)
            (apply-song-plans (plans) "write" #f)
            (each pair (list (list game-file 0) (list album-file 1))
              (let* ((generated (read-score (car pair)))
                     (snare (list-find (lambda (i) (= (field i id:) 2))
                                      (cdr (child generated 'instruments))))
                     (p (pattern generated (cadr pair)))
                     (r (list-find (lambda (r) (= (cadr r) (cadr row))) (skip p 5))))
                (check (equal? (field snare name:) "shared-test-snare")
                       "Shared instrument failed to propagate" (car pair))
                (check (equal? (cadr (assoc 7 (cddr r))) "F#4")
                       "Shared phrase failed to propagate" (car pair))))
            (apply-song-plans (plans) "check" #f)
            ;; Tracker edits to the phrase pool must never be silently discarded.
            (each cell '((8 "===" 0 0 "000") (8 "..." 0 0 "B00"))
              (let ((invalid
                      (replace-child edited 'patterns
                        (cons 'patterns
                          (map (lambda (p)
                                 (if (= (field p id:) 0)
                                     (put-cell p 0 cell)
                                     p))
                               (cdr (child edited 'patterns)))))))
                (write-text source-file (score-text invalid))
                (check (fails? (lambda () (song-plan "relay-ghost" motif)))
                       "Arrangement-only edit was accepted in the phrase pool" cell)))
            (write-text source-file (score-text edited))))
        (initialize repository)
        (display "PASS: dual propagation, source drift, tracker-edit refusal, whole-batch preflight deterministic regeneration and arrangement-only edit refusal.\n")))))
