#!/usr/bin/env sigil
;;; Glass Current closes the album with its complete theme and natural decay.
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define (sections source ids label offset)
  (map (lambda (id)
         (list (str label (+ id offset)) (pattern source id)))
       ids))

(define (lower-octave pitch)
  (let ((octave (string->number (substring pitch 2 3))))
    (check (and octave (> octave 0)) "Invalid octave in lead response" pitch)
    (str (substring pitch 0 2) (- octave 1))))

(define (glass-current source)
  (let* ((intro
           (transform (pattern source 0)
             (lambda (row cell)
               (and (or (>= row 128) (member (car cell) '(5 6)))
                    (level cell
                           (if (member (car cell) '(1 2 3 4 8)) 0.75 1))))))
         (bridge
           (add-notes
             (transform (pattern source 1)
               (lambda (row cell)
                 (and (not (member (car cell) '(6 7)))
                      (or (>= row 128) (not (member (car cell) '(1 2 3 8))))
                      (level cell
                             (if (member (car cell) '(1 2 3 4 8)) 0.8 1)))))
             '((4 6 "G-3" 8 20 7)
               (16 6 "A#3" 8 18 7)
               (32 6 "D-4" 8 20 7)
               (44 6 "F-4" 8 18 7)
               (56 6 "D-4" 8 18 7)
               (68 6 "A-3" 8 20 7)
               (80 6 "F-4" 8 18 7)
               (104 6 "E-4" 8 18 7)
               (116 6 "D-4" 8 20 7)
               (132 6 "E-4" 8 20 7)
               (144 6 "G-4" 8 18 7)
               (160 6 "E-4" 8 18 7)
               (172 6 "C-4" 8 20 7)
               (184 6 "B-3" 8 18 7)
               (196 6 "A-4" 8 20 7)
               (208 6 "F-4" 8 18 7)
               (232 6 "E-4" 8 18 7)
               (244 6 "D-4" 8 20 9))))
         (development
           (transform (pattern source 10)
             (lambda (row cell)
               (if (and (= (car cell) 7) (attack? cell))
                   (append (list 7 (lower-octave (cadr cell))) (skip cell 2))
                   cell))))
         (reprise
           (transform (pattern source 0)
             (lambda (row cell)
               (level cell
                      (if (member (car cell) '(1 2 3 8)) 0.8 1)))))
         (withdrawal
           (transform (pattern source 1)
             (lambda (row cell)
               (and (or (< row 128) (not (member (car cell) '(2 3 8))))
                    (level cell
                           (if (member (car cell) '(1 2 3 4 8)) 0.7 1))))))
         (ending-a
           (phrase 8
             '((0 1 "C-2" 1 32 5)
               (0 4 "D-2" 4 26 8)
               (0 5 "D-3" 10 18 112)
               (4 6 "A-4" 8 20 7)
               (16 2 "F#3" 2 23 3)
               (16 6 "C-5" 8 18 7)
               (24 6 "A-4" 8 18 7)
               (32 1 "C-2" 1 30 5)
               (32 4 "D-2" 4 24 8)
               (40 6 "F-4" 8 20 7)
               (48 2 "F#3" 2 19 3)
               (56 6 "E-4" 8 18 7)
               (64 1 "C-2" 1 27 5)
               (64 4 "D-2" 4 23 8)
               (68 6 "A-4" 8 19 7)
               (80 6 "F-4" 8 18 7)
               (96 4 "D-2" 4 22 8)
               (104 6 "E-4" 8 17 7)
               (116 6 "D-4" 8 19 9)
               (128 4 "G-2" 4 23 8)
               (128 5 "G-3" 10 18 54)
               (136 6 "D-4" 8 18 7)
               (152 6 "A#3" 8 17 7)
               (160 4 "G-2" 4 21 8)
               (176 6 "G-3" 8 18 9)
               (192 4 "A-2" 4 22 8)
               (192 5 "A-3" 10 17 54)
               (200 6 "E-4" 8 18 7)
               (216 6 "C-4" 8 17 7)
               (224 4 "A-2" 4 20 8)
               (240 6 "B-3" 8 16 9))))
         (ending-b
           (phrase 4
             '((0 4 "D-2" 4 22 12)
               (0 5 "D-3" 10 18 96)
               (8 6 "A-3" 8 18 9)
               (32 4 "D-2" 4 18 10)
               (32 6 "F-4" 8 17 9)
               (56 6 "E-4" 8 16 9)
               (80 6 "D-4" 8 18 16)
               (96 6 "D-3" 8 14 8)))))
    (append
      (list (list "Exposed melodic theme / paper groove emerges" intro))
      (sections source '(0 1 2) "Calm current " 1)
      (list (list "Low pluck reflection / rhythm returns" bridge))
      (sections source '(3 4 5 6) "Calm return " -2)
      (list (list "Accepted quiet swell and integrated fill" (pattern source 7)))
      (sections source '(8 9 10 11) "Textured current " -7)
      (list (list "Lower lead call / complete pluck answer" development))
      (sections source '(12 13 14) "Focused return " -11)
      (list (list "Complete calm theme reprise" reprise)
            (list "Melodic return as the kit recedes" withdrawal)
            (list "Final D-G-A reflection" ending-a)
            (list "Last D-minor harmony / low tonic" ending-b)
            (list "Released album tail" (empty-pattern 2))))))

(cli "album-compose-closer" (script-args) '()
  (lambda (options)
    (let* ((motif (require-tool (option-ref options 'motif)))
           (output (option-ref options 'output))
           (reference "assets/tunes/glass-current.cts")
           (source (read-score (path (root) reference))))
      (check (not (option-ref options 'tracks))
             "This composer produces the Glass Current album closer")
      (write-album
        motif
        output
        "glass-current"
        "Glass Current"
        source
        (glass-current source)
        (list reference)
        "Album closer I: complete calm and focused phrases, exposed entrance, new pluck reflection, lower lead development, sixteen-bar calm return and twelve-bar harmonic ending. Accepted Paper Kit II patches and bus remain intact."
        "Keep corrected ghost-note timing, integrated fill, quiet swells and textured Reese balance. Final low D and explicit two-bar release; no playback jumps. Arranged with album-compose-closer.sgl."))))
