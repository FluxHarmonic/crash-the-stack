#!/usr/bin/env sigil
;;; Regenerate or check both checked-in arrangements from shared song sources.
(load (path (script-dir) "lib/core.sgl"))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(load (path (script-dir) "lib/song-source.sgl"))
(import (crash soundtrack songs))
(song-main (path (script-dir) "../../..")
           '("black-glass" "cold-boot" "relay-ghost" "closed-loop" "shadow-protocol"
             "blind-spot" "quiet-array" "sector-drift" "dirty-cache" "basement-circuit"
             "dead-sector" "obsidian-index" "breach-vector" "clock-edge" "glass-current")
           (script-args))
