#!/usr/bin/env sigil
;;; Exercise uploads against a local fake curl, never the network or real secrets.
(import (sigil list))
(requires (tools chmod))
(define sender (path (script-dir) "send-telegram.sgl"))
(define sigil-bin (or (getenv "SIGIL_BIN") "sigil"))

(define (expect condition label)
  (unless condition (error "Telegram control failed" label)))

(with-temp-dir work
  (let* ((fake (path work "curl"))
         (input (path work "track with spaces.ogg"))
         (env-file (path work "credentials.env"))
         (trace (path work "argv.txt"))
         (configuration (path work "config.txt"))
         (environment (dict "PATH" (str work ":" (getenv "PATH"))
                            "MOCK_TRACE" trace "MOCK_CONFIG" configuration)))
    (write-text input "dummy audio fixture")
    (write-text env-file "export TELEGRAM_BOT_TOKEN=\"123:dummy\"\nTELEGRAM_CHAT_ID='456' # comment\n")
    (write-text fake
      "#!/bin/sh\nprintf '%s\\n' \"$@\" >> \"$MOCK_TRACE\"\ncat > \"$MOCK_CONFIG\"\nprintf '%s\\n' '{\"ok\":true,\"result\":{\"message_id\":123}}'\n")
    ($ chmod +x ,fake)
    (let ((result ($? ,sigil-bin ,sender --env-file ,env-file ,input env: ,environment)))
      (expect (ok? result) "acknowledged upload")
      (expect (contains? (stdout-of result) "message 123") "message receipt")
      (expect (not (contains? (read-text trace) "dummy")) "token absent from argv")
      (expect (contains? (read-text configuration) "123:dummy") "token supplied on stdin")
      (expect (not (contains? (str (stdout-of result) (stderr-of result)) "dummy")) "token absent from logs"))
    (delete-file trace)
    (let ((result ($? ,sigil-bin ,sender --env-file ,env-file ,input ,input env: ,environment)))
      (expect (and (failed? result) (not (file-exists? trace))) "duplicate rejected before upload"))
    (let ((result ($? ,sigil-bin ,sender --env-file ,env-file ,(path work "missing.ogg") env: ,environment)))
      (expect (and (failed? result) (not (file-exists? trace))) "missing file rejected before upload"))
    (write-text env-file "TELEGRAM_BOT_TOKEN=\"invalid\nTELEGRAM_CHAT_ID=456\n")
    (let ((result ($? ,sigil-bin ,sender --env-file ,env-file ,input env: ,environment)))
      (expect (and (failed? result) (not (file-exists? trace))) "malformed credentials rejected"))
    (write-text env-file "COURIER_TELEGRAM_TOKEN=123:dummy\nCOURIER_TELEGRAM_CHAT_ID=456\n")
    (write-text fake
      "#!/bin/sh\nprintf 'attempt\\n' >> \"$MOCK_TRACE\"\ncat > \"$MOCK_CONFIG\"\nexit 28\n")
    (let ((result ($? ,sigil-bin ,sender --env-file ,env-file ,input env: ,environment)))
      (expect (failed? result) "transport failure exits nonzero")
      (expect (contains? (stderr-of result) "UNCONFIRMED") "ambiguous outcome is explicit")
      (expect (equal? (read-text trace) "attempt\n") "no automatic retry"))
    (delete-file trace)
    (let ((result ($? ,sigil-bin ,sender --dry-run ,input env: ,environment)))
      (expect (and (ok? result) (not (file-exists? trace))) "dry run skips upload"))
    (println "PASS: Telegram acknowledgement, stdin secrets, input checks, redaction, no retry and dry run.")))
