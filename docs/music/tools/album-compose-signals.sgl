#!/usr/bin/env sigil
;;; Closed Loop and Shadow Protocol retain their different native tracker grids.
(load (path (script-dir) "lib/core.sgl"))
(import (crash soundtrack tools))
(load (path (script-dir) "lib/album-arrangement.sgl"))
(import (crash soundtrack album arrangement))
(initialize (path (script-dir) "../../.."))

(define (crop p rows)
  (set-field
    (transform p (lambda (row cell) (and (< row rows) cell)))
    rows:
    rows))

(define (closed-loop source)
  (let ((intro
          (phrase 4
            '((0 6 "B-3" 8 21 3)
              (8 8 "C-5" 26 9 1)
              (12 6 "D-4" 8 18 3)
              (20 6 "F#3" 8 18 3)
              (24 8 "C-5" 26 9 1)
              (36 6 "B-3" 8 21 3)
              (48 6 "A-3" 8 18 3)
              (56 8 "C-5" 26 10 1)
              (60 6 "F#3" 8 18 3)
              (64 4 "B-1" 4 27 5)
              (64 6 "B-3" 8 21 3)
              (72 2 "F#3" 2 24 2)
              (72 7 "F#4" 9 14 3)
              (88 7 "D-4" 9 14 3)
              (96 1 "C-2" 1 36 5)
              (96 4 "B-1" 4 27 5)
              (100 6 "B-3" 8 21 3)
              (104 7 "C#4" 9 14 3)
              (120 2 "F#3" 2 26 2)
              (120 7 "B-3" 9 14 3))))
        (break
          (add-notes
            (crop
              (transform (pattern source 2)
                (lambda (row cell)
                  (if (and (< row 64) (member (car cell) '(5 6 7))) #f cell)))
              128)
            '((70 5 "B-2" 6 18 7))))
        (ending
          (add-notes
            (crop
              (transform (pattern source 0)
                (lambda (row cell)
                  (and (< row 64)
                       (level cell (if (member (car cell) '(1 2 3 8)) 0.7 0.9)))))
              128)
            '((64 1 "C-2" 1 32 5)
              (64 4 "B-1" 4 25 7)
              (70 5 "B-2" 6 18 11)
              (72 7 "F#4" 9 13 7)
              (88 6 "D-4" 8 17 7)
              (104 6 "B-3" 8 18 11)
              (112 7 "F#3" 9 10 7)))))
    (append
      (list (list "First signal / answering circuit" intro))
      (map (lambda (id)
             (list (str "Calm circuit " (+ id 1)) (pattern source id)))
           '(0 1 2 3 4))
      (list (list "Snap-click mechanism exposed / signals reconnect" break)
            (list "Restrained transition" (pattern source 5)))
      (map (lambda (id)
             (list (str "Energized circuit " (- id 5)) (pattern source id)))
           '(6 7 8 9 10))
      (list (list "Calm hook / B-minor closure" ending)
            (list "Released room tail" (empty-pattern 2))))))

;;; Shadow's speed-6 grid has 16 rows per bar, not the dance tracks' 32.
(define (shadow-protocol source)
  (let* ((intro
           (phrase-rows 64
             '((0 6 "D-3" 6 18 56)
               (16 5 "A-4" 5 15 6)
               (32 1 "D-2" 1 28 6)
               (32 5 "F-4" 5 14 10)
               (48 5 "E-4" 5 12 8))))
         (bridge
           (phrase-rows 128
             '((0 6 "D-3" 6 19 24)
               (0 1 "D-2" 1 30 6)
               (8 5 "A-4" 5 16 8)
               (20 5 "F-4" 5 15 8)
               (32 6 "A#2" 6 17 24)
               (32 1 "A#1" 1 28 6)
               (40 5 "D-4" 5 15 8)
               (52 5 "F-4" 5 14 8)
               (64 6 "A-2" 6 16 24)
               (64 1 "A-1" 1 27 6)
               (72 4 "E-4" 4 19 8)
               (88 4 "C#4" 4 18 6)
               (96 6 "D-3" 6 19 24)
               (96 1 "D-2" 1 32 6)
               (104 4 "D-4" 4 20 6)
               (112 5 "A-3" 5 14 6)
               (120 5 "D-4" 5 15 6))))
         (development
           (transform (pattern source 11)
             (lambda (row cell)
               (if (and (= (car cell) 4) (attack? cell)
                        (member row '(40 43 46 48 52)))
                   (append
                     (list 4
                           (cond ((= row 40) "G-3")
                                 ((= row 43) "A-3")
                                 ((= row 46) "F-3")
                                 ((= row 48) "E-3")
                                 (else "D-3")))
                     (skip cell 2))
                   cell))))
         (reprise
           (transform (pattern source 6)
             (lambda (row cell)
               (level cell (cond ((= (car cell) 1) 0.8)
                                 ((= (car cell) 3) 0.75)
                                 (else 1))))))
         (ending
           (phrase-rows 64
             '((0 6 "D-3" 6 19 48)
               (0 1 "D-2" 1 30 6)
               (4 4 "A-3" 4 18 6)
               (8 5 "A-3" 5 13 6)
               (16 1 "D-2" 1 26 6)
               (16 4 "F-3" 4 16 6)
               (24 5 "F-3" 5 12 8)
               (28 4 "E-3" 4 16 4)
               (32 1 "D-2" 1 23 6)
               (40 4 "D-3" 4 17 8)
               (48 5 "D-4" 5 12 8)))))
    (append
      (list (list "Distant pad / bass emerges" intro))
      (map (lambda (id)
             (list (str "Calm surveillance " (+ id 1)) (pattern source id)))
           '(0 1 2 3))
      (list (list "Unobserved: D-Bb-A-D harmonic passage" bridge))
      (map (lambda (id)
             (list (str "Calm return " (- id 3)) (pattern source id)))
           '(4 5 6 7))
      (list (list "Watch-tick transition" (pattern source 8)))
      (map (lambda (id)
             (list (str "Focused surveillance " (- id 8)) (pattern source id)))
           '(9 10 11 12))
      (list (list "Lower signal response / controlled tension" development))
      (map (lambda (id)
             (list (str "Focused return " (- id 12)) (pattern source id)))
           '(13 14 15 16))
      (list (list "Distant pad and vibes reprise" reprise)
            (list "Final D-minor withdrawal" ending)
            (list "Released room tail" (phrase-rows 32 '()))))))

(cli "album-compose-signals" (script-args) '()
  (lambda (options)
    (let ((motif (require-tool (option-ref options 'motif)))
          (output (option-ref options 'output)))
      (check (not (option-ref options 'tracks)) "This composer produces both signal/stealth tracks")
      (each spec (list (list "closed-loop" "Closed Loop" closed-loop)
                       (list "shadow-protocol" "Shadow Protocol" shadow-protocol))
        (let* ((slug (car spec))
               (reference (str "assets/tunes/" slug ".cts"))
               (source (read-score (path (root) reference))))
          (write-album motif
                       output
                       slug
                       (cadr spec)
                       source
                       ((caddr spec) source)
                       (list reference)
                       "Album signal/stealth pair I: finite arrangement with composed entrance, contrasting passage and ending. Game sources, accepted instrument bank and bus remain unchanged."
                       "Original clock, deliberate syncopation and lead effects retained. Explicit final gates and two tail bars; no playback jumps. Arranged with album-compose-signals.sgl."))))))
