;;; Score-level prototypes: no engine defaults or accepted patches change.
(define-library (crash soundtrack expression patches)
  (import (sigil shell prelude)
          (sigil list)
          (crash soundtrack tools))
  (export EXPRESSION-PATCHES replace-instruments)
  (begin
    (define EXPRESSION-PATCHES
      '((instrument id: 2 name: "relay-contact"
          patch: (fm4-bell alg: 4 index: 2.2
                   op1: (1 1 0.001 0.042 0 0.018)
                   op2: (6.73 0.65 0.001 0.014 0 0.012)
                   op3: (2.41 0.42 0.001 0.022 0 0.012)
                   op4: (9.17 0.42 0.001 0.012 0 0.009)
                   amp-attack: 0.001 amp-decay: 0.07
                   amp-sustain: 0 amp-release: 0.022)
          volume: 43 send: 0.08
          layers: ((chip-noise hp: 2300 cutoff: 7400
                     attack: 0.001 decay: 0.03 sustain: 0 release: 0.012
                     osc-amp: 0.5 octave: 0 volume: 0.45))
          pan: 0)
        (instrument id: 3 name: "clock-dust"
          patch: (chip-noise attack: 0.001 cutoff: 8000 decay: 0.026
                   hp: 4800 osc-amp: 0.8 release: 0.009 sustain: 0)
          volume: 24 pan: 0.25)
        (instrument id: 21 name: "clock-dust-open"
          patch: (chip-noise attack: 0.001 cutoff: 8000 decay: 0.09
                   hp: 4400 osc-amp: 0.7 release: 0.022 sustain: 0)
          volume: 25 pan: 0.25)
        (instrument id: 8 name: "resonant-wire"
          patch: (karplus-strong decay: 0.55 excite-gain: 0.65 amp: 0.57)
          volume: 30 send: 0.15 pan: 0.25)
        (instrument id: 9 name: "suspended-metal"
          patch: (fm4-bell alg: 4 index: 0.9
                   op1: (1 1.12 0.002 0.9 0 0.25)
                   op2: (2.71 0.45 0.002 0.25 0 0.12)
                   op3: (2.01 0.336 0.002 1.1 0 0.3)
                   op4: (5.43 0.3 0.002 0.18 0 0.1)
                   amp-attack: 0.002 amp-decay: 1.1
                   amp-sustain: 0 amp-release: 0.3)
          volume: 24 send: 0.2 pan: 0.35)
        (instrument id: 6 name: "synthetic-choir"
          patch: (fm4-pad alg: 6 fb: 0.04 index: 0.65
                   op1: (1 1.71 0.15 0.4 0.8 0.5)
                   op2: (2 0.473 0.25 0.5 0.7 0.6)
                   op3: (3 0.21 0.35 0.5 0.65 0.6)
                   op4: (1 0.35 0.15 0.3 0.6 0.5)
                   amp-attack: 0.18 amp-decay: 0.4
                   amp-sustain: 0.75 amp-release: 0.65
                   unison: 2 spread: 8 chorus-rate: 0.23
                   chorus-depth: 2 chorus-mix: 0.22)
          volume: 20 send: 0.12
          layers: ((chip-noise hp: 900 cutoff: 2600 osc-amp: 0.15
                     attack: 0.2 decay: 0.5 sustain: 0.3 release: 0.6
                     octave: 0 volume: 0.2))
          pan: -0.25)))

    (define (replace-instruments score ids)
      (replace-child score 'instruments
        (cons 'instruments
          (map (lambda (instrument)
                 (if (member (field instrument id:) ids)
                     (or (list-find
                           (lambda (candidate)
                             (= (field candidate id:) (field instrument id:)))
                           EXPRESSION-PATCHES)
                         (error "Missing expression patch" (field instrument id:)))
                     instrument))
               (cdr (child score 'instruments))))))))
