(define-library (crash soundtrack audit)
  (import (sigil shell prelude)
          (sigil args)
          (sigil json)
          (sigil list)
          (crash soundtrack tools))
  (export clock-audit grid-audit run-audit)
  (begin
    (define CHANNELS '(1 2 3 4 5 6 7 8))

    (define (note-on? cell)
      (not (member (cadr cell) '("..." "==="))))

    (define (attacks table)
      (filter (lambda (tick) (= (list-ref tick 5) 1)) table))

    (define (clock-audit file motif expected-jump)
      (let* ((score (read-score file))
             (patterns (cdr (child score 'patterns)))
             (orders (cdr (child score 'order)))
             (numerator (* 44100 5 (field score speed:)))
             (denominator (* 2 (field score tempo:)))
             (expected (make-vector 9 '()))
             (gated (make-vector 9 #f))
             (offset 0)
             (order-index 0)
             (jumps '())
             (worst 0)
             (count 0))
        (each ident orders
          (let ((pattern (list-find (lambda (p) (= (field p id:) ident)) patterns)))
            (each row (skip pattern 5)
              (each cell (cddr row)
                (let ((ch (car cell))
                      (fx (list-ref cell 4)))
                  (check (not (or (starts-with? fx "F") (starts-with? fx "D")))
                         "Unexpected clock/break effect" file)
                  (when (starts-with? fx "B")
                    (set! jumps (append jumps
                                  (list (list order-index (cadr row)
                                              (string->number (substring fx 1 3) 16))))))
                  (cond
                    ((equal? (cadr cell) "===") (vector-set! gated ch #f))
                    ((note-on? cell)
                     (unless (and (starts-with? fx "3") (vector-ref gated ch))
                       ;; Calculate each timestamp from integers, not accumulated row time.
                       (let ((sample (quotient (+ (* 2 (+ offset (cadr row)) numerator)
                                                   denominator)
                                                (* 2 denominator))))
                         (vector-set! expected ch (cons sample (vector-ref expected ch)))))
                     (vector-set! gated ch #t))))))
            (set! offset (+ offset (field pattern rows:)))
            (set! order-index (+ order-index 1))))
        (let* ((last-id (car (reverse orders)))
               (last-pattern (list-find (lambda (p) (= (field p id:) last-id)) patterns)))
          (check (equal? jumps (list (list (- (length orders) 1)
                                          (- (field last-pattern rows:) 1) expected-jump)))
                 "Incorrect final loop destination" file jumps))
        (each ch CHANNELS
          (let* ((times (reverse (vector-ref expected ch)))
                 (actual (map car (attacks (ticks motif file ch)))))
            (check (= (length actual) (length times)) "Missing or extra triggers" file ch)
            (list-for-each
              (lambda (a b)
                (let ((delta (abs (- a b))))
                  (check (<= delta 1) "Sample-clock drift" file ch delta)
                  (set! worst (max worst delta))))
              actual times)
            (set! count (+ count (length actual)))))
        (dict source: (basename file) compiled_triggers: count
              maximum_clock_error_samples: worst loop_order: expected-jump
              duration_seconds: (/ (* offset numerator) (* denominator 44100.0)))))

    (define (strip-suffix text suffix)
      (if (ends-with? text suffix)
          (substring text 0 (- (string-length text) (string-length suffix))) text))

    (define (grid-audit slug file motif)
      (let* ((score (read-score file))
             (layout (dict-ref (dict-ref (catalog) section_layouts:) (string->keyword slug)))
             (fill (array-ref layout 0))
             (tense (array-ref layout 1))
             (base (fold-left strip-suffix slug '("-v4" "-v3" "-v2" "-dark" "-grit")))
             (arrangement
               (cond
                 ((equal? base "sector-drift-dust-kit") "sector-drift")
                 ((equal? base "closed-loop-relay-kit") "closed-loop")
                 ((equal? base "cold-boot-machine-kit") "cold-boot")
                 ((equal? base "basement-circuit-signal-kit") "acid-house")
                 ((equal? base "glass-current-paper-kit") "liquid")
                 (else base)))
             (roll? (not (member arrangement
                                '("blind-spot" "sector-drift" "closed-loop" "quiet-array"
                                  "dead-sector" "obsidian-index" "clock-edge"))))
             (patterns (cdr (child score 'patterns)))
             (position 0)
             (off-grid 0))
        (check (and (= (field score speed:) 3) (= (field score channels:) 8)
                    (equal? (field score meter:) '(8 4))) "Unexpected meter" slug)
        (each ident (cdr (child score 'order))
          (let ((p (list-find (lambda (p) (= (field p id:) ident)) patterns)))
            (each row (skip p 5)
              (each cell (filter note-on? (cddr row))
                (let* ((r (cadr row))
                       (ch (car cell))
                       (inst (caddr cell))
                       (vol (cadddr cell))
                       (roll-hit? (and roll? (= position fill) (= ch 2)
                                       (>= r (- (field p rows:) 8)))))
                  (if (and roll-hit? (odd? r))
                      (set! off-grid (+ off-grid 1))
                      (check (even? r) "Stray thirty-second onset" slug ident r ch))
                  (when (or (member inst '(8 9 22))
                            (and (member arrangement '("quiet-array" "dead-sector" "clock-edge"))
                                 (= inst 12)))
                    (check (= (modulo r 4) 0) "Melody off eighth grid" slug r))
                  (let ((threshold (cond
                                     ((equal? arrangement "blind-spot") 18)
                                     ((equal? arrangement "sector-drift") 33)
                                     ((equal? arrangement "quiet-array") 18)
                                     ((equal? arrangement "dead-sector") 21)
                                     ((equal? arrangement "obsidian-index") 20)
                                     ((equal? arrangement "clock-edge") 30)
                                     (else 35))))
                    (when (and (= ch 2) (>= vol threshold) (not (= position fill)))
                      (let ((backbeats
                              (cond
                                ((member slug '("obsidian-index-v2" "obsidian-index-v3" "obsidian-index-v4"))
                                 (if (even? (quotient r 32)) '(24) '(16)))
                                ((or (member arrangement '("black-glass" "blind-spot" "quiet-array" "dead-sector" "obsidian-index"))
                                     (and (equal? arrangement "liquid") (< position fill))) '(16))
                                (else '(8 24)))))
                        (check (member (modulo r 32) backbeats) "Incorrect backbeat" slug r)))))))
            (set! position (+ position 1))))
        (check (= off-grid (if roll? 4 0)) "Unexpected off-sixteenth fill hits" slug)
        (dict-set (clock-audit file motif tense) intentional_off_sixteenth_snare_hits: off-grid)))

    (define (musical-edges table scale)
      (let loop ((rest table) (previous #f) (result '()))
        (if (null? rest) (reverse result)
            (let* ((tick (car rest))
                   (pitch (if (= (list-ref tick 4) 0) 0
                              (/ (round (* (caddr tick) scale 100000000)) 100000000)))
                   (state (list (cadr tick) pitch (list-ref tick 4)))
                   (trigger (list-ref tick 5))
                   (edge (list (car tick) state trigger
                               (if (= trigger 1) (list-ref tick 6) 0))))
              (loop (cdr rest) state
                    (if (or (not (equal? state previous)) (= trigger 1))
                        (cons edge result) result))))))

    (define (legacy-audit old-slug new-slug motif)
      (let* ((old (read-score (source-path old-slug)))
             (new (read-score (source-path new-slug)))
             (count 0))
        (each key '(tempo: speed: channels:)
          (check (equal? (field old key) (field new key)) "Changed legacy clock" new-slug))
        (check (equal? (child old 'order) (child new 'order)) "Changed legacy order" new-slug)
        (let ((a (cdr (child old 'patterns))) (b (cdr (child new 'patterns))))
          (check (= (length a) (length b)) "Changed pattern count" new-slug)
          (list-for-each
            (lambda (before after)
              (check (equal? (take before 5) (take after 5)) "Changed pattern header" new-slug)
              (check (= (length before) (length after)) "Changed row count" new-slug)
              (list-for-each
                (lambda (ra rb)
                  (check (and (equal? (take ra 2) (take rb 2)) (= (length ra) (length rb)))
                         "Changed row layout" new-slug)
                  (list-for-each
                    (lambda (ca cb)
                      (check (and (= (car ca) (car cb)) (= (caddr ca) (caddr cb))
                                  (equal? (list-ref ca 4) (list-ref cb 4))
                                  (eq? (= (cadddr ca) 0) (= (cadddr cb) 0)))
                             "Changed legacy effects/instrument" new-slug)
                      (let* ((note (cadr ca))
                             (expected
                               (if (and (equal? old-slug "spy") (= (caddr ca) 5) (note-on? ca))
                                   (str (substring note 0 2)
                                        (- (string->number (substring note 2 3)) 1)) note)))
                        (check (equal? expected (cadr cb)) "Changed legacy pitch" new-slug)))
                    (cddr ra) (cddr rb)))
                (skip before 5) (skip after 5))) a b))
        (each ch CHANNELS
          (let* ((a (ticks motif (source-path old-slug) ch))
                 (b (ticks motif (source-path new-slug) ch))
                 (scale (if (and (equal? old-slug "spy") (= ch 5)) 2 1)))
            (check (equal? (musical-edges a 1) (musical-edges b scale))
                   "Legacy compiled clock/gate mismatch" new-slug ch)
            (set! count (+ count (length (attacks b))))))
        (dict original: old-slug variation: new-slug compiled_triggers: count
              clock_gate_and_effects_preserved: #t)))

    (define (attack-times table start)
      (map (lambda (t) (list (car t) (list-ref t 6)))
           (filter (lambda (t) (>= (car t) start)) (attacks table))))

    (define (revision-audit slug motif)
      (let* ((old (read-score (source-path slug)))
             (new-slug (str slug "-v2"))
             (new (read-score (source-path new-slug)))
             (rhythm '(1 2 3 4 8))
             (count 0))
        (each key '(tempo: speed: channels:)
          (check (equal? (field old key) (field new key)) "Changed revision clock" slug))
        (check (equal? (child old 'order) (child new 'order)) "Changed revision order" slug)
        (when (equal? slug "dirty-cache")
          (check (equal? (child old 'instruments) (child new 'instruments)) "Changed instruments" slug))
        (let ((a (cdr (child old 'patterns))) (b (cdr (child new 'patterns))))
          (check (= (length a) (length b)) "Changed pattern count" slug)
          (list-for-each
            (lambda (pa pb)
              (check (equal? (take pa 5) (take pb 5)) "Changed pattern header" slug)
              (define (rhythm-cells p)
                (map (lambda (r) (cons (cadr r) (filter (lambda (c) (member (car c) rhythm)) (cddr r))))
                     (skip p 5)))
              (check (equal? (rhythm-cells pa) (rhythm-cells pb)) "Changed rhythm cells" slug)
              (when (equal? slug "dirty-cache")
                (if (not (= (field pa id:) 3))
                    (check (equal? pa pb) "Changed unrelated pattern" slug)
                    (begin
                      (check (= (length pa) (length pb)) "Changed harmonic row count" slug)
                      (list-for-each
                        (lambda (ra rb)
                          (check (and (equal? (take ra 2) (take rb 2)) (= (length ra) (length rb)))
                                 "Changed harmonic rows" slug)
                          (list-for-each
                            (lambda (ca cb)
                              (check (equal? (cons (car ca) (cddr ca)) (cons (car cb) (cddr cb)))
                                     "Changed non-pitch data" slug)
                              (when (or (< (cadr ra) 32) (not (member (car ca) '(5 6 7))))
                                (check (equal? ca cb) "Changed unrelated note" slug)))
                            (cddr ra) (cddr rb)))
                        (skip pa 5) (skip pb 5)))))) a b))
        (each ch CHANNELS
          (let ((a (ticks motif (source-path slug) ch))
                (b (ticks motif (source-path new-slug) ch)))
            (cond
              ((member ch rhythm) (check (equal? a b) "Compiled rhythm changed" slug ch))
              ((equal? slug "dirty-cache")
               (check (equal? (attack-times a 0) (attack-times b 0)) "Attack clock changed" slug ch))
              ((= ch 5)
               (check (equal? (attack-times a 201600) (attack-times b 0)) "Existing riff changed" slug))
              ((= ch 6)
               (check (equal? (attack-times a 0) (attack-times b 0)) "Pluck clock changed" slug)))
            (set! count (+ count (length (attacks b))))))
        (dict track: new-slug compiled_triggers: count rhythm_channels_and_bass_unchanged: #t)))

    (define (run-audit mode args)
      (cli mode args '()
        (lambda (opts)
          (let ((motif (require-tool (option-ref opts 'motif))))
            (cond
              ((equal? mode "legacy")
               (each pair '(("spy" "shadow-protocol") ("groove" "dirty-cache") ("breaker" "breach-vector"))
                 (println "~a" (json-encode (legacy-audit (car pair) (cadr pair) motif)))))
              ((equal? mode "revisions")
               (each slug '("dirty-cache" "breach-vector")
                 (println "~a" (json-encode (revision-audit slug motif)))))
              (else
                (let ((slugs (or (option-ref opts 'tracks)
                                (if (equal? mode "adaptive-timing")
                                    '("shadow-protocol-adaptive" "dirty-cache-adaptive" "dirty-cache-adaptive-v2" "breach-vector-adaptive")
                                    (filter (lambda (s) (not (contains? s "adaptive")))
                                      (map keyword->string (dict-keys (dict-ref (catalog) section_layouts:))))))))
                  (each slug slugs
                    (let* ((file (source-path slug))
                           (layout (dict-ref (dict-ref (catalog) section_layouts:) (string->keyword slug)))
                           (fill (array-ref layout 0))
                           (tense (array-ref layout 1)))
                      (if (equal? mode "timing")
                          (println "~a" (json-encode (grid-audit slug file motif)))
                          (let* ((score (read-score file))
                                 (patterns (cdr (child score 'patterns)))
                                 (orders (cdr (child score 'order))))
                            (each index (list 0 fill tense)
                              (let* ((ident (list-ref orders index))
                                     (p (list-find (lambda (p) (= (field p id:) ident)) patterns))
                                     (row (list-find (lambda (r) (= (cadr r) 0)) (skip p 5))))
                                (check (and row (equal? (list-sort < (map car (cddr row))) CHANNELS)
                                            (every (lambda (c) (not (equal? (cadr c) "..."))) (cddr row)))
                                       "Section entry depends on held state" slug index)))
                            (println "~a" (json-encode (clock-audit file motif tense)))
                            (each spec (list (list "calm" 0 fill) (list "tense" tense #f))
                              (let ((dest (path (option-ref opts 'output) (str slug "-" (car spec) ".cts"))))
                                (write-canonical motif dest (section-score score (cadr spec) (caddr spec) (car spec)))
                                ($ ,motif tune check ,dest)
                                (println "~a" (json-encode (clock-audit dest motif 0)))))))))))))))))
)
