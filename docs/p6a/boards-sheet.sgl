;;; The sheet of boards for David (P6a): per preset, a few deals, each
;;; with the ICE map, what the player sees after the uplink, and the
;;; recorded line with the rule that forced each step. Written to
;;; docs/p6a/boards.txt by running this file under `sigil test` from the
;;; repo root.

(import (sigil test)
        (sigil list)
        (sigil math)
        (sigil fs)
        (sigil string)
        (crash stack prng)
        (crash scan rules)
        (crash scan generate)
        (crash scan check)
        (crash scan text))

(define OUT "docs/p6a/boards.txt")

(define (first-of seed w h)
  (prng-index (prng-next (prng-seed (* seed 7919))) (* w h)))

(define (side-by-side a b gap)
  (string-join (map (lambda (x y) (string-append x gap y))
                    (string-split a "\n")
                    (string-split b "\n"))
               "\n"))

(define (rule-count line r)
  (length (filter (lambda (s) (eq? (caddr s) r)) line)))

(define (board-text preset seed)
  (let* ((d (preset-dims preset))
         (w (car d))
         (h (cadr d))
         (first (first-of seed w h))
         (deal (deal-segment preset seed first 'original #f))
         (s (dealt-segment deal))
         (line (dealt-line deal))
         (verdict (check-line (segment-new w h (segment-ice s) preset 'original #f) line)))
    (string-append
     "== " (string-upcase (symbol->string preset))
     " " (number->string w) "x" (number->string h) "/" (number->string (caddr d))
     ", seed " (number->string seed)
     ", uplink " (host->text s first)
     ", perturbations " (number->string (dealt-perturbs deal)) ", placements past the first " (number->string (dealt-placements deal))
     "\n\n"
     "left, the deal (* ICE, @ uplink); right, what the player sees after it (# hidden, . zero, digits readings)\n"
     (side-by-side (segment->truth-text s) (segment->text s) "   ")
     "\n\n"
     "the recorded line: " (number->string (length line)) " steps ("
     (string-join (map (lambda (r) (string-append (symbol->string r) " " (number->string (rule-count line r))))
                       (list 'a 'b 'c 'd))
                  ", ")
     "); the checker: " (if (eq? verdict 'ok) "every step forced" "REFUSED") "\n"
     (string-join (map (lambda (row) (string-join row "   "))
                       (let chunk ((steps (map (lambda (st) (step->text s st)) line)) (acc '()))
                         (if (null? steps)
                             (reverse acc)
                             (let ((k (min 6 (length steps))))
                               (chunk (list-tail* steps k) (cons (list-head* steps k) acc))))))
                  "\n")
     "\n\n")))

(define (list-head* l n) (if (= n 0) '() (cons (car l) (list-head* (cdr l) (- n 1)))))
(define (list-tail* l n) (if (= n 0) l (list-tail* (cdr l) (- n 1))))

(define HEADER
  (string-join
   (list "SCAN (P6a): guess-free boards, per preset"
         ""
         "Generated by docs/p6a/boards-sheet.sgl from (crash scan generate) at the"
         "commit that added this file or changed it last. Each board is a function"
         "of (seed, uplink): the ICE is placed after the first click, never in its"
         "3x3. Where the solver gets stuck, ICE around the stuck spot is moved"
         "(a perturbation) and the board is solved again from the uplink, until it"
         "clears without a guess (D68). `perturbations` counts the moves (a fresh"
         "placement is dealt when nothing can be moved); 0 and 0: the first placement cleared as dealt."
         ""
         "Steps read `scan x,y (rule)` or `flag x,y (rule)`, x from the left and y"
         "from the top, both from 0. The rules:"
         "  uplink  the first click"
         "  a       a reading whose flags equal it: its other hidden neighbors are clean"
         "  b       a reading whose missing ICE equal its hidden neighbors: all ICE"
         "  c       one reading's hidden set inside another's: the difference is settled"
         "  d       the global count: no ICE left, or as many ICE as hidden hosts"
         "A scan of a zero opens its area (the flood); floods are not listed."
         "`the checker` is (crash scan check), which sees only what the player"
         "would and proves each step forced by enumeration."
         ""
         "")
   "\n"))

(test-group "sheet"
  (test "write docs/p6a/boards.txt"
    (write-file-string OUT
                       (string-append HEADER
                                      (string-join (map (lambda (ps) (board-text (car ps) (cadr ps)))
                                                        (list (list 'lan 1) (list 'lan 2) (list 'lan 3)
                                                              (list 'wan 1) (list 'wan 2)
                                                              (list 'backbone 1) (list 'backbone 2)))
                                                   "")))
    (assert-true (file-exists? OUT))))
