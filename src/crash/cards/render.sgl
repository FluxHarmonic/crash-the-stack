;;; (crash cards render) - Drawing the card table (DEFRAG, ruling D16).
;;;
;;; Takes a deal and a card geometry and draws one frame with
;;; sigil-graphics primitives, in the P0 tile shape: each card a flat face
;;; over a darker side strip, the rank and suit as bitmap glyphs in the
;;; card's corner (what a fanned column shows) with the suit again large
;;; in the middle, face-down cards as a dark back, empty places as
;;; outlines, and the HUD with its tappable controls (rects from (crash
;;; cards geometry), so a tap lands where the button is drawn). Nothing
;;; here reads input, a platform or a clock; there is no animation yet
;;; (the cascade and the card motion come with (crash fx) in a later
;;; slice). Colors come from (crash palette).

(define-library (crash cards render)
  (import (sigil struct)
          (sigil math)
          (sigil graphics)
          (crash geometry)
          (crash cards deck)
          (crash cards rules)
          (crash cards geometry)
          (crash cards input)
          (crash cards fx)
          (crash stack prng)
          (crash trace)
          (crash cards trace)
          (crash render)
          (crash font)
          (crash palette))

  (export draw-deal)

  (begin
    (define SIDE LAYER-OFFSET)
    (define (half n) (quotient n 2))
    (define GLYPH-SCALE 2)
    (define BIG-SUIT-SCALE 6)

    ;; The four subsystems (ruling D16): hot PWR and TX for hearts and
    ;; diamonds, cold MEM and DSK for spades and clubs. One color per
    ;; class, not per subsystem (David, from the phone, 2026-09-18: four
    ;; colors made the game harder to read than two, and the amber was
    ;; unreadable on a small screen); the three-letter tag and the suit
    ;; mark tell the two subsystems of a class apart.
    (define (subsystem-tag c)
      (case (card-suit c)
        ((0) "MEM")
        ((1) "PWR")
        ((2) "TX")
        (else "DSK")))

    (define (suit-color c)
      (if (card-red? c) C-HOT C-COLD))

    ;; The court's in-world names, under the big suit mark.
    (define (rank-word c)
      (case (card-rank c)
        ((1) "BOOT")
        ((11) "DAEMON")
        ((12) "SYSOP")
        ((13) "ROOT")
        (else #f)))

    ;; --- background -----------------------------------------------------------

    (define (draw-background g)
      (let ((vw (card-geometry-vw g))
            (vh (card-geometry-vh g)))
        (color! C-BG)
        (draw-filled-rect 0 0 vw vh)
        (let loop ((y -36) (i 0))
          (when (< y (- vh (card-geometry-hud-h g)))
            (color! (case (modulo i 3)
                       ((0) C-BAR-A)
                       ((1) C-BAR-B)
                       (else C-BAR-C)))
            (draw-filled-rect 0 y vw 6)
            (loop (+ y 12) (+ i 1))))))

    ;; --- cards ------------------------------------------------------------------

    (define (draw-outline r color)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color! color)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)))

    ;; An empty place: a dim outline; the stock's shows a ring, meaning
    ;; "tap to turn the waste back".
    (define (draw-slot r ring?)
      (draw-outline r C-TEXT-DIM)
      (when ring?
        (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
               (cx (+ x (half w)))
               (cy (+ y (half h))))
          (color! C-TEXT-DIM)
          (draw-filled-rect (- cx 8) (- cy 8) 16 2)
          (draw-filled-rect (- cx 8) (+ cy 6) 16 2)
          (draw-filled-rect (- cx 8) (- cy 8) 2 16)
          (draw-filled-rect (+ cx 6) (- cy 8) 2 16))))

    (define (draw-sides r)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color! C-SIDE-DARK)
        (draw-filled-rect (- x SIDE) (+ y h) (+ w SIDE) SIDE)
        (color! C-SIDE)
        (draw-filled-rect (- x SIDE) y SIDE h)))

    (define (draw-back r)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (draw-sides r)
        (color! C-SIDE-DARK)
        (draw-filled-rect x y w h)
        (color! C-SIDE)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x y 1 h)
        (color! C-BAR-C)
        (draw-filled-rect (+ x 6) (+ y 6) (- w 12) (- h 12))
        ;; a lattice of dots
        (color! C-SIDE-DARK)
        (let loop ((py (+ y 10)))
          (when (< py (+ y h -8))
            (let inner ((px (+ x 10)))
              (when (< px (+ x w -8))
                (draw-filled-rect px py 2 2)
                (inner (+ px 8))))
            (loop (+ py 8))))))

    ;; A face-up card: the tile's face with the rank and suit top-left
    ;; (the strip a fanned column shows) and the suit large in the middle.
    (define (draw-face r c selected?)
      (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
             (rank (if (= (card-rank c) 10) "10" (string (rank-char c))))
             (rw (text-width rank GLYPH-SCALE))
             (gw (* GLYPH-SCALE GLYPH-W))
             (bw (* BIG-SUIT-SCALE GLYPH-W))
             (bh (* BIG-SUIT-SCALE GLYPH-H)))
        (draw-sides r)
        (color! (if selected? (mix C-SELECTED C-FACE-EDGE 0.3) C-FACE))
        (draw-filled-rect x y w h)
        (color! (if selected? C-SELECTED C-FACE-EDGE))
        (draw-filled-rect x y w 1)
        (draw-filled-rect x y 1 h)
        (color! (suit-color c))
        (draw-text rank (+ x 4) (+ y 3) GLYPH-SCALE)
        ;; the subsystem tag where a card's suit symbol would sit (the icons
        ;; are P3's), and the suit mark small beside it for the classic eye
        (draw-text (subsystem-tag c) (+ x 4 rw 4) (+ y 3) 1)
        (draw-suit (card-suit c) (+ x 4 rw 4) (+ y 11) 1)
        ;; the big suit mark, when the face is tall enough to hold it under
        ;; the corner, with the court's name under it
        (when (>= h (+ 3 (* GLYPH-SCALE GLYPH-H) bh 6))
          (draw-suit (card-suit c)
                     (+ x (half (- w bw)))
                     (+ y (half (- h bh)))
                     BIG-SUIT-SCALE)
          (let ((word (rank-word c)))
            (when word
              (draw-text word
                         (+ x (half (- w (text-width word 1))))
                         (+ y (half (- h bh)) bh 4)
                         1))))
        (when selected?
          (draw-outline (list (- x 1) (- y 1) (+ w 2) (+ h 2)) C-SELECTED))))

    ;; An encrypted packet: the back under a hot veil with a hot strip
    ;; across its top, the strip labeled, so it reads as the ICE's from
    ;; the sliver the fan leaves in view (David, 2026-09-18). left: the
    ;; fraction of the lock's time still to run; the veil fades with it
    ;; and the strip's ground shrinks from the right like a fuse (David:
    ;; "some way to indicate how much time is left").
    (define ENCRYPTED-LABEL "ENCRYPTED")
    (define ENCRYPTED-STRIP 16)

    (define (draw-locked-back r left)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (draw-back r)
        (color-alpha! C-TRACE-HOT (+ 0.08 (* 0.25 left)))
        (draw-filled-rect x y w h)
        (color-alpha! C-TRACE-HOT 0.35)
        (draw-filled-rect x y w ENCRYPTED-STRIP)
        (color! C-TRACE-HOT)
        (draw-filled-rect x y (exact (round (* w left))) ENCRYPTED-STRIP)
        (color! C-BG)
        (draw-text-mini ENCRYPTED-LABEL
                        (+ x (half (- w (text-width-mini ENCRYPTED-LABEL 2))))
                        (+ y 3)
                        2)))

    ;; flag: the pile entry's flag, #t face up, #f face down, a number
    ;; the tick an ICE lock expires at (the waste and the foundations
    ;; pass #t); now: the clock's tick.
    (define (draw-card r c flag selected? now)
      (cond ((eq? flag #t) (draw-face r c selected?))
            ((number? flag)
             (draw-locked-back r (max 0.0 (min 1.0 (/ (- flag now) ENCRYPT-TICKS)))))
            (else (draw-back r))))

    (define (selected-place? game p)
      (equal? (game-selected game) p))

    ;; A pile's card at depth is selected when the selection is at that
    ;; depth or deeper (the run from the selected card up to the top).
    (define (in-selected-run? game i depth)
      (let ((sel (game-selected game)))
        (and sel
             (eq? (car sel) 'pile)
             (= (cadr sel) i)
             (<= depth (caddr sel)))))

    ;; x: the frame's effects; a cascading foundation shows the card under
    ;; the ones it has launched.
    ;; A rect shifted sideways by a hit's shake.
    (define (shaken r hit)
      (if hit
          (list (+ (car r) (exact (round (car hit)))) (cadr r) (caddr r) (cadddr r))
          r))

    ;; The flash over a packet the ICE just hit: hot, fading with the hit.
    (define (draw-hit-flash r hit)
      (when hit
        (color-alpha! C-TRACE-HOT (* 0.55 (cdr hit)))
        (draw-filled-rect (car r) (cadr r) (caddr r) (cadddr r))))

    ;; The corrupted buffer top, for as long as the corruption holds: a
    ;; hot veil and a few flickering slices from the table's random
    ;; stream (David, 2026-09-18: "something visual to make that clear").
    (define (draw-corrupt-veil r ticks)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color-alpha! C-TRACE-HOT 0.35)
        (draw-filled-rect x y w h)
        (let loop ((k 0) (rng (prng-seed (+ 29 (quotient ticks 3)))))
          (when (< k 5)
            (let* ((r1 (prng-next rng))
                   (r2 (prng-next r1))
                   (r3 (prng-next r2)))
              (color-alpha! (if (even? k) C-TRACE-HOT C-BG) 0.6)
              (draw-filled-rect (+ x (- (prng-index r3 8) 4))
                                (+ y (prng-index r1 (max 1 (- h 3))))
                                w
                                (+ 1 (prng-index r2 3)))
              (loop (+ k 1) r3))))))

    (define (draw-top-row g game x)
      (let ((skip (card-fx-moving-cards x)))
        ;; the stock: a back when it has cards, the ring when it is empty
        (if (pair? (game-stock game))
            (draw-back (stock-rect g))
            (draw-slot (stock-rect g) (pair? (game-waste game))))
        ;; the waste: the top card, fanned by three under draw three
        (let* ((waste (game-waste game))
               (shown (min 3 (length waste))))
          (if (null? waste)
              (draw-slot (waste-rect g) #f)
              (let loop ((depth (- shown 1)))
                (when (>= depth 0)
                  (unless (memv (list-ref waste depth) skip)
                    (let* ((hit (and (= depth 0) (card-fx-hit x '(waste 0))))
                           (r (shaken (waste-card-rect g game depth) hit)))
                      (draw-face r
                                 (list-ref waste depth)
                                 (and (= depth 0) (selected-place? game '(waste))))
                      (when (and (= depth 0) (game-corrupted? game))
                        (draw-corrupt-veil r (card-fx-ticks x)))
                      (draw-hit-flash r hit)))
                  (loop (- depth 1))))))
        ;; the foundations
        (let loop ((i 0))
          (when (< i FOUNDATIONS)
            (let* ((f (game-foundation game i))
                   (r (foundation-rect g i))
                   (gone (if (card-fx-idle? x) 0 (vector-ref (card-fx-launched x) i)))
                   (f (if (> gone 0) (drop-n f (min gone (length f))) f))
                   (f (let drop-moving ((f f)) (if (and (pair? f) (memv (car f) skip)) (drop-moving (cdr f)) f))))
              (if (null? f)
                  (draw-slot r #f)
                  (draw-face r (car f) (selected-place? game (list 'foundation i)))))
            (loop (+ i 1))))))

    ;; The cards sliding to their new places, drawn last so they pass
    ;; over everything.
    (define (draw-movers g x)
      (for-each (lambda (m)
                  (draw-card (cadr m) (car m) (caddr m) #f 0))
                (card-fx-movers x)))

    ;; The cascade: each flying card over its trail (the placeholder for
    ;; P3's glyph streams), on the board area only.
    (define (draw-cascade g x)
      (let ((w (card-geometry-card-w g))
            (h (card-geometry-card-h g)))
        (for-each (lambda (f)
                    (let loop ((trail (reverse (flyer-trail f))) (k 0))
                      (unless (null? trail)
                        (draw-face (list (exact (floor (car (car trail))))
                                         (exact (floor (cdr (car trail))))
                                         w h)
                                   (flyer-card f)
                                   #f)
                        (loop (cdr trail) (+ k 1))))
                    (draw-face (list (exact (floor (flyer-x f)))
                                     (exact (floor (flyer-y f)))
                                     w h)
                               (flyer-card f)
                               #f))
                  (reverse (card-fx-flying x)))))

    (define (draw-tableau g game x now)
      (let ((skip (card-fx-moving-cards x)))
        (let loop ((i 0))
          (when (< i PILES)
            (let* ((pile (game-pile game i))
                   (n (length pile)))
              (if (= n 0)
                  (draw-slot (pile-slot-rect g i) #f)
                  ;; bottom card first, so each card covers the one under it
                  (let draw ((depth (- n 1)))
                    (when (>= depth 0)
                      (let ((entry (list-ref pile depth)))
                        (unless (memv (pile-card entry) skip)
                          (let* ((hit (card-fx-hit x (list 'pile i depth)))
                                 (r (shaken (pile-card-rect g game i depth) hit)))
                            (draw-card r
                                       (pile-card entry)
                                       (cdr entry)
                                       (in-selected-run? game i depth)
                                       now)
                            (draw-hit-flash r hit))))
                      (draw (- depth 1))))))
            (loop (+ i 1))))))

    ;; --- the key overlays ---------------------------------------------------------
    ;;
    ;; Each place's tag in the 3x5 set, top right of its exposed strip
    ;; (the rank sits top left), the letters typed so far lit; drawn only
    ;; while the deal's labels-shown holds.

    ;; The rect a place shows: a pile card's own rect (its top strip is
    ;; what the fan leaves visible), else the place's rect.
    (define (place-rect g game p)
      (case (car p)
        ((stock) (stock-rect g))
        ((waste) (waste-card-rect g game 0))
        ((foundation) (foundation-rect g (cadr p)))
        ((pile)
         (let ((depth (if (pair? (cddr p)) (caddr p) 0)))
           (if (>= depth (length (game-pile game (cadr p))))
               (pile-slot-rect g (cadr p))
               (pile-card-rect g game (cadr p) depth))))
        (else (list 0 0 0 0))))

    (define (draw-tag-box x y w h)
      (color! C-BG)
      (draw-filled-rect x y w h))

    ;; --- the PROBE's hint ------------------------------------------------------------
    ;;
    ;; The move on show: its source and its destination ringed twice in
    ;; the highlight color; a source in the feed rings the stock and
    ;; names the card to pull to.

    (define (ring r color)
      (draw-outline r color)
      (draw-outline (list (- (car r) 2) (- (cadr r) 2) (+ (caddr r) 4) (+ (cadddr r) 4)) color))

    (define (draw-hint d g x)
      (let ((h (deal-hint d))
            (game (deal-game d)))
        (when h
          (let* ((src (car h))
                 (dst (cadr h))
                 (src-rect (if (eq? (car src) 'stock) (stock-rect g) (place-rect g game src)))
                 (dst-rect (if (and (eq? (car dst) 'pile) (pair? (game-pile game (cadr dst))))
                               (pile-card-rect g game (cadr dst) 0)
                               (place-rect g game dst))))
            (ring src-rect C-HIGHLIGHT)
            (ring dst-rect C-HIGHLIGHT)
            (when (eq? (car src) 'stock)
              (let* ((label (card-string (cadr src)))
                     (w (+ 6 (text-width label 2))))
                (color! C-HIGHLIGHT)
                (draw-filled-rect (+ (car src-rect) (half (- (caddr src-rect) w))) (+ (cadr src-rect) 40) w 18)
                (color! C-BG)
                (draw-text label (+ (car src-rect) (half (- (caddr src-rect) w)) 3) (+ (cadr src-rect) 43) 2)))))))

    (define (draw-tags d g)
      (let ((game (deal-game d))
            (typed (deal-typed d)))
        ;; the fixed keys on the stock and the waste, in the tags' own
        ;; small set and size (David, 2026-09-18: drawn larger, the J read
        ;; as a jack)
        (for-each
          (lambda (entry)
            (let* ((r (place-rect g game (car entry)))
                   (label (cdr entry))
                   (tw (text-width-mini label 2))
                   (w (+ 4 tw))
                   (x (+ (car r) (caddr r) -3 (- w)))
                   (y (+ (cadr r) 2)))
              (draw-tag-box x y w 14)
              (color! C-LABEL-LIT)
              (draw-text-mini label (+ x 2) (+ y 2) 2)))
          (append (list (cons '(stock) (symbol->string STOCK-KEY)))
                  (if (pair? (game-waste game))
                      (list (cons '(waste) (symbol->string WASTE-KEY)))
                      '())))
        (for-each
          (lambda (entry)
            (let* ((r (place-rect g game (car entry)))
                   (label (cdr entry))
                   (tw (text-width-mini label 2))
                   (w (+ 4 tw))
                   (x (+ (car r) (caddr r) -3 (- w)))
                   (y (+ (cadr r) 2))
                   (prefix? (and (> (string-length typed) 0)
                                 (<= (string-length typed) (string-length label))
                                 (string=? typed (substring label 0 (string-length typed))))))
              (draw-tag-box x y w 14)
              (color! (if prefix? C-HIGHLIGHT C-LABEL-LIT))
              (draw-text-mini label (+ x 2) (+ y 2) 2)))
          (deal-labels d))))

    ;; --- HUD ----------------------------------------------------------------------

    (define TAGS-LINE
      "TAGS: TYPE ONE  F PULL  J BUFFER  SPACE HIDE  ENTER CLEAR")
    ;; With the tags hidden the line says how they come back (David,
    ;; 2026-09-18, after a session with them gone and no way back in view).
    (define TAGS-HIDDEN-LINE
      "TAGS HIDDEN: SPACE SHOWS THEM  F PULL  J BUFFER")
    ;; A jammed stack is not the end: the line says what is left to do,
    ;; and the cards stay in reach (David, 2026-09-18: the centered
    ;; message "covers the cards in a way that I can't actually act").
    (define JAMMED-LINE
      "STACK JAMMED: NO MOVE HELPS. ROLLBACK, SCRAMBLE OR DUMP")

    (define (control-label name game d)
      (case name
        ((undo) "ROLLBACK")
        ((draw) (if (= (game-draw game) 3) "PULL 3" "PULL 1"))
        ((next) "DUMP")
        ((menu) "MENU")
        ((scram) "SCRAMBLE")
        ((probe) "PROBE")
        (else "?")))

    ;; The buttons; the SCORE readout and the meter are drawn on their own.
    (define (draw-controls g game d)
      (for-each (lambda (c)
                  (let* ((name (car c))
                         (x (cadr c)) (y (caddr c))
                         (w (cadddr c)) (h (list-ref c 4))
                         (label (control-label name game d))
                         (tw (text-width label 2)))
                    (color! C-BAR-C)
                    (draw-filled-rect x y w h)
                    (draw-outline (list x y w h) C-TEXT-DIM)
                    (color! C-TEXT)
                    (draw-text label
                               (+ x (exact (floor (/ (- (if (eq? name 'scram) (- w 12) w) tw) 2))))
                               (+ y 3)
                               2)
                    ;; the bank count, a small badge in the button's corner
                    (when (eq? name 'scram)
                      (let ((n (number->string (deal-scrambles d))))
                        (color! C-LABEL-LIT)
                        (draw-filled-rect (+ x w -11) (+ y 1) 10 9)
                        (color! C-BG)
                        (draw-text n (+ x w -9) (+ y 2) 1)))))
                (filter (lambda (c)
                          (and (not (memq (car c) '(score mode)))
                               (or (not (eq? (car c) 'scram))
                                   (eq? (game-scoring game) 'vegas))))
                        (card-controls g))))

    ;; The score as Windows shows it: the timed Standard total on the
    ;; clean face, the bankroll on the twist face.
    (define (score-text d)
      (let ((game (deal-game d)))
        (if (eq? (game-scoring game) 'vegas)
            (string-append "$" (number->string (game-score game)))
            (number->string (timed-score game (deal-trace d) (deal-won? d))))))

    ;; Row 2's right end: the scoring's name, the bankroll, the dump.
    (define (score-line d)
      (let ((game (deal-game d)))
        (if (eq? (game-scoring game) 'vegas)
            (string-append "BOUNTY  BANK " (number->string (deal-bank d))
                           "  DUMP " (number->string (deal-seed d)))
            (string-append "AUDIT  DUMP " (number->string (deal-seed d))))))

    ;; Row 2 under the ICE and after the sever, in place of the keys line.
    (define (phase-line tr game)
      (case (trace-phase tr)
        ((counter)
         (string-append "TRACED. ICE INBOUND. ICE IN " (trace-ice-string tr)
                        ". LINK SEVERS IN " (trace-countdown-string tr) "."
                        (if (game-corrupted? game)
                            " THE BUFFER IS CORRUPTED: PULL PAST IT."
                            " BRING THE SYSTEM ONLINE.")))
        ((severed)
         "LINK SEVERED. TAP: RETRY LINK / NEW DUMP / JACK OUT (^R ^N).")
        (else #f)))

    ;; The state message that sits in the middle, or "": the win only.
    ;; Everything else (the ICE's lines, AUTOCOMMIT, a scramble, a jammed
    ;; stack) is a toast sliding in beside the HUD, the stack's way
    ;; (David, 2026-09-18: the centered boxes got in the way of the game;
    ;; the jammed one covered the cards while the game went on).
    (define (state-message d)
      (let* ((game (deal-game d))
             (tr (deal-trace d))
             (message (deal-message d)))
        (cond ((game-won? game)
               (string-append "SYSTEM ONLINE " (trace-clock-string tr)
                              (cond ((eq? (trace-mode tr) 'clean) "")
                                    ((eq? (trace-cleared-in tr) 'counter)
                                     (string-append " " TAG-UNDER-ICE))
                                    (else (string-append " " TAG-CLEAN-RUN)))))
              (else ""))))

    (define (draw-hud d g x)
      (let* ((game (deal-game d))
             (tr (deal-trace d))
             (vw (card-geometry-vw g))
             (vh (card-geometry-vh g))
             (top (- vh (card-geometry-hud-h g)))
             (right (score-line d))
             (score-rect (card-control-rect g 'score)))
        (color! C-BG)
        (draw-filled-rect 0 top vw (card-geometry-hud-h g))
        (color! C-TEXT-DIM)
        (draw-filled-rect 0 top vw 1)
        (color! C-TEXT)
        (draw-text (score-text d) (car score-rect) (+ (cadr score-rect) 3) 2)
        (color! C-TEXT-DIM)
        (draw-text right (- vw 8 (text-width right 1)) (+ top 32) 1)
        (draw-controls g game d)
        (draw-meter-in (card-control-rect g 'mode) tr)
        (let ((line (and (not (string=? (deal-message d) MSG-STUCK)) (phase-line tr game))))
          (if line
              (begin
                (color! C-HIGHLIGHT)
                (draw-text line 8 (+ top 32) 1))
              (begin
                (color! C-TEXT-DIM)
                (draw-text (cond ((string=? (deal-message d) MSG-STUCK) JAMMED-LINE)
                                 ((deal-labels-shown d) TAGS-LINE)
                                 (else TAGS-HIDDEN-LINE))
                           8
                           (+ top 32)
                           1))))
        (when (> (string-length (deal-typed d)) 0)
          (color! C-HIGHLIGHT)
          (draw-text (string-append "> " (deal-typed d))
                     (- vw 8 (text-width (string-append "> " (deal-typed d)) 2))
                     (+ top 7)
                     2))
        (let ((state (state-message d))
              (toast (card-fx-toast x)))
          (cond ((not (string=? state ""))
                 (draw-message-in vw state top 1.0 0.0))
                ((and toast (not (deal-severed? d)))
                 (draw-toast-in vw (car toast) top (cdr toast)))))))

    ;; --- one frame ------------------------------------------------------------------

    ;; x: the frame's effects from (crash cards fx), already advanced.
    (define (draw-deal d g x)
      (let ((game (deal-game d)))
        (draw-background g)
        (draw-top-row g game x)
        (draw-tableau g game x (if (deal-trace d) (trace-ticks (deal-trace d)) 0))
        (when (and (deal-labels-shown d) (not (deal-auto d)) (not (deal-won? d)))
          (draw-tags d g))
        (draw-hint d g x)
        (draw-movers g x)
        (draw-cascade g x)
        (let ((glitch (card-fx-glitch x))
              (top (- (card-geometry-vh g) (card-geometry-hud-h g))))
          (when glitch (draw-glitch-in (card-geometry-vw g) top (card-fx-ticks x) glitch))
          (when (deal-severed? d)
            (draw-severed-in (card-geometry-vw g)
                             top
                             (card-fx-ticks x)
                             '("RETRY LINK" "NEW DUMP" "JACK OUT"))))
        (draw-hud d g x)))))
