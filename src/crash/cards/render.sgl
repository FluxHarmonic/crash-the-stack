;;; (crash cards render) - Drawing the card table (DEFRAG, ruling D16).
;;;
;;; Takes a deal, a card geometry, the frame's effects and (optionally)
;;; the court-portrait texture, and draws one frame with sigil-graphics
;;; primitives to the bible's section 4 (P3): each packet a flat face over
;;; a darker side strip; an 18 px index band with the rank glyph and the
;;; class mark in the class color and the subsystem tag under the mark
;;; (what a fanned column shows); ranks 2..10 as pips of the class mark in
;;; the classic arrangements (Cybersol's FacePatterns), the BOOT as one
;;; large mark, the courts as a 40x48 portrait from the texture tinted in
;;; the class color (or the large mark when the texture is not there),
;;; each with its name; face-down packets as a back of hex noise with a
;;; cold frame, never a hot color; empty places as outlines; and the HUD
;;; with its tappable controls (rects from (crash cards geometry), so a
;;; tap lands where the button is drawn). Nothing here reads input, a
;;; platform or a clock; the shell hands in the texture it has loaded.
;;; Colors come from (crash palette).

(define-library (crash cards render)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (sigil graphics)
          (crash geometry)
          (crash cards deck)
          (crash cards rules)
          (crash cards geometry)
          (crash cards input)
          (crash cards fx)
          (crash stack prng)
          (crash trace)
          (crash cards trace)
          (crash render)
          (crash font)
          (crash glyphs)
          (crash hud)
          (crash palette))

  (export draw-deal PORTRAITS-PATH PORTRAIT-W PORTRAIT-H)

  (begin
    (define SIDE LAYER-OFFSET)
    (define (half n) (quotient n 2))
    (define GLYPH-SCALE 2)
    ;; The bible's section 4: the index band a fanned packet shows, the
    ;; class mark in it, the pip grid under it, the court portrait block.
    (define BAND-H 18)
    ;; Pips at scale 2 (16 px): David, 2026-09-18, "they look too small
    ;; when in the number-pattern configurations".
    (define PIP-SCALE 2)
    (define PORTRAIT-W 40)
    (define PORTRAIT-H 48)
    ;; A strip of three portraits, DAEMON SYSOP ROOT, a white tint mask on
    ;; transparent (the class color multiplies it), loaded by the shell.
    (define PORTRAITS-PATH "assets/packets/portraits.png")
    ;; The portrait texture this frame, or #f, and the cards the ICE has
    ;; obfuscated with the frame's tick (set by draw-deal; the face drawers
    ;; are reached through the tableau, the movers and the cascade).
    (define *portraits* #f)
    (define *obfuscated* '())
    (define *ticks* 0)
    (define OBFUSCATE-PERIOD 4)

    ;; Cybersol's FacePatterns: pips per column, columns left to right, for
    ;; ranks 2..10; a column of 1 sits at the middle, or at a third when it
    ;; is the middle column between two threes (the seven).
    (define PIP-PATTERNS
      '#((2) (3) (2 2) (2 1 2) (3 3) (3 1 3) (4 4) (4 1 4) (4 2 4)))

    ;; The four subsystems (ruling D16): hot PWR and TX for hearts and
    ;; diamonds, cold MEM and DSK for spades and clubs. One color per
    ;; class, not per subsystem (David, from the phone, 2026-09-18: four
    ;; colors made the game harder to read than two, and the amber was
    ;; unreadable on a small screen); the three-letter tag and the suit
    ;; mark tell the two subsystems of a class apart.
    (define (subsystem-tag c)
      (case (card-suit c)
        ((0) "MEM")
        ((1) "PWR")
        ((2) "TX")
        (else "DSK")))

    (define (suit-color c)
      (if (card-red? c) C-HOT C-COLD))

    ;; The court's in-world names, under the big suit mark.
    (define (rank-word c)
      (case (card-rank c)
        ((1) "BOOT")
        ((11) "DAEMON")
        ((12) "SYSOP")
        ((13) "ROOT")
        (else #f)))

    ;; --- background -----------------------------------------------------------

    ;; bg: the living background, or #f.
    (define (draw-background g bg)
      (let ((vw (card-geometry-vw g))
            (vh (card-geometry-vh g)))
        (color! C-BG)
        (draw-filled-rect 0 0 vw vh)
        (let loop ((y -36) (i 0))
          (when (< y (- vh (card-geometry-hud-h g)))
            (color! (case (modulo i 3)
                       ((0) C-BAR-A)
                       ((1) C-BAR-B)
                       (else C-BAR-C)))
            (draw-filled-rect 0 y vw 6)
            (loop (+ y 12) (+ i 1))))
        (when bg (draw-bg-in bg (- vh (card-geometry-hud-h g))))))

    ;; --- cards ------------------------------------------------------------------

    (define (draw-outline r color)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color! color)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)))

    ;; An empty place: a dim outline; the stock's shows a ring, meaning
    ;; "tap to turn the waste back".
    (define (draw-slot r ring?)
      (draw-outline r C-TEXT-DIM)
      (when ring?
        (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
               (cx (+ x (half w)))
               (cy (+ y (half h))))
          (color! C-TEXT-DIM)
          (draw-filled-rect (- cx 8) (- cy 8) 16 2)
          (draw-filled-rect (- cx 8) (+ cy 6) 16 2)
          (draw-filled-rect (- cx 8) (- cy 8) 2 16)
          (draw-filled-rect (+ cx 6) (- cy 8) 2 16))))

    (define (draw-sides r)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color! C-SIDE-DARK)
        (draw-filled-rect (- x SIDE) (+ y h) (+ w SIDE) SIDE)
        (color! C-SIDE)
        (draw-filled-rect (- x SIDE) y SIDE h)))

    ;; The back (bible section 4): hex-noise rows in C-STATIC-B on C-BG
    ;; inside a C-COLD frame, and no hot color, so a face-down packet never
    ;; looks playable. The noise comes from the table's own random stream
    ;; seeded by the packet's place on the screen, so it holds still.
    ;; The sixteen hex digits as one-character strings, made once: the
    ;; back draws a few hundred of them a frame.
    (define HEX-STRINGS
      (list->vector (map string (string->list "0123456789abcdef"))))
    ;; The noise is sparse on purpose: sokol_gp draws nothing at all once a
    ;; frame passes 65,536 vertices (six per rectangle), and a dealt table
    ;; has 22 backs; four digits on six rows is about 150 rectangles a back
    ;; (the slice-4 review measured the dense form at 400, 97% of the
    ;; budget with the HUD, and an ICE toast over it).
    (define BACK-COLUMNS 4)
    (define BACK-ROW-STEP 12)

    (define (draw-back r)
      (let ((x (car r))
            (y (cadr r))
            (w (caddr r))
            (h (cadddr r)))
        (draw-sides r)
        (color! C-BG)
        (draw-filled-rect x y w h)
        (color! C-COLD)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)
        (color! C-STATIC-B)
        (let rows ((py (+ y 8))
                   (rng (prng-seed (+ 101 (* 7 x) (* 13 y)))))
          (when (< py (+ y h -8))
            (let chars ((k 0)
                        (rng rng))
              (if (< k BACK-COLUMNS)
                  (let ((rng (prng-next rng)))
                    (draw-text-mini (vector-ref HEX-STRINGS (prng-index rng 16))
                                    (+ x 10 (* k 14))
                                    py
                                    1)
                    (chars (+ k 1) rng))
                  (rows (+ py BACK-ROW-STEP) rng)))))))

    ;; --- the face: the index band, the pips, the courts ------------------------

    (define (rank-text c)
      (if (= (card-rank c) 10) "10" (string (rank-char c))))

    ;; Pips of the class mark in the classic arrangement, in the body
    ;; under the band. Three columns sit at the body's left, middle and
    ;; right with 4 px between 16 px marks; two at a quarter and three
    ;; quarters; a column of n spreads its marks evenly over the body's
    ;; height (four of 16 px in 72 with 2 px between), the lone middle
    ;; pip of a seven at a third.
    (define (draw-pips c x y w h)
      (let* ((pattern (vector-ref PIP-PATTERNS (- (card-rank c) 2)))
             (columns (length pattern))
             (mw (* PIP-SCALE MARK-W))
             (mh (* PIP-SCALE MARK-H))
             (col-x (lambda (i)
                      (case columns
                        ((1) (+ x (half (- w mw))))
                        ((2) (+ x (if (= i 0) (- (quotient w 4) (half mw)) (- (* 3 (quotient w 4)) (half mw)))))
                        (else (+ x (* i (+ mw (quotient (- w (* 3 mw)) 2))))))))
             (row-y (lambda (frac) (+ y (exact (round (- (* h frac) (/ mh 2))))))))
        (let loop ((ps pattern) (i 0))
          (unless (null? ps)
            (let ((n (car ps))
                  (cx (col-x i)))
              (cond ((= n 1)
                     (draw-rows (class-mark (card-suit c))
                                cx
                                (row-y (if (and (= columns 3) (= i 1) (= (car pattern) 3)) (/ 1.0 3) 0.5))
                                PIP-SCALE
                                MARK-W))
                    (else
                     (let pips ((k 0))
                       (when (< k n)
                         (draw-rows (class-mark (card-suit c))
                                    cx
                                    (row-y (/ (+ 1 (* 2 k)) (* 2.0 n)))
                                    PIP-SCALE
                                    MARK-W)
                         (pips (+ k 1)))))))
            (loop (cdr ps) (+ i 1))))))

    ;; The court's portrait from the strip (DAEMON SYSOP ROOT = frames
    ;; 0 1 2), a white mask tinted in the class color; the large class
    ;; mark stands in while the texture is not there.
    (define (draw-court c cx cy)
      (let ((frame (- (card-rank c) 11)))
        (if *portraits*
            (draw-texture-region *portraits*
                                 (- cx (half PORTRAIT-W)) (- cy (half PORTRAIT-H))
                                 PORTRAIT-W PORTRAIT-H
                                 (* frame PORTRAIT-W) 0
                                 PORTRAIT-W PORTRAIT-H)
            (draw-rows (class-mark (card-suit c)) (- cx 12) (- cy 12) 3 MARK-W))))

    ;; A face-up packet (bible section 4): the index band a fanned column
    ;; shows (the rank glyph at scale 2 and the 8x8 class mark beside it,
    ;; the subsystem tag under the mark in the 3x5 set, all in the class
    ;; color), then the body: pips for 2..10, one large mark for the BOOT,
    ;; the portrait for a court, with the court's name under it.
    (define (draw-face r c selected?)
      (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
             (rank (rank-text c))
             (rw (text-width rank GLYPH-SCALE))
             (mark-x (+ x 4 rw 4))
             (body-y (+ y BAND-H 2))
             (body-h (- h BAND-H 6)))
        (draw-sides r)
        (color! (if selected? (mix C-SELECTED C-FACE-EDGE 0.3) C-FACE))
        (draw-filled-rect x y w h)
        (color! (if selected? C-SELECTED C-FACE-EDGE))
        (draw-filled-rect x y w 1)
        (draw-filled-rect x y 1 h)
        (color! (suit-color c))
        (if (memv c *obfuscated*)
            ;; obfuscated (P3): the index band sheared and flickering, a
            ;; C-ICE hairline through it; the body is drawn as usual, so
            ;; the packet still reads as a packet, only its identity slowly
            (let ((seed (+ 53 (* 7 c) (* 101 (quotient *ticks* OBFUSCATE-PERIOD)))))
              (let loop ((chars (string->list rank))
                         (cx (+ x 4))
                         (k 0))
                (unless (null? chars)
                  (let ((rows (glyph-rows-of (car chars))))
                    (when rows (draw-rows-sheared rows cx (+ y 2) GLYPH-SCALE GLYPH-W (+ seed k))))
                  (loop (cdr chars) (+ cx (* GLYPH-SCALE (+ GLYPH-W 1))) (+ k 1))))
              (draw-rows-sheared (class-mark (card-suit c)) mark-x (+ y 2) 1 MARK-W (+ seed 9))
              (color! C-ICE)
              (draw-filled-rect x (+ y 8) w 1)
              (color! (suit-color c)))
            (begin
              (draw-text rank (+ x 4) (+ y 2) GLYPH-SCALE)
              (draw-rows (class-mark (card-suit c)) mark-x (+ y 2) 1 MARK-W)
              (draw-text-mini (subsystem-tag c) mark-x (+ y 12) 1)))
        ;; the body, when the face is tall enough to hold one
        (when (>= body-h 24)
          (let ((cx (+ x (half w)))
                (cy (+ body-y (half body-h))))
            (cond ((= (card-rank c) 1)
                   (draw-rows (class-mark (card-suit c)) (- cx 12) (- cy 16) 3 MARK-W))
                  ((>= (card-rank c) 11)
                   (draw-court c cx (- cy 6)))
                  (else
                   (draw-pips c (+ x 4) body-y (- w 8) body-h)))
            (let ((word (rank-word c)))
              (when word
                (color! (suit-color c))
                (draw-text word
                           (- cx (half (text-width word 1)))
                           (+ body-y body-h -6)
                           1)))))
        (when selected?
          (draw-outline (list (- x 1) (- y 1) (+ w 2) (+ h 2)) C-SELECTED))))

    ;; An encrypted packet: the back under a hot veil with a hot strip
    ;; across its top, the strip labeled, so it reads as the ICE's from
    ;; the sliver the fan leaves in view (David, 2026-09-18). left: the
    ;; fraction of the lock's time still to run; the veil fades with it
    ;; and the strip's ground shrinks from the right like a fuse (David:
    ;; "some way to indicate how much time is left").
    (define ENCRYPTED-LABEL "ENCRYPTED")
    (define ENCRYPTED-STRIP 16)

    (define (draw-locked-back r left)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (draw-back r)
        (color-alpha! C-TRACE-HOT (+ 0.08 (* 0.25 left)))
        (draw-filled-rect x y w h)
        (color-alpha! C-TRACE-HOT 0.35)
        (draw-filled-rect x y w ENCRYPTED-STRIP)
        (color! C-TRACE-HOT)
        (draw-filled-rect x y (exact (round (* w left))) ENCRYPTED-STRIP)
        (color! C-BG)
        (draw-text-mini ENCRYPTED-LABEL
                        (+ x (half (- w (text-width-mini ENCRYPTED-LABEL 2))))
                        (+ y 3)
                        2)))

    ;; flag: the pile entry's flag, #t face up, #f face down, a number
    ;; the tick an ICE lock expires at (the waste and the foundations
    ;; pass #t); now: the clock's tick.
    (define (draw-card r c flag selected? now)
      (cond ((eq? flag #t) (draw-face r c selected?))
            ((number? flag)
             (draw-locked-back r (max 0.0 (min 1.0 (/ (- flag now) ENCRYPT-TICKS)))))
            (else (draw-back r))))

    (define (selected-place? game p)
      (equal? (game-selected game) p))

    ;; A pile's card at depth is selected when the selection is at that
    ;; depth or deeper (the run from the selected card up to the top).
    (define (in-selected-run? game i depth)
      (let ((sel (game-selected game)))
        (and sel
             (eq? (car sel) 'pile)
             (= (cadr sel) i)
             (<= depth (caddr sel)))))

    ;; x: the frame's effects; a cascading foundation shows the card under
    ;; the ones it has launched.
    ;; A rect shifted sideways by a hit's shake.
    (define (shaken r hit)
      (if hit
          (list (+ (car r) (exact (round (car hit)))) (cadr r) (caddr r) (cadddr r))
          r))

    ;; The flash over a packet the ICE just hit: hot, fading with the hit.
    (define (draw-hit-flash r hit)
      (when hit
        (color-alpha! C-TRACE-HOT (* 0.55 (cdr hit)))
        (draw-filled-rect (car r) (cadr r) (caddr r) (cadddr r))))

    ;; The corrupted buffer top, for as long as the corruption holds: a
    ;; hot veil and a few flickering slices from the table's random
    ;; stream (David, 2026-09-18: "something visual to make that clear").
    (define (draw-corrupt-veil r ticks)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color-alpha! C-TRACE-HOT 0.35)
        (draw-filled-rect x y w h)
        (let loop ((k 0) (rng (prng-seed (+ 29 (quotient ticks 3)))))
          (when (< k 5)
            (let* ((r1 (prng-next rng))
                   (r2 (prng-next r1))
                   (r3 (prng-next r2)))
              (color-alpha! (if (even? k) C-TRACE-HOT C-BG) 0.6)
              (draw-filled-rect (+ x (- (prng-index r3 8) 4))
                                (+ y (prng-index r1 (max 1 (- h 3))))
                                w
                                (+ 1 (prng-index r2 3)))
              (loop (+ k 1) r3))))))

    (define (draw-top-row g game x)
      (let ((skip (card-fx-moving-cards x)))
        ;; the stock: a back when it has cards, the ring when it is empty
        (if (pair? (game-stock game))
            (draw-back (stock-rect g))
            (draw-slot (stock-rect g) (pair? (game-waste game))))
        ;; the waste: the top card, fanned by three under draw three
        (let* ((waste (game-waste game))
               (shown (min 3 (length waste))))
          (if (null? waste)
              (draw-slot (waste-rect g) #f)
              (let loop ((depth (- shown 1)))
                (when (>= depth 0)
                  (unless (memv (list-ref waste depth) skip)
                    (let* ((hit (and (= depth 0) (card-fx-hit x '(waste 0))))
                           (r (shaken (waste-card-rect g game depth) hit)))
                      (draw-face r
                                 (list-ref waste depth)
                                 (and (= depth 0) (selected-place? game '(waste))))
                      (when (and (= depth 0) (game-corrupted? game))
                        (draw-corrupt-veil r (card-fx-ticks x)))
                      (draw-hit-flash r hit)))
                  (loop (- depth 1))))))
        ;; the foundations
        (let loop ((i 0))
          (when (< i FOUNDATIONS)
            (let* ((f (game-foundation game i))
                   (r (foundation-rect g i))
                   (gone (if (card-fx-idle? x) 0 (vector-ref (card-fx-launched x) i)))
                   (f (if (> gone 0) (drop-n f (min gone (length f))) f))
                   (f (let drop-moving ((f f)) (if (and (pair? f) (memv (car f) skip)) (drop-moving (cdr f)) f))))
              (if (null? f)
                  (draw-slot r #f)
                  (draw-face r (car f) (selected-place? game (list 'foundation i)))))
            (loop (+ i 1))))))

    ;; The cards sliding to their new places, drawn last so they pass
    ;; over everything.
    (define (draw-movers g x)
      (for-each (lambda (m)
                  (draw-card (cadr m) (car m) (caddr m) #f 0))
                (card-fx-movers x)))

    ;; The cascade: each flying card over its trail (the placeholder for
    ;; P3's glyph streams), on the board area only.
    ;; The cascade: each flyer's trail of faces, then the flyer, and
    ;; (bible section 5, P3) the 2 px fragments it sheds in its class
    ;; color along its bottom edge, scattered from the frame's tick so
    ;; they flicker as the packet passes.
    (define (draw-cascade g x)
      (let ((w (card-geometry-card-w g))
            (h (card-geometry-card-h g))
            (ticks (card-fx-ticks x)))
        (for-each (lambda (f)
                    (let loop ((trail (reverse (flyer-trail f))) (k 0))
                      (unless (null? trail)
                        (draw-face (list (exact (floor (car (car trail))))
                                         (exact (floor (cdr (car trail))))
                                         w h)
                                   (flyer-card f)
                                   #f)
                        (loop (cdr trail) (+ k 1))))
                    (draw-face (list (exact (floor (flyer-x f)))
                                     (exact (floor (flyer-y f)))
                                     w h)
                               (flyer-card f)
                               #f)
                    (draw-fragments (flyer-card f)
                                    (exact (floor (flyer-x f)))
                                    (+ (exact (floor (flyer-y f))) h)
                                    w
                                    (flyer-trail f)
                                    ticks))
                  (reverse (card-fx-flying x)))))

    ;; Fragments under a flyer's bottom edge (x, y its left and bottom)
    ;; and behind it along the trail: 2 px squares in the class color,
    ;; one draw per fragment from the tick-seeded stream.
    (define FRAGMENTS 6)
    (define (draw-fragments c x y w trail ticks)
      (color! (suit-color c))
      (let loop ((k 0) (rng (prng-seed (+ 41 ticks (* 7 (card-rank c))))))
        (when (< k FRAGMENTS)
          (let* ((r1 (prng-next rng))
                 (r2 (prng-next r1)))
            (draw-filled-rect (+ x (prng-index r1 (max 1 w))) (+ y 1 (prng-index r2 6)) 2 2)
            (loop (+ k 1) r2))))
      (let loop ((t trail) (k 0))
        (when (and (pair? t) (< k 4))
          (let* ((rng (prng-seed (+ 43 ticks k)))
                 (r1 (prng-next rng)))
            (draw-filled-rect (+ (exact (floor (car (car t)))) (prng-index r1 (max 1 w)))
                              (+ (exact (floor (cdr (car t)))) (quotient (* 3 w) 4))
                              2
                              2)
            (loop (cdr t) (+ k 1))))))

    (define (draw-tableau g game x now)
      (let ((skip (card-fx-moving-cards x)))
        (let loop ((i 0))
          (when (< i PILES)
            (let* ((pile (game-pile game i))
                   (n (length pile)))
              (if (= n 0)
                  (draw-slot (pile-slot-rect g i) #f)
                  ;; bottom card first, so each card covers the one under it
                  (let draw ((depth (- n 1)))
                    (when (>= depth 0)
                      (let ((entry (list-ref pile depth)))
                        (unless (memv (pile-card entry) skip)
                          (let* ((hit (card-fx-hit x (list 'pile i depth)))
                                 (r (shaken (pile-card-rect g game i depth) hit)))
                            (draw-card r
                                       (pile-card entry)
                                       (cdr entry)
                                       (in-selected-run? game i depth)
                                       now)
                            (draw-hit-flash r hit))))
                      (draw (- depth 1))))))
            (loop (+ i 1))))))

    ;; --- the key overlays ---------------------------------------------------------
    ;;
    ;; Each place's tag in the 3x5 set, top right of its exposed strip
    ;; (the rank sits top left), the letters typed so far lit; drawn only
    ;; while the deal's labels-shown holds.

    ;; The rect a place shows: a pile card's own rect (its top strip is
    ;; what the fan leaves visible), else the place's rect.
    (define (place-rect g game p)
      (case (car p)
        ((stock) (stock-rect g))
        ((waste) (waste-card-rect g game 0))
        ((foundation) (foundation-rect g (cadr p)))
        ((pile)
         (let ((depth (if (pair? (cddr p)) (caddr p) 0)))
           (if (>= depth (length (game-pile game (cadr p))))
               (pile-slot-rect g (cadr p))
               (pile-card-rect g game (cadr p) depth))))
        (else (list 0 0 0 0))))

    (define (draw-tag-box x y w h)
      (color! C-BG)
      (draw-filled-rect x y w h))

    ;; --- the PROBE's hint ------------------------------------------------------------
    ;;
    ;; The move on show: its source and its destination ringed twice in
    ;; the highlight color; a source in the feed rings the stock and
    ;; names the card to pull to.

    (define (ring r color)
      (draw-outline r color)
      (draw-outline (list (- (car r) 2) (- (cadr r) 2) (+ (caddr r) 4) (+ (cadddr r) 4)) color))

    (define (draw-hint d g x)
      (let ((h (deal-hint d))
            (game (deal-game d)))
        (when h
          (let* ((src (car h))
                 (dst (cadr h))
                 (src-rect (if (eq? (car src) 'stock) (stock-rect g) (place-rect g game src)))
                 (dst-rect (if (and (eq? (car dst) 'pile) (pair? (game-pile game (cadr dst))))
                               (pile-card-rect g game (cadr dst) 0)
                               (place-rect g game dst))))
            (ring src-rect C-HIGHLIGHT)
            (ring dst-rect C-HIGHLIGHT)
            (when (eq? (car src) 'stock)
              (let* ((label (card-string (cadr src)))
                     (w (+ 6 (text-width label 2))))
                (color! C-HIGHLIGHT)
                (draw-filled-rect (+ (car src-rect) (half (- (caddr src-rect) w))) (+ (cadr src-rect) 40) w 18)
                (color! C-BG)
                (draw-text label (+ (car src-rect) (half (- (caddr src-rect) w)) 3) (+ (cadr src-rect) 43) 2)))))))

    (define (draw-tags d g)
      (let ((game (deal-game d))
            (typed (deal-typed d)))
        ;; the fixed keys on the stock and the waste, in the tags' own
        ;; small set and size (David, 2026-09-18: drawn larger, the J read
        ;; as a jack)
        (for-each
          (lambda (entry)
            (let* ((r (place-rect g game (car entry)))
                   (label (cdr entry))
                   (tw (text-width-mini label 2))
                   (w (+ 4 tw))
                   (x (+ (car r) (caddr r) -3 (- w)))
                   (y (+ (cadr r) 2)))
              (draw-tag-box x y w 14)
              (color! C-LABEL-LIT)
              (draw-text-mini label (+ x 2) (+ y 2) 2)))
          (append (list (cons '(stock) (symbol->string STOCK-KEY)))
                  (if (pair? (game-waste game))
                      (list (cons '(waste) (symbol->string WASTE-KEY)))
                      '())))
        (for-each
          (lambda (entry)
            (let* ((r (place-rect g game (car entry)))
                   (label (cdr entry))
                   (tw (text-width-mini label 2))
                   (w (+ 4 tw))
                   (x (+ (car r) (caddr r) -3 (- w)))
                   (y (+ (cadr r) 2))
                   (prefix? (and (> (string-length typed) 0)
                                 (<= (string-length typed) (string-length label))
                                 (string=? typed (substring label 0 (string-length typed))))))
              (draw-tag-box x y w 14)
              (color! (if prefix? C-HIGHLIGHT C-LABEL-LIT))
              (draw-text-mini label (+ x 2) (+ y 2) 2)))
          (deal-labels d))))

    ;; --- HUD ----------------------------------------------------------------------

    (define TAGS-LINE
      "TAGS: TYPE ONE  F PULL  J BUFFER  TAB HIDE  ENTER CLEAR  SPACE TOOLS  ? KEYS")
    ;; With the tags hidden the line says how they come back (David,
    ;; 2026-09-18, after a session with them gone and no way back in view).
    (define TAGS-HIDDEN-LINE
      "TAGS HIDDEN: TAB SHOWS THEM  F PULL  J BUFFER  SPACE TOOLS")
    ;; A jammed stack is not the end: the line says what is left to do,
    ;; and the cards stay in reach (David, 2026-09-18: the centered
    ;; message "covers the cards in a way that I can't actually act").
    (define JAMMED-LINE
      "STACK JAMMED: NO MOVE HELPS. ROLLBACK, SCRAMBLE OR DUMP")

    ;; The score as Windows shows it: the timed Standard total on the
    ;; clean face, the bankroll on the twist face.
    (define (score-text d)
      (let ((game (deal-game d)))
        (if (eq? (game-scoring game) 'vegas)
            (string-append "$" (number->string (game-score game)))
            (number->string (timed-score game (deal-trace d) (deal-won? d))))))

    ;; Row 2's right end: the scoring's name, the bankroll, the dump.
    (define (score-line d)
      (let ((game (deal-game d)))
        (if (eq? (game-scoring game) 'vegas)
            (string-append "BOUNTY  BANK " (number->string (deal-bank d))
                           "  DUMP " (number->string (deal-seed d)))
            (string-append "AUDIT  DUMP " (number->string (deal-seed d))))))

    ;; Row 2 under the ICE and after the sever, in place of the keys line.
    (define (phase-line tr game)
      (case (trace-phase tr)
        ((counter)
         (string-append "TRACED. ICE INBOUND. ICE IN " (trace-ice-string tr)
                        ". LINK SEVERS IN " (trace-countdown-string tr) "."
                        (if (game-corrupted? game)
                            " THE BUFFER IS CORRUPTED: PULL PAST IT."
                            " BRING THE SYSTEM ONLINE.")))
        ((severed)
         "LINK SEVERED. TAP: RETRY LINK / NEW DUMP / JACK OUT (^R ^N).")
        (else #f)))

    ;; The state message that sits in the middle, or "": the win only.
    ;; Everything else (the ICE's lines, AUTOCOMMIT, a scramble, a jammed
    ;; stack) is a toast sliding in beside the HUD, the stack's way
    ;; (David, 2026-09-18: the centered boxes got in the way of the game;
    ;; the jammed one covered the cards while the game went on).
    (define (state-message d)
      (let* ((game (deal-game d))
             (tr (deal-trace d))
             (message (deal-message d)))
        (cond ((game-won? game)
               (string-append "SYSTEM ONLINE " (trace-clock-string tr)
                              (cond ((eq? (trace-mode tr) 'clean) "")
                                    ((eq? (trace-cleared-in tr) 'counter)
                                     (string-append " " TAG-UNDER-ICE))
                                    (else (string-append " " TAG-CLEAN-RUN)))))
              (else ""))))

    (define (draw-hud d g x)
      (let* ((game (deal-game d))
             (tr (deal-trace d))
             (vw (card-geometry-vw g))
             (vh (card-geometry-vh g))
             (top (- vh (card-geometry-hud-h g)))
             (layout (deal-hud d))
             (st (deal-tools d))
             (tools (deal-tools-list d))
             (right (score-line d))
             (score-rect (card-control-rect g layout 'score))
             (meter-rect (card-control-rect g layout 'mode)))
        (draw-bar-frame vw vh top layout tr st (not (every tool-enabled tools)))
        (draw-meter-in meter-rect tr)
        (draw-readout score-rect layout (score-text d) C-TEXT)
        ;; the scoring's name, the bankroll and the dump under the score
        (color! C-TEXT-DIM)
        (draw-text-mini right (- (+ (car score-rect) (caddr score-rect)) (text-width-mini right 1))
                        (if (eq? layout 'strip) (+ top 16) (+ top 24))
                        1)
        ;; beside the meter: the ICE countdown under the ICE
        (when (eq? (trace-phase tr) 'counter)
          (color! C-ICE)
          (if (eq? layout 'strip)
              (draw-text (string-append "ICE IN " (trace-ice-string tr)) (+ 100 (half vw)) (+ top 3) 1)
              (draw-text (string-append "ICE IN " (trace-ice-string tr)) (+ (car meter-rect) (caddr meter-rect) 8) (+ top 8) 1)))
        (draw-keys-mark (card-control-rect g layout 'keys) (deal-keys-shown d))
        (let ((line (and (not (string=? (deal-message d) MSG-STUCK)) (phase-line tr game))))
          (cond ((deal-keys-shown d)
                 (draw-line-2 vw top (if (deal-labels-shown d) TAGS-LINE TAGS-HIDDEN-LINE) C-TEXT-DIM))
                (line (draw-line-2 vw top line (phase-color tr)))
                ((string=? (deal-message d) MSG-STUCK)
                 (draw-line-2 vw top JAMMED-LINE C-TEXT-DIM))
                (else (draw-line-2 vw top (deal-instruction d) C-TEXT-DIM))))
        (when (> (string-length (deal-typed d)) 0)
          (color! C-HIGHLIGHT)
          (draw-text (string-append "> " (deal-typed d))
                     (- (car score-rect) 12 (text-width (string-append "> " (deal-typed d)) 2))
                     (+ top 7)
                     2))
        (let ((state (state-message d))
              (toast (card-fx-toast x)))
          (cond ((not (string=? state ""))
                 (draw-message-in vw state top 1.0 0.0))
                ((and toast (not (deal-severed? d)))
                 (draw-toast-in vw (car toast) top (cdr toast)))))
        (when (tools-open? st)
          (draw-tool-stack vw vh st tools))))

    ;; --- one frame ------------------------------------------------------------------

    ;; x: the frame's effects from (crash cards fx), already advanced.
    ;; tex: the portrait strip the shell has loaded, or #f; bg: the living
    ;; background, stepped by the shell, or #f.
    (define (draw-deal d g x tex bg)
      (let ((game (deal-game d)))
        (set! *portraits* tex)
        (set! *obfuscated* (game-obfuscated game))
        (set! *ticks* (card-fx-ticks x))
        (draw-background g bg)
        (draw-top-row g game x)
        (draw-tableau g game x (if (deal-trace d) (trace-ticks (deal-trace d)) 0))
        (when (and (deal-labels-shown d) (not (deal-auto d)) (not (deal-won? d)))
          (draw-tags d g))
        (draw-hint d g x)
        (draw-movers g x)
        (draw-cascade g x)
        (let ((glitch (card-fx-glitch x))
              (top (- (card-geometry-vh g) (card-geometry-hud-h g))))
          (when glitch (draw-glitch-in (card-geometry-vw g) top (card-fx-ticks x) glitch))
          (when (deal-severed? d)
            (draw-severed-in (card-geometry-vw g)
                             top
                             (card-fx-ticks x)
                             '("RETRY LINK" "NEW DUMP" "JACK OUT")
                             (card-fx-sever x))))
        (draw-hud d g x)))))
