;;; (crash cards fx) - What moves on the card table: the cascade.
;;;
;;; Windows Solitaire's win: the finished foundations bounce and stream
;;; down the screen, one card at a time, each leaving a trail because the
;;; screen is never cleared. This is that, in placeholder form on the
;;; fixed clock of (crash tween): when a deal is observed to be won, the
;;; foundations launch their cards top first, one every CASCADE-GAP
;;; ticks, cycling the four; a card flies with a random sideways
;;; velocity from the table's own random stream, falls under GRAVITY,
;;; bounces off the bottom edge losing BOUNCE of its speed, and is gone
;;; once it leaves the screen sideways. The trail is the card's last
;;; TRAIL positions, drawn behind it. P3 turns the trail into glyph
;;; streams; the physics stays.
;;;
;;; fx-frame advances the clock and the flight; fx-observe watches the
;;; deal before and after a step and starts the cascade on the win. The
;;; renderer reads the flying cards and how many each foundation has
;;; launched, and never advances anything. Everything is immutable and
;;; copy-constructed; nothing reads a platform.

(define-library (crash cards fx)
  (import (sigil struct)
          (sigil math)
          (crash stack prng)
          (crash tween)
          (crash cards deck)
          (crash cards rules)
          (crash cards geometry)
          (crash trace)
          (crash cards input))

  (export card-fx card-fx? card-fx-new card-fx-clock
          card-fx-frame card-fx-observe card-fx-idle?
          card-fx-flying card-fx-launched card-fx-cascading? card-fx-ticks
          card-fx-glitch card-fx-toast
          card-fx-movers card-fx-moving-cards card-fx-hit
          GLITCH-TICKS TOAST-TICKS TOAST-HOLD MOVE-TICKS MOVE-MAX HIT-TICKS HIT-SHAKE
          flyer flyer-card flyer-x flyer-y flyer-trail
          CASCADE-GAP GRAVITY BOUNCE TRAIL LAUNCH-VX-MIN LAUNCH-VX-MAX)

  (begin
    ;; --- knobs ---------------------------------------------------------------

    (define CASCADE-GAP 6)          ; ticks between launches
    (define GRAVITY 0.35)           ; pixels per tick per tick
    (define BOUNCE 0.78)            ; the fraction of speed kept off the bottom edge
    (define TRAIL 14)               ; positions kept behind a flying card
    (define LAUNCH-VX-MIN 1.6)      ; sideways speed, pixels per tick, either way
    (define LAUNCH-VX-MAX 4.2)
    (define LAUNCH-VY -1.5)         ; a small hop off the foundation
    (define GLITCH-TICKS 45)        ; the full-screen glitch when the trace completes
    (define HIT-TICKS 36)           ; a packet the ICE hit shakes and flashes this long
    (define HIT-SHAKE 4.0)          ; pixels of sideways shake, 6 Hz like the stack's mismatch
    (define MOVE-TICKS 10)          ; a card slides to its new place over this many ticks
    (define MOVE-MAX 13)            ; more cards than this moving at once (a scramble, a churn,
                                    ; a turn of the waste) is not a slide but a new picture
    (define TOAST-TICKS 130)        ; a message: held, then it slides up and fades
    (define TOAST-HOLD 0.7)         ; the fraction of TOAST-TICKS it holds still

    ;; A flying card: where it is, where it goes, where it was.
    (define-struct flyer
      (card default: 0)
      (x default: 0.0)
      (y default: 0.0)
      (vx default: 0.0)
      (vy default: 0.0)
      (trail default: '()))         ; ((x . y) ...) newest first

    (define-struct card-fx
      (clock default: #f)
      (cascading? default: #f)
      (launched default: (vector 0 0 0 0))   ; cards launched per foundation
      (next-foundation default: 0)
      (until-launch default: 0)              ; ticks until the next launch
      (game default: #f)                     ; the won game, for what to launch
      (flying default: '())
      (rng default: 1)
      (glitch-ticks default: 0)              ; ticks of glitch left
      (toast-state default: #f)              ; (message . ticks-left), or #f
      (moving default: '())                  ; cards sliding: (card from-rect to-rect up? ticks-left)
      (hits default: '()))                   ; places the ICE just hit: (place . ticks-left)

    (define (card-fx-new)
      (card-fx clock: (clock-new)))

    (define (card-fx-idle? x)
      (and (not (card-fx-cascading? x))
           (null? (card-fx-flying x))
           (= 0 (card-fx-glitch-ticks x))
           (not (card-fx-toast-state x))
           (null? (card-fx-moving x))
           (null? (card-fx-hits x))))

    ;; The places a counter-hack just landed on: the pile card that went
    ;; face down (encrypt), the waste's top (corrupt). Nothing for churn:
    ;; the whole stock changed and the ICE line says so.
    (define (hit-places g0 g1 last-ice)
      (case last-ice
        ((corrupt) (if (pair? (game-waste g1)) (list '(waste 0)) '()))
        ((encrypt)
         (apply append
                (map (lambda (i)
                       (let loop ((a (game-pile g0 i)) (b (game-pile g1 i)) (depth 0) (acc '()))
                         (if (or (null? a) (null? b))
                             (reverse acc)
                             (loop (cdr a) (cdr b) (+ depth 1)
                                   (if (and (pile-up? (car a)) (not (pile-up? (car b)))
                                            (eqv? (pile-card (car a)) (pile-card (car b))))
                                       (cons (list 'pile i depth) acc)
                                       acc)))))
                     (iota PILES))))
        (else '())))

    ;; (dx . flash) for a place the ICE hit, or #f: a 6 Hz sideways shake
    ;; and a flash fading over the hit's life.
    (define (card-fx-hit x p)
      (let ((entry (find (lambda (h) (equal? (car h) p)) (card-fx-hits x))))
        (and entry
             (let* ((left (cdr entry))
                    (age (- HIT-TICKS left))
                    (life (/ left HIT-TICKS)))
               (cons (* HIT-SHAKE life (sin (* 6.283185307179586 6.0 (/ age 60.0))))
                     life)))))

    ;; --- card moves ------------------------------------------------------------
    ;;
    ;; A move is two games; the cards whose place changed slide from where
    ;; they were drawn to where they are drawn now (David, 2026-09-18: hard
    ;; to track where cards go). The renderer draws a sliding card at its
    ;; interpolated rect and leaves its slot empty meanwhile.

    ;; ((card . place) ...) for every card that is drawn somewhere: the
    ;; piles' cards, the foundations' tops, the waste's top three.
    (define (drawn-places g)
      (append
        (apply append
               (map (lambda (i)
                      (let loop ((entries (game-pile g i)) (depth 0) (acc '()))
                        (if (null? entries)
                            (reverse acc)
                            (loop (cdr entries)
                                  (+ depth 1)
                                  (cons (cons (pile-card (car entries)) (list 'pile i depth)) acc)))))
                    (iota PILES)))
        (apply append
               (map (lambda (i)
                      (let ((f (game-foundation g i)))
                        (if (pair? f) (list (cons (car f) (list 'foundation i))) '())))
                    (iota FOUNDATIONS)))
        (let loop ((waste (game-waste g)) (depth 0) (acc '()))
          (if (or (null? waste) (= depth 3))
              (reverse acc)
              (loop (cdr waste) (+ depth 1) (cons (cons (car waste) (list 'waste depth)) acc))))))

    ;; The rect a drawn place has under a game.
    (define (drawn-rect g game p)
      (case (car p)
        ((pile) (pile-card-rect g game (cadr p) (caddr p)))
        ((foundation) (foundation-rect g (cadr p)))
        ((waste) (waste-card-rect g game (cadr p)))
        (else (stock-rect g))))

    ;; Is the card face up at its new place (a pile entry's flag; the rest
    ;; are always up)?
    (define (up-at? game p)
      (if (eq? (car p) 'pile)
          (pile-up? (list-ref (game-pile game (cadr p)) (caddr p)))
          #t))

    ;; A place without its depth: a card that stays in its pile (or on
    ;; its foundation, or in the waste) and only shifts within it has not
    ;; moved.
    (define (home p)
      (case (car p)
        ((pile foundation) (list (car p) (cadr p)))
        (else (list (car p)))))

    ;; The slides a step from g0 to g1 starts: every card drawn in g1 in a
    ;; home other than the one it had in g0 (a card from the stock starts
    ;; at the stock). None when the step moved more than MOVE-MAX cards.
    (define (moves-between g0 g1 g)
      (let* ((before (drawn-places g0))
             (after (drawn-places g1))
             (movers (filter (lambda (entry)
                               (let ((was (assv (car entry) before)))
                                 (not (and was (equal? (home (cdr was)) (home (cdr entry)))))))
                             after)))
        (if (> (length movers) MOVE-MAX)
            '()
            (map (lambda (entry)
                   (let* ((card (car entry))
                          (to (cdr entry))
                          (was (assv card before))
                          (from (if was (cdr was) '(stock))))
                     (list card
                           (drawn-rect g g0 from)
                           (drawn-rect g g1 to)
                           (up-at? g1 to)
                           MOVE-TICKS)))
                 movers))))

    ;; (card rect up?) for every sliding card, at the eased position.
    (define (card-fx-movers x)
      (map (lambda (m)
             (let* ((card (car m))
                    (from (cadr m))
                    (to (caddr m))
                    (up? (cadddr m))
                    (left (list-ref m 4))
                    (t (ease 'out-quad (- 1.0 (/ left MOVE-TICKS)))))
               (list card
                     (list (exact (floor (+ (car from) (* t (- (car to) (car from))))))
                           (exact (floor (+ (cadr from) (* t (- (cadr to) (cadr from))))))
                           (caddr to)
                           (cadddr to))
                     up?)))
           (card-fx-moving x)))

    ;; The cards the renderer must not draw in their slots this frame.
    (define (card-fx-moving-cards x)
      (map car (card-fx-moving x)))

    ;; The glitch's progress 0..1, or #f.
    (define (card-fx-glitch x)
      (and (> (card-fx-glitch-ticks x) 0)
           (- 1.0 (/ (card-fx-glitch-ticks x) GLITCH-TICKS))))

    ;; (message . progress 0..1), or #f.
    (define (card-fx-toast x)
      (let ((t (card-fx-toast-state x)))
        (and t (cons (car t) (- 1.0 (/ (cdr t) TOAST-TICKS))))))

    (define (card-fx-ticks x)
      (clock-ticks (card-fx-clock x)))

    ;; --- observing -------------------------------------------------------------

    ;; The step from before to after won the game: start the cascade from
    ;; the foundations as they stand. A new deal stops it.
    (define (card-fx-observe x before after g)
      (let* ((x (cond ((and (deal-won? after) (not (deal-won? before)))
                       (card-fx x
                                cascading?: #t
                                launched: (vector 0 0 0 0)
                                next-foundation: 0
                                until-launch: CASCADE-GAP
                                game: (deal-game after)
                                flying: '()
                                rng: (prng-seed (+ 7 (card-fx-ticks x)))))
                      ;; a new deal, or the same seed dealt again: the
                      ;; cascade and its bookkeeping stop
                      ((or (not (= (deal-seed before) (deal-seed after)))
                           (and (deal-won? before) (not (deal-won? after))))
                       (card-fx x cascading?: #f flying: '() game: #f launched: (vector 0 0 0 0)))
                      (else x)))
             ;; the trace completing: the glitch
             (x (if (and (eq? (trace-phase (deal-trace after)) 'counter)
                         (not (eq? (trace-phase (deal-trace before)) 'counter)))
                    (card-fx x glitch-ticks: GLITCH-TICKS)
                    x))
             ;; a counter-hack landed: the packets it hit shake and flash
             (x (if (not (= (trace-ice-count (deal-trace before)) (trace-ice-count (deal-trace after))))
                    (card-fx x hits: (append (map (lambda (p) (cons p HIT-TICKS))
                                                  (hit-places (deal-game before) (deal-game after)
                                                              (trace-last-ice (deal-trace after))))
                                             (card-fx-hits x)))
                    x))
             ;; the cards that changed place slide there
             (x (if (and (not (eq? (deal-game before) (deal-game after)))
                         (= (deal-seed before) (deal-seed after))
                         (not (deal-won? after)))
                    (card-fx x moving: (append (moves-between (deal-game before) (deal-game after) g)
                                               (card-fx-moving x)))
                    (card-fx x moving: '())))
             ;; a new message: a toast
             (m (deal-message after)))
        (if (and (> (string-length m) 0)
                 (not (string=? m (deal-message before))))
            (card-fx x toast-state: (cons m TOAST-TICKS))
            x)))

    ;; --- advancing ----------------------------------------------------------------

    ;; The next foundation with a card still to launch, from i, or #f.
    (define (next-with-cards x i)
      (let ((game (card-fx-game x))
            (launched (card-fx-launched x)))
        (let loop ((k 0) (i i))
          (cond ((= k FOUNDATIONS) #f)
                ((< (vector-ref launched i) (length (game-foundation game i))) i)
                (else (loop (+ k 1) (modulo (+ i 1) FOUNDATIONS)))))))

    ;; Launch the next card: the top of the next foundation with cards.
    (define (launch x g)
      (let ((i (next-with-cards x (card-fx-next-foundation x))))
        (if (not i)
            (card-fx x cascading?: #f)
            (let* ((game (card-fx-game x))
                   (n (vector-ref (card-fx-launched x) i))
                   (card (list-ref (game-foundation game i) n))
                   (r (foundation-rect g i))
                   (r1 (prng-next (card-fx-rng x)))
                   (r2 (prng-next r1))
                   (speed (+ LAUNCH-VX-MIN
                             (* (- LAUNCH-VX-MAX LAUNCH-VX-MIN)
                                (/ (prng-index r1 1000) 1000.0))))
                   (vx (if (even? (prng-index r2 2)) speed (- speed)))
                   (launched (vector-copy (card-fx-launched x))))
              (vector-set! launched i (+ n 1))
              (card-fx x
                       launched: launched
                       next-foundation: (modulo (+ i 1) FOUNDATIONS)
                       until-launch: CASCADE-GAP
                       rng: r2
                       flying: (cons (flyer card: card
                                            x: (inexact (car r))
                                            y: (inexact (cadr r))
                                            vx: vx
                                            vy: LAUNCH-VY)
                                     (card-fx-flying x)))))))

    ;; One tick of flight for every card; a card off the sides is dropped.
    (define (fly x g)
      (let ((vw (card-geometry-vw g))
            (floor-y (- (card-geometry-vh g) (card-geometry-hud-h g) (card-geometry-card-h g)))
            (w (card-geometry-card-w g)))
        (card-fx x
                 flying: (filter (lambda (f) (and (> (+ (flyer-x f) w) 0) (< (flyer-x f) vw)))
                                 (map (lambda (f)
                                        (let* ((vy (+ (flyer-vy f) GRAVITY))
                                               (y (+ (flyer-y f) vy))
                                               (bounce? (> y floor-y))
                                               (trail (take (cons (cons (flyer-x f) (flyer-y f))
                                                                  (flyer-trail f))
                                                            (min TRAIL (+ 1 (length (flyer-trail f)))))))
                                          (flyer f
                                                 x: (+ (flyer-x f) (flyer-vx f))
                                                 y: (if bounce? (inexact floor-y) y)
                                                 vy: (if bounce? (- (* vy BOUNCE)) vy)
                                                 trail: trail)))
                                      (card-fx-flying x))))))

    (define (tick x g)
      (let* ((x (fly x g))
             (x (if (> (card-fx-glitch-ticks x) 0)
                    (card-fx x glitch-ticks: (- (card-fx-glitch-ticks x) 1))
                    x))
             (x (let ((t (card-fx-toast-state x)))
                  (cond ((not t) x)
                        ((<= (cdr t) 1) (card-fx x toast-state: #f))
                        (else (card-fx x toast-state: (cons (car t) (- (cdr t) 1)))))))
             (x (card-fx x hits: (filter (lambda (h) (> (cdr h) 0))
                                         (map (lambda (h) (cons (car h) (- (cdr h) 1))) (card-fx-hits x)))))
             (x (card-fx x moving: (filter (lambda (m) (> (list-ref m 4) 0))
                                           (map (lambda (m)
                                                  (list (car m) (cadr m) (caddr m) (cadddr m) (- (list-ref m 4) 1)))
                                                (card-fx-moving x))))))
        (if (not (card-fx-cascading? x))
            x
            (let ((until (- (card-fx-until-launch x) 1)))
              (if (<= until 0)
                  (launch x g)
                  (card-fx x until-launch: until))))))

    ;; Advance the clock by the frame's wall dt and the cascade by the
    ;; ticks that produced.
    (define (card-fx-frame x dt g)
      (let* ((c (clock-advance (card-fx-clock x) dt))
             (x (card-fx x clock: c)))
        (if (card-fx-idle? x)
            x
            (let loop ((n (clock-steps c)) (x x))
              (if (= n 0) x (loop (- n 1) (tick x g)))))))))
