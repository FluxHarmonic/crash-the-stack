;;; (crash cards input) - A frame of input becomes a DEFRAG move.
;;;
;;; DEFRAG is Klondike in the game's fiction (ruling D16, 2026-09-17): a
;;; memory dump of 52 packets in seven stacks, most encrypted, sorted
;;; into four cores in boot order until the system comes back online.
;;; The rules and the code keep the classic names; every string the
;;; player reads uses the in-world ones (the design note's vocabulary
;;; table): feed / buffer for the stock / waste, PULL for a draw,
;;; ROLLBACK for undo, COMMIT for a move to a core, AUTOCOMMIT, AUDIT and
;;; BOUNTY for Standard and Vegas, STACK JAMMED, SYSTEM ONLINE.
;;;
;;; The card table's counterpart of (crash input): the shell hands in the
;;; same input-frame (keys pressed, modifiers held, a pointer click in
;;; virtual coordinates), and deal-step turns it into a new deal. Nothing
;;; here reads a platform.
;;;
;;; A tap lands on a PLACE through (crash cards geometry)'s hit-place and
;;; ends in game-select, the one door of (crash cards rules): tap-tap,
;;; with the stock a tap away. The tools (PULL, ROLLBACK, PROBE, SCRAMBLE,
;;; NEXT, MENU) are the tool stack's (ruling D33, (crash hud)): Space or
;;; the corner button opens it, a tag or a tap fires one, and while it is
;;; open no key reaches a pile. The bar's own controls (the score, the
;;; meter, the ? mark) are hit-tested first, from the rects the renderer
;;; draws. ? shows the keys line; MENU comes out as a request for the
;;; shell.
;;;
;;; The keyboard is the stack's hint model (David, 2026-09-17: "the hint
;;; key overlay in the stack game works really well, we should use the
;;; same in solitaire"; a second model, Cybersol's pile letters, was
;;; tried beside it and dropped on 2026-09-18: "just stay with the hint
;;; one, it is more logical"): the stock is always F and the waste always
;;; J (index-finger keys, always the same: David, 2026-09-17, after the
;;; stock landed on A and strained the pinky); every other tappable place
;;; (each foundation, each pile's face-up cards top down or its empty
;;; slot) wears a tag from the stack's assigner over the rest of the
;;; alphabet; type the tag to tap the place. Space hides and shows the
;;; tags, or clears a half-typed one.
;;;
;;; Always: Return deselects, Backspace undoes (after erasing a typed tag
;;; letter).

(define-library (crash cards input)
  (import (sigil struct)
          (sigil math)
          (crash input)
          (crash cards deck)
          (crash cards rules)
          (crash cards geometry)
          (crash trace)
          (crash cards trace)
          (crash stack prng)
          (crash cards seeds)
          (crash cards lines)
          (crash cards solve)
          (crash hud))

  (export deal deal? deal-new deal-restore
          deal-game deal-seed deal-message deal-won?
          deal-labels deal-labels-shown deal-typed deal-auto deal-bank
          deal-trace deal-severed? deal-finished? deal-with-trace deal-retry
          deal-step deal-advance deal-undo deal-next deal-toggle-draw
          deal-with-bank deal-with-mode deal-with-scoring
          deal-scrambles deal-with-scrambles deal-scramble
          deal-level deal-recent deal-with-progress
          deal-probe deal-probe-step deal-probe-running? deal-hint hint-move
          deal-tools deal-tools-list deal-with-tools-touch
          deal-hud deal-with-hud deal-keys-shown deal-device deal-request deal-clear-request deal-note
          deal-instruction
          PROBE-STEP PROBE-BUDGET HINT-TICKS
          MSG-PROBING MSG-NO-LINE MSG-PROBE-LOST MSG-PROBE-PULL-3
          SCRAMBLE-START SCRAMBLE-MAX MSG-SCRAMBLED MSG-NO-SCRAMBLE MSG-SCRAMBLE-FAILED
          jack-out-tap?
          AUTO-TICKS
          deal-places tag-places STOCK-KEY WASTE-KEY
          MSG-DEALT MSG-WON MSG-STUCK MSG-AUTO MSG-TOO-LATE)

  (begin
    (define MSG-DEALT "JACKED IN. DUMP LOADED. TRACE RUNNING.")
    (define MSG-WON "SYSTEM ONLINE.")
    (define MSG-STUCK "STACK JAMMED.")   ; a toast; the HUD line says what is left to do (JAMMED-LINE)
    (define MSG-PROBING "PROBING FOR A LINE...")
    (define MSG-NO-LINE "NO LINE FROM HERE. ROLLBACK OR SCRAMBLE.")
    (define MSG-PROBE-LOST "PROBE LOST THE THREAD. ROLLBACK OR SCRAMBLE.")
    (define MSG-PROBE-PULL-3 "PROBE READS THE FEED UNDER PULL 1 ONLY.")
    (define MSG-AUTO "AUTOCOMMIT.")
    (define MSG-TOO-LATE "TOO LATE TO SWITCH.")
    (define MSG-SCRAMBLED "SCRAMBLED THE ENCRYPTED PACKETS.")
    (define MSG-NO-SCRAMBLE "NO SCRAMBLE BANKED.")
    (define MSG-SCRAMBLE-FAILED "SCRAMBLE FOUND NO MOVE. KEPT.")

    ;; The scramble bank (design note, Klondike twist 2): a twist deal
    ;; starts with SCRAMBLE-START, a clean run (won before the trace
    ;; completes) earns one more, never past SCRAMBLE-MAX; the overworld
    ;; sells them later. Using one costs SCRAMBLE-COST on the trace.
    (define SCRAMBLE-START 1)
    (define SCRAMBLE-MAX 3)

    ;; Auto-complete plays one card every this many sim ticks (60 a second).
    (define AUTO-TICKS 8)

    ;; A deal is immutable: a change is a copy-construction.
    (define-struct deal
      (game default: #f)
      (seed default: 1)
      (labels default: '())          ; ((place . "ab") ...), recomputed when the game changes
      (labels-shown default: #t)     ; space toggles
      (typed default: "")            ; tag letters typed so far
      (auto default: #f)             ; auto-complete is running: every tableau card is up
      (auto-acc default: 0)          ; ticks toward the next auto-complete step
      (bank default: 0)              ; the Vegas bankroll carried between deals
      (trace default: #f)            ; the ICE, (crash trace) driven by (crash cards trace)
      (scrambles default: 0)         ; scrambles banked, 0..SCRAMBLE-MAX
      (level default: 0)             ; the progression's window start ((crash cards seeds))
      (recent default: '())          ; the last seeds dealt, newest first, at most RECENT-MAX
      (probing default: #f)          ; a PROBE search in progress ((crash cards solve)), or #f
      (shown default: #f)            ; the move PROBE shows: (src dst ticks-left), or #f
      (tools default: (tools-new))   ; the tool stack, (crash hud)
      (hud default: DEFAULT-LAYOUT)  ; the bar's layout, (crash hud)
      (keys-shown default: #f)       ; the keys line in place of the instruction line (?)
      (note default: #f)             ; the shell's line for the won deal (a run's layer, the scoreboard's news), or #f
      (device default: 'mouse)       ; the last input device: touch | mouse | keyboard (the prompt follows it)
      (request default: #f)          ; for the shell: menu, or #f
      (message default: ""))

    ;; --- places and their tags ----------------------------------------------

    ;; The stock's and the waste's keys in TAGS, fixed; the tags of the
    ;; other places come from the alphabet without these two letters, so
    ;; a typed F or J is never the start of a tag.
    (define STOCK-KEY 'f)
    (define WASTE-KEY 'j)
    (define TAG-ALPHABET "asdghklqwertyuiopzxcvbnm")

    (define (tag-char i) (string-ref TAG-ALPHABET i))

    (define (tag-length count)
      (if (<= count (string-length TAG-ALPHABET)) 1 2))

    (define (tag-label i len)
      (if (= len 1)
          (string (tag-char i))
          (let ((n (string-length TAG-ALPHABET)))
            (string (tag-char (quotient i n)) (tag-char (modulo i n))))))

    (define (tag-key? key)
      (let ((name (symbol->string key)))
        (and (= (string-length name) 1)
             (let loop ((i 0))
               (cond ((= i (string-length TAG-ALPHABET)) #f)
                     ((char=? (tag-char i) (string-ref name 0)) #t)
                     (else (loop (+ i 1))))))))

    ;; Every place a tag names, in tag order: the foundations, then each
    ;; pile's face-up cards from the top down (or the empty pile itself).
    ;; The stock and the waste have their fixed keys instead.
    (define (deal-places g)
      (append (map (lambda (i) (list 'foundation i)) (iota FOUNDATIONS))
              (apply append
                     (map (lambda (i)
                            (let ((pile (game-pile g i)))
                              (if (null? pile)
                                  (list (list 'pile i))
                                  (let loop ((depth 0) (acc '()))
                                    (if (or (= depth (length pile))
                                            (not (pile-up? (list-ref pile depth))))
                                        (reverse acc)
                                        (loop (+ depth 1)
                                              (cons (list 'pile i depth) acc)))))))
                          (iota PILES)))))

    ;; ((place . tag) ...) over the places, the stack's assigner over
    ;; TAG-ALPHABET (one letter while the places fit, two after).
    (define (tag-places g)
      (let* ((places (deal-places g))
             (len (tag-length (length places))))
        (let loop ((places places) (i 0) (acc '()))
          (if (null? places)
              (reverse acc)
              (loop (cdr places)
                    (+ i 1)
                    (cons (cons (car places) (tag-label i len)) acc))))))

    (define (label->place labels text)
      (let ((entry (find (lambda (e) (string=? (cdr e) text)) labels)))
        (and entry (car entry))))

    ;; --- construction ---------------------------------------------------------

    ;; Everything that must follow a game change: the tags, the message,
    ;; the typed text, and auto-complete arming itself the moment every
    ;; tableau card is face up (the history is cut then: the run is not
    ;; undone, like an ICE event).
    (define (with-game d g)
      (let* ((arm? (and (not (deal-auto d))
                        (not (game-won? g))
                        (game-all-up? g)))
             (g (if arm? (game g history: '() selected: #f) g)))
        (deal d
              game: g
              labels: (tag-places g)
              typed: ""
              shown: #f
              probing: #f
              auto: (or (deal-auto d) arm?)
              trace: (if (and (game-won? g) (deal-trace d))
                         (trace-finish (deal-trace d))
                         (deal-trace d))
              scrambles: (if (and (game-won? g)
                                  (deal-trace d)
                                  (eq? (trace-mode (deal-trace d)) 'twist)
                                  (eq? (trace-phase (deal-trace d)) 'trace))
                             (min SCRAMBLE-MAX (+ 1 (deal-scrambles d)))
                             (deal-scrambles d))
              message: (cond ((game-won? g) MSG-WON)
                             ((or arm? (deal-auto d)) MSG-AUTO)
                             ((game-stuck? g) MSG-STUCK)
                             (else "")))))

    (define (deal-severed? d)
      (and (deal-trace d) (trace-severed? (deal-trace d))))

    (define (deal-finished? d)
      (and (deal-trace d)
           (memq (trace-phase (deal-trace d)) '(severed cleared))
           #t))

    ;; The HUD line for what the ICE just did, or the phase that began.
    (define (event-message events)
      (let ((last (if (null? events) #f (list-ref events (- (length events) 1)))))
        (case last
          ((traced) MSG-TRACED)
          ((encrypt) MSG-ENCRYPTED)
          ((corrupt) MSG-CORRUPTED)
          ((churn) MSG-CHURNED)
          ((obfuscate) MSG-OBFUSCATED)
          ((nothing) MSG-NOTHING)
          ((severed) MSG-SEVERED)
          (else #f))))

    ;; The frame's sim ticks reach the trace here (one at a time inside
    ;; trace-advance*, which fires the counter-hacks its seconds cover);
    ;; the game it hands back replaces the deal's. Then auto-complete.
    (define (deal-advance d0 ticks)
      (define d (deal d0 tools: (tools-advance (deal-tools d0) ticks)))
      (cond ((= ticks 0) d)
            ((not (deal-trace d)) (auto-advance (hint-advance d ticks) ticks))
            ((deal-finished? d) d)
            (else
             (let* ((d (hint-advance d ticks))
                    (r (trace-advance* (deal-trace d) (deal-game d) ticks fire-cards-ice))
                    (tr (car r))
                    (g (game-unlock-expired (cadr r) (trace-ticks tr)))   ; locks whose time is up turn back up
                    (events (caddr r))
                    (message (event-message events))
                    (d (cond ((not (eq? g (deal-game d)))
                              (deal (with-game (deal d trace: tr) g) message: (or message "")))
                             (message (deal d trace: tr message: message))
                             (else (deal d trace: tr)))))
               (auto-advance d ticks)))))

    ;; While auto-complete runs, one card every AUTO-TICKS until the game
    ;; is won.
    (define (auto-advance d ticks)
      (if (or (not (deal-auto d)) (deal-won? d) (= ticks 0))
          d
          (let loop ((d d) (acc (+ (deal-auto-acc d) ticks)))
            (cond ((deal-won? d) (deal d auto-acc: 0))
                  ((< acc AUTO-TICKS) (deal d auto-acc: acc))
                  (else
                   (let ((g (game-auto-step (deal-game d))))
                     (if (eq? g (deal-game d))
                         ;; nothing to play and nothing to draw (the stock
                         ;; and waste both empty with no top fitting; a won
                         ;; game never reaches here): the run stops
                         (deal d auto: #f auto-acc: 0 message: MSG-STUCK)
                         (loop (with-game d g) (- acc AUTO-TICKS)))))))))

    ;; A fresh deal: the version (mode: twist, the hacker version with the
    ;; ICE running, or clean, the original with the timer) and the scoring
    ;; (vegas, BOUNTY, or standard, AUDIT) are chosen at deal from the
    ;; settings and the menu (P4: the two are independent; before it, Vegas
    ;; was twist and Standard clean, flipped by a tap on the meter). rest:
    ;; the scoring, then the mode; vegas and twist when not given.
    (define (deal-new seed draw . rest)
      (let ((scoring (if (pair? rest) (car rest) 'vegas))
            (mode (if (and (pair? rest) (pair? (cdr rest))) (cadr rest) 'twist)))
        (deal (with-game (deal seed: seed trace: (trace-new mode) scrambles: SCRAMBLE-START)
                         (game-with-scoring (game-new seed draw) scoring))
              message: MSG-DEALT)))

    (define (deal-with-scrambles d n)
      (deal d scrambles: (max 0 (min SCRAMBLE-MAX n))))

    ;; A scramble: twist mode only, one from the bank, the hidden cards
    ;; reshuffled until a move exists (refused, and the bank kept, when
    ;; SCRAMBLE-TRIES find none), SCRAMBLE-COST on the trace.
    (define (deal-scramble d)
      (cond ((busy? d) d)
            ((not (eq? (trace-mode (deal-trace d)) 'twist)) (deal d message: MSG-TOO-LATE))
            ((<= (deal-scrambles d) 0) (deal d message: MSG-NO-SCRAMBLE))
            (else
             (let ((g (game-scramble (deal-game d))))
               (if (not g)
                   (deal d message: MSG-SCRAMBLE-FAILED)
                   (deal (with-game (deal d
                                          trace: (trace-scramble (deal-trace d))
                                          scrambles: (- (deal-scrambles d) 1))
                                    g)
                         message: MSG-SCRAMBLED))))))

    ;; --- PROBE: the next move of a winning line ------------------------------------
    ;;
    ;; David, 2026-09-18: a hint that "shows the next move of a known
    ;; winning line from the CURRENT position", priced like the stack's
    ;; hint. The deal's own line ((crash cards lines)) is tried first: when
    ;; the position is on it, its next move is the hint at once. Off the
    ;; line the solver runs from here, spread over frames by the shell
    ;; (deal-probe-step, PROBE-STEP positions a call); a position with no
    ;; line says so, and one the budget cannot settle says the probe lost
    ;; the thread. PULL 3 is refused: the solver reads the feed as PULL 1
    ;; does. A hint stays HINT-TICKS or until the table changes.

    (define PROBE-STEP 1)        ; positions per deal-probe-step (the shell calls it while its frame budget lasts)
    (define PROBE-BUDGET 800)    ; positions before the probe gives up (a few ms each in the shipped builds: seconds, not minutes)
    (define HINT-TICKS 120)      ; a hint stays this long (2 s)

    (define (deal-probe-running? d)
      (and (deal-probing d) #t))

    ;; (src dst ticks-left) of the hint on show, or #f.
    (define (deal-hint d) (deal-shown d))

    ;; The position's index on the deal's own line, or #f: the index k
    ;; such that the line's first k moves from the deal give this
    ;; position (the pool model: feed and buffer as one pool).
    (define (line-index d)
      (let* ((seed (deal-seed d))
             (k (let loop ((i 0))
                  (cond ((= i (vector-length WINNABLE-SEEDS)) #f)
                        ((= (vector-ref WINNABLE-SEEDS i) seed) i)
                        (else (loop (+ i 1)))))))
        (and k
             (let ((line (line-moves k))
                   (key (position-key (pool-game (deal-game d)))))
               (let loop ((g (pool-game (game-new seed 1))) (line line) (n 0))
                 (cond ((string=? (position-key g) key) (cons n line))
                       ((null? line) #f)
                       (else (loop (fast-move g (car line)) (cdr line) (+ n 1)))))))))

    ;; A line move as a move on the real table: a pool card from the
    ;; waste when it tops it, else from the stock (pull until it tops
    ;; the waste); #f when the rules refuse it here (a lock in the way).
    (define (real-move g m)
      (let ((src (car m)) (dst (cdr m)))
        (cond ((not (eq? (car src) 'pool))
               (and (game-move g src dst) m))
              ((and (pair? (game-waste g)) (= (car (game-waste g)) (cadr src)))
               (and (game-move g '(waste) dst) (cons (list 'waste) dst)))
              (else
               ;; playable once pulled to the top: check the move from a
               ;; game with the card there
               (let ((probe (game g stock: '() waste: (list (cadr src)))))
                 (and (game-move probe '(waste) dst) (cons (list 'stock (cadr src)) dst)))))))

    ;; (src . dst) of the hint, or #f.
    (define (hint-move d)
      (let ((h (deal-shown d)))
        (and h (cons (car h) (cadr h)))))

    (define (with-hint d m)
      (deal d shown: (list (car m) (cdr m) HINT-TICKS) probing: #f message: (hint-message m)))

    (define (hint-message m)
      (let ((src (car m)) (dst (cdr m)))
        (string-append "PROBE: "
                       (case (car src)
                         ((stock) (string-append "PULL TO " (card-string (cadr src))))
                         ((waste) "THE BUFFER")
                         (else (string-append "STACK " (number->string (+ 1 (cadr src))))))
                       " TO "
                       (case (car dst)
                         ((foundation) "A CORE")
                         (else (string-append "STACK " (number->string (+ 1 (cadr dst)))))))))

    (define (deal-probe d)
      (cond ((busy? d) d)
            ((deal-probing d) d)
            ((= (game-draw (deal-game d)) 3) (deal d message: MSG-PROBE-PULL-3))
            (else
             (let* ((d (deal d trace: (trace-probe (deal-trace d)) shown: #f))
                    (on-line (line-index d))
                    (next (and on-line (pair? (cdr on-line)) (real-move (deal-game d) (car (cdr on-line))))))
               (if next
                   (with-hint d next)
                   (deal d probing: (solve-start (deal-game d) PROBE-BUDGET) message: MSG-PROBING))))))

    ;; One step of a running probe; the hint or the refusal when it ends.
    (define (deal-probe-step d)
      (let ((st (deal-probing d)))
        (if (not st)
            d
            (let* ((st (solve-step st PROBE-STEP))
                   (v (solve-verdict st)))
              (cond ((not v) (deal d probing: st))
                    ((eq? (verdict-status v) 'won)
                     (let ((m (and (pair? (verdict-line v)) (real-move (deal-game d) (car (verdict-line v))))))
                       (if m (with-hint d m) (deal d probing: #f message: MSG-PROBE-LOST))))
                    ((eq? (verdict-status v) 'lost) (deal d probing: #f message: MSG-NO-LINE))
                    (else (deal d probing: #f message: MSG-PROBE-LOST)))))))

    (define (hint-advance d ticks)
      (let ((h (deal-shown d)))
        (cond ((not h) d)
              ((<= (caddr h) ticks) (deal d shown: #f))
              (else (deal d shown: (list (car h) (cadr h) (- (caddr h) ticks)))))))

    ;; While auto-complete runs, the game is won, or the link is severed,
    ;; the table takes no move: only NEXT, RETRY and the menu.
    (define (busy? d)
      (or (deal-auto d) (deal-won? d) (deal-severed? d)))

    ;; The same seed again (a severed deal's first choice, ctrl+r any
    ;; time): a fresh deal of this seed, settings, scoring and mode kept.
    (define (deal-retry d)
      (let ((fresh (deal-new (deal-seed d)
                             (game-draw (deal-game d))
                             (game-scoring (deal-game d))
                             (trace-mode (deal-trace d)))))
        (deal fresh
              labels-shown: (deal-labels-shown d)
              hud: (deal-hud d)
              tools: (deal-tools d)
              device: (deal-device d)
              bank: (deal-bank d)
              scrambles: (max SCRAMBLE-START (deal-scrambles d))
              request: (quote retry))))   ; for the shell: a run's RECONNECT (P4)

    ;; The version: twist (the hacker version, the ICE) or clean (the
    ;; original, timed), only while no move has been made. The scoring is
    ;; its own setting (deal-with-scoring) since P4.
    (define (deal-with-mode d mode)
      (let* ((g (deal-game d))
             (tr (trace-with-mode (deal-trace d) mode)))
        (if (or (> (game-moves g) 0)
                (not (memq mode MODES))
                (not (eq? (trace-mode tr) mode)))   ; the trace refused the flip: nothing moves
            d
            (deal d trace: tr))))

    ;; The scoring, vegas (BOUNTY) or standard (AUDIT), only before the
    ;; first move (game-with-scoring refuses after).
    (define (deal-with-scoring d scoring)
      (with-game d (game-with-scoring (deal-game d) scoring)))

    (define (deal-with-trace d tr)
      (deal d trace: tr))

    ;; A deal from saved parts ((crash cards save)): the game and the
    ;; settings; the tags are recomputed.
    (define (deal-restore seed g labels-shown . rest)
      (with-game (deal seed: seed
                       labels-shown: labels-shown
                       trace: (if (pair? rest) (car rest) (trace-new 'twist)))
                 g))

    (define (deal-won? d)
      (game-won? (deal-game d)))

    ;; An undo that changed something costs UNDO-COST on the trace.
    (define (deal-undo d)
      (let* ((g (deal-game d))
             (g1 (game-undo g)))
        (cond ((busy? d) d)
              ((eq? g g1) d)
              (else (with-game (deal d trace: (trace-undo (deal-trace d))) g1)))))

    ;; The next dump: a seed from the progression's window ((crash cards
    ;; seeds); a cleared dump moves the window up first), not among the
    ;; recent ones, drawn with the game's random stream salted by the
    ;; clock's ticks and the move count (the moment of the DUMP tap, so
    ;; two plays of one deal rarely get the same next deal; no platform
    ;; is read). The draw count, the scoring and the settings are kept; a
    ;; Vegas deal's result joins the bankroll.
    (define (deal-next d)
      (let* ((g (deal-game d))
             (vegas? (eq? (game-scoring g) 'vegas))
             (level (if (deal-won? d) (level-after-win (deal-level d)) (deal-level d)))
             (salt (+ (game-rng g)
                      (if (deal-trace d) (trace-ticks (deal-trace d)) 0)
                      (* 7919 (game-moves g))))
             (picked (pick-seed level (deal-recent d) (prng-seed salt)))
             (seed (car picked))
             (fresh (deal-new seed (game-draw g) (game-scoring g) (trace-mode (deal-trace d)))))
        (deal fresh
              labels-shown: (deal-labels-shown d)
              hud: (deal-hud d)
              tools: (deal-tools d)
              device: (deal-device d)
              bank: (if vegas? (+ (deal-bank d) (game-score g)) (deal-bank d))
              scrambles: (max SCRAMBLE-START (deal-scrambles d))
              level: level
              recent: (take (cons seed (deal-recent d))
                            (min RECENT-MAX (+ 1 (length (deal-recent d)))))
              request: (quote next))))   ; for the shell: a run's next layer (P4)

    (define (deal-with-bank d bank)
      (deal d bank: bank))

    ;; The progression's state from a save: the window start and the
    ;; recent seeds.
    (define (deal-with-progress d level recent)
      (deal d level: (max 0 level) recent: (take recent (min RECENT-MAX (length recent)))))

    ;; One or three: the next draw honors it.
    (define (deal-toggle-draw d)
      (let ((g (deal-game d)))
        (if (busy? d)
            d
            (with-game d (game-with-draw g (if (= (game-draw g) 1) 3 1))))))

    (define (pick d place)
      (cond ((busy? d) d)
            (else
             (let* ((g (deal-game d))
                    (g1 (game-select g place)))
               (cond ((and (eq? g g1) (eq? (car place) 'waste) (game-corrupted? g))
                      (deal d message: MSG-CORRUPT-REFUSED))
                     ((> (game-passes g1) (game-passes g))
                      (with-game (deal d trace: (trace-pass (deal-trace d))) g1))
                     (else (with-game d g1)))))))

    (define (deselect d)
      (let ((g (deal-game d)))
        (if (game-selected g)
            (with-game d (game g selected: #f))
            (deal d typed: ""))))

    ;; --- keys -----------------------------------------------------------------

    (define (pressed? f key) (and (memq key (input-frame-pressed f)) #t))

    (define (typing? d)
      (> (string-length (deal-typed d)) 0))

    ;; The commands; #f when the frame holds none.
    (define (held? f key) (and (memq key (input-frame-held f)) #t))

    (define (step-commands d f)
      (let ((ctrl (held? f 'ctrl)))
        (cond ((pressed? f 'tab) (deal d labels-shown: (not (deal-labels-shown d)) typed: ""))
              ((pressed? f '?) (deal d keys-shown: (not (deal-keys-shown d))))
              ((pressed? f 'escape) (deal d request: 'menu))
              ((pressed? f 'return) (deselect d))
              ((and (pressed? f 'backspace) (not (typing? d))) (deal-undo d))
              ((and ctrl (pressed? f 'r)) (deal-retry d))
              ((and ctrl (pressed? f 'n)) (deal-next d))
              ((and ctrl (pressed? f 's)) (deal-scramble d))
              (else #f))))

    ;; Tags: each letter extends what has been typed; a complete tag taps
    ;; its place; Tab toggles the overlay (Space did, until the tool stack
    ;; took Space); Backspace erases a letter.
    (define (step-tags d f)
      (let loop ((keys (input-frame-pressed f)) (d d))
        (if (null? keys)
            d
            (let ((key (car keys))
                  (typed (deal-typed d)))
              (cond ((and (eq? key 'backspace) (typing? d))
                     (loop (cdr keys)
                           (deal d typed: (substring typed 0 (- (string-length typed) 1)))))
                    ((eq? key STOCK-KEY) (loop (cdr keys) (deal (pick d '(stock)) typed: "")))
                    ((eq? key WASTE-KEY) (loop (cdr keys) (deal (pick d '(waste)) typed: "")))
                    ((not (tag-key? key)) (loop (cdr keys) d))
                    ((not (deal-labels-shown d)) (loop (cdr keys) d))
                    (else
                     (let* ((labels (deal-labels d))
                            (len (tag-length (length labels)))
                            (typed (string-append typed (symbol->string key))))
                       (if (< (string-length typed) len)
                           (loop (cdr keys) (deal d typed: typed))
                           (let ((place (label->place labels typed)))
                             (loop (cdr keys)
                                   (deal (if place (pick d place) d) typed: "")))))))))))

    ;; --- controls and the pointer -----------------------------------------------

    (define (step-control d name)
      (case name
        ((undo) (deal-undo d))
        ((draw) (deal-toggle-draw d))
        ((next) (deal-next d))
        ((score mode) d)   ; drawn, not controls, since P4 (the scoring is a setting)
        ((scram) (deal-scramble d))
        ((probe) (deal-probe d))
        ((keys) (deal d keys-shown: (not (deal-keys-shown d))))
        ((menu) (deal d request: 'menu))
        (else d)))

    ;; --- the tool stack --------------------------------------------------------

    ;; This table's tools for the frame (ruling D33): PULL with its count,
    ;; ROLLBACK, PROBE and SCRAMBLE (twist only: in clean mode they are
    ;; absent, not disabled; SCRAMBLE shows its bank), NEXT. Under SEVERED
    ;; only NEXT; the menu is the bar's button or Escape (David,
    ;; 2026-09-19), not a tool.
    ;; The list is kept until one of its inputs changes (the step and the
    ;; HUD both ask every frame; five tool structs and their lists are
    ;; about 2 KB in the native codegen, 2026-09-20): the key folds the
    ;; draw count, the mode, whether play is on, the probe and the
    ;; scramble bank into one number.
    (define *tools-key* #f)
    (define *tools-list* '())

    (define (deal-tools-list d)
      (let* ((g (deal-game d))
             (twist? (eq? (trace-mode (deal-trace d)) 'twist))
             (play? (and (not (deal-finished? d)) (not (busy? d))))
             (key (+ (if (= (game-draw g) 1) 0 1)
                     (if twist? 2 0)
                     (if play? 4 0)
                     (if (deal-probing d) 8 0)
                     (* 16 (deal-scrambles d)))))
        (unless (eqv? key *tools-key*)
          (set! *tools-list* (build-tools-list g twist? play? d))
          (set! *tools-key* key))
        *tools-list*))

    (define (build-tools-list g twist? play? d)
        (append (list (make-tool 'draw (if (= (game-draw g) 1) "PULL 1" "PULL 3") 'p #f #f play?)
                      (make-tool 'undo "ROLLBACK" 'r #f #f play?))
                (if twist?
                    (list (make-tool 'probe "PROBE" 'o HINT-COST #f
                                     (and play? (not (deal-probing d)) (= (game-draw g) 1)))
                          (make-tool 'scram "SCRAMBLE" 'c SCRAMBLE-COST (deal-scrambles d)
                                     (and play? (> (deal-scrambles d) 0))))
                    '())
                (list (make-tool 'next "NEXT" 'n))))

    ;; The touch flag also sets the device the deal opens on.
    (define (deal-with-tools-touch d touch?)
      (deal d
            tools: (tools-with-touch (deal-tools d) touch?)
            device: (if touch? 'touch 'mouse)))

    (define (deal-with-hud d name)
      (deal d hud: (if (layout-name? name) name DEFAULT-LAYOUT)))

    (define (deal-clear-request d)
      (deal d request: #f))

    ;; The instruction line under the readouts when the keys line is hidden.
    (define (deal-instruction d)
      (cond ((deal-won? d) (or (deal-note d) "SYSTEM ONLINE. NEXT DEALS ANOTHER."))
            ((deal-auto d) "AUTOCOMMIT RUNNING.")
            ((deal-probe-running? d) "PROBING THE BUFFER.")
            ((game-selected (deal-game d)) "NOW WHERE IT GOES.")
            ((eq? (deal-device d) 'keyboard) "STACK THE PACKETS BY CLASS. F PULLS.")
            (else "STACK THE PACKETS BY CLASS. TAP THE FEED TO PULL.")))

    ;; On a severed table the choices are the board area's thirds: RETRY
    ;; LINK (the same deal again), NEW DEAL, JACK OUT (the menu; the shell
    ;; reads that one with jack-out-tap? before stepping).
    (define (jack-out-tap? d f g)
      (let ((click (input-frame-click f)))
        (and click
             (deal-severed? d)
             (< (cdr click) (- (card-geometry-vh g) (card-geometry-hud-h g)))
             (>= (car click) (* 2 (quotient (card-geometry-vw g) 3))))))

    (define (step-pointer d f g)
      (let ((click (input-frame-click f)))
        (cond ((not click) d)
              ((deal-severed? d)
               (if (< (cdr click) (- (card-geometry-vh g) (card-geometry-hud-h g)))
                   (let ((third (quotient (card-geometry-vw g) 3)))
                     (cond ((< (car click) third) (deal-retry d))
                           ((< (car click) (* 2 third)) (deal-next d))
                           (else d)))
                   (let ((name (hit-card-control g (deal-hud d) (car click) (cdr click))))
                     (if (eq? name 'keys) (step-control d name) d))))
              ((hit-card-control g (deal-hud d) (car click) (cdr click))
               => (lambda (name) (step-control d name)))
              (else
               (let ((place (hit-place g (deal-game d) (car click) (cdr click))))
                 (if place (pick d place) d))))))

    ;; --- one frame ----------------------------------------------------------------

    (define (deal-step d f g)
      (let* ((d (let ((dev (frame-device f (tools-touch (deal-tools d)))))
                  (if (and dev (not (eq? dev (deal-device d)))) (deal d device: dev) d)))
             (was-open (tools-open? (deal-tools d)))
             (r (tools-step (deal-tools d)
                            (cons (input-frame-pressed f) (input-frame-click f))
                            (deal-tools-list d)
                            (card-geometry-vw g)
                            (card-geometry-vh g)))
             (d (deal d tools: (car r))))
        (cond (was-open
               ;; modal: the frame was the stack's, whatever it held
               (if (cdr r) (step-control d (cdr r)) d))
              ((tools-open? (car r))
               (deal d typed: ""))
              ((step-commands d f) => (lambda (d) d))
              ((held? f 'ctrl) (step-pointer d f g))
              (else
               (step-tags (step-pointer d f g) f)))))))
