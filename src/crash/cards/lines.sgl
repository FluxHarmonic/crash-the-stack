    (define (char-value ch base) (- (char->integer ch) base))

    ;; The moves of the k-th line as (src . dst) pairs in the rules'
    ;; place notation, a pool card as (pool card).
    (define (line-moves k)
      (let* ((text (vector-ref LINES k))
             (n (quotient (string-length text) 3)))
        (let loop ((i (- n 1)) (acc '()))
          (if (< i 0)
              acc
              (let* ((a (string-ref text (* 3 i)))
                     (b (string-ref text (+ 1 (* 3 i))))
                     (c (string-ref text (+ 2 (* 3 i))))
                     (src (if (char=? a #\p)
                              (list 'pool (char-value b 48))
                              (list 'pile (char-value a 97) (char-value b 48))))
                     (dst (if (char<? c #\F)
                              (list 'pile (char-value c 48))
                              (list 'foundation (char-value c 70)))))
                (loop (- i 1) (cons (cons src dst) acc)))))))))
