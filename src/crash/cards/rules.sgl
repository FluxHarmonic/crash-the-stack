;;; (crash cards rules) - Klondike, the rules and nothing else.
;;;
;;; Windows Solitaire's table: seven tableau piles, four foundations, a
;;; stock and a waste. A game is a snapshot of all of it plus the
;;; selection and a history of earlier snapshots for undo, immutable by
;;; convention like the Mahjongg board in (crash stack rules): every move
;;; returns a new game, so undo is a pop and a bad move never half-applies.
;;;
;;; The rules (Cybersol's valid-pile-move? and valid-foundation-move?, and
;;; the ones it left on its TODO list):
;;;   - a card goes on a tableau pile whose top is the opposite color and
;;;     one rank higher; a king goes on an empty pile; a run of face-up
;;;     cards moves together when its bottom card may;
;;;   - a card goes on a foundation whose top is the same suit and one rank
;;;     lower; an ace goes on an empty foundation; only one card at a time;
;;;   - the stock deals DRAW cards (one or three) onto the waste; an empty
;;;     stock takes the waste back, in order, and counts a pass;
;;;   - the card uncovered on a pile turns face up by itself;
;;;   - the game is won when the four foundations hold thirteen each;
;;;   - Standard or Vegas scoring, Windows' numbers, in the block below.
;;;
;;; game-select is the one door the input layer uses: every tap, and later
;;; every key, names a PLACE and ends here. Places: (pile i depth) with
;;; depth counted from the top card (0 = the top), (waste), (foundation i),
;;; (stock). Tap-tap: a first tap selects a face-up card (on a pile, the
;;; run from that card to the top); a second tap on a pile or foundation
;;; tries the move; a second tap on the selected card sends it to a
;;; foundation when one takes it and deselects otherwise (Windows'
;;; double-click, on a phone); a tap on the stock draws.
;;;
;;; No rendering, windowing or platform import may appear here; the gate
;;; test/test-imports.sgl asserts it.

(define-library (crash cards rules)
  (import (sigil struct)
          (sigil math)
          (crash stack prng)
          (crash cards deck))

  (export game game?
          game-tableau game-foundations game-stock game-waste
          game-draw game-passes game-selected game-history game-moves game-rng
          game-scoring game-score game-corrupt
          game-new game-from-deck game-with-scoring
          game-corrupted? game-corrupt-waste game-encrypt game-churn
          encryptable-places
          game-stuck? game-scramble progress-moves SCRAMBLE-TRIES
          PILES FOUNDATIONS DRAW-COUNTS SCORINGS
          SCORE-TO-FOUNDATION SCORE-WASTE-TO-TABLEAU SCORE-TURN-OVER
          SCORE-FROM-FOUNDATION SCORE-RECYCLE-ONE SCORE-RECYCLE-THREE
          RECYCLE-THREE-FREE
          VEGAS-BUY-IN VEGAS-PER-CARD
          pile-card pile-up? pile-locked? game-pile game-foundation
          place-card place-selectable? selection-cards run-length
          valid-pile-move? valid-foundation-move?
          game-move game-draw! game-undo game-select game-with-draw recycle-allowed? reachable-cards
          game-won? game-all-up? game-face-down-count legal-moves
          game-auto-step
          game-canonical game-equal?)

  (begin
    (define PILES 7)
    (define FOUNDATIONS 4)
    (define DRAW-COUNTS '(1 3))
    (define SCORINGS '(standard vegas))

    ;; --- Windows Solitaire's scoring, the numbers David rules on ------------
    ;; Standard, from the table in Wikipedia's "Klondike (solitaire)" (read
    ;; 2026-09-17): waste or tableau to a foundation 10, waste to the
    ;; tableau 5, a tableau card turned over 5, foundation to the tableau
    ;; -15, the waste turned back -100 under draw one, never below 0. The
    ;; time penalty (-2 per 10 s) and the bonus (700000 / seconds past 30 s)
    ;; belong to the clock and land with the trace. Recalled, not sourced,
    ;; for David to confirm: draw three charges -20 per turn of the waste
    ;; from the fourth pass on. Vegas: 52 to sit down, 5 per card reaching a
    ;; foundation (and 5 back for a card leaving one), the bankroll carried
    ;; between deals; Vegas's pass limit is not kept (see recycle-allowed?).
    (define SCORE-TO-FOUNDATION 10)
    (define SCORE-WASTE-TO-TABLEAU 5)
    (define SCORE-TURN-OVER 5)
    (define SCORE-FROM-FOUNDATION -15)
    (define SCORE-RECYCLE-ONE -100)
    (define SCORE-RECYCLE-THREE -20)
    (define RECYCLE-THREE-FREE 3)     ; passes before draw three's turn charges
    (define VEGAS-BUY-IN 52)
    (define VEGAS-PER-CARD 5)


    ;; tableau: PILES lists of (card . up?), top card first.
    ;; foundations: FOUNDATIONS lists of cards, top first.
    ;; stock, waste: cards, top first (the next card drawn, the last drawn).
    ;; selected: a place, or #f. history: earlier games, newest first.
    (define-struct game
      (tableau default: (vector))
      (foundations default: (vector))
      (stock default: '())
      (waste default: '())
      (draw default: 1)
      (passes default: 0)
      (selected default: #f)
      (history default: '())
      (moves default: 0)
      (scoring default: 'standard)    ; standard | vegas
      (score default: 0)
      (corrupt default: #f)           ; (card . draws-left) while the ICE holds the waste's top
      (rng default: 1))

    ;; --- construction --------------------------------------------------------

    ;; A pile entry is (card . flag): #t face up, #f face down as dealt,
    ;; locked face down by the ICE (an encrypted packet; it looks
    ;; different, plays like a dealt face-down card, and the uncovering
    ;; flip turns it up like any other).
    (define (pile-card entry) (car entry))
    (define (pile-up? entry) (eq? (cdr entry) #t))
    (define (pile-locked? entry) (eq? (cdr entry) 'locked))

    ;; Pile i gets i+1 cards, pile by pile in deck order (Cybersol's loop),
    ;; the last one face up; the rest is the stock, the next card to deal
    ;; on top.
    (define (deal-tableau cards)
      (let ((tableau (make-vector PILES '())))
        (let loop ((i 0) (cards cards))
          (if (= i PILES)
              (cons tableau cards)
              (let inner ((n (+ i 1)) (cards cards) (pile '()))
                (if (= n 0)
                    (begin
                      (vector-set! tableau i (cons (cons (car (car pile)) #t) (cdr pile)))
                      (loop (+ i 1) cards))
                    (inner (- n 1)
                           (cdr cards)
                           (cons (cons (car cards) #f) pile))))))))

    (define (game-from-deck cards draw . rest)
      (let ((dealt (deal-tableau cards)))
        (game tableau: (car dealt)
              foundations: (make-vector FOUNDATIONS '())
              stock: (cdr dealt)
              draw: (if (memv draw DRAW-COUNTS) draw 1)
              rng: (if (pair? rest) (car rest) 1))))

    ;; A seeded deal.
    (define (game-new seed draw)
      (let ((shuffled (shuffled-deck seed)))
        (game-from-deck (car shuffled) draw (cdr shuffled))))

    (define (game-with-draw g draw)
      (if (memv draw DRAW-COUNTS) (game g draw: draw) g))

    ;; Standard or Vegas, settable while no move has been made (Windows
    ;; applies the choice to the next game; here the deal is fresh).
    (define (game-with-scoring g scoring)
      (if (and (memq scoring SCORINGS) (= 0 (game-moves g)))
          (game g
                scoring: scoring
                score: (if (eq? scoring 'vegas) (- VEGAS-BUY-IN) 0))
          g))

    ;; --- queries -------------------------------------------------------------

    (define (game-pile g i) (vector-ref (game-tableau g) i))
    (define (game-foundation g i) (vector-ref (game-foundations g) i))

    (define (place-kind p) (car p))

    ;; The card a place names: a pile's card at its depth, the waste's or a
    ;; foundation's top; #f for an empty place or the stock.
    (define (place-card g p)
      (case (place-kind p)
        ((pile)
         (let ((pile (game-pile g (cadr p)))
               (depth (if (pair? (cddr p)) (caddr p) 0)))
           (and (< depth (length pile))
                (pile-card (list-ref pile depth)))))
        ((waste) (and (pair? (game-waste g)) (car (game-waste g))))
        ((foundation)
         (let ((f (game-foundation g (cadr p))))
           (and (pair? f) (car f))))
        (else #f)))

    ;; Is the waste's top the card the ICE corrupted?
    (define (game-corrupted? g)
      (let ((c (game-corrupt g)))
        (and c
             (pair? (game-waste g))
             (= (car c) (car (game-waste g))))))

    ;; A place the player may pick up: a face-up pile card, the top of the
    ;; waste (unless corrupted), the top of a foundation.
    ;; The face-up run at a pile's top: how many cards from the top are
    ;; face up before the first face-down one (an encrypted packet inside
    ;; a run ends it: the cards under it stay where they are).
    (define (run-length pile)
      (let loop ((entries pile) (n 0))
        (if (or (null? entries) (not (pile-up? (car entries))))
            n
            (loop (cdr entries) (+ n 1)))))

    (define (place-selectable? g p)
      (case (place-kind p)
        ((pile)
         (let ((pile (game-pile g (cadr p)))
               (depth (if (pair? (cddr p)) (caddr p) 0)))
           (< depth (run-length pile))))
        ((waste) (and (place-card g p) (not (game-corrupted? g))))
        ((foundation) (and (place-card g p) #t))
        (else #f)))

    ;; The cards a selection would move, top first: a pile's run down to
    ;; the depth, else the one top card.
    (define (selection-cards g p)
      (case (place-kind p)
        ((pile)
         (let ((depth (if (pair? (cddr p)) (caddr p) 0)))
           (map pile-card (take (game-pile g (cadr p)) (+ depth 1)))))
        (else
         (let ((c (place-card g p)))
           (if c (list c) '())))))

    ;; --- the two rules -------------------------------------------------------

    ;; card onto the top card of a pile (#f for an empty pile).
    (define (valid-pile-move? card top)
      (if (not top)
          (= (card-rank card) 13)
          (and (not (eq? (card-color card) (card-color top)))
               (= (card-rank card) (- (card-rank top) 1)))))

    ;; card onto the top card of a foundation (#f for an empty one).
    (define (valid-foundation-move? card top)
      (if (not top)
          (= (card-rank card) 1)
          (and (= (card-suit card) (card-suit top))
               (= (card-rank card) (+ (card-rank top) 1)))))

    ;; --- moves ---------------------------------------------------------------

    (define (snapshot g)
      (game g history: '()))

    (define (push-history g0 g1)
      (game g1
            history: (cons (snapshot g0) (game-history g0))
            selected: #f
            moves: (+ 1 (game-moves g0))))

    (define (vector-with v i x)
      (let ((nv (vector-copy v)))
        (vector-set! nv i x)
        nv))

    ;; A pile with its top card face up, whatever it was.
    (define (flip-top pile)
      (if (and (pair? pile) (not (pile-up? (car pile))))
          (cons (cons (pile-card (car pile)) #t) (cdr pile))
          pile))

    ;; The game with the selection's cards taken off their place (the
    ;; uncovered pile card turned up), or #f when the place holds nothing.
    (define (take-from g src)
      (let ((cards (selection-cards g src)))
        (and (pair? cards)
             (case (place-kind src)
               ((pile)
                (let* ((i (cadr src))
                       (pile (game-pile g i)))
                  (game g tableau: (vector-with (game-tableau g)
                                                i
                                                (flip-top (drop-n pile (length cards)))))))
               ((waste) (game g waste: (cdr (game-waste g))))
               ((foundation)
                (let ((i (cadr src)))
                  (game g foundations: (vector-with (game-foundations g)
                                                    i
                                                    (cdr (game-foundation g i))))))
               (else #f)))))

    ;; cards (top first) placed on a pile or a foundation, legality already
    ;; checked.
    (define (put-on g dst cards)
      (case (place-kind dst)
        ((pile)
         (let ((i (cadr dst)))
           (game g tableau: (vector-with (game-tableau g)
                                         i
                                         (append (map (lambda (c) (cons c #t)) cards)
                                                 (game-pile g i))))))
        ((foundation)
         (let ((i (cadr dst)))
           (game g foundations: (vector-with (game-foundations g)
                                             i
                                             (append cards (game-foundation g i))))))
        (else g)))

    ;; Is moving the run at src onto dst allowed? dst is a pile or a
    ;; foundation (its depth, if any, is ignored: a tap anywhere on a pile
    ;; means the pile). Only single cards reach a foundation; a run's
    ;; bottom card is what must fit a pile.
    (define (move-legal? g src dst)
      (let ((cards (selection-cards g src)))
        (and (pair? cards)
             (place-selectable? g src)
             (not (equal? (place-name src) (place-name dst)))
             (case (place-kind dst)
               ((pile)
                (valid-pile-move? (list-ref cards (- (length cards) 1))
                                  (place-card g (list 'pile (cadr dst) 0))))
               ((foundation)
                (and (null? (cdr cards))
                     (valid-foundation-move? (car cards) (place-card g dst))))
               (else #f)))))

    ;; A place without its depth: what a destination is.
    (define (place-name p)
      (case (place-kind p)
        ((pile foundation) (list (car p) (cadr p)))
        (else (list (car p)))))

    ;; What a move scores: the destination, the source, and a pile card
    ;; turned over by the move (the source pile's new top was face down).
    (define (move-points g src dst cards)
      (let* ((vegas? (eq? (game-scoring g) 'vegas))
             (n (length cards))
             (turned? (and (eq? (place-kind src) 'pile)
                           (let ((rest (drop-n (game-pile g (cadr src)) n)))
                             (and (pair? rest) (not (pile-up? (car rest))))))))
        (if vegas?
            (cond ((eq? (place-kind dst) 'foundation) VEGAS-PER-CARD)
                  ((eq? (place-kind src) 'foundation) (- VEGAS-PER-CARD))
                  (else 0))
            (+ (cond ((eq? (place-kind dst) 'foundation) SCORE-TO-FOUNDATION)
                     ((eq? (place-kind src) 'foundation) SCORE-FROM-FOUNDATION)
                     ((eq? (place-kind src) 'waste) SCORE-WASTE-TO-TABLEAU)
                     (else 0))
               (if turned? SCORE-TURN-OVER 0)))))

    ;; Standard never goes below zero; Vegas is a bankroll and does.
    (define (add-score g points)
      (let ((total (+ (game-score g) points)))
        (game g score: (if (eq? (game-scoring g) 'vegas) total (max 0 total)))))

    ;; The move, or #f when it is not legal.
    (define (game-move g src dst)
      (and (move-legal? g src dst)
           (let ((cards (selection-cards g src)))
             (push-history g
                           (add-score (put-on (take-from g src) dst cards)
                                      (move-points g src dst cards))))))

    ;; May the waste be turned back into the stock? Always. Windows' Vegas
    ;; allows one pass under draw one and three under draw three; here
    ;; the trace is the price of a pass (PASS-COST, (crash cards trace)),
    ;; and a pass limit on top made a twist deal lose two ways at once
    ;; (David, 2026-09-18, from play: unlimited turns "feel a little
    ;; better and also have a consequence to constantly rotating
    ;; through"). Standard still charges its recycle points.
    (define (recycle-allowed? g)
      #t)

    ;; What turning the waste back costs, given the pass it starts.
    (define (recycle-points g passes)
      (cond ((eq? (game-scoring g) 'vegas) 0)
            ((= (game-draw g) 1) SCORE-RECYCLE-ONE)
            ((> passes RECYCLE-THREE-FREE) SCORE-RECYCLE-THREE)
            (else 0)))

    ;; Turn DRAW cards from the stock onto the waste, the last drawn on
    ;; top; an empty stock takes the waste back (a pass); nothing to do
    ;; with both empty. Named with a bang for the reader's eye only: it
    ;; returns a new game like every move.
    ;; The corruption wears off with the draws: one fewer each, gone at 0.
    (define (draw-off-corrupt g)
      (let ((c (game-corrupt g)))
        (cond ((not c) g)
              ((<= (cdr c) 1) (game g corrupt: #f))
              (else (game g corrupt: (cons (car c) (- (cdr c) 1)))))))

    (define (game-draw! g)
      (cond ((pair? (game-stock g))
             (let loop ((n (game-draw g))
                        (stock (game-stock g))
                        (waste (game-waste g)))
               (if (or (= n 0) (null? stock))
                   (push-history g (draw-off-corrupt (game g stock: stock waste: waste)))
                   (loop (- n 1) (cdr stock) (cons (car stock) waste)))))
            ((and (pair? (game-waste g)) (recycle-allowed? g))
             (let ((passes (+ 1 (game-passes g))))
               (push-history g (add-score (game g
                                                stock: (reverse (game-waste g))
                                                waste: '()
                                                corrupt: #f
                                                passes: passes)
                                          (recycle-points g passes)))))
            (else g)))

    ;; Back to the previous snapshot; a game with no history is returned
    ;; as it is. The move count and passes come back with the snapshot.
    (define (game-undo g)
      (let ((h (game-history g)))
        (if (null? h)
            g
            (game (car h) history: (cdr h) selected: #f))))

    ;; The first foundation that takes the card, as a place, or #f.
    (define (foundation-for g card)
      (let loop ((i 0))
        (cond ((= i FOUNDATIONS) #f)
              ((valid-foundation-move? card (place-card g (list 'foundation i)))
               (list 'foundation i))
              (else (loop (+ i 1))))))

    ;; A pile place always carries its depth once it is a selection, so
    ;; (pile 2) and (pile 2 0) are one tap.
    (define (with-depth p)
      (if (and (eq? (place-kind p) 'pile) (null? (cddr p)))
          (list 'pile (cadr p) 0)
          p))

    ;; The entry point: a tap at a place. See the header for the tap-tap
    ;; rule. A tap that changes nothing returns the same game.
    (define (game-select g p0)
      (let ((p (with-depth p0))
            (sel (game-selected g)))
        (cond ((eq? (place-kind p) 'stock) (game-draw! g))
              ((not sel)
               (if (place-selectable? g p) (game g selected: p) g))
              ((equal? sel p)
               (let* ((cards (selection-cards g sel))
                      (dst (and (pair? cards)
                                (null? (cdr cards))
                                (foundation-for g (car cards)))))
                 (or (and dst (game-move g sel dst))
                     (game g selected: #f))))
              ((game-move g sel p) => (lambda (moved) moved))
              ((place-selectable? g p) (game g selected: p))
              (else (game g selected: #f)))))

    ;; --- what the ICE can do to the table (the members live in (crash cards trace)) ---

    ;; The waste's top card is unplayable for draws draws. No history
    ;; entry: the counter-hacks cut the history themselves.
    (define (game-corrupt-waste g draws)
      (if (pair? (game-waste g))
          (game g corrupt: (cons (car (game-waste g)) draws) selected: #f)
          g))

    ;; Every face-up tableau card with at least one card on top of it:
    ;; what encrypt may turn face down (the uncovered flip brings it back).
    (define (encryptable-places g)
      (apply append
             (map (lambda (i)
                    (let ((pile (game-pile g i)))
                      (let loop ((depth 1) (acc '()))
                        (if (or (>= depth (length pile))
                                (not (pile-up? (list-ref pile depth))))
                            (reverse acc)
                            (loop (+ depth 1) (cons (list 'pile i depth) acc))))))
                  (iota PILES))))

    ;; The card at a pile place turned face down, marked as the ICE's.
    (define (game-encrypt g p)
      (let* ((i (cadr p))
             (depth (caddr p))
             (pile (game-pile g i)))
        (if (or (>= depth (length pile)) (= depth 0))
            g
            (game g
                  tableau: (vector-with (game-tableau g)
                                        i
                                        (append (take pile depth)
                                                (list (cons (pile-card (list-ref pile depth)) 'locked))
                                                (drop-n pile (+ depth 1))))
                  selected: #f))))

    ;; The stock and the waste shuffled together into a new stock with
    ;; the given random state (the caller advances it); the waste empty,
    ;; the passes untouched. Returns (cons game rng).
    (define (game-churn g rng)
      (let* ((cards (list->vector (append (game-stock g) (reverse (game-waste g)))))
             (n (vector-length cards)))
        (let loop ((i (- n 1)) (rng rng))
          (if (< i 1)
              (cons (game g stock: (vector->list cards) waste: '() corrupt: #f selected: #f) rng)
              (let* ((rng (prng-next rng))
                     (j (prng-index rng (+ i 1)))
                     (tmp (vector-ref cards i)))
                (vector-set! cards i (vector-ref cards j))
                (vector-set! cards j tmp)
                (loop (- i 1) rng))))))

    ;; --- the scramble ----------------------------------------------------------

    ;; Attempts at a scramble that leaves a move before it is refused.
    (define SCRAMBLE-TRIES 50)

    ;; The legal moves that get somewhere: a card to a foundation, the
    ;; waste's top to the tableau, or a run whose move turns the card
    ;; under it face up. Shuttling a run between two piles is legal and
    ;; leads nowhere, so it does not count: a table with only such moves
    ;; is what a player calls stuck.
    (define (progress-moves g)
      (filter (lambda (m)
                (let ((src (car m)) (dst (cdr m)))
                  (or (eq? (place-kind dst) 'foundation)
                      (eq? (place-kind src) 'waste)
                      (let* ((pile (game-pile g (cadr src)))
                             (under (drop-n pile (+ 1 (caddr src)))))
                        (and (pair? under) (not (pile-up? (car under))))))))
              (legal-moves g)))

    ;; Is the player out of moves: no progress move on the table now, and
    ;; no card in the stock or the waste that a pile or a foundation would
    ;; take (under either draw count every card there comes round in some
    ;; pass; Vegas's pass limit is not modelled here, so a Vegas deal out
    ;; of passes reads as not stuck while a playable card sits in the
    ;; stock). The scanner the scramble guarantee and the dead-position
    ;; control share.
    ;; The cards the player can bring to the top of the waste from here
    ;; by drawing alone, through one full cycle of the stock (out, turned
    ;; back, out again): every card under draw one; under draw three only
    ;; every third from where the stock stands, which a turn of the waste
    ;; does not change (the adversarial review's probe). A Vegas deal out
    ;; of passes cannot turn the waste: what is left in the stock, and the
    ;; waste's top, are all it can reach.
    (define (reachable-cards g)
      (let ((d (game-draw g)))
        (let loop ((stock (game-stock g))
                   (waste (game-waste g))
                   (turned 0)
                   (acc (if (pair? (game-waste g)) (list (car (game-waste g))) '())))
          (cond ((pair? stock)
                 (let ((n (min d (length stock))))
                   (loop (drop-n stock n)
                         (append (reverse (take stock n)) waste)
                         turned
                         (cons (list-ref stock (- n 1)) acc))))
                ((and (pair? waste) (< turned 2) (recycle-allowed? g))
                 (loop (reverse waste) '() (+ turned 1) acc))
                (else (distinct acc))))))

    (define (distinct cards)
      (let loop ((cs cards) (acc '()))
        (cond ((null? cs) (reverse acc))
              ((memv (car cs) acc) (loop (cdr cs) acc))
              (else (loop (cdr cs) (cons (car cs) acc))))))

    (define (game-stuck? g)
      (and (null? (progress-moves g))
           (let ((tops (append (map (lambda (i) (place-card g (list 'pile i 0))) (iota PILES))))
                 (foundation-tops (map (lambda (i) (place-card g (list 'foundation i))) (iota FOUNDATIONS))))
             (not (any (lambda (card)
                         (or (any (lambda (top) (valid-pile-move? card top)) tops)
                             (any (lambda (top) (valid-foundation-move? card top)) foundation-tops)))
                       (reachable-cards g))))))

    ;; What a pile keeps through a scramble: everything from the top down
    ;; to its last face-up card (an encrypted packet inside the run stays
    ;; in place); the face-down cards under that are the hidden part.
    (define (kept-length pile)
      (let loop ((entries pile) (i 0) (last-up 0))
        (cond ((null? entries) last-up)
              ((pile-up? (car entries)) (loop (cdr entries) (+ i 1) (+ i 1)))
              (else (loop (cdr entries) (+ i 1) last-up)))))

    ;; One shuffle of the hidden cards (every face-down tableau card under
    ;; a pile's last face-up one, the stock and the waste) back into the
    ;; same face-down slots and a new stock, with the given random state;
    ;; face-up cards, foundations and passes untouched. Returns (cons game
    ;; rng).
    (define (shuffle-hidden g rng)
      (let* ((kept (lambda (pile) (take pile (kept-length pile))))
             (hidden (lambda (pile) (drop-n pile (kept-length pile))))
             (down-counts (map (lambda (i) (length (hidden (game-pile g i)))) (iota PILES)))
             (pool (list->vector
                     (append (apply append
                                    (map (lambda (i) (map pile-card (hidden (game-pile g i))))
                                         (iota PILES)))
                             (game-stock g)
                             (reverse (game-waste g)))))
             (n (vector-length pool)))
        (let loop ((i (- n 1)) (rng rng))
          (if (>= i 1)
              (let* ((rng (prng-next rng))
                     (j (prng-index rng (+ i 1)))
                     (tmp (vector-ref pool i)))
                (vector-set! pool i (vector-ref pool j))
                (vector-set! pool j tmp)
                (loop (- i 1) rng))
              (let deal ((i 0) (k 0) (tableau (vector-copy (game-tableau g))))
                (if (= i PILES)
                    (cons (game g
                                tableau: tableau
                                stock: (let rest ((j k) (acc '()))
                                         (if (= j n) (reverse acc) (rest (+ j 1) (cons (vector-ref pool j) acc))))
                                waste: '()
                                corrupt: #f
                                selected: #f)
                          rng)
                    (let* ((pile (game-pile g i))
                           (ups (kept pile))
                           (downs (list-ref down-counts i)))
                      (vector-set! tableau i
                                   (append ups
                                           (let fill ((m 0) (j k) (acc '()))
                                             (if (= m downs)
                                                 (reverse acc)
                                                 (fill (+ m 1) (+ j 1) (cons (cons (vector-ref pool j) #f) acc))))))
                      (deal (+ i 1) (+ k downs) tableau))))))))

    ;; The scramble: shuffle-hidden with the game's random stream until
    ;; the result is not stuck, up to SCRAMBLE-TRIES times; #f when no try
    ;; found a move (the caller refuses the scramble). With the stock and
    ;; the waste both empty no shuffle can help (the face-down cards go
    ;; back under the same face-up ones), so that is refused at once.
    ;; The history is cut: a scramble is not undone.
    (define (game-scramble g)
      (if (and (null? (game-stock g)) (null? (game-waste g)))
          #f
          (let loop ((k 0) (rng (prng-next (game-rng g))))
            (if (= k SCRAMBLE-TRIES)
                #f
                (let* ((r (shuffle-hidden g rng))
                       (candidate (car r)))
                  (if (game-stuck? candidate)
                      (loop (+ k 1) (prng-next (cdr r)))
                      (game candidate rng: (cdr r) history: '() moves: (+ 1 (game-moves g)))))))))

    ;; --- the state of play ---------------------------------------------------

    (define (game-won? g)
      (let loop ((i 0))
        (cond ((= i FOUNDATIONS) #t)
              ((= (length (game-foundation g i)) RANKS) (loop (+ i 1)))
              (else #f))))

    (define (game-face-down-count g)
      (let loop ((i 0) (n 0))
        (if (= i PILES)
            n
            (loop (+ i 1)
                  (+ n (length (filter (lambda (e) (not (pile-up? e)))
                                       (game-pile g i))))))))

    ;; Every tableau card face up: what auto-complete waits for.
    (define (game-all-up? g)
      (= 0 (game-face-down-count g)))

    ;; One step of auto-complete: the first pile top or the waste's top
    ;; that a foundation takes goes there; else a draw (which turns the
    ;; waste back when the stock is out). With every tableau card face up
    ;; some card is always reachable this way, so repeating it wins. A
    ;; won game is returned as it is.
    ;; Auto-complete's own draw: one card, whatever the draw count (draw
    ;; three's parity would otherwise bury a needed card for good: the
    ;; adversarial review's probe), no score, no pass counted, no history
    ;; entry. A corrupted waste top is skipped as a source; the draw past
    ;; it wears the corruption off as any draw does.
    (define (auto-draw g)
      (cond ((pair? (game-stock g))
             (draw-off-corrupt (game g
                                     stock: (cdr (game-stock g))
                                     waste: (cons (car (game-stock g)) (game-waste g)))))
            ((pair? (game-waste g))
             (game g stock: (reverse (game-waste g)) waste: '()))
            (else g)))

    (define (game-auto-step g)
      (if (game-won? g)
          g
          (let ((sources (append (filter (lambda (p) (pair? (game-pile g (cadr p))))
                                         (map (lambda (i) (list 'pile i 0)) (iota PILES)))
                                 (if (and (pair? (game-waste g)) (not (game-corrupted? g)))
                                     (list (list 'waste))
                                     '()))))
            (let loop ((sources sources))
              (cond ((null? sources) (auto-draw g))
                    ((foundation-for g (place-card g (car sources)))
                     => (lambda (dst) (or (game-move g (car sources) dst) (loop (cdr sources)))))
                    (else (loop (cdr sources))))))))

    ;; Every move the player could make now, as (src . dst) places, from
    ;; the piles' face-up runs and the waste's top to a pile or a
    ;; foundation. Left out: moves from a foundation (never progress), and
    ;; a king that already heads its pile moving to another empty pile
    ;; (the same position over again). The stock is not a move here; a
    ;; caller that asks "is the player stuck" also looks at the stock and
    ;; the waste.
    ;; Computed with the tops in hand rather than through move-legal?
    ;; pair by pair: the scramble leg calls this tens of thousands of
    ;; times (measured 2026-09-17: 15 minutes the slow way).
    (define (legal-moves g)
      (let* ((pile-tops (map (lambda (i) (place-card g (list 'pile i 0))) (iota PILES)))
             (fdests (foundation-dests g))
             (foundation-tops (map (lambda (dst) (place-card g dst)) fdests))
             (corrupted? (game-corrupted? g))
             ;; the destinations a single card (top first in its run) may take
             (dests-for
               (lambda (src bottom single? from-pile)
                 (append
                   (let loop ((i 0) (tops pile-tops) (acc '()))
                     (cond ((= i PILES) (reverse acc))
                           ((and (not (eqv? i from-pile))
                                 (valid-pile-move? bottom (car tops))
                                 (not (and (not (car tops))
                                           from-pile
                                           ;; a king heading its pile to another empty pile
                                           (= (+ 1 (caddr src)) (length (game-pile g from-pile))))))
                            (loop (+ i 1) (cdr tops) (cons (cons src (list 'pile i)) acc)))
                           (else (loop (+ i 1) (cdr tops) acc))))
                   (if single?
                       (let loop ((ds fdests) (tops foundation-tops) (acc '()))
                         (cond ((null? ds) (reverse acc))
                               ((valid-foundation-move? bottom (car tops))
                                (loop (cdr ds) (cdr tops) (cons (cons src (car ds)) acc)))
                               (else (loop (cdr ds) (cdr tops) acc))))
                       '())))))
        (append
          (apply append
                 (map (lambda (i)
                        (let loop ((depth 0) (entries (game-pile g i)) (acc '()))
                          (if (or (null? entries) (not (pile-up? (car entries))))
                              (apply append (reverse acc))
                              (loop (+ depth 1)
                                    (cdr entries)
                                    (cons (dests-for (list 'pile i depth)
                                                     (pile-card (car entries))
                                                     (= depth 0)
                                                     i)
                                          acc)))))
                      (iota PILES)))
          (if (and (pair? (game-waste g)) (not corrupted?))
              (dests-for '(waste) (car (game-waste g)) #t #f)
              '()))))

    ;; The foundations as destinations, with only the first empty one
    ;; listed: an ace to any empty foundation is one move, not four.
    (define (foundation-dests g)
      (let loop ((i 0) (empty-seen? #f) (acc '()))
        (cond ((= i FOUNDATIONS) (reverse acc))
              ((null? (game-foundation g i))
               (loop (+ i 1) #t (if empty-seen? acc (cons (list 'foundation i) acc))))
              (else (loop (+ i 1) empty-seen? (cons (list 'foundation i) acc))))))

    ;; --- structural equality -------------------------------------------------

    (define (game-canonical g)
      (list (vector->list (game-tableau g))
            (vector->list (game-foundations g))
            (game-stock g)
            (game-waste g)
            (game-draw g)
            (game-passes g)
            (game-selected g)
            (game-scoring g)
            (game-score g)
            (game-corrupt g)))

    (define (game-equal? a b)
      (equal? (game-canonical a) (game-canonical b)))))
