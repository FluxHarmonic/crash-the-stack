;;; (crash save) - A session as a datum, and back.
;;;
;;; What survives a reload or a restart: the board's position (which
;;; slots hold a tile, their faces, the locks, the selection, the random
;;; state the next shuffle draws from), the trace meter, and the settings
;;; a player has changed (keyboard model, tags shown, renderer, meter
;;; face). Not the history: undo does not reach across a reload (a P1
;;; limit, about 30 KB of snapshots if it ever should). The layout is
;;; named, not embedded; only the Turtle exists so far.
;;;
;;; datum->session is strict: anything not shaped like a save of this
;;; version answers #f, and the caller deals a fresh board. A corrupted
;;; save must never trap the game at boot. (crash store) turns the datum
;;; into text and back; this module reads no platform.

(define-library (crash save)
  (import (sigil struct)
          (sigil list)
          (sigil math)
          (crash stack layout)
          (crash stack rules)
          (crash stack turtle)
          (crash input)
          (crash trace)
          (crash look))

  (export SAVE-VERSION session->datum datum->session
          save-due? SAVE-EVERY-TICKS
          best->datum datum->best)

  (begin
    (define SAVE-VERSION 1)

    ;; The meter's time is saved every so many ticks (5 s) between the
    ;; events that save at once, so a reload loses at most that much.
    (define SAVE-EVERY-TICKS 300)

    ;; Does the step from before to after warrant a save? A board change,
    ;; a hint, a shuffle, the lock, a flipped face or setting, a cleared
    ;; board, or the clock crossing a SAVE-EVERY-TICKS boundary.
    (define (save-due? before after)
      (let ((b0 (session-board before))
            (b1 (session-board after))
            (t0 (session-trace before))
            (t1 (session-trace after)))
        (or (not (eq? b0 b1))
            (not (= (trace-hints t0) (trace-hints t1)))
            (not (= (trace-shuffles t0) (trace-shuffles t1)))
            (not (eq? (trace-phase t0) (trace-phase t1)))
            (not (= (trace-ice-count t0) (trace-ice-count t1)))
            (not (eq? (trace-mode t0) (trace-mode t1)))
            (not (eq? (session-model before) (session-model after)))
            (not (eq? (session-labels-shown before) (session-labels-shown after)))
            (not (eq? (session-look before) (session-look after)))
            (not (= (quotient (trace-ticks t0) SAVE-EVERY-TICKS)
                    (quotient (trace-ticks t1) SAVE-EVERY-TICKS))))))

    ;; The best (lowest) finished trace per layout: ((turtle . seconds)).
    (define (best->datum best)
      (list 'crash-best SAVE-VERSION (cons 'turtle best)))

    (define (datum->best d)
      (and (pair? d)
           (eq? (car d) 'crash-best)
           (pair? (cdr d))
           (eqv? (cadr d) SAVE-VERSION)
           (pair? (cddr d))
           (let ((entry (assq 'turtle (cddr d))))
             (and entry
                  (number? (cdr entry))
                  (>= (cdr entry) 0)
                  (cdr entry)))))

    (define (session->datum s)
      (let ((b (session-board s))
            (tr (session-trace s)))
        (list 'crash-save
              SAVE-VERSION
              (cons 'seed (session-seed s))
              (cons 'moves (session-moves s))   ; P4; absent in an earlier save, read as 0
              (cons 'marks (session-marks s))   ; P5 (D64): the node's objective; absent in an earlier save, read as none
              (cons 'layout 'turtle)
              (cons 'present (vector->list (board-present b)))
              (cons 'faces (vector->list (board-faces b)))
              (cons 'locked (vector->list (board-locked b)))
              (cons 'scrambled (board-scrambled-slots b))
              (cons 'selected (board-selected b))
              (cons 'rng (board-rng b))
              (list 'trace
                    (trace-mode tr)
                    (trace-phase tr)
                    (trace-ticks tr)
                    (trace-hints tr)
                    (trace-shuffles tr)
                    (trace-countdown tr)
                    (trace-ice-timer tr)
                    (trace-ice-count tr)
                    (trace-last-ice tr)
                    (trace-cleared-in tr)
                    (trace-trace-at tr)
                    (trace-sever-at tr))
              (list 'settings
                    (session-model s)
                    (session-labels-shown s)
                    (session-look s)))))

    (define (field d key)
      (let ((entry (assq key (cddr d))))
        (and entry (cdr entry))))

    (define (booleans? l n)
      (and (list? l)
           (= (length l) n)
           (every boolean? l)))

    ;; A lock entry is #f or (partner . tick).
    (define (locks? l n)
      (and (list? l)
           (= (length l) n)
           (every (lambda (e)
                    (or (not e)
                        (and (pair? e)
                             (exact? (car e)) (integer? (car e)) (>= (car e) 0) (< (car e) n)
                             (exact? (cdr e)) (integer? (cdr e)) (>= (cdr e) 0))))
                  l)))

    (define (faces? l n)
      (and (list? l)
           (= (length l) n)
           (every (lambda (f)
                    (and (exact? f) (integer? f) (>= f 0) (< f 36)))
                  l)))

    (define (well-formed? d n)
      (and (pair? d)
           (eq? (car d) 'crash-save)
           (pair? (cdr d))
           (eqv? (cadr d) SAVE-VERSION)
           (list? (cddr d))
           (every pair? (cddr d))
           (eq? (field d 'layout) 'turtle)
           (let ((seed (field d 'seed)))
             (and (exact? seed) (integer? seed) (>= seed 0)))
           (booleans? (field d 'present) n)
           (faces? (field d 'faces) n)
           (locks? (field d 'locked) n)
           (let ((sel (field d 'selected)))
             (or (not sel)
                 (and (exact? sel) (integer? sel) (>= sel 0) (< sel n))))
           (let ((rng (field d 'rng)))
             (and (exact? rng) (integer? rng) (> rng 0)))
           (let ((tr (field d 'trace)))
             (and (list? tr)
                  (= (length tr) 12)
                  (memq (car tr) MODES)
                  (memq (cadr tr) PHASES)
                  (every (lambda (x) (and (exact? x) (integer? x) (>= x 0)))
                         (list (list-ref tr 2) (list-ref tr 3) (list-ref tr 4)
                               (list-ref tr 5) (list-ref tr 6) (list-ref tr 7)))
                  (memq (list-ref tr 8) '(#f lock remap scramble))
                  (memq (list-ref tr 9) '(#f trace counter))
                  (every (lambda (x) (and (exact? x) (integer? x) (> x 0)))
                         (list (list-ref tr 10) (list-ref tr 11)))))
           (let ((st (field d 'settings)))
             (and (list? st)
                  (= (length st) 3)
                  (memq (car st) MODELS)
                  (boolean? (cadr st))
                  ;; the look: one name today (the polish row, ruling D32);
                  ;; a P3 save carries any of the sheet switch's names and a
                  ;; P0..P2 save its render mode, every one of them a symbol
                  (symbol? (caddr st))))))

    ;; A saved look: the one there is. Read for the save's shape, ignored.
    (define (saved-look x)
      DEFAULT-LOOK)

    ;; The faces still on the board come in even counts (pairs leave
    ;; together); anything else is not a board this game made and would
    ;; trap the next shuffle.
    ;; The daemons count as one face: a cross-daemon match leaves two of
    ;; their faces odd while any two of them still pair (see reshuffle).
    (define (even-face-counts? faces present)
      (let ((counts (make-vector 36 0)))
        (let loop ((f faces) (p present))
          (unless (null? f)
            (when (car p)
              (let ((face (if (daemon-face? (car f)) DAEMON-FIRST (car f))))
                (vector-set! counts face (+ 1 (vector-ref counts face)))))
            (loop (cdr f) (cdr p))))
        (let loop ((i 0))
          (cond ((= i 36) #t)
                ((odd? (vector-ref counts i)) #f)
                (else (loop (+ i 1)))))))

    ;; A lock entry is kept only when both tiles are present and each names
    ;; the other; anything else is dropped rather than trusted.
    (define (consistent-locks locked present)
      (let ((v (list->vector locked))
            (p (list->vector present)))
        (let loop ((i 0))
          (when (< i (vector-length v))
            (let ((l (vector-ref v i)))
              (when (and l
                         (not (and (vector-ref p i)
                                   (vector-ref p (car l))
                                   (vector-ref v (car l))
                                   (= (car (vector-ref v (car l))) i))))
                (vector-set! v i #f)))
            (loop (+ i 1))))
        v))

    ;; A session from a save datum, or #f when the datum is not one. A
    ;; selection that is no longer a playable, unlocked tile is dropped;
    ;; a random state MINSTD would fix at zero is replaced.
    (define (datum->session d)
      (let* ((lay (turtle-layout))
             (n (layout-slot-count lay)))
        (and (well-formed? d n)
             (even-face-counts? (field d 'faces) (field d 'present))
             (let* ((b0 (board-new lay
                                   (list->vector (field d 'faces))
                                   (list->vector (field d 'present))))
                    (b1 (board b0
                               locked: (consistent-locks (field d 'locked)
                                                         (field d 'present))))
                    ;; scrambled: slot ids (P3); absent in a P0..P2 save, and
                    ;; a mark on a tile that is gone is dropped
                    (b1 (board-scramble b1
                                        (filter (lambda (id)
                                                  (and (integer? id) (>= id 0) (< id n)
                                                       (tile-present? b1 id)))
                                                (or (field d 'scrambled) '()))))
                    (sel (field d 'selected))
                    (b (board b1
                              selected: (and sel
                                             (playable? b1 sel)
                                             (not (tile-locked? b1 sel))
                                             sel)))
                    (tr (field d 'trace))
                    (st (field d 'settings))
                    (rng (field d 'rng)))
               (set-board-rng! b (if (< rng 2147483647) rng 1))
               (session (session-restore (field d 'seed)
                                b
                                (trace mode: (car tr)
                                       phase: (cadr tr)
                                       ticks: (list-ref tr 2)
                                       hints: (list-ref tr 3)
                                       shuffles: (list-ref tr 4)
                                       countdown: (list-ref tr 5)
                                       ice-timer: (list-ref tr 6)
                                       ice-count: (list-ref tr 7)
                                       last-ice: (list-ref tr 8)
                                       cleared-in: (list-ref tr 9)
                                       trace-at: (list-ref tr 10)
                                       sever-at: (list-ref tr 11))
                                (car st)
                                (cadr st)
                                (saved-look (caddr st)))
                        moves: (let ((m (field d 'moves))) (if (and (integer? m) (exact? m) (>= m 0)) m 0))
                        ;; the marks (D64): slot ids; a mark on a tile that is gone is dropped
                        marks: (let ((ms (field d 'marks)))
                                 (if (list? ms)
                                     (filter (lambda (id) (and (integer? id) (exact? id) (>= id 0) (< id n) (tile-present? b id))) ms)
                                     '())))))))))
