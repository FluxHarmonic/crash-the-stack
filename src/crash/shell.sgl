;;; (crash shell) - What both shells agree on before either opens a window.
;;;
;;; The virtual viewport the game is drawn into on every target, the test
;;; tile's path relative to where the game runs (the repo root natively, the
;;; served build/web on the web), the modifier keys (crash input) reads,
;;; and the two things every shell does with the store: restore the saved
;;; board at boot (or deal) and save after a frame that changed something.
;;; The card table (P2) has the same two: boot-deal and save-deal-after-frame!,
;;; under its own store key. (crash shell native) and (crash shell web) import
;;; this and nothing else shared; (crash main) picks between them.

(define-library (crash shell)
  (import (crash stack layout)
          (crash stack rules)
          (crash input)
          (crash trace)
          (crash save)
          (crash store)
          (crash cards input)
          (crash cards save)
          (crash cards seeds)
          (crash look)
          (crash menu))

  (export VW VH TEST-TILE-PATH MODIFIERS
          BOARD-KEY BEST-KEY CARDS-KEY ACTIVE-KEY LOOK-KEY
          stored-look set-stored-look! step-look!
          boot-session save-after-frame!
          boot-deal save-deal-after-frame!
          active-game set-active-game! saved-game?
          launch-menu menu-frame? jack-out?)

  (begin
    (define VW 640)
    (define VH 400)
    (define TEST-TILE-PATH "assets/test-tile.png")
    (define MODIFIERS '(ctrl shift))

    (define BOARD-KEY "board")
    (define BEST-KEY "best")
    (define CARDS-KEY "cards")
    ;; The game last chosen from the menu: stack | cards.
    (define ACTIVE-KEY "active")
    ;; The look in force (P3, the sheet switch), a name from (crash look);
    ;; its own key so it outlives a deal and reaches both tables.
    (define LOOK-KEY "look")

    ;; The stored look, or #f when nothing is stored yet.
    (define (stored-look*)
      (let ((d (store-read-datum LOOK-KEY)))
        (and (look-name? d) d)))

    (define (stored-look)
      (or (stored-look*) DEFAULT-LOOK))

    (define (set-stored-look! name)
      (store-write-datum! LOOK-KEY name))

    ;; The next look, stored; the shells call this for the menu's LOOK
    ;; entry and hand the name to the table in memory, if any.
    (define (step-look!)
      (let ((next (look-after (stored-look))))
        (set-stored-look! next)
        next))

    ;; (cons session restored?): the saved session if there is one and
    ;; fresh? is #f, else a new deal of seed; the best result comes along
    ;; either way.
    ;; The look comes from its own key; a save from before the key existed
    ;; (P0..P2: the settings' render mode) seeds the key instead of being
    ;; overridden by the default, so a player who had the texture on keeps it.
    (define (boot-session lay seed fresh?)
      (let* ((saved (and (not fresh?)
                         (datum->session (store-read-datum BOARD-KEY))))
             (best (datum->best (store-read-datum BEST-KEY)))
             (s (session-with-best (or saved (session-new lay (or seed 1))) best))
             (stored (stored-look*)))
        (unless stored (set-stored-look! (session-look s)))
        (cons (if stored (session-with-look s stored) s)
              (and saved #t))))

    ;; After a frame: save the session when the step warrants it, and when
    ;; the board was just cleared record the trace as the best if it is.
    ;; Returns the session (with a new best, if one landed).
    (define (save-after-frame! before after)
      (let* ((b0 (session-board before))
             (b1 (session-board after))
             (just-cleared? (and (board-cleared? b1) (not (board-cleared? b0))))
             (value (trace-value (session-trace after)))
             (best (session-best after))
             (after (if (and just-cleared? (or (not best) (< value best)))
                        (begin
                          (store-write-datum! BEST-KEY (best->datum value))
                          (session-with-best after value))
                        after)))
        (when (save-due? before after)
          (store-write-datum! BOARD-KEY (session->datum after)))
        ;; ctrl+t or the TILES tap stepped the look: it is the game's, not the board's
        (unless (eq? (session-look before) (session-look after))
          (set-stored-look! (session-look after)))
        after))

    ;; (cons deal restored?): the saved deal if there is one and fresh? is
    ;; #f, else a new deal of seed with draw one.
    (define (boot-deal seed fresh?)
      (let ((saved (and (not fresh?)
                        (datum->deal (store-read-datum CARDS-KEY)))))
        (cons (or saved (deal-new (or seed (first-seed)) 1))
              (and saved #t))))

    ;; After a frame on the card table: save the deal when the game changed.
    (define (save-deal-after-frame! before after)
      (when (deal-save-due? before after)
        (store-write-datum! CARDS-KEY (deal->datum after)))
      after)

    ;; --- the menu -------------------------------------------------------------

    (define (active-game)
      (let ((d (store-read-datum ACTIVE-KEY)))
        (if (memq d '(stack cards)) d 'stack)))

    (define (set-active-game! id)
      (store-write-datum! ACTIVE-KEY id))

    ;; Does the store hold a game to continue for this table?
    (define (saved-game? id)
      (case id
        ((stack) (and (datum->session (store-read-datum BOARD-KEY)) #t))
        ((cards) (and (datum->deal (store-read-datum CARDS-KEY)) #t))
        (else #f)))

    ;; The menu at launch or from a HUD control: CONTINUE when the active
    ;; game is in memory (held?) or has a save (and is highlighted then),
    ;; STACK, DEFRAG, UPDATE when the page says one is waiting.
    (define (launch-menu update-waiting? held?)
      (let ((continue? (or held? (saved-game? (active-game)))))
        (menu-with-look (menu-new (append (if continue? '(continue) '())
                                          '(stack cards look)
                                          (if update-waiting? '(update) '()))
                                  (if continue? 'continue 'stack))
                        (stored-look))))

    ;; Does this frame ask for the menu: a tap on a MENU control (its
    ;; name from either table's hit-test, passed in), or ctrl+e?
    (define (menu-frame? f control)
      (or (eq? control 'menu)
          (and (memq 'ctrl (input-frame-held f))
               (memq 'e (input-frame-pressed f))
               #t)))

    ;; A severed stack's third choice, JACK OUT: the right third of the
    ;; board area (see (crash input) step-pointer for the other two).
    (define (jack-out? s f vw vh hud-h)
      (let ((click (input-frame-click f)))
        (and click
             (trace-severed? (session-trace s))
             (< (cdr click) (- vh hud-h))
             (>= (car click) (* 2 (quotient vw 3))))))))
