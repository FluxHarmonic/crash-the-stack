;;; (crash shell) - What both shells agree on before either opens a window.
;;;
;;; The virtual viewport the game is drawn into on every target, the
;;; texture paths the looks name (relative to where the game runs: the repo
;;; root natively, the served build/web on the web; (crash look) holds
;;; them), the modifier keys (crash input) reads,
;;; and the two things every shell does with the store: restore the saved
;;; board at boot (or deal) and save after a frame that changed something.
;;; The card table (P2) has the same two: boot-deal and save-deal-after-frame!,
;;; under its own store key. (crash shell native) and (crash shell web) import
;;; this and nothing else shared; (crash main) picks between them.

(define-library (crash shell)
  (import (crash stack layout)
          (crash stack rules)
          (crash input)
          (crash trace)
          (crash save)
          (crash store)
          (crash cards input)
          (crash cards save)
          (crash cards seeds)
          (crash look)
          (crash hud)
          (crash bg)
          (crash sfx)
          (crash audio)
          (crash menu)
          (crash font)
          (crash glyphs)
          (crash glyphs tools)
          (crash palette)
          (crash synth)
          (crash geometry)
          (crash cards geometry)
          (only (crash stack generate) FACE-ORDER))

  (export VW VH MODIFIERS bg-advance bg-choose copper-choice phosphor-choice
          literal-check LITERAL-NAMES
          AMBIENT-PATH AMBIENT-RATE play-cues!
          BOARD-KEY BEST-KEY CARDS-KEY ACTIVE-KEY LOOK-KEY HUD-KEY
          stored-look set-stored-look! step-look!
          stored-hud set-stored-hud! step-hud!
          boot-session save-after-frame!
          boot-deal save-deal-after-frame!
          active-game set-active-game! saved-game?
          launch-menu menu-frame? jack-out?)

  (begin
    (define VW 640)
    (define VH 400)
    (define MODIFIERS '(ctrl shift))

    ;; --- the literal check (2026-09-19) ---------------------------------------
    ;;
    ;; On the web build a quoted literal came out of module load with its
    ;; cells overwritten (see (crash menu)'s MENU-ENTRIES); a sigil wasm
    ;; runtime bug, filed. Until it is fixed, boot checks the shape of
    ;; every quoted literal the game leans on and says so in one trace
    ;; line, so the arm reddens instead of a corrupt board shipping.
    ;; Answers the names that failed, '() when all hold.
    (define LITERAL-NAMES
      (list 'glyphs 'mini-glyphs 'sheets 'class-marks 'icons 'face-order 'palette 'menu-entries 'looks
            'layouts 'phases 'models 'cues 'controls 'card-controls 'modifiers))

    (define (rows? x n len)
      (and (list? x)
           (= (length x) n)
           (every (lambda (r) (and (string? r) (= (string-length r) len))) x)))

    (define (literal-check)
      (let ((bad '()))
        ;; ok?: a thunk, so a predicate that throws on a mangled literal
        ;; is a failed check, not an aborted boot
        (define (check name ok?)
          (unless (guard (e (#t #f)) (ok?))
            (set! bad (cons name bad))))
        (define (glyph-table? table least h w)
          (and (list? table)
               (> (length table) least)
               (every (lambda (g) (and (pair? g) (char? (car g)) (rows? (cdr g) h w))) table)))
        (define (vector-of-rows? v n h w)
          (and (vector? v)
               (= (vector-length v) n)
               (let loop ((i 0))
                 (or (= i n)
                     (and (rows? (vector-ref v i) h w) (loop (+ i 1)))))))
        (check 'glyphs (lambda () (glyph-table? GLYPHS 40 GLYPH-H GLYPH-W)))
        (check 'mini-glyphs (lambda () (glyph-table? MINI-GLYPHS 30 MINI-H MINI-W)))
        (check 'sheets
               (lambda ()
                 (every (lambda (entry)
                          (and (symbol? (car entry))
                               (vector-of-rows? (cdr entry) FACE-COUNT GLYPH-H GLYPH-W)))
                        SHEETS)))
        (check 'class-marks (lambda () (vector-of-rows? CLASS-MARKS 4 MARK-H MARK-W)))
        (check 'icons
               (lambda ()
                 (and (list? ICONS)
                      (>= (length ICONS) 10)
                      (every (lambda (e) (and (pair? e) (symbol? (car e)) (rows? (cdr e) ICON-H ICON-W))) ICONS))))
        (check 'face-order
               (lambda ()
                 (and (vector? FACE-ORDER)
                      (= (vector-length FACE-ORDER) 72)
                      (every (lambda (f) (and (integer? f) (>= f 0) (< f FACE-COUNT)))
                             (vector->list FACE-ORDER)))))
        (check 'palette
               (lambda ()
                 (and (list? PALETTE)
                      (> (length PALETTE) 30)
                      (every (lambda (e)
                               (and (pair? e)
                                    (symbol? (car e))
                                    (list? (cdr e))
                                    (= (length (cdr e)) 3)
                                    (every (lambda (v) (and (number? v) (>= v 0.0) (<= v 1.0))) (cdr e))))
                             PALETTE))))
        (check 'menu-entries
               (lambda ()
                 (and (list? MENU-ENTRIES)
                      (= (length MENU-ENTRIES) 6)
                      (every (lambda (e) (and (pair? e) (symbol? (car e)) (pair? (cdr e)) (string? (cadr e))))
                             MENU-ENTRIES))))
        (check 'looks
               (lambda ()
                 (and (list? LOOK-NAMES)
                      (>= (length LOOK-NAMES) 8)
                      (every symbol? LOOK-NAMES)
                      (every (lambda (name) (string? (look-label (look-ref name)))) LOOK-NAMES))))
        ;; symbol lists: a mangled cell holds another symbol and passes any
        ;; shape test, so these are compared with twins built at init
        (check 'layouts (lambda () (equal? HUD-LAYOUTS (list 'zones 'strip))))
        (check 'phases (lambda () (equal? PHASES (list 'trace 'counter 'severed 'cleared))))
        (check 'models (lambda () (equal? MODELS (list 'hint 'cursor))))
        (check 'cues (lambda () (equal? CUES (list 'select 'match 'mismatch 'shuffle 'lock 'scramble 'cleared 'severed))))
        (check 'controls (lambda () (equal? CONTROL-NAMES (list 'mode 'look 'keys 'tool 'menu))))
        (check 'card-controls (lambda () (equal? CARD-CONTROL-NAMES (list 'score 'mode 'keys 'tool 'menu))))
        (check 'modifiers (lambda () (equal? MODIFIERS (list 'ctrl 'shift))))
        (reverse bad)))

    (define BOARD-KEY "board")
    (define BEST-KEY "best")
    (define CARDS-KEY "cards")
    ;; The game last chosen from the menu: stack | cards.
    (define ACTIVE-KEY "active")
    ;; The look in force (P3, the sheet switch), a name from (crash look);
    ;; its own key so it outlives a deal and reaches both tables.
    (define LOOK-KEY "look")
    ;; The bar's layout (P3, ruling D33): zones | strip, its own key too.
    (define HUD-KEY "hud")

    (define (stored-hud)
      (let ((d (store-read-datum HUD-KEY)))
        (if (layout-name? d) d DEFAULT-LAYOUT)))

    (define (set-stored-hud! name)
      (store-write-datum! HUD-KEY name))

    (define (step-hud!)
      (let ((next (layout-after (stored-hud))))
        (set-stored-hud! next)
        next))

    ;; The stored look, or #f when nothing is stored yet.
    (define (stored-look*)
      (let ((d (store-read-datum LOOK-KEY)))
        (and (look-name? d) d)))

    (define (stored-look)
      (or (stored-look*) DEFAULT-LOOK))

    (define (set-stored-look! name)
      (store-write-datum! LOOK-KEY name))

    ;; The next look, stored; the shells call this for the menu's LOOK
    ;; entry and hand the name to the table in memory, if any.
    (define (step-look!)
      (let ((next (look-after (stored-look))))
        (set-stored-look! next)
        next))

    ;; (cons session restored?): the saved session if there is one and
    ;; fresh? is #f, else a new deal of seed; the best result comes along
    ;; either way.
    ;; The look comes from its own key; a save from before the key existed
    ;; (P0..P2: the settings' render mode) seeds the key instead of being
    ;; overridden by the default, so a player who had the texture on keeps it.
    (define (boot-session lay seed fresh?)
      (let* ((saved (and (not fresh?)
                         (datum->session (store-read-datum BOARD-KEY))))
             (best (datum->best (store-read-datum BEST-KEY)))
             (s (session-with-best (or saved (session-new lay (or seed 1))) best))
             (stored (stored-look*)))
        (unless stored (set-stored-look! (session-look s)))
        (cons (session-with-hud (if stored (session-with-look s stored) s) (stored-hud))
              (and saved #t))))

    ;; After a frame: save the session when the step warrants it, and when
    ;; the board was just cleared record the trace as the best if it is.
    ;; Returns the session (with a new best, if one landed).
    (define (save-after-frame! before after)
      (let* ((b0 (session-board before))
             (b1 (session-board after))
             (just-cleared? (and (board-cleared? b1) (not (board-cleared? b0))))
             (value (trace-value (session-trace after)))
             (best (session-best after))
             (after (if (and just-cleared? (or (not best) (< value best)))
                        (begin
                          (store-write-datum! BEST-KEY (best->datum value))
                          (session-with-best after value))
                        after)))
        (when (save-due? before after)
          (store-write-datum! BOARD-KEY (session->datum after)))
        ;; ctrl+t or the TILES tap stepped the look: it is the game's, not the board's
        (unless (eq? (session-look before) (session-look after))
          (set-stored-look! (session-look after)))
        after))

    ;; (cons deal restored?): the saved deal if there is one and fresh? is
    ;; #f, else a new deal of seed with draw one.
    (define (boot-deal seed fresh?)
      (let ((saved (and (not fresh?)
                        (datum->deal (store-read-datum CARDS-KEY)))))
        (cons (deal-with-hud (or saved (deal-new (or seed (first-seed)) 1)) (stored-hud))
              (and saved #t))))

    ;; After a frame on the card table: save the deal when the game changed.
    (define (save-deal-after-frame! before after)
      (when (deal-save-due? before after)
        (store-write-datum! CARDS-KEY (deal->datum after)))
      after)

    ;; --- the sound (P3) ---------------------------------------------------------

    ;; The ambient loop: s16le mono PCM at AMBIENT-RATE (assets/MANIFEST
    ;; names its provenance). The native shell reads the file; the web
    ;; page fetches it and hands it over in chunks.
    (define AMBIENT-PATH "assets/audio/ambient.pcm")
    (define AMBIENT-RATE 22050)

    (define (play-cues! cues)
      (for-each audio-cue! cues))

    ;; --- the living background ---------------------------------------------------

    ;; The background after a frame of either table: its phase follows the
    ;; trace's, a counter-hack that fired this frame bursts it, and it
    ;; steps once per sim tick the table's clock drained. before/after: the
    ;; table's trace either side of the step.
    ;; b is #f when the background is off (?bg=off, --bg off): a lever
    ;; for a phone that cannot afford the field.
    (define (bg-advance b steps before after)
      (if (not b)
          #f
      (let* ((b (if (eq? (trace-phase before) (trace-phase after))
                    b
                    (bg-with-phase b (trace-phase after))))
             (b (if (> (trace-ice-count after) (trace-ice-count before))
                    (bg-with-burst b)
                    b)))
        (bg-tick b steps))))

    ;; The background a `?bg=`/`--bg` name asks for: the rule on the GPU
    ;; (life, reaction; the default), on the CPU (life-cpu, reaction-cpu,
    ;; the fallback and the oracle), or none (off, or any other name).
    ;; hold: a field-step count to stop at (the arm's door), or #f.
    (define (bg-choose name seed hold)
      (let* ((text (symbol->string name))
             (n (string-length text))
             (cpu? (and (> n 4) (string=? (substring text (- n 4) n) "-cpu")))
             (mode (string->symbol (if cpu? (substring text 0 (- n 4)) text))))
        (and (memq mode MODES)
             (bg-with-hold (bg-new seed mode (not cpu?)) hold))))

    ;; When the copper raster draws over the field: roll (the cleared
    ;; sequence only; the default), always, off, bitmap (the painted bars,
    ;; the scanline leg's reference). Any other name is the default.
    (define (copper-choice name)
      (if (memq name (list 'always 'off 'bitmap)) name 'roll))

    ;; Phosphor persistence on the cascade: on (the default), off, probe
    ;; (the arm's door: two blocks alternating every frame, persistence
    ;; on, at rest).
    (define (phosphor-choice name)
      (if (memq name (list 'off 'probe)) name 'on))

    ;; --- the menu -------------------------------------------------------------

    (define (active-game)
      (let ((d (store-read-datum ACTIVE-KEY)))
        (if (memq d '(stack cards)) d 'stack)))

    (define (set-active-game! id)
      (store-write-datum! ACTIVE-KEY id))

    ;; Does the store hold a game to continue for this table?
    (define (saved-game? id)
      (case id
        ((stack) (and (datum->session (store-read-datum BOARD-KEY)) #t))
        ((cards) (and (datum->deal (store-read-datum CARDS-KEY)) #t))
        (else #f)))

    ;; The menu at launch or from a HUD control: CONTINUE when the active
    ;; game is in memory (held?) or has a save (and is highlighted then),
    ;; STACK, DEFRAG, UPDATE when the page says one is waiting.
    (define (launch-menu update-waiting? held?)
      (let ((continue? (or held? (saved-game? (active-game)))))
        (menu-with-hud (menu-with-look (menu-new (append (if continue? '(continue) '())
                                                         '(stack cards look hud)
                                                         (if update-waiting? '(update) '()))
                                                 (if continue? 'continue 'stack))
                                       (stored-look))
                       (stored-hud))))

    ;; Does this frame ask for the menu by key: ctrl+e? (The MENU tool
    ;; comes out of the table's step as a request, read after it.)
    (define (menu-frame? f)
      (and (memq 'ctrl (input-frame-held f))
           (memq 'e (input-frame-pressed f))
           #t))

    ;; A severed stack's third choice, JACK OUT: the right third of the
    ;; board area (see (crash input) step-pointer for the other two).
    (define (jack-out? s f vw vh hud-h)
      (let ((click (input-frame-click f)))
        (and click
             (trace-severed? (session-trace s))
             (< (cdr click) (- vh hud-h))
             (>= (car click) (* 2 (quotient vw 3))))))))
