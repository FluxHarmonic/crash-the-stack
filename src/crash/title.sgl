;;; (crash title) - The title's model: the ANSI logo grid, its modem-speed
;;; reveal, and the shear that lands it.
;;;
;;; The logo is a cell grid built by scripts/art/ansi from a hand-drawn
;;; block alphabet (ruling D38: no image generation on this path), read
;;; here from the data module (crash title logo). This module answers
;;; what is SHOWN at a tick: which cells, with which glyph and roles, at
;;; what offset. (crash title draw) puts the pixels down with the block
;;; glyphs of (crash font); nothing here imports graphics, so the menu
;;; (a rules-family module) can hold one of these.
;;;
;;; The reveal: the grid draws cell by cell, row by row, at a rate that
;;; reads as a 2400-baud terminal (baud / 10 cells a second; 4 a tick at
;;; 60), a cursor block leading the draw, and with GLITCHES planned from
;;; the boot's seed so every boot differs and any boot can be reproduced
;;; (?seed=N on the web): a wrong character that corrects itself a beat
;;; later, a row drawn in the wrong colors that snaps right, a row that
;;; draws shifted and settles, ▓░ noise in a row's shadow, one letter with
;;; its colors inverted. Every glitch has a tick it ends at.
;;;
;;; The shear (David, 2026-09-19: the slant, and "can it be shifted in
;;; real time"): the grid is stored upright and sheared per row when
;;; drawn, row r of each letter line SLANT × (5 - r) cells right of its
;;; bottom row, resolved to whole pixels (not the whole-cell stair the
;;; spec's `slant` bakes for a PNG). The modem draws the logo upright, the way a
;;; terminal would, and once the last glitch has resolved the logo slams
;;; into its slant over SHEAR-TICKS with an out-back ease; a skip lands
;;; on the slanted logo at once. So the logo is fully correct and still
;;; at SETTLE, every seed, and settle is the end of the slam.
;;;
;;; Everything is a pure function of (seed, tick): the same seed shows
;;; the same frame at the same tick on both targets, which is what the
;;; arm asserts. Time is the caller's frame count: (crash menu) steps
;;; this once per menu frame (one tick), so the pace assumes 60 frames a
;;; second; ?baud= is the knob if a display runs faster.

(define-library (crash title)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (crash stack prng)
          (crash tween)
          (crash title logo)
          (crash title alphabet))

  (export title title? title-new title-seed title-tick title-baud title-done
          title-settle-tick title-slam-tick title-plan
          title-step title-skip title-running? title-settled?
          title-cues
          title-cell title-drawn-count title-frame-digest
          title-live-glitches title-shown-cell title-row-shift title-row-extent title-row-start
          title-cursor-row title-shear title-row-shear cursor-on?
          glitch glitch? glitch-kind glitch-row glitch-col glitch-from glitch-to glitch-param
          DEFAULT-BAUD title-baud! title-default-baud
          DEFAULT-GLITCH title-glitch! title-default-glitch title-level
          BLOCK-CODES DEFAULT-SLANT title-slant! title-default-slant SHEAR-TICKS
          BACKDROP-PATH
          BOOT-TIMEOUT boot-reset! boot-add-step! boot-run! boot-done? boot-timed-out? boot-progress boot-pending-names
          logo-check)

  (begin
    ;; --- the grid ------------------------------------------------------------

    ;; The block glyph codes scripts/art/ansi writes: full, ▓ ▒ ░, the
    ;; top, bottom, left and right halves.
    (define BLOCK-CODES (list #\# #\3 #\2 #\1 #\^ #\v #\< #\>))

    ;; The backdrop the shells load and hand to the draw (P3d part B).
    (define BACKDROP-PATH "assets/title/backdrop.png")

    ;; A row's three strings.
    (define (row-glyphs y) (car (vector-ref LOGO-ROWS y)))
    (define (row-fg y) (cadr (vector-ref LOGO-ROWS y)))
    (define (row-bg y) (caddr (vector-ref LOGO-ROWS y)))

    ;; The settled cell at (x, y): (glyph fg bg) with fg and bg as role
    ;; indexes into LOGO-ROLES or #f, or #f for an empty cell.
    (define (title-cell x y)
      (let ((g (string-ref (row-glyphs y) x)))
        (and (not (char=? g #\space))
             (list g
                   (role-index (string-ref (row-fg y) x))
                   (role-index (string-ref (row-bg y) x))))))

    ;; a role letter (a b c ...) to its index, - to #f
    (define (role-index ch)
      (and (not (char=? ch #\-))
           (- (char->integer ch) (char->integer #\a))))

    ;; The shadow's role: the last role when the spec had a shadow (three
    ;; roles), else none. A shadow cell is one whose fg is that role.
    (define SHADOW-ROLE (and (= (vector-length LOGO-ROLES) 3) 2))

    (define (shadow-cell? cell)
      (and cell SHADOW-ROLE (eqv? (cadr cell) SHADOW-ROLE)))

    ;; --- the draw order -----------------------------------------------------
    ;;
    ;; Cells are drawn row by row, each row from its first lit cell to its
    ;; last (the modem does not send the blanks after a line); a blank row
    ;; costs nothing. ROW-START is the index of each row's first cell in
    ;; that order, ROW-X0 and ROW-LEN its extent.

    (define (row-extent y)
      (let ((g (row-glyphs y)))
        (let loop ((x 0) (x0 #f) (x1 #f))
          (cond ((= x LOGO-W) (if x0 (cons x0 (+ 1 (- x1 x0))) (cons 0 0)))
                ((char=? (string-ref g x) #\space) (loop (+ x 1) x0 x1))
                (else (loop (+ x 1) (or x0 x) x))))))

    (define ROW-EXTENTS
      (list->vector (map row-extent (iota LOGO-H))))

    (define (row-x0 y) (car (vector-ref ROW-EXTENTS y)))
    (define (row-len y) (cdr (vector-ref ROW-EXTENTS y)))

    ;; (x0 . len) of row y's lit extent, and its first cell's index in draw order.
    (define (title-row-extent y) (vector-ref ROW-EXTENTS y))
    (define (title-row-start y) (vector-ref ROW-START y))

    (define ROW-START
      (let loop ((y 0) (at 0) (acc '()))
        (if (= y LOGO-H)
            (list->vector (reverse acc))
            (loop (+ y 1) (+ at (row-len y)) (cons at acc)))))

    (define (row-start y) (vector-ref ROW-START y))
    (define (row-end y) (+ (row-start y) (row-len y)))   ; one past the last

    (define TOTAL-CELLS (row-end (- LOGO-H 1)))

    ;; --- the letters and their lines -----------------------------------------

    (define LETTER-COUNT (quotient (vector-length LOGO-LETTERS) 3))
    (define (letter-row i) (vector-ref LOGO-LETTERS (* 3 i)))
    (define (letter-col i) (vector-ref LOGO-LETTERS (+ 1 (* 3 i))))
    (define (letter-w i) (vector-ref LOGO-LETTERS (+ 2 (* 3 i))))

    ;; Each grid row's index within its letter line (0..5), or 6 for a
    ;; row no letter covers (a gap, or the shadow's last row).
    (define ROW-LINE-INDEX
      (list->vector
       (map (lambda (y)
              (let loop ((i 0))
                (cond ((= i LETTER-COUNT) 6)
                      ((and (>= y (letter-row i)) (< y (+ (letter-row i) 6)))
                       (- y (letter-row i)))
                      (else (loop (+ i 1))))))
            (iota LOGO-H))))

    ;; --- the clock ------------------------------------------------------------

    (define DEFAULT-BAUD 4800)   ; David, 2026-09-19: "4500 feels pretty good"; 4800 is the real rate nearest it
    (define TICKS-PER-SECOND 60)
    ;; The baud in force for new titles (?baud=N on the web); a module
    ;; setting, since the page's parameter lands before any menu exists.
    (define *default-baud* DEFAULT-BAUD)
    (define (title-baud! n) (set! *default-baud* n))
    (define (title-default-baud) *default-baud*)
    ;; The glitch level for new titles (?glitch=N on the web): 0 none, 1 a
    ;; few and short, 2 (the default; David 2026-09-19: "I didn't see much
    ;; glitching") many with one whole-row glitch every boot, 3 more still.
    (define DEFAULT-GLITCH 2)
    (define *default-glitch* DEFAULT-GLITCH)
    (define (title-glitch! n) (set! *default-glitch* (max 0 (min 3 n))))
    (define (title-default-glitch) *default-glitch*)

    ;; Cells drawn by tick t: baud / 10 characters a second.
    (define (drawn-at t baud)
      (min TOTAL-CELLS (quotient (* t baud) (* 10 TICKS-PER-SECOND))))

    ;; The first tick at which cell i (in draw order) is on screen.
    (define (cell-tick i baud)
      (let ((need (* (+ i 1) 10 TICKS-PER-SECOND)))
        (quotient (+ need baud -1) baud)))

    (define (reveal-end-tick baud) (cell-tick (- TOTAL-CELLS 1) baud))

    ;; --- the shear ---------------------------------------------------------------

    ;; The slant at rest, in cells per row: row r of a letter line sits
    ;; slant × (5 - r) cells right of row 5, resolved to whole pixels, not
    ;; whole cells (David, 2026-09-19: "can we make it slant slightly
    ;; less? Are we making it snap to the character grid?"; the first cut
    ;; was a whole-cell stair, one cell per two rows). ?slant=N is the door,
    ;; 0 upright; the default is half the first cut's angle.
    (define DEFAULT-SLANT 0.25)
    (define *slant* DEFAULT-SLANT)
    (define (title-slant! n) (set! *slant* (max 0.0 (min 2.0 n))))
    (define (title-default-slant) *slant*)
    (define SHEAR-TICKS 20)      ; the slam, from upright to the slant

    ;; --- the glitches -------------------------------------------------------------
    ;;
    ;; kind: wrong-char | wrong-color | shift | noise | invert
    ;; row, col: the cell or row or letter box (invert: param is the
    ;; letter's index) it touches; from, to: the ticks it is visible in,
    ;; [from, to); param: the wrong glyph code, the shift, or the letter.
    (define-struct glitch
      (kind default: 'noise)
      (row default: 0)
      (col default: 0)
      (from default: 0)
      (to default: 0)
      (param default: #f))

    (define KINDS (list 'wrong-char 'wrong-color 'shift 'noise 'invert))
    ;; The levels: how many glitches a boot, how long a beat (ticks) they
    ;; hang on after their moment, and how many of the first ones are
    ;; forced to a whole-row kind (wrong-color or shift: the unmistakable
    ;; ones). (least spread beat-least beat-spread forced-rows)
    (define (level-params level)
      (case level
        ((0) (list 0 1 0 1 0))
        ((1) (list 2 2 12 18 0))
        ((3) (list 9 4 30 30 2))
        (else (list 5 3 24 24 1))))

    ;; Rows with letter cells (a shadow-only row is not glitched).
    (define LETTER-ROWS
      (filter (lambda (y)
                (let ((g (row-glyphs y)) (f (row-fg y)))
                  (let loop ((x 0))
                    (cond ((= x LOGO-W) #f)
                          ((and (not (char=? (string-ref g x) #\space))
                                (not (and SHADOW-ROLE
                                          (eqv? (role-index (string-ref f x)) SHADOW-ROLE))))
                           #t)
                          (else (loop (+ x 1)))))))
              (iota LOGO-H)))

    ;; A letter cell of row y (not blank, not shadow), for wrong-char.
    (define (letter-cols y)
      (filter (lambda (x)
                (let ((c (title-cell x y)))
                  (and c (not (shadow-cell? c)))))
              (iota LOGO-W)))

    ;; The plan for a seed at a level: its count of glitches, each with its
    ;; window in ticks at this baud. Threads the MINSTD state by hand, one
    ;; draw per choice, so the plan is a function of (seed, baud).
    (define (make-plan seed baud level)
      (let* ((params (level-params level))
             (least (car params))
             (spread (cadr params))
             (beat-least (caddr params))
             (beat-spread (cadddr params))
             (forced (list-ref params 4))
             (s (prng-next (prng-seed seed)))
             (n (+ least (prng-index s spread))))
        (let loop ((k 0) (s s) (acc '()))
          (if (= k n)
              (reverse acc)
              (let* ((s (prng-next s))
                     ;; the first `forced` glitches are whole-row ones
                     (kind (if (< k forced)
                               (list-ref (list 'wrong-color 'shift) (prng-index s 2))
                               (list-ref KINDS (prng-index s (length KINDS)))))
                     (s (prng-next s))
                     (y (list-ref LETTER-ROWS (prng-index s (length LETTER-ROWS))))
                     (s (prng-next s))
                     (beat (+ beat-least (prng-index s beat-spread)))
                     (row-from (cell-tick (row-start y) baud))
                     (row-to (+ (cell-tick (- (row-end y) 1) baud) beat)))
                (case kind
                  ((wrong-char)
                   (let* ((cols (letter-cols y))
                          (s (prng-next s))
                          (x (list-ref cols (prng-index s (length cols))))
                          (s (prng-next s))
                          (code (list-ref BLOCK-CODES (prng-index s (length BLOCK-CODES))))
                          (own (car (title-cell x y)))
                          ;; a wrong character is a different one
                          (code (if (char=? code own) (if (char=? own #\#) #\2 #\#) code))
                          (i (+ (row-start y) (- x (row-x0 y))))
                          (from (cell-tick i baud)))
                     (loop (+ k 1) s
                           (cons (glitch kind: kind row: y col: x from: from to: (+ from beat) param: code)
                                 acc))))
                  ((wrong-color)
                   (loop (+ k 1) s
                         (cons (glitch kind: kind row: y from: row-from to: row-to) acc)))
                  ((shift)
                   (let* ((s (prng-next s))
                          (dx (+ 1 (prng-index s 3))))
                     (loop (+ k 1) s
                           (cons (glitch kind: kind row: y from: row-from to: row-to param: dx)
                                 acc))))
                  ((noise)
                   ;; the row's shadow is the row below: while it draws and a beat
                   (let* ((sy (min (- LOGO-H 1) (+ y 1)))
                          (from (cell-tick (row-start sy) baud))
                          (to (+ (cell-tick (- (row-end sy) 1) baud) beat)))
                     (loop (+ k 1) s
                           (cons (glitch kind: kind row: y from: from to: to) acc))))
                  (else
                   ;; invert: a letter, from its first cell to its line's end
                   (let* ((s (prng-next s))
                          (li (prng-index s LETTER-COUNT))
                          (ly (letter-row li))
                          (lx (letter-col li))
                          (first (let find ((r 0))
                                   (cond ((= r 6) (row-start ly))
                                         ((title-cell lx (+ ly r))
                                          (+ (row-start (+ ly r)) (- lx (row-x0 (+ ly r)))))
                                         (else (find (+ r 1))))))
                          (last-row (+ ly 5))
                          (from (cell-tick first baud))
                          (to (+ (cell-tick (- (row-end last-row) 1) baud) beat)))
                     (loop (+ k 1) s
                           (cons (glitch kind: kind row: ly col: lx from: from to: to param: li)
                                 acc))))))))))

    ;; --- the state ----------------------------------------------------------------

    (define-struct title
      (seed default: 1)
      (baud default: DEFAULT-BAUD)
      (tick default: 0)
      (done default: #f)           ; settled: by time or by a skip
      (slam-tick default: 0)       ; the last glitch resolved; the shear starts here
      (settle-tick default: 0)     ; the tick everything is correct and still from
      (level default: DEFAULT-GLITCH) ; the glitch level the plan was made at
      (slant default: DEFAULT-SLANT)  ; cells per row at rest
      (plan default: '()))         ; the glitches, from the seed

    ;; A title for this boot. settled?: #t opens it already settled (the
    ;; menu after a table; the reveal is once per boot). An optional glitch
    ;; level overrides the module setting (the tests).
    (define (title-new seed baud settled? . rest)
      (let* ((level (if (and (pair? rest) (car rest)) (car rest) *default-glitch*))
             (plan (make-plan seed baud level))
             (slam (fold (lambda (m g) (max m (glitch-to g)))
                         (+ 1 (reveal-end-tick baud))
                         plan))
             (settle (+ slam SHEAR-TICKS)))
        (title seed: seed
               baud: baud
               tick: (if settled? settle 0)
               done: settled?
               level: level
               slant: *slant*
               slam-tick: slam
               settle-tick: settle
               plan: plan)))

    (define (title-running? t) (not (title-done t)))
    (define (title-settled? t) (title-done t))

    ;; One tick. Done once the settle tick is reached; the tick stops there.
    (define (title-step t)
      (if (title-done t)
          t
          (let ((tick (+ 1 (title-tick t))))
            (if (>= tick (title-settle-tick t))
                (title t tick: (title-settle-tick t) done: #t)
                (title t tick: tick)))))

    (define (title-skip t)
      (if (title-done t) t (title t tick: (title-settle-tick t) done: #t)))

    (define (title-drawn-count t)
      (if (title-done t) TOTAL-CELLS (drawn-at (title-tick t) (title-baud t))))

    ;; The shear at this tick, in cells: 0 while the modem draws, the slam
    ;; from the last glitch's end, the slant from settle on.
    (define (title-shear t)
      (let ((tick (title-tick t)))
        (cond ((title-done t) (* 1.0 (title-slant t)))
              ((< tick (title-slam-tick t)) 0.0)
              (else (let ((p (/ (- tick (title-slam-tick t)) (* 1.0 SHEAR-TICKS))))
                      (* (title-slant t) (ease 'out-back (min 1.0 p))))))))

    ;; Row y's shear in cells at this tick: (5 - r) for row r of its letter
    ;; line (0 for a row no letter covers), times the shear. Every cell of a
    ;; row moves together, shadow cells with the row they sit in (a shadow
    ;; given its caster's row landed on the next letter cell where the
    ;; first cut's stair stepped down: measured, two cells on one spot).
    (define (title-row-shear t y)
      (let ((r (vector-ref ROW-LINE-INDEX y)))
        (if (> r 5) 0.0 (* (- 5 r) (title-shear t)))))

    ;; The cursor's blink at a tick: on for CURSOR-ON of every CURSOR-PERIOD
    ;; ticks (the reveal's cursor and the menu's, ruling D39, share it).
    (define CURSOR-PERIOD 16)
    (define CURSOR-ON 12)
    (define (cursor-on? tick) (< (modulo tick CURSOR-PERIOD) CURSOR-ON))

    ;; The row the cursor is on (the row being drawn), or #f once done.
    (define (title-cursor-row t)
      (and (not (title-done t))
           (let ((drawn (title-drawn-count t)))
             (let loop ((y 0))
               (cond ((= y LOGO-H) #f)
                     ((and (>= drawn (row-start y)) (< drawn (row-end y))) y)
                     (else (loop (+ y 1))))))))

    ;; --- the frame: what is shown at this tick ---------------------------------

    (define (active? g tick)
      (and (>= tick (glitch-from g)) (< tick (glitch-to g))))

    ;; The glitches live at this tick.
    (define (title-live-glitches t)
      (if (title-done t)
          '()
          (filter (lambda (g) (active? g (title-tick t))) (title-plan t))))

    ;; a MINSTD draw folded from the tick and the cell, for the noise
    (define (flicker tick x y n)
      (prng-index (prng-next (prng-seed (+ 1 (* 7919 (quotient tick 3)) (* 131 x) y))) n))

    ;; The shown cell at (x, y): (glyph fg-role bg-role shadow?) with the
    ;; roles as indexes or #f, or #f for nothing. The live glitches
    ;; override the settled cell; the caller decides whether the cursor
    ;; has passed the cell.
    (define (title-shown-cell t x y live)
      (let ((cell (title-cell x y)))
        (and cell
             (let* ((tick (title-tick t))
                    (g (car cell))
                    (fg (cadr cell))
                    (bg (caddr cell))
                    (shadow? (shadow-cell? cell)))
               (let loop ((gs live) (g g) (fg fg) (bg bg))
                 (if (null? gs)
                     (list g fg bg shadow?)
                     (let ((gl (car gs)))
                       (case (glitch-kind gl)
                         ((wrong-char)
                          (if (and (= (glitch-row gl) y) (= (glitch-col gl) x))
                              (loop (cdr gs) (glitch-param gl) fg bg)
                              (loop (cdr gs) g fg bg)))
                         ((wrong-color)
                          (if (and (= (glitch-row gl) y) (not shadow?))
                              (loop (cdr gs) g (swap fg) (swap bg))
                              (loop (cdr gs) g fg bg)))
                         ((noise)
                          ;; the row's shadow is the row below, one cell right
                          (if (and (= (glitch-row gl) (- y 1)) shadow?)
                              (loop (cdr gs)
                                    (list-ref (list #\1 #\2 #\3) (flicker tick x y 3))
                                    fg bg)
                              (loop (cdr gs) g fg bg)))
                         ((invert)
                          (if (and (not shadow?)
                                   (>= y (glitch-row gl)) (< y (+ (glitch-row gl) 6))
                                   (>= x (glitch-col gl)) (< x (+ (glitch-col gl) (letter-w (glitch-param gl)))))
                              (loop (cdr gs) g (swap fg) (swap bg))
                              (loop (cdr gs) g fg bg)))
                         (else (loop (cdr gs) g fg bg))))))))))

    ;; the two letter roles trade places; the shadow and none stay
    (define (swap role)
      (cond ((eqv? role 0) 1)
            ((eqv? role 1) 0)
            (else role)))

    ;; The row's glitch shift in cells at this tick.
    (define (title-row-shift y live)
      (let loop ((gs live))
        (cond ((null? gs) 0)
              ((and (eq? (glitch-kind (car gs)) 'shift) (= (glitch-row (car gs)) y))
               (glitch-param (car gs)))
              (else (loop (cdr gs))))))

    ;; --- the cues -----------------------------------------------------------------
    ;;
    ;; modem: a new row began drawing; glitch: a glitch came on; settle:
    ;; the slam began (the last glitch resolved). Read off two states, the
    ;; way (crash sfx) does.
    (define (rows-begun t)
      (let ((drawn (title-drawn-count t)))
        (length (filter (lambda (y) (and (> (row-len y) 0) (> drawn (row-start y))))
                        (iota LOGO-H)))))

    (define (title-cues before after)
      (append (if (> (rows-begun after) (rows-begun before)) (list 'modem) '())
              (if (any (lambda (g)
                         (and (> (glitch-from g) (title-tick before))
                              (<= (glitch-from g) (title-tick after))))
                       (title-plan after))
                  (list 'glitch)
                  '())
              (if (and (< (title-tick before) (title-slam-tick before))
                       (>= (title-tick after) (title-slam-tick after)))
                  (list 'settle)
                  '())))


    ;; --- the boot (ruling D40) ------------------------------------------------------
    ;;
    ;; Everything the menu and the first board need is readied BEFORE the
    ;; menu becomes interactive, on both targets, so nothing pops in after
    ;; it is live (David: "weird to see graphics pop in and the music start
    ;; delayed"). The shells register STEPS at boot, in order, each a
    ;; thunk that answers #t once its work is done (a texture landed or
    ;; given up, the ambient decoded, P3c's atlas baked); the menu frame
    ;; runs boot-run! and the menu is live once the reveal has settled and
    ;; every step is done. The reveal is the cover; if the steps outlast it
    ;; the cursor blinks on a CONNECTING line. A step that raises counts
    ;; as done (a broken step must not hold the menu), and after
    ;; BOOT-TIMEOUT ticks the boot is forced done and says so.
    (define BOOT-TIMEOUT 1200)   ; ticks: 20 s

    (define *boot-pending* '())  ; ((name . thunk) ...) not yet done, in order
    (define *boot-done* '())     ; names done, newest first
    (define *boot-total* 0)
    (define *boot-ticks* 0)
    (define *boot-timed-out* #f)

    (define (boot-reset!)
      (set! *boot-pending* '())
      (set! *boot-done* '())
      (set! *boot-total* 0)
      (set! *boot-ticks* 0)
      (set! *boot-timed-out* #f))

    ;; Append a step; the shells add theirs at boot, later rows theirs.
    (define (boot-add-step! name thunk)
      (set! *boot-pending* (append *boot-pending* (list (cons name thunk))))
      (set! *boot-total* (+ *boot-total* 1)))

    ;; One frame of the boot: the first pending step runs; when it answers
    ;; done the next runs in the same frame, so a run of quick steps
    ;; costs one frame. Answers the names that finished this call, oldest
    ;; first; when the deadline forces the rest, their names too, and
    ;; boot-timed-out? says so.
    (define (boot-run!)
      (set! *boot-ticks* (+ *boot-ticks* 1))
      (let loop ((finished '()))
        (cond ((null? *boot-pending*) (reverse finished))
              ((and (> *boot-ticks* BOOT-TIMEOUT) (not *boot-timed-out*))
               (set! *boot-timed-out* #t)
               (set! *boot-done* (append (map car *boot-pending*) *boot-done*))
               (set! *boot-pending* '())
               (reverse (append (reverse (map car *boot-pending*)) finished)))
              (else
               (let* ((step (car *boot-pending*))
                      (done? (guard (e (#t #t)) (and ((cdr step)) #t))))
                 (if done?
                     (begin
                       (set! *boot-pending* (cdr *boot-pending*))
                       (set! *boot-done* (cons (car step) *boot-done*))
                       (loop (cons (car step) finished)))
                     (reverse finished)))))))

    (define (boot-done?) (null? *boot-pending*))
    (define (boot-timed-out?) *boot-timed-out*)
    ;; (done . total)
    (define (boot-progress) (cons (length *boot-done*) *boot-total*))
    (define (boot-pending-names) (map car *boot-pending*))

    ;; --- for the arm ----------------------------------------------------------------

    ;; A digest of the shown frame: the shown cells' glyph codes and role
    ;; indexes, the row shifts and the shear folded into one integer, so
    ;; two boots with one seed can be compared tick by tick without pixels.
    (define (title-frame-digest t)
      (let ((live (title-live-glitches t))
            (drawn (title-drawn-count t))
            (shear (exact (round (* 1000 (title-shear t))))))
        (let rows ((y 0) (h (modulo (+ 7 shear) 1000000007)))
          (if (= y LOGO-H)
              h
              (let* ((start (row-start y))
                     (in-row (max 0 (min (row-len y) (- drawn start))))
                     (xa (row-x0 y)))
                (let cols ((x xa) (h (modulo (+ (* h 31) (title-row-shift y live)) 1000000007)))
                  (if (>= x (+ xa in-row))
                      (rows (+ y 1) h)
                      (let* ((shown (title-shown-cell t x y live))
                             (v (if shown
                                    (+ (char->integer (car shown))
                                       (* 256 (if (cadr shown) (+ 1 (cadr shown)) 0))
                                       (* 4096 (if (caddr shown) (+ 1 (caddr shown)) 0)))
                                    0)))
                        (cols (+ x 1) (modulo (+ (* h 31) v) 1000000007))))))))))

    ;; The data module's shape, for the boot's literal check.
    (define (logo-check)
      (and (integer? LOGO-W) (integer? LOGO-H)
           (vector? LOGO-ROWS)
           (= (vector-length LOGO-ROWS) LOGO-H)
           (every (lambda (r)
                    (and (list? r) (= (length r) 3)
                         (every (lambda (s) (and (string? s) (= (string-length s) LOGO-W))) r)))
                  (vector->list LOGO-ROWS))
           (vector? LOGO-ROLES)
           (every string? (vector->list LOGO-ROLES))
           (vector? LOGO-LETTERS)
           (= 0 (modulo (vector-length LOGO-LETTERS) 3))
           (every integer? (vector->list LOGO-LETTERS))
           ;; the alphabet (D41): one-character names, six rows of seven
           (vector? ALPHABET)
           (every (lambda (g)
                    (and (list? g) (= (length g) (+ 1 ALPHABET-H))
                         (string? (car g)) (= (string-length (car g)) 1)
                         (every (lambda (s) (and (string? s) (= (string-length s) ALPHABET-W))) (cdr g))))
                  (vector->list ALPHABET))))
))
