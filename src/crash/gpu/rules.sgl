;;; (crash gpu rules) - Additional field step shaders for D55's deal pool.
;;; All additions use the existing nearest RGBA8 ping-pong and palette-only view.
;;; CYCLIC: R is the shown byte; G is phase (0..15); B is waiting age.
;;; FLOW: R is the squared scalar for display; BA retains its 16-bit state.
;;; SIGNAL: R is the shown byte; G/B carry downward/rightward heads.
;;; ECHO: R is the eased interference display; the emitters derive from the clock.
;;; SYNAPSE: R is shown; G is pulse phase; B is wiring; A marks initialized cells.

(define-library (crash gpu rules)
  (import (crash gpu glsl))
  (export CYCLIC-SOURCE FLOW-SOURCE SIGNAL-SOURCE ECHO-SOURCE SYNAPSE-SOURCE)

  (begin
    (define FIELD-GLSL
      (string-append
       "uniform sampler2D iTexChannel0_iSmpChannel0;\n"
       "uniform vec2 u_resolution;\n"
       "uniform vec2 u_key;\n"
       "uniform float u_rate;\n"
       "in vec2 texUV;\n"
       "in vec4 iColor;\n"
       "out vec4 fragColor;\n"
       "uint hash31(uint x) {\n"
       "    x ^= x >> 16; x = (x * 0x2c9277u) & 0x7fffffffu;\n"
       "    x ^= x >> 15; x = (x * 0x3a8f05u) & 0x7fffffffu;\n"
       "    return x ^ (x >> 16);\n"
       "}\n"
       "uint stepkey() { return uint(u_key.x) * 65536u + uint(u_key.y); }\n"
       "vec4 cell(ivec2 q) {\n"
       "    ivec2 size = ivec2(u_resolution);\n"
       "    q = (q % size + size) % size;\n"
       "    return texelFetch(iTexChannel0_iSmpChannel0, q, 0);\n"
       "}\n"))

    (define CYCLIC-SOURCE
      (string-append
       GLSL-PREFIX
       FIELD-GLSL
       "uniform float u_states;\n"
       "uniform float u_rain;\n"
       "uniform float u_max_age;\n"
       "int phase(ivec2 q) { return int(floor(cell(q).g * 255.0 + 0.5)); }\n"
       "void main() {\n"
       "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
       "    vec4 c = cell(p);\n"
       "    int k = int(floor(c.g * 255.0 + 0.5));\n"
       "    int age = int(floor(c.b * 255.0 + 0.5));\n"
       "    int next = (k + 1) % int(u_states);\n"
       "    bool advance = false;\n"
       "    for (int y = -1; y <= 1; y++) {\n"
       "        for (int x = -1; x <= 1; x++) {\n"
       "            if ((x != 0 || y != 0) && phase(p + ivec2(x, y)) == next) advance = true;\n"
       "        }\n"
       "    }\n"
       "    int vy = int(u_resolution.y) - 1 - p.y;\n"
       "    uint h = hash31((stepkey() + uint(p.x) + uint(vy) * 64u) & 0x7fffffffu);\n"
       "    // Rare spontaneous advances reopen a stalled front on this small torus.\n"
       "    if (h % 1000u < uint(u_rain)) advance = true;\n"
       "    bool moved = age >= int(u_max_age) - 1 || (advance && (h >> 10) % 1000u < uint(u_rate));\n"
       "    if (moved) { k = next; age = 0; } else age++;\n"
       "    // Ease local activity into dark patches instead of flashing phase colors.\n"
       "    int previous = int(floor(c.r * 255.0 + 0.5));\n"
       "    int shown = (previous * 7 + (moved ? 176 : 16)) / 8;\n"
       "    fragColor = vec4(float(shown), float(k), float(age), 255.0) / 255.0;\n"
       "}\n"))

    (define FLOW-SOURCE
      (string-append
       GLSL-PREFIX
       FIELD-GLSL
       "uniform float u_clock;\n"
       "uniform float u_phase;\n"
       "uniform float u_decay;\n"
       "uniform vec2 u_rain;\n"
       "uniform float u_wet;\n"
       "vec2 pack(float x) {\n"
       "    float s = floor(clamp(x, 0.0, 1.0) * 65535.0 + 0.5);\n"
       "    float hi = floor(s / 256.0);\n"
       "    return vec2(hi, s - hi * 256.0) / 255.0;\n"
       "}\n"
       "float value(ivec2 q) {\n"
       "    vec2 c = floor(cell(q).ba * 255.0 + 0.5);\n"
       "    return (c.x * 256.0 + c.y) / 65535.0;\n"
       "}\n"
       "float sampleField(vec2 q) {\n"
       "    ivec2 p = ivec2(floor(q));\n"
       "    vec2 f = fract(q);\n"
       "    return mix(mix(value(p), value(p + ivec2(1, 0)), f.x),\n"
       "               mix(value(p + ivec2(0, 1)), value(p + ivec2(1, 1)), f.x), f.y);\n"
       "}\n"
       "void main() {\n"
       "    vec2 p = floor(gl_FragCoord.xy);\n"
       "    vec2 wave = 6.28318530718 / u_resolution;\n"
       "    vec2 a = p * wave + vec2(u_phase + u_clock * 0.007, -u_clock * 0.009);\n"
       "    // Curl of a periodic stream function: (d psi/dy, -d psi/dx).\n"
       "    // The second harmonic breaks up closed orbits without a divergent source.\n"
       "    vec2 velocity = vec2(sin(a.x) * cos(a.y), -cos(a.x) * sin(a.y) * wave.x / wave.y);\n"
       "    velocity += 0.35 * vec2(cos(2.0 * a.y + u_clock * 0.004), sin(2.0 * a.x));\n"
       "    float v = sampleField(p - u_rate * velocity) * u_decay;\n"
       "    vec2 rain = vec2(u_rain.x, u_resolution.y - 1.0 - u_rain.y);\n"
       "    vec2 d = abs(p - rain);\n"
       "    d = min(d, u_resolution - d);\n"
       "    // Seeded smooth rain feeds moving islands; no random choice uses wall time.\n"
       "    if (u_wet > 0.5) v = max(v, 0.94 * exp(-dot(d, d) / 7.0));\n"
       "    fragColor = vec4(v * v, 0.0, pack(v));\n"
       "}\n"))

    (define SIGNAL-SOURCE
      (string-append
       GLSL-PREFIX
       FIELD-GLSL
       "uniform float u_clock;\n"
       "uniform float u_seed;\n"
       "void main() {\n"
       "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
       "    ivec2 size = ivec2(u_resolution);\n"
       "    vec4 c = cell(p);\n"
       "    uint seed = uint(u_seed);\n"
       "    int vy = size.y - 1 - p.y;\n"
       "    uint column = hash31(seed + uint(p.x / 5));\n"
       "    uint row = hash31(seed + 1024u + uint(vy / 11));\n"
       "    bool verticalLane = p.x % 5 == int(column % 5u);\n"
       "    bool horizontalLane = vy % 11 == int(row % 11u);\n"
       "    int period = max(1, (1 + int((column >> 8) % 3u)) / int(u_rate));\n"
       "    float down = c.g;\n"
       "    float right = c.b;\n"
       "    if (int(u_clock) % period == 0) {\n"
       "        down = cell(p + ivec2(0, 1)).g;\n"
       "        if (vy == 0) down = verticalLane && hash31(stepkey() + uint(p.x)) % 1000u < 120u ? 1.0 : 0.0;\n"
       "    }\n"
       "    if (int(u_clock) % max(1, 2 / int(u_rate)) == 0) {\n"
       "        right = cell(p + ivec2(-1, 0)).b;\n"
       "        if (p.x == 0) right = horizontalLane && hash31(stepkey() + 4096u + uint(vy)) % 1000u < 60u ? 1.0 : 0.0;\n"
       "    }\n"
       "    // Stable seeded grain breaks up regular dither spacing without flicker.\n"
       "    uint grain = hash31(seed + 8192u + uint(p.x) + uint(vy) * 64u);\n"
       "    float ground = float(grain % 32u);\n"
       "    float shown = max(ground, min(150.0, floor(c.r * 255.0 * 0.94)));\n"
       "    if (down > 0.5 || right > 0.5) shown = 200.0;\n"
       "    fragColor = vec4(shown / 255.0, down, right, 1.0);\n"
       "}\n"))

    (define ECHO-SOURCE
      (string-append
       GLSL-PREFIX
       FIELD-GLSL
       "uniform float u_clock;\n"
       "uniform float u_seed;\n"
       "void main() {\n"
       "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
       "    vec2 q = vec2(p.x, int(u_resolution.y) - 1 - p.y);\n"
       "    uint seed = uint(u_seed);\n"
       "    uint grain = hash31(seed + 8192u + uint(q.x) + uint(q.y) * 64u);\n"
       "    float wave = 0.0;\n"
       "    // Four staggered drops. Each new center appears only after its old ring fades.\n"
       "    for (int i = 0; i < 4; i++) {\n"
       "        float clock = u_clock + float(i * 42);\n"
       "        float age = mod(clock, 168.0);\n"
       "        uint event = uint(floor(clock / 168.0)) * 4u + uint(i);\n"
       "        uint h = hash31(seed + event * 7919u);\n"
       "        vec2 center = vec2(2.0 + float(h % 36u), 2.0 + float((h >> 8) % 18u));\n"
       "        float distance = length(q - center);\n"
       "        float offset = distance - age * 0.19;\n"
       "        float envelope = exp(-offset * offset / 7.0);\n"
       "        float fade = smoothstep(0.0, 8.0, age) * (1.0 - smoothstep(90.0, 168.0, age));\n"
       "        wave += cos(offset * 2.1) * envelope * fade;\n"
       "    }\n"
       "    // Signed waves interfere; only the small overlaps reach the accent range.\n"
       "    float ground = float(grain % 32u);\n"
       "    float target = min(200.0, ground + 116.0 * abs(wave));\n"
       "    float shown = mix(cell(p).r * 255.0, target, 0.32);\n"
       "    fragColor = vec4(shown / 255.0, 0.0, 0.0, 1.0);\n"
       "}\n"))

    (define SYNAPSE-SOURCE
      (string-append
       GLSL-PREFIX
       FIELD-GLSL
       "uniform float u_clock;\n"
       "uniform float u_seed;\n"
       "uint nodeKey(ivec2 tile) {\n"
       "    return hash31(uint(u_seed) + uint(tile.x + 32) * 733u + uint(tile.y + 32) * 7919u);\n"
       "}\n"
       "vec2 node(ivec2 tile) {\n"
       "    uint h = nodeKey(tile);\n"
       "    return vec2(tile * 6) + vec2(1.0 + float(h % 4u), 1.0 + float((h >> 8) % 4u));\n"
       "}\n"
       "float segmentDistance(vec2 p, vec2 a, vec2 b) {\n"
       "    vec2 d = b - a;\n"
       "    float t = clamp(dot(p - a, d) / dot(d, d), 0.0, 1.0);\n"
       "    return length(p - a - t * d);\n"
       "}\n"
       "int wiring(vec2 p) {\n"
       "    ivec2 tile = ivec2(floor(p / 6.0));\n"
       "    if (length(p - node(tile)) < 0.8) return 2;\n"
       "    float nearest = 10.0;\n"
       "    // Jittered junctions and diagonal branches avoid a regular circuit grid.\n"
       "    for (int y = -1; y <= 0; y++) {\n"
       "        for (int x = -1; x <= 0; x++) {\n"
       "            ivec2 t = tile + ivec2(x, y);\n"
       "            vec2 a = node(t);\n"
       "            uint h = nodeKey(t);\n"
       "            if (h % 4u != 0u) nearest = min(nearest, segmentDistance(p, a, node(t + ivec2(1, 0))));\n"
       "            if ((h >> 4) % 4u != 0u) nearest = min(nearest, segmentDistance(p, a, node(t + ivec2(0, 1))));\n"
       "            if ((h >> 8) % 3u == 0u) nearest = min(nearest, segmentDistance(p, a, node(t + ivec2(1, 1))));\n"
       "        }\n"
       "    }\n"
       "    return nearest < 0.6 ? 1 : 0;\n"
       "}\n"
       "void main() {\n"
       "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
       "    vec2 q = vec2(p.x, int(u_resolution.y) - 1 - p.y);\n"
       "    vec4 c = cell(p);\n"
       "    uint h = hash31(uint(u_seed) + 8192u + uint(q.x) + uint(q.y) * 64u);\n"
       "    // Cache the seeded graph once; later steps only read neighbors' pulse phases.\n"
       "    int wire = c.a < 0.5 ? wiring(q) : int(floor(c.b * 255.0 + 0.5));\n"
       "    int phase = int(floor(c.g * 255.0 + 0.5));\n"
       "    if (c.a < 0.5) phase = wire == 2 && h % 4u == 0u ? 1 : 0;\n"
       "    else if (int(u_clock) % 3 == 0) {\n"
       "        uint pulse = hash31(uint(u_seed) + uint(u_clock / 21.0) * 1297u);\n"
       "        ivec2 origin = ivec2(int(pulse % 6u), int((pulse >> 8) % 3u));\n"
       "        bool scheduled = wire == 2 && int(u_clock) % 21 == 0 && all(equal(ivec2(q) / 6, origin));\n"
       "        // One local heartbeat survives quiet or refractory stretches of the graph.\n"
       "        if (scheduled) phase = 1;\n"
       "        else if (phase > 0) phase = (phase + 1) % 18;\n"
       "        else if (wire > 0) {\n"
       "            bool incoming = false;\n"
       "            for (int y = -1; y <= 1; y++) {\n"
       "                for (int x = -1; x <= 1; x++) {\n"
       "                    if (x != 0 || y != 0) {\n"
       "                        int neighbor = int(floor(cell(p + ivec2(x, y)).g * 255.0 + 0.5));\n"
       "                        if (neighbor == 3) incoming = true;\n"
       "                    }\n"
       "                }\n"
       "            }\n"
       "            bool spontaneous = wire == 2 && hash31(stepkey() + h) % 1000u < 2u;\n"
       "            if (incoming || spontaneous) phase = wire == 2 ? 1 : 3;\n"
       "        }\n"
       "    }\n"
       "    // Nodes pause for two beats before forwarding a pulse; refractory paths rest.\n"
       "    float ground = float(h % 32u);\n"
       "    if (wire > 0) ground = max(ground, 32.0 + float(h % 16u));\n"
       "    float shown = max(ground, floor(c.r * 255.0 * 0.94));\n"
       "    if (phase > 0 && phase <= 3) shown = min(wire == 2 ? 200.0 : 176.0, shown + 32.0);\n"
       "    fragColor = vec4(shown, float(phase), float(wire), 255.0) / 255.0;\n"
       "}\n"))
))
