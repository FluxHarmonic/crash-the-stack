;;; (crash gpu glsl) - What every shader in the game shares: the dialect
;;; prefix and sokol_gp's vertex stage.
;;;
;;; One source, two dialects: the desktop core profile natively (`#version
;;; 410`), GLSL ES 3.00 on the web build with the precision defaults ES
;;; requires; the version line and those defaults are the only
;;; differences the sources need, so they live here under cond-expand
;;; and every fragment source is GLSL-PREFIX followed by dialect-free
;;; text. The vertex stage is sgp's passthrough (coord = position.xy,
;;; texcoord.zw; color at location 1), the shape (sigil graphics)
;;; documents; a fragment stage reads texUV and iColor from it.
;;;
;;; Integer precision on the web is highp: the field's hash is 32-bit
;;; arithmetic on uint and a mediump int is 16 bits.

(define-library (crash gpu glsl)
  (export GLSL-PREFIX VERT-SOURCE)

  (begin
    (cond-expand
      (wasm
       (define GLSL-PREFIX
         "#version 300 es\nprecision highp float;\nprecision highp int;\nprecision mediump sampler2D;\n"))
      (else
       (define GLSL-PREFIX "#version 410\n")))

    (define VERT-SOURCE
      (string-append
       GLSL-PREFIX
       "layout(location = 0) in vec4 coord;\n"
       "layout(location = 1) in vec4 color;\n"
       "out vec2 texUV;\n"
       "out vec4 iColor;\n"
       "void main() {\n"
       "    gl_Position = vec4(coord.xy, 0.0, 1.0);\n"
       "    texUV = coord.zw;\n"
       "    iColor = color;\n"
       "}\n"))))
