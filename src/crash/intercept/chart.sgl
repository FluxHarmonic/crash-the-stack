;;; (crash intercept chart) - A tune's onsets turned into lanes
;;;
;;; David's rulings (2026-09-28): charts are generated from the song, never
;;; hand-authored; three difficulties SCRIPT KID / RUNNER / ELITE; taps only
;;; in this build. After his first play the same evening: ALWAYS FOUR LANES,
;;; on every difficulty and every device ("RUNNER's 6 keys are too many to
;;; map at once"), so a keyboard and a touch screen play the same chart. The
;;; keys are D F J K (index and middle fingers; F and J carry the home-row
;;; bumps); on touch, four wide pads, two per thumb. Difficulty scales the
;;; density, the fall speed and the patterns instead.
;;;
;;; The left hand plays the beat, the right hand the tune. Channel roles
;;; come from the soundtrack's shared layout (every song generated from
;;; docs/music/songs/ has it; measured on the five INTERCEPT songs): ch1
;;; kick, ch2 snare or clap, ch3 hats, ch4 bass, ch5 chord stab, ch6 and
;;; ch7 the melody, ch8 clicks.
;;;
;;;   lanes         D       F       J       K
;;;   SCRIPT KID    snare   kick    melody  melody    no chords, beats and eighths
;;;   RUNNER        snare   kick    melody  melody    chords of two, sixteenths
;;;   ELITE         snare   kick    melody  melody    + hats on D (quick repeats), the melody
;;;                 +hats   +melody                     crossing onto D and F, anything on the grid
;;;
;;; The melody's notes spread over its lanes by pitch, bar by bar: the
;;; distinct pitches of the bar in rising order take the lanes left to
;;; right (a bar with one pitch uses its pitch class). Then every candidate
;;; is offered in priority order (on the beat before off it, kick before
;;; snare before melody before hats, earlier first) and kept only if it
;;; leaves the tier's limits whole: the grid it may sit on, a gap to the
;;; last note in its lane, a gap to any note (notes at one instant are a
;;; chord: at most the tier's chord size), and a cap on notes in every
;;; second that holds it. The result is a pure function of the onsets and
;;; the tier, so `chart-hash` pins it.
;;;
;;;   (make-chart onsets difficulty)  -> vector of #(ms lane), in time order
;;;   (chart-lanes difficulty)        -> 4
;;;   (chart-keys difficulty)         -> the key symbol per lane: (d f j k)
;;;   (chart-fall-ms difficulty)      -> how long a note falls before the hit line
;;;   (chart-hash chart)              -> an integer over every note (the gate pins it)

(define-library (crash intercept chart)
  (import (sigil math)
          (sigil list))

  (export make-chart chart-lanes chart-keys chart-fall-ms chart-hash chart-rate
          DIFFICULTIES difficulty-name difficulty? TIERS KEYS)

  (begin
    (define DIFFICULTIES (list 'script-kid 'runner 'elite))
    (define (difficulty? d) (and (memq d DIFFICULTIES) #t))
    (define (difficulty-name d)
      (case d ((script-kid) "SCRIPT KID") ((runner) "RUNNER") (else "ELITE")))

    ;; Per tier: (grid-max lane-gap any-gap cap chord)
    ;; grid-max: 1 beats and eighths, 2 to sixteenths, 3 anything; gaps in
    ;; ms (ELITE's 110 ms lane gap is the quick repeats); cap: notes in any
    ;; second; chord: notes allowed at one instant.
    (define TIERS
      '((script-kid 1 300 200 2 1)
        (runner     2 200 120 4 2)
        (elite      3 110  70 6 2)))

    (define (tier difficulty) (cdr (assq difficulty TIERS)))

    (define KEYS '(d f j k))
    (define (chart-keys difficulty) KEYS)
    (define (chart-lanes difficulty) 4)

    ;; Fall time from the top of the lanes to the hit line (the tiers scale
    ;; speed as well as density, David via the leader 2026-09-28).
    (define (chart-fall-ms difficulty)
      (case difficulty ((script-kid) 1700) ((runner) 1400) (else 1150)))

    ;; The layout: which lanes the beat's channels take, where the melody's
    ;; lanes start and how many there are, and which channels feed it.
    ;;   (beat-roles melody-base melody-lanes melody-channels)
    ;; beat-roles: ((channel . lane) ...). ELITE's melody spans all four
    ;; lanes (it crosses onto the left hand) and its hats join the snare's.
    (define (layout difficulty)
      (case difficulty
        ((elite) (list '((2 . 0) (1 . 1) (3 . 0)) 0 4 '(6 4 7)))
        (else (list '((2 . 0) (1 . 1)) 2 2 '(6 4 7)))))
    ;; Priority of a channel's notes when the limits force a choice.
    (define (role-rank ch)
      (case ch ((1) 0) ((2) 1) ((6) 2) ((4) 3) ((7) 4) ((3) 5) ((5) 6) (else 7)))

    (define (o-ms o) (vector-ref o 0))
    (define (o-ch o) (vector-ref o 1))
    (define (o-midi o) (vector-ref o 2))
    (define (o-grid o) (vector-ref o 3))
    (define (o-bar o) (vector-ref o 4))

    (define (uniq-sorted xs)
      (let loop ((xs (list-sort < xs)) (acc '()))
        (cond ((null? xs) (reverse acc))
              ((and (pair? acc) (= (car acc) (car xs))) (loop (cdr xs) acc))
              (else (loop (cdr xs) (cons (car xs) acc))))))

    (define (index-of x xs)
      (let loop ((xs xs) (i 0))
        (cond ((null? xs) 0) ((= (car xs) x) i) (else (loop (cdr xs) (+ i 1))))))

    ;; The melody lane of one note, from the distinct pitches of its bar.
    (define (melody-lane midi pitches base n)
      (let ((k (length pitches)))
        (+ base
           (cond ((= k 1) (modulo midi n))
                 ((<= k n) (exact (round (/ (* (index-of midi pitches) (- n 1)) (* 1.0 (- k 1))))))
                 (else (quotient (* (index-of midi pitches) n) k))))))

    ;; Candidates: (ms lane grid rank) for every onset a lane takes.
    (define (candidates onsets difficulty)
      (let* ((lay (layout difficulty))
             (left (list-ref lay 0))
             (base (list-ref lay 1))
             (n (list-ref lay 2))
             (melodic (list-ref lay 3))
             ;; bar -> the distinct melody pitches in it
             (bars (let loop ((os onsets) (acc '()))
                     (if (null? os)
                         acc
                         (let ((o (car os)))
                           (if (memv (o-ch o) melodic)
                               (let ((e (assv (o-bar o) acc)))
                                 (if e
                                     (begin (set-cdr! e (cons (o-midi o) (cdr e))) (loop (cdr os) acc))
                                     (loop (cdr os) (cons (list (o-bar o) (o-midi o)) acc))))
                               (loop (cdr os) acc))))))
             (bars (map (lambda (e) (cons (car e) (uniq-sorted (cdr e)))) bars)))
        (let loop ((os onsets) (acc '()))
          (if (null? os)
              (reverse acc)
              (let* ((o (car os))
                     (l (assv (o-ch o) left)))
                (loop (cdr os)
                      (cond (l (cons (list (o-ms o) (cdr l) (o-grid o) (role-rank (o-ch o))) acc))
                            ((memv (o-ch o) melodic)
                             (cons (list (o-ms o)
                                         (melody-lane (o-midi o) (cdr (assv (o-bar o) bars)) base n)
                                         (o-grid o)
                                         (role-rank (o-ch o)))
                                   acc))
                            (else acc))))))))

    (define (better? a b)
      (let ((ga (list-ref a 2)) (gb (list-ref b 2))
            (ra (list-ref a 3)) (rb (list-ref b 3)))
        (or (< ga gb)
            (and (= ga gb) (< ra rb))
            (and (= ga gb) (= ra rb) (< (car a) (car b)))
            (and (= ga gb) (= ra rb) (= (car a) (car b)) (< (cadr a) (cadr b))))))

    ;; Accepted notes kept in 10 ms buckets, so every check reads only the
    ;; buckets within reach of the candidate.
    (define BUCKET-MS 10)
    (define CHORD-MS 1.0)   ; two notes this close are one instant (a chord)

    (define (make-chart onsets difficulty)
      (let* ((t (tier difficulty))
             (grid-max (list-ref t 0))
             (lane-gap (list-ref t 1))
             (any-gap (list-ref t 2))
             (cap (list-ref t 3))
             (chord (list-ref t 4))
             (cands (filter (lambda (c) (<= (list-ref c 2) grid-max))
                            (candidates onsets difficulty)))
             (end-ms (fold-left (lambda (m c) (max m (car c))) 0.0 cands))
             (nb (+ 2 (exact (floor (/ end-ms BUCKET-MS)))))
             (buckets (make-vector nb '()))
             (bucket-of (lambda (ms) (max 0 (min (- nb 1) (exact (floor (/ ms BUCKET-MS)))))))
             ;; The accepted note times within (ms - 1000, ms + 1000), sorted.
             (around (lambda (ms)
                       (let loop ((b (bucket-of (- ms 1000))) (acc '()))
                         (if (> b (bucket-of (+ ms 1000)))
                             (list-sort < acc)
                             (loop (+ b 1)
                                   (fold-left (lambda (acc e)
                                                (if (< (abs (- (car e) ms)) 1000) (cons (car e) acc) acc))
                                              acc
                                              (vector-ref buckets b)))))))
             ;; The cap: with ms added, no window [p, p + 1000) that holds ms
             ;; holds more than cap notes. Such a window at its fullest starts
             ;; on a note, so only the starts at or before ms are tried.
             (under-cap? (lambda (ms)
                           (let ((ts (list-sort < (cons ms (around ms)))))
                             (let loop ((starts ts))
                               (cond ((or (null? starts) (> (car starts) ms)) #t)
                                     ((<= (+ (car starts) 1000) ms) (loop (cdr starts)))
                                     ((> (length (filter (lambda (x) (and (>= x (car starts)) (< x (+ (car starts) 1000)))) ts))
                                         cap)
                                      #f)
                                     (else (loop (cdr starts))))))))
             ;; One pass over the accepted notes within the widest gap,
             ;; allocating nothing, then the cap:
             ;;   - one note per lane within the lane gap (a chord is two lanes)
             ;;   - any other note: at this instant (a chord, two at most) or
             ;;     at least the any-gap away
             ;;   - under the cap in every second that holds it
             (reach (max lane-gap any-gap))
             (fits? (lambda (c)
                      (let ((ms (car c))
                            (lane (cadr c))
                            (last (bucket-of (+ (car c) reach))))
                        (let loop ((b (bucket-of (- (car c) reach)))
                                   (es '())
                                   (same 0))
                          (cond ((pair? es)
                                 (let* ((e (car es))
                                        (d (abs (- (car e) ms))))
                                   (cond ((>= d reach) (loop b (cdr es) same))
                                         ((and (= (cdr e) lane) (< d lane-gap)) #f)
                                         ((< d CHORD-MS) (loop b (cdr es) (+ same 1)))
                                         ((< d any-gap) #f)
                                         (else (loop b (cdr es) same)))))
                                ((<= b last) (loop (+ b 1) (vector-ref buckets b) same))
                                (else (and (< same chord) (under-cap? ms)))))))))
        (for-each (lambda (c)
                    (when (fits? c)
                      (let ((b (bucket-of (car c))))
                        (vector-set! buckets b (cons (cons (car c) (cadr c)) (vector-ref buckets b))))))
                  (list-sort better? cands))
        (list->vector
          (map (lambda (e) (vector (car e) (cdr e)))
               (list-sort (lambda (a b) (or (< (car a) (car b)) (and (= (car a) (car b)) (< (cdr a) (cdr b)))))
                          (apply append (vector->list buckets)))))))

    ;; Notes per second over the chart's span (a figure for the gate and the select screen).
    (define (chart-rate chart)
      (let ((n (vector-length chart)))
        (if (< n 2)
            0.0
            (/ n (/ (- (vector-ref (vector-ref chart (- n 1)) 0) (vector-ref (vector-ref chart 0) 0)) 1000.0)))))

    ;; A hash over every note: time to 0.01 ms and lane, folded mod a prime
    ;; under 2^24 so it stays a small integer on the web (wasm's small
    ;; integers are 32-bit signed).
    (define HASH-MOD 16777213)
    (define (chart-hash chart)
      (let loop ((i 0) (h 5381))
        (if (= i (vector-length chart))
            h
            (let* ((note (vector-ref chart i))
                   (ms (exact (round (* 100.0 (vector-ref note 0)))))
                   (h (modulo (+ (* h 33) (modulo ms HASH-MOD)) HASH-MOD))
                   (h (modulo (+ (* h 33) (vector-ref note 1) 1) HASH-MOD)))
              (loop (+ i 1) h)))))))
