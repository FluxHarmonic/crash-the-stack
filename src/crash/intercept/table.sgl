;;; (crash intercept table) - INTERCEPT's screen: select a song, play it, the results
;;;
;;; One value the shells step once a frame and draw with (crash intercept
;;; draw). Phases:
;;;
;;;   select   the set list (David's ruling d: Black Glass, Blind Spot,
;;;            Sector Drift, Clock Edge, Glass Current), DIFFICULTY and
;;;            OFFSET; Enter or a tap on PLAY starts the song
;;;   loading  the song's text is on its way (the web page's fetch)
;;;   play     the song runs; presses are judged on the song clock
;;;   results  LINK HELD or LINK SEVERED, the score; RETRY or SONGS
;;;
;;; A frame hands in: the keys pressed (menu keys), the lane presses with
;;; the wall ms each happened at (the web shell stamps a key when its DOM
;;; event arrives, the native shell when it polls), the taps in virtual
;;; px with their wall ms, and the frame's wall ms. The song clock is
;;; (crash intercept clock) steered by (crash intercept audio)'s count
;;; of frames heard; a press's song time is the clock's reading at the
;;; press's wall time, minus OFFSET (a positive offset means the sound
;;; reaches the player later than the sink says, so presses land later).
;;;
;;;   (intercept-open touch? song)         -> a table on the select screen (song: a name or #f)
;;;   (intercept-step t frame)             -> the table after the frame
;;;   (intercept-requests t)               -> ('menu) when the player left INTERCEPT
;;;   (make-intercept-frame keys presses taps wall-ms)
;;;       keys: symbols pressed; presses: ((key . wall-ms) ...); taps: ((x y wall-ms) ...)
;;;
;;; Lines (the shells print what intercept-say! hands them):
;;;   crash: intercept select SONG DIFFICULTY keys|touch       the song select opened
;;;   crash: intercept open SONG DIFFICULTY keys|touch notes N hash H lanes L
;;;   crash: intercept press LANE SONG-MS             a song's first 16 lane presses (the arms: input reached the lane)
;;;   crash: intercept start SONG lead MS audio on|off
;;;   crash: intercept end held|severed score S acc A max-combo C counts SY CL LO DR
;;;   crash: intercept clock SONG-MS error MS audio MS wall MS   (each second: the drawn clock, audio minus drawn,
;;;                                                     the audio clock, the frame's wall ms)

(define-library (crash intercept table)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (sigil string)
          (motif tune)
          (crash store)
          (only (crash music live) live-music-text)
          (crash intercept source)
          (crash intercept chart)
          (crash intercept rules)
          (crash intercept clock)
          (crash intercept audio))

  (export intercept-open intercept-step intercept-requests make-intercept-frame
          intercept-phase intercept-songs intercept-song intercept-difficulty intercept-touch?
          intercept-focus intercept-offset intercept-run intercept-chart intercept-now
          intercept-fall-ms intercept-lanes intercept-flashes intercept-over intercept-best
          intercept-length-ms intercept-sections intercept-message intercept-last-note-ms intercept-over-ms intercept-set-say! intercept-autoplay!
          intercept-results-rows intercept-select-rows intercept-leave! intercept-set-audio-reader!
          intercept-taps CALIBRATE-TAPS
          SONGS LEAD-MS OFFSET-STEP)

  (begin
    ;; David's ruling d, in his order.
    (define SONGS
      (list (list 'black-glass "BLACK GLASS" 140)
            (list 'blind-spot "BLIND SPOT" 96)
            (list 'sector-drift "SECTOR DRIFT" 100)
            (list 'clock-edge "CLOCK EDGE" 128)
            (list 'glass-current "GLASS CURRENT" 172)))
    (define (intercept-songs) SONGS)

    (define LEAD-MS 2500)        ; silence before the song: the first bars fall in from the top
    (define END-HOLD-MS 1200)    ; after the last note's window, the results come up
    (define OFFSET-STEP 5)
    (define OFFSET-MAX 300)
    (define STORE-KEY "intercept")

    (define *say* (lambda parts #f))
    (define (intercept-set-say! proc) (set! *say* proc))

    ;; --autoplay / ?autoplay: every note pressed on the first frame whose
    ;; song clock reaches it (the drift gate's driver); presses from the
    ;; devices still count.
    (define *autoplay* #f)
    (define (intercept-autoplay! on) (set! *autoplay* on))

    ;; Where the song clock reads the audio from: (crash intercept audio)'s
    ;; audible time, or a test's simulated sink.
    (define *audio-reader* intercept-audio-ms)
    (define (intercept-set-audio-reader! proc) (set! *audio-reader* proc))

    (define-struct intercept-frame (keys) (presses) (taps) (wall))
    (define (make-intercept-frame keys presses taps wall)
      (intercept-frame keys: keys presses: presses taps: taps wall: wall))

    (define-struct itable
      (phase default: 'select)     ; select | loading | play | results
      (touch default: #f)
      (song default: 0)            ; index into SONGS
      (focus default: 0)           ; the select screen's row: 0..4 songs, 5 difficulty, 6 offset
      (difficulty default: 'runner)
      (offset default: 0)          ; ms, OFFSET's value
      (chart default: #f)
      (run default: #f)
      (clock default: #f)
      (length-ms default: 0.0)     ; the song's end on its clock
      (sections default: (quote ()))  ; ((ms . major?) ...): the song's pattern changes, for the progress bar
      (loading-since default: #f)  ; wall ms the song's text was first asked for
      (message default: #f)        ; a line for the select screen (the text never came, or would not read)
      (calibrate default: #f)      ; this song is a calibration: tap along to the kick, OFFSET from the median
      (kicks default: #f)          ; the calibration's kick onsets, a sorted vector of song ms
      (taps default: (quote ()))   ; the calibration's tap deltas so far (ms, tap - nearest kick)
      (lanes default: 4)
      (flashes default: '())       ; #(kind lane wall-ms judgment) for the draw, newest first
      (over default: #f)           ; held | severed
      (over-wall default: 0)       ; wall ms the results came up
      (best default: #f)           ; the best before this run (the results' line)
      (said-at default: 0)         ; the song ms the last clock line was said at
      (presses-said default: 0)    ; the song's lane presses said so far (the first PRESS-LINES)
      (requests default: '()))

    (define (intercept-phase t) (itable-phase t))
    (define (intercept-touch? t) (itable-touch t))
    (define (intercept-song t) (list-ref SONGS (itable-song t)))
    (define (intercept-difficulty t) (itable-difficulty t))
    (define (intercept-focus t) (itable-focus t))
    (define (intercept-offset t) (itable-offset t))
    (define (intercept-run t) (itable-run t))
    (define (intercept-chart t) (itable-chart t))
    (define (intercept-lanes t) (itable-lanes t))
    (define (intercept-flashes t) (itable-flashes t))
    (define (intercept-over t) (itable-over t))
    (define (intercept-best t) (itable-best t))
    (define (intercept-length-ms t) (itable-length-ms t))
    (define (intercept-sections t) (itable-sections t))
    (define (intercept-message t) (itable-message t))
    (define (intercept-taps t) (itable-taps t))
    (define (intercept-last-note-ms t) (last-note-ms t))
    (define (intercept-requests t) (itable-requests t))
    (define (intercept-fall-ms t) (chart-fall-ms (itable-difficulty t)))
    ;; The song time the notes are drawn and judged at: the clock less OFFSET
    (define (intercept-now t) (and (itable-clock t) (- (clock-ms (itable-clock t)) (itable-offset t))))
    (define (intercept-over-ms t wall) (- wall (itable-over-wall t)))

    ;; --- the stored choices and bests ----------------------------------------------
    (define (stored)
      (let ((d (guard (e (#t #f)) (store-read-datum STORE-KEY))))
        (if (list? d) d '())))
    (define (stored-ref key default)
      (let ((e (assq key (stored)))) (if e (cdr e) default)))
    (define (store! key value)
      (guard (e (#t #f))
        (store-write-datum! STORE-KEY
                            (cons (cons key value) (filter (lambda (e) (and (pair? e) (not (eq? (car e) key)))) (stored))))))
    (define (best-key t)
      (string->symbol (string-append (symbol->string (car (intercept-song t)))
                                     "/" (symbol->string (itable-difficulty t))
                                     (if (itable-touch t) "/touch" "/keys"))))
    (define (best-of t)
      (let ((e (assq (best-key t) (stored-ref 'best '()))))
        (and e (cdr e))))
    (define (record-best! t score)
      (let ((old (stored-ref 'best '())))
        (store! 'best (cons (cons (best-key t) score) (filter (lambda (e) (not (eq? (car e) (best-key t)))) old)))))

    (define (song-index name)
      (let loop ((ss SONGS) (i 0))
        (cond ((null? ss) 0) ((eq? (car (car ss)) name) i) (else (loop (cdr ss) (+ i 1))))))

    (define PRESS-LINES 16)
    (define (intercept-open touch? song)
      (let* ((d (stored-ref 'difficulty 'runner))
             (t (itable touch: touch?
                        song: (if (and song (assq song SONGS)) (song-index song) (song-index (stored-ref 'song 'black-glass)))
                        difficulty: (if (difficulty? d) d 'runner)
                        offset: (let ((o (stored-ref 'offset 0))) (if (and (integer? o) (<= (abs o) OFFSET-MAX)) o 0)))))
        (when (and song (not (assq song SONGS))) (*say* "intercept unknown" song))   ; a door's name not on the set list: the list opens on the stored song
        (*say* "intercept select" (car (intercept-song t)) (itable-difficulty t) (if touch? "touch" "keys"))
        t))

    ;; Leaving the screen (MENU, Escape from the list): the song stops.
    (define (intercept-leave! t)
      (intercept-audio-stop!)
      t)

    ;; --- the rows (the draw and the taps share them) ---------------------------------
    ;; The select screen: (id x y w h) per tappable row.
    (define ROW-X 120)
    (define ROW-W 400)
    (define ROW-H 22)
    (define ROWS-Y 96)
    (define (intercept-select-rows)
      (append (let loop ((i 0) (acc '()))
                (if (= i (length SONGS))
                    (reverse acc)
                    (loop (+ i 1) (cons (list i ROW-X (+ ROWS-Y (* i ROW-H)) ROW-W (- ROW-H 2)) acc))))
              (list (list 5 ROW-X 222 ROW-W 20)
                    (list 6 ROW-X 246 ROW-W 20)
                    (list 7 ROW-X 268 ROW-W 18)   ; CALIBRATE
                    (list 'play 220 292 200 26)
                    (list 'back 8 8 72 20))))
    (define (intercept-results-rows)
      (list (list 'retry 170 318 140 26)
            (list 'songs 330 318 140 26)))

    (define (hit rows x y)
      (let ((r (list-find (lambda (r) (and (>= x (list-ref r 1)) (< x (+ (list-ref r 1) (list-ref r 3)))
                                           (>= y (list-ref r 2)) (< y (+ (list-ref r 2) (list-ref r 4)))))
                          rows)))
        (and r (car r))))

    ;; --- select ---------------------------------------------------------------------
    (define (step-difficulty d delta)
      (let* ((i (let loop ((ds DIFFICULTIES) (i 0)) (if (eq? (car ds) d) i (loop (cdr ds) (+ i 1)))))
             (n (length DIFFICULTIES)))
        (list-ref DIFFICULTIES (modulo (+ i delta) n))))

    ;; Up/down within the focus's group: songs 0..4 (the chosen song follows),
    ;; or the settings rows 5..7; each group wraps on itself.
    (define (step-focus t delta)
      (let ((i (itable-focus t)))
        (if (< i 5)
            (let ((j (modulo (+ i delta) 5)))
              (itable t focus: j song: j))
            (itable t focus: (+ 5 (modulo (+ (- i 5) delta) 3))))))

    ;; left/right on a song row step DIFFICULTY (no need to leave the list)
    (define (adjust t delta)
      (case (if (< (itable-focus t) 5) 5 (itable-focus t))
        ((5) (let ((d (step-difficulty (itable-difficulty t) delta)))
               (store! 'difficulty d)
               (itable t difficulty: d)))
        ((6) (let ((o (max (- OFFSET-MAX) (min OFFSET-MAX (+ (itable-offset t) (* delta OFFSET-STEP))))))
               (store! 'offset o)
               (itable t offset: o)))
        (else t)))

    (define (step-select t f)
      (let loop ((keys (intercept-frame-keys f)) (t t))
        (if (null? keys)
            (let tap-loop ((taps (intercept-frame-taps f)) (t t))
              (if (null? taps)
                  t
                  (let* ((tap (car taps))
                         (id (hit (intercept-select-rows) (car tap) (cadr tap))))
                    (cond ((not id) (tap-loop (cdr taps) t))
                          ((eq? id 'play) (begin-song t (caddr tap)))
                          ((eqv? id 7) (begin-calibrate t))
                          ((eq? id 'back) (itable t requests: (list 'menu)))
                          ((and (integer? id) (< id 5))
                           ;; a tap on the chosen song plays it; on another, chooses it
                           (if (= id (itable-song t))
                               (begin-song t (caddr tap))
                               (tap-loop (cdr taps) (itable t song: id focus: id))))
                          (else
                           ;; DIFFICULTY / OFFSET: the right half steps up, the left half down
                           (tap-loop (cdr taps)
                                     (adjust (itable t focus: id) (if (>= (car tap) (+ ROW-X (quotient ROW-W 2))) 1 -1))))))))
            (let ((k (car keys)))
              (case k
                ;; two groups: the five songs (the chosen song follows the focus) and
                ;; the three settings rows; up/down stay in the focus's group and Tab
                ;; moves between them, so reaching DIFFICULTY never walks the chosen
                ;; song down the list (it did: Black Glass became Glass Current)
                ((up) (loop (cdr keys) (step-focus t -1)))
                ((down) (loop (cdr keys) (step-focus t 1)))
                ((tab) (loop (cdr keys) (itable t focus: (if (< (itable-focus t) 5) 5 (itable-song t)))))
                ((left) (loop (cdr keys) (adjust t -1)))
                ((right) (loop (cdr keys) (adjust t 1)))
                ((return space) (if (= 7 (itable-focus t))
                                    (begin-calibrate t)
                                    (begin-song t (intercept-frame-wall f))))
                ((escape) (itable t requests: (list 'menu)))
                (else (loop (cdr keys) t)))))))

    ;; --- a song -----------------------------------------------------------------------
    (define (begin-song t wall)
      (store! 'song (car (intercept-song t)))
      (itable t phase: 'loading requests: '() over: #f run: #f chart: #f clock: #f flashes: '() calibrate: #f
                loading-since: #f message: #f))

    ;; The text is asked for every frame until it lands (natively at once).
    ;; Escape or the MENU tap goes back to the list; a text that has not
    ;; landed in LOADING-MS (a fetch the page gave up on is never asked
    ;; again) goes back with a message, so a touch player is never stuck
    ;; (the review's M1).
    (define LOADING-MS 20000)
    (define (step-loading t f)
      (let ((wall (intercept-frame-wall f))
            (back? (or (memq 'escape (intercept-frame-keys f))
                       (list-find (lambda (tap) (eq? 'back (hit (intercept-select-rows) (car tap) (cadr tap))))
                                  (intercept-frame-taps f)))))
        (cond (back? (itable t phase: 'select))
              ((not (itable-loading-since t)) (step-loading (itable t loading-since: wall) f))
              ((> (- wall (itable-loading-since t)) LOADING-MS)
               (*say* "intercept lost" (car (intercept-song t)))
               (itable t phase: 'select message: "NO SIGNAL: THE TRANSMISSION DID NOT ARRIVE"))
              (else
               (let ((text (live-music-text (car (intercept-song t)))))
                 (if (not text)
                     t
                     (start-song t text wall)))))))

    (define (start-song t text wall)
      (let ((tune (guard (e (#t #f)) (read-tune-string text))))
        (if (not tune)
            (begin (*say* "intercept corrupt" (car (intercept-song t)))
                   (itable t phase: 'select message: "THE TRANSMISSION IS CORRUPTED"))
            (start-tune t tune wall))))

    ;; CALIBRATE (the leader for David, 2026-09-28: "tap along to a few beats;
    ;; set OFFSET from the median"): the chosen song plays from its top with
    ;; nothing falling; any lane key or pad tapped on the kick is measured
    ;; against the nearest kick on the song clock. After CALIBRATE-TAPS taps
    ;; OFFSET is their median, rounded to OFFSET-STEP: a player who hears the
    ;; song late taps late by the same amount, and OFFSET moves the judging
    ;; that far later. Taps further than CALIBRATE-REACH from any kick are
    ;; not counted (a stray press, or the lead-in).
    (define CALIBRATE-TAPS 8)
    (define CALIBRATE-REACH 300)
    (define CALIBRATE-MS 40000)   ; the song ms by which it gives up
    (define (begin-calibrate t)
      (itable (begin-song t 0) calibrate: #t))

    (define (kick-onsets onsets)
      (list->vector (map (lambda (o) (vector-ref o 0))
                         (filter (lambda (o) (= 1 (vector-ref o 1))) onsets))))

    (define (nearest-delta kicks ms)
      (let loop ((i 0) (best #f))
        (if (= i (vector-length kicks))
            best
            (let ((d (- ms (vector-ref kicks i))))
              (loop (+ i 1) (if (or (not best) (< (abs d) (abs best))) d best))))))

    (define (median xs)
      (let* ((s (list-sort < xs)) (n (length s)))
        (if (odd? n)
            (list-ref s (quotient n 2))
            (/ (+ (list-ref s (- (quotient n 2) 1)) (list-ref s (quotient n 2))) 2.0))))

    (define (start-calibration t tune w wall)
      (let ((sounding (intercept-audio-start! tune LEAD-MS)))
        (*say* "intercept calibrate start" (car (intercept-song t)) "audio" (if sounding "on" "off"))
        (itable t
                phase: 'calibrate
                chart: (vector)
                run: (make-run (vector) 4)
                clock: (make-clock (- LEAD-MS) wall)
                length-ms: (vector-ref w 0)
                sections: (vector-ref w 2)
                lanes: 4
                kicks: (kick-onsets (vector-ref w 1))
                taps: '()
                said-at: 0
                flashes: '())))

    (define (step-calibrate t f)
      (let* ((wall (intercept-frame-wall f))
             (clock (clock-tick (itable-clock t) wall (*audio-reader*)))
             (now (clock-ms clock))
             ;; raw song time, no OFFSET: the calibration measures it
             (times (append (filter (lambda (x) x)
                                    (map (lambda (p) (and (key-lane t (car p)) (clock-at clock (min wall (cdr p)))))
                                         (intercept-frame-presses f)))
                            (filter (lambda (x) x)
                                    (map (lambda (tap) (and (tap-lane t (car tap) (cadr tap)) (clock-at clock (min wall (caddr tap)))))
                                         (intercept-frame-taps f)))))
             (deltas (filter (lambda (d) (and d (<= (abs d) CALIBRATE-REACH)))
                             (map (lambda (ms) (nearest-delta (itable-kicks t) ms)) times)))
             (_ (for-each (lambda (d) (*say* "intercept calibrate tap" (exact (round d)))) deltas))
             (taps (append (itable-taps t) deltas))
             (flashes (append (map (lambda (x) (vector 'press 0 wall #f)) times)
                              (filter (lambda (fl) (< (- wall (vector-ref fl 2)) FLASH-KEEP-MS)) (itable-flashes t))))
             (t (itable t clock: clock taps: taps flashes: flashes)))
        (cond ((memq 'escape (intercept-frame-keys f))
               (intercept-audio-stop!)
               (itable t phase: 'select calibrate: #f))
              ((>= (length taps) CALIBRATE-TAPS)
               (let* ((m (median taps))
                      (o (max (- OFFSET-MAX) (min OFFSET-MAX (* OFFSET-STEP (exact (round (/ m OFFSET-STEP))))))))
                 (intercept-audio-stop!)
                 (store! 'offset o)
                 (*say* "intercept calibrate done" o "median" (exact (round m)) "taps" (length taps))
                 (itable t phase: 'select calibrate: #f offset: o focus: 6
                         message: (string-append "OFFSET SET TO " (if (> o 0) "+" "") (number->string o)
                                                 " MS FROM " (number->string (length taps)) " TAPS"))))
              ((> now CALIBRATE-MS)
               (intercept-audio-stop!)
               (itable t phase: 'select calibrate: #f
                       message: (string-append "CALIBRATION NEEDS " (number->string CALIBRATE-TAPS) " TAPS ON THE KICK")))
              (else t))))

    (define (start-tune t tune wall)
      (if (itable-calibrate t)
          (start-calibration t tune (tune-walk tune) wall)
          (start-song-tune t tune wall)))

    (define (start-song-tune t tune wall)
      (let* ((w (tune-walk tune))
             (d (itable-difficulty t))
             (touch? (itable-touch t))
             (chart (make-chart (vector-ref w 1) d))
             (lanes (chart-lanes d))
             (sounding (intercept-audio-start! tune LEAD-MS)))
        (*say* "intercept open" (car (intercept-song t)) d (if touch? "touch" "keys")
               "notes" (vector-length chart) "hash" (chart-hash chart) "lanes" lanes)
        (*say* "intercept start" (car (intercept-song t)) "lead" LEAD-MS "audio" (if sounding "on" "off"))
        (itable t
                phase: 'play
                chart: chart
                run: (make-run chart lanes)
                clock: (make-clock (- LEAD-MS) wall)
                length-ms: (vector-ref w 0)
                sections: (vector-ref w 2)
                lanes: lanes
                best: (best-of t)
                said-at: 0
                presses-said: 0
                flashes: '())))

    ;; A key's lane on this chart, or #f. The web reports ; as |;|, the
    ;; native shell as semicolon: both are the eighth lane.
    (define (key-lane t k)
      (let* ((k (if (eq? k (string->symbol ";")) 'semicolon k))
             (keys (chart-keys (itable-difficulty t))))
        (let loop ((ks keys) (i 0))
          (cond ((null? ks) #f) ((eq? (car ks) k) i) (else (loop (cdr ks) (+ i 1)))))))

    ;; A tap's lane: the touch lanes are 160 px wide across the whole
    ;; width; a tap in the lower 60% of the screen counts (the thumbs).
    (define (tap-lane t x y)
      (and (itable-touch t)
           (>= y 150)
           (< -1 x 640)
           (min 3 (quotient (exact (floor x)) 160))))


    (define (autoplay-presses t now)
      (let* ((r (itable-run t))
             (chart (itable-chart t)))
        (let loop ((i (run-judged-floor r)) (acc '()))
          (if (>= i (vector-length chart))
              acc
              (let ((note (vector-ref chart i)))
                ;; pressed at this frame's reading, the first frame at or past
                ;; the note: the judgment then shows the frame and clock jitter
                ;; a player's press carries, not a delta of 0 by construction
                (cond ((> (vector-ref note 0) now) acc)
                      ((run-judgment r i) (loop (+ i 1) acc))
                      (else (loop (+ i 1) (cons (cons (vector-ref note 1) now) acc)))))))))

    ;; The first index worth checking: notes before the last judged one are
    ;; done (they are judged in time order per lane; a small look-back covers chords).
    (define (run-judged-floor r) (max 0 (- (run-judged r) 16)))

    (define FLASH-KEEP-MS 600)

    (define (step-play t f)
      (let* ((wall (intercept-frame-wall f))
             (clock (clock-tick (itable-clock t) wall (*audio-reader*)))
             (now (clock-ms clock))
             (off (itable-offset t))
             ;; the song time the player's ear is at: presses, expiry, autoplay, the end
             ;; and the draw all run on it (the review's H1: expiry once ran on the raw
             ;; clock, so a positive OFFSET dropped notes the player hit on time)
             (j (- now off))
             (lane-presses
               (append
                 (filter (lambda (p) p)
                         (map (lambda (p)
                                (let ((lane (key-lane t (car p))))
                                  (and lane (cons lane (- (clock-at clock (min wall (cdr p))) off)))))
                              (intercept-frame-presses f)))
                 (filter (lambda (p) p)
                         (map (lambda (tap)
                                (let ((lane (tap-lane t (car tap) (cadr tap))))
                                  (and lane (cons lane (- (clock-at clock (min wall (caddr tap))) off)))))
                              (intercept-frame-taps f)))
                 (if *autoplay* (autoplay-presses t j) '())))
             (_ (let loop ((ps lane-presses) (n (itable-presses-said t)))
                  (when (and (pair? ps) (< n PRESS-LINES))
                    (*say* "intercept press" (car (car ps)) (exact (round (cdr (car ps)))))
                    (loop (cdr ps) (+ n 1)))))
             (r (run-advance (itable-run t) j lane-presses))
             (flashes (append (reverse (map (lambda (e) (vector (vector-ref e 0) (vector-ref e 1) wall
                                                                (if (eq? (vector-ref e 0) 'hit) (vector-ref e 3) #f)))
                                            (run-events r)))
                              (filter (lambda (fl) (< (- wall (vector-ref fl 2)) FLASH-KEEP-MS))
                                      (itable-flashes t))))
             (t (itable t clock: clock run: r flashes: flashes
                        presses-said: (min PRESS-LINES (+ (itable-presses-said t) (length lane-presses))))))
        (when (>= now (+ (itable-said-at t) 1000))
          (*say* "intercept clock" (exact (round now)) "error"
                 (let ((e (clock-error clock))) (if e (exact (round e)) "-"))
                 "audio" (let ((a (intercept-audio-ms))) (if a (number->string (/ (round (* 10.0 a)) 10.0)) "-"))
                 "wall" (number->string (round wall))))   ; a float through number->string: an exact epoch integer wraps on wasm (32-bit small integers) and display rounds a float to 6 digits
        (let ((t (if (>= now (+ (itable-said-at t) 1000)) (itable t said-at: now) t)))
          (cond ((memq 'escape (intercept-frame-keys f))
                 (intercept-audio-stop!)
                 (itable t phase: 'select))
                ((run-failed? r) (finish t 'severed wall))
                ((and (run-done? r)
                      (> j (+ (last-note-ms t) LOSSY-MS END-HOLD-MS)))
                 (finish t 'held wall))
                (else t)))))

    (define (last-note-ms t)
      (let ((c (itable-chart t)))
        (if (= 0 (vector-length c)) 0.0 (vector-ref (vector-ref c (- (vector-length c) 1)) 0))))

    (define (finish t how wall)
      (let ((r (itable-run t)))
        (when (eq? how 'severed) (intercept-audio-stop!))
        (when (and (eq? how 'held) (> (run-score r) (or (itable-best t) -1)))
          (record-best! t (run-score r)))
        (*say* "intercept end" how "score" (run-score r)
               "acc" (/ (round (* 10.0 (run-accuracy r))) 10.0)
               "max-combo" (run-max-combo r)
               "counts" (list-ref (run-counts r) 0) (list-ref (run-counts r) 1)
               (list-ref (run-counts r) 2) (list-ref (run-counts r) 3))
        (itable t phase: 'results over: how over-wall: wall)))

    ;; --- results ------------------------------------------------------------------------
    (define RESULTS-WAIT-MS 600)   ; a press still ringing from the song does not choose

    (define (step-results t f)
      (let ((wall (intercept-frame-wall f)))
        (if (< (- wall (itable-over-wall t)) RESULTS-WAIT-MS)
            t
            (let ((choice (or (let ((ks (intercept-frame-keys f)))
                                (cond ((or (memq 'return ks) (memq 'space ks) (memq 'r ks)) 'retry)
                                      ((memq 'escape ks) 'songs)
                                      (else #f)))
                              (let tap-loop ((taps (intercept-frame-taps f)))
                                (and (pair? taps)
                                     (or (hit (intercept-results-rows) (car (car taps)) (cadr (car taps)))
                                         (tap-loop (cdr taps))))))))
              (case choice
                ((retry) (intercept-audio-stop!) (begin-song t wall))
                ((songs) (intercept-audio-stop!) (itable t phase: 'select))
                (else t))))))

    (define (intercept-step t f)
      (let ((t (itable t requests: '())))
        (case (itable-phase t)
          ((select) (step-select t f))
          ((loading) (step-loading t f))
          ((play) (step-play t f))
          ((calibrate) (step-calibrate t f))
          (else (step-results t f)))))))
