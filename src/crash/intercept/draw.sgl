;;; (crash intercept draw) - Drawing INTERCEPT
;;;
;;; The wire in Crash's look (style bible §1: C-WIRE-DARK lanes lit
;;; C-WIRE-LIT, packets hot or cold and nothing else): the left hand's
;;; packets are cold (the beat), the right hand's hot (the tune). The
;;; packets fall onto a hit line above the keycaps (keyboard) or above
;;; four wide pads for the thumbs (touch).
;;;
;;; Feedback is visual only (David's ruling f: "just good visual
;;; feedback"), and immediate, drawn the frame the press is judged: the
;;; lane glows on any press; a hit flashes a bar in the judgment's color
;;; across the lane at the hit line and throws the judgment's word up the
;;; lane; a DROP flashes C-TRACE-HOT; the combo sits in the middle of the
;;; wire and flares on every hit.
;;;
;;; Nothing here reads input, a platform or a clock: the wall ms comes in.

(define-library (crash intercept draw)
  (import (sigil math)
          (sigil list)
          (sigil string)
          (sigil graphics)
          (crash palette)
          (crash font)
          (crash atlas)
          (only (crash render) draw-board-background)
          (crash intercept chart)
          (crash intercept rules)
          (crash intercept table))

  (export draw-intercept lane-rect intercept-layout)

  (begin
    (define (text! text x y scale)
      (if (atlas-on?) (atlas-text text x y scale) (draw-text text x y scale)))
    (define (text-center! text cx y scale)
      (text! text (- cx (quotient (text-width text scale) 2)) y scale))

    ;; --- the layout -------------------------------------------------------------
    ;; (x0 lane-w hand-gap top hit-y) for a lane count on keys or touch.
    (define KEY-LANE-W 48)
    (define HAND-GAP 16)
    (define LANE-TOP 30)   ; under the transmission bar and, on a phone, SIGNAL
    (define (intercept-layout lanes touch?)
      (if touch?
          (list 0 160 0 LANE-TOP 262)
          (let ((w (+ (* lanes KEY-LANE-W) HAND-GAP)))
            (list (quotient (- 640 w) 2) KEY-LANE-W HAND-GAP LANE-TOP 312))))

    ;; A lane's column: (x y w h), from the top of the wire to the hit line.
    (define (lane-rect lanes touch? lane)
      (let* ((l (intercept-layout lanes touch?))
             (x0 (list-ref l 0)) (w (list-ref l 1)) (gap (list-ref l 2))
             (top (list-ref l 3)) (hit-y (list-ref l 4)))
        (list (+ x0 (* lane w) (if (>= lane (quotient lanes 2)) gap 0))
              top w (- hit-y top))))

    (define (lane-cold? lanes lane) (< lane (quotient lanes 2)))

    (define (judgment-color j)
      (case j
        ((sync) C-LABEL-LIT)
        ((clean) C-SELECTED)
        ((lossy) C-TEXT-DIM)
        (else C-TRACE-HOT)))
    (define (judgment-word j)
      (case j ((sync) "SYNC") ((clean) "CLEAN") ((lossy) "LOSSY") (else "DROP")))

    (define (key-label k)
      (if (eq? k 'semicolon) ";" (string-upcase (symbol->string k))))

    ;; --- the wire ---------------------------------------------------------------
    (define FLASH-MS 140)
    (define HIT-FLASH-MS 220)
    (define WORD-MS 420)

    (define (age wall fl) (- wall (vector-ref fl 2)))

    (define (draw-lanes t wall)
      (let* ((lanes (intercept-lanes t))
             (touch? (intercept-touch? t))
             (hit-y (list-ref (intercept-layout lanes touch?) 4)))
        (let loop ((lane 0))
          (when (< lane lanes)
            (let* ((r (lane-rect lanes touch? lane))
                   (x (list-ref r 0)) (y (list-ref r 1)) (w (list-ref r 2)) (h (list-ref r 3)))
              (color-alpha! C-BG 0.9)   ; the lanes' band, strongly darkened over the field (t-15acbf)
              (draw-filled-rect x y w (+ h 4))
              (color! C-BAR-A)
              (draw-filled-rect x y 1 h)
              (draw-filled-rect (+ x w -1) y 1 h)
              (color! C-WIRE-DARK)
              (draw-filled-rect (+ x (quotient w 2)) y 1 h)
              ;; a press glows the lane, fading
              (for-each (lambda (fl)
                          (when (and (= lane (vector-ref fl 1)) (< (age wall fl) FLASH-MS))
                            (color-alpha! C-WIRE-LIT (* 0.28 (- 1.0 (/ (age wall fl) (* 1.0 FLASH-MS)))))
                            (draw-filled-rect x y w h)))
                        (intercept-flashes t))
              ;; the receiver on the hit line
              (color! C-TEXT-DIM)
              (draw-filled-rect (+ x 3) hit-y (- w 6) 2)
              (color! C-TEXT)
              (draw-filled-rect (+ x 3) (- hit-y 3) 2 8)
              (draw-filled-rect (+ x w -5) (- hit-y 3) 2 8))
            (loop (+ lane 1))))))

    ;; The first note that can still be on screen (ms >= now - window), by bisection.
    (define (first-visible chart ms)
      (let loop ((lo 0) (hi (vector-length chart)))
        (if (>= lo hi)
            lo
            (let ((mid (quotient (+ lo hi) 2)))
              (if (< (vector-ref (vector-ref chart mid) 0) ms)
                  (loop (+ mid 1) hi)
                  (loop lo mid))))))

    (define NOTE-H 10)

    (define (draw-notes t)
      (let* ((chart (intercept-chart t))
             (r (intercept-run t))
             (now (intercept-now t))
             (fall (* 1.0 (intercept-fall-ms t)))
             (lanes (intercept-lanes t))
             (touch? (intercept-touch? t))
             (l (intercept-layout lanes touch?))
             (top (list-ref l 3))
             (hit-y (list-ref l 4)))
        (let loop ((i (first-visible chart (- now LOSSY-MS))))
          (when (< i (vector-length chart))
            (let* ((note (vector-ref chart i))
                   (ms (vector-ref note 0)))
              (when (<= ms (+ now fall))
                (unless (run-judgment r i)
                  (let* ((lane (vector-ref note 1))
                         (rect (lane-rect lanes touch? lane))
                         (y (exact (round (- hit-y (* (- hit-y top) (/ (- ms now) fall)) (quotient NOTE-H 2)))))
                         (x (+ (list-ref rect 0) 4))
                         (w (- (list-ref rect 2) 8)))
                    (when (>= y (- top NOTE-H))
                      (color! (if (lane-cold? lanes lane) C-COLD C-HOT))
                      (draw-filled-rect x y w NOTE-H)
                      (color! C-FACE-EDGE)
                      (draw-filled-rect x y w 1)
                      (color! C-SIDE-DARK)
                      (draw-filled-rect x (+ y NOTE-H -2) w 2))))
                (loop (+ i 1))))))))

    (define (draw-hits t wall)
      (let* ((lanes (intercept-lanes t))
             (touch? (intercept-touch? t))
             (hit-y (list-ref (intercept-layout lanes touch?) 4))
             (shown '()))
        (for-each (lambda (fl)
                    (let* ((kind (vector-ref fl 0))
                           (lane (vector-ref fl 1))
                           (a (age wall fl))
                           (r (lane-rect lanes touch? lane))
                           (x (list-ref r 0)) (w (list-ref r 2)))
                      (when (memq kind '(hit drop))
                        (let ((j (if (eq? kind 'hit) (vector-ref fl 3) 'drop)))
                          ;; the burst at the hit line
                          (when (< a HIT-FLASH-MS)
                            (let* ((k (- 1.0 (/ a (* 1.0 HIT-FLASH-MS))))
                                   (grow (exact (round (* 10 (- 1.0 k))))))
                              (color-alpha! (judgment-color j) (* 0.9 k))
                              (draw-filled-rect (- x grow -2) (- hit-y 5 grow) (+ w (* 2 grow) -4) (+ 12 (* 2 grow)))))
                          ;; the word, newest per lane only
                          (when (and (< a WORD-MS) (not (memv lane shown)))
                            (set! shown (cons lane shown))
                            (color! (judgment-color j))
                            (let ((word (judgment-word j))
                                  (rise (exact (floor (/ (* 14 a) WORD-MS)))))   ; a is a float on the web (now-ms)
                              (text-center! word (+ x (quotient w 2)) (- hit-y 28 rise)
                                            (if (and touch? (> w 100)) 2 1))))))))
                  (intercept-flashes t))))

    (define (draw-caps t wall)
      (let* ((lanes (intercept-lanes t))
             (touch? (intercept-touch? t))
             (hit-y (list-ref (intercept-layout lanes touch?) 4))
             (keys (chart-keys (intercept-difficulty t))))
        (let loop ((lane 0) (ks keys))
          (when (< lane lanes)
            (let* ((r (lane-rect lanes touch? lane))
                   (x (list-ref r 0)) (w (list-ref r 2))
                   (lit (list-find (lambda (fl) (and (= lane (vector-ref fl 1)) (< (age wall fl) FLASH-MS)))
                                   (intercept-flashes t))))
              (if touch?
                  ;; a pad for a thumb, from under the hit line to the bottom
                  (let ((y (+ hit-y 12)) (h (- 400 hit-y 16)))
                    (color-alpha! (if lit C-WIRE-LIT C-BAR-B) (if lit 0.45 0.55))
                    (draw-filled-rect (+ x 4) y (- w 8) h)
                    (color! (if (lane-cold? lanes lane) C-COLD C-HOT))
                    (draw-filled-rect (+ x 4) y (- w 8) 2))
                  (let ((y (+ hit-y 8)))
                    (color! (if lit C-WIRE-LIT C-BAR-C))
                    (draw-filled-rect (+ x 4) y (- w 8) 24)
                    (color! (if (lane-cold? lanes lane) C-COLD C-HOT))
                    (draw-filled-rect (+ x 4) (+ y 22) (- w 8) 2)
                    (color! (if lit C-BG C-TEXT))
                    (text-center! (key-label (car ks)) (+ x (quotient w 2)) (+ y 5) 2))))
            (loop (+ lane 1) (cdr ks))))))

    ;; SIGNAL: a bar of width w at (x, y), its label left of it.
    (define (signal-bar t x y w)
      (let* ((r (intercept-run t))
             (s (run-signal r))
             (fill (quotient (* w s) SIGNAL-MAX)))
        (color! C-BAR-B)
        (draw-filled-rect x y w 5)
        (color! (if (< s 25) C-TRACE-HOT C-TRACE))
        (draw-filled-rect x y fill 5)
        (color! C-TEXT-DIM)
        (text! "SIGNAL" (- x 42) (- y 1) 1)))

    ;; The transmission (David, 2026-09-28: "I have no idea when the song is
    ;; going to stop"): a bar across the top that fills as the song plays,
    ;; to its last note; a tick at every pattern change and a taller one
    ;; where a marked section (calm, fill, tense) starts; CAPTURE counts the
    ;; packets caught of the song's total. When the last note is judged and
    ;; the link held, the bar turns C-LABEL-LIT and the wire says so.
    (define PROGRESS-Y 14)
    (define (draw-progress t)
      (let* ((r (intercept-run t))
             (now (max 0.0 (intercept-now t)))
             (end (max 1.0 (intercept-last-note-ms t)))
             (x-of (lambda (ms) (max 0 (min 640 (exact (round (* 640 (/ ms end))))))))
             (done? (and (run-done? r) (not (run-failed? r))))
             (c (run-counts r))
             (caught (+ (list-ref c 0) (list-ref c 1) (list-ref c 2))))
        (color! C-BAR-B)
        (draw-filled-rect 0 PROGRESS-Y 640 3)
        (color! (if done? C-LABEL-LIT C-WIRE-LIT))
        (draw-filled-rect 0 PROGRESS-Y (x-of now) 3)
        (for-each (lambda (s)
                    (when (< (car s) end)
                      (if (cdr s)
                          (begin (color! C-TEXT) (draw-filled-rect (x-of (car s)) (- PROGRESS-Y 3) 1 9))
                          (begin (color! C-TEXT-DIM) (draw-filled-rect (x-of (car s)) (- PROGRESS-Y 1) 1 5)))))
                  (intercept-sections t))
        (color! (if done? C-LABEL-LIT C-TEXT-DIM))
        (text-center! (string-append "CAPTURE " (number->string caught) "/" (number->string (vector-length (intercept-chart t))))
                      320 3 1)))

    (define (draw-hud t wall)
      (let* ((r (intercept-run t))
             (song (intercept-song t))
             (touch? (intercept-touch? t))
             (now (intercept-now t)))
        (color! C-TEXT-DIM)
        ;; the pause button, top left (the tap target is the table's PAUSE-RECT)
        (color! C-BAR-C)
        (draw-filled-rect 4 2 22 14)
        (color! C-TEXT)
        (draw-filled-rect 11 5 3 8)
        (draw-filled-rect 17 5 3 8)
        (color! C-TEXT-DIM)
        (text! (string-append (cadr song) "  " (difficulty-name (intercept-difficulty t))) 34 5 1)
        (color! C-TEXT)
        (let ((s (number->string (run-score r))))
          (text! s (- 632 (text-width s 1)) 3 1))
        (draw-progress t)
        ;; SIGNAL: under the transmission on a phone (the bottom is the
        ;; thumbs'), under the keycaps on a keyboard
        (if touch?
            (signal-bar t 60 21 520)
            (signal-bar t 170 382 300))
        ;; the combo, flaring on a hit
        (when (>= (run-combo r) 4)
          (let* ((last-hit (list-find (lambda (fl) (eq? (vector-ref fl 0) 'hit)) (intercept-flashes t)))
                 (flare (and last-hit (< (age wall last-hit) 120)))
                 (c (number->string (run-combo r)))
                 (cy (if touch? 110 130)))
            (color-alpha! (if flare C-FACE-EDGE C-TEXT) (if flare 1.0 0.7))
            (text-center! c 320 cy 4)
            (color! (case (run-multiplier r) ((4) C-LABEL-LIT) ((3) C-HIGHLIGHT) ((2) C-SELECTED) (else C-TEXT-DIM)))
            (text-center! (string-append "COMBO X" (number->string (run-multiplier r))) 320 (+ cy 34) 1)))
        ;; the transmission caught: the moment the last note is judged with the link held
        (when (and (run-done? r) (not (run-failed? r)))
          (color! (if (even? (quotient (exact (floor (max 0.0 now))) 250)) C-LABEL-LIT C-FACE-EDGE))   ; song ms: an epoch-sized exact wraps on wasm
          (text-center! "TRANSMISSION" 320 176 3)
          (text-center! "INTERCEPTED" 320 204 3))
        ;; the count-in
        (when (< now 0.0)
          (color! C-LABEL-LIT)
          (text-center! "INCOMING" 320 150 3)
          (color! C-TEXT)
          (text-center! (number->string (+ 1 (exact (floor (/ (- now) 1000.0))))) 320 180 3))))

    (define (draw-play t wall)
      (draw-lanes t wall)
      (draw-notes t)
      (draw-caps t wall)
      (draw-hits t wall)
      (draw-hud t wall))

    ;; --- the select screen ---------------------------------------------------------
    (define (row-rect t id)
      (list-find (lambda (r) (equal? (car r) id)) (intercept-select-rows t)))

    (define (m-ss ms)
      (let* ((s (exact (round (/ ms 1000.0))))
             (sec (modulo s 60)))
        (string-append (number->string (quotient s 60)) ":" (if (< sec 10) "0" "") (number->string sec))))

    ;; a small chevron centered at (cx, y), pointing up or down
    (define (chevron cx y up?)
      (let loop ((k 0))
        (when (< k 3)
          (draw-filled-rect (- cx k) (if up? (+ y k) (- (+ y 2) k)) (+ 1 (* 2 k)) 1)
          (loop (+ k 1)))))

    (define (draw-select t wall)
      (let* ((focus (intercept-focus t))
             (touch? (intercept-touch? t))
             (songs (intercept-songs))
             (n (length songs))
             (first (intercept-list-first t))
             (chosen-i (let loop2 ((s2 songs) (k 0)) (if (eq? (car (car s2)) (car (intercept-song t))) k (loop2 (cdr s2) (+ k 1))))))
        (color! C-LABEL-LIT)
        (text-center! "INTERCEPT" 320 36 3)
        (color! C-TEXT-DIM)
        (text-center! "CATCH THE TRAFFIC ON THE WIRE" 320 66 1)
        ;; the visible window of the list (it scrolls: t-f04480), where it sits in
        ;; the whole list, and chevrons where more songs wait above or below
        (for-each
         (lambda (r)
           (let* ((i (car r))
                  (s (list-ref songs i))
                  (x (list-ref r 1)) (y (list-ref r 2)) (w (list-ref r 3)) (h (list-ref r 4))
                  (chosen (= i chosen-i)))
             (when chosen
               (color-alpha! C-SELECTED 0.18)
               (draw-filled-rect x y w h))
             (when (= focus i)
               (color! C-SELECTED)
               (draw-filled-rect x y 2 h))
             (color! (if chosen C-TEXT C-TEXT-DIM))
             (text! (cadr s) (+ x 10) (+ y 3) 2)
             (color! C-TEXT-DIM)
             (let ((bpm (string-append (number->string (caddr s)) " BPM")))
               (text! bpm (- (+ x w) 10 (text-width bpm 1)) (+ y 7) 1))))
         (filter (lambda (r) (and (integer? (car r)) (< (car r) ROW-DIFFICULTY))) (intercept-select-rows t)))
        (color! C-TEXT-DIM)
        (let ((pos (string-append (number->string (+ chosen-i 1)) "/" (number->string n))))
          (text! pos (- ROW-X 8 (text-width pos 1)) 99 1))
        (when (> first 0) (chevron 320 88 #t))
        (when (< (+ first VISIBLE) n) (chevron 320 207 #f))
        (let ((row (lambda (id label value)
                     (let* ((r (row-rect t id))
                            (x (list-ref r 1)) (y (list-ref r 2)) (w (list-ref r 3)) (h (list-ref r 4)))
                       (when (= focus id)
                         (color! C-SELECTED)
                         (draw-filled-rect x y 2 h))
                       (color! C-TEXT-DIM)
                       (text! label (+ x 10) (+ y 4) 2)
                       (color! C-TEXT)
                       (let ((v (string-append "< " value " >")))
                         (text! v (- (+ x w) 10 (text-width v 2)) (+ y 4) 2))))))
          (row ROW-DIFFICULTY "DIFFICULTY" (difficulty-name (intercept-difficulty t)))
          (row ROW-OFFSET "OFFSET" (let ((o (intercept-offset t)))
                                     (string-append (if (> o 0) "+" "") (number->string o) " MS")))
          ;; CALIBRATE: tap along to the kick and OFFSET is set from the taps
          (let* ((r (row-rect t ROW-CALIBRATE)) (x (list-ref r 1)) (y (list-ref r 2)) (w (list-ref r 3)) (h (list-ref r 4)))
            (when (= focus ROW-CALIBRATE)
              (color! C-SELECTED)
              (draw-filled-rect x y 2 h))
            (color! C-TEXT-DIM)
            (text! "CALIBRATE" (+ x 10) (+ y 3) 2)
            (text! "TAP ALONG TO THE KICK" (- (+ x w) 10 (text-width "TAP ALONG TO THE KICK" 1)) (+ y 6) 1)))
        (let* ((r (row-rect t 'play)) (x (list-ref r 1)) (y (list-ref r 2)) (w (list-ref r 3)) (h (list-ref r 4)))
          (color! C-SELECTED)
          (draw-filled-rect x y w h)
          (color! C-BG)
          (text-center! (if (eq? (intercept-phase t) 'loading) "SYNCING" "PLAY") (+ x (quotient w 2)) (+ y 7) 2))
        (when (intercept-message t)   ; the text never came, or would not read
          (color! C-TRACE-HOT)
          (text-center! (intercept-message t) 320 322 1))
        (let* ((r (row-rect t 'back)) (x (list-ref r 1)) (y (list-ref r 2)) (w (list-ref r 3)) (h (list-ref r 4)))
          (color! C-BAR-C)
          (draw-filled-rect x y w h)
          (color! C-TEXT)
          (text-center! "MENU" (+ x (quotient w 2)) (+ y 7) 1))
        (let* ((d (intercept-difficulty t))
               (keys (chart-keys d))
               (lanes-line (if touch?
                               "FOUR PADS: TAP AS PACKETS HIT THE LINE"
                               (string-append "FOUR LANES: "
                                              (apply string-append (map (lambda (k) (string-append (key-label k) " ")) keys))))))
          (color! C-TEXT-DIM)
          (text-center! lanes-line 320 334 1)
          (text-center! (if touch? "TAP A SONG, THEN TAP IT AGAIN TO PLAY" "UP DOWN SONG  LEFT RIGHT DIFFICULTY  TAB SETTINGS  ENTER PLAYS") 320 350 1))))

    ;; --- results -------------------------------------------------------------------------
    (define (draw-results t wall)
      (let* ((r (intercept-run t))
             (held? (eq? (intercept-over t) 'held))
             (c (run-counts r))
             (x 150) (y 70) (w 340) (h 290)
             (best (intercept-best t)))
        (color-alpha! C-BG 0.92)
        (draw-filled-rect x y w h)
        (color! C-BAR-C)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (color! (if held? C-LABEL-LIT C-TRACE-HOT))
        (text-center! (if held? "INTERCEPTED" "LINK SEVERED") 320 (+ y 14) 3)
        (color! C-TEXT-DIM)
        (text-center! (string-append (cadr (intercept-song t)) "  " (difficulty-name (intercept-difficulty t))) 320 (+ y 44) 1)
        (let ((line (lambda (i label value col)
                      (color! C-TEXT-DIM)
                      (text! label (+ x 30) (+ y 64 (* i 18)) 2)
                      (color! col)
                      (text! value (- (+ x w) 30 (text-width value 2)) (+ y 64 (* i 18)) 2))))
          (line 0 "SCORE" (number->string (run-score r)) C-TEXT)
          (line 1 "ACCURACY" (let ((a (/ (round (* 10.0 (run-accuracy r))) 10.0))) (number->string a)) C-TEXT)
          (line 2 "GRADE" (if held? (run-grade r) "-") C-LABEL-LIT)
          (line 3 "SYNC" (number->string (list-ref c 0)) C-LABEL-LIT)
          (line 4 "CLEAN" (number->string (list-ref c 1)) C-SELECTED)
          (line 5 "LOSSY" (number->string (list-ref c 2)) C-TEXT-DIM)
          (line 6 "DROP" (number->string (list-ref c 3)) C-TRACE-HOT)
          (line 7 "MAX COMBO" (number->string (run-max-combo r)) C-TEXT))
        (color! C-TEXT-DIM)
        (text-center! (cond ((not held?) "THE WIRE DROPPED YOU")
                            ((or (not best) (> (run-score r) best)) "NEW BEST")
                            (else (string-append "BEST " (number->string best))))
                      320 (+ y 214) 1)
        (for-each (lambda (b)
                    (let ((bx (list-ref b 1)) (by (list-ref b 2)) (bw (list-ref b 3)) (bh (list-ref b 4)))
                      (color! (if (eq? (car b) 'retry) C-SELECTED C-BAR-C))
                      (draw-filled-rect bx by bw bh)
                      (color! (if (eq? (car b) 'retry) C-BG C-TEXT))
                      (text-center! (if (eq? (car b) 'retry) "RETRY" "SONGS") (+ bx (quotient bw 2)) (+ by 7) 2)))
                  (intercept-results-rows))))

    ;; CALIBRATE: nothing falls (a picture would pull the taps toward it);
    ;; the words, the taps counted, and a pad glow so a tap is seen to land.
    (define (draw-calibrate t wall)
      (let* ((taps (length (intercept-taps t)))
             (n (max 0 (- taps 1)))   ; the first tap starts the count
             (lit (list-find (lambda (fl) (< (age wall fl) FLASH-MS)) (intercept-flashes t))))
        (color! C-LABEL-LIT)
        (text-center! "CALIBRATE" 320 60 3)
        (color! C-BAR-C)   ; the way out, top left, as in play
        (draw-filled-rect 4 2 22 14)
        (color! C-TEXT)
        (draw-filled-rect 11 5 3 8)
        (draw-filled-rect 17 5 3 8)
        (color! C-TEXT)
        (text-center! "TAP ON EVERY CLICK YOU HEAR" 320 110 2)
        (color! C-TEXT-DIM)
        (text-center! (if (intercept-touch? t) "ANY PAD" "D F J OR K") 320 136 1)
        (text-center! (if (= taps 0) "THE FIRST TAP STARTS IT" "KEEP TAPPING") 320 150 1)
        (text-center! (if (intercept-touch? t) "PAUSE, TOP LEFT, LEAVES" "ESC LEAVES") 320 350 1)
        ;; the tap count only: no picture of the click (it would pull the taps toward it)
        (color! (if lit C-WIRE-LIT C-BAR-C))
        (draw-filled-rect 220 190 200 60)
        (color! (if lit C-BG C-TEXT))
        (text-center! (string-append (number->string (min n CALIBRATE-TAPS)) " / " (number->string CALIBRATE-TAPS)) 320 212 2)))

    ;; PAUSED: the wire dimmed under the panel's three choices.
    (define (draw-paused t)
      (color-alpha! C-BG 0.8)
      (draw-filled-rect 0 0 640 400)
      (color! C-LABEL-LIT)
      (text-center! "PAUSED" 320 100 3)
      (for-each (lambda (b)
                  (let ((x (list-ref b 1)) (y (list-ref b 2)) (w (list-ref b 3)) (h (list-ref b 4)))
                    (color! (if (eq? (car b) 'resume) C-SELECTED C-BAR-C))
                    (draw-filled-rect x y w h)
                    (color! (if (eq? (car b) 'resume) C-BG C-TEXT))
                    (text-center! (case (car b) ((resume) "RESUME") ((retry) "RETRY") (else "SONGS"))
                                  (+ x (quotient w 2)) (+ y 9) 2)))
                (intercept-pause-rows)))

    ;; --- the field behind the wire (t-15acbf, David 2026-09-29) ------------------------
    ;; Crash's living field plays behind INTERCEPT, dimmed and grayed so the
    ;; packets stay the brightest thing on screen, lifting on every beat of the
    ;; song (from the song clock and its BPM: the soundtrack starts on a beat),
    ;; still through the select screen and the lead-in. The shell steps it and
    ;; bursts it at the song's marked sections; the lanes keep a strongly
    ;; darkened band. #f bg: BACKGROUND OFF (motion sensitivity).
    (define (beat-pulse t)
      (let ((now (intercept-now t)))
        (if (and now (> now 0) (eq? (intercept-phase t) 'play))
            (let* ((b (/ 60000.0 (caddr (intercept-song t))))
                   (p (- 1.0 (/ (- now (* b (floor (/ now b)))) b))))
              (* p p p))
            0.0)))
    (define (draw-veil vw vh pulse)
      (color-alpha! C-STATIC-B 0.25)
      (draw-filled-rect 0 0 vw vh)
      (color-alpha! C-BG (- 0.62 (* 0.18 pulse)))
      (draw-filled-rect 0 0 vw vh))

    (define (draw-intercept t vw vh bg copper wall)
      (draw-board-background vw vh vh 0.0 bg copper)
      (when bg (draw-veil vw vh (beat-pulse t)))
      (case (intercept-phase t)
        ((select loading) (draw-select t wall))
        ((calibrate) (draw-calibrate t wall))
        ((paused) (draw-play t wall) (draw-paused t))
        ((play) (draw-play t wall))
        (else (draw-play t wall) (draw-results t wall))))))
