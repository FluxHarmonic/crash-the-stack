;;; (crash shell web) - The browser shell.
;;;
;;; The same game as (crash shell native), driven the way a browser drives
;;; things: the generic loader (sigil-web-app.js, from sigil-wasm-runtime)
;;; forwards DOM keydown/keyup by key name and a pointerdown on the canvas
;;; as canvas-buffer pixels, and the gles3 app shell dispatches
;;; ("frame", ms) once per requestAnimationFrame. Every one of those arrives
;;; here through (crash main)'s sigil-web-dispatch-event, and each frame this
;;; shell folds what arrived into one input-frame, steps the session, and
;;; draws it, exactly as the native shell does with sigil-app's polled state.
;;;
;;; The frame loop is inverted (one tick per dispatch) rather than a
;;; coroutine that wait-frames, because the browser already hands us one
;;; frame at a time; there is nothing to suspend. (sigil coroutines) itself
;;; does work under native-codegen wasm as of sigil 0.22.1: measured
;;; 2026-09-17, the stdlib's doubler example returned 10 and 42 from the web
;;; build; Cinder's July finding that reset/shift trapped there is stale.
;;;
;;; What the browser cannot give the game: ctrl chords (the loader drops any
;;; keydown with ctrlKey, and Chrome reserves ctrl+n / ctrl+t). The commands
;;; are on the canvas instead, drawn by (crash render) in the HUD and
;;; hit-tested by (crash input) from the same rects, so a tap on them takes
;;; the pointer path like a tap on a tile; the page keeps only its
;;; fullscreen button (David, 2026-09-17: the controls belong in the game's
;;; own UI). Tab, Backspace and the tag letters still arrive as keys. The
;;; test-tile toggle (ctrl+t) has no browser path. Escape does nothing
;;; here; there is no window to close.
;;;
;;; Trace lines, printed only when the page was opened with ?trace (the
;;; page dispatches ("trace", "on") as soon as the loader is up; verify.mjs
;;; relies on them, a player never sees them):
;;;   crash: seed S tiles N pair A AX AY B BX BY   the first solution pair
;;;                                         and its centers in virtual pixels
;;;   crash: labels A TA B TB              the same pair's hint-mode tags
;;;   crash: tags shown|hidden touch on|off fresh on|off   the boot's inputs
;;;   crash: update waiting|prompt|apply   the web build's waiting update, as
;;;                                         the game shows it (ruling D14)
;;;   crash: control apply X Y             the prompt's APPLY box (with later, update)
;;;   crash: control NAME X Y              the centre of each HUD control
;;;   crash: select N                      a tile was selected
;;;   crash: deselect                      the selection was cleared by a pick
;;;   crash: undo tiles N                  an undo put tiles back
;;;   crash: shuffle                       the board was shuffled
;;;   crash: removed A B tiles N           a pair left the board
;;;   crash: unlock A B                    a locked pair's first match
;;;   crash: lock A B                      the ICE locked a pair
;;;   crash: remap                         the ICE re-dealt the stack
;;;   crash: ice nothing                   an interval with nothing to hit
;;;   crash: trace V H S PHASE ICE         the meter after a hint, a shuffle, a
;;;                                         phase change or a counter-hack: value,
;;;                                         hints, shuffles, phase, counter-hacks fired
;;;   crash: restored tiles N trace V phase P ice K locked A B ...   a saved
;;;                                         board came back at boot (verify.mjs's
;;;                                         reload sub-arm)
;;;   crash: tile missing after N fetches   the test tile never landed; the
;;;                                         flat renderer stands in
;;;
;;;   crash: cards seed S moves N draw D    the card table booted (with ?cards)
;;;   crash: cards stock X Y                the stock's center
;;;   crash: cards first SX SY DX DY        the first legal move's source and
;;;                                         destination centers, or "first none"
;;;   crash: cards tags TS TD               the same move's source and destination tags
;;;   crash: cards probe hint SRC DST        PROBE showed a move (its places' kinds)
;;;   crash: cards probe none                PROBE found no line (or lost the thread)
;;;   crash: cards restored moves N          ... from a saved deal
;;;   crash: cards select PLACE              a card was selected
;;;   crash: cards deselect
;;;   crash: cards moved N                   a move landed; N = the move count
;;;   crash: cards drew N                    a draw; N = cards in the waste
;;;   crash: cards undo N
;;;   crash: cards ice NAME                  a counter-hack landed (encrypt corrupt churn nothing)
;;;   crash: cards trace V MODE PHASE ICE LAST   the meter after a phase or mode change,
;;;                                         a counter-hack, or a charge
;;;   crash: cards scramble N                a scramble was used; N left in the bank
;;;   crash: cards tagsshown on|off touch on|off   the deal's tag state at boot
;;;   crash: cards auto                      auto-complete armed (every tableau card up)
;;;   crash: cards won moves N
;;;
;;; The board is saved to localStorage after every change ((crash store),
;;; (crash shell)) and restored at boot; ?fresh deals seed 1 instead.
;;; The game opens on the menu (STACK / CARDS / CONTINUE / UPDATE, P2);
;;; ?stack and ?cards go straight to a table (the arms' doors). The card
;;; table has its own saved deal. ?seed=N starts a fresh deal or board
;;; from N (with ?fresh, or when nothing is saved). The MENU control in
;;; either HUD, ctrl+e, or a severed stack's JACK OUT come back to the
;;; menu; the table stays in memory meanwhile. The menu's UPDATE entry
;;; applies a waiting version the way the in-game prompt does: the page
;;; polls ("update", "chosen?") and the dispatch answers 1 once APPLY was
;;; taken.
;;;   crash: menu ID X Y ...                the menu's entries and their centers
;;;   crash: menu chose ID

(define-library (crash shell web)
  (import (sigil struct)
          (sigil math)
          (sigil string)
          (sigil graphics)
          (sigil graphics image)
          (sigil browser gles3)
          (crash stack layout)
          (crash stack turtle)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash trace)
          (crash save)
          (crash tween)
          (crash fx)
          (crash render)
          (crash cards rules)
          (crash cards geometry)
          (crash cards input)
          (crash cards render)
          (crash cards fx)
          (crash menu)
          (crash shell))

  (export web-main web-dispatch)

  (begin
    ;; --- state between dispatches ------------------------------------------
    (define *session* #f)
    (define *geom* #f)
    (define *fx* #f)         ; the effects and their clock, (crash fx)
    (define *last-ms* #f)    ; the previous frame's requestAnimationFrame timestamp
    (define *keys* '())      ; key symbols currently held (sigil-app's names)
    (define *pressed* '())   ; keys that went down since the last frame
    (define *click* #f)      ; (x . y) in virtual pixels, or #f
    (define *tile-fetch* 0)  ; gles3 image handle for the test tile, 0 = not asked yet
    (define *tile-tries* 0)  ; fetches started for it, TILE-TRIES at most
    (define *tile-wait* 0.0) ; seconds the current fetch has been pending
    (define *texture* #f)    ; the decoded test tile, once ready
    (define *trace* #f)      ; print the trace lines above
    (define *restored* #f)   ; the boot restored a saved board
    (define *fresh* #f)      ; ?fresh: ignore the saved board
    (define *touch* #f)      ; the page reports a touch screen: fresh boards start with tags hidden
    (define *announced* #f)  ; the boot lines have been printed for this deal
    (define *booted* #f)     ; a table has been booted (on the first frame)
    (define *screen* 'menu)  ; menu | stack | cards
    (define *menu* #f)       ; the first screen, (crash menu)
    (define *update* #f)     ; waiting | prompt | #f: the page's word on a new version
    (define *update-chosen* #f) ; the player took APPLY; the page's poll reads it
    (define *cards* #f)      ; ?cards: straight to the card table
    (define *stack* #f)      ; ?stack: straight to the stack
    (define *seed* #f)       ; ?seed=N: the raw seed a fresh deal or board starts from; none given: the tables' own first ones
    (define *deal* #f)       ; the card table's deal, (crash cards input)
    (define *card-geom* #f)
    (define *card-fx* #f)    ; the card table's effects and clock, (crash cards fx)

    ;; --- keys ----------------------------------------------------------------

    ;; DOM KeyboardEvent.key -> the symbol sigil-app would report, so
    ;; (crash input) sees one vocabulary on both targets. Anything else
    ;; becomes a symbol nobody listens to.
    (define (dom-key->sym k)
      (cond ((string=? k "ArrowLeft") 'left)
            ((string=? k "ArrowRight") 'right)
            ((string=? k "ArrowUp") 'up)
            ((string=? k "ArrowDown") 'down)
            ((string=? k " ") 'space)
            ((string=? k "Enter") 'return)
            ((string=? k "Backspace") 'backspace)
            ((string=? k "Tab") 'tab)
            ((string=? k "Escape") 'escape)
            ((string=? k "Shift") 'shift)
            ((string=? k "Control") 'ctrl)
            ((string=? k "Alt") 'alt)
            ((= (string-length k) 1) (string->symbol (string-downcase k)))
            (else (string->symbol k))))

    (define (key-down! k)
      (let ((sym (dom-key->sym k)))
        ;; A held key repeats keydown in the DOM; only the first counts
        ;; as pressed, matching sigil-app's edge semantics.
        (unless (memq sym *keys*)
          (set! *keys* (cons sym *keys*))
          (set! *pressed* (cons sym *pressed*)))))

    (define (key-up! k)
      (let ((sym (dom-key->sym k)))
        (set! *keys* (filter (lambda (x) (not (eq? x sym)))
                             *keys*))))

    ;; --- pointer -------------------------------------------------------------

    ;; "x,y,mods" from the loader: canvas-buffer pixels (the loader applies
    ;; the CSS to buffer scale; the letterbox inverse is the same one native
    ;; uses) and a modifier bitmask the game does not read (the web's
    ;; commands are on the canvas, not on chords).
    (define (pointer-down! payload)
      (let ((parts (string-split payload ",")))
        (when (= (length parts) 3)
          (let ((x (string->number (car parts)))
                (y (string->number (cadr parts))))
            (when (and x y)
              (set! *click* (frame->virtual (gles3-canvas-width)
                                            (gles3-canvas-height)
                                            VW
                                            VH
                                            x
                                            y)))))))

    ;; --- the test tile, fetched by JS, decoded here once it lands ---------

    ;; The tile is optional (the primitives renderer is the fallback), so
    ;; it is fetched on demand, from the first stack frame that wants the
    ;; texture render mode, rather than from web-main: a fetch pending
    ;; while the page's service worker activates over the boot's first
    ;; frames failed under load ("Failed to fetch", measured 2026-09-18 in
    ;; headless Chrome, 7 of 24 arm runs; the retry a second later always
    ;; landed). A fetch that has not landed after TILE-RETRY-AFTER seconds
    ;; is asked for again, TILE-TRIES times in all; then the tile is given
    ;; up with one trace line and the mode stays flat. (Today the texture
    ;; mode's only toggle is ctrl+t, which has no browser path, so no web
    ;; session asks for the tile; the fetch waits for the day one does.)
    (define TILE-RETRY-AFTER 1.0)
    (define TILE-TRIES 2)

    (define (fetch-tile!)
      (set! *tile-fetch* (gles3-fetch-image TEST-TILE-PATH))
      (set! *tile-tries* (+ *tile-tries* 1))
      (set! *tile-wait* 0.0))

    (define (ensure-texture! dt)
      (cond (*texture* #f)
            ((> *tile-tries* TILE-TRIES) #f)
            ((and (= *tile-fetch* 0)
                  (not (eq? (session-render-mode *session*) 'texture)))
             #f)
            ((= *tile-fetch* 0) (fetch-tile!))
            ((gles3-image-ready? *tile-fetch*)
             (let ((img (load-image-from-memory (gles3-image-ptr *tile-fetch*)
                                                (gles3-image-size *tile-fetch*))))
               (when img
                 (set! *texture* (load-texture img))
                 (image-free! img))))
            (else
             (set! *tile-wait* (+ *tile-wait* dt))
             (when (> *tile-wait* TILE-RETRY-AFTER)
               (if (< *tile-tries* TILE-TRIES)
                   (fetch-tile!)
                   (begin
                     (say "tile" "missing" "after" *tile-tries* "fetches")
                     (set! *tile-tries* (+ *tile-tries* 1))))))))

    ;; --- trace lines ---------------------------------------------------------

    ;; The loader's WASI shim logs every fd_write as its own console entry,
    ;; so the line is built first (str) and written once; println's newline
    ;; is a second, empty entry, which nothing reads.
    (define (say . parts)
      (when *trace*
        (println "~a" (apply str "crash:" (map (lambda (p) (str " " p)) parts)))))

    ;; The meter's line, whenever a hint, a shuffle or the lock moved it.
    (define (report-trace! before after)
      (let ((t0 (session-trace before))
            (t1 (session-trace after)))
        (when (or (not (= (trace-hints t0) (trace-hints t1)))
                  (not (= (trace-shuffles t0) (trace-shuffles t1)))
                  (not (eq? (trace-phase t0) (trace-phase t1)))
                  (not (= (trace-ice-count t0) (trace-ice-count t1))))
          (say "trace"
               (exact (floor (trace-value t1)))
               (trace-hints t1)
               (trace-shuffles t1)
               (trace-phase t1)
               (trace-ice-count t1)))))

    ;; What changed between two sessions, as one line, or nothing. A new
    ;; deal is reported by say-first-pair instead (web-tick checks the seed).
    ;; A shuffle and the lock can land in one frame (the shuffle's cost
    ;; crosses the threshold), so the lock is reported on its own after.
    (define (report-change! before after)
      (let* ((b0 (session-board before))
             (b1 (session-board after))
             (n0 (board-tile-count b0))
             (n1 (board-tile-count b1))
             (h0 (length (board-history b0)))
             (h1 (length (board-history b1)))
             (t0 (session-trace before))
             (t1 (session-trace after)))
        (cond ((not (= (session-seed before) (session-seed after))) #f)
              ;; a counter-hack: it cut the history, so it is read off the
              ;; trace, not the board
              ((not (= (trace-ice-count t0) (trace-ice-count t1)))
               (case (trace-last-ice t1)
                 ((lock) (report-lock! b0 b1))
                 ((remap) (say "remap"))
                 (else (say "ice" "nothing"))))
              ((< n1 n0)
               ;; Two tiles left: the selected one and the one just picked.
               (let ((gone (filter (lambda (id)
                                     (and (tile-present? b0 id)
                                          (not (tile-present? b1 id))))
                                   (iota (layout-slot-count (board-layout b0))))))
                 (apply say "removed" (append gone (list "tiles" n1)))))
              ;; Same tiles, shorter history: an undo, whatever it put back;
              ;; longer history with the same tiles: a shuffle (faces moved),
              ;; a lock (more locked tiles) or an unlock (fewer).
              ((< h1 h0) (say "undo" "tiles" n1))
              ((and (> h1 h0)
                    (not (equal? (vector->list (board-faces b0))
                                 (vector->list (board-faces b1)))))
               (say "shuffle")
               (report-lock! b0 b1))
              ((> h1 h0)
               (let ((l0 (board-locked-slots b0))
                     (l1 (board-locked-slots b1)))
                 (if (> (length l1) (length l0))
                     (report-lock! b0 b1)
                     (apply say "unlock" (filter (lambda (id) (not (memv id l1))) l0)))))
              ((and (board-selected b1)
                    (not (eqv? (board-selected b0) (board-selected b1))))
               (say "select" (board-selected b1)))
              ((and (board-selected b0)
                    (not (board-selected b1)))
               (say "deselect")))))

    (define (report-lock! b0 b1)
      (let ((l0 (board-locked-slots b0))
            (l1 (board-locked-slots b1)))
        (when (> (length l1) (length l0))
          (apply say "lock" (filter (lambda (id) (not (memv id l0))) l1)))))

    ;; A slot's hint-mode tag, from the session's own table.
    (define (slot-tag s id)
      (let ((entry (assv id (session-labels s))))
        (if entry (cdr entry) "-")))

    (define (say-first-pair s)
      (let ((sol (board-solution (session-board s))))
        (if (null? sol)
            (say "seed" (session-seed s) "tiles" (board-tile-count (session-board s)) "pair none")
            (let* ((a (car (car sol)))
                   (b (cdr (car sol)))
                   (ca (slot-centre *geom* a))
                   (cb (slot-centre *geom* b)))
              (say "seed" (session-seed s)
                   "tiles" (board-tile-count (session-board s))
                   "pair" a (car ca) (cdr ca)
                   b (car cb) (cdr cb))
              (say "labels" a (slot-tag s a) b (slot-tag s b))))
        (say "tags"
             (if (session-labels-shown s) "shown" "hidden")
             "touch" (if *touch* "on" "off")
             "fresh" (if *fresh* "on" "off"))
        (for-each (lambda (c)
                    (say "control"
                         (car c)
                         (+ (cadr c) (half (cadddr c)))
                         (+ (caddr c) (half (list-ref c 4)))))
                  (append (geometry-controls *geom*) (update-controls *geom*)))))

    ;; What changed on the card table between two deals, as one line.
    (define (report-deal-change! before after)
      (let* ((g0 (deal-game before))
             (g1 (deal-game after))
             (m0 (game-moves g0))
             (m1 (game-moves g1))
             (h0 (length (game-history g0)))
             (h1 (length (game-history g1))))
        (cond ((and (deal-hint after) (not (deal-hint before)))
               (say "cards" "probe" "hint" (car (car (deal-hint after))) (car (cadr (deal-hint after)))))
              ((and (deal-probe-running? before) (not (deal-probe-running? after)) (not (deal-hint after)))
               (say "cards" "probe" "none"))
              ((eq? g0 g1) #f)
              ((not (= (deal-seed before) (deal-seed after)))
               (set! *announced* #f)
               (set! *restored* #f))
              ((not (= (trace-ice-count (deal-trace before)) (trace-ice-count (deal-trace after))))
               (say "cards" "ice" (or (trace-last-ice (deal-trace after)) 'nothing)))
              ((< (deal-scrambles after) (deal-scrambles before))
               (say "cards" "scramble" (deal-scrambles after)))
              ((game-won? g1) (say "cards" "won" "moves" m1))
              ((and (deal-auto after) (not (deal-auto before))) (say "cards" "auto"))
              ((< h1 h0) (say "cards" "undo" m1))
              ((> (length (game-waste g1)) (length (game-waste g0)))
               (say "cards" "drew" (length (game-waste g1))))
              ((> m1 m0) (say "cards" "moved" m1))
              ((and (game-selected g1)
                    (not (equal? (game-selected g0) (game-selected g1))))
               (apply say "cards" "select" (game-selected g1)))
              ((and (game-selected g0) (not (game-selected g1)))
               (say "cards" "deselect")))))

    ;; The card table's meter line, whenever its phase, mode or ICE count
    ;; moved, or the game charged it (a pass, an undo).
    (define (report-deal-trace! before after)
      (let ((t0 (deal-trace before))
            (t1 (deal-trace after)))
        (when (or (not (eq? (trace-phase t0) (trace-phase t1)))
                  (not (eq? (trace-mode t0) (trace-mode t1)))
                  (not (= (trace-ice-count t0) (trace-ice-count t1)))
                  (not (= (trace-extra t0) (trace-extra t1))))
          (say "cards" "trace"
               (exact (floor (trace-value t1)))
               (trace-mode t1)
               (trace-phase t1)
               (trace-ice-count t1)
               (or (trace-last-ice t1) 'none)))))

    (define (say-deal d)
      (let* ((g (deal-game d))
             (moves (legal-moves g)))
        (say "cards" "seed" (deal-seed d)
             "moves" (game-moves g)
             "draw" (game-draw g))
        (let ((stock (place-center *card-geom* g '(stock))))
          (say "cards" "stock" (car stock) (cdr stock)))
        (if (null? moves)
            (say "cards" "first" "none")
            (let* ((src (place-center *card-geom* g (car (car moves))))
                   (dst (place-center *card-geom* g (cdr (car moves))))
                   (tag (lambda (p)
                          (let ((entry (find (lambda (e) (equal? (car e) p)) (deal-labels d))))
                            (if entry (cdr entry) "-"))))
                   (dst-place (let ((p (cdr (car moves))))
                                (if (and (eq? (car p) 'pile) (pair? (game-pile g (cadr p))))
                                    (list 'pile (cadr p) 0)
                                    p))))
              (say "cards" "first" (car src) (cdr src) (car dst) (cdr dst))
              (say "cards" "tags" (tag (car (car moves))) (tag dst-place)))))
      (when *restored*
        (say "cards" "restored" "moves" (game-moves (deal-game d))))
      (when (deal-auto d)
        (say "cards" "auto"))
      (say "cards" "tagsshown" (if (deal-labels-shown d) "on" "off")
           "touch" (if *touch* "on" "off"))
      (for-each (lambda (c)
                  (say "control"
                       (car c)
                       (+ (cadr c) (half (cadddr c)))
                       (+ (caddr c) (half (list-ref c 4)))))
                (card-controls *card-geom*)))

    ;; --- one frame -----------------------------------------------------------

    ;; Keys that went down since the last frame are kept newest first;
    ;; they are handed over oldest first, so two tag letters landing in
    ;; one slow frame still spell their tag in the order they were typed
    ;; (measured 2026-09-17: under load "dr" arrived as "rd" and picked
    ;; nothing).
    (define (input-this-frame)
      (let ((f (make-input-frame (reverse *pressed*)
                                 (filter (lambda (k) (memq k MODIFIERS))
                                         *keys*)
                                 *click*)))
        (set! *pressed* '())
        (set! *click* #f)
        f))

    ;; The frame's wall dt in seconds from the rAF timestamp (ms): the
    ;; fixed clock in (crash fx) turns it into ticks. The first frame, and
    ;; a frame after a payload that is not a number, count as no time.
    (define (frame-dt payload)
      (let* ((ms (string->number payload))
             (dt (if (and ms *last-ms*)
                     (/ (- ms *last-ms*) 1000.0)
                     0.0)))
        (when ms (set! *last-ms* ms))
        dt))

    ;; A running PROBE gets PROBE-FRAME-MS of this frame, one position at
    ;; a time, so a hard position never stalls the table (the solver runs
    ;; at a few ms per position in this build; see the evidence note).
    (define PROBE-FRAME-MS 6)

    (define (probe-work d)
      (let ((t0 (current-milliseconds)))
        (let loop ((d d))
          (if (and (deal-probe-running? d)
                   (< (- (current-milliseconds) t0) PROBE-FRAME-MS))
              (loop (deal-probe-step d))
              d))))

    (define (cards-tick f dt)
      (when (and *trace* (not *announced*))
        (say-deal *deal*)
        (set! *announced* #t))
      (let* ((before *deal*)
             (x (card-fx-frame *card-fx* dt *card-geom*))
             (after (save-deal-after-frame!
                      before
                      (probe-work
                        (deal-advance (deal-step before f *card-geom*)
                                      (clock-steps (card-fx-clock x))))))
             (x (card-fx-observe x before after *card-geom*)))
        (set! *deal* after)
        (set! *card-fx* x)
        (report-deal-change! before after)
        (report-deal-trace! before after)
        (begin-frame)
        (draw-deal after *card-geom* x)
        (end-frame)))

    (define (stack-tick f dt)
      ;; The boot lines wait for trace to be switched on, and repeat after
      ;; a new deal.
      (when (and *trace* (not *announced*))
        (say-first-pair *session*)
        (when *restored*
          (let ((b (session-board *session*)))
            (apply say "restored"
                   "tiles" (board-tile-count b)
                   "trace" (exact (floor (trace-value (session-trace *session*))))
                   "phase" (trace-phase (session-trace *session*))
                   "ice" (trace-ice-count (session-trace *session*))
                   "locked" (board-locked-slots b))))
        (set! *announced* #t))
      (let* ((before *session*)
             (x (fx-frame *fx* dt))
             (after (save-after-frame!
                      before
                      (session-advance (session-step before f *geom*)
                                       (clock-steps (fx-clock x)))))
             (x (fx-observe x before after *geom*)))
        (set! *session* after)
        (set! *fx* x)
        (unless (eq? (session-update before) (session-update after))
          (say "update" (session-update after))
          (when (eq? (session-update after) 'apply) (update-chosen!)))
        (report-change! before after)
        (report-trace! before after)
        (when (not (= (session-seed before) (session-seed after)))
          (set! *announced* #f))
        (begin-frame)
        (draw-session after *geom* *texture* x)
        (end-frame)
        (ensure-texture! dt)))

    ;; The menu's boot line: each shown entry with its center.
    (define (say-menu m)
      (apply say "menu"
             (let loop ((ids (menu-entries m)) (i 0) (acc '()))
               (if (null? ids)
                   (reverse acc)
                   (let ((r (menu-entry-rect i VW VH)))
                     (loop (cdr ids)
                           (+ i 1)
                           (cons (+ (cadr r) (half (cadddr r)))
                                 (cons (+ (car r) (half (caddr r)))
                                       (cons (car ids) acc)))))))))

    ;; A choice opens its table and draws it this same frame (with an
    ;; empty input frame), so no frame goes undrawn.
    (define (menu-tick f dt)
      (when (and *trace* (not *announced*))
        (say-menu *menu*)
        (set! *announced* #t))
      (let ((r (menu-step *menu* f VW VH)))
        (set! *menu* (car r))
        (when (cdr r)
          (say "menu" "chose" (cdr r))
          (choose! (cdr r)))
        (if (eq? *screen* 'menu)
            (begin
              (begin-frame)
              (draw-menu *menu* VW VH #f)
              (end-frame))
            (tick-screen (make-input-frame '() '() #f) dt))))

    (define (web-tick dt)
      (unless *booted* (boot!))
      (gles3-resize-to-display)
      (tick-screen (input-this-frame) dt))

    (define (tick-screen f dt)
      (let ((click (input-frame-click f)))
        (case *screen*
          ((menu) (menu-tick f dt))
          ((stack)
           (cond ((or (menu-frame? f (and click (hit-control *geom* (car click) (cdr click))))
                      (jack-out? *session* f VW VH (geometry-hud-h *geom*)))
                  (open-menu!))
                 (else (stack-tick f dt))))
          (else
           (if (or (menu-frame? f (and click (hit-card-control *card-geom* (car click) (cdr click))))
                   (jack-out-tap? *deal* f *card-geom*))
               (open-menu!)
               (cards-tick f dt))))))

    ;; --- entry ---------------------------------------------------------------

    ;; Boot the table the page asked for: the card table with ?cards, else
    ;; the stack. Called on the first frame rather than from web-main: the
    ;; page's parameters (?cards, ?fresh, ?seed, the touch flag, the update
    ;; state) are dispatched once the loader is up, which is after web-main
    ;; returns (sigil_wasm_start) and before the first frame, so booting
    ;; here sees every one of them.
    (define (open-menu!)
      (set! *screen* 'menu)
      (set! *announced* #f)
      (set! *menu* (launch-menu (and *update* #t)
                                (and (case (active-game)
                                       ((stack) *session*)
                                       ((cards) *deal*)
                                       (else #f))
                                     #t))))

    ;; The stack. CONTINUE (resume?) returns to the table in memory, or
    ;; the saved one; STACK deals a NEW board: the next seed after the
    ;; one in memory or in the store, else ?seed (David, 2026-09-18:
    ;; going "fresh" into a game put him back in the previous one, trace
    ;; and all).
    (define (open-stack! resume?)
      (set! *screen* 'stack)
      (set! *announced* #f)
      (let ((lay (turtle-layout)))
        (unless *geom* (set! *geom* (make-geometry lay VW VH)))
        (unless (and resume? *session*)
          (let* ((booted (boot-session lay *seed* *fresh*))
                 (s (cond (resume? (car booted))
                          (*session* (session-next *session*))
                          ((cdr booted) (session-next (car booted)))
                          (else (car booted)))))
            (set! *session* (if *touch* (session s labels-shown: #f) s))
            (set! *restored* (and resume? (cdr booted)))
            (set! *fx* (fx-new))))))

    (define (open-cards! resume?)
      (set! *screen* 'cards)
      (set! *announced* #f)
      (unless *card-geom* (set! *card-geom* (make-card-geometry VW VH)))
      (unless (and resume? *deal*)
        (let* ((booted (boot-deal *seed* *fresh*))
               (d (cond (resume? (car booted))
                        (*deal* (deal-next *deal*))
                        ((cdr booted) (deal-next (car booted)))
                        (else (car booted)))))
          (set! *deal* (if *touch* (deal d labels-shown: #f) d))
          (set! *restored* (and resume? (cdr booted)))
          (set! *card-fx* (card-fx-new)))))

    ;; The update's state reaches the stack's session (the game draws it
    ;; and takes the choice, (crash input) step-update) and the menu (its
    ;; UPDATE entry); when it lands before the first frame, boot! calls
    ;; this again once the table is up. Reported for the arm.
    (define (update! state)
      (set! *update* state)
      (when *session*
        (set! *session* (session-with-update *session* state))
        (say "update" state))
      (when (and *booted* (eq? *screen* 'menu)) (open-menu!))
      0)

    ;; The player's APPLY: the page polls ("update", "chosen?") and reads
    ;; the answer from the dispatch's return value (1 once chosen; the
    ;; loader hands a handler's integer back to the page since sigil 0.22.2).
    (define (update-chosen!)
      (set! *update-chosen* #t))

    ;; A menu choice. UPDATE applies the waiting version the same way the
    ;; in-game prompt does.
    (define (choose! choice)
      (let* ((resume? (eq? choice 'continue))
             (id (if resume? (active-game) choice)))
        (case id
          ((stack) (set-active-game! 'stack) (open-stack! resume?))
          ((cards) (set-active-game! 'cards) (open-cards! resume?))
          ((update) (update-chosen!))
          (else #f))))

    ;; ?stack and ?cards open their table as CONTINUE would (the saved
    ;; game, or a fresh one), which is what the arms and a bookmark want.
    (define (boot!)
      (set! *session* #f)
      (set! *deal* #f)
      (set! *booted* #t)
      (cond (*cards* (open-cards! #t))
            (*stack* (open-stack! #t))
            (else (open-menu!)))
      ;; the page's update word lands before the first frame, ahead of
      ;; any session: the table takes it here, once
      (when *update* (update! *update*)))

    ;; A page parameter landed (before the first frame; see open-menu!).
    (define (param! setter)
      (setter)
      0)

    (define (web-main)
      (unless (gles3-use-canvas "#stage")
        (error "crash web: no WebGL2 context for #stage. This browser has WebGL2 off or unavailable (Chrome: chrome://gpu, or Settings > System > graphics acceleration)."))
      (gles3-resize-to-display)
      (gfx-setup)
      (set-viewport VW VH)
      (set-letterbox-color 0.0 0.0 0.0)
      ;; The callback name is only used by the bytecode eval path; native
      ;; builds get a ("frame", ms) dispatch instead, which lands in web-dispatch.
      (gles3-start-loop "crash-web-tick")
      0)

    (define (web-dispatch type payload)
      (cond ((string=? type "frame") (web-tick (frame-dt payload)) 0)
            ((string=? type "keydown") (key-down! payload) 0)
            ((string=? type "keyup") (key-up! payload) 0)
            ((string=? type "pointerdown") (pointer-down! payload) 0)
            ((string=? type "trace") (set! *trace* (string=? payload "on")) 0)
            ((string=? type "fresh") (param! (lambda () (set! *fresh* (string=? payload "on")))))
            ((string=? type "cards") (param! (lambda () (set! *cards* (string=? payload "on")))))
            ((string=? type "stack") (param! (lambda () (set! *stack* (string=? payload "on")))))
            ((string=? type "update")
             (cond ((string=? payload "waiting") (update! 'waiting))
                   ((string=? payload "prompt") (update! 'prompt))
                   ((string=? payload "chosen?") (if *update-chosen* 1 0))
                   (else 0)))
            ((string=? type "seed")
             (param! (lambda ()
                       (let ((n (string->number payload)))
                         (when (and n (exact? n) (integer? n) (>= n 0)) (set! *seed* n))))))
            ((string=? type "touch") (param! (lambda () (set! *touch* (string=? payload "on")))))
            (else 0)))))
