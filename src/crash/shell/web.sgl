;;; (crash shell web) - The browser shell.
;;;
;;; The same game as (crash shell native), driven the way a browser drives
;;; things: the generic loader (sigil-web-app.js, from sigil-wasm-runtime)
;;; forwards DOM keydown/keyup by key name, the page template forwards
;;; pointerdown as canvas-buffer pixels, and the gles3 app shell dispatches
;;; ("frame", ms) once per requestAnimationFrame. Every one of those arrives
;;; here through (crash main)'s sigil-web-dispatch-event, and each frame this
;;; shell folds what arrived into one input-frame, steps the session, and
;;; draws it, exactly as the native shell does with sigil-app's polled state.
;;;
;;; The frame loop is inverted (one tick per dispatch) rather than a
;;; coroutine that wait-frames, because the browser already hands us one
;;; frame at a time; there is nothing to suspend. (sigil coroutines) itself
;;; does work under native-codegen wasm as of sigil 0.22.1: measured
;;; 2026-09-17, the stdlib's doubler example returned 10 and 42 from the web
;;; build; Cinder's July finding that reset/shift trapped there is stale. A
;;; top-level define inside cond-expand still is not registered (measured the
;;; same day: "call: not a procedure"), which is why (crash main) is shaped
;;; the way it is.
;;;
;;; What the browser cannot give the game: ctrl chords (the loader drops any
;;; keydown with ctrlKey, and Chrome reserves ctrl+n / ctrl+t). The commands
;;; are on the canvas instead, drawn by (crash render) in the HUD and
;;; hit-tested by (crash input) from the same rects, so a tap on them takes
;;; the pointer path like a tap on a tile; the page keeps only its
;;; fullscreen button (David, 2026-09-17: the controls belong in the game's
;;; own UI). Tab, Backspace and the tag letters still arrive as keys. The
;;; test-tile toggle (ctrl+t) has no browser path. Escape does nothing
;;; here; there is no window to close.
;;;
;;; Trace lines, printed only when the page was opened with ?trace (the
;;; template dispatches ("trace", "on") after boot; verify.mjs relies on
;;; them, a player never sees them):
;;;   crash: seed S pair A AX AY B BX BY   the first solution pair and its
;;;                                         centers in virtual pixels
;;;   crash: labels A TA B TB              the same pair's hint-mode tags
;;;   crash: control NAME X Y              the centre of each HUD control
;;;   crash: select N                      a tile was selected
;;;   crash: deselect                      the selection was cleared by a pick
;;;   crash: undo tiles N                  an undo put tiles back
;;;   crash: shuffle                       the board was shuffled
;;;   crash: removed A B tiles N           a pair left the board

(define-library (crash shell web)
  (import (sigil struct)
          (sigil math)
          (sigil string)
          (sigil graphics)
          (sigil graphics image)
          (sigil browser gles3)
          (crash stack layout)
          (crash stack turtle)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash fx)
          (crash render)
          (crash shell))

  (export web-main web-dispatch)

  (begin
    ;; --- state between dispatches ------------------------------------------
    (define *session* #f)
    (define *geom* #f)
    (define *fx* #f)         ; the effects and their clock, (crash fx)
    (define *last-ms* #f)    ; the previous frame's requestAnimationFrame timestamp
    (define *keys* '())      ; key symbols currently held (sigil-app's names)
    (define *pressed* '())   ; keys that went down since the last frame
    (define *click* #f)      ; (x . y) in virtual pixels, or #f
    (define *tile-fetch* 0)  ; gles3 image handle for the test tile, 0 = none
    (define *texture* #f)    ; the decoded test tile, once ready
    (define *trace* #f)      ; print the trace lines above
    (define *announced* #f)  ; the boot lines have been printed for this deal

    ;; --- keys ----------------------------------------------------------------

    ;; DOM KeyboardEvent.key -> the symbol sigil-app would report, so
    ;; (crash input) sees one vocabulary on both targets. Anything else
    ;; becomes a symbol nobody listens to.
    (define (dom-key->sym k)
      (cond ((string=? k "ArrowLeft") 'left)
            ((string=? k "ArrowRight") 'right)
            ((string=? k "ArrowUp") 'up)
            ((string=? k "ArrowDown") 'down)
            ((string=? k " ") 'space)
            ((string=? k "Enter") 'return)
            ((string=? k "Backspace") 'backspace)
            ((string=? k "Tab") 'tab)
            ((string=? k "Escape") 'escape)
            ((string=? k "Shift") 'shift)
            ((string=? k "Control") 'ctrl)
            ((string=? k "Alt") 'alt)
            ((= (string-length k) 1) (string->symbol (string-downcase k)))
            (else (string->symbol k))))

    (define (key-down! k)
      (let ((sym (dom-key->sym k)))
        ;; A held key repeats keydown in the DOM; only the first counts
        ;; as pressed, matching sigil-app's edge semantics.
        (unless (memq sym *keys*)
          (set! *keys* (cons sym *keys*))
          (set! *pressed* (cons sym *pressed*)))))

    (define (key-up! k)
      (let ((sym (dom-key->sym k)))
        (set! *keys* (filter (lambda (x) (not (eq? x sym)))
                             *keys*))))

    ;; --- pointer -------------------------------------------------------------

    ;; "bx,by" in canvas-buffer pixels (the template's job is the CSS to
    ;; buffer scale; the letterbox inverse is the same one native uses).
    (define (pointer-down! payload)
      (let ((parts (string-split payload ",")))
        (when (= (length parts) 2)
          (let ((x (string->number (car parts)))
                (y (string->number (cadr parts))))
            (when (and x y)
              (set! *click* (frame->virtual (gles3-canvas-width)
                                            (gles3-canvas-height)
                                            VW
                                            VH
                                            x
                                            y)))))))

    ;; --- the test tile, fetched by JS, decoded here once it lands ---------

    (define (ensure-texture!)
      (when (and (not *texture*)
                 (> *tile-fetch* 0)
                 (gles3-image-ready? *tile-fetch*))
        (let ((img (load-image-from-memory (gles3-image-ptr *tile-fetch*)
                                           (gles3-image-size *tile-fetch*))))
          (when img
            (set! *texture* (load-texture img))
            (image-free! img)))))

    ;; --- trace lines ---------------------------------------------------------

    ;; The loader's WASI shim logs every fd_write as its own console entry,
    ;; so the line is built first (str) and written once; println's newline
    ;; is a second, empty entry, which nothing reads.
    (define (say . parts)
      (when *trace*
        (println "~a" (apply str "crash:" (map (lambda (p) (str " " p)) parts)))))

    ;; What changed between two sessions, as one line, or nothing. A new
    ;; deal is reported by say-first-pair instead (web-tick checks the seed).
    (define (report-change! before after)
      (let* ((b0 (session-board before))
             (b1 (session-board after))
             (n0 (board-tile-count b0))
             (n1 (board-tile-count b1))
             (h0 (length (board-history b0)))
             (h1 (length (board-history b1))))
        (cond ((not (= (session-seed before) (session-seed after))) #f)
              ((< n1 n0)
               ;; Two tiles left: the selected one and the one just picked.
               (let ((gone (filter (lambda (id)
                                     (and (tile-present? b0 id)
                                          (not (tile-present? b1 id))))
                                   (iota (layout-slot-count (board-layout b0))))))
                 (apply say "removed" (append gone (list "tiles" n1)))))
              ;; Same tiles, shorter history: an undo, whatever it put back;
              ;; longer history with the same tiles: only a shuffle does that.
              ((< h1 h0) (say "undo" "tiles" n1))
              ((> h1 h0) (say "shuffle"))
              ((and (board-selected b1)
                    (not (eqv? (board-selected b0) (board-selected b1))))
               (say "select" (board-selected b1)))
              ((and (board-selected b0)
                    (not (board-selected b1)))
               (say "deselect")))))

    ;; A slot's hint-mode tag, from the session's own table.
    (define (slot-tag s id)
      (let ((entry (assv id (session-labels s))))
        (if entry (cdr entry) "-")))

    (define (say-first-pair s)
      (let ((sol (board-solution (session-board s))))
        (if (null? sol)
            (say "seed" (session-seed s) "pair none")
            (let* ((a (car (car sol)))
                   (b (cdr (car sol)))
                   (ca (slot-centre *geom* a))
                   (cb (slot-centre *geom* b)))
              (say "seed" (session-seed s)
                   "pair" a (car ca) (cdr ca)
                   b (car cb) (cdr cb))
              (say "labels" a (slot-tag s a) b (slot-tag s b))))
        (for-each (lambda (c)
                    (say "control"
                         (car c)
                         (+ (cadr c) (half (cadddr c)))
                         (+ (caddr c) (half (list-ref c 4)))))
                  (geometry-controls *geom*))))

    ;; --- one frame -----------------------------------------------------------

    (define (input-this-frame)
      (let ((f (make-input-frame *pressed*
                                 (filter (lambda (k) (memq k MODIFIERS))
                                         *keys*)
                                 *click*)))
        (set! *pressed* '())
        (set! *click* #f)
        f))

    ;; The frame's wall dt in seconds from the rAF timestamp (ms): the
    ;; fixed clock in (crash fx) turns it into ticks. The first frame, and
    ;; a frame after a payload that is not a number, count as no time.
    (define (frame-dt payload)
      (let* ((ms (string->number payload))
             (dt (if (and ms *last-ms*)
                     (/ (- ms *last-ms*) 1000.0)
                     0.0)))
        (when ms (set! *last-ms* ms))
        dt))

    (define (web-tick dt)
      (when *session*
        (gles3-resize-to-display)
        (ensure-texture!)
        ;; The boot lines wait for trace to be switched on, and repeat after
        ;; a new deal.
        (when (and *trace* (not *announced*))
          (say-first-pair *session*)
          (set! *announced* #t))
        (let* ((before *session*)
               (after (session-step before (input-this-frame) *geom*))
               (x (fx-observe (fx-frame *fx* dt) before after *geom*)))
          (set! *session* after)
          (set! *fx* x)
          (report-change! before after)
          (when (not (= (session-seed before) (session-seed after)))
            (set! *announced* #f))
          (begin-frame)
          (draw-session after *geom* *texture* x)
          (end-frame))))

    ;; --- entry ---------------------------------------------------------------

    (define (web-main)
      (unless (gles3-use-canvas "#stage")
        (error "crash web: no WebGL2 canvas #stage"))
      (gles3-resize-to-display)
      (gfx-setup)
      (set-viewport VW VH)
      (set-letterbox-color 0.0 0.0 0.0)
      (let ((lay (turtle-layout)))
        (set! *geom* (make-geometry lay VW VH))
        (set! *session* (session-new lay 1))
        (set! *fx* (fx-new)))
      (set! *tile-fetch* (gles3-fetch-image TEST-TILE-PATH))
      ;; The callback name is only used by the bytecode eval path; native
      ;; builds get a ("frame", ms) dispatch instead, which lands in web-dispatch.
      (gles3-start-loop "crash-web-tick")
      0)

    (define (web-dispatch type payload)
      (cond ((string=? type "frame") (web-tick (frame-dt payload)) 0)
            ((string=? type "keydown") (key-down! payload) 0)
            ((string=? type "keyup") (key-up! payload) 0)
            ((string=? type "pointerdown") (pointer-down! payload) 0)
            ((string=? type "trace") (set! *trace* (string=? payload "on")) 0)
            (else 0)))))
