;;; (crash shell web) - The browser shell.
;;;
;;; The same game as (crash shell native), driven the way a browser drives
;;; things: the generic loader (sigil-web-app.js, from sigil-wasm-runtime)
;;; forwards DOM keydown/keyup by key name and a pointerdown on the canvas
;;; as canvas-buffer pixels, and the gles3 app shell dispatches
;;; ("frame", ms) once per requestAnimationFrame. Every one of those arrives
;;; here through (crash main)'s sigil-web-dispatch-event, and each frame this
;;; shell folds what arrived into one input-frame, steps the session, and
;;; draws it, exactly as the native shell does with sigil-app's polled state.
;;;
;;; The frame loop is inverted (one tick per dispatch) rather than a
;;; coroutine that wait-frames, because the browser already hands us one
;;; frame at a time; there is nothing to suspend. (sigil coroutines) itself
;;; does work under native-codegen wasm as of sigil 0.22.1: measured
;;; 2026-09-17, the stdlib's doubler example returned 10 and 42 from the web
;;; build; Cinder's July finding that reset/shift trapped there is stale.
;;;
;;; What the browser cannot give the game: ctrl chords (the loader drops any
;;; keydown with ctrlKey, and Chrome reserves ctrl+n / ctrl+t). The commands
;;; are on the canvas instead, drawn by (crash render) in the HUD and
;;; hit-tested by (crash input) from the same rects, so a tap on them takes
;;; the pointer path like a tap on a tile; the page keeps only its
;;; fullscreen button (David, 2026-09-17: the controls belong in the game's
;;; own UI). Tab, Backspace and the tag letters still arrive as keys. The
;;; look switch (ctrl+t) has a tap on the TILES counter and the menu's LOOK
;;; entry as its browser paths (P3). Escape does nothing
;;; here; there is no window to close.
;;;
;;; Trace lines, printed only when the page was opened with ?trace (the
;;; page dispatches ("trace", "on") as soon as the loader is up; verify.mjs
;;; relies on them, a player never sees them):
;;;   crash: seed S tiles N pair A AX AY B BX BY   the first solution pair
;;;                                         and its centers in virtual pixels
;;;   crash: labels A TA B TB              the same pair's hint-mode tags
;;;   crash: tags shown|hidden touch on|off fresh on|off   the boot's inputs
;;;   crash: look NAME                     the look in force, at boot and after a step
;;;   crash: update waiting|prompt|apply   the web build's waiting update, as
;;;                                         the game shows it (ruling D14)
;;;   crash: control apply X Y             the prompt's APPLY box (with later, update)
;;;   crash: control NAME X Y              the center of each HUD control (mode look keys tool)
;;;   crash: tools open|closed             the tool stack (D33) opened or closed
;;;   crash: tool NAME X Y on|off          each entry's center while it opens
;;;   crash: hud zones|strip               the bar's layout at boot and after a HUD choice
;;;   crash: cards draw 1|3                the pull count flipped (the PULL tool)
;;;   crash: literal-check ok|FAILED ...   the quoted literals' shapes at boot
;;;   crash: select N                      a tile was selected
;;;   crash: deselect                      the selection was cleared by a pick
;;;   crash: undo tiles N                  an undo put tiles back
;;;   crash: shuffle                       the board was shuffled
;;;   crash: removed A B tiles N           a pair left the board
;;;   crash: unlock A B                    a locked pair's first match
;;;   crash: lock A B                      the ICE locked a pair
;;;   crash: remap                         the ICE re-dealt the stack
;;;   crash: scramble A B ...              the ICE scrambled these faces (P3)
;;;   crash: ice nothing                   an interval with nothing to hit
;;;   crash: trace V H S PHASE ICE         the meter after a hint, a shuffle, a
;;;                                         phase change or a counter-hack: value,
;;;                                         hints, shuffles, phase, counter-hacks fired
;;;   crash: restored tiles N trace V phase P ice K locked A B ...   a saved
;;;                                         board came back at boot (verify.mjs's
;;;                                         reload sub-arm)
;;;   crash: texture missing PATH after N fetches   a look's texture never
;;;                                         landed; the flat tile stands in
;;;
;;;   crash: cards seed S moves N draw D    the card table booted (with ?cards)
;;;   crash: cards stock X Y                the stock's center
;;;   crash: cards first SX SY DX DY        the first legal move's source and
;;;                                         destination centers, or "first none"
;;;   crash: cards tags TS TD               the same move's source and destination tags
;;;   crash: cards probe hint SRC DST        PROBE showed a move (its places' kinds)
;;;   crash: cards probe none                PROBE found no line (or lost the thread)
;;;   crash: cards restored moves N          ... from a saved deal
;;;   crash: cards select PLACE              a card was selected
;;;   crash: cards deselect
;;;   crash: cards moved N                   a move landed; N = the move count
;;;   crash: cards drew N                    a draw; N = cards in the waste
;;;   crash: cards undo N
;;;   crash: cards ice NAME                  a counter-hack landed (encrypt corrupt churn nothing)
;;;   crash: cards trace V MODE PHASE ICE LAST   the meter after a phase or mode change,
;;;                                         a counter-hack, or a charge
;;;   crash: cards scramble N                a scramble was used; N left in the bank
;;;   crash: cards tagsshown on|off touch on|off   the deal's tag state at boot
;;;   crash: cards auto                      auto-complete armed (every tableau card up)
;;;   crash: cards won moves N
;;;
;;; The board is saved to localStorage after every change ((crash store),
;;; (crash shell)) and restored at boot; ?fresh deals seed 1 instead.
;;; The game opens on the menu (STACK / CARDS / CONTINUE / UPDATE, P2);
;;; ?stack and ?cards go straight to a table (the arms' doors). The card
;;; table has its own saved deal. ?seed=N starts a fresh deal or board
;;; from N (with ?fresh, or when nothing is saved). The MENU control in
;;; either HUD, ctrl+e, or a severed stack's JACK OUT come back to the
;;; menu; the table stays in memory meanwhile. The menu's UPDATE entry
;;; applies a waiting version the way the in-game prompt does: the page
;;; polls ("update", "chosen?") and the dispatch answers 1 once APPLY was
;;; taken.
;;;   crash: menu ID X Y ...                the menu's entries and their centers
;;;   crash: menu chose ID

(define-library (crash shell web)
  (import (sigil struct)
          (sigil math)
          (sigil string)
          (sigil time)
          (sigil graphics)
          (sigil graphics image)
          (sigil browser gles3)
          (crash stack layout)
          (crash stack turtle)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash trace)
          (crash save)
          (crash tween)
          (crash fx)
          (crash render)
          (crash cards rules)
          (crash cards geometry)
          (crash cards input)
          (crash cards render)
          (crash cards fx)
          (crash menu)
          (crash look)
          (crash hud)
          (crash bg)
          (crash gpu bg)
          (crash gpu phosphor)
          (crash atlas)
          (sigil gc)
          (crash sfx)
          (crash audio)
          (crash shell))

  (export web-main web-dispatch)

  (begin
    ;; --- state between dispatches ------------------------------------------
    (define *session* #f)
    (define *geom* #f)
    (define *fx* #f)         ; the effects and their clock, (crash fx)
    (define *last-ms* #f)    ; the previous frame's requestAnimationFrame timestamp
    (define *keys* '())      ; key symbols currently held (sigil-app's names)
    (define *pressed* '())   ; keys that went down since the last frame
    (define *click* #f)      ; (x . y) in virtual pixels, or #f
    (define *textures* '())  ; loaded look textures by path, tex or #f once given up
    (define *tex-path* #f)   ; the path being fetched, or #f
    (define *tex-fetch* 0)   ; gles3 image handle of that fetch
    (define *tex-tries* 0)   ; fetches started for it, TEXTURE-TRIES at most
    (define *tex-wait* 0.0)  ; seconds the current fetch has been pending
    (define *trace* #f)      ; print the trace lines above
    (define *restored* #f)   ; the boot restored a saved board
    (define *fresh* #f)      ; ?fresh: ignore the saved board
    (define *touch* #f)      ; the page reports a touch screen: fresh boards start with tags hidden
    (define *hud* #f)        ; the bar's layout after a HUD choice or ?hud= (the store holds it)
    (define *version* #f)    ; the page's build stamp, for the menu's corner
    (define *announced* #f)  ; the boot lines have been printed for this deal
    (define *booted* #f)     ; a table has been booted (on the first frame)
    (define *screen* 'menu)  ; menu | stack | cards
    (define *menu* #f)       ; the first screen, (crash menu)
    (define *update* #f)     ; waiting | prompt | #f: the page's word on a new version
    (define *update-chosen* #f) ; the player took APPLY; the page's poll reads it
    (define *cards* #f)      ; ?cards: straight to the card table
    (define *stack* #f)      ; ?stack: straight to the stack
    (define *seed* #f)       ; ?seed=N: the raw seed a fresh deal or board starts from; none given: the tables' own first ones
    (define *deal* #f)       ; the card table's deal, (crash cards input)
    (define *card-geom* #f)
    (define *card-fx* #f)    ; the card table's effects and clock, (crash cards fx)
    (define *bg* #f)         ; the living background, (crash bg), stepped by whichever table is up
    (define *bg-mode* 'life) ; ?bg=reaction: the other rule; ?bg=life-cpu: the CPU field; ?bg=off: none
    (define *bg-hold* #f)    ; ?bghold=N: the field stops after N steps (the field leg's door)
    (define *bg-stride* #f)  ; ?bgstride=N: ticks between field steps (STRIDE by default; David's comparison door)
    (define *bg-rsteps* #f)  ; ?rsteps=N: Gray-Scott iterations per field step (REACT-STEPS by default)
    (define *bg-only* #f)    ; ?bgonly: draw the background alone, no table over it (the field leg reads every cell)
    (define *bg-said* #f)    ; the hold's line was said
    (define *copper* 'roll)  ; ?copper=always|off|bitmap; ?raster=N: the raster at a fixed roll N, split (the scanline leg)
    (define *phosphor* 'on)  ; ?phosphor=off|probe
    (define *demo* #f)       ; ?demo=cleared: the cleared sequence on demand, once, on whichever table opens (David's door)
    (define *demo-armed* #f) ; the stack's near-cleared board is in; the next tick finishes it
    (define *frame-n* 0)     ; frames presented (the probe alternates on it)
    (define *advance-ms* 0.0) ; the last frame's bg-advance time (the CPU field's step, the GPU field's bookkeeping)
    (define *frame-ms* 0.0)   ; the frame's wall dt, ms
    (define *ms* #f)         ; ?ms: the frame's wall dt in the corner, for the phone's frame cost
    (define *audio-ready* #f) ; the context and sink opened (audio-open!)
    (define *ambient-chunks* '()) ; the ambient PCM's decoded chunks, newest first
    (define *resumed* #f)    ; the context was seen running after a gesture (the line is said once)
    (define *ms-sum* 0.0)    ; and, with ?trace, a line every MS-EVERY frames: mean and max ms
    (define *ms-max* 0.0)
    (define *ms-n* 0)
    (define *ms-step* 0.0)   ; and the field's costs over the window: the step (bg-advance + the GPU passes) and the present
    (define *ms-present* 0.0)
    (define *gc-last* #f)     ; (minor major bytes) at the window's start
    ;; The frame's phases, wasm-side wall time from the jiffy clock (the
    ;; floor's anatomy, P3c): sim from the tick's start to present! (the
    ;; table's step, the effects, the saves, the trace lines), draw from
    ;; frame-begin! to end-frame (the field's passes, every draw call
    ;; queued into sokol_gp), flush the end-frame (sgp's flush: the GL
    ;; calls through the bridge and the commit). The menu has sim only.
    (define *tick-t0* 0.0)
    (define *sim-ms* 0.0)
    (define *draw-ms* 0.0)
    (define *flush-ms* 0.0)
    (define *ms-sim* 0.0)
    (define *ms-draw* 0.0)
    (define *ms-flush* 0.0)

    (define (now-ms) (/ (* 1000.0 (current-jiffy)) (jiffies-per-second)))
    (define MS-EVERY 300)
    ;;   crash: frame-ms MEAN MAX step MEAN present MEAN gc MINOR MAJOR alloc BYTES sim MEAN draw MEAN flush MEAN
    ;;                                        over the last MS-EVERY frames (?ms with
    ;;                                        ?trace), ms to a tenth; the GC's
    ;;                                        collections and bytes allocated in the window
    (define (count-frame! dt)
      (let ((ms (* 1000.0 dt)))
        (set! *ms-sum* (+ *ms-sum* ms))
        (set! *ms-max* (max *ms-max* ms))
        (set! *ms-n* (+ *ms-n* 1))
        (let ((gpu (gpu-bg-ms)))
          (set! *ms-step* (+ *ms-step* *advance-ms* (car gpu)))
          (set! *ms-present* (+ *ms-present* (cdr gpu))))
        (set! *ms-sim* (+ *ms-sim* *sim-ms*))
        (set! *ms-draw* (+ *ms-draw* *draw-ms*))
        (set! *ms-flush* (+ *ms-flush* *flush-ms*))
        (when (= *ms-n* MS-EVERY)
          (let* ((now (gc-snapshot))
                 (was (or *gc-last* now)))
            (say "frame-ms" (exact (round (/ *ms-sum* MS-EVERY))) (exact (round *ms-max*))
                 "step" (tenth (/ *ms-step* MS-EVERY)) "present" (tenth (/ *ms-present* MS-EVERY))
                 "gc" (- (car now) (car was)) (- (cadr now) (cadr was))
                 "alloc" (- (caddr now) (caddr was))
                 "sim" (tenth (/ *ms-sim* MS-EVERY)) "draw" (tenth (/ *ms-draw* MS-EVERY)) "flush" (tenth (/ *ms-flush* MS-EVERY)))
            (set! *ms-sim* 0.0)
            (set! *ms-draw* 0.0)
            (set! *ms-flush* 0.0)
            (set! *gc-last* now))
          (set! *ms-step* 0.0)
          (set! *ms-present* 0.0)
          (set! *ms-sum* 0.0)
          (set! *ms-max* 0.0)
          (set! *ms-n* 0))))

    (define (tenth x) (/ (round (* 10.0 x)) 10.0))

    ;; (minor major bytes-allocated) from (sigil gc); a runtime without
    ;; the stat answers zeros, so a window's delta reads 0.
    (define (gc-snapshot)
      (let* ((stats (guard (e (#t '())) (gc-stats)))
             (get (lambda (key) (let ((p (assq key stats))) (if p (cdr p) 0)))))
        (list (get 'minor-collections) (get 'major-collections) (get 'bytes-allocated))))

    ;; --- keys ----------------------------------------------------------------

    ;; DOM KeyboardEvent.key -> the symbol sigil-app would report, so
    ;; (crash input) sees one vocabulary on both targets. Anything else
    ;; becomes a symbol nobody listens to.
    (define (dom-key->sym k)
      (cond ((string=? k "ArrowLeft") 'left)
            ((string=? k "ArrowRight") 'right)
            ((string=? k "ArrowUp") 'up)
            ((string=? k "ArrowDown") 'down)
            ((string=? k " ") 'space)
            ((string=? k "Enter") 'return)
            ((string=? k "Backspace") 'backspace)
            ((string=? k "Tab") 'tab)
            ((string=? k "Escape") 'escape)
            ;; ? is shifted: its keyup can arrive as / once shift is up, so
            ;; both names are the one key (the keys line's toggle)
            ((string=? k "/") '?)
            ((string=? k "Shift") 'shift)
            ((string=? k "Control") 'ctrl)
            ((string=? k "Alt") 'alt)
            ((= (string-length k) 1) (string->symbol (string-downcase k)))
            (else (string->symbol k))))

    (define (key-down! k)
      (let ((sym (dom-key->sym k)))
        ;; A held key repeats keydown in the DOM; only the first counts
        ;; as pressed, matching sigil-app's edge semantics.
        (unless (memq sym *keys*)
          (set! *keys* (cons sym *keys*))
          (set! *pressed* (cons sym *pressed*)))))

    (define (key-up! k)
      (let ((sym (dom-key->sym k)))
        (set! *keys* (filter (lambda (x) (not (eq? x sym)))
                             *keys*))))

    ;; --- the sound (P3) ----------------------------------------------------------

    ;; The page fetches assets/audio/ambient.pcm (there is no bytes fetch
    ;; in the bridges the wasm has; the page has fetch) and hands it over
    ;; as ("audio-chunk", base64) dispatches, then ("audio-done", count).
    ;; Decoded here into one s16le bytevector and handed to the mixer.
    ;;   crash: audio open|closed             the context and sink at boot
    ;;   crash: audio resumed                 a gesture resumed the context (said once)
    ;;   crash: ambient FRAMES                the loop landed (frames at AMBIENT-RATE)
    ;; ("ambient", "off") drops the loop again: the browser arm's way to
    ;; hear a cue by itself.
    (define B64 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

    ;; code point -> value, a 128-entry table built once (1.1 MB of PCM is
    ;; 1.5 million characters; a scan per character would be seconds)
    (define B64-TABLE
      (let ((t (make-vector 128 #f)))
        (let loop ((i 0))
          (when (< i 64)
            (vector-set! t (char->integer (string-ref B64 i)) i)
            (loop (+ i 1))))
        t))

    (define (b64-value c)
      (let ((k (char->integer c)))
        (and (< k 128) (vector-ref B64-TABLE k))))

    ;; base64 text -> bytevector, exact to the padding. Indexed, not
    ;; listed: a chunk is 22 thousand characters and the page sends
    ;; seventy of them, one a frame; a string->list per chunk was the
    ;; garbage that made the decode a one-second stall (the review).
    (define (b64-decode text)
      (let* ((n (string-length text))
             (pads (cond ((and (>= n 2) (char=? (string-ref text (- n 1)) #\=) (char=? (string-ref text (- n 2)) #\=)) 2)
                         ((and (>= n 1) (char=? (string-ref text (- n 1)) #\=)) 1)
                         (else 0)))
             (out (make-bytevector (quotient (* (- n pads) 3) 4) 0)))
        (let loop ((i 0) (acc 0) (bits 0) (k 0))
          (if (= i n)
              out
              (let ((v (b64-value (string-ref text i))))
                (if (not v)
                    (loop (+ i 1) acc bits k)
                    (let ((acc (+ (* acc 64) v))
                          (bits (+ bits 6)))
                      (if (>= bits 8)
                          (let* ((bits (- bits 8))
                                 (byte (quotient acc (expt 2 bits))))
                            (when (< k (bytevector-length out))
                              (bytevector-u8-set! out k byte))
                            (loop (+ i 1) (- acc (* byte (expt 2 bits))) bits (+ k 1)))
                          (loop (+ i 1) acc bits k)))))))))

    ;; One chunk a frame, decoded as it lands, so the cost is spread over
    ;; the seconds the page takes to send them.
    (define (audio-chunk! payload)
      (set! *ambient-chunks* (cons (b64-decode payload) *ambient-chunks*))
      0)

    (define (audio-done! payload)
      (let ((bytes (apply bytevector-append (reverse *ambient-chunks*))))
        (set! *ambient-chunks* '())
        (audio-set-ambient! bytes AMBIENT-RATE)
        (say "ambient" (quotient (bytevector-length bytes) 2))
        0))

    ;; A user gesture (a pointer down, a key, the page's pointerup and
    ;; touchend and click): resume the context whenever it is not running.
    ;; Once is not enough: touch activation comes with pointerup, not
    ;; pointerdown; iOS suspends the context on lock and tab switch; a
    ;; keyboard-only player never taps (the slices 5-7 review).
    (define (gesture! payload)
      (when (and *audio-ready* (not (eq? (audio-state) 'running)))
        (audio-resume!))
      (when (and *audio-ready* (not *resumed*) (eq? (audio-state) 'running))
        (set! *resumed* #t)
        (say "audio" "resumed"))
      0)

    ;; --- pointer -------------------------------------------------------------

    ;; "x,y,mods" from the loader: canvas-buffer pixels (the loader applies
    ;; the CSS to buffer scale; the letterbox inverse is the same one native
    ;; uses) and a modifier bitmask the game does not read (the web's
    ;; commands are on the canvas, not on chords).
    (define (pointer-down! payload)
      (gesture! payload)
      (let ((parts (string-split payload ",")))
        (when (= (length parts) 3)
          (let ((x (string->number (car parts)))
                (y (string->number (cadr parts))))
            (when (and x y)
              (set! *click* (frame->virtual (gles3-canvas-width)
                                            (gles3-canvas-height)
                                            VW
                                            VH
                                            x
                                            y)))))))

    ;; --- textures, fetched by JS, decoded here once they land -------------

    ;; A look's texture is optional (the primitives tile is the fallback),
    ;; so it is fetched on demand, from the first stack frame that wants
    ;; it, rather than from web-main: a fetch pending while the page's
    ;; service worker activates over the boot's first frames failed under
    ;; load ("Failed to fetch", measured 2026-09-18 in headless Chrome, 7 of
    ;; 24 arm runs; the retry a second later always landed). One fetch is in
    ;; flight at a time (the look in force); one that has not landed after
    ;; TEXTURE-RETRY-AFTER seconds is asked for again, TEXTURE-TRIES times
    ;; in all, then that path is given up with one trace line and the flat
    ;; tile stands in. Loaded textures are kept by path: ((path . tex) ...),
    ;; tex #f for a path that was given up.
    ;;   crash: texture missing PATH after N fetches
    ;; No fetch starts in the boot's first TEXTURE-BOOT-DELAY seconds: that
    ;; is the window in which the page's service worker activates, and a
    ;; fetch pending across it fails under load (the finding above; the
    ;; card table wants its portraits from its first frame, so the
    ;; on-demand rule alone no longer keeps fetches out of the window).
    (define TEXTURE-RETRY-AFTER 1.0)
    (define TEXTURE-TRIES 2)
    (define TEXTURE-BOOT-DELAY 2.0)
    (define *since-boot* 0.0)

    (define (fetch-texture! path)
      (set! *tex-path* path)
      (set! *tex-fetch* (gles3-fetch-image path))
      (set! *tex-tries* (+ *tex-tries* 1))
      (set! *tex-wait* 0.0))

    (define (texture-loaded! path tex)
      (set! *textures* (cons (cons path tex) *textures*))
      (set! *tex-path* #f)
      (set! *tex-fetch* 0)
      (set! *tex-tries* 0))

    ;; The texture at a path: loaded, or #f (no path, pending, or given up).
    (define (texture-for-path path)
      (let ((entry (and path (assoc path *textures*))))
        (and entry (cdr entry))))

    ;; The texture for the session's look, or #f for a flat look.
    (define (texture-for s)
      (texture-for-path (look-texture (look-ref (session-look s)))))

    ;; Ask for the texture at want (a path or #f) unless it is loaded or
    ;; in flight; called once a frame by the screen that draws it.
    (define (ensure-texture! dt want)
      (cond (*tex-path*
             ;; a fetch in flight is serviced whatever is wanted now (the
             ;; look may have moved on): it lands or lapses on its own
             ;; clock, and the next frame asks for what is wanted then
             (ensure-fetch! dt))
            ((not want) #f)
            ((assoc want *textures*) #f)
            ((< *since-boot* TEXTURE-BOOT-DELAY) #f)
            (else (fetch-texture! want))))

    ;; The fetch in flight: decode it when it lands, retry or give it up.
    (define (ensure-fetch! dt)
      (cond ((gles3-image-ready? *tex-fetch*)
             (let ((img (load-image-from-memory (gles3-image-ptr *tex-fetch*)
                                                (gles3-image-size *tex-fetch*))))
               (if img
                   (let ((tex (load-texture img)))
                     (image-free! img)
                     (texture-loaded! *tex-path* tex))
                   (texture-loaded! *tex-path* #f))))
            (else
             (set! *tex-wait* (+ *tex-wait* dt))
             (when (> *tex-wait* TEXTURE-RETRY-AFTER)
               (if (< *tex-tries* TEXTURE-TRIES)
                   (fetch-texture! *tex-path*)
                   (begin
                     (say "texture" "missing" *tex-path* "after" *tex-tries* "fetches")
                     (texture-loaded! *tex-path* #f)))))))

    ;; --- trace lines ---------------------------------------------------------

    ;; The loader's WASI shim logs every fd_write as its own console entry,
    ;; so the line is built first (str) and written once; println's newline
    ;; is a second, empty entry, which nothing reads.
    (define (say . parts)
      (when *trace*
        (println "~a" (apply str "crash:" (map (lambda (p) (str " " p)) parts)))))

    ;; The meter's line, whenever a hint, a shuffle or the lock moved it.
    (define (report-trace! before after)
      (let ((t0 (session-trace before))
            (t1 (session-trace after)))
        (when (or (not (= (trace-hints t0) (trace-hints t1)))
                  (not (= (trace-shuffles t0) (trace-shuffles t1)))
                  (not (eq? (trace-phase t0) (trace-phase t1)))
                  (not (= (trace-ice-count t0) (trace-ice-count t1))))
          (say "trace"
               (exact (floor (trace-value t1)))
               (trace-hints t1)
               (trace-shuffles t1)
               (trace-phase t1)
               (trace-ice-count t1)))))

    ;; What changed between two sessions, as one line, or nothing. A new
    ;; deal is reported by say-first-pair instead (web-tick checks the seed).
    ;; A shuffle and the lock can land in one frame (the shuffle's cost
    ;; crosses the threshold), so the lock is reported on its own after.
    (define (report-change! before after)
      (let* ((b0 (session-board before))
             (b1 (session-board after))
             (n0 (board-tile-count b0))
             (n1 (board-tile-count b1))
             (h0 (length (board-history b0)))
             (h1 (length (board-history b1)))
             (t0 (session-trace before))
             (t1 (session-trace after)))
        (cond ((not (= (session-seed before) (session-seed after))) #f)
              ;; a counter-hack: it cut the history, so it is read off the
              ;; trace, not the board
              ((not (= (trace-ice-count t0) (trace-ice-count t1)))
               (case (trace-last-ice t1)
                 ((lock) (report-lock! b0 b1))
                 ((remap) (say "remap"))
                 ((scramble) (apply say "scramble" (board-scrambled-slots b1)))
                 (else (say "ice" "nothing"))))
              ((< n1 n0)
               ;; Two tiles left: the selected one and the one just picked.
               (let ((gone (filter (lambda (id)
                                     (and (tile-present? b0 id)
                                          (not (tile-present? b1 id))))
                                   (iota (layout-slot-count (board-layout b0))))))
                 (apply say "removed" (append gone (list "tiles" n1)))))
              ;; Same tiles, shorter history: an undo, whatever it put back;
              ;; longer history with the same tiles: a shuffle (faces moved),
              ;; a lock (more locked tiles) or an unlock (fewer).
              ((< h1 h0) (say "undo" "tiles" n1))
              ((and (> h1 h0)
                    (not (equal? (vector->list (board-faces b0))
                                 (vector->list (board-faces b1)))))
               (say "shuffle")
               (report-lock! b0 b1))
              ((> h1 h0)
               (let ((l0 (board-locked-slots b0))
                     (l1 (board-locked-slots b1)))
                 (if (> (length l1) (length l0))
                     (report-lock! b0 b1)
                     (apply say "unlock" (filter (lambda (id) (not (memv id l1))) l0)))))
              ((and (board-selected b1)
                    (not (eqv? (board-selected b0) (board-selected b1))))
               (say "select" (board-selected b1)))
              ((and (board-selected b0)
                    (not (board-selected b1)))
               (say "deselect")))))

    (define (report-lock! b0 b1)
      (let ((l0 (board-locked-slots b0))
            (l1 (board-locked-slots b1)))
        (when (> (length l1) (length l0))
          (apply say "lock" (filter (lambda (id) (not (memv id l0))) l1)))))

    ;; A slot's hint-mode tag, from the session's own table.
    (define (slot-tag s id)
      (let ((entry (assv id (session-labels s))))
        (if entry (cdr entry) "-")))

    (define (say-first-pair s)
      (let ((sol (board-solution (session-board s))))
        (if (null? sol)
            (say "seed" (session-seed s) "tiles" (board-tile-count (session-board s)) "pair none")
            (let* ((a (car (car sol)))
                   (b (cdr (car sol)))
                   (ca (slot-centre *geom* a))
                   (cb (slot-centre *geom* b)))
              (say "seed" (session-seed s)
                   "tiles" (board-tile-count (session-board s))
                   "pair" a (car ca) (cdr ca)
                   b (car cb) (cdr cb))
              (say "labels" a (slot-tag s a) b (slot-tag s b))))
        (say "tags"
             (if (session-labels-shown s) "shown" "hidden")
             "touch" (if *touch* "on" "off")
             "fresh" (if *fresh* "on" "off"))
        (for-each (lambda (c)
                    (say "control"
                         (car c)
                         (+ (cadr c) (half (cadddr c)))
                         (+ (caddr c) (half (list-ref c 4)))))
                  (append (geometry-controls *geom* (session-hud s)) (update-controls *geom* (session-hud s))))))

    ;; What changed on the card table between two deals, as one line.
    (define (report-deal-change! before after)
      (let* ((g0 (deal-game before))
             (g1 (deal-game after))
             (m0 (game-moves g0))
             (m1 (game-moves g1))
             (h0 (length (game-history g0)))
             (h1 (length (game-history g1))))
        (cond ((and (deal-hint after) (not (deal-hint before)))
               (say "cards" "probe" "hint" (car (car (deal-hint after))) (car (cadr (deal-hint after)))))
              ((and (deal-probe-running? before) (not (deal-probe-running? after)) (not (deal-hint after)))
               (say "cards" "probe" "none"))
              ((eq? g0 g1) #f)
              ((not (= (deal-seed before) (deal-seed after)))
               (set! *announced* #f)
               (set! *restored* #f))
              ((not (= (trace-ice-count (deal-trace before)) (trace-ice-count (deal-trace after))))
               (say "cards" "ice" (or (trace-last-ice (deal-trace after)) 'nothing)))
              ((< (deal-scrambles after) (deal-scrambles before))
               (say "cards" "scramble" (deal-scrambles after)))
              ((not (= (game-draw g0) (game-draw g1)))
               (say "cards" "draw" (game-draw g1)))
              ((game-won? g1) (say "cards" "won" "moves" m1))
              ((and (deal-auto after) (not (deal-auto before))) (say "cards" "auto"))
              ((< h1 h0) (say "cards" "undo" m1))
              ((> (length (game-waste g1)) (length (game-waste g0)))
               (say "cards" "drew" (length (game-waste g1))))
              ((> m1 m0) (say "cards" "moved" m1))
              ((and (game-selected g1)
                    (not (equal? (game-selected g0) (game-selected g1))))
               (apply say "cards" "select" (game-selected g1)))
              ((and (game-selected g0) (not (game-selected g1)))
               (say "cards" "deselect")))))

    ;; The card table's meter line, whenever its phase, mode or ICE count
    ;; moved, or the game charged it (a pass, an undo).
    (define (report-deal-trace! before after)
      (let ((t0 (deal-trace before))
            (t1 (deal-trace after)))
        (when (or (not (eq? (trace-phase t0) (trace-phase t1)))
                  (not (eq? (trace-mode t0) (trace-mode t1)))
                  (not (= (trace-ice-count t0) (trace-ice-count t1)))
                  (not (= (trace-extra t0) (trace-extra t1))))
          (say "cards" "trace"
               (exact (floor (trace-value t1)))
               (trace-mode t1)
               (trace-phase t1)
               (trace-ice-count t1)
               (or (trace-last-ice t1) 'none)))))

    (define (say-deal d)
      (let* ((g (deal-game d))
             (moves (legal-moves g)))
        (say "cards" "seed" (deal-seed d)
             "moves" (game-moves g)
             "draw" (game-draw g))
        (let ((stock (place-center *card-geom* g '(stock))))
          (say "cards" "stock" (car stock) (cdr stock)))
        (if (null? moves)
            (say "cards" "first" "none")
            (let* ((src (place-center *card-geom* g (car (car moves))))
                   (dst (place-center *card-geom* g (cdr (car moves))))
                   (tag (lambda (p)
                          (let ((entry (find (lambda (e) (equal? (car e) p)) (deal-labels d))))
                            (if entry (cdr entry) "-"))))
                   (dst-place (let ((p (cdr (car moves))))
                                (if (and (eq? (car p) 'pile) (pair? (game-pile g (cadr p))))
                                    (list 'pile (cadr p) 0)
                                    p))))
              (say "cards" "first" (car src) (cdr src) (car dst) (cdr dst))
              (say "cards" "tags" (tag (car (car moves))) (tag dst-place)))))
      (when *restored*
        (say "cards" "restored" "moves" (game-moves (deal-game d))))
      (when (deal-auto d)
        (say "cards" "auto"))
      (say "cards" "tagsshown" (if (deal-labels-shown d) "on" "off")
           "touch" (if *touch* "on" "off"))
      (for-each (lambda (c)
                  (say "control"
                       (car c)
                       (+ (cadr c) (half (cadddr c)))
                       (+ (caddr c) (half (list-ref c 4)))))
                (card-controls *card-geom* (deal-hud d))))

    ;; --- one frame -----------------------------------------------------------

    ;; Keys that went down since the last frame are kept newest first;
    ;; they are handed over oldest first, so two tag letters landing in
    ;; one slow frame still spell their tag in the order they were typed
    ;; (measured 2026-09-17: under load "dr" arrived as "rd" and picked
    ;; nothing).
    (define (input-this-frame)
      (let ((f (make-input-frame (reverse *pressed*)
                                 (filter (lambda (k) (memq k MODIFIERS))
                                         *keys*)
                                 *click*)))
        (set! *pressed* '())
        (set! *click* #f)
        f))

    ;; The frame's wall dt in seconds from the rAF timestamp (ms): the
    ;; fixed clock in (crash fx) turns it into ticks. The first frame, and
    ;; a frame after a payload that is not a number, count as no time.
    (define (frame-dt payload)
      (let* ((ms (string->number payload))
             (dt (if (and ms *last-ms*)
                     (/ (- ms *last-ms*) 1000.0)
                     0.0)))
        (when ms (set! *last-ms* ms))
        dt))

    ;; A running PROBE gets PROBE-FRAME-MS of this frame, one position at
    ;; a time, so a hard position never stalls the table (the solver runs
    ;; at a few ms per position in this build; see the evidence note).
    (define PROBE-FRAME-MS 6)

    (define (probe-work d)
      (let ((t0 (current-milliseconds)))
        (let loop ((d d))
          (if (and (deal-probe-running? d)
                   (< (- (current-milliseconds) t0) PROBE-FRAME-MS))
              (loop (deal-probe-step d))
              d))))

    (define (cards-tick f dt)
      (when (and *trace* (not *announced*))
        (say-deal *deal*)
        (say "hud" (deal-hud *deal*))
        (set! *announced* #t))
      (let* ((before *deal*)
             (x (card-fx-frame *card-fx* dt *card-geom*))
             (after (save-deal-after-frame!
                      before
                      (probe-work
                        (deal-advance (deal-step before f *card-geom*)
                                      (clock-steps (card-fx-clock x))))))
             (x (card-fx-observe x before after *card-geom*)))
        (set! *deal* after)
        (set! *card-fx* x)
        (play-cues! (deal-cues before after))
        (advance-bg! (clock-steps (card-fx-clock x)) (deal-trace before) (deal-trace after))
        (report-deal-change! before after)
        (report-deal-trace! before after)
        (unless (eq? (tools-open? (deal-tools before)) (tools-open? (deal-tools after)))
          (say-tools (deal-tools after) (deal-tools-list after)))
        (present! (card-fx-cascading? x)
                  (lambda ()
                    (if *bg-only*
                        (draw-board-background VW VH (- VH (card-geometry-hud-h *card-geom*)) 0.0 (background) *copper*)
                        (draw-deal after *card-geom* x (texture-for-path PORTRAITS-PATH) (background) *copper*))))
        (ensure-texture! dt PORTRAITS-PATH)))

    (define (stack-tick f dt)
      ;; The boot lines wait for trace to be switched on, and repeat after
      ;; a new deal.
      (when (and *trace* (not *announced*))
        (say-first-pair *session*)
        (say "look" (session-look *session*))
        (say "hud" (session-hud *session*))
        (when *restored*
          (let ((b (session-board *session*)))
            (apply say "restored"
                   "tiles" (board-tile-count b)
                   "trace" (exact (floor (trace-value (session-trace *session*))))
                   "phase" (trace-phase (session-trace *session*))
                   "ice" (trace-ice-count (session-trace *session*))
                   "locked" (board-locked-slots b))))
        (set! *announced* #t))
      (let* ((before *session*)
             (x (fx-frame *fx* dt))
             (after (save-after-frame!
                      before
                      (session-advance (if *demo-armed*
                                           (begin (set! *demo-armed* #f) (session-demo-finish before))
                                           (session-step before f *geom*))
                                       (clock-steps (fx-clock x)))))
             (x (fx-observe x before after *geom*)))
        (set! *session* after)
        (set! *fx* x)
        (play-cues! (session-cues before after))
        (advance-bg! (clock-steps (fx-clock x)) (session-trace before) (session-trace after))
        (unless (eq? (session-update before) (session-update after))
          (say "update" (session-update after))
          (when (eq? (session-update after) 'apply) (update-chosen!)))
        (report-change! before after)
        (report-trace! before after)
        (unless (eq? (session-look before) (session-look after))
          (say "look" (session-look after)))
        (unless (eq? (tools-open? (session-tools before)) (tools-open? (session-tools after)))
          (say-tools (session-tools after) (session-tools-list after)))
        (when (not (= (session-seed before) (session-seed after)))
          (set! *announced* #f))
        (present! (and (fx-cleared x) #t)
                  (lambda ()
                    (if *bg-only*
                        (draw-board-background VW VH (- VH (geometry-hud-h *geom*)) 0.0 (background) *copper*)
                        (draw-session after *geom* (texture-for after) x (background) *copper*))))
        (ensure-texture! dt (look-texture (look-ref (session-look after))))))

    ;; The tool stack opening or closing, and while it opens each entry's
    ;; center and whether it can fire, so the arm taps what the player sees:
    ;;   crash: tools open|closed
    ;;   crash: tool NAME X Y on|off
    (define (say-tools st tools)
      (say "tools" (if (tools-open? st) "open" "closed"))
      (when (tools-open? st)
        (let ((n (length tools)))
          (let loop ((ts tools) (i 0))
            (when (pair? ts)
              (let ((r (tool-entry-rect VH i n (tools-touch st))))
                (say "tool"
                     (tool-name (car ts))
                     (+ (car r) (half (caddr r)))
                     (+ (cadr r) (half (cadddr r)))
                     (if (tool-enabled (car ts)) "on" "off")))
              (loop (cdr ts) (+ i 1)))))))

    ;; The menu's boot line: each shown entry with its center.
    (define (say-menu m)
      (apply say "menu"
             (let loop ((ids (menu-entries m)) (i 0) (acc '()))
               (if (null? ids)
                   (reverse acc)
                   (let ((r (menu-entry-rect i VW VH)))
                     (loop (cdr ids)
                           (+ i 1)
                           (cons (+ (cadr r) (half (cadddr r)))
                                 (cons (+ (car r) (half (caddr r)))
                                       (cons (car ids) acc)))))))))

    ;; A choice opens its table and draws it this same frame (with an
    ;; empty input frame), so no frame goes undrawn.
    (define (menu-tick f dt)
      (when (and *trace* (not *announced*))
        (say-menu *menu*)
        (set! *announced* #t))
      (let ((r (menu-step *menu* f VW VH)))
        (set! *menu* (car r))
        (when (cdr r)
          (say "menu" "chose" (cdr r))
          (choose! (cdr r)))
        (if (eq? *screen* 'menu)
            (begin
              (frame-begin!)
              (draw-menu *menu* VW VH *version*)
              (end-frame))
            (tick-screen (make-input-frame '() '() #f) dt))))

    (define (web-tick dt)
      (unless *booted* (boot!))
      (set! *since-boot* (+ *since-boot* dt))
      (set! *frame-ms* (* 1000.0 dt))
      (when *ms* (count-frame! dt))
      (set! *tick-t0* (now-ms))
      (set! *sim-ms* 0.0)
      (set! *draw-ms* 0.0)
      (set! *flush-ms* 0.0)
      (gles3-resize-to-display)
      (tick-screen (input-this-frame) dt)
      (audio-pump!))

    (define (tick-screen f dt)
      (let ((click (input-frame-click f)))
        (case *screen*
          ((menu) (menu-tick f dt))
          ((stack)
           (cond ((or (menu-frame? f)
                      (jack-out? *session* f VW VH (geometry-hud-h *geom*)))
                  (open-menu!))
                 (else
                  (stack-tick f dt)
                  ;; the MENU tool: the session asks, the shell answers
                  (when (session-request *session*)
                    (set! *session* (session-clear-request *session*))
                    (open-menu!)))))
          (else
           (if (or (menu-frame? f)
                   (jack-out-tap? *deal* f *card-geom*))
               (open-menu!)
               (begin
                 (cards-tick f dt)
                 (when (deal-request *deal*)
                   (set! *deal* (deal-clear-request *deal*))
                   (open-menu!))))))))

    ;; --- entry ---------------------------------------------------------------

    ;; Boot the table the page asked for: the card table with ?cards, else
    ;; the stack. Called on the first frame rather than from web-main: the
    ;; page's parameters (?cards, ?fresh, ?seed, the touch flag, the update
    ;; state) are dispatched once the loader is up, which is after web-main
    ;; returns (sigil_wasm_start) and before the first frame, so booting
    ;; here sees every one of them.
    (define (open-menu!)
      (set! *screen* 'menu)
      (set! *announced* #f)
      (set! *menu* (launch-menu (and *update* #t)
                                (and (case (active-game)
                                       ((stack) *session*)
                                       ((cards) *deal*)
                                       (else #f))
                                     #t))))

    ;; The stack. CONTINUE (resume?) returns to the table in memory, or
    ;; the saved one; STACK deals a NEW board: the next seed after the
    ;; one in memory or in the store, else ?seed (David, 2026-09-18:
    ;; going "fresh" into a game put him back in the previous one, trace
    ;; and all).
    (define (open-stack! resume?)
      (set! *screen* 'stack)
      (set! *announced* #f)
      (let ((lay (turtle-layout)))
        (unless *geom* (set! *geom* (make-geometry lay VW VH)))
        (unless (and resume? *session*)
          (let* ((booted (boot-session lay *seed* *fresh*))
                 (s (cond (resume? (car booted))
                          (*session* (session-next *session*))
                          ((cdr booted) (session-next (car booted)))
                          (else (car booted)))))
            (set! *session* (session-with-tools-touch (if *touch* (session s labels-shown: #f) s) *touch*))
            (when (eq? *demo* 'cleared)
              (set! *session* (session-demo-near-cleared *session*))
              (set! *demo-armed* #t)
              (set! *demo* #f)
              (say "demo" "cleared" "stack"))
            (set! *restored* (and resume? (cdr booted)))
            (set! *fx* (fx-new))))))

    (define (open-cards! resume?)
      (set! *screen* 'cards)
      (set! *announced* #f)
      (unless *card-geom* (set! *card-geom* (make-card-geometry VW VH)))
      (unless (and resume? *deal*)
        (let* ((booted (if (eq? *demo* 'cleared)
                           (let ((won (demo-won-deal)))
                             (set! *demo* #f)
                             (say "demo" "cleared" (if won "cards" "FAILED: the won deal did not parse"))
                             (if won (cons won #f) (boot-deal *seed* *fresh*)))
                           (boot-deal *seed* *fresh*)))
               (d (cond (resume? (car booted))
                        (*deal* (deal-next *deal*))
                        ((cdr booted) (deal-next (car booted)))
                        (else (car booted)))))
          (set! *deal* (deal-with-tools-touch (if *touch* (deal d labels-shown: #f) d) *touch*))
          (set! *restored* (and resume? (cdr booted)))
          (set! *card-fx* (card-fx-new)))))

    ;; The update's state reaches the stack's session (the game draws it
    ;; and takes the choice, (crash input) step-update) and the menu (its
    ;; UPDATE entry); when it lands before the first frame, boot! calls
    ;; this again once the table is up. Reported for the arm.
    (define (update! state)
      (set! *update* state)
      (when *session*
        (set! *session* (session-with-update *session* state))
        (say "update" state))
      (when (and *booted* (eq? *screen* 'menu)) (open-menu!))
      0)

    ;; The player's APPLY: the page polls ("update", "chosen?") and reads
    ;; the answer from the dispatch's return value (1 once chosen; the
    ;; loader hands a handler's integer back to the page since sigil 0.22.2).
    (define (update-chosen!)
      (set! *update-chosen* #t))

    ;; A menu choice. UPDATE applies the waiting version the same way the
    ;; in-game prompt does; LOOK steps the look (P3) and stays on the
    ;; menu, the stack in memory taking the new one.
    ;;   crash: look NAME                     the look after a LOOK choice
    (define (choose! choice)
      (let* ((resume? (eq? choice 'continue))
             (id (if resume? (active-game) choice)))
        (case id
          ((stack) (set-active-game! 'stack) (open-stack! resume?))
          ((cards) (set-active-game! 'cards) (open-cards! resume?))
          ((update) (update-chosen!))
          ((look) (let ((next (step-look!)))
                    (set! *menu* (menu-with-look *menu* next))
                    (when *session* (set! *session* (session-with-look *session* next)))
                    (say "look" next)))
          ((hud) (let ((next (step-hud!)))
                   (set! *hud* next)
                   (set! *menu* (menu-with-hud *menu* next))
                   (when *session* (set! *session* (session-with-hud *session* next)))
                   (when *deal* (set! *deal* (deal-with-hud *deal* next)))
                   (say "hud" next)))
          (else #f))))

    ;; ?stack and ?cards open their table as CONTINUE would (the saved
    ;; game, or a fresh one), which is what the arms and a bookmark want.
    (define (background) *bg*)

    ;; The background after a table's frame: (crash shell)'s bg-advance,
    ;; timed for ?ms (the CPU field's step, or the GPU field's schedule).
    ;; A held field says so once, after the frame that shows the held
    ;; step has been presented (the field leg reads the canvas after
    ;; the line):
    ;;   crash: bg held N
    (define (advance-bg! steps before after)
      (let ((t0 (current-milliseconds)))
        (set! *bg* (bg-advance *bg* steps before after))
        (set! *advance-ms* (inexact (- (current-milliseconds) t0)))))

    (define (say-held!)
      (when (and *bg* (bg-held? *bg*) (not *bg-said*)
                 (or (not (bg-gpu? *bg*)) (= (gpu-bg-steps) (bg-steps *bg*))))
        (set! *bg-said* #t)
        (say "bg" "held" (bg-steps *bg*))))

    ;; One presented frame: draw (a thunk over the virtual viewport)
    ;; straight to the swap chain, or through the phosphor targets while
    ;; the cascade runs (ruling D36.2) or the probe is on; the ?ms
    ;; readout over it; then the held line, once the frame is out.
    (define (present! cascading? draw)
      (set! *sim-ms* (- (now-ms) *tick-t0*))
      (let ((t1 (now-ms)))
        (frame-begin!)
        (atlas-ensure!)
        (when (and (eq? *screen* 'stack) *session* *geom*)
          (tiles-ensure! (look-ref (session-look *session*)) *geom*))
        (when (and *bg* (bg-gpu? *bg*)) (gpu-bg-prepare! *bg*))
        (cond ((eq? *phosphor* 'probe)
               (phosphor-frame! VW VH PHOSPHOR (lambda () (draw) (draw-phosphor-probe *frame-n*))))
              ((and cascading? (eq? *phosphor* 'on))
               (phosphor-frame! VW VH PHOSPHOR draw))
              (else
               (phosphor-reset!)
               (draw)))
        (when *ms*
          (let ((gpu (gpu-bg-ms)))
            (draw-frame-ms *frame-ms* (+ *advance-ms* (car gpu)) (cdr gpu))))
        (set! *draw-ms* (- (now-ms) t1))
        (end-frame)
        (set! *flush-ms* (- (now-ms) t1 *draw-ms*)))
      (set! *frame-n* (+ *frame-n* 1))
      (say-held!))

    (define (boot!)
      (set! *session* #f)
      (set! *deal* #f)
      (set! *bg* (bg-choose *bg-mode* 1 *bg-hold*))
      (when (and *bg* (or *bg-stride* *bg-rsteps*))
        (set! *bg* (bg *bg*
                       stride: (or *bg-stride* (bg-stride *bg*))
                       react-steps: (or *bg-rsteps* (bg-react-steps *bg*)))))
      (set! *bg-said* #f)
      (when *bg* (say "bg" (if (bg-gpu? *bg*) "gpu" "cpu") (bg-mode *bg*)))
      (set! *booted* #t)
      (set! *audio-ready* (audio-open!))
      (say "audio" (if *audio-ready* "open" "closed"))
      ;; the quoted literals' shapes (see (crash shell)): one line the arm asserts
      (let ((bad (literal-check)))
        (if (null? bad)
            (say "literal-check" "ok")
            (apply say "literal-check" "FAILED" bad)))
      (cond (*cards* (open-cards! #t))
            (*stack* (open-stack! #t))
            ;; a boot that throws says why (the loader prints only the
            ;; message, and a menu that never opened is a struct-ref
            ;; storm every frame after)
            (else (guard (e (#t (say "boot-error"
                                     (if (error-object? e) (error-object-message e) e)
                                     (if (error-object? e) (error-object-irritants e) '()))))
                    (open-menu!))))
      ;; the page's update word lands before the first frame, ahead of
      ;; any session: the table takes it here, once
      (when *update* (update! *update*)))

    ;; A page parameter landed (before the first frame; see open-menu!).
    (define (param! setter)
      (setter)
      0)

    (define (web-main)
      (unless (gles3-use-canvas "#stage")
        (error "crash web: no WebGL2 context for #stage. This browser has WebGL2 off or unavailable (Chrome: chrome://gpu, or Settings > System > graphics acceleration)."))
      (gles3-resize-to-display)
      (gfx-setup)
      (set-viewport VW VH)
      (set-letterbox-color 0.0 0.0 0.0)
      ;; The callback name is only used by the bytecode eval path; native
      ;; builds get a ("frame", ms) dispatch instead, which lands in web-dispatch.
      (gles3-start-loop "crash-web-tick")
      0)

    (define (web-dispatch type payload)
      (cond ((string=? type "frame") (web-tick (frame-dt payload)) 0)
            ((string=? type "keydown") (key-down! payload) 0)
            ((string=? type "keyup") (key-up! payload) 0)
            ((string=? type "pointerdown") (pointer-down! payload) 0)
            ((string=? type "trace") (set! *trace* (string=? payload "on")) 0)
            ((string=? type "fresh") (param! (lambda () (set! *fresh* (string=? payload "on")))))
            ((string=? type "cards") (param! (lambda () (set! *cards* (string=? payload "on")))))
            ((string=? type "stack") (param! (lambda () (set! *stack* (string=? payload "on")))))
            ((string=? type "update")
             (cond ((string=? payload "waiting") (update! 'waiting))
                   ((string=? payload "prompt") (update! 'prompt))
                   ((string=? payload "chosen?") (if *update-chosen* 1 0))
                   (else 0)))
            ((string=? type "seed")
             (param! (lambda ()
                       (let ((n (string->number payload)))
                         (when (and n (exact? n) (integer? n) (>= n 0)) (set! *seed* n))))))
            ((string=? type "touch") (param! (lambda () (set! *touch* (string=? payload "on")))))
            ;; ?bg=life|reaction|life-cpu|reaction-cpu|off (a name outside the rule table is off)
            ((string=? type "bg") (param! (lambda () (set! *bg-mode* (string->symbol payload)))))
            ((string=? type "bghold") (param! (lambda () (set! *bg-hold* (string->number payload)))))
            ((string=? type "bgstride") (param! (lambda () (set! *bg-stride* (let ((n (string->number payload))) (and n (>= n 1) n))))))
            ((string=? type "rsteps") (param! (lambda () (set! *bg-rsteps* (let ((n (string->number payload))) (and n (>= n 1) n))))))
            ((string=? type "bgonly") (param! (lambda () (set! *bg-only* (string=? payload "on")))))
            ((string=? type "copper") (param! (lambda () (set! *copper* (copper-choice (string->symbol payload))))))
            ((string=? type "raster") (param! (lambda () (set! *copper* (or (string->number payload) *copper*)))))
            ((string=? type "phosphor") (param! (lambda () (set! *phosphor* (phosphor-choice (string->symbol payload))))))
            ((string=? type "demo") (param! (lambda () (set! *demo* (and (string=? payload "cleared") 'cleared)))))
            ((string=? type "atlas") (param! (lambda () (atlas-set! (not (string=? payload "off"))))))
            ;; ?hud=strip: the bar's layout for this boot (and stored)
            ((string=? type "hud") (param! (lambda () (set! *hud* (if (string=? payload "strip") 'strip 'zones)) (set-stored-hud! *hud*))))
            ((string=? type "version") (set! *version* (string-append "WEB " payload)) 0)
            ((string=? type "ms") (param! (lambda () (set! *ms* (string=? payload "on")))))
            ((string=? type "audio-chunk") (audio-chunk! payload))
            ((string=? type "gesture") (gesture! payload))
            ;; the ambient off (the browser arm mutes it to hear a cue alone)
            ((string=? type "ambient") (when (string=? payload "off") (audio-set-ambient! #f AMBIENT-RATE)) 0)
            ((string=? type "audio-done") (audio-done! payload))
            (else 0)))))
