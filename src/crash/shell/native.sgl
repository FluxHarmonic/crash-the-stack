;;; (crash shell native) - The native shell.
;;;
;;; Opens a window with sigil-app, sets the 640x400 virtual viewport, and
;;; each frame: polls the keys and the mouse into an input-frame (mouse in
;;; virtual coordinates), steps the session, draws it. Everything game-shaped
;;; lives in the modules this imports; the web shell (crash shell web) replaces
;;; only this file, and (crash main) picks between the two.
;;;
;;;   crash-the-stack [--seed N] [--texture] [--keys hint|cursor] [--log-keys] [--fresh]
;;;                   [--bench-probe N]   time the PROBE solver over the first N winnable seeds, no window
;;;                   [--cards]
;;;   crash-the-stack --edit PATH        the layout editor on PATH (loaded if it exists)
;;;
;;; The game opens on the menu (P2: STACK / CARDS / CONTINUE; ruling D14's
;;; placeholder until P4's real one); --cards skips it straight to the
;;; card table, which is saved under its own store key and restored the
;;; same way as the board. The MENU control in either HUD, ctrl+e, or a
;;; severed stack's JACK OUT come back to the menu; the table's state
;;; stays in memory meanwhile.
;;;
;;; The board, the meter and the settings are saved to the user data
;;; directory ((crash store): $XDG_DATA_HOME/crash-the-stack) after every
;;; change and restored at start; --fresh ignores the saved board and
;;; deals --seed.
;;;
;;; --log-keys prints the key symbols sigil-app reports each frame, for
;;; checking what a physical key arrives as (David saw Enter cycle the
;;; models like Tab on 2026-09-16; this tells whether it arrives as tab).
;;;
;;; The window opens at exactly twice the virtual size so the letterboxed
;;; viewport scales by an integer at start (sigil-graphics scales by a float
;;; min(w/vw, h/vh); 2x is exact).

(define-library (crash shell native)
  (import (sigil struct)
          (sigil math)
          (sigil process)
          (sigil fs)
          (sigil io)
          (sigil app)
          (sigil graphics)
          (crash stack layout)
          (crash stack turtle)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash editor)
          (crash tween)
          (crash fx)
          (crash render)
          (crash cards geometry)
          (crash cards input)
          (crash cards render)
          (crash cards fx)
          (crash cards rules)
          (crash cards seeds)
          (crash cards solve)
          (crash menu)
          (crash look)
          (crash shell))

  (export native-main load-editor)

  (begin
    ;; Naming: UPPER-CASE for a constant, *earmuffs* for mutable module state
    ;; (the sigil-app and Cinder convention; see CLAUDE.md).
    (define WINDOW-W 1280)
    (define WINDOW-H 800)

    ;; Every key sigil-app can report that the game listens to: one
    ;; one-character symbol per face key (letters and digits alike, |1|
    ;; for the 1 key), plus the named keys.
    (define FACE-KEY-SYMBOLS
      (map (lambda (c)
             (string->symbol (string c)))
           (string->list FACE-KEYS)))
    (define OTHER-KEYS '(space return tab backspace left right up down))
    (define ALL-KEYS (append FACE-KEY-SYMBOLS OTHER-KEYS))

    ;; Window pixel -> virtual pixel, through the one letterbox inverse in
    ;; (crash geometry) that the web shell also uses.
    (define (window->virtual x y)
      (frame->virtual (frame-width)
                      (frame-height)
                      VW
                      VH
                      x
                      y))

    (define (poll-frame)
      (make-input-frame
        (filter key-pressed? ALL-KEYS)
        (filter key-down? MODIFIERS)
        (and (mouse-pressed? 'left)
             (window->virtual (mouse-x)
                              (mouse-y)))))

    (define (load-test-tile)
      (let ((img (load-image TEST-TILE-PATH)))
        (if img
            ;; load-image, load-texture, image-free!: a helper for this belongs in
            ;; sigil-graphics (finding 11 in the evidence note).
            (let ((tex (load-texture img)))
              (image-free! img)
              tex)
            (begin
              (display "test tile not found: ") (display TEST-TILE-PATH) (newline)
              #f))))

    (define (arg-value args flag default)
      (cond ((null? args) default)
            ((and (string=? (car args) flag)
                  (pair? (cdr args)))
             (cadr args))
            (else (arg-value (cdr args) flag default))))

    ;; Last frame's wall time in ms, shown in the HUD under --log-keys.
    (define *frame-ms* 0.0)

    ;; --- the three screens ----------------------------------------------------
    ;;
    ;; One loop, one screen at a time: the menu, the stack or the card
    ;; table. A table's state stays in memory while the menu is up, so
    ;; CONTINUE (or the same table's entry) returns to it; a table that
    ;; was never opened this run boots from the store. Each frame: poll,
    ;; hand the frame to the screen, draw it.

    (define-struct stage
      (screen default: 'menu)     ; menu | stack | cards
      (menu default: #f)
      (session default: #f)       ; the stack, once opened
      (fx default: #f)
      (deal default: #f)          ; the card table, once opened
      (card-fx default: #f))

    ;; The stack. CONTINUE (resume?) returns to the table in memory, or
    ;; the saved one; STACK deals a NEW board: the next seed after the
    ;; one in memory or in the store, else the flags' (David, 2026-09-18:
    ;; going "fresh" into a game put him back in the previous one).
    (define (open-stack a lay seed fresh? texture-first? model resume?)
      (let* ((held (stage-session a))
             (s (cond ((and resume? held) held)
                      (else
                       (let ((booted (boot-session lay seed fresh?)))
                         (cond (resume? (car booted))
                               (held (session-next held))
                               ((cdr booted) (session-next (car booted)))
                               (else (car booted)))))))
             (s (if (eq? s held)
                    s
                    (let ((s (if model (session-with-model s model) s)))
                      (if texture-first?
                          (begin
                            (set-stored-look! 'test-tile)
                            (session-with-look s 'test-tile))
                          s)))))
        (stage a screen: 'stack session: s fx: (if (eq? s held) (stage-fx a) (fx-new)))))

    (define (open-cards a seed fresh? resume?)
      (let* ((held (stage-deal a))
             (d (cond ((and resume? held) held)
                      (else
                       (let ((booted (boot-deal seed fresh?)))
                         (cond (resume? (car booted))
                               (held (deal-next held))
                               ((cdr booted) (deal-next (car booted)))
                               (else (car booted))))))))
        (stage a
               screen: 'cards
               deal: d
               card-fx: (if (eq? d held) (stage-card-fx a) (card-fx-new)))))

    (define (open-menu a)
      (stage a
             screen: 'menu
             menu: (launch-menu #f
                                (and (case (active-game)
                                       ((stack) (stage-session a))
                                       ((cards) (stage-deal a))
                                       (else #f))
                                     #t))))

    ;; A menu choice: CONTINUE resumes the active table; STACK and DEFRAG
    ;; start a new game of theirs; LOOK steps the look (P3) and stays on
    ;; the menu, the table in memory taking the new one.
    (define (choose a choice lay seed fresh? texture-first? model)
      (let* ((resume? (eq? choice 'continue))
             (id (if resume? (active-game) choice)))
        (case id
          ((stack) (set-active-game! 'stack)
                   (open-stack a lay seed fresh? texture-first? model resume?))
          ((cards) (set-active-game! 'cards)
                   (open-cards a seed fresh? resume?))
          ((look) (let ((next (step-look!)))
                    (stage a
                           menu: (menu-with-look (stage-menu a) next)
                           session: (and (stage-session a)
                                         (session-with-look (stage-session a) next)))))
          (else a))))

    (define (step-stack a f dt geom log-keys?)
      (let* ((s (stage-session a))
             (x (fx-frame (stage-fx a) dt))
             (after (save-after-frame!
                      s
                      (session-advance (session-step s f geom)
                                       (clock-steps (fx-clock x)))))
             (x (fx-observe x s after geom)))
        (when log-keys?
          (set! *frame-ms* (* 1000.0 dt))
          (when (pair? (input-frame-pressed f))
            (display "keys: ")
            (write (input-frame-pressed f))
            (display " held: ")
            (write (input-frame-held f))
            (newline)))
        (stage a session: after fx: x)))

    (define (step-cards a f dt geom)
      (let* ((d (stage-deal a))
             (x (card-fx-frame (stage-card-fx a) dt geom))
             (after (save-deal-after-frame!
                      d
                      (probe-work
                        (deal-advance (deal-step d f geom)
                                      (clock-steps (card-fx-clock x))))))
             (x (card-fx-observe x d after geom)))
        (stage a deal: after card-fx: x)))

    (define (stage-loop seed texture-first? model log-keys? fresh? cards?)
      (lambda ()
        (gfx-setup)
        (set-viewport VW VH)
        (set-letterbox-color 0.0 0.0 0.0)
        (let* ((lay (turtle-layout))
               (geom (make-geometry lay VW VH))
               (card-geom (make-card-geometry VW VH))
               (tex (load-test-tile))
               (open (lambda (a choice)
                       (choose a choice lay seed fresh? texture-first? model))))
          (let loop ((a (if cards?
                            (open-cards (open-menu (stage)) seed fresh? #t)
                            (open-menu (stage)))))
            ;; wait-frame's dt feeds the fixed clock the effects run on
            (let* ((dt (wait-frame))
                   (f (poll-frame))
                   (click (input-frame-click f))
                   (a (case (stage-screen a)
                        ((menu)
                         (let ((r (menu-step (stage-menu a) f VW VH)))
                           (if (cdr r)
                               (open (stage a menu: (car r)) (cdr r))
                               (stage a menu: (car r)))))
                        ((stack)
                         (cond ((menu-frame? f (and click (hit-control geom (car click) (cdr click))))
                                (open-menu a))
                               ((jack-out? (stage-session a) f VW VH (geometry-hud-h geom))
                                (open-menu a))
                               (else (step-stack a f dt geom log-keys?))))
                        (else
                         (if (or (menu-frame? f (and click (hit-card-control card-geom (car click) (cdr click))))
                                 (jack-out-tap? (stage-deal a) f card-geom))
                             (open-menu a)
                             (step-cards a f dt card-geom))))))
              (begin-frame)
              (case (stage-screen a)
                ((menu) (draw-menu (stage-menu a) VW VH #f))
                ((stack)
                 (draw-session (stage-session a) geom tex (stage-fx a))
                 (when log-keys?
                   (draw-frame-ms *frame-ms*)))
                (else (draw-deal (stage-deal a) card-geom (stage-card-fx a))))
              (end-frame)
              (cond ((key-pressed? 'escape) (request-quit))
                    ((quit-requested?) #t)
                    (else (loop a))))))
        (gfx-shutdown)))

    ;; --- the layout editor ------------------------------------------------------
    ;;
    ;; --edit PATH: the editor over the canvas geometry; ctrl+s writes the
    ;; layout to PATH in the 2020 format (refused with a message for an odd
    ;; or empty count, per (crash editor)); ctrl+p play-tests the layout as a
    ;; board (seed 1) and ctrl+p again returns to the editor; Escape quits.

    (define (write-layout! path e)
      (let ((d (editor-datum e)))
        (if d
            (begin
              (write-file-string path (with-output-to-string (lambda () (write d) (newline))))
              (editor e message: (string-append "SAVED " (number->string (editor-count e)) " TILES")))
            (editor e message: (if (= (editor-count e) 0)
                                   "NOTHING TO SAVE"
                                   "ODD TILE COUNT: ADD OR REMOVE ONE")))))

    (define (load-editor path)
      (if (file-exists? path)
          (let ((d (call-with-input-file path read)))
            (editor-from-layout (sexp->layout d)))
          (editor-new)))

    (define (editor-loop path)
      (lambda ()
        (gfx-setup)
        (set-viewport VW VH)
        (set-letterbox-color 0.0 0.0 0.0)
        (let ((canvas (make-canvas-geometry VW VH
                                            CANVAS-MIN-HX CANVAS-MAX-HX
                                            CANVAS-MIN-HY CANVAS-MAX-HY
                                            CANVAS-LAYERS)))
          ;; play: #f in the editor, else (session . geometry) of the play-test
          (let loop ((e (load-editor path))
                     (play #f)
                     (x (fx-new)))
            (let* ((dt (wait-frame))
                   (f (poll-frame))
                   (ctrl (and (memq 'ctrl (input-frame-held f)) #t))
                   (x (fx-frame x dt)))
              (cond
                ;; ctrl+p toggles the play-test
                ((and ctrl (memq 'p (input-frame-pressed f)))
                 (if play
                     (begin (draw-frame-editor e canvas) (loop e #f x))
                     (let ((lay (editor-layout e)))
                       (if lay
                           (let ((g (make-geometry lay VW VH)))
                             (loop e (cons (session-new lay 1) g) x))
                           (loop (editor e message: "ODD OR EMPTY: CANNOT PLAY") #f x)))))
                (play
                 (let* ((s (car play))
                        (g (cdr play))
                        (after (session-advance (session-step s f g) (clock-steps (fx-clock x))))
                        (x (fx-observe x s after g)))
                   (begin-frame)
                   (draw-session after g #f x)
                   (end-frame)
                   (cond ((key-pressed? 'escape) (request-quit))
                         ((quit-requested?) #t)
                         (else (loop e (cons after g) x)))))
                (else
                 (let ((e (if (and ctrl (memq 's (input-frame-pressed f)))
                              (write-layout! path e)
                              (editor-step e f))))
                   (draw-frame-editor e canvas)
                   (cond ((key-pressed? 'escape) (request-quit))
                         ((quit-requested?) #t)
                         (else (loop e #f x)))))))))
        (gfx-shutdown)))

    (define (draw-frame-editor e canvas)
      (begin-frame)
      (draw-editor e canvas)
      (end-frame))

    ;; A running PROBE gets PROBE-FRAME-MS of each frame, one position at
    ;; a time (the web shell does the same).
    (define PROBE-FRAME-MS 6)

    (define (probe-work d)
      (let ((t0 (current-milliseconds)))
        (let loop ((d d))
          (if (and (deal-probe-running? d)
                   (< (- (current-milliseconds) t0) PROBE-FRAME-MS))
              (loop (deal-probe-step d))
              d))))

    ;; --bench-probe N: the PROBE solver's speed in this build, the
    ;; number that sets how many positions a frame may expand ((crash
    ;; cards input) PROBE-NODES-PER-TICK): each of the first n winnable
    ;; seeds solved from the deal, ms and positions printed, then the
    ;; per-position cost.
    (define (bench-probe! n)
      (let loop ((i 0) (ms-total 0) (nodes-total 0))
        (if (>= i (min n (vector-length WINNABLE-SEEDS)))
            (begin
              (display (string-append "bench-probe: " (number->string i) " deals, "
                                      (number->string ms-total) " ms, "
                                      (number->string nodes-total) " positions, "
                                      (number->string (if (> nodes-total 0) (/ (* 1000 ms-total) nodes-total) 0))
                                      " us/position"))
              (newline))
            (let* ((seed (vector-ref WINNABLE-SEEDS i))
                   (t0 (current-milliseconds))
                   (v (solve (game-new seed 1)))
                   (ms (- (current-milliseconds) t0)))
              (display (string-append "  seed " (number->string seed) " " (symbol->string (verdict-status v))
                                      " moves " (number->string (length (verdict-line v)))
                                      " nodes " (number->string (verdict-nodes v))
                                      " ms " (number->string ms)))
              (newline)
              (loop (+ i 1) (+ ms-total ms) (+ nodes-total (verdict-nodes v)))))))

    (define (native-main . _args)
      (let* ((args (cdr (command-line)))
             (seed-arg (string->number (arg-value args "--seed" "")))
             ;; seeds are integers; prng-seed folds 0 onto 1, so 0 and 1
             ;; deal alike; none given (#f): the tables' own first ones
             (seed (if (and seed-arg
                            (exact? seed-arg)
                            (integer? seed-arg)
                            (>= seed-arg 0))
                       seed-arg
                       #f))
             (texture-first? (and (member "--texture" args) #t))
             (model-arg (arg-value args "--keys" #f))
             (model (and model-arg (string->symbol model-arg)))
             (log-keys? (and (member "--log-keys" args) #t))
             (fresh? (and (member "--fresh" args) #t))
             (cards? (and (member "--cards" args) #t))
             (edit-path (arg-value args "--edit" #f))
             (bench-arg (arg-value args "--bench-probe" #f)))
        (when bench-arg
          (bench-probe! (or (string->number bench-arg) 20))
          (exit 0))
        (run-game (if edit-path "Crash The Stack - Editor" "Crash The Stack")
                  WINDOW-W
                  WINDOW-H
                  (if edit-path
                      (editor-loop edit-path)
                      (stage-loop seed texture-first? model log-keys? fresh? cards?)))
        0))))
