;;; (crash shell native) - The native shell.
;;;
;;; Opens a window with sigil-app, sets the 640x400 virtual viewport, and
;;; each frame: polls the keys and the mouse into an input-frame (mouse in
;;; virtual coordinates), steps the session, draws it. Everything game-shaped
;;; lives in the modules this imports; the web shell (crash shell web) replaces
;;; only this file, and (crash main) picks between the two.
;;;
;;;   crash-the-stack [--seed N] [--texture] [--keys hint|cursor] [--log-keys] [--fresh]
;;;                   [--cards]
;;;
;;; The game opens on the menu (P2: STACK / CARDS / CONTINUE; ruling D14's
;;; placeholder until P4's real one); --cards skips it straight to the
;;; card table, which is saved under its own store key and restored the
;;; same way as the board. The MENU control in either HUD, ctrl+e, or a
;;; severed stack's JACK OUT come back to the menu; the table's state
;;; stays in memory meanwhile.
;;;
;;; The board, the meter and the settings are saved to the user data
;;; directory ((crash store): $XDG_DATA_HOME/crash-the-stack) after every
;;; change and restored at start; --fresh ignores the saved board and
;;; deals --seed.
;;;
;;; --log-keys prints the key symbols sigil-app reports each frame, for
;;; checking what a physical key arrives as (David saw Enter cycle the
;;; models like Tab on 2026-09-16; this tells whether it arrives as tab).
;;;
;;; The window opens at exactly twice the virtual size so the letterboxed
;;; viewport scales by an integer at start (sigil-graphics scales by a float
;;; min(w/vw, h/vh); 2x is exact).

(define-library (crash shell native)
  (import (sigil struct)
          (sigil math)
          (sigil process)
          (sigil app)
          (sigil graphics)
          (crash stack layout)
          (crash stack turtle)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash tween)
          (crash fx)
          (crash render)
          (crash cards geometry)
          (crash cards input)
          (crash cards render)
          (crash cards fx)
          (crash menu)
          (crash shell))

  (export native-main)

  (begin
    ;; Naming: UPPER-CASE for a constant, *earmuffs* for mutable module state
    ;; (the sigil-app and Cinder convention; see CLAUDE.md).
    (define WINDOW-W 1280)
    (define WINDOW-H 800)

    ;; Every key sigil-app can report that the game listens to. Digit keys
    ;; are symbols named "0".."9", which the reader cannot spell, hence the
    ;; string->symbol.
    (define FACE-KEY-SYMBOLS
      (map (lambda (c)
             (string->symbol (string c)))
           (string->list FACE-KEYS)))
    (define OTHER-KEYS '(space return tab backspace left right up down))
    (define ALL-KEYS (append FACE-KEY-SYMBOLS OTHER-KEYS))

    ;; Window pixel -> virtual pixel, through the one letterbox inverse in
    ;; (crash geometry) that the web shell also uses.
    (define (window->virtual x y)
      (frame->virtual (frame-width)
                      (frame-height)
                      VW
                      VH
                      x
                      y))

    (define (poll-frame)
      (make-input-frame
        (filter key-pressed? ALL-KEYS)
        (filter key-down? MODIFIERS)
        (and (mouse-pressed? 'left)
             (window->virtual (mouse-x)
                              (mouse-y)))))

    (define (load-test-tile)
      (let ((img (load-image TEST-TILE-PATH)))
        (if img
            ;; load-image, load-texture, image-free!: a helper for this belongs in
            ;; sigil-graphics (finding 11 in the evidence note).
            (let ((tex (load-texture img)))
              (image-free! img)
              tex)
            (begin
              (display "test tile not found: ") (display TEST-TILE-PATH) (newline)
              #f))))

    (define (arg-value args flag default)
      (cond ((null? args) default)
            ((and (string=? (car args) flag)
                  (pair? (cdr args)))
             (cadr args))
            (else (arg-value (cdr args) flag default))))

    ;; Last frame's wall time in ms, shown in the HUD under --log-keys.
    (define *frame-ms* 0.0)

    ;; --- the three screens ----------------------------------------------------
    ;;
    ;; One loop, one screen at a time: the menu, the stack or the card
    ;; table. A table's state stays in memory while the menu is up, so
    ;; CONTINUE (or the same table's entry) returns to it; a table that
    ;; was never opened this run boots from the store. Each frame: poll,
    ;; hand the frame to the screen, draw it.

    (define-struct stage
      (screen default: 'menu)     ; menu | stack | cards
      (menu default: #f)
      (session default: #f)       ; the stack, once opened
      (fx default: #f)
      (deal default: #f)          ; the card table, once opened
      (card-fx default: #f))

    ;; The stack, opened from the store or the flags.
    (define (open-stack a lay seed fresh? texture-first? model)
      (if (stage-session a)
          (stage a screen: 'stack)
          (let ((s (car (boot-session lay seed fresh?))))
            (stage a
                 screen: 'stack
                 session: (session (if model (session-with-model s model) s)
                                   render-mode: (if texture-first?
                                                    'texture
                                                    (session-render-mode s)))
                 fx: (fx-new)))))

    (define (open-cards a seed fresh?)
      (if (stage-deal a)
          (stage a screen: 'cards)
          (stage a
                 screen: 'cards
                 deal: (car (boot-deal seed fresh?))
                 card-fx: (card-fx-new))))

    (define (open-menu a)
      (stage a screen: 'menu menu: (launch-menu #f)))

    ;; A menu choice: which table to open (CONTINUE is the active one).
    (define (choose a choice lay seed fresh? texture-first? model)
      (let ((id (if (eq? choice 'continue) (active-game) choice)))
        (case id
          ((stack) (set-active-game! 'stack)
                   (open-stack a lay seed fresh? texture-first? model))
          ((cards) (set-active-game! 'cards)
                   (open-cards a seed fresh?))
          (else a))))

    (define (step-stack a f dt geom log-keys?)
      (let* ((s (stage-session a))
             (x (fx-frame (stage-fx a) dt))
             (after (save-after-frame!
                      s
                      (session-advance (session-step s f geom)
                                       (clock-steps (fx-clock x)))))
             (x (fx-observe x s after geom)))
        (when log-keys?
          (set! *frame-ms* (* 1000.0 dt))
          (when (pair? (input-frame-pressed f))
            (display "keys: ")
            (write (input-frame-pressed f))
            (display " held: ")
            (write (input-frame-held f))
            (newline)))
        (stage a session: after fx: x)))

    (define (step-cards a f dt geom)
      (let* ((d (stage-deal a))
             (x (card-fx-frame (stage-card-fx a) dt geom))
             (after (save-deal-after-frame!
                      d
                      (deal-advance (deal-step d f geom)
                                    (clock-steps (card-fx-clock x)))))
             (x (card-fx-observe x d after geom)))
        (stage a deal: after card-fx: x)))

    (define (stage-loop seed texture-first? model log-keys? fresh? cards?)
      (lambda ()
        (gfx-setup)
        (set-viewport VW VH)
        (set-letterbox-color 0.0 0.0 0.0)
        (let* ((lay (turtle-layout))
               (geom (make-geometry lay VW VH))
               (card-geom (make-card-geometry VW VH))
               (tex (load-test-tile))
               (open (lambda (a choice)
                       (choose a choice lay seed fresh? texture-first? model))))
          (let loop ((a (if cards?
                            (open-cards (open-menu (stage)) seed fresh?)
                            (open-menu (stage)))))
            ;; wait-frame's dt feeds the fixed clock the effects run on
            (let* ((dt (wait-frame))
                   (f (poll-frame))
                   (click (input-frame-click f))
                   (a (case (stage-screen a)
                        ((menu)
                         (let ((r (menu-step (stage-menu a) f VW VH)))
                           (if (cdr r)
                               (open (stage a menu: (car r)) (cdr r))
                               (stage a menu: (car r)))))
                        ((stack)
                         (cond ((menu-frame? f (and click (hit-control geom (car click) (cdr click))))
                                (open-menu a))
                               ((jack-out? (stage-session a) f VW VH (geometry-hud-h geom))
                                (open-menu a))
                               (else (step-stack a f dt geom log-keys?))))
                        (else
                         (if (menu-frame? f (and click (hit-card-control card-geom (car click) (cdr click))))
                             (open-menu a)
                             (step-cards a f dt card-geom))))))
              (begin-frame)
              (case (stage-screen a)
                ((menu) (draw-menu (stage-menu a) VW VH #f))
                ((stack)
                 (draw-session (stage-session a) geom tex (stage-fx a))
                 (when log-keys?
                   (draw-frame-ms *frame-ms*)))
                (else (draw-deal (stage-deal a) card-geom (stage-card-fx a))))
              (end-frame)
              (cond ((key-pressed? 'escape) (request-quit))
                    ((quit-requested?) #t)
                    (else (loop a))))))
        (gfx-shutdown)))

    (define (native-main . _args)
      (let* ((args (cdr (command-line)))
             (seed-arg (string->number (arg-value args "--seed" "1")))
             ;; seeds are integers; prng-seed folds 0 onto 1, so 0 and 1 deal alike
             (seed (if (and seed-arg
                            (exact? seed-arg)
                            (integer? seed-arg)
                            (>= seed-arg 0))
                       seed-arg
                       1))
             (texture-first? (and (member "--texture" args) #t))
             (model-arg (arg-value args "--keys" #f))
             (model (and model-arg (string->symbol model-arg)))
             (log-keys? (and (member "--log-keys" args) #t))
             (fresh? (and (member "--fresh" args) #t))
             (cards? (and (member "--cards" args) #t)))
        (run-game "Crash The Stack"
                  WINDOW-W
                  WINDOW-H
                  (stage-loop seed texture-first? model log-keys? fresh? cards?))
        0))))
