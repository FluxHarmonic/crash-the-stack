;;; (crash look) - The one look the tiles wear.
;;;
;;; P0's test-tile switch (ruling D4) became P3's sheet switch (ruling
;;; D26: David rules on art through a switch in the game, not by looking
;;; at PNGs), and the switch has done its work: the charcoal face with
;;; sheet A's glyphs and white daemons won (rulings D31 and D32, 2026-09-18:
;;; "might actually feel less like Mahjongg, which is good"; navy, violet,
;;; the light face, sheet B and the textured skins are out). The polish
;;; row (2026-09-20) removed the losing candidates, their assets and every
;;; way of stepping between them (ctrl+t, the TILES tap, the menu's LOOK
;;; entry); what is left is the look as data, so the renderer and the
;;; saves keep one name for it. A save from the switch's days carries any
;;; of the old names; every one of them reads as this look. Data only: no
;;; platform, no drawing.

(define-library (crash look)
  (import (sigil struct))

  (export look look? look-name look-label look-glyphs
          LOOKS LOOK-NAMES DEFAULT-LOOK
          look-ref look-name?)

  (begin
    (define-struct look
      (name default: 'a)
      (label default: "FACES A")
      (glyphs default: 'a))      ; the sheet in (crash glyphs)

    (define LOOKS
      (list (look name: 'a label: "FACES A" glyphs: 'a)))

    (define LOOK-NAMES (map look-name LOOKS))
    (define DEFAULT-LOOK (look-name (car LOOKS)))

    (define (look-name? x)
      (and (memq x LOOK-NAMES) #t))

    ;; The look of that name; an unknown name (an old save's) is the default.
    (define (look-ref name)
      (let loop ((ls LOOKS))
        (cond ((null? ls) (car LOOKS))
              ((eq? (look-name (car ls)) name) (car ls))
              (else (loop (cdr ls))))))))
