;;; (crash look) - The candidate looks David cycles through on the phone.
;;;
;;; P0's test-tile switch (ruling D4), generalized for P3 (ruling D26:
;;; David rules on art through a sheet switch in the game, not by looking
;;; at PNGs). A look names a glyph sheet for the tile faces, the face's
;;; color and the daemons' (roles the renderer maps to the palette; David
;;; 2026-09-18: white daemons are hard to see on the light face, so darker
;;; faces and a violet daemon are candidates), and a tile skin: flat (the
;;; primitives tile) or a texture strip under assets/, with its frame
;;; size, frame count and the width of the side face drawn into each
;;; frame. The list is the set of candidates in the tree, the first entry
;;; the default. ctrl+t, a tap on the TILES counter and the menu's
;;; LOOK entry all step to the next one; the choice is saved under its own
;;; store key so it survives a new deal and a relaunch. Data only: no
;;; platform, no drawing; the shells load the textures, on demand, by path.

(define-library (crash look)
  (import (sigil struct))

  (export look look? look-name look-label look-glyphs look-face look-daemon
          look-texture look-frame-w look-frame-h look-frames look-side
          LOOKS LOOK-NAMES DEFAULT-LOOK
          look-ref look-after look-name? look-textures)

  (begin
    (define-struct look
      (name default: 'flat)
      (label default: "FLAT")    ; the menu entry and the HUD
      (glyphs default: 'keys)    ; keys: the face-key letters; else a sheet in (crash glyphs)
      (face default: 'light)     ; light (C-FACE) | navy (C-WIRE-DARK) | charcoal (C-STATIC-B)
      (daemon default: 'white)   ; white (C-DAEMON) | violet (C-GIBSON)
      (texture default: #f)      ; #f: the primitives tile; else a strip under assets/
      (frame-w default: 32)      ; one frame of the strip: the block with its side face
      (frame-h default: 44)
      (frames default: 1)        ; frame 0 the blank block; frames 1.. drawn faces for faces 0..
      (side default: 3))         ; px of side face inside a frame, left and bottom

    (define LOOKS
      (list (look name: 'a label: "FACES A" glyphs: 'a)
            (look name: 'a-navy label: "A NAVY FACE" glyphs: 'a face: 'navy)
            (look name: 'a-charcoal label: "A CHARCOAL FACE" glyphs: 'a face: 'charcoal)
            (look name: 'a-violet label: "A VIOLET DAEMONS" glyphs: 'a daemon: 'violet)
            (look name: 'b label: "FACES B" glyphs: 'b)
            (look name: 'block label: "BLOCK" glyphs: 'a texture: "assets/tiles/block.png")
            (look name: 'worn label: "WORN" glyphs: 'a texture: "assets/tiles/block-worn.png")
            (look name: 'flat label: "KEYS" glyphs: 'keys)
            (look name: 'test-tile
                  label: "TEST TILE"
                  glyphs: 'keys
                  texture: "assets/test-tile.png"
                  frames: 4
                  side: 4)))

    (define LOOK-NAMES (map look-name LOOKS))
    (define DEFAULT-LOOK (look-name (car LOOKS)))

    ;; Every texture path a look names, once each: what the shells may load.
    (define (look-textures)
      (let loop ((ls LOOKS)
                 (acc '()))
        (cond ((null? ls) (reverse acc))
              ((and (look-texture (car ls)) (not (member (look-texture (car ls)) acc)))
               (loop (cdr ls) (cons (look-texture (car ls)) acc)))
              (else (loop (cdr ls) acc)))))

    (define (look-name? x)
      (and (memq x LOOK-NAMES) #t))

    ;; The look of that name; an unknown name is the default.
    (define (look-ref name)
      (let loop ((ls LOOKS))
        (cond ((null? ls) (car LOOKS))
              ((eq? (look-name (car ls)) name) (car ls))
              (else (loop (cdr ls))))))

    ;; The name after this one, wrapping.
    (define (look-after name)
      (let loop ((names LOOK-NAMES))
        (cond ((null? names) DEFAULT-LOOK)
              ((eq? (car names) name)
               (if (null? (cdr names)) DEFAULT-LOOK (cadr names)))
              (else (loop (cdr names))))))))
