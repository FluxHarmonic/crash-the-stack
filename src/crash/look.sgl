;;; (crash look) - The candidate looks David cycles through on the phone.
;;;
;;; P0's test-tile switch (ruling D4), generalized for P3 (ruling D26:
;;; David rules on art through a sheet switch in the game, not by looking
;;; at PNGs). A look names a glyph sheet for the tile faces and a tile
;;; skin; the list is the set of candidates in the tree, the first entry
;;; the default. ctrl+t, a tap on the TILES counter and the menu's LOOK
;;; entry all step to the next one; the choice is saved under its own
;;; store key so it survives a new deal and a relaunch. Data only: no
;;; platform, no drawing.

(define-library (crash look)
  (import (sigil struct))

  (export look look? look-name look-label look-glyphs look-tile
          LOOKS LOOK-NAMES DEFAULT-LOOK
          look-ref look-after look-name?)

  (begin
    (define-struct look
      (name default: 'flat)
      (label default: "FLAT")    ; the menu entry and the HUD
      (glyphs default: 'keys)    ; keys: the face-key letters; else a sheet in (crash glyphs) (P3)
      (tile default: 'flat))     ; flat: the primitives tile; test-tile: P0's texture

    (define LOOKS
      (list (look name: 'flat label: "FLAT" glyphs: 'keys tile: 'flat)
            (look name: 'test-tile label: "TEST TILE" glyphs: 'keys tile: 'test-tile)))

    (define LOOK-NAMES (map look-name LOOKS))
    (define DEFAULT-LOOK (look-name (car LOOKS)))

    (define (look-name? x)
      (and (memq x LOOK-NAMES) #t))

    ;; The look of that name; an unknown name is the default.
    (define (look-ref name)
      (let loop ((ls LOOKS))
        (cond ((null? ls) (car LOOKS))
              ((eq? (look-name (car ls)) name) (car ls))
              (else (loop (cdr ls))))))

    ;; The name after this one, wrapping.
    (define (look-after name)
      (let loop ((names LOOK-NAMES))
        (cond ((null? names) DEFAULT-LOOK)
              ((eq? (car names) name)
               (if (null? (cdr names)) DEFAULT-LOOK (cadr names)))
              (else (loop (cdr names))))))))
