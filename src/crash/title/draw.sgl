;;; (crash title draw) - Putting the title on screen.
;;;
;;; The model in (crash title) says what is shown at a tick; this draws
;;; it with the block glyphs of (crash font): 8 px square cells, 80
;;; across the 640 viewport, so the logo is crisp at any dpr on both
;;; targets with no font file. The only module of the title that imports
;;; graphics, so the menu can hold a title without reaching graphics
;;; (test/test-imports.sgl holds the rules family to that).
;;;
;;; The shear is applied here, per row: each row's cells move right by
;;; its stair times the tick's shear (see (crash title)), rounded to a
;;; pixel. The backdrop (part B)
;;; goes under everything: the dithered piece the shells load and hand
;;; in, drawn over the whole viewport.

(define-library (crash title draw)
  (import (sigil math)
          (sigil list)
          (sigil graphics)
          (crash font)
          (crash palette)
          (crash title)
          (crash title logo)
          (crash title alphabet)
          (crash title card)
          (crash atlas)
          (crash menu)
          (crash settings)
          (crash credits)
          (crash scores)
          (crash run)
          (only (crash code) code-display CODE-LENGTH))   ; (crash code) has an ALPHABET too, the string; the title's is the glyph vector

  (export title-draw draw-title draw-menu-item draw-menu-items draw-overlay draw-bottom-band title-stamp! menu-prepare!
          title-covers? title-bake! title-diag! title-diag-dial!
          TITLE-CELL TITLE-X TITLE-Y TITLE-H
          BACKDROP-W BACKDROP-H)

  (begin
    (define TITLE-CELL 8)                       ; px, square
    (define TITLE-X 0)
    (define TITLE-Y 8)
    (define TITLE-H (* LOGO-H TITLE-CELL))      ; the logo's height in px

    ;; The backdrop: 320x200 through scripts/art/dither, shipped scaled
    ;; 2x by point so its dots are two texels wide under the sampler's
    ;; linear filter (sigil-graphics offers no nearest sampling).
    (define BACKDROP-W 640)
    (define BACKDROP-H 400)

    ;; The role colors, resolved once from (crash palette)'s table.
    (define ROLE-COLORS
      (list->vector
       (map (lambda (name)
              (let ((entry (assq (string->symbol name) PALETTE)))
                (if entry (cdr entry) C-TEXT)))
            (vector->list LOGO-ROLES))))

    (define (role-color i) (vector-ref ROLE-COLORS i))

    ;; --- doors for David's phone (2026-09-20) --------------------------------
    ;; ?bake=off draws the settled logo and the items cell by cell (the path
    ;; before the bake); ?diag draws an overlay on the menu: each texture
    ;; and render target with its size, how many times each bake ran, and
    ;; how many frames drew the backdrop (his phone at 45ac055 shows the
    ;; card but no backdrop; the arm's SwiftShader shows both).
    (define *bake* #t)
    (define *diag* #f)
    (define (title-bake! on?) (set! *bake* on?))

    ;; The bakes run before the frame's passes, not inside them: a bake is
    ;; a render-target pass, and a pass cannot nest (sokol asserts). With
    ;; SCANLINES on the whole frame draws inside the post pass (P4), so a
    ;; sheet, the logo or a row baked at draw time crashed the process
    ;; (2026-09-21, the first overlay drive with scanlines on by default).
    ;; The shells call menu-prepare! from present!'s prep step for the
    ;; menu or the overlay they are about to draw; once it has run, the
    ;; draw paths bake nothing and fall back to cells for anything not yet
    ;; baked (the next frame's prepare catches it).
    (define *prepared* #f)
    (define (menu-prepare! m)
      (set! *prepared* #t)
      (when *bake*
        (when (menu-live? m)
          (items-bake! (if (eq? (menu-screen m) 'top)
                           (map menu-label (menu-entries m))
                           (screen-labels m))))
        (let ((t (and (eq? (menu-screen m) 'top) (menu-title m))))
          (when (and t (not (title-gated? t)) (not (title-in-card? t)))
            (if (and (title-settled? t) (null? (title-live-glitches t)))
                (logo-bake! t TITLE-CELL)
                (rows-prepare! t TITLE-CELL))))))

    ;; Every completed row with no live glitch on it, baked (the draw's rule).
    (define (rows-prepare! t cell)
      (let ((live (title-live-glitches t))
            (drawn (title-drawn-count t)))
        (let rows ((y 0))
          (when (< y LOGO-H)
            (let* ((extent (title-row-extent y))
                   (width (cdr extent))
                   (in-row (max 0 (min width (- drawn (title-row-start y))))))
              (when (and (= in-row width) (> width 0) (not (row-content-live? y live)))
                (row-bake! t y cell)))
            (rows (+ y 1))))))
    (define (title-diag! on?) (set! *diag* on?))
    (define *logo-bakes* 0)
    (define *items-bakes* 0)
    (define *backdrop-draws* 0)
    (define *frames* 0)
    (define *last-backdrop* #f)
    (define *last-card* #f)
    (define (diag-line! text x y)
      (color! C-BG)
      (draw-filled-rect (- x 2) (- y 1) (+ (text-width text 1) 4) (+ GLYPH-H 2))
      (color! C-TEXT)
      (draw-text text x y 1))
    (define (tex-desc name tex)
      (string-append name " "
                     (cond ((not tex) "NONE")
                           (else (string-append (number->string (texture-width tex)) "X" (number->string (texture-height tex)))))))
    ;; the DIALING phase's cost, set by the shell (title-diag-dial!): starved frames, the longest frame in ms
    (define *diag-dial* (cons 0 0))
    (define (title-diag-dial! underruns worst-ms) (set! *diag-dial* (cons underruns worst-ms)))
    (define (draw-diag backdrop card vw vh)
      (let ((y 126) (x 8))
        (diag-line! (string-append "DIAG FRAME " (number->string *frames*) " BAKE " (if *bake* "ON" "OFF")) x y)
        (diag-line! (tex-desc "TEX BACKDROP" backdrop) x (+ y 10))
        (diag-line! (tex-desc "TEX CARD" card) x (+ y 20))
        (diag-line! (string-append "RT LOGO " (if *logo-rt* (string-append (number->string (render-target-width *logo-rt*)) "X" (number->string (render-target-height *logo-rt*))) "NONE")
                                   " BAKES " (number->string *logo-bakes*)) x (+ y 30))
        (diag-line! (string-append "RT ITEMS " (number->string (length *items-sheets*)) " SHEETS"
                                   " BAKES " (number->string *items-bakes*) " ROWS " (number->string *row-bakes*)) x (+ y 40))
        (diag-line! (string-append "BACKDROP DRAWN " (number->string *backdrop-draws*) " FRAMES") x (+ y 50))
        (diag-line! (string-append "DIAL UNDERRUNS " (number->string (car *diag-dial*)) " WORST " (number->string (cdr *diag-dial*)) " MS") x (+ y 60))))

    ;; Draw the title with the grid's top-left at (x0, y0), cells of cell px.
    ;; A settled title is one frame forever, so it is baked once into a
    ;; render target at 2x (linear sampling under the viewport's scale,
    ;; the way the backdrop is shipped 2x by point) and drawn as one
    ;; texture a frame: the per-cell draw was ~2,000 rectangles a frame
    ;; on the menu, the draw 123 ms against the board's 88 on the arm's
    ;; SwiftShader and the sink starving over the return (measured
    ;; 2026-09-20, David: "the music slows down"). The reveal itself
    ;; still draws cell by cell (it moves).
    (define BAKE-SCALE 2)
    (define BAKE-MARGIN 64)                     ; virtual px past the grid for the shear's overhang
    (define *logo-rt* #f)
    (define *logo-key* #f)                      ; (cell . shear) the target was baked for
    (define (logo-bake! t cell)
      (let ((key (cons cell (title-shear t))))
        (unless (equal? key *logo-key*)
          (when *logo-rt* (render-target-free! *logo-rt*))
          (let ((rt (make-render-target (* BAKE-SCALE (+ (* LOGO-W cell) BAKE-MARGIN))
                                        (* BAKE-SCALE LOGO-H cell)
                                        'linear)))
            (with-render-target rt
              (set-blend-mode 'none)
              (title-draw-cells t 0 0 (* BAKE-SCALE cell)))
            (set-blend-mode 'normal)
            (set! *logo-rt* rt)
            (rows-free!)
            (set! *logo-bakes* (+ 1 *logo-bakes*))
            (set! *logo-key* key)))
        *logo-rt*))
    (define (title-draw t x0 y0 cell)
      (if (and *bake* (title-settled? t) (null? (title-live-glitches t))
               (or (not *prepared*) (equal? (cons cell (title-shear t)) *logo-key*)))
          (let ((rt (logo-bake! t cell))
                (w (+ (* LOGO-W cell) BAKE-MARGIN))
                (h (* LOGO-H cell)))
            (color! C-TEX-PLAIN)
            (draw-render-target rt x0 y0 w h))
          (title-draw-cells t x0 y0 cell #t)))

    ;; --- the reveal's rows, baked as they complete -----------------------------
    ;;
    ;; David on the phone (2026-09-20): the typing beeps lag, because the
    ;; in-progress logo was redrawn from the grid as rectangles every reveal
    ;; frame (up to ~2,000 native calls, each an allocation on wasm) while
    ;; the settled logo was baked. Now each row is baked into its own small
    ;; render target the first time it is complete with no content glitch
    ;; live on it, and drawn as one textured region from then on; the row
    ;; being typed and any row a live glitch touches (a wrong character or
    ;; color, an inversion, the noise on a shadow row) draw as rectangles
    ;; that frame. A shift glitch and the slam's shear only move a row, so
    ;; they translate the baked region. The targets are freed when the
    ;; settled logo bakes whole.
    (define *row-rts* #f)                        ; a vector of (rt . texture) per row, or #f, made on first use
    (define (row-rts) (or *row-rts* (begin (set! *row-rts* (make-vector LOGO-H #f)) *row-rts*)))
    (define (row-content-live? y live)
      (let loop ((gs live))
        (cond ((null? gs) #f)
              ((let ((g (car gs)))
                 (case (glitch-kind g)
                   ((wrong-char wrong-color) (= (glitch-row g) y))
                   ((noise) (= (glitch-row g) (- y 1)))
                   ((invert) (and (>= y (glitch-row g)) (< y (+ (glitch-row g) 6))))
                   (else #f)))
               #t)
              (else (loop (cdr gs))))))
    (define (row-bake! t y cell)
      (or (vector-ref (row-rts) y)
          (let* ((w (* BAKE-SCALE LOGO-W cell))
                 (h (* BAKE-SCALE cell))
                 (rt (make-render-target w h 'linear)))
            (with-render-target rt
              (set-blend-mode 'none)
              (draw-row-cells t y 0 0 (* BAKE-SCALE cell) '() (cdr (title-row-extent y)) 0 0))
            (set-blend-mode 'normal)
            (let ((entry (cons rt (render-target->texture rt))))
              (vector-set! (row-rts) y entry)
              (set! *row-bakes* (+ 1 *row-bakes*))
              entry))))
    (define (rows-free!)
      (let loop ((y 0))
        (when (< y LOGO-H)
          (let ((entry (vector-ref (row-rts) y)))
            (when entry (render-target-free! (car entry)) (vector-set! (row-rts) y #f)))
          (loop (+ y 1)))))
    (define *row-bakes* 0)

    ;; Row y's cells from its extent's start, in-row of them, as rectangles
    ;; at (x0 + (x + dx) cell + shear-px, py); live is the glitch list.
    (define (draw-row-cells t y x0 py cell live in-row dx shear-px)
      (let* ((extent (title-row-extent y))
             (xa (car extent))
             (xb (+ xa in-row)))
        (let cols ((x xa))
          (when (< x xb)
            (let ((shown (title-shown-cell t x y live)))
              (when shown
                (let ((px (+ x0 (* (+ x dx) cell) shear-px)))
                  (when (caddr shown)
                    (color! (role-color (caddr shown)))
                    (draw-filled-rect px py cell cell))
                  (when (cadr shown)
                    (color! (role-color (cadr shown)))
                    (draw-block (car shown) px py cell)))))
            (cols (+ x 1))))))

    ;; The title cell by cell, rows-rt? allowing a completed row to come
    ;; from its baked target (off inside the whole-logo bake).
    (define (title-draw-cells t x0 y0 cell . rest)
      (let* ((rows-rt? (and (pair? rest) (car rest) *bake*))
             (live (title-live-glitches t))
             (drawn (title-drawn-count t))
             (tick (title-tick t))
             (cursor-row (title-cursor-row t)))
        (let rows ((y 0))
          (when (< y LOGO-H)
            (let* ((extent (title-row-extent y))
                   (xa (car extent))
                   (width (cdr extent))
                   (in-row (max 0 (min width (- drawn (title-row-start y)))))
                   (xb (+ xa in-row))
                   (dx (title-row-shift y live))
                   (shear-px (exact (round (* cell (title-row-shear t y)))))
                   (py (+ y0 (* y cell))))
              (if (and rows-rt? (= in-row width) (> width 0) (not (row-content-live? y live))
                       (or (not *prepared*) (vector-ref (row-rts) y)))
                  (let ((entry (row-bake! t y cell))
                        (w (* LOGO-W cell)))
                    (color! C-TEX-PLAIN)
                    (draw-texture-region (cdr entry) (+ x0 (* dx cell) shear-px) py w cell
                                         0 (* BAKE-SCALE cell) (* BAKE-SCALE w) (- (* BAKE-SCALE cell))))
                  (draw-row-cells t y x0 py cell live in-row dx shear-px))
              ;; the cursor: a block leading the draw, blinking, on the
              ;; row being drawn
              (when (and cursor-row (= cursor-row y) (cursor-on? tick))
                (color! C-TEXT)
                (draw-filled-rect (+ x0 (* (+ xb dx) cell) shear-px) py cell cell)))
            (rows (+ y 1))))))



    ;; --- text in the block alphabet (ruling D41) ------------------------------------
    ;;
    ;; The menu's items are set in the logo's own alphabet at ITEM-CELL
    ;; (4 px: half the logo's cell, a quarter-cell dot of 1 px, which is
    ;; two or three device pixels on the phone), the way a DOOM menu reuses
    ;; its title font. Letters are 7 cells wide with one between, a space
    ;; three; a one-cell shadow in the static dark, a solid cell (a ▒ at a
    ;; 1 px dot is eight rectangles; five items cast 4,448 of them and the
    ;; menu frame ran to 8,400 rectangles against sokol_gp's 10,922, four
    ;; times the board's, which is what bogged the laptop down: measured
    ;; by count, 2026-09-19), is cast into every
    ;; empty cell down-right of a lit one, then the letters go over it.
    ;; A ramp item takes the logo's hero ramp row by row (A A ▓ ▒ ░ B, the
    ;; spec's `rows`); a flat item is one color.
    (define ITEM-CELL 4)
    (define ITEM-RAMP (list 'a 'a #\3 #\2 #\1 'b))

    ;; the alphabet as an alist of one-char strings to their six rows
    (define GLYPHS-BY-CHAR
      (map (lambda (g) (cons (string-ref (car g) 0) (cdr g)))
           (vector->list ALPHABET)))

    (define (block-glyph ch)
      (let ((entry (assv (char-upcase ch) GLYPHS-BY-CHAR)))
        (and entry (cdr entry))))

    ;; the width of a string in cells: letters 7 + 1, a space 3 + 1, no gap after the last
    (define (block-text-width text)
      (let loop ((cs (string->list text)) (w 0))
        (if (null? cs)
            (max 0 (- w 1))
            (loop (cdr cs) (+ w (if (char=? (car cs) #\space) 4 8))))))

    ;; the cell of a glyph at (r, c), space outside the box
    (define (glyph-code rows r c)
      (if (or (< r 0) (>= r ALPHABET-H) (< c 0) (>= c ALPHABET-W))
          #\space
          (string-ref (list-ref rows r) c)))

    ;; Draw text with its top-left at (x, y) in cells of cell px; style
    ;; 'ramp (the hero ramp) or 'flat (C-LABEL-LIT).
    (define (draw-block-text text x y cell style)
      (let loop ((cs (string->list text)) (x x))
        (unless (null? cs)
          (let ((rows (and (not (char=? (car cs) #\space)) (block-glyph (car cs)))))
            (when rows
              ;; the shadow, into empty cells down-right of lit ones
              (color! C-STATIC-B)
              (let sr ((r 0))
                (when (< r ALPHABET-H)
                  (let sc ((c 0))
                    (when (< c ALPHABET-W)
                      (when (and (not (char=? (glyph-code rows r c) #\space))
                                 (char=? (glyph-code rows (+ r 1) (+ c 1)) #\space))
                        (draw-block #\# (+ x (* (+ c 1) cell)) (+ y (* (+ r 1) cell)) cell))
                      (sc (+ c 1))))
                  (sr (+ r 1))))
              ;; the letter
              (let lr ((r 0))
                (when (< r ALPHABET-H)
                  (let ((token (if (eq? style 'ramp) (list-ref ITEM-RAMP r) 'flat)))
                    (let lc ((c 0))
                      (when (< c ALPHABET-W)
                        (let ((code (glyph-code rows r c))
                              (px (+ x (* c cell)))
                              (py (+ y (* r cell))))
                          (unless (char=? code #\space)
                            (cond ((eq? token 'flat)
                                   (color! C-LABEL-LIT)
                                   (draw-block code px py cell))
                                  ((char=? code #\#)
                                   (cond ((eq? token 'a) (color! C-SELECTED) (draw-block #\# px py cell))
                                         ((eq? token 'b) (color! C-HIGHLIGHT) (draw-block #\# px py cell))
                                         (else (color! C-HIGHLIGHT)
                                               (draw-block #\# px py cell)
                                               (color! C-SELECTED)
                                               (draw-block token px py cell))))
                                  (else
                                   ;; a half block takes the row's ink: A over ▓ and ▒, B under
                                   (color! (if (or (eq? token 'a) (eqv? token #\3) (eqv? token #\2)) C-SELECTED C-HIGHLIGHT))
                                   (draw-block code px py cell)))))
                        (lc (+ c 1)))))
                  (lr (+ r 1))))))
          (loop (cdr cs) (+ x (* cell (if (char=? (car cs) #\space) 4 8)))))))

    ;; --- the menu's items (rulings D39 and D41) -------------------------------
    ;;
    ;; Set in the block alphabet at ITEM-CELL, no box (David: "we can't
    ;; really see the tower behind the menu"): the selected item in the
    ;; logo's hero ramp, the others flat C-LABEL-LIT, every one with the
    ;; one-cell shadow, and a block cursor at the selected item's left,
    ;; blinking with the reveal's cursor. Centered in the rect the menu
    ;; keeps as the tap target. The 5x7 font at 2x with a shadow was the
    ;; fallback if the block letters did not read at item size; they do.
    ;;
    ;; The items are baked once into a sheet (a render target at 2x, one
    ;; row per item per style: flat, then ramp) and each is one textured
    ;; rectangle a frame: drawn cell by cell they were ~1,000 rectangles a
    ;; frame, and on the web every native call allocates (~130 KB a frame
    ;; in the menu's draw, 105 minor collections a 120-frame window,
    ;; measured 2026-09-20 on the return's slowdown). A label the sheet
    ;; does not hold (CONNECTING n/m, which changes) draws directly.
    (define ITEM-H (* ITEM-CELL (+ ALPHABET-H 1)))   ; a row of the sheet: the letters and the shadow's cell
    ;; The labels are baked in sheets of SHEET-LABELS each (a flat and a
    ;; ramp row per label), ONE SHEET PER FRAME: a label drawn cell by cell
    ;; is ~200 rectangles a style, sgp's vertex buffer is 65,536 vertices
    ;; a frame across every pass, and a SETTINGS screen's 31 labels in one
    ;; frame overran it (sg_append_buffer, 2026-09-20); a render target's
    ;; pass clears on entry, so a sheet cannot be filled over several
    ;; frames either. A label whose sheet is not baked yet draws directly
    ;; for those frames. One sheet also stays under the 4096 px a target
    ;; may have.
    (define SHEET-LABELS 8)
    (define *items-sheets* '())                       ; ((rt . tex) ...), one per SHEET-LABELS labels, in order
    (define *items-tex* #f)                           ; the first sheet's texture (draw-menu-item's "anything baked" test)
    (define *items-key* #f)                           ; the labels the sheets are for, in order
    (define *items-h* 0)                              ; a sheet's height in virtual px
    (define *items-w* 0)                              ; a sheet's width in virtual px
    (define (items-bake! labels)
      (unless (equal? labels *items-key*)
        (for-each (lambda (s) (render-target-free! (car s))) *items-sheets*)
        (set! *items-sheets* '())
        (set! *items-tex* #f)
        (set! *items-w* (+ ITEM-CELL (* ITEM-CELL (fold (lambda (m l) (max m (block-text-width l))) 0 labels))))
        (set! *items-h* (* ITEM-H 2 SHEET-LABELS))
        (set! *items-key* labels))
      ;; the next sheet, when one is missing
      (let* ((baked (length *items-sheets*))
             (ls (list-tail* labels (* baked SHEET-LABELS))))
        (when (pair? ls)
          (let ((rt (make-render-target (* BAKE-SCALE *items-w*) (* BAKE-SCALE *items-h*) 'linear)))
            (with-render-target rt
              (set-blend-mode 'none)
              (let loop ((ls ls) (i 0))
                (unless (or (null? ls) (= i SHEET-LABELS))
                  (draw-block-text (car ls) 0 (* BAKE-SCALE ITEM-H 2 i) (* BAKE-SCALE ITEM-CELL) 'flat)
                  (draw-block-text (car ls) 0 (* BAKE-SCALE ITEM-H (+ 1 (* 2 i))) (* BAKE-SCALE ITEM-CELL) 'ramp)
                  (loop (cdr ls) (+ i 1)))))
            (set-blend-mode 'normal)
            (set! *items-bakes* (+ 1 *items-bakes*))
            (set! *items-sheets* (append *items-sheets* (list (cons rt (render-target->texture rt)))))
            (set! *items-tex* (cdr (car *items-sheets*)))))))

    (define (list-tail* l n)
      (if (or (= n 0) (null? l)) l (list-tail* (cdr l) (- n 1))))

    ;; The item's sheet row (index, or #f to draw it directly) at (tx, ty):
    ;; the region flipped on read, the target being bottom-up (the same
    ;; flip (crash atlas) and the tiles' sheet make).
    (define (draw-item-row index style tx ty tw)
      (let* ((sheet (list-ref *items-sheets* (quotient index SHEET-LABELS)))
             (row (modulo index SHEET-LABELS))
             (cy (* ITEM-H (+ (* 2 row) (if (eq? style 'ramp) 1 0))))
             (cw (+ tw ITEM-CELL)))
        (color! C-TEX-PLAIN)
        (draw-texture-region (cdr sheet) tx ty cw ITEM-H
                             0 (* BAKE-SCALE (- *items-h* cy)) (* BAKE-SCALE cw) (- (* BAKE-SCALE ITEM-H)))))

    (define (draw-menu-item label rect lit? frames . rest)
      (let* ((index (and (pair? rest) (car rest)))
             (x (car rect)) (y (cadr rect)) (w (caddr rect)) (h (cadddr rect))
             (tw (* ITEM-CELL (block-text-width label)))
             (th (* ITEM-CELL ALPHABET-H))
             (tx (+ x (quotient (- w tw) 2)))
             (ty (+ y (quotient (- h th ITEM-CELL) 2))))
        (if (and *bake* index *items-tex*)
            (draw-item-row index (if lit? 'ramp 'flat) tx ty tw)
            (draw-block-text label tx ty ITEM-CELL (if lit? 'ramp 'flat)))
        (when (and lit? (cursor-on? frames))
          (color! C-SELECTED)
          (draw-filled-rect (- tx (* 3 ITEM-CELL) (* ALPHABET-W ITEM-CELL)) ty
                            (* ALPHABET-W ITEM-CELL) th))))

    ;; The menu's items, or the boot's CONNECTING line (ruling D40): the
    ;; items only once the menu is live (the reveal settled, every boot
    ;; step done); while the reveal runs, nothing (it is the cover); once
    ;; it has settled with steps still running, CONNECTING with the boot's
    ;; progress and the blinking cursor where the first item will be.
    ;; A sub-screen (P4) draws its heading where the logo was, its rows
    ;; under it (a value row's name left and value right), and its own
    ;; content: the credits' pages, the scoreboard, the code entry.
    (define (draw-menu-items m vw vh)
      (draw-menu-items* m vw vh)
      (when *diag* (draw-diag *last-backdrop* *last-card* vw vh)))
    (define (draw-menu-items* m vw vh)
      (cond ((menu-live? m)
             (if (eq? (menu-screen m) 'top)
                 (draw-top-screen m vw vh)
                 (draw-sub-screen m vw vh)))
            ((and (menu-title m) (title-settled? (menu-title m)))
             (let* ((p (boot-progress))
                    (label (string-append "CONNECTING "
                                          (number->string (car p))
                                          "/"
                                          (number->string (cdr p)))))
               (draw-menu-item label (menu-entry-rect m 0 vw vh) #t (menu-frames m))))
            (else #f)))

    ;; The index of a label on the baked sheets, or #f when it is not
    ;; there yet (drawn directly then).
    (define (label-index label)
      (and *items-key*
           (let loop ((ls *items-key*) (i 0))
             (cond ((null? ls) #f)
                   ((>= i (* SHEET-LABELS (length *items-sheets*))) #f)
                   ((string=? (car ls) label) i)
                   (else (loop (cdr ls) (+ i 1)))))))

    (define (draw-top-screen m vw vh)
      (let ((labels (map menu-label (menu-entries m))))
        (when (and *bake* (not *prepared*)) (items-bake! labels))
        (let loop ((ls labels) (i 0))
          (unless (null? ls)
            (draw-menu-item (car ls)
                            (menu-entry-rect m i vw vh)
                            (= i (menu-highlight m))
                            (menu-frames m)
                            (label-index (car ls)))
            (loop (cdr ls) (+ i 1))))
        ;; the live board's share code (P4), with COPY on the web
        (let ((r (code-line-rect m vw vh)))
          (when r
            (let* ((line (string-append "CODE " (code-display (menu-code-line m)) (if (menu-copy m) "  [COPY]" "")))
                   (x (quotient (- vw (text-width line 1)) 2)))
              (color! C-STATIC-B)
              (text! line (+ x 1) (+ (cadr r) 5) 1)
              (color! C-LABEL-LIT)
              (text! line x (+ (cadr r) 4) 1))))))

    ;; The labels a sub-screen's sheet holds: the heading, every row's
    ;; name, and every value a row can show, so stepping a value never
    ;; re-bakes (a bake is a 300 ms frame on the phone).
    (define (screen-labels m)
      (let ((ids (menu-entries m)))
        (append (list (or (menu-heading m) ""))
                (map menu-label ids)
                (apply append
                       (map (lambda (id)
                              (cond ((eq? id 'version) (list "HACKER" "ORIGINAL"))
                                    ((setting-ref id)
                                     (map (lambda (v) (setting-value-label id v))
                                          (setting-values (setting-ref id))))
                                    (else '())))
                            ids)))))

    (define (draw-sub-screen m vw vh)
      (when (and *bake* (not *prepared*)) (items-bake! (screen-labels m)))
      ;; the heading, in the ramp, where the logo was
      (let* ((heading (or (menu-heading m) ""))
             (tw (* ITEM-CELL (block-text-width heading)))
             (tx (quotient (- vw tw) 2)))
        (if (and *bake* *items-tex* (label-index heading))
            (draw-item-row (label-index heading) 'ramp tx HEADING-Y tw)
            (draw-block-text heading tx HEADING-Y ITEM-CELL 'ramp)))
      ;; the rows
      (let loop ((ids (menu-entries m)) (i 0))
        (unless (null? ids)
          (let* ((id (car ids))
                 (rect (menu-entry-rect m i vw vh))
                 (lit? (= i (menu-highlight m)))
                 (value (menu-row-value m id)))
            (if value
                (draw-value-row (menu-label id) value rect lit? (menu-frames m) (menu-row-note m id))
                (begin
                  (draw-menu-item (menu-label id) rect lit? (menu-frames m) (label-index (menu-label id)))
                  ;; an item's note (the overlay's exit row: what leaving keeps) under it, centered
                  (let ((note (menu-row-note m id)))
                    (when note
                      (color! C-TEXT-DIM)
                      (text! note (quotient (- vw (text-width note 1)) 2) (+ (cadr rect) (cadddr rect) 1) 1))))))
          (loop (cdr ids) (+ i 1))))
      ;; the screen's content, on a panel in the band's style where it is text
      ;; (solid C-BG with a C-BAR-C rule: the backdrop is busy under the
      ;; credits' lines, and the bible keeps alpha for the glow and the veil)
      (when (memq (menu-screen m) (list 'credits 'scores 'code 'run-done))
        (color! C-BAR-C)
        (draw-filled-rect 8 (- TEXT-Y 9) (- vw 16) (- TEXT-ROWS-Y TEXT-Y 2))
        (color! C-BG)
        (draw-filled-rect 9 (- TEXT-Y 8) (- vw 18) (- TEXT-ROWS-Y TEXT-Y 4)))
      (case (menu-screen m)
        ((credits) (draw-credits m vw vh))
        ((scores) (draw-scores m vw vh))
        ((code) (draw-code-entry m vw vh))
        ((run-done) (draw-run-done m vw vh))
        (else #f)))

    ;; A value row: the name at the row's left, the value right-aligned
    ;; at its right, both in the ramp when highlighted, the cursor at the
    ;; name's left.
    ;; note: a word in the 5x7 beside the value (GAME SETTINGS says when
    ;; a change takes: NEXT DEAL or NOW), or #f.
    (define (draw-value-row name value rect lit? frames . rest)
      (let* ((note (and (pair? rest) (car rest)))
             (x (car rect))
             (y (cadr rect))
             (w (caddr rect))
             (h (cadddr rect))
             (th (* ITEM-CELL ALPHABET-H))
             (ty (+ y (quotient (- h th ITEM-CELL) 2)))
             (nw (* ITEM-CELL (block-text-width name)))
             (vw* (* ITEM-CELL (block-text-width value)))
             (nx (+ x (* 11 ITEM-CELL)))   ; room for the cursor block (7 cells) and its gap (3) at the left
             (vx (- (+ x w) vw*))
             (style (if lit? 'ramp 'flat))
             (draw (lambda (label tx tw)
                     (let ((i (label-index label)))
                       (if (and *bake* i *items-tex*)
                           (draw-item-row i style tx ty tw)
                           (draw-block-text label tx ty ITEM-CELL style))))))
        (draw name nx nw)
        (draw value vx vw*)
        (when note
          (color! C-TEXT-DIM)
          (text! note (- vx (text-width note 1) 12) (+ ty (quotient (- th GLYPH-H) 2)) 1))
        (when (and lit? (cursor-on? frames))
          (color! C-SELECTED)
          (draw-filled-rect (- nx (* 3 ITEM-CELL) (* ALPHABET-W ITEM-CELL)) ty
                            (* ALPHABET-W ITEM-CELL) th))))

    ;; The table's overlay (ruling D51): the paused table's own menu on a
    ;; solid panel (the text screens' style: C-BG with a C-BAR-C rule) from
    ;; the top of the viewport to bottom (the HUD bar's top: the bar stays
    ;; visible with its meter frozen), the heading and rows as any
    ;; sub-screen draws them.
    (define (draw-overlay m vw vh bottom)
      (color! C-BAR-C)
      (draw-filled-rect 8 8 (- vw 16) (- bottom 12))
      (color! C-BG)
      (draw-filled-rect 9 9 (- vw 18) (- bottom 14))
      (draw-sub-screen m vw vh))

    ;; --- the text screens ------------------------------------------------------------

    ;; Text at scale 2 fits 50 characters in the 600 px between the gutters.
    (define TEXT-SCALE 2)
    (define TEXT-WIDTH 50)
    (define TEXT-X 20)
    (define TEXT-Y 56)
    (define TEXT-PITCH 16)

    ;; The credits (D44): the page's lines, headings lit; the page
    ;; indicator under them.
    (define (draw-credits m vw vh)
      (let loop ((lines (credits-lines (menu-page m) TEXT-WIDTH *stamp*)) (y TEXT-Y))
        (unless (null? lines)
          (let ((style (car (car lines))) (text (cdr (car lines))))
            (unless (eq? style 'gap)
              (color! (if (eq? style 'heading) C-LABEL-LIT C-TEXT))
              (text! text TEXT-X y TEXT-SCALE)))
          (loop (cdr lines) (+ y TEXT-PITCH))))
      (let ((line (string-append "PAGE " (number->string (+ 1 (menu-page m))) "/" (number->string CREDITS-PAGES) "  LEFT/RIGHT TURNS")))
        (color! C-TEXT-DIM)
        (text! line (- vw TEXT-X (text-width line 1)) (- TEXT-ROWS-Y 12) 1)))

    ;; The build's commit for the version line: the shells set it.
    (define *stamp* "unversioned")
    (define (title-stamp! text) (set! *stamp* text))

    ;; m:ss of a tick count at 60 a second.
    (define (clock-text ticks)
      (let* ((s (quotient ticks 60))
             (m (quotient s 60))
             (r (modulo s 60)))
        (string-append (number->string m) ":" (if (< r 10) "0" "") (number->string r))))

    ;; The scoreboard: one row per table x version with the best time,
    ;; the fewest moves and the clears, then each table's daily streak.
    (define (draw-scores m vw vh)
      (let ((s (menu-scores m))
            (col (lambda (i) (+ TEXT-X (* i 12 10)))))   ; five columns of ten characters
        (color! C-LABEL-LIT)
        (text! "TABLE" (col 0) TEXT-Y TEXT-SCALE)
        (text! "VERSION" (col 1) TEXT-Y TEXT-SCALE)
        (text! "TIME" (col 2) TEXT-Y TEXT-SCALE)
        (text! "MOVES" (col 3) TEXT-Y TEXT-SCALE)
        (text! "CLEARS" (col 4) TEXT-Y TEXT-SCALE)
        (let loop ((cells (list (list 'stack 'hacker "STACK" "HACKER")
                                (list 'stack 'original "STACK" "ORIGINAL")
                                (list 'cards 'hacker "DEFRAG" "HACKER")
                                (list 'cards 'original "DEFRAG" "ORIGINAL")))
                   (y (+ TEXT-Y (* 2 TEXT-PITCH))))
          (unless (null? cells)
            (let* ((c (car cells))
                   (best (and s (scores-best s (car c) (cadr c)))))
              (color! C-TEXT)
              (text! (caddr c) (col 0) y TEXT-SCALE)
              (text! (cadddr c) (col 1) y TEXT-SCALE)
              (color! (if best C-TEXT C-TEXT-DIM))
              (text! (if best (clock-text (car best)) "-") (col 2) y TEXT-SCALE)
              (text! (if best (number->string (cadr best)) "-") (col 3) y TEXT-SCALE)
              (text! (if best (number->string (caddr best)) "0") (col 4) y TEXT-SCALE))
            (loop (cdr cells) (+ y TEXT-PITCH))))
        (let ((y (+ TEXT-Y (* 7 TEXT-PITCH))))
          (color! C-LABEL-LIT)
          (text! "DAILY STREAK" (col 0) y TEXT-SCALE)
          (color! C-TEXT)
          (text! (string-append "STACK " (number->string (if s (scores-streak s 'stack) 0)))
                 (col 0) (+ y TEXT-PITCH) TEXT-SCALE)
          (text! (string-append "DEFRAG " (number->string (if s (scores-streak s 'cards) 0)))
                 (col 2) (+ y TEXT-PITCH) TEXT-SCALE))))

    ;; The code entry: the typed characters at scale 3 with a blinking
    ;; cursor block, the keypad (the alphabet, DEL, GO) as boxes with
    ;; their labels at scale 2, the refusal line when the last GO was
    ;; refused.
    (define (draw-code-entry m vw vh)
      (let* ((shown (menu-code-display m))
             (scale 3)
             (tw (text-width shown scale))
             (full (text-width "XXXXX-XXXXX" scale))
             (x (quotient (- vw full) 2))
             (y 72))
        (color! C-TEXT-DIM)
        (draw-filled-rect (- x 8) (- y 6) (+ full 16) (+ (* GLYPH-H scale) 12))
        (color! C-BG)
        (draw-filled-rect (- x 6) (- y 4) (+ full 12) (+ (* GLYPH-H scale) 8))
        (color! C-LABEL-LIT)
        (text! shown x y scale)
        (when (and (< (string-length (menu-code m)) CODE-LENGTH) (cursor-on? (menu-frames m)))
          (color! C-SELECTED)
          (draw-filled-rect (+ x tw (if (> tw 0) scale 0)) y (* GLYPH-W scale) (* GLYPH-H scale)))
        (color! C-TEXT-DIM)
        (let ((hint "TYPE OR TAP A CODE. ENTER OR GO DEALS IT."))
          (text! hint (quotient (- vw (text-width hint 1)) 2) (+ y (* GLYPH-H scale) 14) 1))
        (for-each (lambda (cell)
                    (let* ((label (car cell))
                           (r (cdr cell))
                           (cx (car r))
                           (cy (cadr r))
                           (cw (caddr r))
                           (ch (cadddr r))
                           (lw (text-width label TEXT-SCALE)))
                      (color! C-BAR-C)
                      (draw-filled-rect cx cy cw ch)
                      (color! C-TEXT)
                      (text! label (+ cx (quotient (- cw lw) 2)) (+ cy (quotient (- ch (* GLYPH-H TEXT-SCALE)) 2)) TEXT-SCALE)))
                  (keypad-cells vw vh))))

    ;; RUN COMPLETE (JACK IN, P4): the ledger and the run's share code.
    ;; (menu-run m) is (run . code).
    (define (draw-run-done m vw vh)
      (let* ((entry (menu-run m))
             (r (and entry (car entry)))
             (code (and entry (cdr entry)))
             (l (and r (run-ledger r)))
             (row (lambda (i label value)
                    (let ((y (+ TEXT-Y (* i TEXT-PITCH))))
                      (color! C-TEXT-DIM)
                      (text! label (+ TEXT-X 60) y TEXT-SCALE)
                      (color! C-TEXT)
                      (text! value (+ TEXT-X 300) y TEXT-SCALE)))))
        (when l
          (color! C-LABEL-LIT)
          (text! "THE STACK IS DOWN. LINK CLOSED." TEXT-X TEXT-Y TEXT-SCALE)
          (row 2 "LAYERS" (string-append (number->string (ledger-cleared l)) "/" (number->string (run-layer-count))))
          (row 3 "TIME" (clock-text (ledger-ticks l)))
          (row 4 "MOVES" (number->string (ledger-moves l)))
          (row 5 "RECONNECTS" (number->string (ledger-reconnects l)))
          (row 7 "RUN CODE" (if code (code-display code) "-")))))

    (define PRESENTS-LINE "PRESENTS")   ; under the publisher card's mark, with the resolve

    ;; The bottom band (P4, [[t-1c53b6]]): a C-BG strip over the
    ;; backdrop's last rows holding the copyright (ruling D44: the holder
    ;; is David, the brand publishes, nothing else on the title), the key
    ;; hint and the build stamp, all in the 5x7 at scale 1 on two rows: the
    ;; copyright above, the hint and the stamp below. Off the image, so no
    ;; orange band swallows it (David's read of abdce9f).
    (define BAND-H 24)
    (define TITLE-LINE "(C) 2026 DAVID WILSON - FLUX HARMONIC")
    (define (draw-bottom-band vw vh hint version)
      (let ((top (- vh BAND-H))
            (y1 (- vh 22))
            (y2 (- vh 11)))
        (color! C-BG)
        (draw-filled-rect 0 top vw BAND-H)
        (color! C-LABEL-LIT)
        (text! TITLE-LINE (quotient (- vw (text-width TITLE-LINE 1)) 2) y1 1)
        (color! C-TEXT-DIM)
        (text! hint 8 y2 1)
        (when version
          (text! version (- vw 8 (text-width version 1)) y2 1))))

    ;; text through P3c's atlas when it is on (one textured rectangle a
    ;; glyph), else (crash font)'s rectangles, the oracle the atlas leg
    ;; holds it to (the same switch as render.sgl's)
    (define (text! text x y scale)
      (if (atlas-on?) (atlas-text text x y scale) (draw-text text x y scale)))

    ;; Is the title's own screen up (the gate or the card), covering the
    ;; menu's chrome? The footer stays off it.
    (define (title-covers? t)
      (and t (or (title-gated? t) (title-in-card? t)) #t))   ; dialing is in-card at tick 0

    ;; The title screen's top: the publisher card while it runs (ruling
    ;; D43: the strip's frame for this tick over C-BG, black until the
    ;; shell has the strip), the gate's boot screen while gated (ruling
    ;; D42: black, the block cursor blinking at the modem cadence, the
    ;; line in the 5x7); else the backdrop, when the shell has it loaded,
    ;; then the logo on its grid. t may be #f (a menu built without one).
    ;; rest: the backdrop texture, then the card strip texture; either
    ;; may be #f or missing.
    (define (draw-title t vw vh . rest)
      (let ((backdrop (and (pair? rest) (car rest)))
            (card (and (pair? rest) (pair? (cdr rest)) (cadr rest))))
        (cond ((and t (title-dialing? t))
               ;; DIALING (ruling D45): black, the line where the gate's was, and
               ;; under it a meter of the boot's steps, one block cell each, the
               ;; done ones solid in the items' flat color, the rest a dotted
               ;; cell in the dim text color
               (color! C-BG)
               (draw-filled-rect 0 0 vw vh)
               (let* ((line "DIALING...")
                      (scale 2)
                      (tw (text-width line scale))
                      (x (quotient (- vw tw) 2))
                      (y (quotient (- vh (* GLYPH-H scale)) 2))
                      (p (title-dial-shown t))   ; the boot's progress, climbing over the screen's minimum second
                      (done (car p))
                      (total (max 1 (cdr p)))
                      (cell 8)
                      (gap 2)
                      (mw (- (* total (+ cell gap)) gap))
                      (mx (quotient (- vw mw) 2))
                      (my (+ y (* GLYPH-H scale) 8)))
                 (color! C-TEXT)
                 (draw-text line x y scale)
                 (let loop ((i 0))
                   (when (< i total)
                     (cond ((< i done) (color! C-LABEL-LIT) (draw-block #\# (+ mx (* i (+ cell gap))) my cell))
                           (else (color! C-TEXT-DIM) (draw-block #\1 (+ mx (* i (+ cell gap))) my cell)))
                     (loop (+ i 1))))))
              ((and t (title-in-card? t))
               (color! C-BG)
               (draw-filled-rect 0 0 vw vh)
               (let ((f (title-card-frame t CARD-FRAMES)))
                 (when (and card (> f 0))
                   (color! C-TEX-PLAIN)
                   (draw-texture-region card 0 0 vw vh
                                        (* (- f 1) CARD-FRAME-W) 0 CARD-FRAME-W CARD-FRAME-H))
                 ;; PRESENTS under the mark, with the resolve (David, 2026-09-20):
                 ;; the 5x7 at scale 2 in the items' flat color, centered under
                 ;; the mark's box (CARD-BOX is at 1x; the frame is 2x)
                 (when (= f CARD-FRAMES)
                   (let* ((scale 2)
                          (tw (text-width PRESENTS-LINE scale))
                          (box-bottom (* 2 (+ (vector-ref CARD-BOX 1) (vector-ref CARD-BOX 3)))))
                     (color! C-LABEL-LIT)
                     (draw-text PRESENTS-LINE (quotient (- vw tw) 2) (+ box-bottom 12) scale)))))
              ((and t (title-gated? t))
               (color! C-BG)
               (draw-filled-rect 0 0 vw vh)
               (let* ((line (or (title-gate-line t) "TAP TO CONNECT"))
                      (scale 2)
                      (tw (text-width line scale))
                      (x (quotient (- vw tw (* 3 scale) (* GLYPH-W scale)) 2))
                      (y (quotient (- vh (* GLYPH-H scale)) 2)))
                 (when (cursor-on? (title-gate-frames t))
                   (color! C-TEXT)
                   (draw-filled-rect x y (* GLYPH-W scale) (* GLYPH-H scale)))
                 (color! C-TEXT)
                 (draw-text line (+ x (* GLYPH-W scale) (* 3 scale)) y scale)))
              (else
               (set! *frames* (+ 1 *frames*))
               (set! *last-backdrop* backdrop)
               (set! *last-card* card)
               (when backdrop
                 (color! C-TEX-PLAIN)
                 (set! *backdrop-draws* (+ 1 *backdrop-draws*))
                 (draw-texture-region backdrop 0 0 vw vh 0 0 BACKDROP-W BACKDROP-H))
               (when t
                 (title-draw t TITLE-X TITLE-Y TITLE-CELL))))))
))
