;;; (crash title logo) - the LOGO grid, GENERATED by scripts/art/ansi
;;; from assets/src/title/logo.spec and assets/src/title/blocky.txt; edit those, not this file.
;;; 80x14 cells; a row is three strings: glyph codes (space, # full,
;;; 3 2 1 for the ▓ ▒ ░ dither, ^ v < > for the top, bottom, left, right
;;; half), then the fg and bg roles as a letter into LOGO-ROLES
;;; (- for none). Drawn by (crash title) with the block glyphs of (crash font).

(define-library (crash title logo)
  (export LOGO-W LOGO-H LOGO-ROLES LOGO-ROWS LOGO-LETTERS)

  (begin
    (define LOGO-W 80)
    (define LOGO-H 14)
    ;; each letter's box as row col width, six rows each, in reading order
    (define LOGO-LETTERS
      '#(0 20 7 0 28 7 0 36 7 0 44 7 0 52 7 7 6 7 7 14 7 7 22 7 7 34 7 7 42 7 7 50 7 7 58 7 7 66 7))
    ;; role names as strings (a quoted symbol list came out of the web
    ;; build's module load corrupted once, 2026-09-19; strings did not)
    (define LOGO-ROLES
      '#("C-SELECTED" "C-HIGHLIGHT" "C-BAR-C"))

    (define LOGO-ROWS
      '#(("                     v##### ######v  v###v   v##### ##   ##                     " "---------------------aaaaaa-aaaaaaa--aaaaa---aaaaaa-aa---aa---------------------" "--------------------------------------------------------------------------------")
         ("                    ##^22222##222##2##^2^## ##^22222##2  ##2                    " "--------------------aaacccccaacccaacaaacaaa-aaacccccaac--aac--------------------" "--------------------------------------------------------------------------------")
         ("                    3322    33vvv3^23322 332^3333v  33vvv332                    " "--------------------aacc----aaaaaaacaacc-aacaaaaaa--aaaaaaac--------------------" "--------------------bb------bb---b--bb---bb--bbbb---bb---bb---------------------")
         ("                    222     22^^222222222222 222222 22^^^222                    " "--------------------aac-----aaaaaaccaaaaaaac-ccccaa-aaaaaaac--------------------" "--------------------bb------bb--bb--bbbbbbb------bb-bb---bb---------------------")
         ("                    11v     1122211 11222112v    11211222112                    " "--------------------aab-----aacccaa-aacccaacb----aacaacccaac--------------------" "--------------------bb------bb---bb-bb---bb------bb-bb---bb---------------------")
         ("                     ^##### ##2  ##2##2  ##2######^2##2  ##2                    " "---------------------bbbbbb-bbc--bbcbbc--bbcbbbbbbbcbbc--bbc--------------------" "--------------------------------------------------------------------------------")
         ("                      222222 22   22 22   22 2222222 22   22                    " "----------------------cccccc-cc---cc-cc---cc-ccccccc-cc---cc--------------------" "--------------------------------------------------------------------------------")
         ("      ####### ##   ## #######      v##### #######  v###v   v##### ##   ##       " "------aaaaaaa-aa---aa-aaaaaaa------aaaaaa-aaaaaaa--aaaaa---aaaaaa-aa---aa-------" "--------------------------------------------------------------------------------")
         ("      ^^###^^2##2  ##2##222222    ##^22222^^###^^2##^2^## ##^22222##2 ##^2      " "------aaaaaaacaac--aacaacccccc----aaacccccaaaaaaacaaacaaa-aaacccccaac-aaac------" "--------------------------------------------------------------------------------")
         ("       233222233vvv33233vvv       ^3333v   23322223322 3323322    33v33222      " "-------caaccccaaaaaaacaaaaa-------aaaaaa---caaccccaacc-aacaacc----aaaaaccc------" "--------bb----bb---bb-bb-----------bbbb-----bb----bb---bb-bb------bb-bb---------")
         ("        222   22^^^22222^^^2       222222   222   22222222222     2222v2        " "--------aac---aaaaaaacaaaaac-------ccccaa---aac---aaaaaaacaac-----aaaaac--------" "--------bb----bb---bb-bb---------------bb---bb----bbbbbbb-bb------bbbb----------")
         ("        112   11222112112222      v    112  112   1122211211v     112^11v       " "--------aac---aacccaacaacccc------b----aac--aac---aacccaacaab-----aacbaab-------" "--------bb----bb---bb-bb---------------bb---bb----bb---bb-bb------bb--bb--------")
         ("        ##2   ##2  ##2#######     ######^2  ##2   ##2  ##2 ^##### ##2 2##2      " "--------bbc---bbc--bbcbbbbbbb-----bbbbbbbc--bbc---bbc--bbc-bbbbbb-bbc-cbbc------" "--------------------------------------------------------------------------------")
         ("         22    22   22 2222222     2222222   22    22   22  222222 22   22      " "---------cc----cc---cc-ccccccc-----ccccccc---cc----cc---cc--cccccc-cc---cc------" "--------------------------------------------------------------------------------")))))
