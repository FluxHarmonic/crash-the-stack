;;; from assets/src/title/blocky.txt; edit the text, not this file. Each glyph: its
;;; character as a one-letter string, then six rows of seven codes (space,
;;; # full, ^ v < > the top, bottom, left, right half). The menu's items are
;;; set in these (ruling D41); scripts/art/ansi lays the logo out from the same text.

(define-library (crash title alphabet)
  (export ALPHABET ALPHABET-W ALPHABET-H)

