;;; (crash stack fixtures) - Small layouts the gates share.
;;;
;;; Lives with the rules so the test files can import it (test/ is not on the
;;; library path). A few dozen bytes in the bundle; also handy for the editor.

(define-library (crash stack fixtures)
  (import (crash stack layout))
  (export tower-3-layout column-4-layout)
  (begin
    ;; A 3-high column at x=0 plus three flat tiles at x=3, 5, 7 (two whole
    ;; tiles apart, so none blocks another). Six tiles, three pairs. A search
    ;; that takes a random first pair and never rewinds dead-ends here with
    ;; probability 2/3: three of the six first picks are flat-flat (leaving a
    ;; column of two, then one), and after a top-flat pick a flat-flat second
    ;; pick strands the base. So this layout proves the backtrack is live.
    (define (tower-3-layout)
      (sexp->layout '(stack ((0 . 0) (3 . 0) (5 . 0) (7 . 0))
                            ((0 . 0))
                            ((0 . 0)))))

    ;; Four tiles in one column: two pairs stacked so only the top tile is
    ;; ever free. No two tiles are playable together, under any faces, so no
    ;; solution exists. The positive control for the replay checker and for
    ;; the generator's refusal.
    (define (column-4-layout)
      (sexp->layout '(stack ((0 . 0)) ((0 . 0)) ((0 . 0)) ((0 . 0)))))))
