;;; (crash stack prng) - The generator's own random numbers.
;;;
;;; A seed names a board for as long as the game exists: share codes and the
;;; daily board (P4) are seeds. That is why this is not (sigil random): the
;;; stdlib's stream may change between Sigil versions, and a board must not.
;;;
;;; MINSTD (Park-Miller): s' = s * 48271 mod (2^31 - 1). The state is the
;;; integer itself, threaded by hand, so a generator run is a pure function
;;; of its seed. The multiply stays inside a 64-bit fixnum (48271 * 2^31 is
;;; about 1e14), which was checked in Sigil 0.22 before this was written.

(define-library (crash stack prng)

  (export prng-seed prng-next prng-index)

  (begin
    (define MODULUS 2147483647)
    (define MULTIPLIER 48271)

    ;; Any integer to a valid state (never 0, which MINSTD would fix at 0).
    (define (prng-seed n)
      (let ((s (modulo n MODULUS)))
        (if (= s 0) 1 s)))

    (define (prng-next s)
      (modulo (* s MULTIPLIER) MODULUS))

    ;; An index in [0, n) from the CURRENT state. Call prng-next first for a
    ;; fresh draw. The modulo bias is below 1e-6 for the n this game uses
    ;; (a few hundred pairs at most against a 2^31 range).
    (define (prng-index s n)
      (modulo s n))))
