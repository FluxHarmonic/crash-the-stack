;;; (crash stack turtle) - The Turtle, transcribed.
;;;
;;; The traditional Mahjongg solitaire layout, 144 tiles in five layers
;;; (87 36 16 4 1), as David transcribed it from GNOME Mahjongg by hand in
;;; 2020 (crash-the-stack/dist/assets/stacks/test/gnome-easy.scm). It is the
;;; tuning fixture for the generator and the playability gate, not a shipped
;;; layout: the shipped set is drawn in the editor later (design decision 5).
;;;
;;; Format is the 2020 file format verbatim: whole-tile coordinates, y growing
;;; downward, layers listed bottom-up; see (crash stack layout). Embedded as a
;;; datum so the web build fetches nothing.

(define-library (crash stack turtle)
  (import (crash stack layout))

  (export turtle-stack turtle-layout)

  (begin
    (define turtle-stack
      (quote
        (stack ((5.5 . -3.5)
                (4.5 . -3.5)
                (3.5 . -3.5)
                (2.5 . -3.5)
                (1.5 . -3.5)
                (0.5 . -3.5)
                (-0.5 . -3.5)
                (-1.5 . -3.5)
                (-2.5 . -3.5)
                (-3.5 . -3.5)
                (-4.5 . -3.5)
                (-5.5 . -3.5)
                (3.5 . -2.5)
                (2.5 . -2.5)
                (1.5 . -2.5)
                (0.5 . -2.5)
                (-0.5 . -2.5)
                (-1.5 . -2.5)
                (-2.5 . -2.5)
                (-3.5 . -2.5)
                (4.5 . -1.5)
                (3.5 . -1.5)
                (2.5 . -1.5)
                (1.5 . -1.5)
                (0.5 . -1.5)
                (-0.5 . -1.5)
                (-1.5 . -1.5)
                (-2.5 . -1.5)
                (-3.5 . -1.5)
                (-4.5 . -1.5)
                (7.5 . 0.0)
                (6.5 . 0.0)
                (5.5 . -0.5)
                (4.5 . -0.5)
                (3.5 . -0.5)
                (2.5 . -0.5)
                (1.5 . -0.5)
                (0.5 . -0.5)
                (-0.5 . -0.5)
                (-1.5 . -0.5)
                (-2.5 . -0.5)
                (-3.5 . -0.5)
                (-4.5 . -0.5)
                (-5.5 . -0.5)
                (5.5 . 0.5)
                (4.5 . 0.5)
                (3.5 . 0.5)
                (2.5 . 0.5)
                (1.5 . 0.5)
                (0.5 . 0.5)
                (-0.5 . 0.5)
                (-1.5 . 0.5)
                (-2.5 . 0.5)
                (-3.5 . 0.5)
                (-4.5 . 0.5)
                (-5.5 . 0.5)
                (4.5 . 1.5)
                (3.5 . 1.5)
                (2.5 . 1.5)
                (1.5 . 1.5)
                (0.5 . 1.5)
                (-0.5 . 1.5)
                (-1.5 . 1.5)
                (-2.5 . 1.5)
                (-3.5 . 1.5)
                (-4.5 . 1.5)
                (3.5 . 2.5)
                (2.5 . 2.5)
                (1.5 . 2.5)
                (0.5 . 2.5)
                (-0.5 . 2.5)
                (-1.5 . 2.5)
                (-2.5 . 2.5)
                (-3.5 . 2.5)
                (5.5 . 3.5)
                (4.5 . 3.5)
                (3.5 . 3.5)
                (2.5 . 3.5)
                (1.5 . 3.5)
                (0.5 . 3.5)
                (-0.5 . 3.5)
                (-1.5 . 3.5)
                (-2.5 . 3.5)
                (-3.5 . 3.5)
                (-4.5 . 3.5)
                (-5.5 . 3.5)
                (-6.5 . 0.0))
               ((2.5 . -2.5)
                (1.5 . -2.5)
                (0.5 . -2.5)
                (-0.5 . -2.5)
                (-1.5 . -2.5)
                (-2.5 . -2.5)
                (2.5 . -1.5)
                (1.5 . -1.5)
                (0.5 . -1.5)
                (-0.5 . -1.5)
                (-1.5 . -1.5)
                (-2.5 . -1.5)
                (2.5 . -0.5)
                (1.5 . -0.5)
                (0.5 . -0.5)
                (-0.5 . -0.5)
                (-1.5 . -0.5)
                (-2.5 . -0.5)
                (2.5 . 0.5)
                (1.5 . 0.5)
                (0.5 . 0.5)
                (-0.5 . 0.5)
                (-1.5 . 0.5)
                (-2.5 . 0.5)
                (2.5 . 1.5)
                (1.5 . 1.5)
                (0.5 . 1.5)
                (-0.5 . 1.5)
                (-1.5 . 1.5)
                (-2.5 . 1.5)
                (2.5 . 2.5)
                (1.5 . 2.5)
                (0.5 . 2.5)
                (-0.5 . 2.5)
                (-1.5 . 2.5)
                (-2.5 . 2.5))
               ((1.5 . -1.5)
                (0.5 . -1.5)
                (-0.5 . -1.5)
                (-1.5 . -1.5)
                (1.5 . -0.5)
                (0.5 . -0.5)
                (-0.5 . -0.5)
                (-1.5 . -0.5)
                (1.5 . 0.5)
                (0.5 . 0.5)
                (-0.5 . 0.5)
                (-1.5 . 0.5)
                (1.5 . 1.5)
                (0.5 . 1.5)
                (-0.5 . 1.5)
                (-1.5 . 1.5))
               ((0.5 . -0.5) (-0.5 . -0.5) (0.5 . 0.5) (-0.5 . 0.5))
               ((0.0 . 0.0)))
        ))

    (define (turtle-layout)
      (sexp->layout turtle-stack))))
