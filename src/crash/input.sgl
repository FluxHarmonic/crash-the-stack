;;; (crash input) - A frame of input becomes a move.
;;;
;;; The shell (native: (crash main) over sigil-app; web: P0b's entry) hands
;;; in one input-frame per frame: the keys that went down this frame, the
;;; modifier keys held, and a pointer click in VIRTUAL coordinates if there
;;; was one. session-step turns that into a new session. Nothing here reads
;;; a platform; that is what lets the web shell drive it unchanged.
;;;
;;; Every way of picking a tile ends in session-pick, which ends in
;;; board-select: the mouse (hit-test the topmost tile under the click),
;;; and the three keyboard models of decision D5 that David tries by feel:
;;;
;;;   cursor  (a)  arrows or hjkl move a highlight between playable tiles;
;;;                space picks the highlighted tile.
;;;   coords  (b)  the board edges carry column letters and row digits; a
;;;                letter then a digit (either order) picks that tile.
;;;   hint    (c)  every uncovered tile wears a one- or two-letter label, the
;;;                way qutebrowser labels links; type the label you see to
;;;                pick that tile. Labels go on every uncovered tile, not
;;;                only the playable ones, so typing one tells you exactly
;;;                what clicking it would: whether THAT tile is free.
;;;                (David, 2026-09-16, replacing the glyph model.)
;;;
;;; The glyph model (press a face key, the highlight jumps to a free tile of
;;; that face) was cut because one keystroke searched the whole board for a
;;; free K and its partner: GNOME's hint, made free. It survives as the
;;; PRICED HINT prototype: ctrl+h then a face key rings a free tile of that
;;; face and counts one hint; P1 attaches the trace cost. Until then the HUD
;;; shows the count so the price is at least visible.
;;;
;;; Always: tab cycles the model, backspace or ctrl+z undoes, ctrl+s
;;; shuffles, ctrl+n deals the next seed, ctrl+t toggles the test-tile
;;; renderer, ctrl+h asks for a hint. Commands take ctrl because in the hint
;;; model every letter is a label key. (Escape is the shell's: it quits.)

(define-library (crash input)
  (import (sigil core)
          (sigil struct)
          (sigil math)
          (crash stack layout)
          (crash stack rules)
          (crash stack generate)
          (crash geometry))

  (export input-frame input-frame? make-input-frame
          input-frame-pressed input-frame-held input-frame-click
          session session? session-new
          session-board session-model session-highlight session-pending
          session-render-mode session-seed session-message
          session-typed session-hint session-hint-armed session-hints session-cursor-shown
          hint-labels uncovered-slots HINT-ALPHABET
          session-step session-pick session-with session-with-model
          MODELS model-name next-model
          key->face face->key FACE-KEYS)

  (begin
    ;; pressed: key symbols that went down this frame (sigil-app's names:
    ;; a..z, 0..9, space, return, tab, backspace, left right up down).
    ;; held: modifiers currently down, from '(ctrl shift).
    ;; click: (x . y) in virtual pixels, or #f.
    (define-struct input-frame
      (pressed default: '())
      (held default: '())
      (click default: #f))

    (define (make-input-frame pressed held click)
      (input-frame pressed: pressed held: held click: click))

    ;; Fields are mutable only so session-with can fill a fresh copy; a
    ;; session is otherwise treated as immutable, like a board.
    (define-struct session
      (board default: #f mutable: #t)
      (model default: 'cursor mutable: #t)            ; cursor | coords | hint
      (highlight default: #f mutable: #t)             ; slot the cursor model points at
      (pending default: #f mutable: #t)               ; coords: (col . row) with one half still #f
      (render-mode default: 'primitives mutable: #t)  ; primitives | texture
      (seed default: 1 mutable: #t)
      (message default: "" mutable: #t)
      (typed default: "" mutable: #t)                ; hint model: label letters typed so far
      (hint default: #f mutable: #t)                  ; priced hint: the ringed slot, or #f
      (hint-armed default: #f mutable: #t)            ; ctrl+h pressed, face key awaited
      (hints default: 0 mutable: #t)                  ; priced hints used this board
      (cursor-shown default: #f mutable: #t))         ; ring visible: set by an arrow, cleared by a pick

    (define MODELS '(cursor coords hint))

    (define (model-name m)
      (case m
        ((cursor) "CURSOR")
        ((coords) "COORDS")
        ((hint) "HINT")
        (else "?")))

    (define (next-model m)
      (let ((rest (cdr (memq m MODELS))))
        (if (null? rest) (car MODELS) (car rest))))

    ;; --- faces and keys ------------------------------------------------------

    (define FACE-KEYS "0123456789abcdefghijklmnopqrstuvwxyz")

    ;; 'a -> 10, '0 -> 0 ... or #f for any other key.
    (define (key->face key)
      (let ((name (symbol->string key)))
        (and (= (string-length name) 1)
             (let loop ((i 0))
               (cond ((= i (string-length FACE-KEYS)) #f)
                     ((char=? (string-ref FACE-KEYS i) (string-ref name 0)) i)
                     (else (loop (+ i 1))))))))

    (define (face->key face)
      (string->symbol (string (string-ref FACE-KEYS face))))

    ;; --- helpers ------------------------------------------------------------

    (define (session-with s . fields)
      (let ((nx (session board: (session-board s)
                         model: (session-model s)
                         highlight: (session-highlight s)
                         pending: (session-pending s)
                         render-mode: (session-render-mode s)
                         seed: (session-seed s)
                         message: (session-message s)
                         typed: (session-typed s)
                         hint: (session-hint s)
                         hint-armed: (session-hint-armed s)
                         hints: (session-hints s)
                         cursor-shown: (session-cursor-shown s))))
        (let loop ((fields fields))
          (unless (null? fields)
            (case (car fields)
              ((board) (set-session-board! nx (cadr fields)))
              ((model) (set-session-model! nx (cadr fields)))
              ((highlight) (set-session-highlight! nx (cadr fields)))
              ((pending) (set-session-pending! nx (cadr fields)))
              ((render-mode) (set-session-render-mode! nx (cadr fields)))
              ((seed) (set-session-seed! nx (cadr fields)))
              ((message) (set-session-message! nx (cadr fields)))
              ((typed) (set-session-typed! nx (cadr fields)))
              ((hint) (set-session-hint! nx (cadr fields)))
              ((hint-armed) (set-session-hint-armed! nx (cadr fields)))
              ((hints) (set-session-hints! nx (cadr fields)))
              ((cursor-shown) (set-session-cursor-shown! nx (cadr fields))))
            (loop (cddr fields))))
        nx))

    (define (pressed? f key) (and (memq key (input-frame-pressed f)) #t))
    (define (held? f key) (and (memq key (input-frame-held f)) #t))

    (define (slot-of s id) (layout-slot (board-layout (session-board s)) id))

    ;; Manhattan-ish distance in half-units between two slots' centres.
    (define (slot-distance s a b)
      (let ((sa (slot-of s a)) (sb (slot-of s b)))
        (+ (abs (- (slot-hx sa) (slot-hx sb)))
           (abs (- (slot-hy sa) (slot-hy sb))))))

    (define (argmin score ids)
      (let loop ((ids ids) (best #f) (best-score #f))
        (cond ((null? ids) best)
              (else (let ((sc (score (car ids))))
                      (if (and sc (or (not best-score) (< sc best-score)))
                          (loop (cdr ids) (car ids) sc)
                          (loop (cdr ids) best best-score)))))))

    ;; A highlight that points at a playable tile: keep it if it still is,
    ;; else the nearest playable to where it was, else the first playable.
    (define (home-highlight s)
      (let* ((b (session-board s))
             (h (session-highlight s))
             (playable (playable-slots b)))
        (cond ((null? playable) (session-with s 'highlight #f))
              ((and h (playable? b h)) s)
              ((not h) (session-with s 'highlight (car playable)))
              (else (session-with s 'highlight
                                  (argmin (lambda (id) (slot-distance s h id)) playable))))))

    ;; --- construction -------------------------------------------------------

    ;; A layout no face assignment can clear (the generator answered #f) still
    ;; gets a board to look at, all faces 0, and a message saying why.
    (define (session-new lay seed)
      (let ((b (generate lay seed)))
        (home-highlight
          (session board: (or b (board-new lay (make-vector (layout-slot-count lay) 0)))
                   seed: seed
                   message: (if b "" "NO SOLVABLE DEAL FOR THIS LAYOUT")))))

    ;; --- picking ------------------------------------------------------------

    ;; The one door: every model and the pointer come through here. A pick
    ;; that is not playable changes nothing, the keyboard highlight included.
    (define (session-pick s id)
      (if (not (playable? (session-board s) id))
          s
          (let ((b (board-select (session-board s) id)))
            (home-highlight (session-with s 'board b 'pending #f 'highlight id
                                          'hint #f 'typed "" 'message "" 'cursor-shown #f)))))

    ;; A session in the named keyboard model (unknown names leave it as is).
    (define (session-with-model s model)
      (if (memq model MODELS) (session-with s 'model model) s))

    (define (session-new-board s b)
      (home-highlight (session-with s 'board b 'pending #f 'hint #f 'typed "" 'message "")))

    ;; --- the models ---------------------------------------------------------

    (define (direction-of f)
      (cond ((or (pressed? f 'left) (pressed? f 'h)) 'left)
            ((or (pressed? f 'right) (pressed? f 'l)) 'right)
            ((or (pressed? f 'up) (pressed? f 'k)) 'up)
            ((or (pressed? f 'down) (pressed? f 'j)) 'down)
            (else #f)))

    ;; Left and right walk the playable tiles in reading order (top row first,
    ;; left to right), wrapping at the ends, so pressing right enough times
    ;; visits every playable tile: reachability by construction, which the
    ;; gate in test/test-cursor.sgl checks over sample boards. Up and down are
    ;; spatial shortcuts: the playable tile above or below with the least
    ;; sideways drift, nearest first (score cross * 1000 + along; half-unit
    ;; distances never reach 1000); with nothing in that direction the
    ;; highlight stays. An earlier all-spatial version stranded tiles.
    (define (cursor-step-reading s h forward?)
      (let* ((b (session-board s))
             (order (filter (lambda (id) (playable? b id))
                            (layout-reading-order (board-layout b))))
             (order (if forward? order (reverse order)))
             (after (memv h order)))
        (cond ((null? order) h)
              ((and after (pair? (cdr after))) (cadr after))
              (else (car order)))))

    (define (cursor-step-vertical s h dir)
      (let* ((sh (slot-of s h))
             (score (lambda (id)
                      (let* ((sc (slot-of s id))
                             (dx (- (slot-hx sc) (slot-hx sh)))
                             (dy (- (slot-hy sc) (slot-hy sh))))
                        (case dir
                          ((up) (and (< dy 0) (+ (* 1000 (abs dx)) (- dy))))
                          ((down) (and (> dy 0) (+ (* 1000 (abs dx)) dy)))
                          (else #f))))))
        (or (argmin score (filter (lambda (id) (not (= id h)))
                                  (playable-slots (session-board s))))
            h)))

    (define (cursor-move s dir)
      (let ((h (session-highlight s)))
        (if (not h)
            (home-highlight s)
            (session-with s 'highlight
                          (case dir
                            ((right) (cursor-step-reading s h #t))
                            ((left) (cursor-step-reading s h #f))
                            (else (cursor-step-vertical s h dir)))))))

    (define (step-cursor s f)
      (let ((dir (direction-of f)))
        ;; The ring shows only once an arrow has been pressed since the last
        ;; pick: the highlight homes silently after a match so nothing looks
        ;; pre-chosen (David, 2026-09-16).
        (cond (dir (session-with (cursor-move s dir) 'cursor-shown #t))
              ((and (pressed? f 'space) (session-highlight s))
               (session-pick s (session-highlight s)))
              (else s))))

    ;; A letter fixes the column, a digit the row; when both are known the
    ;; tile at that address is picked (or nothing is, if none is playable)
    ;; and the address clears either way.
    (define (step-coords s f g)
      (let loop ((keys (input-frame-pressed f)) (s s))
        (if (null? keys)
            s
            (let* ((key (car keys))
                   (col (column-of-key g key))
                   (row (row-of-key g key))
                   (pending (or (session-pending s) (cons #f #f)))
                   (col* (or col (car pending)))
                   (row* (or row (cdr pending))))
              (cond ((and (not col) (not row)) (loop (cdr keys) s))
                    ((and col* row*)
                     (let ((id (slot-at-labels g (session-board s) col* row*)))
                       (loop (cdr keys)
                             (if id
                                 (session-pick s id)
                                 (session-with s 'pending #f)))))
                    (else (loop (cdr keys) (session-with s 'pending (cons col* row*)))))))))

    ;; --- the hint model ------------------------------------------------------
    ;;
    ;; Labels are assigned over the uncovered present tiles in reading order,
    ;; one letter each while there are at most 26 of them, two letters
    ;; otherwise (home-row letters first, so the common labels sit under the
    ;; fingers). They are recomputed from the board every frame, so they shift
    ;; only when a tile leaves. Digits are not labels.

    (define HINT-ALPHABET "asdfghjklqwertyuiopzxcvbnm")

    (define (hint-char i) (string-ref HINT-ALPHABET i))

    (define (hint-label-length count)
      (if (<= count (string-length HINT-ALPHABET)) 1 2))

    (define (hint-label i len)
      (if (= len 1)
          (string (hint-char i))
          (let ((n (string-length HINT-ALPHABET)))
            (string (hint-char (let loop ((q 0) (r i)) (if (< r n) q (loop (+ q 1) (- r n)))))
                    (hint-char (modulo i n))))))

    ;; Uncovered present tiles, top row first, left to right.
    (define (uncovered-slots b)
      (filter (lambda (id) (and (tile-present? b id) (not (covered? b id))))
              (layout-reading-order (board-layout b))))

    ;; ((slot . "label") ...) for the current board.
    (define (hint-labels s)
      (let* ((b (session-board s))
             (slots (uncovered-slots b))
             (len (hint-label-length (length slots))))
        (let loop ((slots slots) (i 0) (acc '()))
          (if (null? slots)
              (reverse acc)
              (loop (cdr slots) (+ i 1) (cons (cons (car slots) (hint-label i len)) acc))))))

    (define (label-key? key)
      (let ((name (symbol->string key)))
        (and (= (string-length name) 1)
             (let loop ((i 0))
               (cond ((= i (string-length HINT-ALPHABET)) #f)
                     ((char=? (hint-char i) (string-ref name 0)) #t)
                     (else (loop (+ i 1))))))))

    (define (label->slot labels text)
      (let ((entry (find (lambda (e) (string=? (cdr e) text)) labels)))
        (and entry (car entry))))

    ;; Each label letter extends what has been typed; a complete label picks
    ;; its tile (a blocked tile's label does nothing, like a click on it) and
    ;; the typed text clears either way. A letter outside the alphabet clears.
    (define (step-hint s f)
      (let loop ((keys (input-frame-pressed f)) (s s))
        (if (null? keys)
            s
            (let ((key (car keys)))
              (cond ((not (label-key? key))
                     (loop (cdr keys) (if (member key '(space return)) (session-with s 'typed "") s)))
                    (else
                     (let* ((labels (hint-labels s))
                            (len (hint-label-length (length labels)))
                            (typed (string-append (session-typed s) (symbol->string key))))
                       (if (< (string-length typed) len)
                           (loop (cdr keys) (session-with s 'typed typed))
                           (let ((id (label->slot labels typed)))
                             (loop (cdr keys)
                                   (session-with (if id (session-pick s id) s) 'typed "")))))))))))

    ;; --- the priced hint (prototype; P1 attaches the trace cost) -------------
    ;;
    ;; ctrl+h arms it; the next face key rings the first playable tile of
    ;; that face after the current hint ring (wrapping), and the hint count
    ;; goes up by one. The ring is only a pointer: picking still goes through
    ;; the model in use or the mouse.
    (define (hint-jump s face)
      (let* ((b (session-board s))
             (matching (filter (lambda (id) (eqv? (tile-face b id) face)) (playable-slots b)))
             (h (session-hint s))
             (target (cond ((null? matching) #f)
                           ((and h (memv h matching))
                            (let ((after (cdr (memv h matching))))
                              (if (null? after) (car matching) (car after))))
                           (else (car matching)))))
        (session-with s 'hint-armed #f
                      'hint target
                      'hints (+ 1 (session-hints s))
                      'message (if target "" "NO FREE TILE OF THAT FACE"))))

    (define (step-armed-hint s f)
      (let ((face (find (lambda (x) x) (map key->face (input-frame-pressed f)))))
        (if face (hint-jump s face) s)))

    (define (step-pointer s f g)
      (let ((click (input-frame-click f)))
        (if (not click)
            s
            (let ((id (hit-slot g (session-board s) (car click) (cdr click))))
              (if id (session-pick s id) s)))))

    ;; --- commands -----------------------------------------------------------

    (define (step-commands s f)
      (let ((b (session-board s))
            (ctrl (held? f 'ctrl)))
        (cond ((pressed? f 'tab)
               (session-with s 'model (next-model (session-model s)) 'pending #f 'typed ""))
              ((or (pressed? f 'backspace) (and ctrl (pressed? f 'z)))
               (session-new-board s (board-undo b)))
              ((and ctrl (pressed? f 's))
               (session-new-board s (reshuffle b)))
              ((and ctrl (pressed? f 'n))
               (let ((seed (+ 1 (session-seed s))))
                 (session-with (session-new (board-layout b) seed)
                               'model (session-model s)
                               'render-mode (session-render-mode s))))
              ((and ctrl (pressed? f 'h))
               (session-with s 'hint-armed #t 'message "HINT: PRESS A FACE KEY"))
              ((and ctrl (pressed? f 't))
               (session-with s 'render-mode
                             (if (eq? (session-render-mode s) 'primitives) 'texture 'primitives)))
              (else #f))))

    ;; --- one frame ----------------------------------------------------------

    (define (session-step s f g)
      (cond ((step-commands s f) => (lambda (s) s))
            ((session-hint-armed s) (step-armed-hint s f))
            (else
             (let ((s (step-pointer s f g)))
               (if (held? f 'ctrl)
                   s
                   (case (session-model s)
                     ((cursor) (step-cursor s f))
                     ((coords) (step-coords s f g))
                     ((hint) (step-hint s f))
                     (else s)))))))))
