;;; (crash input) - A frame of input becomes a move.
;;;
;;; The shell (native: (crash main) over sigil-app; web: P0b's entry) hands
;;; in one input-frame per frame: the keys that went down this frame, the
;;; modifier keys held, and a pointer click in VIRTUAL coordinates if there
;;; was one. session-step turns that into a new session. Nothing here reads
;;; a platform; that is what lets the web shell drive it unchanged.
;;;
;;; Every way of picking a tile ends in session-pick, which ends in
;;; board-select: the mouse (hit-test the topmost tile under the click),
;;; and the two keyboard models that survived David's first day of play
;;; (2026-09-16), decision D5:
;;;
;;;   hint    every uncovered tile wears a one- or two-letter tag, the way
;;;           qutebrowser labels links; type the tag you see to pick that
;;;           tile. Tags go on every uncovered tile, not only the playable
;;;           ones, so typing one tells you exactly what clicking it would:
;;;           whether THAT tile is free. Space hides and shows the tags.
;;;           The primary keyboard input.
;;;   cursor  arrows or hjkl move a highlight between playable tiles; space
;;;           picks the highlighted tile. The backup for people who do not
;;;           touch-type; its slowness is meant to push them to hint mode.
;;;
;;; Two models were cut the same day. Coords (column letters and row digits
;;; on the board edges) was "too hard to scan"; hint mode solves the same
;;; problem. Glyph (press a face key, the highlight jumps to a free tile of
;;; that face) let one keystroke search the whole board for a free K and its
;;; partner: GNOME's hint, made free. It survives as the priced hint:
;;; ctrl+h then a face key rings a free tile of that face and costs
;;; HINT-COST on the trace ((crash trace)), like every other hint.
;;;
;;; The session carries the trace ((crash trace): TRACE, COUNTER-HACK,
;;; SEVERED): the shell hands in the sim ticks each frame through
;;; session-advance, hints and shuffles charge it here, the counter-hacks
;;; it fires land on the board here, and a severed connection refuses
;;; every move and undo until the player asks for the same stack again
;;; (ctrl+r, or a tap on the left half of the board) or a new one (ctrl+n,
;;; the NEXT control, the right half). The trace's face (twist, the bar;
;;; clean, GNOME's clock) is the session's from its first frame: the P1
;;; flip (ctrl+m, a tap on the meter) went with the polish row (ruling
;;; D19: P4's JACK IN / FREE PLAY choose it at deal time).
;;;
;;; Always: Tab shows and hides the tags (shift+Tab switches model),
;;; return deselects, backspace or ctrl+z undoes (backspace erases a
;;; typed tag letter first), ctrl+s shuffles, ctrl+n deals the next seed,
;;; ctrl+h asks for a hint, ? shows and hides the keys line, Escape (or
;;; the bar's MENU button beside the wrench) asks for the menu. Commands
;;; take ctrl because in hint mode every letter is a tag key.
;;;
;;; The same commands are the tool stack (ruling D33, (crash hud)):
;;; Space or a tap on the corner button opens it, a tool's tag letter or
;;; digit, arrows and Return, or a tap on its entry fires it, and while it
;;; is open nothing else reaches the board. A chosen tool is rewritten
;;; into the key frame the command already handles, so a tap on a phone
;;; and a ctrl chord on a desktop are one code path. The HINT tool cannot
;;; wait for a face key (a phone has none), so it gives GNOME's hint
;;; instead: a legal pair, the selected tile's partner when one is
;;; selected. The keyboard gets the same by pressing ctrl+h twice. The
;;; menu is the shell's: the session carries the request the shell reads
;;; after the step and clears.

(define-library (crash input)
  (import (sigil struct)
          (sigil math)
          (crash stack layout)
          (crash stack rules)
          (crash stack generate)
          (crash trace)
          (crash geometry)
          (crash look)
          (crash hud))

  (export input-frame input-frame? make-input-frame
          input-frame-pressed input-frame-held input-frame-click
          session session? session-new
          session-board session-model session-highlight
          session-look session-with-look session-seed session-message
          session-typed session-hint session-hint-partner session-hint-armed
          session-hints session-cursor-shown
          session-trace session-refused session-advance session-with-trace-mode
          session-update session-with-update
          session-best session-with-best session-restore
          session-retry session-next
          session-tools session-tools-list session-with-tools-touch
          session-hud session-with-hud session-keys-shown
          session-device frame-device
          session-demo-near-cleared session-demo-finish
          session-request session-clear-request
          session-instruction
          session-labels session-labels-shown
          hint-labels uncovered-slots HINT-ALPHABET
          hint-label hint-label-length label-key?
          session-step session-pick session-with-model
          MODELS model-name next-model
          key->face face->key FACE-KEYS)

  (begin
    ;; pressed: key symbols that went down this frame (sigil-app's names:
    ;; a..z, 0..9, space, return, tab, backspace, left right up down).
    ;; held: modifiers currently down, from '(ctrl shift).
    ;; click: (x . y) in virtual pixels, or #f.
    (define-struct input-frame
      (pressed default: '())
      (held default: '())
      (click default: #f))

    (define (make-input-frame pressed held click)
      (input-frame pressed: pressed held: held click: click))

    ;; A session is immutable: a change is a copy-construction, (session s
    ;; field: value ...), which Sigil's define-struct provides (David, 2026-09-17).
    (define-struct session
      (board default: #f)
      (model default: 'hint)              ; hint | cursor
      (highlight default: #f)             ; slot the cursor model points at
      (cursor-shown default: #f)          ; ring visible: set by an arrow, cleared by a pick
      (labels default: '())               ; hint tags ((slot . "ab") ...), recomputed when the board changes
      (labels-shown default: #t)          ; space toggles
      (typed default: "")                 ; tag letters typed so far
      (hint default: #f)                  ; priced hint: the ringed slot, or #f
      (hint-partner default: #f)          ; the pair hint's second slot, or #f
      (hint-armed default: #f)            ; ctrl+h pressed, face key awaited
      (trace default: #f)                 ; the meter, (crash trace)
      (refused default: #f)               ; a strong-locked tile the last pick bounced off, or #f
      (update default: #f)                ; a new version of the web build: #f | waiting | prompt | apply
      (best default: #f)                  ; best trace on this layout so far, or #f
      (look default: DEFAULT-LOOK)        ; the one name from (crash look) (an old save's name reads as it)
      (tools default: (tools-new))        ; the tool stack, (crash hud)
      (hud default: DEFAULT-LAYOUT)       ; the bar's layout, (crash hud): zones | strip
      (keys-shown default: #f)            ; the keys line in place of the instruction line (?)
      (device default: 'mouse)            ; the last input device: touch | mouse | keyboard (the prompt follows it)
      (request default: #f)               ; for the shell: menu, or #f
      (seed default: 1)
      (message default: ""))

    ;; The device a frame came from, or #f for an idle frame: a click is
    ;; the touch screen or the mouse (the stack's touch flag says which),
    ;; a key the keyboard. The prompt line follows it (David, 2026-09-20:
    ;; "TAP TWO MATCHING TILES." reads wrong under a keyboard).
    (define (frame-device f touch?)
      (cond ((input-frame-click f) (if touch? 'touch 'mouse))
            ((pair? (input-frame-pressed f)) 'keyboard)
            (else #f)))

    (define MODELS '(hint cursor))

    ;; Hints used this board, from the meter.
    (define (session-hints s)
      (trace-hints (session-trace s)))

    (define (model-name m)
      (case m
        ((hint) "HINT")
        ((cursor) "CURSOR")
        (else "?")))

    (define (next-model m)
      (let ((rest (cdr (memq m MODELS))))
        (if (null? rest) (car MODELS) (car rest))))

    ;; --- faces and keys ------------------------------------------------------

    (define FACE-KEYS "0123456789abcdefghijklmnopqrstuvwxyz")

    ;; 'a -> 10, '0 -> 0 ... or #f for any other key.
    (define (key->face key)
      (let ((name (symbol->string key)))
        (and (= (string-length name) 1)
             (let loop ((i 0))
               (cond ((= i (string-length FACE-KEYS)) #f)
                     ((char=? (string-ref FACE-KEYS i) (string-ref name 0)) i)
                     (else (loop (+ i 1))))))))

    (define (face->key face)
      (string->symbol (string (string-ref FACE-KEYS face))))

    ;; --- helpers ------------------------------------------------------------

    (define (pressed? f key) (and (memq key (input-frame-pressed f)) #t))
    (define (held? f key) (and (memq key (input-frame-held f)) #t))

    (define (slot-of s id) (layout-slot (board-layout (session-board s)) id))

    ;; Manhattan-ish distance in half-units between two slots' centres.
    (define (slot-distance s a b)
      (let ((sa (slot-of s a)) (sb (slot-of s b)))
        (+ (abs (- (slot-hx sa) (slot-hx sb)))
           (abs (- (slot-hy sa) (slot-hy sb))))))

    (define (argmin score ids)
      (let loop ((ids ids) (best #f) (best-score #f))
        (cond ((null? ids) best)
              (else (let ((sc (score (car ids))))
                      (if (and sc (or (not best-score) (< sc best-score)))
                          (loop (cdr ids) (car ids) sc)
                          (loop (cdr ids) best best-score)))))))

    ;; A highlight that points at a playable tile: keep it if it still is,
    ;; else the nearest playable to where it was, else the first playable.
    (define (home-highlight s)
      (let* ((b (session-board s))
             (h (session-highlight s))
             (playable (playable-slots b)))
        (cond ((null? playable) (session s highlight: #f))
              ((and h (playable? b h)) s)
              ((not h) (session s highlight: (car playable)))
              (else
               (session s highlight: (argmin (lambda (id)
                                               (slot-distance s h id))
                                             playable))))))

    ;; --- hint tags -----------------------------------------------------------
    ;;
    ;; Tags are assigned over the uncovered present tiles in reading order,
    ;; one letter each while there are at most 26 of them, two letters
    ;; otherwise (home-row letters first, so the common tags sit under the
    ;; fingers). They are computed when the board changes and cached on the
    ;; session, so they shift only when a tile leaves. Digits are not tags.

    (define HINT-ALPHABET "asdfghjklqwertyuiopzxcvbnm")

    (define (hint-char i) (string-ref HINT-ALPHABET i))

    (define (hint-label-length count)
      (if (<= count (string-length HINT-ALPHABET)) 1 2))

    (define (hint-label i len)
      (if (= len 1)
          (string (hint-char i))
          (let ((n (string-length HINT-ALPHABET)))
            (string (hint-char (let loop ((q 0) (r i))
                                 (if (< r n)
                                     q
                                     (loop (+ q 1) (- r n)))))
                    (hint-char (modulo i n))))))

    ;; Uncovered present tiles, top row first, left to right.
    (define (uncovered-slots b)
      (filter (lambda (id)
                (and (tile-present? b id)
                     (not (covered? b id))))
              (layout-reading-order (board-layout b))))

    ;; ((slot . "tag") ...) for a board.
    (define (compute-hint-labels b)
      (let* ((slots (uncovered-slots b))
             (len (hint-label-length (length slots))))
        (let loop ((slots slots) (i 0) (acc '()))
          (if (null? slots)
              (reverse acc)
              (loop (cdr slots)
                    (+ i 1)
                    (cons (cons (car slots)
                                (hint-label i len))
                          acc))))))

    ;; The session's cached tags.
    (define (hint-labels s) (session-labels s))

    (define (label-key? key)
      (let ((name (symbol->string key)))
        (and (= (string-length name) 1)
             (let loop ((i 0))
               (cond ((= i (string-length HINT-ALPHABET)) #f)
                     ((char=? (hint-char i) (string-ref name 0)) #t)
                     (else (loop (+ i 1))))))))

    (define (label->slot labels text)
      (let ((entry (find (lambda (e) (string=? (cdr e) text)) labels)))
        (and entry (car entry))))

    ;; --- construction -------------------------------------------------------

    ;; Everything that must follow a board change: the tags, the cursor's
    ;; home, and the per-pick state. The tags depend on which tiles are
    ;; present, not on the selection or the faces, and no board operation
    ;; changes presence without changing the tile count (a pair leaves or
    ;; comes back by undo; a pick, a shuffle, a lock, a scramble keep it),
    ;; so a board with the old count keeps the old tags: a tap allocates a
    ;; board copy and nothing else (P3c, the tap hitch).
    (define (session-on-board s b)
      (home-highlight
        (session s
                 board: b
                 labels: (if (and (session-board s)
                                  (= (board-tile-count b) (board-tile-count (session-board s))))
                             (session-labels s)
                             (compute-hint-labels b))
                 hint: #f
                 hint-partner: #f
                 typed: ""
                 message: ""
                 refused: #f
                 cursor-shown: #f)))

    ;; A layout no face assignment can clear (the generator answered #f) still
    ;; gets a board to look at, all faces 0, and a message saying why.
    (define (session-new lay seed)
      (let* ((b (generate lay seed))
             (blank (lambda ()
                      (board-new lay (make-vector (layout-slot-count lay) 0))))
             (tr (trace-with-thresholds (trace-new 'twist)
                                        (layout-setting lay 'trace-at TRACE-AT)
                                        (layout-setting lay 'sever-at SEVER-AT)))
             (s (session-on-board (session seed: seed trace: tr)
                                  (or b (blank)))))
        (if b
            (session s message: MSG-JACKED-IN)
            (session s message: "NO SOLVABLE DEAL FOR THIS LAYOUT"))))

    ;; --- picking ------------------------------------------------------------

    ;; Can a pick break this lock? Only a weak one (D15).
    (define (breakable? b id now)
      (lock-weak? b id now))

    ;; The one door: every model and the pointer come through here. A pick
    ;; that is not playable changes nothing, the keyboard highlight
    ;; included. A locked tile: a STRONG lock refuses the pick (the tile
    ;; shakes, LOCKED); a WEAK one breaks on the pick and the tile is
    ;; selected, so the partner's pick removes the pair (D15).
    (define (session-pick s id)
      (let ((b0 (session-board s))
            (now (trace-ticks (session-trace s))))
        (cond ((or (finished? s) (not (playable? b0 id))) s)
              ((and (tile-locked? b0 id) (not (breakable? b0 id now)))
               (session s refused: id message: MSG-LOCKED))
              (else
               (let* ((broke? (tile-locked? b0 id))
                      (b0 (if broke?
                              (board-unlock-pair b0 id (tile-lock-partner b0 id))
                              b0))
                      (b1 (board-select b0 id))
                      (tr (if (board-cleared? b1)
                              (trace-finish (session-trace s))
                              (session-trace s))))
                 (session (session-on-board s b1)
                               highlight: id
                               trace: tr
                               message: (if broke? MSG-LOCK-BROKEN "")))))))

    ;; The cleared sequence on demand (P3c, David's ask: he had not won a
    ;; board and could not judge the copper roll or the phosphor). Two
    ;; halves, one frame apart, so the shell's observers see the board
    ;; clear the way a real clear does: session-demo-near-cleared plays
    ;; the generator's solution through board-select up to the last
    ;; pair; session-demo-finish picks that pair through the one door
    ;; (the trace finishes, the rain spawns on the before/after edge).
    (define (session-demo-near-cleared s)
      (let ((pairs (board-solution (session-board s))))
        (if (or (null? pairs) (null? (cdr pairs)))
            s
            (let loop ((pairs pairs) (b (session-board s)))
              (if (null? (cdr pairs))
                  (session-on-board s b)
                  (loop (cdr pairs)
                        (board-select (board-select b (car (car pairs))) (cdr (car pairs)))))))))

    (define (session-demo-finish s)
      (let ((pairs (board-solution (session-board s))))
        (if (null? pairs)
            s
            (let ((last (list-ref pairs (- (length pairs) 1))))
              (session-pick (session-pick s (car last)) (cdr last))))))

    ;; A session in the named keyboard model (unknown names leave it as is).
    (define (session-with-model s model)
      (if (memq model MODELS) (session s model: model) s))

    ;; --- the cursor model ---------------------------------------------------

    (define (direction-of f)
      (cond ((or (pressed? f 'left) (pressed? f 'h)) 'left)
            ((or (pressed? f 'right) (pressed? f 'l)) 'right)
            ((or (pressed? f 'up) (pressed? f 'k)) 'up)
            ((or (pressed? f 'down) (pressed? f 'j)) 'down)
            (else #f)))

    ;; Left and right walk the playable tiles in reading order (top row first,
    ;; left to right), wrapping at the ends, so pressing right enough times
    ;; visits every playable tile: reachability by construction, which the
    ;; gate in test/test-cursor.sgl checks over sample boards. Up and down are
    ;; spatial shortcuts: the playable tile above or below with the least
    ;; sideways drift, nearest first (score cross * 1000 + along; half-unit
    ;; distances never reach 1000); with nothing in that direction the
    ;; highlight stays. An earlier all-spatial version stranded tiles.
    (define (cursor-step-reading s h forward?)
      (let* ((b (session-board s))
             (order (filter (lambda (id) (playable? b id))
                            (layout-reading-order (board-layout b))))
             (order (if forward? order (reverse order)))
             (after (memv h order)))
        (cond ((null? order) h)
              ((and after (pair? (cdr after))) (cadr after))
              (else (car order)))))

    (define (cursor-step-vertical s h dir)
      (let* ((sh (slot-of s h))
             (score (lambda (id)
                      (let* ((sc (slot-of s id))
                             (dx (- (slot-hx sc) (slot-hx sh)))
                             (dy (- (slot-hy sc) (slot-hy sh))))
                        (case dir
                          ((up) (and (< dy 0) (+ (* 1000 (abs dx)) (- dy))))
                          ((down) (and (> dy 0) (+ (* 1000 (abs dx)) dy)))
                          (else #f))))))
        (or (argmin score (filter (lambda (id) (not (= id h)))
                                  (playable-slots (session-board s))))
            h)))

    (define (cursor-move s dir)
      (let ((h (session-highlight s)))
        (if (not h)
            (home-highlight s)
            (session s highlight:
                          (case dir
                            ((right) (cursor-step-reading s h #t))
                            ((left) (cursor-step-reading s h #f))
                            (else (cursor-step-vertical s h dir)))))))

    (define (step-cursor s f)
      (let ((dir (direction-of f)))
        ;; The ring shows only once an arrow has been pressed since the last
        ;; pick: the highlight homes silently after a match so nothing looks
        ;; pre-chosen (David, 2026-09-16).
        (cond (dir (session (cursor-move s dir) cursor-shown: #t))
              (else s))))

    ;; --- the hint model -----------------------------------------------------

    ;; Each tag letter extends what has been typed; a complete tag picks its
    ;; tile (a blocked tile's tag does nothing, like a click on it) and the
    ;; typed text clears either way. Tab hides the tags and shows them
    ;; again (David, 2026-09-16: every tile wearing a tag can be visually
    ;; noisy; Space did this until the tool stack took Space, D33).
    ;; Backspace erases a typed letter; with nothing typed it is the undo
    ;; command instead.
    (define (step-hint s f)
      (let loop ((keys (input-frame-pressed f)) (s s))
        (if (null? keys)
            s
            (let ((key (car keys))
                  (typed (session-typed s)))
              (cond ((and (eq? key 'backspace)
                          (> (string-length typed) 0))
                     (loop (cdr keys)
                           (session s typed: (substring typed
                                                        0
                                                        (- (string-length typed) 1)))))
                    ((not (label-key? key)) (loop (cdr keys) s))
                    ((not (session-labels-shown s)) (loop (cdr keys) s))
                    (else
                     (let* ((labels (session-labels s))
                            (len (hint-label-length (length labels)))
                            (typed (string-append typed (symbol->string key))))
                       (if (< (string-length typed) len)
                           (loop (cdr keys) (session s typed: typed))
                           (let ((id (label->slot labels typed)))
                             (loop (cdr keys)
                                   (session (if id
                                                (session-pick s id)
                                                s)
                                            typed: "")))))))))))

    ;; --- the priced hint -----------------------------------------------------
    ;;
    ;; ctrl+h arms it; the next face key rings the first playable tile of
    ;; that face after the current hint ring (wrapping), and the hint count
    ;; goes up by one. The ring is only a pointer: picking still goes through
    ;; the model in use or the mouse.
    (define (hint-jump s face)
      (let* ((b (session-board s))
             (matching (filter (lambda (id)
                                 (eqv? (tile-face b id) face))
                               (playable-slots b)))
             (h (session-hint s))
             (target (cond ((null? matching) #f)
                           ((and h (memv h matching))
                            (let ((after (cdr (memv h matching))))
                              (if (null? after)
                                  (car matching)
                                  (car after))))
                           (else (car matching)))))
        (session s hint-armed: #f
                      hint: target
                      hint-partner: #f
                      trace: (trace-hint (session-trace s))
                      message: (if target "" "NO FREE TILE OF THAT FACE"))))

    ;; GNOME's hint: ring a legal pair, the selected tile's partner when
    ;; one is selected, else the first legal match after the current ring
    ;; (wrapping, so repeated hints walk the matches). One hint counted.
    (define (hint-pair s)
      (let* ((b (session-board s))
             (sel (board-selected b))
             (matches (legal-matches b))
             (mine (if sel
                       (filter (lambda (m) (or (= (car m) sel) (= (cdr m) sel)))
                               matches)
                       '()))
             (pool (if (null? mine) matches mine))
             (h (session-hint s))
             (after (and h (let loop ((ms pool))
                             (cond ((null? ms) #f)
                                   ((= (car (car ms)) h) ms)
                                   (else (loop (cdr ms)))))))
             (target (cond ((null? pool) #f)
                           ((and after (pair? (cdr after))) (cadr after))
                           (else (car pool)))))
        (session s hint-armed: #f
                      hint: (and target (car target))
                      hint-partner: (and target (cdr target))
                      trace: (trace-hint (session-trace s))
                      message: (if target "" "NO MOVES LEFT"))))

    ;; --- a waiting update (the web shell's, ruling D14) -------------------------
    ;;
    ;; The page tells the shell a new version is waiting; the shell puts
    ;; the state here and the game draws it: a prompt with APPLY and NOT
    ;; NOW above the HUD at launch, an UPDATE mark in the HUD during play
    ;; (tapping it brings the prompt back). APPLY leaves the state at apply
    ;; for the shell to hand to the page; nothing here reloads anything.

    (define (session-with-update s state)
      (session s update: state))

    ;; A click while an update is showing: the prompt's boxes or the mark.
    ;; Answers the new session, or #f when the click is not about the update.
    (define (step-update s click g)
      (let ((state (session-update s)))
        (cond ((not state) #f)
              ((eq? state 'prompt)
               (let ((hit (hit-update-control g (session-hud s) (car click) (cdr click))))
                 (cond ((eq? hit 'apply) (session s update: 'apply))
                       ((eq? hit 'later) (session s update: 'waiting))
                       (else #f))))
              ((eq? state 'waiting)
               (and (eq? (hit-update-control g (session-hud s) (car click) (cdr click)) 'update)
                    (session s update: 'prompt)))
              (else #f))))

    ;; --- the trace meter ------------------------------------------------------

    (define (session-with-best s best)
      (session s best: best))

    ;; A session from saved parts ((crash save)): the board as it was, the
    ;; meter, and the settings; tags and the cursor's home are recomputed.
    (define (session-restore seed b tr model labels-shown look)
      (session-with-model (session-on-board (session seed: seed
                                                     trace: tr
                                                     labels-shown: labels-shown
                                                     look: look)
                                            b)
                          model))

    (define (session-with-trace-mode s mode)
      (session s trace: (trace-with-mode (session-trace s) mode)))

    ;; The look: one name today (ruling D32); any other, from a save made
    ;; while the sheet switch was in the game, reads as it.
    (define (session-with-look s name)
      (session s look: (if (look-name? name) name DEFAULT-LOOK)))

    (define (severed? s)
      (trace-severed? (session-trace s)))

    (define (finished? s)
      (memq (trace-phase (session-trace s)) '(severed cleared)))

    ;; A shuffle that changed the board costs SHUFFLE-COST; one the generator
    ;; refused (nothing clearable) costs nothing and says so. Every lock goes
    ;; with the faces it was on (a lock over two re-dealt faces would mean
    ;; nothing), so a shuffle is also the expensive way out of a lock.
    (define (shuffle-command s)
      (let* ((b (session-board s))
             (broken (board-break-locks b))
             (nb (let ((dealt (reshuffle broken)))
                   (if (eq? dealt broken) b dealt))))
        (cond ((finished? s) s)
              ((eq? nb b) (session s message: "NOTHING TO SHUFFLE"))
              (else (session (session-on-board s nb)
                                  trace: (trace-shuffle (session-trace s)))))))

    ;; The HUD line for what the ICE just did, or the phase that began.
    (define (event-message events)
      (let ((last (if (null? events) #f (list-ref events (- (length events) 1)))))
        (case last
          ((traced) MSG-TRACED)
          ((lock) MSG-LOCKED-PAIR)
          ((remap) MSG-REMAPPED)
          ((scramble) MSG-SCRAMBLED)
          ((nothing) MSG-NOTHING)
          ((severed) MSG-SEVERED)
          (else #f))))

    ;; A lock that just turned weak by decay says so once.
    (define (weak-message tr0 tr1 b)
      (let ((t0 (trace-ticks tr0))
            (t1 (trace-ticks tr1))
            (locked (board-locked-slots b)))
        (and (pair? locked)
             (let ((any-turned? (let loop ((ids locked))
                                  (cond ((null? ids) #f)
                                        ((and (lock-weak? b (car ids) t1)
                                              (not (lock-weak? b (car ids) t0)))
                                         #t)
                                        (else (loop (cdr ids)))))))
               (and any-turned? MSG-LOCK-WEAK)))))

    ;; The frame's sim ticks reach the trace here, one at a time inside
    ;; trace-advance, which fires the counter-hacks its seconds cover; the
    ;; board it hands back replaces the session's, with tags and cursor
    ;; recomputed, and the last event becomes the HUD message.
    (define (session-advance s0 ticks)
      (let* ((s (session s0 tools: (tools-advance (session-tools s0) ticks)))
             (b (session-board s)))
        (if (or (finished? s) (= ticks 0))
            s
            (let* ((r (trace-advance (session-trace s) b ticks))
                   (tr (car r))
                   (nb (cadr r))
                   (events (caddr r))
                   (message (or (event-message events)
                                (weak-message (session-trace s) tr nb))))
              (cond ((and (eq? nb b) (not message))
                     (session s trace: tr))
                    ((eq? nb b)
                     (session s trace: tr message: message))
                    (else
                     (session (session-on-board s nb)
                                   trace: tr
                                   message: (or message ""))))))))

    ;; The next seed: a fresh deal, settings and mode kept.
    (define (session-next s)
      (session-retry (session s seed: (+ 1 (session-seed s)))))

    ;; The same stack again (a severed game's first choice, ctrl+r any
    ;; time): a fresh deal of this seed, settings kept, in the mode the
    ;; last game was in.
    (define (session-retry s)
      (session-with-trace-mode
        (session (session-new (board-layout (session-board s)) (session-seed s))
                      model: (session-model s)
                      labels-shown: (session-labels-shown s)
                      look: (session-look s)
                      best: (session-best s))
        (trace-mode (session-trace s))))

    (define (step-armed-hint s f)
      (let ((face (find (lambda (x) x) (map key->face (input-frame-pressed f)))))
        (if face (hint-jump s face) s)))

    ;; On a severed board the three choices are the board area's thirds:
    ;; RETRY LINK (the same stack again), NEW STACK, JACK OUT (the menu,
    ;; P4's; until then it only says so).
    (define (step-pointer s f g)
      (let ((click (input-frame-click f)))
        (cond ((not click) s)
              ((and (session-update s) (step-update s click g)) => (lambda (s) s))
              ((severed? s)
               (if (< (cdr click) (- (geometry-vh g) (geometry-hud-h g)))
                   (let ((third (quotient (geometry-vw g) 3)))
                     (cond ((< (car click) third) (session-retry s))
                           ((< (car click) (* 2 third)) (session-next s))
                           (else (session s message: MSG-NO-MENU))))
                   s))
              (else
               (let ((id (hit-slot g (session-board s) (car click) (cdr click))))
                 (if id (session-pick s id) s))))))

    ;; --- commands -----------------------------------------------------------

    ;; Backspace belongs to the hint model while a tag is half-typed.
    (define (typing? s)
      (and (eq? (session-model s) 'hint)
           (> (string-length (session-typed s)) 0)))

    (define (step-commands s f)
      (let ((b (session-board s))
            (ctrl (held? f 'ctrl)))
        (cond ((and (pressed? f 'tab) (held? f 'shift))
               (session s model: (next-model (session-model s)) typed: ""))
              ((pressed? f 'tab)
               (session s labels-shown: (not (session-labels-shown s)) typed: ""))
              ((pressed? f '?)
               (session s keys-shown: (not (session-keys-shown s))))
              ;; Escape (or the bar's MENU button, which sends it): the
              ;; menu, as a request the shell answers
              ((pressed? f 'escape)
               (session s request: 'menu))
              ;; the cursor model: Return picks the ringed tile (Space did,
              ;; until the tool stack took Space)
              ((and (pressed? f 'return)
                    (eq? (session-model s) 'cursor)
                    (session-cursor-shown s)
                    (session-highlight s))
               (session-pick s (session-highlight s)))
              ((pressed? f 'return)
               (let ((sel (board-selected b)))
                 (if sel (session-pick s sel) (session s typed: ""))))
              ((or (and (pressed? f 'backspace) (not (typing? s)))
                   (and ctrl (pressed? f 'z)))
               (if (finished? s) s (session-on-board s (board-undo b))))
              ((and ctrl (pressed? f 'r))
               (session-retry s))
              ((and ctrl (pressed? f 's))
               (shuffle-command s))
              ((and ctrl (pressed? f 'n))
               (session-next s))
              ((and (finished? s)
                    (or (pressed? f 'pair-hint) (and ctrl (pressed? f 'h))))
               s)
              ((or (pressed? f 'pair-hint)
                   (and ctrl (pressed? f 'h) (session-hint-armed s)))
               (hint-pair s))
              ((and ctrl (pressed? f 'h))
               (session s hint-armed: #t))
              (else #f))))

    ;; --- one frame ----------------------------------------------------------

    ;; The key frame a HUD control or a tool stands for. pair-hint is not
    ;; a key any keyboard sends; it is the control's own command. keys is
    ;; the ? button at the bar's right end; menu is answered as a request.
    ;; The meter (mode) and the TILES readout (look) are drawn, not
    ;; tapped, since the polish row: a tap on them is a tap on the bar.
    (define (control-command name)
      (case name
        ((undo) (make-input-frame '(backspace) '() #f))
        ((shuf) (make-input-frame '(s) '(ctrl) #f))
        ((hint) (make-input-frame '(pair-hint) '() #f))
        ((next) (make-input-frame '(n) '(ctrl) #f))
        ((keys) (make-input-frame '(?) '() #f))
        ((menu) (make-input-frame '(escape) '() #f))
        (else #f)))

    ;; A click on a control replaces the frame with that control's command
    ;; (keys pressed in the same frame wait: a tap on a phone comes alone).
    (define (with-control f g s)
      (let ((click (input-frame-click f)))
        (or (and click
                 (control-command (hit-control g (session-hud s) (car click) (cdr click))))
            f)))

    ;; --- the tool stack --------------------------------------------------------

    ;; This table's tools for the frame (ruling D33): under SEVERED only
    ;; NEXT; on a finished board UNDO, SHUFFLE and HINT are done.
    ;; MENU is not a tool (David, 2026-09-19): the bar's peer button next
    ;; to the wrench, or Escape. The two lists are built once each: the
    ;; step and the HUD both ask every frame, and four tool structs are
    ;; about 1 KB in the native codegen (2026-09-20).
    (define *tools-in-play* #f)
    (define *tools-done* #f)

    (define (session-tools-list s)
      (if (finished? s)
          (or *tools-done* (begin (set! *tools-done* (build-tools-list #f)) *tools-done*))
          (or *tools-in-play* (begin (set! *tools-in-play* (build-tools-list #t)) *tools-in-play*))))

    (define (build-tools-list play?)
      (list (make-tool 'undo "UNDO" 'u #f #f play?)
            (make-tool 'shuf "SHUFFLE" 's SHUFFLE-COST #f play?)
            (make-tool 'hint "HINT" 'h HINT-COST #f play?)
            (make-tool 'next "NEXT" 'n)))

    ;; The touch flag also sets the device the session opens on.
    (define (session-with-tools-touch s touch?)
      (session s
               tools: (tools-with-touch (session-tools s) touch?)
               device: (if touch? 'touch 'mouse)))

    (define (session-with-hud s name)
      (session s hud: (if (layout-name? name) name DEFAULT-LAYOUT)))

    (define (session-clear-request s)
      (session s request: #f))

    ;; A chosen tool fires as its command.
    (define (fire-tool s name g)
      (let ((f (control-command name)))
        (or (and f (step-commands s f)) s)))

    ;; The instruction line: what the bar says under the readouts when the
    ;; keys line is hidden (D33: a new player's first minute depends on it).
    (define (session-instruction s)
      (let ((b (session-board s)))
        (cond ((session-hint-armed s) "HINT: PRESS A FACE KEY")
              ((board-cleared? b) "STACK CRASHED. NEXT DEALS ANOTHER.")
              ((board-no-moves? b) "NO MOVES LEFT: SHUFFLE.")
              ((board-selected b) "NOW ITS MATCH.")
              ((eq? (session-device s) 'keyboard) "PRESS THE LETTERS OF TWO MATCHING TILES.")
              (else "TAP TWO MATCHING TILES."))))

    ;; The stack sees the raw frame first (a tap on the bar while it is
    ;; open closes it, whatever control sits there; the review of S8
    ;; found the bar's rewrite swallowing such taps); only a frame the
    ;; stack left alone is rewritten by the bar's controls.
    (define (session-step s f0 g)
      (let* ((s (let ((d (frame-device f0 (tools-touch (session-tools s)))))
                  (if (and d (not (eq? d (session-device s)))) (session s device: d) s)))
             (was-open (tools-open? (session-tools s)))
             (r (tools-step (session-tools s)
                            (cons (input-frame-pressed f0) (input-frame-click f0))
                            (session-tools-list s)
                            (geometry-vw g)
                            (geometry-vh g)))
             ;; the session is copied only when the stack changed (an idle
             ;; frame is the common one)
             (s (if (eq? (car r) (session-tools s)) s (session s tools: (car r))))
             (f (with-control f0 g s)))
        (cond (was-open
               ;; modal: the frame was the stack's, whatever it held
               (if (cdr r) (fire-tool s (cdr r) g) s))
              ((tools-open? (car r))
               (session s typed: ""))
              ((step-commands s f) => (lambda (s) s))
              ((session-hint-armed s) (step-armed-hint s f))
              (else
               (let* ((s (step-pointer s f g))
                      (model (session-model s)))
                 (cond ((held? f 'ctrl) s)
                       ((eq? model 'hint) (step-hint s f))
                       ((eq? model 'cursor) (step-cursor s f))
                       (else s)))))))))
