;;; (crash native) - The game's own natives, registered from C.
;;;
;;; src/c/crash-native.c registers %mix-track! (the music mixer's inner
;;; loop, both targets), %upsample! (the live soundtrack rendered below
;;; the device rate, a 4-tap cubic into the device-rate buffer; M1, both),
;;; %b64-decode (the page's delivery, both), %fatal!
;;; (the page guard's trap door: a FATAL line and abort(), both) and
;;; %decode-ogg (stb_vorbis, native only; #f on
;;; the web) under this module's name at startup, the way sigil-audio's
;;; audio.c fills (sigil audio); this file is the library the compiler
;;; needs to see so (crash audio) can import the names. The one
;;; definition here names the C surface's version (the compiler refuses
;;; an empty library).

(define-library (crash native)
  (export NATIVE-SURFACE)

  (begin
    ;; bump when the C natives' arguments change
    (define NATIVE-SURFACE 3)))
