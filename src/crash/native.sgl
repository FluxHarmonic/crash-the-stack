;;; (crash native) - The game's own natives, registered from C.
;;;
;;; src/c/crash-native.c registers %b64-decode (the page's delivery,
;;; both targets), %upsample! (the live soundtrack rendered below the
;;; device rate, a 4-tap cubic into the device-rate buffer; M1, both),
;;; %cpu-ms (the process's CPU clock for the bench; native) and %fatal!
;;; (the page guard's trap door: a FATAL line and abort(), both) under
;;; this module's name at startup, the way sigil-audio's audio.c fills
;;; (sigil audio); this file is the library the compiler needs to see so
;;; the importers can name them. The one definition here names the C
;;; surface's version (the compiler refuses an empty library). P4's
;;; %mix-track! and %decode-ogg left with M1.

(define-library (crash native)
  (export NATIVE-SURFACE)

  (begin
    ;; bump when the C natives' arguments change
    (define NATIVE-SURFACE 5)))
