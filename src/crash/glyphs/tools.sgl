;;; (crash glyphs tools) - the tool icons, GENERATED by scripts/art/icons
;;; from assets/src/glyphs/tools.txt; edit the text, not this file. Each icon is twelve
;;; rows of twelve cells, # lit (the font's draw-rows format), by name.

