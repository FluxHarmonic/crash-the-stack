         "dsk-disc"
         "dsk-hash"
         "dsk-seal"
         "dsk-link"
         "dsk-wheel"
         "dsk-folder"
         "daemon-eye"
         "daemon-hand"
         "daemon-mask"
         "daemon-skull"))

    (define SHEET-A
      '#(("#####" "#####" "#####" "#####" "#####" "#####" "#####")
         ("....." "....." "....." "#####" "#####" "#####" "#####")
         ("#.#.#" "....." "#.#.#" "....." "#.#.#" "....." "#.#.#")
         ("#####" "....." "#####" "....." "#####" "....." "#####")
         ("#.#.#" ".#.#." "#.#.#" ".#.#." "#.#.#" ".#.#." "#.#.#")
         ("#####" "#...#" "#...#" "#...#" "#...#" "#...#" "#####")
         ("#...#" ".#.#." "..#.." ".#.#." "#...#" ".#.#." "..#..")
         ("##.##" "#...#" "....." "....." "....." "#...#" "##.##")
         ("..###" ".###." "###.." "#####" "..###" ".###." "###..")
         (".###." "#####" "#...#" "#...#" "#####" "#####" "#####")
         ("....." ".###." ".#.#." ".#.#." ".#.#." "##.##" ".....")
         ("..#.." "..#.." ".#.#." ".#.#." "#...#" "#...#" ".....")
         ("....." "....." ".#..." "#.#.#" "...#." "....." ".....")
         ("..#.." "..#.." "#####" "....." ".###." "....." "..#..")
         ("..#.." "#.#.#" ".###." "..#.." ".###." "#.#.#" "..#..")
         (".#.#." ".#.#." "#####" "#####" ".###." "..#.." "..#..")
         ("#...#" ".#.#." "..#.." "..#.." "..#.." "..#.." "..#..")
         ("..##." "..###" "#####" "#####" "..###" "..##." ".....")
         ("....." "..#.." ".###." "#####" ".###." "..#.." ".....")
         ("###.." "#.#.." "#.###" "###.#" "..#.#" "..###" ".....")
         ("....." "..#.." ".#.#." "#...#" ".#.#." "..#.." ".....")
         ("#.#.#" "#####" "#.#.#" "#####" "#.#.#" "#####" "#.#.#")
         ("....." "#...#" "#...#" ".#.#." "..#.." "..#.." ".###.")
         (".###." "#...#" "....." ".###." "....." "..#.." ".....")
         (".###." "#...#" ".###." "..#.." "..#.." "..##." "..#..")
         (".###." "#...#" "#####" "#####" "##.##" "#####" "#####")
         (".###." "#...#" "#.#.#" "#...#" ".###." "....." ".....")
         (".#.#." "#####" ".#.#." ".#.#." "#####" ".#.#." ".....")
         ("....." ".###." "#####" "##.##" "#####" ".###." ".....")
         (".###." "#...#" "#.###" "##.##" "###.#" "#...#" ".###.")
         ("..#.." ".###." "##.##" "#.#.#" "##.##" ".###." "..#..")
         ("##..." "#####" "#####" "#####" "#####" "#####" ".....")
         ("....." ".###." "#...#" "#.#.#" "#...#" ".###." ".....")
         ("#.#.#" "#.#.#" "#####" "#####" ".###." ".###." "..#..")
         ("#####" "#.#.#" "#####" ".#.#." ".###." "....." ".....")
         (".###." "#...#" "#.#.#" "#####" ".#.#." ".###." ".#.#.")))))
