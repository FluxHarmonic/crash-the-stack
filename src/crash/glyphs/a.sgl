;;; (crash glyphs a) - glyph sheet A, GENERATED by scripts/art/glyphs
;;; from assets/src/glyphs/a.txt; edit the text, not this file. 36 faces in
;;; face order, each seven rows of five cells, # lit (the font's format).

(define-library (crash glyphs a)
  (export SHEET-A SHEET-A-NAMES)

  (begin
    (define SHEET-A-NAMES
      '#("mem-full"
         "mem-half"
         "mem-dotted"
         "mem-striped"
