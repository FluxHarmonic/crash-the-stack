;;; (crash tracker main) - The entry of crash-tracker.wasm
;;;
;;; The tracker's own wasm (David, 2026-09-21): the package's entry for the
;;; tracker-web config, where the wasm runtime resolves main and
;;; sigil-web-dispatch-event. Everything is (crash tracker web); on native
;;; the tracker lives inside the game (--tune / --tracker), so this module
;;; is the web arm only and answers nothing elsewhere.

(define-library (crash tracker main)
  (cond-expand
    (wasm (import (crash tracker web)))
    (else (import (sigil core))))

  (export main sigil-web-dispatch-event)

  (begin
    (cond-expand
      (wasm
       (define (main . args)
         (tracker-web-main))
       (define (sigil-web-dispatch-event type payload)
         (tracker-web-dispatch type payload)))
      (else
       (define (main . args) 0)
       (define (sigil-web-dispatch-event type payload) 0)))))
