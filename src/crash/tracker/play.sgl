;;; (crash tracker play) - A tune through motif's stream into the sink
;;;
;;; (play-start! tune pos row loop?) compiles the tune at the sink's rate
;;; from (pos . row) with (motif tune compile)'s start:, opens a render
;;; stream and registers it as (crash audio)'s source: every pump pulls
;;; the frames the sink has room for straight out of the stream (no
;;; allocation, render-stream-chunk-into!). A looping play restarts the
;;; stream when it runs out; a plain play stops.
;;;
;;; The clock: the row under the listener is the compiled timeline entry
;;; whose start is at or before (render position - the sink's depth), the
;;; sample now leaving the device, so a slow frame moves the cursor by
;;; audio time. (play-position) answers (pos . row) or #f.
;;;
;;; The cost readout: (play-chunk-ms) is the wall time of the last pull
;;; per 1024 frames, the number the gate pins on both targets.

(define-library (crash tracker play)
  (import (sigil math)
          (sigil time)
          (motif tune)
          (motif tune compile)
          (motif render)
          (crash audio))

  (export play-start! play-stop! play-pump-source play-position play-playing?
          play-loop? play-chunk-ms play-rendered-frames play-tick-length
          TUNE-GAIN)

  (begin
    (define TUNE-GAIN 0.9)

    (define *stream* #f)         ; the open render stream, or #f
    (define *compiled* #f)       ; the compiled tune (timeline, length)
    (define *tune* #f)
    (define *start* #f)          ; (pos . row) the stream began at
    (define *loop* #f)
    (define *chunk-ms* 0.0)      ; wall ms of the last pull, per 1024 frames
    (define *rendered* 0)        ; frames pulled since play-start!

    (define (play-playing?) (and *stream* #t))
    (define (play-loop?) *loop*)
    (define (play-chunk-ms) *chunk-ms*)
    (define (play-rendered-frames) *rendered*)

    (define (open! tune pos row loop?)
      (let* ((sr (audio-rate))
             (t (if loop? (tune tune order: (list (list-ref (tune-order tune) pos))) tune))
             (start (if loop? (cons 0 row) (cons pos row)))
             (trk (tune->track t sr: sr start: start))
             (ct (compile-tune t sr start: start)))
        (set! *compiled* ct)
        (set! *stream* (open-render-stream trk))))

    ;; Pull n frames into out at byte-offset; answers #t while the stream
    ;; has more, #f once it ended (the pump then drops the source).
    (define (pull! out byte-offset n)
      (let* ((t0 (current-milliseconds))
             (ok (if (and *stream* (render-stream-done? *stream*))
                     (if *loop*
                         (begin
                           (close-render-stream! *stream*)
                           (open! *tune* (car *start*) (cdr *start*) #t)
                           #t)
                         #f)
                     #t)))
        (if (not ok)
            (begin (play-stop!) #f)
            (begin
              (render-stream-chunk-into! *stream* out byte-offset n)
              (set! *rendered* (+ *rendered* n))
              (let ((ms (- (current-milliseconds) t0)))
                (when (> n 0)
                  (set! *chunk-ms* (/ (* 1024.0 ms) n))))
              #t))))

    (define (play-pump-source) pull!)

    (define (play-start! tune pos row loop?)
      (play-stop!)
      (set! *tune* tune)
      (set! *start* (cons pos row))
      (set! *loop* loop?)
      (set! *rendered* 0)
      (open! tune pos row loop?)
      (audio-set-source! pull! TUNE-GAIN)
      #t)

    (define (play-stop!)
      (when *stream*
        (audio-set-source! #f 0.0)
        (close-render-stream! *stream*)
        (set! *stream* #f)
        (set! *compiled* #f)))

    ;; Samples of one tick at the tune's tempo, for the gate's "two rows" arithmetic.
    (define (play-tick-length tune)
      (/ (* (audio-rate) 2.5) (tune-tempo tune)))

    ;; The (pos . row) now leaving the device, or #f when not playing.
    (define (play-position)
      (and *stream* *compiled*
           (let* ((now (- (render-stream-position *stream*) (audio-source-depth)))
                  (now (max 0 now)))
             (let ((e (let loop ((es (compiled-tune-timeline *compiled*)) (best #f))
                        (cond ((null? es) best)
                              ((<= (vector-ref (car es) 2) now) (loop (cdr es) (car es)))
                              (else best)))))
               (and e
                    (if *loop*
                        (cons (car *start*) (vector-ref e 1))
                        (cons (vector-ref e 0) (vector-ref e 1))))))))

    ))
