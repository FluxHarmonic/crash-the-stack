;;; (crash render) - Drawing the table.
;;;
;;; Takes a session, a geometry, (optionally) the test-tile texture and the
;;; frame's effects from (crash fx), and draws one frame with sigil-graphics
;;; primitives: a copper-bar background, each tile as a flat face over a
;;; darker side face offset per layer (moved, scaled or flipped as the
;;; effects say), the glyph in its suit color from the bitmap font, the
;;; selection and the keyboard highlight, the match ghosts and particles,
;;; the hint tags, and the HUD with its tappable controls. Nothing here
;;; reads input, a platform or a clock; the shell decides what texture to
;;; hand in (native: load-image from assets/; web: from memory) and the
;;; effects arrive already advanced.
;;;
;;; Palette: at most 32 colors, all named here, for the Amiga feel and so
;;; David can retune the look in one place (design decision 7).

(define-library (crash render)
  (import (sigil struct)
          (sigil math)
          (sigil graphics)
          (crash stack layout)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash trace)
          (crash tween)
          (crash fx)
          (crash font))

  (export draw-session draw-frame-ms
          TEST-TILE-W TEST-TILE-H TEST-TILE-FRAMES)

  (begin
    ;; --- palette ------------------------------------------------------------
    ;; (r g b) in 0..1. Sixteen used; sixteen in hand.

    (define C-BG        '(0.05 0.04 0.10))
    (define C-BAR-A     '(0.09 0.07 0.18))
    (define C-BAR-B     '(0.13 0.09 0.24))
    (define C-BAR-C     '(0.18 0.11 0.30))
    (define C-FACE      '(0.86 0.88 0.90))
    (define C-FACE-EDGE '(0.98 0.99 1.00))
    (define C-SIDE      '(0.42 0.44 0.52))
    (define C-SIDE-DARK '(0.24 0.25 0.32))
    (define C-SELECTED  '(0.30 0.95 0.85))
    (define C-HIGHLIGHT '(1.00 0.35 0.85))
    (define C-TEXT      '(0.80 0.90 1.00))
    (define C-TEXT-DIM  '(0.45 0.50 0.65))
    (define C-SUIT-0    '(0.10 0.45 0.85))   ; digits 0-8
    (define C-SUIT-1    '(0.80 0.20 0.25))   ; 9-h
    (define C-SUIT-2    '(0.10 0.55 0.30))   ; i-q
    (define C-SUIT-3    '(0.55 0.25 0.70))   ; r-z
    (define C-LABEL-LIT '(1.00 0.80 0.20))
    (define C-LOCKED    '(0.55 0.30 0.45))   ; a locked tile's face
    (define C-TRACE     '(0.30 0.95 0.85))   ; the meter, low
    (define C-TRACE-HOT '(1.00 0.35 0.35))   ; the meter, near the lock
    ;; Tints for the test-tile texture: white leaves the art as drawn.
    (define C-TEX-PLAIN     '(1.00 1.00 1.00))
    (define C-TEX-SELECTED  '(0.50 1.00 0.95))

    (define (color! c)
      (set-color (car c)
                 (cadr c)
                 (caddr c)
                 1.0))

    (define (color-alpha! c a)
      (set-color (car c)
                 (cadr c)
                 (caddr c)
                 a))

    ;; c0 at t = 0, c1 at t = 1.
    (define (mix c0 c1 t)
      (let loop ((c0 c0) (c1 c1) (acc '()))
        (if (null? c0)
            (reverse acc)
            (loop (cdr c0)
                  (cdr c1)
                  (cons (+ (car c0) (* (- (car c1) (car c0)) t)) acc)))))

    (define (suit-color face)
      (cond ((< face 9) C-SUIT-0)
            ((< face 18) C-SUIT-1)
            ((< face 27) C-SUIT-2)
            (else C-SUIT-3)))

    ;; --- test tile texture layout -------------------------------------------
    ;; assets/test-tile.png is a strip of TEST-TILE-FRAMES frames, each
    ;; TEST-TILE-W x TEST-TILE-H: frame 0 the blank block (side face included
    ;; in the art), frames 1.. the hand-drawn glyph faces for faces 0, 1, 2.

    (define TEST-TILE-W 32)
    (define TEST-TILE-H 44)
    (define TEST-TILE-FRAMES 4)

    ;; --- background -----------------------------------------------------------

    ;; roll: pixels the copper bars have scrolled (the cleared sequence
    ;; rolls them; 0 otherwise).
    (define (draw-background g roll)
      (let ((vw (geometry-vw g))
            (vh (geometry-vh g))
            (shift (modulo (exact (floor roll)) 36)))
        (color! C-BG)
        (draw-filled-rect 0 0 vw vh)
        ;; copper bars: three tones stepping through the board area
        (let loop ((y (- shift 36)) (i 0))
          (when (< y (- vh (geometry-hud-h g)))
            (color! (case (modulo i 3)
                       ((0) C-BAR-A)
                       ((1) C-BAR-B)
                       (else C-BAR-C)))
            (draw-filled-rect 0 y vw 6)
            (loop (+ y 12) (+ i 1))))))

    ;; --- tiles ----------------------------------------------------------------

    (define (glyph-scale g)
      (max 1 (exact (floor (/ (- (geometry-tile-w g) 6) GLYPH-W)))))

    ;; The glyph is drawn only while the (possibly flipping) face is wide
    ;; enough to hold it; a tile edge-on shows no glyph.
    (define (draw-glyph-on g face x y w h dark?)
      (let* ((scale (glyph-scale g))
             (gw (* scale GLYPH-W))
             (gh (* scale GLYPH-H))
             (text (string (string-ref FACE-KEYS face))))
        (when (>= w (+ gw 2))
          (color! (if dark? C-BG (suit-color face)))
          (draw-text text
                     (+ x (exact (floor (/ (- w gw) 2))))
                     (+ y (exact (floor (/ (- h gh) 2))))
                     scale))))

    ;; A tile is drawn in two passes per layer: first its side faces (left and
    ;; bottom, one layer offset deep), then its face. With half-row offsets a
    ;; single draw order cannot be right for both: the Turtle's end tile at
    ;; y=0 straddles the rows at -0.5 and 0.5, and whichever order the sort
    ;; picks, one neighbor's side strip paints over the other's face (David
    ;; saw the dark strip on the tile beside each end tile, 2026-09-16).
    ;; Drawing every side in a layer before any face makes each face cover
    ;; every side strip that overlaps it, which is what a stack looks like.

    (define (draw-sides-primitives g x y w h)
      (let ((side (geometry-side g)))
        ;; the bottom strip runs the full width plus the side so the corner is filled
        (color! C-SIDE-DARK)
        (draw-filled-rect (- x side) (+ y h) (+ w side) side)
        (color! C-SIDE)
        (draw-filled-rect (- x side) y side h)))

    ;; glow: 0..1, how bright the selected face breathes this frame. A
    ;; locked tile's face is dimmed and barred across the top.
    (define (draw-face-primitives g face x y w h selected? locked? glow)
      ;; the face, with a lighter top-left edge
      (color! (cond (selected? (mix C-SELECTED C-FACE-EDGE (* 0.35 glow)))
                    (locked? C-LOCKED)
                    (else C-FACE)))
      (draw-filled-rect x y w h)
      (color! (if selected? C-SELECTED C-FACE-EDGE))
      (draw-filled-rect x y w 1)
      (draw-filled-rect x y 1 h)
      (when face (draw-glyph-on g face x y w h selected?))
      (when locked?
        (color! C-HIGHLIGHT)
        (draw-filled-rect x (+ y 3) w 2)
        (draw-filled-rect x (+ y h -5) w 2)))

    ;; Test-tile mode: the drawn block scaled to the tile, with the drawn
    ;; face for faces 0..2 and the bitmap glyph for the rest, so the two
    ;; directions sit side by side on one board. The strip's frame carries
    ;; the side art in its left and bottom cells (TEST-TILE-SIDE of them), so
    ;; the side pass draws the whole frame and the face pass redraws only the
    ;; face region over it.

    (define TEST-TILE-SIDE 4)

    (define (tile-frame b id)
      (let ((face (tile-face b id)))
        (if (and face (< face (- TEST-TILE-FRAMES 1)))
            (+ face 1)
            0)))

    (define (draw-sides-texture g b id tex x y w h selected?)
      (let ((side (geometry-side g))
            (frame (tile-frame b id)))
        (color! (if selected? C-TEX-SELECTED C-TEX-PLAIN))
        (draw-texture-region tex
                             (- x side) y
                             (+ w side) (+ h side)
                             (* frame TEST-TILE-W) 0
                             TEST-TILE-W TEST-TILE-H)))

    (define (draw-face-texture g b id face tex x y w h selected?)
      (let ((frame (tile-frame b id)))
        (color! (if selected? C-TEX-SELECTED C-TEX-PLAIN))
        (draw-texture-region tex
                             x y
                             w h
                             (+ (* frame TEST-TILE-W) TEST-TILE-SIDE) 0
                             (- TEST-TILE-W TEST-TILE-SIDE)
                             (- TEST-TILE-H TEST-TILE-SIDE))
        (when (and face (= frame 0))
          (draw-glyph-on g face x y w h selected?))))

    ;; A ring around a tile: the cursor highlight in magenta, the priced
    ;; hint in yellow. Drawn after every tile so no neighbor paints over it.
    (define (draw-ring g id color alpha)
      (let* ((r (slot-rect g id))
             (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color-alpha! color alpha)
        (draw-filled-rect (- x 1) (- y 1) (+ w 2) 2)
        (draw-filled-rect (- x 1) (+ y h -1) (+ w 2) 2)
        (draw-filled-rect (- x 1) (- y 1) 2 (+ h 2))
        (draw-filled-rect (+ x w -1) (- y 1) 2 (+ h 2))))

    ;; A tile's rect after the effects: (x y w h) moved by (dx dy) and
    ;; scaled about its centre by (sx sy).
    (define (viewed-rect r view)
      (if (not view)
          r
          (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
                 (dx (car view)) (dy (cadr view))
                 (sx (caddr view)) (sy (cadddr view))
                 (w2 (* w sx))
                 (h2 (* h sy)))
            (list (+ x dx (/ (- w w2) 2.0))
                  (+ y dy (/ (- h h2) 2.0))
                  w2
                  h2))))

    (define (draw-tiles s g tex x)
      (let* ((b (session-board s))
             (lay (board-layout b))
             (selected (board-selected b))
             (glow (fx-glow x))
             (textured? (and tex (eq? (session-render-mode s) 'texture)))
             (highlight (and (eq? (session-model s) 'cursor)
                             (session-cursor-shown s)
                             (session-highlight s)
                             (tile-present? b (session-highlight s))
                             (session-highlight s)))
             (each-on-layer
               (lambda (layer proc)
                 (for-each
                   (lambda (id)
                     (when (and (tile-present? b id)
                                (= layer (slot-layer (layout-slot lay id))))
                       (let* ((view (fx-tile-view x id))
                              (r (viewed-rect (slot-rect g id) view))
                              (face (or (and view (list-ref view 4))
                                        (tile-face b id))))
                         (proc id
                               face
                               (car r) (cadr r) (caddr r) (cadddr r)
                               (eqv? selected id)))))
                   (geometry-draw-order g)))))
        (let loop ((layer 0))
          (when (< layer (layout-layer-count lay))
            (each-on-layer layer
                           (lambda (id face x y w h selected?)
                             (if textured?
                                 (draw-sides-texture g b id tex x y w h selected?)
                                 (draw-sides-primitives g x y w h))))
            (each-on-layer layer
                           (lambda (id face x y w h selected?)
                             (if textured?
                                 (draw-face-texture g b id face tex x y w h selected?)
                                 (draw-face-primitives g face x y w h selected?
                                                       (tile-locked? b id) glow))))
            (loop (+ layer 1))))
        (draw-ghosts g x)
        (draw-particles g x)
        (when highlight (draw-ring g highlight C-HIGHLIGHT 1.0))
        (let ((hint (session-hint s))
              (partner (session-hint-partner s))
              (ring-alpha (fx-ring-alpha x)))
          (when (and hint (tile-present? b hint))
            (draw-ring g hint C-LABEL-LIT ring-alpha))
          (when (and partner (tile-present? b partner))
            (draw-ring g partner C-LABEL-LIT ring-alpha)))))

    ;; The match ghosts: a face rising off the table and fading, in the
    ;; primitives style whatever the render mode (the burst is the point).
    (define (draw-ghosts g x)
      (for-each (lambda (ghost)
                  (let ((face (car ghost))
                        (gx (cadr ghost))
                        (gy (caddr ghost))
                        (w (cadddr ghost))
                        (h (list-ref ghost 4))
                        (a (list-ref ghost 5)))
                    (color-alpha! C-SIDE a)
                    (draw-filled-rect (- gx 2) gy (+ w 2) (+ h 2))
                    (color-alpha! C-SELECTED a)
                    (draw-filled-rect gx gy w h)
                    (when face
                      (color-alpha! (suit-color face) a)
                      (let* ((scale (glyph-scale g))
                             (gw (* scale GLYPH-W))
                             (gh (* scale GLYPH-H)))
                        (draw-text (string (string-ref FACE-KEYS face))
                                   (exact (floor (+ gx (/ (- w gw) 2))))
                                   (exact (floor (+ gy (/ (- h gh) 2))))
                                   scale)))))
                (fx-ghosts x)))

    ;; Glyph fragments and rain: small squares in the suit color.
    (define (draw-particles g x)
      (for-each (lambda (pt)
                  (color-alpha! (suit-color (car pt)) (list-ref pt 4))
                  (draw-filled-rect (cadr pt)
                                    (caddr pt)
                                    (cadddr pt)
                                    (cadddr pt)))
                (fx-particles x (geometry-vw g) (geometry-vh g))))

    ;; --- hint labels (model c) -------------------------------------------------
    ;;
    ;; Shown only while the session says so (space toggles them): a small dark
    ;; tag in the 3x5 set, centered on the tile's top edge so the glyph stays
    ;; readable under it; the letters typed so far are drawn lit.

    (define (draw-hint-labels s g)
      (let ((typed (session-typed s)))
        (for-each
          (lambda (entry)
            (let* ((r (slot-rect g (car entry)))
                   (label (cdr entry))
                   (tw (text-width-mini label 1))
                   (w (+ 4 tw))
                   (x (+ (car r) (exact (floor (/ (- (caddr r) w) 2)))))
                   (y (- (cadr r) 3))
                   (prefix? (and (> (string-length typed) 0)
                                 (<= (string-length typed) (string-length label))
                                 (string=? typed
                                           (substring label 0 (string-length typed))))))
              (color! C-BG)
              (draw-filled-rect x y w 7)
              (color! (if prefix? C-HIGHLIGHT C-LABEL-LIT))
              (draw-text-mini label (+ x 2) (+ y 1) 1)))
          (session-labels s))))

    ;; --- HUD ------------------------------------------------------------------
    ;;
    ;; Row 1: the tile counter, the four controls (rects from (crash
    ;; geometry), so a tap lands where the button is drawn), the hint count
    ;; (the trace meter takes this spot in the trace slice) and the seed.
    ;; Row 2: the keys of the model in use.

    (define HINT-KEYS-LINE
      "TAGS: TYPE ONE  SPACE HIDE  ENTER DESELECT  TAB CURSOR  BKSP UNDO  ^S SHUFFLE  ^H HINT  ^N NEXT  ^T TILE")
    (define CURSOR-KEYS-LINE
      "CURSOR: ARROWS MOVE  SPACE PICK  ENTER DESELECT  TAB TAGS  BKSP UNDO  ^S SHUFFLE  ^H HINT  ^N NEXT  ^T TILE")
    ;; Shown in place of the keys line while a lock is on the board: being
    ;; traced does not end the game (David, 2026-09-17).
    (define TRACED-LINE
      "TRACED: THE ICE LOCKED A PAIR. A LOCKED PAIR NEEDS TWO MATCHES. THE GAME GOES ON.")

    (define (control-label name)
      (case name
        ((undo) "UNDO")
        ((shuf) "SHUF")
        ((hint) "HINT")
        ((next) "NEXT")
        (else "?")))

    (define (draw-controls g)
      (for-each (lambda (c)
                  (let* ((name (car c))
                         (x (cadr c)) (y (caddr c))
                         (w (cadddr c)) (h (list-ref c 4))
                         (label (control-label name))
                         (tw (text-width label 2)))
                    (color! C-BAR-C)
                    (draw-filled-rect x y w h)
                    (color! C-TEXT-DIM)
                    (draw-filled-rect x y w 1)
                    (draw-filled-rect x (+ y h -1) w 1)
                    (draw-filled-rect x y 1 h)
                    (draw-filled-rect (+ x w -1) y 1 h)
                    (color! C-TEXT)
                    (draw-text label
                               (+ x (exact (floor (/ (- w tw) 2))))
                               (+ y 3)
                               2)))
                (filter (lambda (c) (not (eq? (car c) 'mode)))
                        (geometry-controls g))))

    ;; The meter, in the rect (crash geometry) reserves for it. Twist: a
    ;; bar filling toward the lock, going hot as it nears, with the value;
    ;; clean: GNOME's clock. Tapping it flips the face ((crash input)).
    (define (draw-meter g tr)
      (let* ((r (control-rect g 'mode))
             (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color! C-BG)
        (draw-filled-rect x y w h)
        (if (eq? (trace-mode tr) 'clean)
            (let ((text (string-append "TIME " (trace-clock-string tr))))
              (color! C-TEXT)
              (draw-text text (+ x 4) (+ y 3) 2))
            (let* ((frac (trace-fraction tr))
                   (fill (exact (floor (* (- w 2) frac))))
                   (text (string-append "TRACE "
                                        (number->string (exact (floor (trace-value tr)))))))
              (color! C-TEXT-DIM)
              (draw-filled-rect x y w 1)
              (draw-filled-rect x (+ y h -1) w 1)
              (draw-filled-rect x y 1 h)
              (draw-filled-rect (+ x w -1) y 1 h)
              (color! (mix C-TRACE C-TRACE-HOT frac))
              (draw-filled-rect (+ x 1) (+ y 1) fill (- h 2))
              (color! (if (trace-locked? tr) C-HIGHLIGHT C-TEXT))
              (draw-text (if (trace-locked? tr) "LOCKED" text) (+ x 4) (+ y 3) 2)))))

    ;; The centred message box: the cleared sequence slides it in and
    ;; fades it up over its first fifth; every other message just sits.
    (define (draw-message g message top cleared)
      (let* ((w (text-width message 3))
             (x (exact (floor (/ (- (geometry-vw g) w) 2))))
             (p (if cleared (min 1.0 (* cleared 5.0)) 1.0))
             (k (ease 'out-back p))
             (y (exact (floor (+ (/ top 2) (* 40 (- 1.0 k)))))))
        (color-alpha! C-BG p)
        (draw-filled-rect (- x 8) (- y 16) (+ w 16) 36)
        (color-alpha! C-SELECTED p)
        (draw-text message x (- y 10) 3)))

    (define (draw-hud s g x)
      (let* ((b (session-board s))
             (vw (geometry-vw g))
             (vh (geometry-vh g))
             (top (- vh (geometry-hud-h g)))
             (left (string-append "TILES " (number->string (board-tile-count b))))
             (right (string-append "SEED " (number->string (session-seed s))))
             (cleared (fx-cleared x)))
        (color! C-BG)
        (draw-filled-rect 0 top vw (geometry-hud-h g))
        (color! C-TEXT-DIM)
        (draw-filled-rect 0 top vw 1)
        (color! C-TEXT)
        (draw-text left 8 (+ top 7) 2)
        (draw-text right (- vw 8 (text-width right 2)) (+ top 7) 2)
        (draw-controls g)
        (draw-meter g (session-trace s))
        (if (pair? (board-locked-slots b))
            (begin
              (color! C-HIGHLIGHT)
              (draw-text TRACED-LINE 8 (+ top 32) 1))
            (begin
              (color! C-TEXT-DIM)
              (draw-text (if (eq? (session-model s) 'hint)
                             HINT-KEYS-LINE
                             CURSOR-KEYS-LINE)
                         8 (+ top 32) 1)))
        (when (> (string-length (session-typed s)) 0)
          (color! C-HIGHLIGHT)
          (draw-text (string-append "> " (session-typed s))
                     (- vw 8 (text-width right 2) 24 (text-width (string-append "> " (session-typed s)) 2))
                     (+ top 7)
                     2))
        (let ((message (cond ((board-cleared? b)
                              "STACK CRASHED")
                             ((null? (legal-matches b))
                              "NO MOVES LEFT - SHUFFLE")
                             (else
                              (session-message s)))))
          (unless (string=? message "")
            (draw-message g message top (and (board-cleared? b) cleared))))))

    ;; Frame-time readout for --log-keys: last frame in ms, top-right.
    (define (draw-frame-ms ms)
      (let ((text (string-append "MS " (number->string (exact (round ms))))))
        (color! C-LABEL-LIT)
        (draw-text text (- 640 8 (text-width text 2)) 6 2)))

    ;; --- one frame ------------------------------------------------------------

    ;; x: the frame's effects from (crash fx), already advanced.
    (define (draw-session s g tex x)
      (let ((cleared (fx-cleared x)))
        (draw-background g (if cleared (* cleared 400.0) 0.0))
        (draw-tiles s g tex x)
        (when (and (eq? (session-model s) 'hint) (session-labels-shown s))
          (draw-hint-labels s g))
        (draw-hud s g x)))))
