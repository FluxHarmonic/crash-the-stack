;;; (crash render) - Drawing the table.
;;;
;;; Takes a session, a geometry, (optionally) the test-tile texture and the
;;; frame's effects from (crash fx), and draws one frame with sigil-graphics
;;; primitives: a copper-bar background, each tile as a flat face over a
;;; darker side face offset per layer (moved, scaled or flipped as the
;;; effects say), the glyph in its suit color from the bitmap font, the
;;; selection and the keyboard highlight, the match ghosts and particles,
;;; the hint tags, and the HUD with its tappable controls. Nothing here
;;; reads input, a platform or a clock; the shell decides what texture to
;;; hand in (native: load-image from assets/; web: from memory) and the
;;; effects arrive already advanced.
;;;
;;; Palette: the colors come from (crash palette), at most 32, so David
;;; can retune the look in one place (design decision 7).

(define-library (crash render)
  (import (sigil struct)
          (sigil math)
          (sigil graphics)
          (crash stack layout)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash editor)
          (crash trace)
          (crash stack prng)
          (crash tween)
          (crash fx)
          (crash font)
          (crash palette)
          (crash look)
          (crash menu))

  (export draw-session draw-editor draw-frame-ms draw-menu
          draw-meter-in draw-glitch-in draw-severed-in draw-message-in draw-toast-in
          TEST-TILE-W TEST-TILE-H TEST-TILE-FRAMES)

  (begin
    (define (suit-color face)
      (cond ((< face 9) C-SUIT-0)
            ((< face 18) C-SUIT-1)
            ((< face 27) C-SUIT-2)
            (else C-SUIT-3)))

    ;; --- test tile texture layout -------------------------------------------
    ;; assets/test-tile.png is a strip of TEST-TILE-FRAMES frames, each
    ;; TEST-TILE-W x TEST-TILE-H: frame 0 the blank block (side face included
    ;; in the art), frames 1.. the hand-drawn glyph faces for faces 0, 1, 2.

    (define TEST-TILE-W 32)
    (define TEST-TILE-H 44)
    (define TEST-TILE-FRAMES 4)

    ;; --- background -----------------------------------------------------------

    ;; roll: pixels the copper bars have scrolled (the cleared sequence
    ;; rolls them; 0 otherwise).
    (define (draw-background g roll)
      (let ((vw (geometry-vw g))
            (vh (geometry-vh g))
            (shift (modulo (exact (floor roll)) 36)))
        (color! C-BG)
        (draw-filled-rect 0 0 vw vh)
        ;; copper bars: three tones stepping through the board area
        (let loop ((y (- shift 36)) (i 0))
          (when (< y (- vh (geometry-hud-h g)))
            (color! (case (modulo i 3)
                       ((0) C-BAR-A)
                       ((1) C-BAR-B)
                       (else C-BAR-C)))
            (draw-filled-rect 0 y vw 6)
            (loop (+ y 12) (+ i 1))))))

    ;; --- tiles ----------------------------------------------------------------

    (define (glyph-scale g)
      (max 1 (exact (floor (/ (- (geometry-tile-w g) 6) GLYPH-W)))))

    ;; The glyph is drawn only while the (possibly flipping) face is wide
    ;; enough to hold it; a tile edge-on shows no glyph.
    (define (draw-glyph-on g face x y w h dark?)
      (let* ((scale (glyph-scale g))
             (gw (* scale GLYPH-W))
             (gh (* scale GLYPH-H))
             (text (string (string-ref FACE-KEYS face))))
        (when (>= w (+ gw 2))
          (color! (if dark? C-BG (suit-color face)))
          (draw-text text
                     (+ x (exact (floor (/ (- w gw) 2))))
                     (+ y (exact (floor (/ (- h gh) 2))))
                     scale))))

    ;; A tile is drawn in two passes per layer: first its side faces (left and
    ;; bottom, one layer offset deep), then its face. With half-row offsets a
    ;; single draw order cannot be right for both: the Turtle's end tile at
    ;; y=0 straddles the rows at -0.5 and 0.5, and whichever order the sort
    ;; picks, one neighbor's side strip paints over the other's face (David
    ;; saw the dark strip on the tile beside each end tile, 2026-09-16).
    ;; Drawing every side in a layer before any face makes each face cover
    ;; every side strip that overlaps it, which is what a stack looks like.

    (define (draw-sides-primitives g x y w h)
      (let ((side (geometry-side g)))
        ;; the bottom strip runs the full width plus the side so the corner is filled
        (color! C-SIDE-DARK)
        (draw-filled-rect (- x side) (+ y h) (+ w side) side)
        (color! C-SIDE)
        (draw-filled-rect (- x side) y side h)))

    ;; glow: 0..1, how bright the selected face breathes this frame. lock:
    ;; #f, 'strong or 'weak: a locked face is dimmed and barred, red for a
    ;; strong lock, amber for a weak one. right-open?: no tile beside this
    ;; one on its own layer, so its right edge is over a lower layer (or
    ;; nothing) and gets a dark line to read as an edge (David, 2026-09-17:
    ;; a tile's right boundary was hard to see against the tiles under it;
    ;; two faces side by side on one layer stay seamless).
    (define (draw-face-primitives g face x y w h selected? lock right-open? glow)
      ;; the face, with a lighter top-left edge
      (color! (cond (selected? (mix C-SELECTED C-FACE-EDGE (* 0.35 glow)))
                    ((eq? lock 'strong) C-LOCKED)
                    ((eq? lock 'weak) C-LOCK-WEAK)
                    (else C-FACE)))
      (draw-filled-rect x y w h)
      (color! (if selected? C-SELECTED C-FACE-EDGE))
      (draw-filled-rect x y w 1)
      (draw-filled-rect x y 1 h)
      (when right-open?
        (color! (if selected? C-SELECTED C-SIDE))
        (draw-filled-rect (+ x w -1) y 1 h))
      (when face (draw-glyph-on g face x y w h selected?))
      (when lock
        (color! (if (eq? lock 'strong) C-TRACE-HOT C-LABEL-LIT))
        (draw-filled-rect x (+ y 3) w 2)
        (draw-filled-rect x (+ y h -5) w 2)))

    ;; Test-tile mode: the drawn block scaled to the tile, with the drawn
    ;; face for faces 0..2 and the bitmap glyph for the rest, so the two
    ;; directions sit side by side on one board. The strip's frame carries
    ;; the side art in its left and bottom cells (TEST-TILE-SIDE of them), so
    ;; the side pass draws the whole frame and the face pass redraws only the
    ;; face region over it.

    (define TEST-TILE-SIDE 4)

    (define (tile-frame b id)
      (let ((face (tile-face b id)))
        (if (and face (< face (- TEST-TILE-FRAMES 1)))
            (+ face 1)
            0)))

    (define (draw-sides-texture g b id tex x y w h selected?)
      (let ((side (geometry-side g))
            (frame (tile-frame b id)))
        (color! (if selected? C-TEX-SELECTED C-TEX-PLAIN))
        (draw-texture-region tex
                             (- x side) y
                             (+ w side) (+ h side)
                             (* frame TEST-TILE-W) 0
                             TEST-TILE-W TEST-TILE-H)))

    (define (draw-face-texture g b id face tex x y w h selected?)
      (let ((frame (tile-frame b id)))
        (color! (if selected? C-TEX-SELECTED C-TEX-PLAIN))
        (draw-texture-region tex
                             x y
                             w h
                             (+ (* frame TEST-TILE-W) TEST-TILE-SIDE) 0
                             (- TEST-TILE-W TEST-TILE-SIDE)
                             (- TEST-TILE-H TEST-TILE-SIDE))
        (when (and face (= frame 0))
          (draw-glyph-on g face x y w h selected?))))

    ;; A ring around a tile: the cursor highlight in magenta, the priced
    ;; hint in yellow. Drawn after every tile so no neighbor paints over it.
    (define (draw-ring g id color alpha)
      (let* ((r (slot-rect g id))
             (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color-alpha! color alpha)
        (draw-filled-rect (- x 1) (- y 1) (+ w 2) 2)
        (draw-filled-rect (- x 1) (+ y h -1) (+ w 2) 2)
        (draw-filled-rect (- x 1) (- y 1) 2 (+ h 2))
        (draw-filled-rect (+ x w -1) (- y 1) 2 (+ h 2))))

    ;; A tile's rect after the effects: (x y w h) moved by (dx dy) and
    ;; scaled about its centre by (sx sy).
    (define (viewed-rect r view)
      (if (not view)
          r
          (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
                 (dx (car view)) (dy (cadr view))
                 (sx (caddr view)) (sy (cadddr view))
                 (w2 (* w sx))
                 (h2 (* h sy)))
            (list (+ x dx (/ (- w w2) 2.0))
                  (+ y dy (/ (- h h2) 2.0))
                  w2
                  h2))))

    ;; #f, 'strong or 'weak for a tile, at the game's tick.
    (define (lock-state b id now)
      (cond ((not (tile-locked? b id)) #f)
            ((lock-weak? b id now) 'weak)
            (else 'strong)))

    (define (draw-tiles s g tex x)
      (let* ((b (session-board s))
             (lay (board-layout b))
             (selected (board-selected b))
             (now (trace-ticks (session-trace s)))
             (glow (fx-glow x))
             (textured? (and tex (eq? (look-tile (look-ref (session-look s))) 'test-tile)))
             (highlight (and (eq? (session-model s) 'cursor)
                             (session-cursor-shown s)
                             (session-highlight s)
                             (tile-present? b (session-highlight s))
                             (session-highlight s)))
             (each-on-layer
               (lambda (layer proc)
                 (for-each
                   (lambda (id)
                     (when (and (tile-present? b id)
                                (= layer (slot-layer (layout-slot lay id))))
                       (let* ((view (fx-tile-view x id))
                              (r (viewed-rect (slot-rect g id) view))
                              (face (or (and view (list-ref view 4))
                                        (tile-face b id))))
                         (proc id
                               face
                               (car r) (cadr r) (caddr r) (cadddr r)
                               (eqv? selected id)))))
                   (geometry-draw-order g)))))
        (let loop ((layer 0))
          (when (< layer (layout-layer-count lay))
            (each-on-layer layer
                           (lambda (id face x y w h selected?)
                             (if textured?
                                 (draw-sides-texture g b id tex x y w h selected?)
                                 (draw-sides-primitives g x y w h))))
            (each-on-layer layer
                           (lambda (id face x y w h selected?)
                             (if textured?
                                 (draw-face-texture g b id face tex x y w h selected?)
                                 (draw-face-primitives g face x y w h selected?
                                                       (lock-state b id now)
                                                       (not (blocked-right? b id))
                                                       glow))))
            (loop (+ layer 1))))
        (draw-ghosts g x)
        (draw-particles g x)
        (when highlight (draw-ring g highlight C-HIGHLIGHT 1.0))
        (let ((hint (session-hint s))
              (partner (session-hint-partner s))
              (ring-alpha (fx-ring-alpha x)))
          (when (and hint (tile-present? b hint))
            (draw-ring g hint C-LABEL-LIT ring-alpha))
          (when (and partner (tile-present? b partner))
            (draw-ring g partner C-LABEL-LIT ring-alpha)))))

    ;; The match ghosts: a face rising off the table and fading, in the
    ;; primitives style whatever the render mode (the burst is the point).
    (define (draw-ghosts g x)
      (for-each (lambda (ghost)
                  (let ((face (car ghost))
                        (gx (cadr ghost))
                        (gy (caddr ghost))
                        (w (cadddr ghost))
                        (h (list-ref ghost 4))
                        (a (list-ref ghost 5)))
                    (color-alpha! C-SIDE a)
                    (draw-filled-rect (- gx 2) gy (+ w 2) (+ h 2))
                    (color-alpha! C-SELECTED a)
                    (draw-filled-rect gx gy w h)
                    (when face
                      (color-alpha! (suit-color face) a)
                      (let* ((scale (glyph-scale g))
                             (gw (* scale GLYPH-W))
                             (gh (* scale GLYPH-H)))
                        (draw-text (string (string-ref FACE-KEYS face))
                                   (exact (floor (+ gx (/ (- w gw) 2))))
                                   (exact (floor (+ gy (/ (- h gh) 2))))
                                   scale)))))
                (fx-ghosts x)))

    ;; Glyph fragments and rain: small squares in the suit color.
    (define (draw-particles g x)
      (for-each (lambda (pt)
                  (color-alpha! (suit-color (car pt)) (list-ref pt 4))
                  (draw-filled-rect (cadr pt)
                                    (caddr pt)
                                    (cadddr pt)
                                    (cadddr pt)))
                (fx-particles x (geometry-vw g) (geometry-vh g))))

    ;; --- hint labels (model c) -------------------------------------------------
    ;;
    ;; Shown only while the session says so (space toggles them): a small dark
    ;; tag in the 3x5 set, centered on the tile's top edge so the glyph stays
    ;; readable under it; the letters typed so far are drawn lit.

    (define (draw-hint-labels s g)
      (let ((typed (session-typed s)))
        (for-each
          (lambda (entry)
            (let* ((r (slot-rect g (car entry)))
                   (label (cdr entry))
                   (tw (text-width-mini label 1))
                   (w (+ 4 tw))
                   (x (+ (car r) (exact (floor (/ (- (caddr r) w) 2)))))
                   (y (- (cadr r) 3))
                   (prefix? (and (> (string-length typed) 0)
                                 (<= (string-length typed) (string-length label))
                                 (string=? typed
                                           (substring label 0 (string-length typed))))))
              (color! C-BG)
              (draw-filled-rect x y w 7)
              (color! (if prefix? C-HIGHLIGHT C-LABEL-LIT))
              (draw-text-mini label (+ x 2) (+ y 1) 1)))
          (session-labels s))))

    ;; --- HUD ------------------------------------------------------------------
    ;;
    ;; Row 1: the tile counter, the four controls (rects from (crash
    ;; geometry), so a tap lands where the button is drawn), the hint count
    ;; (the trace meter takes this spot in the trace slice) and the seed.
    ;; Row 2: the keys of the model in use.

    (define HINT-KEYS-LINE
      "TAGS: TYPE ONE  SPACE HIDE  ENTER DESELECT  TAB CURSOR  BKSP UNDO  ^S SHUFFLE  ^H HINT  ^N NEXT  ^T TILE")
    (define CURSOR-KEYS-LINE
      "CURSOR: ARROWS MOVE  SPACE PICK  ENTER DESELECT  TAB TAGS  BKSP UNDO  ^S SHUFFLE  ^H HINT  ^N NEXT  ^T TILE")
    ;; Row 2 under the ICE and after the sever, in place of the keys line
    ;; (David, 2026-09-17: make the phase unmistakable, and say that being
    ;; traced does not end the game).
    (define (lock-line b now)
      (let ((locked (board-locked-slots b)))
        (cond ((null? locked) " CRASH THE STACK TO ESCAPE.")
              ((any (lambda (id) (lock-weak? b id now)) locked)
               " A LOCK IS WEAK: TAP IT TO BREAK.")
              (else " A STRONG LOCK HOLDS UNTIL IT WEAKENS."))))

    (define (phase-line tr b)
      (case (trace-phase tr)
        ((counter)
         (string-append "TRACED. ICE INBOUND. ICE IN " (trace-ice-string tr)
                        ". LINK SEVERS IN " (trace-countdown-string tr) "."
                        (lock-line b (trace-ticks tr))))
        ((severed)
         "LINK SEVERED. TAP: RETRY LINK / NEW STACK / JACK OUT (^R ^N).")
        (else #f)))

    (define (control-label name)
      (case name
        ((undo) "UNDO")
        ((shuf) "SHUF")
        ((hint) "HINT")
        ((next) "NEXT")
        ((menu) "MENU")
        (else "?")))

    (define (draw-controls g)
      (for-each (lambda (c)
                  (let* ((name (car c))
                         (x (cadr c)) (y (caddr c))
                         (w (cadddr c)) (h (list-ref c 4))
                         (label (control-label name))
                         (tw (text-width label 2)))
                    (color! C-BAR-C)
                    (draw-filled-rect x y w h)
                    (color! C-TEXT-DIM)
                    (draw-filled-rect x y w 1)
                    (draw-filled-rect x (+ y h -1) w 1)
                    (draw-filled-rect x y 1 h)
                    (draw-filled-rect (+ x w -1) y 1 h)
                    (color! C-TEXT)
                    (draw-text label
                               (+ x (exact (floor (/ (- w tw) 2))))
                               (+ y 3)
                               2)))
                (filter (lambda (c) (not (memq (car c) '(mode look))))
                        (geometry-controls g))))

    ;; The meter, in the rect (crash geometry) reserves for it. TRACE: a bar
    ;; filling toward the trace, going hot as it nears, with GNOME's number;
    ;; COUNTER-HACK: the bar counts down to the sever, hot; SEVERED: empty;
    ;; CLEARED: the score. Clean: GNOME's clock. Tapping it flips the face
    ;; while the game is still in TRACE ((crash input)).
    (define (draw-meter g tr)
      (draw-meter-in (control-rect g 'mode) tr))

    ;; The meter in any rect (the card table has its own HUD, P2).
    (define (draw-meter-in r tr)
      (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
             (phase (trace-phase tr))
             (clean? (eq? (trace-mode tr) 'clean)))
        (color! C-BG)
        (draw-filled-rect x y w h)
        (if (and clean? (not (eq? phase 'cleared)))
            (let ((text (string-append "TIME " (trace-clock-string tr))))
              (color! C-TEXT)
              (draw-text text (+ x 4) (+ y 3) 2))
            (let* ((frac (trace-fraction tr))
                   (fill (exact (floor (* (- w 2) frac))))
                   (text (case phase
                           ((trace) (string-append "TRACE "
                                                   (number->string (exact (floor (trace-value tr))))))
                           ((counter) (string-append "LINK " (trace-countdown-string tr)))
                           ((severed) "SEVERED")
                           (else (string-append "CRASHED " (trace-clock-string tr)))))
                   (bar (case phase
                          ((trace) (mix C-TRACE C-TRACE-HOT frac))
                          ((counter) C-TRACE-HOT)
                          (else C-TRACE))))
              (color! C-TEXT-DIM)
              (draw-filled-rect x y w 1)
              (draw-filled-rect x (+ y h -1) w 1)
              (draw-filled-rect x y 1 h)
              (draw-filled-rect (+ x w -1) y 1 h)
              (color! bar)
              (draw-filled-rect (+ x 1) (+ y 1) fill (- h 2))
              (color! (if (eq? phase 'severed) C-HIGHLIGHT C-TEXT))
              (draw-text text (+ x 4) (+ y 3) 2)))))

    ;; A box with a label, the shape of every control.
    (define (draw-box r label fill edge ink)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color! fill)
        (draw-filled-rect x y w h)
        (color! edge)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)
        (color! ink)
        (draw-text label
                   (+ x (exact (floor (/ (- w (text-width label 2)) 2))))
                   (+ y (exact (floor (/ (- h 14) 2))))
                   2)))

    ;; The web build's waiting update (ruling D14): the mark in the HUD
    ;; while a version waits, the prompt's two boxes above the HUD.
    (define (draw-update-mark g)
      (draw-box (cdr (assq 'update (update-controls g))) "UPDATE" C-BAR-C C-SELECTED C-SELECTED))

    (define (draw-update-prompt g)
      (let* ((vw (geometry-vw g))
             (top (- (geometry-vh g) (geometry-hud-h g)))
             (title "NEW VERSION READY")
             (tw (text-width title 2)))
        (color-alpha! C-BG 0.9)
        (draw-filled-rect (- (half vw) 150) (- top 74) 300 62)
        (color! C-SELECTED)
        (draw-text title (- (half vw) (half tw)) (- top 68) 2)
        (draw-box (cdr (assq 'apply (update-controls g))) "APPLY" C-BAR-C C-SELECTED C-TEXT)
        (draw-box (cdr (assq 'later (update-controls g))) "NOT NOW" C-BAR-C C-TEXT-DIM C-TEXT)))

    ;; The centred message box. rise: 0..1 slides it in from below and fades
    ;; it up (the cleared sequence); fade: 0..1 slides it up and fades it
    ;; out (a toast leaving). A state message passes 1 and 0.
    (define (draw-message g message top rise fade)
      (draw-message-in (geometry-vw g) message top rise fade))

    (define (draw-message-in vw message top rise fade)
      (let* ((w (text-width message 3))
             (x (exact (floor (/ (- vw w) 2))))
             (k (ease 'out-back rise))
             (y (exact (floor (- (+ (/ top 2) (* 40 (- 1.0 k)))
                                 (* 50 (ease 'in-out-quad fade))))))
             (a (* rise (- 1.0 fade))))
        (color-alpha! C-BG a)
        (draw-filled-rect (- x 8) (- y 16) (+ w 16) 36)
        (color-alpha! C-SELECTED a)
        (draw-text message x (- y 10) 3)))

    ;; A toast: slides in from the right edge to sit just above the HUD,
    ;; holds, then slides out to the right (David, 2026-09-17: not over the
    ;; tiles; the terminal states keep the middle of the screen). The slide
    ;; in takes the first TOAST-SLIDE of its life, the slide out the last.
    (define TOAST-SLIDE 0.12)

    (define (draw-toast g text top p)
      (draw-toast-in (geometry-vw g) text top p))

    ;; The same toast on any table (the card table's, P2).
    (define (draw-toast-in vw text top p)
      (let* ((w (+ 16 (text-width text 2)))
             (h 24)
             (slide (cond ((< p TOAST-SLIDE) (- 1.0 (ease 'out-quad (/ p TOAST-SLIDE))))
                          ((> p (- 1.0 TOAST-SLIDE))
                           (ease 'in-out-quad (/ (- p (- 1.0 TOAST-SLIDE)) TOAST-SLIDE)))
                          (else 0.0)))
             (x (exact (floor (+ (- vw w 8) (* slide (+ w 8))))))
             (y (- top 14))
             ;; a short flash as it lands
             (flash (if (and (>= p TOAST-SLIDE) (< p (* 2.5 TOAST-SLIDE)))
                        (if (even? (exact (floor (* p 60)))) 1.0 0.0)
                        0.0)))
        (color! (mix C-BG C-SELECTED (* 0.5 flash)))
        (draw-filled-rect x y w h)
        (color! C-SELECTED)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)
        (color! (mix C-SELECTED C-TEXT flash))
        (draw-text text (+ x 8) (+ y 5) 2)))

    (define (draw-hud s g x)
      (let* ((b (session-board s))
             (vw (geometry-vw g))
             (vh (geometry-vh g))
             (top (- vh (geometry-hud-h g)))
             (left (string-append "TILES " (number->string (board-tile-count b))))
             ;; the look's name after the count: the counter is the tap
             ;; target that steps it (P3, the sheet switch)
             (look-label (look-label (look-ref (session-look s))))
             (right (string-append "SEED " (number->string (session-seed s))))
             (cleared (fx-cleared x)))
        (color! C-BG)
        (draw-filled-rect 0 top vw (geometry-hud-h g))
        (color! C-TEXT-DIM)
        (draw-filled-rect 0 top vw 1)
        (color! C-TEXT)
        (draw-text left 8 (+ top 7) 2)
        (color! C-TEXT-DIM)
        (draw-text look-label (+ 8 (text-width left 2) 6) (+ top 12) 1)
        (if (memq (session-update s) '(waiting prompt))
            (draw-update-mark g)
            (draw-text right (- vw 8 (text-width right 2)) (+ top 7) 2))
        (draw-controls g)
        (draw-meter g (session-trace s))
        ;; row 2, centered (David, 2026-09-17)
        (let* ((line (phase-line (session-trace s) b))
               (text (or line
                         (if (eq? (session-model s) 'hint) HINT-KEYS-LINE CURSOR-KEYS-LINE)))
               (x (max 8 (exact (floor (/ (- vw (text-width text 1)) 2))))))
          (color! (if line C-HIGHLIGHT C-TEXT-DIM))
          (draw-text text x (+ top 32) 1))
        (when (> (string-length (session-typed s)) 0)
          (color! C-HIGHLIGHT)
          (draw-text (string-append "> " (session-typed s))
                     (- vw 8 (text-width right 2) 24 (text-width (string-append "> " (session-typed s)) 2))
                     (+ top 7)
                     2))
        ;; state messages sit; everything else is a toast from (crash fx)
        (let* ((tr (session-trace s))
               (state (cond ((board-cleared? b)
                             (string-append "STACK CRASHED " (trace-clock-string tr)
                                            (cond ((eq? (trace-mode tr) 'clean) "")
                                                  ((eq? (trace-cleared-in tr) 'counter)
                                                   (string-append " " TAG-UNDER-ICE))
                                                  (else (string-append " " TAG-CLEAN-RUN)))))
                            ((trace-severed? tr) "")
                            ((null? (legal-matches b)) "NO MOVES LEFT - SHUFFLE")
                            ((session-hint-armed s) "HINT: PRESS A FACE KEY")
                            (else "")))
               (toast (fx-toast x)))
          (cond ((not (string=? state ""))
                 (draw-message g state top (if (and (board-cleared? b) cleared)
                                               (min 1.0 (* cleared 5.0))
                                               1.0)
                               0.0))
                ((and toast (not (trace-severed? tr)))
                 (draw-toast g (car toast) top (cdr toast)))))))

    ;; --- the trace's screens -------------------------------------------------

    ;; The glitch when the trace completes: horizontal slices of the board in
    ;; the hot colours, thinning out as it passes, from the board's own
    ;; random stream seeded by the tick so it flickers.
    (define (draw-glitch g x p)
      (draw-glitch-in (geometry-vw g) (- (geometry-vh g) (geometry-hud-h g)) (fx-ticks x) p))

    ;; ticks: the frame's sim tick, seeding the flicker.
    (define (draw-glitch-in vw top ticks p)
      (let* ((n (exact (floor (* 24 (- 1.0 p)))))
             (a (* 0.7 (- 1.0 p))))
        (let loop ((k 0) (rng (prng-seed (+ 13 ticks))))
          (when (< k n)
            (let* ((r1 (prng-next rng))
                   (r2 (prng-next r1))
                   (r3 (prng-next r2))
                   (y (prng-index r1 top))
                   (h (+ 2 (prng-index r2 6)))
                   (dx (- (prng-index r3 40) 20)))
              (color-alpha! (if (even? k) C-TRACE-HOT C-SELECTED) a)
              (draw-filled-rect dx y vw h)
              (loop (+ k 1) r3))))))

    ;; The severed connection: static over the board and the two choices.
    (define (draw-severed g x)
      (draw-severed-in (geometry-vw g)
                       (- (geometry-vh g) (geometry-hud-h g))
                       (fx-ticks x)
                       '("RETRY LINK" "NEW STACK" "JACK OUT")))

    ;; labels: the three choices, left to right, each a third of the board.
    (define (draw-severed-in vw top ticks labels)
      (begin
        (color-alpha! C-BG 0.75)
        (draw-filled-rect 0 0 vw top)
        (let loop ((k 0) (rng (prng-seed (+ 17 ticks))))
          (when (< k 160)
            (let* ((r1 (prng-next rng))
                   (r2 (prng-next r1))
                   (r3 (prng-next r2)))
              (color-alpha! C-TEXT-DIM (+ 0.15 (* 0.5 (/ (prng-index r3 100) 100.0))))
              (draw-filled-rect (prng-index r1 vw) (prng-index r2 top) 3 2)
              (loop (+ k 1) r3))))
        (let* ((title "LINK SEVERED")
               (tw (text-width title 3)))
          (color! C-TRACE-HOT)
          (draw-text title (exact (floor (/ (- vw tw) 2))) (- (half top) 40) 3))
        (for-each (lambda (choice)
                    (let* ((label (car choice))
                           (cx (cdr choice))
                           (w 180)
                           (h 40)
                           (bx (- cx (half w)))
                           (by (+ (half top) 10)))
                      (color! C-BAR-C)
                      (draw-filled-rect bx by w h)
                      (color! C-SELECTED)
                      (draw-filled-rect bx by w 1)
                      (draw-filled-rect bx (+ by h -1) w 1)
                      (draw-filled-rect bx by 1 h)
                      (draw-filled-rect (+ bx w -1) by 1 h)
                      (color! C-TEXT)
                      (draw-text label
                                 (- cx (half (text-width label 2)))
                                 (+ by 13)
                                 2)))
                  (let ((third (quotient vw 3)))
                    (list (cons (car labels) (half third))
                          (cons (cadr labels) (+ third (half third)))
                          (cons (caddr labels) (+ (* 2 third) (half third))))))))

    ;; --- the menu -------------------------------------------------------------

    ;; The first screen (P2, ruling D14's placeholder): the title, the
    ;; entries from (crash menu) in their rects, the highlighted one lit.
    ;; version: a short string for the corner, or #f.
    (define (draw-menu m vw vh version)
      (color! C-BG)
      (draw-filled-rect 0 0 vw vh)
      (let loop ((y -36) (i 0))
        (when (< y vh)
          (color! (case (modulo i 3)
                     ((0) C-BAR-A)
                     ((1) C-BAR-B)
                     (else C-BAR-C)))
          (draw-filled-rect 0 y vw 6)
          (loop (+ y 12) (+ i 1))))
      (let ((tw (text-width MENU-TITLE 4)))
        (color! C-SELECTED)
        (draw-text MENU-TITLE (exact (floor (/ (- vw tw) 2))) 60 4))
      (let loop ((ids (menu-entries m)) (i 0))
        (unless (null? ids)
          (let* ((r (menu-entry-rect i vw vh))
                 (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
                 (label (if (eq? (car ids) 'look)
                            (string-append "LOOK: " (look-label (look-ref (menu-look m))))
                            (menu-label (car ids))))
                 (lit? (= i (menu-highlight m)))
                 (tw (text-width label 3)))
            (color! (if lit? C-BAR-C C-BG))
            (draw-filled-rect x y w h)
            (color! (if lit? C-SELECTED C-TEXT-DIM))
            (draw-filled-rect x y w 1)
            (draw-filled-rect x (+ y h -1) w 1)
            (draw-filled-rect x y 1 h)
            (draw-filled-rect (+ x w -1) y 1 h)
            (color! (if lit? C-SELECTED C-TEXT))
            (draw-text label (+ x (exact (floor (/ (- w tw) 2)))) (+ y 5) 3)
            (when lit?
              (draw-text ">" (- x 20) (+ y 5) 3)))
          (loop (cdr ids) (+ i 1))))
      (color! C-TEXT-DIM)
      (draw-text "ARROWS OR TAP. ENTER PICKS." 8 (- vh 14) 1)
      (when version
        (draw-text version (- vw 8 (text-width version 1)) (- vh 14) 1)))

    ;; Frame-time readout for --log-keys: last frame in ms, top-right.
    (define (draw-frame-ms ms)
      (let ((text (string-append "MS " (number->string (exact (round ms))))))
        (color! C-LABEL-LIT)
        (draw-text text (- 640 8 (text-width text 2)) 6 2)))

    ;; --- one frame ------------------------------------------------------------

    ;; --- the editor -----------------------------------------------------------
    ;;
    ;; Blank faces on the canvas geometry, the layers above the cursor's
    ;; drawn per the editor's dim mode, the cursor as a ring (selected color
    ;; where a tile can go, highlight where it cannot), and a status line.

    (define (draw-editor e g)
      (let* ((c (editor-cursor e))
             (cl (car c))
             (dim (editor-dim e))
             (vw (geometry-vw g))
             (vh (geometry-vh g))
             (top (- vh (geometry-hud-h g)))
             (alpha-for (lambda (layer)
                          (cond ((<= layer cl) 1.0)
                                ((eq? dim 'full) 1.0)
                                ((eq? dim 'dim) 0.35)
                                (else 0.0)))))
        (draw-background g 0.0)
        (let loop ((layer 0))
          (when (< layer CANVAS-LAYERS)
            (let ((a (alpha-for layer))
                  (on-layer (filter (lambda (p) (= (car p) layer)) (editor-slots e))))
              (when (> a 0.0)
                (for-each (lambda (p)
                            (let* ((r (cell-rect g layer (cadr p) (caddr p)))
                                   (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
                                   (side (geometry-side g)))
                              (color-alpha! C-SIDE-DARK a)
                              (draw-filled-rect (- x side) (+ y h) (+ w side) side)
                              (color-alpha! C-SIDE a)
                              (draw-filled-rect (- x side) y side h)))
                          on-layer)
                (for-each (lambda (p)
                            (let* ((r (cell-rect g layer (cadr p) (caddr p)))
                                   (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
                              (color-alpha! (if (= layer cl) C-FACE (mix C-FACE C-BAR-C 0.25)) a)
                              (draw-filled-rect x y w h)
                              (color-alpha! C-FACE-EDGE a)
                              (draw-filled-rect x y w 1)
                              (draw-filled-rect x y 1 h)))
                          on-layer)))
            (loop (+ layer 1))))
        ;; the cursor
        (let* ((r (cell-rect g cl (cadr c) (caddr c)))
               (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
               (here? (and (member c (editor-slots e)) #t))
               (ok? (or here? (placeable? e c))))
          (color! (if ok? C-SELECTED C-HIGHLIGHT))
          (draw-filled-rect (- x 1) (- y 1) (+ w 2) 2)
          (draw-filled-rect (- x 1) (+ y h -1) (+ w 2) 2)
          (draw-filled-rect (- x 1) (- y 1) 2 (+ h 2))
          (draw-filled-rect (+ x w -1) (- y 1) 2 (+ h 2)))
        ;; the HUD
        (color! C-BG)
        (draw-filled-rect 0 top vw (geometry-hud-h g))
        (color! C-TEXT-DIM)
        (draw-filled-rect 0 top vw 1)
        (color! C-TEXT)
        (draw-text (string-append "EDIT  TILES " (number->string (editor-count e))
                                  "  LAYER " (number->string cl)
                                  "  AT " (number->string (cadr c)) "," (number->string (caddr c))
                                  "  ABOVE " (case dim ((full) "FULL") ((dim) "DIM") (else "HIDDEN"))
                                  "  TRACE " (number->string (editor-trace-at e))
                                  "  ICE " (number->string (editor-sever-at e)))
                   8 (+ top 7) 2)
        (color! C-TEXT-DIM)
        (draw-text "ARROWS/HJKL MOVE  SHIFT HALF  U/D LAYER  SPACE PLACE/REMOVE  TAB DIM  1/2 TRACE  3/4 ICE  ^S SAVE  ^P PLAY  ESC QUIT"
                   8 (+ top 32) 1)
        (unless (string=? (editor-message e) "")
          (draw-message g (editor-message e) top 1.0 0.0))))

    ;; x: the frame's effects from (crash fx), already advanced.
    (define (draw-session s g tex x)
      (let ((cleared (fx-cleared x))
            (glitch (fx-glitch x)))
        (draw-background g (if cleared (* cleared 400.0) 0.0))
        (draw-tiles s g tex x)
        (when (and (eq? (session-model s) 'hint) (session-labels-shown s))
          (draw-hint-labels s g))
        (when glitch (draw-glitch g x glitch))
        (when (trace-severed? (session-trace s)) (draw-severed g x))
        (draw-hud s g x)
        (when (eq? (session-update s) 'prompt) (draw-update-prompt g))))))
