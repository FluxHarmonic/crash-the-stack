;;; (crash render) - Drawing the table.
;;;
;;; Takes a session, a geometry and the frame's effects from (crash fx),
;;; and draws one frame with sigil-graphics primitives: the living
;;; background, each tile as a charcoal face over a darker side face
;;; offset per layer (moved, scaled or flipped as the effects say), the
;;; glyph in its suit color from sheet A through the atlas, the selection
;;; and the keyboard highlight, the match ghosts and particles, the hint
;;; tags, and the HUD with its three buttons. Nothing here reads input, a
;;; platform or a clock; the effects arrive already advanced.
;;;
;;; Palette: the colors come from (crash palette), at most 32, so David
;;; can retune the look in one place (design decision 7).

(define-library (crash render)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (sigil graphics)
          (crash stack layout)
          (crash stack rules)
          (crash geometry)
          (crash input)
          (crash editor)
          (crash trace)
          (crash stack prng)
          (crash tween)
          (crash fx)
          (crash font)
          (crash palette)
          (crash look)
          (crash depth)
          (crash glyphs)
          (crash bg)
          (crash gpu bg)
          (crash gpu copper)
          (crash atlas)
          (crash menu)
          (crash title draw)
          (crash hud)
          (crash glyphs tools))

  (export frame-begin!
          draw-session draw-editor draw-frame-ms draw-diag-lines draw-phosphor-probe draw-menu
          draw-bg-in draw-background draw-board-background
          draw-meter-in draw-glitch-in draw-severed-in draw-message-in draw-toast-in
          draw-tool-button draw-menu-button draw-tool-stack draw-bar-frame draw-readout draw-line-2
          draw-keys-button draw-prompt draw-beside-meter phase-color tiles-ensure!
          depth-set! depth-in-force text-cache cached-text)

  (begin
    ;; Every frame starts here: sokol_gp's begin resets its state, and its
    ;; default blend mode is none, under which color-alpha! paints opaque.
    ;; Found 2026-09-19 building the tool stack's dim: every fade the
    ;; game had drawn so far (ghosts, rings, toasts, the glitch's bands,
    ;; the severed overlay) had been a pop. Normal blending from the
    ;; frame's first draw, both shells.
    (define (frame-begin!)
      (begin-frame)
      (set-blend-mode 'normal))

    ;; The bible's section 3: four suits of eight (MEM, PWR, TX, DSK) and
    ;; the four daemons in white (ruling D32). On the charcoal face the
    ;; PWR red is the palette's hot red, C-TRACE-HOT (David, 2026-09-18:
    ;; C-SUIT-1's tone "doesn't feel right on charcoal"; keep it hot).
    ;; A cond on the suit, not a case: every case clause the native codegen
    ;; tests allocates its datum list (96 bytes a tile a frame, 2026-09-20).
    (define (suit-color face)
      (let ((suit (face-suit face)))
        (cond ((eqv? suit 0) C-SUIT-0)
              ((eqv? suit 1) C-TRACE-HOT)
              ((eqv? suit 2) C-SUIT-2)
              ((eqv? suit 3) C-SUIT-3)
              (else C-DAEMON))))

    ;; The tile face: charcoal (ruling D32), and its rim the mid gray of
    ;; the side, not the white edge ("the tile-dividing lines may be a
    ;; bit too white").
    (define FACE-COLOR C-STATIC-B)
    (define FACE-EDGE-COLOR C-SIDE)

    ;; --- background -----------------------------------------------------------

    ;; roll: pixels the copper bars have scrolled (the cleared sequence
    ;; rolls them; 0 otherwise). bg: the living background ((crash bg)) or
    ;; #f. copper: when the raster draws over the field: 'roll (during the
    ;; cleared sequence only, the default), 'always (David's comparison
    ;; switch, ?copper=always), 'off (never over the field), 'bitmap (the
    ;; painted bars, the reference the scanline leg reads the raster
    ;; against; goes once the raster is proven). With no field the bars
    ;; are the background, as they were before P3.
    (define (draw-background g roll bg copper)
      (draw-board-background (geometry-vw g)
                             (geometry-vh g)
                             (- (geometry-vh g) (geometry-hud-h g))
                             roll
                             bg
                             copper))

    ;; The same on any table's numbers: the viewport vw x vh, the board
    ;; area's bottom at top (the card table calls this with its own
    ;; geometry).
    (define (draw-board-background vw vh top roll bg copper)
      (let* ((roll (if (number? copper) copper roll))   ; ?raster=N: a fixed roll, the raster always
             (rolling? (> roll 0)))
        (color! C-BG)
        (draw-filled-rect 0 0 vw vh)
        (when bg
          (draw-bg-in bg top))
        (when (or (not bg)
                  (eq? copper 'always)
                  (number? copper)
                  (and rolling? (or (eq? copper 'roll) (eq? copper 'bitmap))))
          (draw-copper vw top roll copper))))

    ;; The copper bars over the board area: the raster ((crash gpu copper):
    ;; split from the middle and the colors sweeping while the roll runs),
    ;; or the painted bars: three tones stepping through the area, 6 px
    ;; every 12, rolled down by `roll`.
    (define (draw-copper vw top roll copper)
      (if (eq? copper 'bitmap)
          (let ((shift (modulo (exact (floor roll)) 36)))
            (let loop ((y (- shift 36)) (i 0))
              (when (< y top)
                (color! (case (modulo i 3)
                          ((0) C-BAR-A)
                          ((1) C-BAR-B)
                          (else C-BAR-C)))
                (draw-filled-rect 0 y vw 6)
                (loop (+ y 12) (+ i 1)))))
          (copper-draw! 0 0 vw top roll (> roll 0) (copper-phase roll))))

    ;; The sweep: the bar colors rotate one place every period of the roll.
    (define (copper-phase roll)
      (modulo (quotient (exact (floor roll)) PERIOD) 3))

    ;; The living background's field over the board area (the same field
    ;; on the card table). On the GPU (the default, P3c) the field is
    ;; presented from its render target through the view shader that
    ;; dithers and maps the tones; on the CPU (the fallback, ?bg=life-cpu)
    ;; one rectangle per run of half cells on a row, each in its ramp
    ;; tone. The ramp is a ring of RAMP dark tones from three hue families
    ;; of the palette (David, 2026-09-18: colorful, low saturation, so the
    ;; tiles pop): ground, the two purples, the violet seal, the moss
    ;; accent David asked for (2026-09-19), the teal wire, the slate
    ;; static, the middle purple; the list is (crash gpu bg)'s RAMP-COLORS,
    ;; the same eight the view shader's palette uniform holds.
    (define (ramp-color tone)
      (list-ref RAMP-COLORS tone))

    ;; The runs come grouped by tone, so the color is set once per group.
    (define (draw-bg-in bg top)
      (if (bg-gpu? bg)
          (gpu-bg-blit! bg 0 0 (* CELL GRID-W) (* CELL GRID-H))
          (let loop ((runs (bg-runs bg)) (tone -1))
            (unless (null? runs)
              (let ((run (car runs)))
                (unless (= (car run) tone) (color! (ramp-color (car run))))
                (when (< (caddr run) top)
                  (draw-filled-rect (cadr run)
                                    (caddr run)
                                    (cadddr run)
                                    (min (list-ref run 4) (- top (caddr run)))))
                (loop (cdr runs) (car run)))))))

    ;; --- tiles ----------------------------------------------------------------

    (define (glyph-scale g)
      (max 1 (exact (floor (/ (- (geometry-tile-w g) 6) GLYPH-W)))))

    ;; A face's glyph with its top-left at (x, y): the look's sheet (P3), or
    ;; the face-key letter when the look says keys (or names a sheet that
    ;; is not in the tree). In the current color.
    ;; Text and glyphs through (crash atlas) (one texture region each,
    ;; P3c), or (crash font)'s rects with ?atlas=off, the oracle the arm
    ;; holds the atlas pixel-identical to. The menu's text stays on the
    ;; rect path (P3d owns draw-menu).
    (define (text! text x y scale)
      (if (atlas-on?) (atlas-text text x y scale) (draw-text text x y scale)))

    (define (text-mini! text x y scale)
      (if (atlas-on?) (atlas-text-mini text x y scale) (draw-text-mini text x y scale)))

    (define (draw-face-glyph sheet face x y scale)
      (unless (and (atlas-on?) (not (eq? sheet 'keys)) (atlas-face sheet face x y scale))
        (let ((rows (and (not (eq? sheet 'keys)) (sheet-glyph sheet face))))
          (if rows
              (draw-rows rows x y scale GLYPH-W)
              (text! (string (string-ref FACE-KEYS face)) x y scale)))))

    ;; A scrambled face (the ICE's third counter-hack, P3): the glyph's
    ;; rows shear sideways by a cell or two, a different way every few
    ;; ticks from the board's own stream, and one row drops out, so the
    ;; face is readable with effort; a C-ICE hairline says whose work it is.
    (define SCRAMBLE-PERIOD 4)

    (define (draw-face-glyph-scrambled sheet face x y scale ticks id)
      (let ((rows (or (and (not (eq? sheet 'keys)) (sheet-glyph sheet face))
                      (glyph-rows-of (string-ref FACE-KEYS face)))))
        (when rows
          (draw-rows-sheared rows x y scale GLYPH-W
                             (+ 31 (* 7 id) (* 101 (quotient ticks SCRAMBLE-PERIOD)))))))

    ;; The glyph is drawn only while the (possibly flipping) face is wide
    ;; enough to hold it; a tile edge-on shows no glyph. scramble: #f, or
    ;; (ticks . id) for a scrambled face.
    (define (draw-glyph-on g look face x y w h dark? scramble)
      (let* ((scale (glyph-scale g))
             (gw (* scale GLYPH-W))
             (gh (* scale GLYPH-H))
             (gx (+ x (exact (floor (/ (- w gw) 2)))))
             (gy (+ y (exact (floor (/ (- h gh) 2))))))
        (when (>= w (+ gw 2))
          (color! (if dark? C-BG (suit-color face)))
          (if scramble
              (begin
                (draw-face-glyph-scrambled (look-glyphs look) face gx gy scale (car scramble) (cdr scramble))
                (color! C-ICE)
                (draw-filled-rect x (+ gy (* scale 3)) w 1))
              (draw-face-glyph (look-glyphs look) face gx gy scale)))))

    ;; A tile is drawn in two passes per layer: first its side faces (left and
    ;; bottom, one layer offset deep), then its face. With half-row offsets a
    ;; single draw order cannot be right for both: the Turtle's end tile at
    ;; y=0 straddles the rows at -0.5 and 0.5, and whichever order the sort
    ;; picks, one neighbor's side strip paints over the other's face (David
    ;; saw the dark strip on the tile beside each end tile, 2026-09-16).
    ;; Drawing every side in a layer before any face makes each face cover
    ;; every side strip that overlaps it, which is what a stack looks like.

    ;; --- the tile bodies, baked (P3c) ------------------------------------------
    ;;
    ;; A primitives-look tile body is four rectangles (the face, two edge
    ;; lines, the open right edge) and its sides two more; 144 tiles a
    ;; frame made them the largest rectangle count left after the glyph
    ;; atlas. Every variant a frame can need is baked once into one small
    ;; 'nearest render target at the geometry's tile size: three body
    ;; states (plain, strong lock, weak lock) by right-open (no, yes), and
    ;; the side piece (the left and bottom strips, alpha 0 elsewhere, drawn
    ;; with normal blending so the transparent part leaves the tiles under
    ;; it alone). A tile is then one draw-texture-region for its sides and
    ;; one for its body; the selected tile keeps the rectangles, its face
    ;; color breathes with the glow. Keyed by (tile-w tile-h side layers):
    ;; a layout or depth change re-bakes. tiles-ensure! runs from the shells'
    ;; present! before any other pass (a bake inside the phosphor's pass
    ;; would be a pass inside a pass); a draw with nothing baked falls back
    ;; to the rectangles. The atlas leg holds the two paths identical.
    ;;
    ;; The depth cues (ruling D48, (crash depth)) add cells, on a SECOND
    ;; sheet: the bodies once per shade step (one per layer, B) and per
    ;; edge (on, off), the side pieces one per deeper drawn depth (offset
    ;; + 1 .. offset + 3, A), and one dithered shadow patch (C). The first
    ;; sheet stays exactly the sheet before D48 (the six plain bodies and
    ;; the offset-deep side piece, (7w + side) x (h + side)), so the plain
    ;; look's draw reads the same texels through the same coordinates: a
    ;; taller sheet moved the nearest-sampled rows at the phone's
    ;; fractional scale and the atlas leg's row hashes went red
    ;; (2026-09-20, 40 of 488 rows). Both sheets are baked once per
    ;; geometry; the draw picks.
    (define *tiles-rt* #f)
    (define *tiles-tex* #f)
    (define *tiles-key* #f)
    (define *tiles-h* 0)
    (define *depth-rt* #f)
    (define *depth-tex* #f)
    (define *depth-h* 0)
    (define *tiles-layers* 1)            ; shade steps baked on the depth sheet
    (define *sides-x* 0)                 ; the first deeper side piece's x on the depth sheet
    (define *shadow-x* 0)                ; the shadow patch's x on the depth sheet
    (define TILE-VARIANTS 6)             ; (plain strong weak) x (closed open)

    ;; The depth in force: the shells set it from the store or a door.
    (define *depth* (depth-ref DEFAULT-DEPTH))
    (define (depth-set! name) (set! *depth* (depth-ref name)))
    (define (depth-in-force) (depth-name *depth*))
    ;; The layer the tile walk is on (the passes read it: no per-tile argument).
    (define *layer* 0)

    (define (tile-variant lock right-open?)
      (+ (cond ((eq? lock 'strong) 1) ((eq? lock 'weak) 2) (else 0))
         (if right-open? 3 0)))

    ;; The body cell's index on the depth sheet: variant within (shade, edge).
    (define (body-cell shade edge? lock right-open?)
      (+ (* (+ (* shade 2) (if edge? 0 1)) TILE-VARIANTS)
         (tile-variant lock right-open?)))

    (define (tiles-ensure! g)
      (let* ((w (geometry-tile-w g))
             (h (geometry-tile-h g))
             (side (geometry-side g))
             (layers (layout-layer-count (geometry-layout g)))
             (key (list w h side layers)))
        (unless (equal? key *tiles-key*)
          (when *tiles-rt* (render-target-free! *tiles-rt*))
          (when *depth-rt* (render-target-free! *depth-rt*))
          ;; the plain sheet, as it was before D48
          (let ((rt (make-render-target (+ (* TILE-VARIANTS w) w side) (+ h side) 'nearest)))
            (with-render-target rt
              (set-blend-mode 'none)
              (let variants ((v 0))
                (when (< v TILE-VARIANTS)
                  (draw-face-rects (* v w) 0 w h #f
                                   (case (modulo v 3) ((1) 'strong) ((2) 'weak) (else #f))
                                   (>= v 3)
                                   0.0
                                   0
                                   #t)
                  (variants (+ v 1))))
              (draw-sides-rects (+ (* TILE-VARIANTS w) side) 0 w h side))
            (set-blend-mode 'normal)
            (set! *tiles-rt* rt)
            (set! *tiles-tex* (render-target->texture rt))
            (set! *tiles-h* (+ h side)))
          ;; the depth sheet
          (let* ((bodies (* layers 2 TILE-VARIANTS))
                 (sides-x (* bodies w))
                 (sides-w (let loop ((d 1) (acc 0))
                            (if (> d MAX-SIDE-GROWTH) acc (loop (+ d 1) (+ acc w side d)))))
                 (shadow-x (+ sides-x sides-w))
                 (cell-h (+ h (max (+ side MAX-SIDE-GROWTH) MAX-SHADOW)))
                 (rt (make-render-target (+ shadow-x w MAX-SHADOW) cell-h 'nearest)))
            (with-render-target rt
              (set-blend-mode 'none)
              ;; the bodies: for each shade step and edge, the six variants
              (let shades ((shade 0))
                (when (< shade layers)
                  (let edges ((e 0))
                    (when (< e 2)
                      (let variants ((v 0))
                        (when (< v TILE-VARIANTS)
                          (let ((lock (case (modulo v 3) ((1) 'strong) ((2) 'weak) (else #f)))
                                (open? (>= v 3)))
                            (draw-face-rects (* (body-cell shade (= e 0) lock open?) w) 0 w h #f
                                             lock open? 0.0 shade (= e 0)))
                          (variants (+ v 1))))
                      (edges (+ e 1))))
                  (shades (+ shade 1))))
              ;; the deeper side pieces, one per drawn depth past the offset
              (let pieces ((d 1) (x sides-x))
                (when (<= d MAX-SIDE-GROWTH)
                  (draw-sides-rects (+ x side d) 0 w h (+ side d))
                  (pieces (+ d 1) (+ x w side d))))
              ;; the shadow patch: Bayer 4x4 at half, C-BAR-A, nothing between
              (draw-shadow-patch shadow-x 0 (+ w MAX-SHADOW) (+ h MAX-SHADOW)))
            (set-blend-mode 'normal)
            (set! *depth-rt* rt)
            (set! *depth-tex* (render-target->texture rt))
            (set! *depth-h* cell-h)
            (set! *tiles-layers* layers)
            (set! *sides-x* sides-x)
            (set! *shadow-x* shadow-x))
          (set! *tiles-key* key))))

    ;; The x of the side piece for a drawn depth past the offset on the
    ;; depth sheet (the pieces widen by one px each: offset + 1, + 2, ...).
    (define (side-piece-x w side depth)
      (let loop ((d 1) (x *sides-x*))
        (if (= d (- depth side)) x (loop (+ d 1) (+ x w side d)))))

    ;; A baked cell (cx, 0, cw, ch) at (x, y), white-tinted, upright (the
    ;; target is bottom-up: (crash atlas) has the flip), from the plain
    ;; sheet or the depth sheet.
    (define (draw-tile-cell x y cx cw ch)
      (set-color 1.0 1.0 1.0 1.0)
      (draw-texture-region *tiles-tex*
                           x y cw ch
                           cx *tiles-h* cw (- ch)))

    (define (draw-depth-cell x y cx cw ch)
      (set-color 1.0 1.0 1.0 1.0)
      (draw-texture-region *depth-tex*
                           x y cw ch
                           cx *depth-h* cw (- ch)))

    ;; The side strips of a face at (x, y, w, h), depth px deep.
    (define (draw-sides-rects x y w h depth)
      ;; the bottom strip runs the full width plus the side so the corner is filled
      (color! C-SIDE-DARK)
      (draw-filled-rect (- x depth) (+ y h) (+ w depth) depth)
      (color! C-SIDE)
      (draw-filled-rect (- x depth) y depth h))

    ;; The drawn depth of a side on the layer the walk is on.
    (define (side-depth g)
      (if (depth-grow *depth*) (depth-side *depth* *layer*) (geometry-side g)))

    (define (draw-sides-primitives g x y w h)
      (let ((depth (side-depth g))
            (side (geometry-side g)))
        (cond ((not (and (atlas-on?) *tiles-tex*))
               (draw-sides-rects x y w h depth))
              ((= depth side)
               (draw-tile-cell (- x side) y (* TILE-VARIANTS w) (+ w side) (+ h side)))
              (else
               (draw-depth-cell (- x depth) y (side-piece-x w side depth) (+ w depth) (+ h depth))))))

    ;; C's shadow: the patch's top-left (w x h) region drawn at the tile's
    ;; rect moved down and left by the layer's fall, under the tile's own
    ;; sides and body (drawn first in the layer's passes). A sub-rectangle
    ;; of a Bayer field is a Bayer field, so one patch serves every tile.
    (define (draw-shadow g x y w h)
      (let ((fall (depth-shadow-fall *depth* *layer*)))
        (when (> fall 0)
          (if (and (atlas-on?) *depth-tex*)
              (draw-depth-cell (- x fall) (+ y fall) *shadow-x* w h)
              (draw-shadow-patch (- x fall) (+ y fall) w h)))))

    ;; Bayer 4x4 at half: the cells whose threshold is below 8 of 16, as
    ;; 1 px rectangles in C-BAR-A (the bake draws it once; the rect path
    ;; draws it per tile, the oracle). Built with vector, not quoted: a
    ;; quoted literal at a module's top level is the shape the web
    ;; runtime has corrupted before ((crash menu)'s MENU-ENTRIES, 2026-09-19).
    (define BAYER-4
      (vector 0 8 2 10
              12 4 14 6
              3 11 1 9
              15 7 13 5))

    (define (draw-shadow-patch x y w h)
      (color! C-BAR-A)
      (let rows ((j 0))
        (when (< j h)
          (let cols ((i 0))
            (when (< i w)
              (when (< (vector-ref BAYER-4 (+ (* 4 (modulo j 4)) (modulo i 4))) 8)
                (draw-filled-rect (+ x i) (+ y j) 1 1))
              (cols (+ i 1))))
          (rows (+ j 1)))))

    ;; glow: 0..1, how bright the selected face breathes this frame. lock:
    ;; #f, 'strong or 'weak: a locked face is dimmed and barred, red for a
    ;; strong lock, amber for a weak one. right-open?: no tile beside this
    ;; one on its own layer, so its right edge is over a lower layer (or
    ;; nothing) and gets a dark line to read as an edge (David, 2026-09-17:
    ;; a tile's right boundary was hard to see against the tiles under it;
    ;; two faces side by side on one layer stay seamless).
    ;; The face is drawn in three parts so a layer's draws come grouped by
    ;; texture (P3c): every body (rectangles on sgp's white texture), then
    ;; every glyph (the atlas), then the lock bars (rectangles again, over
    ;; the glyph). sokol_gp merges a draw into a batch only across draws
    ;; that share a texture (and looks back eight commands), so a glyph
    ;; between two bodies cost a draw call per tile: 170 GL calls a frame
    ;; against 40 before the atlas. Tiles on one layer never overlap, so
    ;; the grouping draws the same pixels.
    ;; shade: B's step for the tile's layer (0 without B); edge?: whether
    ;; the light top-left edge is drawn (B: only on a tile with nothing on
    ;; top; else always).
    (define (draw-face-body g face x y w h selected? lock right-open? glow shade edge?)
      (cond ((or (not (atlas-on?)) (not *tiles-tex*) selected?)
             (draw-face-rects x y w h selected? lock right-open? glow shade edge?))
            ((and (= shade 0) edge?)
             (draw-tile-cell x y (* (tile-variant lock right-open?) w) w h))
            ((< shade *tiles-layers*)
             (draw-depth-cell x y (* (body-cell shade edge? lock right-open?) w) w h))
            (else
             (draw-face-rects x y w h selected? lock right-open? glow shade edge?))))

    ;; B's face per shade step: the base layer the ruled charcoal, each
    ;; step SHADE-STEP of the way to the side gray (a mix, not a palette
    ;; slot: a candidate; the winner's steps become slots, D48).
    (define SHADE-STEP 0.15)
    (define (face-shade shade)
      (if (= shade 0) FACE-COLOR (mix FACE-COLOR C-SIDE (min 0.75 (* SHADE-STEP shade)))))

    (define (draw-face-rects x y w h selected? lock right-open? glow shade edge?)
      ;; the face, with a lighter top-left edge
      (color! (cond (selected? (mix C-SELECTED C-FACE-EDGE (* 0.35 glow)))
                    ((eq? lock 'strong) C-LOCKED)
                    ((eq? lock 'weak) C-LOCK-WEAK)
                    (else (face-shade shade))))
      (draw-filled-rect x y w h)
      (when (or edge? selected?)
        (color! (if selected? C-SELECTED FACE-EDGE-COLOR))
        (draw-filled-rect x y w 1)
        (draw-filled-rect x y 1 h))
      (when right-open?
        (color! (if selected? C-SELECTED C-SIDE-DARK))
        (draw-filled-rect (+ x w -1) y 1 h)))

    (define (draw-face-glyph-part g look face x y w h selected? scramble)
      (when face (draw-glyph-on g look face x y w h selected? scramble)))

    (define (draw-face-lock x y w h lock)
      (when lock
        (color! (if (eq? lock 'strong) C-TRACE-HOT C-LABEL-LIT))
        (draw-filled-rect x (+ y 3) w 2)
        (draw-filled-rect x (+ y h -5) w 2)))

    ;; A ring around a tile: the cursor highlight in magenta, the priced
    ;; hint in yellow. Drawn after every tile so no neighbor paints over it.
    (define (draw-ring g id color alpha)
      (let* ((r (slot-rect g id))
             (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color-alpha! color alpha)
        (draw-filled-rect (- x 1) (- y 1) (+ w 2) 2)
        (draw-filled-rect (- x 1) (+ y h -1) (+ w 2) 2)
        (draw-filled-rect (- x 1) (- y 1) 2 (+ h 2))
        (draw-filled-rect (+ x w -1) (- y 1) 2 (+ h 2))))

    ;; A tile's rect after the effects: (x y w h) moved by (dx dy) and
    ;; scaled about its centre by (sx sy).
    (define (viewed-rect r view)
      (if (not view)
          r
          (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
                 (dx (car view)) (dy (cadr view))
                 (sx (caddr view)) (sy (cadddr view))
                 (w2 (* w sx))
                 (h2 (* h sy)))
            (list (+ x dx (/ (- w w2) 2.0))
                  (+ y dy (/ (- h h2) 2.0))
                  w2
                  h2))))

    ;; #f, 'strong or 'weak for a tile, at the game's tick.
    (define (lock-state b id now)
      (cond ((not (tile-locked? b id)) #f)
            ((lock-weak? b id now) 'weak)
            (else 'strong)))

    ;; The frame's tile buffers (draw-tiles): TILE-FIELDS values per present
    ;; tile in draw order, each tile's layer, the tiles' indexes sorted by
    ;; layer with each layer's start and count. Grown on demand to the
    ;; layout's slot count and layer count, never per frame.
    (define TILE-FIELDS 7)
    (define *tile-fields* (make-vector 0 0))
    (define *tile-layer* (make-vector 0 0))
    (define *tile-order* (make-vector 0 0))
    (define *layer-start* (make-vector 0 0))
    (define *layer-count* (make-vector 0 0))

    (define (ensure-tile-buffers! slots layers)
      (when (< (vector-length *tile-layer*) slots)
        (set! *tile-fields* (make-vector (* slots TILE-FIELDS) 0))
        (set! *tile-layer* (make-vector slots 0))
        (set! *tile-order* (make-vector slots 0)))
      (when (< (vector-length *layer-start*) layers)
        (set! *layer-start* (make-vector layers 0))
        (set! *layer-count* (make-vector layers 0))))

    ;; Counting sort of the first n tiles by layer into *tile-order*.
    (define (sort-tiles-by-layer! n layers)
      (let clear ((l 0))
        (when (< l layers) (vector-set! *layer-count* l 0) (clear (+ l 1))))
      (let count ((i 0))
        (when (< i n)
          (let ((l (vector-ref *tile-layer* i)))
            (vector-set! *layer-count* l (+ 1 (vector-ref *layer-count* l))))
          (count (+ i 1))))
      (let starts ((l 0) (at 0))
        (when (< l layers)
          (vector-set! *layer-start* l at)
          (starts (+ l 1) (+ at (vector-ref *layer-count* l)))))
      ;; fill in draw order, each layer's cursor from its start
      (let clear ((l 0))
        (when (< l layers) (vector-set! *layer-count* l 0) (clear (+ l 1))))
      (let place ((i 0))
        (when (< i n)
          (let* ((l (vector-ref *tile-layer* i))
                 (k (+ (vector-ref *layer-start* l) (vector-ref *layer-count* l))))
            (vector-set! *tile-order* k i)
            (vector-set! *layer-count* l (+ 1 (vector-ref *layer-count* l))))
          (place (+ i 1)))))

    ;; The fill, a procedure of its own with the tile's rect computed in
    ;; place: as a named let over slot-rect and viewed-rect it allocated
    ;; 192 bytes a tile a frame (2026-09-20: the loop's closure at every
    ;; entry, the rect's list, fx-tile-view's loop), 28 KB a frame.
    (define (fill-tiles! g b x lay selected ids n)
      (cond ((null? ids) n)
            ((tile-present? b (car ids))
             (let* ((id (car ids))
                    (view (fx-tile-view x id))
                    (o (* n TILE-FIELDS))
                    (x0 (slot-x g id))
                    (y0 (slot-y g id))
                    (w (geometry-tile-w g))
                    (h (geometry-tile-h g)))
               (vector-set! *tile-fields* o id)
               (vector-set! *tile-fields* (+ o 1) (or (and view (list-ref view 4)) (tile-face b id)))
               (if view
                   ;; viewed-rect: moved by (dx dy), scaled about the centre by (sx sy)
                   (let ((w2 (* w (caddr view)))
                         (h2 (* h (cadddr view))))
                     (vector-set! *tile-fields* (+ o 2) (+ x0 (car view) (/ (- w w2) 2.0)))
                     (vector-set! *tile-fields* (+ o 3) (+ y0 (cadr view) (/ (- h h2) 2.0)))
                     (vector-set! *tile-fields* (+ o 4) w2)
                     (vector-set! *tile-fields* (+ o 5) h2))
                   (begin
                     (vector-set! *tile-fields* (+ o 2) x0)
                     (vector-set! *tile-fields* (+ o 3) y0)
                     (vector-set! *tile-fields* (+ o 4) w)
                     (vector-set! *tile-fields* (+ o 5) h)))
               (vector-set! *tile-fields* (+ o 6) (eqv? selected id))
               (vector-set! *tile-layer* n (slot-layer (layout-slot lay id)))
               (fill-tiles! g b x lay selected (cdr ids) (+ n 1))))
            (else (fill-tiles! g b x lay selected (cdr ids) n))))

    ;; Pass proc over the tiles of a layer, in draw order.
    (define (walk-layer! k end proc)
      (when (< k end)
        (let ((o (* (vector-ref *tile-order* k) TILE-FIELDS)))
          (proc (vector-ref *tile-fields* o)
                (vector-ref *tile-fields* (+ o 1))
                (vector-ref *tile-fields* (+ o 2))
                (vector-ref *tile-fields* (+ o 3))
                (vector-ref *tile-fields* (+ o 4))
                (vector-ref *tile-fields* (+ o 5))
                (vector-ref *tile-fields* (+ o 6))))
        (walk-layer! (+ k 1) end proc)))

    (define (each-on-layer layer proc)
      (walk-layer! (vector-ref *layer-start* layer)
                   (+ (vector-ref *layer-start* layer) (vector-ref *layer-count* layer))
                   proc))

    (define (draw-tiles s g x)
      (let* ((b (session-board s))
             (lay (board-layout b))
             (selected (board-selected b))
             (now (trace-ticks (session-trace s)))
             (ticks (fx-ticks x))
             (glow (fx-glow x))
             (look (look-ref (session-look s)))
             (highlight (and (eq? (session-model s) 'cursor)
                             (session-cursor-shown s)
                             (session-highlight s)
                             (tile-present? b (session-highlight s))
                             (session-highlight s)))
             ;; every present tile once: (id face x y w h selected?) per
             ;; tile into the module's buffers (no allocation a frame: the
             ;; first cut of this consed a vector per tile and raised the
             ;; GC's minor collections 18 -> 26 per 300 frames), then a
             ;; counting sort by layer, so the four passes a layer takes
             ;; walk an index range instead of re-reading the layout and
             ;; the effects (20 walks of the draw order a frame before)
             (n (begin
                  (ensure-tile-buffers! (length (geometry-draw-order g)) (layout-layer-count lay))
                  (fill-tiles! g b x lay selected (geometry-draw-order g) 0)))
             (sorted (sort-tiles-by-layer! n (layout-layer-count lay))))
        ;; the passes' procedures, made once a frame, not once a layer; the
        ;; layer they are on is *layer* (the depth cues read it)
        (let ((shadows (lambda (id face x y w h selected?)
                         (draw-shadow g x y w h)))
              (sides (lambda (id face x y w h selected?)
                       (draw-sides-primitives g x y w h)))
              (bodies (lambda (id face x y w h selected?)
                        (draw-face-body g face x y w h selected?
                                        (lock-state b id now)
                                        (not (blocked-right? b id))
                                        glow
                                        (if (depth-shade *depth*) *layer* 0)
                                        (or (not (depth-shade *depth*)) (not (covered? b id))))))
              (glyphs (lambda (id face x y w h selected?)
                        (draw-face-glyph-part g look face x y w h selected?
                                              (and (tile-scrambled? b id) (cons ticks id)))))
              (locks (lambda (id face x y w h selected?)
                       (draw-face-lock x y w h (lock-state b id now)))))
          (let loop ((layer 0))
            (when (< layer (layout-layer-count lay))
              (set! *layer* layer)
              (when (> (depth-shadow-fall *depth* layer) 0)
                (each-on-layer layer shadows))
              (each-on-layer layer sides)
              (each-on-layer layer bodies)
              (each-on-layer layer glyphs)
              (each-on-layer layer locks)
              (loop (+ layer 1)))))
        (draw-ghosts g look x)
        (draw-particles g look x)
        (when highlight (draw-ring g highlight C-HIGHLIGHT 1.0))
        (let ((hint (session-hint s))
              (partner (session-hint-partner s))
              (ring-alpha (fx-ring-alpha x)))
          (when (and hint (tile-present? b hint))
            (draw-ring g hint C-LABEL-LIT ring-alpha))
          (when (and partner (tile-present? b partner))
            (draw-ring g partner C-LABEL-LIT ring-alpha)))))

    ;; The match ghosts: a face rising off the table and fading, in the
    ;; primitives style whatever the render mode (the burst is the point).
    (define (draw-ghosts g look x)
      (for-each (lambda (ghost)
                  (let ((face (car ghost))
                        (gx (cadr ghost))
                        (gy (caddr ghost))
                        (w (cadddr ghost))
                        (h (list-ref ghost 4))
                        (a (list-ref ghost 5)))
                    (color-alpha! C-SIDE a)
                    (draw-filled-rect (- gx 2) gy (+ w 2) (+ h 2))
                    (color-alpha! C-SELECTED a)
                    (draw-filled-rect gx gy w h)
                    (when face
                      (color-alpha! (suit-color face) a)
                      (let* ((scale (glyph-scale g))
                             (gw (* scale GLYPH-W))
                             (gh (* scale GLYPH-H)))
                        (draw-face-glyph (look-glyphs look)
                                         face
                                         (exact (floor (+ gx (/ (- w gw) 2))))
                                         (exact (floor (+ gy (/ (- h gh) 2))))
                                         scale)))))
                (fx-ghosts x)))

    ;; Glyph fragments and rain: small squares in the suit color.
    (define (draw-particles g look x)
      (for-each (lambda (pt)
                  (color-alpha! (suit-color (car pt)) (list-ref pt 4))
                  (draw-filled-rect (cadr pt)
                                    (caddr pt)
                                    (cadddr pt)
                                    (cadddr pt)))
                (fx-particles x (geometry-vw g) (geometry-vh g))))

    ;; --- hint labels (model c) -------------------------------------------------
    ;;
    ;; Shown only while the session says so (space toggles them): a small dark
    ;; tag in the 3x5 set, centered on the tile's top edge so the glyph stays
    ;; readable under it; the letters typed so far are drawn lit.

    ;; The labels' boxes first, then their text (one texture each: two
    ;; batches, not one per label), each walk a procedure of its own over
    ;; the slot's x and y, with the typed prefix compared in place: as a
    ;; for-each of lambdas over slot-rect and substring it allocated 46 KB
    ;; a frame (2026-09-20).
    (define (draw-hint-labels s g)
      (let ((typed (session-typed s))
            (labels (session-labels s)))
        (color! C-BG)
        (label-boxes! g labels)
        (label-texts! g labels typed)))

    (define (label-w label) (+ 4 (text-width-mini label 1)))
    (define (label-x g id w) (+ (slot-x g id) (exact (floor (/ (- (geometry-tile-w g) w) 2)))))
    (define (label-y g id) (- (slot-y g id) 3))

    (define (label-boxes! g labels)
      (when (pair? labels)
        (let* ((entry (car labels))
               (w (label-w (cdr entry))))
          (draw-filled-rect (label-x g (car entry) w) (label-y g (car entry)) w 7))
        (label-boxes! g (cdr labels))))

    (define (label-texts! g labels typed)
      (when (pair? labels)
        (let* ((entry (car labels))
               (label (cdr entry))
               (w (label-w label)))
          (color! (if (label-prefix? typed label) C-HIGHLIGHT C-LABEL-LIT))
          (text-mini! label (+ (label-x g (car entry) w) 2) (+ (label-y g (car entry)) 1) 1))
        (label-texts! g (cdr labels) typed)))

    ;; typed is a non-empty prefix of label.
    (define (label-prefix? typed label)
      (let ((n (string-length typed)))
        (and (> n 0)
             (<= n (string-length label))
             (chars-match? typed label 0 n))))

    (define (chars-match? a b i n)
      (or (= i n)
          (and (char=? (string-ref a i) (string-ref b i))
               (chars-match? a b (+ i 1) n))))

    ;; --- HUD ------------------------------------------------------------------
    ;;
    ;; Row 1: the tile counter, the four controls (rects from (crash
    ;; geometry), so a tap lands where the button is drawn), the hint count
    ;; (the trace meter takes this spot in the trace slice) and the seed.
    ;; Row 2: the keys of the model in use.

    ;; line 2 runs from the MENU button to the ? button (LINE-2-X to vw -
    ;; LINE-2-INSET); a longer line wraps at a space onto two rows
    (define HINT-KEYS-LINE
      "TAGS: TYPE ONE  TAB HIDE  ENTER DESELECT  SHIFT+TAB CURSOR  BKSP UNDO  SPACE TOOLS  ^S ^H ^N")
    (define CURSOR-KEYS-LINE
      "CURSOR: ARROWS MOVE  ENTER PICK  SHIFT+TAB TAGS  BKSP UNDO  SPACE TOOLS  ^S ^H ^N")
    ;; Row 2 under the ICE and after the sever, in place of the keys line
    ;; (David, 2026-09-17: make the phase unmistakable, and say that being
    ;; traced does not end the game).
    (define (lock-line b now)
      (let ((locked (board-locked-slots b)))
        (cond ((null? locked) " CRASH THE STACK TO ESCAPE.")
              ((any (lambda (id) (lock-weak? b id now)) locked)
               " A LOCK IS WEAK: TAP IT TO BREAK.")
              (else " A STRONG LOCK HOLDS UNTIL IT WEAKENS."))))

    (define (phase-line tr b)
      (let ((phase (trace-phase tr)))
        (cond ((eq? phase 'counter)
               (string-append "TRACED. ICE INBOUND. ICE IN " (trace-ice-string tr)
                              ". LINK SEVERS IN " (trace-countdown-string tr) "."
                              (lock-line b (trace-ticks tr))))
              ((eq? phase 'severed)
               "LINK SEVERED. TAP: RETRY LINK / NEW STACK / JACK OUT (^R ^N).")
              (else #f))))

    ;; The phase's color for a line of the bar (bible section 1: the ICE
    ;; speaks in C-ICE; a severed link is C-TRACE-HOT).
    (define (phase-color tr)
      (let ((phase (trace-phase tr)))
        (cond ((eq? phase 'counter) C-ICE)
              ((eq? phase 'severed) C-TRACE-HOT)
              (else C-TEXT-DIM))))

    ;; --- the tool stack (ruling D33) ------------------------------------------------

    ;; An icon from the tools sheet ((crash glyphs tools)), 12x12 rows.
    (define (icon-rows name)
      (let ((entry (assq name ICONS)))
        (if entry (cdr entry) (cdr (car ICONS)))))

    ;; The icon through the atlas (one region), or the rect path with
    ;; ?atlas=off: the two bar buttons' icons were 2.6 KB a frame each
    ;; through draw-rows (2026-09-20).
    (define (icon! name x y scale)
      (unless (and (atlas-on?) (atlas-icon name x y scale))
        (draw-rows (icon-rows name) x y scale ICON-W)))

    ;; A 24x24 bar button: the icon at scale 1 over a mini key name, lit
    ;; or not.
    (define (draw-bar-button r icon key lit?)
      (let ((x (car r))
            (y (cadr r))
            (w (caddr r))
            (h (cadddr r)))
        (color! (if lit? C-SELECTED C-BAR-C))
        (draw-filled-rect x y w h)
        (color! (if lit? C-HIGHLIGHT C-TEXT-DIM))
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)
        (color! (if lit? C-BG C-TEXT))
        (icon! icon (+ x 6) (+ y 2) 1)
        (color! (if lit? C-BG C-TEXT-DIM))
        (text-mini! key (+ x (quotient (- w (text-width-mini key 1)) 2)) (+ y 16) 1)))

    ;; The corner button: the wrench (David, 2026-09-19), SPC beneath in
    ;; the mini font, lit while the stack is open or just after a choice,
    ;; a badge at the top right when a tool is banked or disabled.
    (define (draw-tool-button vh st badge?)
      (let ((r (tool-button-rect vh)))
        (draw-bar-button r 'wrench "SPC" (or (tools-open? st) (> (tools-flash st) 0)))
        (when badge?
          (color! C-LABEL-LIT)
          (draw-filled-rect (+ (car r) (caddr r) -7) (+ (cadr r) 1) 6 6))))

    ;; The menu's peer button beside the wrench: the door, ESC beneath.
    (define (draw-menu-button r)
      (draw-bar-button r 'menu "ESC" #f))

    ;; A tag key's letter, upper case (the font has no lower case).
    (define (tag-text key)
      (let ((c (string-ref (symbol->string key) 0)))
        (string (if (char-lower-case? c) (char-upcase c) c))))

    ;; The column: entries sliding up from the button (out-quad over
    ;; OPEN-TICKS, a STAGGER-TICKS stagger from the bottom up, scale 0.6 to
    ;; 1 and alpha 0 to 1), each a 12x12 icon in the tool's color, the
    ;; label, a price in C-TRACE-HOT or a bank as xN, and the tag key in
    ;; a C-LABEL-LIT box at the right (hollow when disabled). The board
    ;; is dimmed to 70 % while the stack is open.
    (define (draw-tool-stack vw vh st tools)
      (let* ((n (length tools))
             (age (tools-open st))
             (touch? (tools-touch st)))
        (color-alpha! C-BG 0.3)
        (draw-filled-rect 0 0 vw (- vh HUD-HEIGHT))
        (let loop ((ts tools) (i 0))
          (when (pair? ts)
            (let* ((t (car ts))
                   (r (tool-entry-rect vh i n touch?))
                   (p (ease 'out-quad (entry-progress age i n)))
                   (sc (+ 0.6 (* 0.4 p)))
                   (w (exact (floor (* (caddr r) sc))))
                   (h (exact (floor (* (cadddr r) sc))))
                   (x (car r))
                   (y (+ (cadr r) (- (cadddr r) h)))
                   (on? (tool-enabled t))
                   (hi? (eqv? i (tools-highlight st)))
                   (ink (cond ((not on?) C-TEXT-DIM) (else C-TEXT)))
                   ;; the icon's color: the tool's kind in the suit colors
                   ;; (undo MEM blue, shuffle and scramble TX green, hint
                   ;; and probe DSK violet), look and pull in the tag
                   ;; color, next in the trace's, menu dim
                   (tone (case (tool-name t)
                           ((undo) C-SUIT-0)
                           ((shuf scram) C-SUIT-2)
                           ((hint probe) C-SUIT-3)
                           ((draw) C-LABEL-LIT)
                           ((next) C-TRACE)
                           (else C-TEXT-DIM))))
              (when (> p 0.0)
                (color-alpha! (if hi? C-BAR-B C-BAR-C) p)
                (draw-filled-rect x y w h)
                (color-alpha! (if hi? C-HIGHLIGHT C-TEXT-DIM) p)
                (draw-filled-rect x y w 1)
                (draw-filled-rect x (+ y h -1) w 1)
                (draw-filled-rect x y 1 h)
                (draw-filled-rect (+ x w -1) y 1 h)
                (when (>= p 1.0)
                  (let ((ty (+ y (exact (floor (/ (- h 14) 2))))))
                    ;; the tool's icon from the sheet, in the tool's color
                    (color! (if on? tone C-TEXT-DIM))
                    (icon! (tool-name t) (+ x 6) (+ ty 1) 1)
                    (color! ink)
                    (text! (tool-label t) (+ x 22) ty 2)
                    (let* ((after (+ x 22 (text-width (tool-label t) 2) 4))
                           (after (if (tool-price t)
                                      (let ((p (number->string (tool-price t))))
                                        (color! (if on? C-TRACE-HOT C-TEXT-DIM))
                                        (text-mini! p after (+ ty 3) 1)
                                        (+ after (text-width-mini p 1) 4))
                                      after)))
                      (when (tool-bank t)
                        (color! (if on? C-LABEL-LIT C-TEXT-DIM))
                        (text-mini! (string-append "X" (number->string (tool-bank t))) after (+ ty 3) 1)))
                    ;; the tag box
                    (let ((bx (+ x w -15))
                          (by (+ y (exact (floor (/ (- h 12) 2))))))
                      (color! C-LABEL-LIT)
                      (if on?
                          (draw-filled-rect bx by 12 12)
                          (begin
                            (draw-filled-rect bx by 12 1)
                            (draw-filled-rect bx (+ by 11) 12 1)
                            (draw-filled-rect bx by 1 12)
                            (draw-filled-rect (+ bx 11) by 1 12)))
                      (color! (if on? C-BG C-LABEL-LIT))
                      (text! (tag-text (tool-tag t)) (+ bx 3) (+ by 2) 1)))))
              (loop (cdr ts) (+ i 1)))))))

    ;; A string built from a number, kept until the number changes: a
    ;; readout rebuilt every frame is a literal, a number->string and a
    ;; string-append, each an allocation in the native codegen, and the
    ;; HUD has five (2026-09-20). build is a procedure of the key.
    (define (text-cache) (vector #f ""))

    (define (cached-text c key build)
      (unless (equal? key (vector-ref c 0))
        (vector-set! c 0 key)
        (vector-set! c 1 (build key)))
      (vector-ref c 1))

    (define *tiles-text* (text-cache))
    (define *seed-text* (text-cache))
    (define *time-text* (text-cache))
    (define *trace-text* (text-cache))
    (define *link-text* (text-cache))
    (define *crashed-text* (text-cache))
    (define *ice-text* (text-cache))
    (define *prompt-text* (text-cache))
    (define (tiles-text n) (string-append "TILES " (number->string n)))
    ;; keyed by a string (the ICE clock, the typed letters): equal, not eqv
    (define (ice-text clock) (string-append "ICE IN " clock))
    (define (prompt-text typed) (string-append "> " typed))
    (define (seed-text n) (string-append "SEED " (number->string n)))
    (define (time-text n) (string-append "TIME " (clock-string n)))
    (define (trace-text n) (string-append "TRACE " (number->string n)))
    (define (link-text n) (string-append "LINK " (clock-string n)))
    (define (crashed-text n) (string-append "CRASHED " (clock-string n)))

    ;; --- the bar (ruling D33: status only) --------------------------------------------

    ;; The band, its top rule (a full-width phase-colored strip in the
    ;; strip layout, with the meter drawn over it) and the tool button.
    (define (draw-bar-frame vw vh top layout tr st badge?)
      (color! C-BG)
      (draw-filled-rect 0 top vw (- vh top))
      (color! C-BAR-C)
      (draw-filled-rect 0 top vw 1)
      (draw-tool-button vh st badge?)
      (draw-menu-button (cdr (assq 'menu (bar-controls vw vh)))))

    ;; A readout at the right of the first row (zones) or inside the strip
    ;; (strip), right-aligned in its rect.
    (define (draw-readout r layout text color)
      (let ((strip? (eq? layout 'strip)))
        (color! color)
        (if strip?
            (text! text (- (+ (car r) (caddr r)) (text-width text 1)) (+ (cadr r) 2) 1)
            (text! text (- (+ (car r) (caddr r)) (text-width text 2)) (+ (cadr r) 3) 2))))

    ;; The second line: the keys line when shown, else the phase line in
    ;; its color, else the instruction; centered between the MENU button
    ;; and the ? button, never over either. A line wider than that span
    ;; wraps at the last space that fits onto two rows, the first above
    ;; the second (David's phone read, 2026-09-20: the counter-hack lines
    ;; ran under the buttons). A wrapped line costs two substrings a
    ;; frame (the lines that wrap, the phase line and the keys line, are
    ;; rare or already rebuilt each frame).
    (define LINE-2-X 60)          ; the MENU button's right edge plus a cell
    (define LINE-2-INSET 32)      ; the ? button's width plus its margin and a cell
    (define LINE-2-Y 32)          ; the single row
    (define LINE-2-UPPER-Y 24)    ; the first of two rows: under the meter and the UPDATE mark
    (define LINE-2-LOWER-Y 33)    ; the second, a cell's gap below the first
    (define LINE-2-SCALE 1)

    ;; The index of the space nearest the middle of the text whose two
    ;; halves both fit in limit characters, else the last space at or
    ;; before the limit, else #f (no space: the line is cut at the limit).
    ;; Balanced halves read as one sentence in two rows; a split at the
    ;; last fitting space leaves a word or two alone on the second row.
    (define (split-point text limit)
      (let* ((n (string-length text))
             (mid (quotient n 2)))
        (let loop ((d 0))
          (cond ((> d mid) (last-space-before text limit))
                ((space-at? text (- mid d) limit n) (- mid d))
                ((space-at? text (+ mid d) limit n) (+ mid d))
                (else (loop (+ d 1)))))))

    ;; A space at i whose halves (before it, after it) both fit.
    (define (space-at? text i limit n)
      (and (>= i 0)
           (< i n)
           (char=? (string-ref text i) #\space)
           (<= i limit)
           (<= (- n i 1) limit)))

    (define (last-space-before text limit)
      (let loop ((i (min limit (- (string-length text) 1))))
        (cond ((< i 0) #f)
              ((char=? (string-ref text i) #\space) i)
              (else (loop (- i 1))))))

    (define (draw-line-2 vw top text color)
      (let* ((span (- vw LINE-2-X LINE-2-INSET))
             (w (text-width text LINE-2-SCALE))
             (cell (+ 1 GLYPH-W)))
        (color! color)
        (if (<= w span)
            (text! text (+ LINE-2-X (quotient (- span w) 2)) (+ top LINE-2-Y) LINE-2-SCALE)
            (let* ((fit (quotient span cell))
                   (at (or (split-point text fit) fit))
                   (head (substring text 0 at))
                   (tail (substring text (min (string-length text) (+ at 1)) (string-length text)))
                   (tail (if (> (text-width tail LINE-2-SCALE) span)
                             (substring tail 0 (min (string-length tail) fit))
                             tail)))
              (text! head (+ LINE-2-X (quotient (- span (text-width head LINE-2-SCALE)) 2)) (+ top LINE-2-UPPER-Y) LINE-2-SCALE)
              (text! tail (+ LINE-2-X (quotient (- span (text-width tail LINE-2-SCALE)) 2)) (+ top LINE-2-LOWER-Y) LINE-2-SCALE)))))

    ;; The ? button at the bar's right end, the wrench's peer: the keys
    ;; icon over its key, lit while the keys line shows.
    (define (draw-keys-button r shown?)
      (draw-bar-button r 'keys "?" shown?))

    ;; The tag letters typed so far: zones, at scale 2 to the left of the
    ;; meter, right-aligned a cell short of its edge (the ICE countdown
    ;; owns the meter's right; David's read 2026-09-20: the two wrote
    ;; over each other); strip, inside the strip at its middle, at the
    ;; strip's own scale. typed: the letters; the "> " string is kept
    ;; until they change (both tables share the cache: one draws a frame).
    (define (draw-prompt m top layout typed)
      (color! C-HIGHLIGHT)
      (draw-prompt-text m top layout (cached-text *prompt-text* typed prompt-text)))

    (define (draw-prompt-text m top layout text)
      (if (eq? layout 'strip)
          (text! text (- (+ (car m) (half (caddr m))) (half (text-width text 1))) (+ (cadr m) STRIP-TEXT-Y) 1)
          (text! text (- (car m) 6 (text-width text 2)) (+ top 7) 2)))

    ;; The text row inside the strip: the border, then a pixel of padding.
    (define STRIP-TEXT-Y 3)

    ;; At the meter's right: the ICE countdown under the ICE (bible
    ;; section 5) in C-ICE, else the caller's readout (the seed, the
    ;; score's mode), dim. Zones: beside the box, the countdown at scale 1
    ;; on the text's row, the readout in the mini font; strip: inside the
    ;; strip, right-aligned a cell short of its end. ice-clock: the
    ;; trace's m:ss under the ICE, else #f; the "ICE IN " string is kept
    ;; until the clock changes.
    (define (draw-beside-meter m top layout ice-clock other-text)
      (draw-beside-meter-text m top layout
                              (and ice-clock (cached-text *ice-text* ice-clock ice-text))
                              other-text))

    (define (draw-beside-meter-text m top layout ice-text other-text)
      (if (eq? layout 'strip)
          (let* ((text (or ice-text other-text))
                 (x (- (+ (car m) (caddr m)) 6 (text-width text 1))))
            (color! (if ice-text C-ICE C-TEXT-DIM))
            (text! text x (+ (cadr m) STRIP-TEXT-Y) 1))
          (let ((x (+ (car m) (caddr m) 8)))
            (cond (ice-text
                   (color! C-ICE)
                   (text! ice-text x (+ (cadr m) (quotient (- (cadddr m) 7) 2)) 1))
                  (else
                   (color! C-TEXT-DIM)
                   (text-mini! other-text x (+ (cadr m) (quotient (- (cadddr m) 5) 2)) 1))))))

    ;; The meter in the rect the layout gives it: zones a METER-W x
    ;; METER-H box on the first row, strip the band's top STRIP-H px
    ;; across the width.
    (define (draw-meter g layout tr)
      (draw-meter-in (meter-rect g layout) tr))

    ;; The meter in any rect (both tables' bars): the text at scale 2 in
    ;; a box 16 or taller, scale 1 in the strip. The texts are kept by
    ;; the second they show (a clock string floors its seconds), the
    ;; phase dispatch a cond (a case clause allocates in the native
    ;; codegen).
    (define (draw-meter-in r tr)
      (let* ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
             (phase (trace-phase tr))
             (clean? (eq? (trace-mode tr) 'clean))
             (sc (if (>= h 16) 2 1))
             (ty (+ y (exact (floor (/ (- h (* 7 sc)) 2)))))
             (seconds (exact (floor (trace-value tr)))))
        (color! C-BG)
        (draw-filled-rect x y w h)
        (if (and clean? (not (eq? phase 'cleared)))
            (begin
              (color! C-TEXT)
              (text! (cached-text *time-text* seconds time-text) (+ x 4) ty sc))
            (let* ((frac (trace-fraction tr))
                   (fill (exact (floor (* (- w 2) frac))))
                   (text (cond ((eq? phase 'trace) (cached-text *trace-text* seconds trace-text))
                               ((eq? phase 'counter)
                                (cached-text *link-text* (exact (floor (/ (trace-countdown tr) TICKS-PER-SECOND))) link-text))
                               ((eq? phase 'severed) SEVERED-TEXT)
                               (else (cached-text *crashed-text* seconds crashed-text))))
                   (bar (cond ((eq? phase 'trace) (mix C-TRACE C-TRACE-HOT frac))
                              ((eq? phase 'counter) C-TRACE-HOT)
                              (else C-TRACE))))
              (color! C-TEXT-DIM)
              (draw-filled-rect x y w 1)
              (draw-filled-rect x (+ y h -1) w 1)
              (draw-filled-rect x y 1 h)
              (draw-filled-rect (+ x w -1) y 1 h)
              (color! bar)
              (draw-filled-rect (+ x 1) (+ y 1) fill (- h 2))
              (color! (if (eq? phase 'severed) C-HIGHLIGHT C-TEXT))
              (text! text (+ x 4) ty sc)))))

    (define SEVERED-TEXT "SEVERED")

    ;; A box with a label, the shape of every control.
    (define (draw-box r label fill edge ink)
      (let ((x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
        (color! fill)
        (draw-filled-rect x y w h)
        (color! edge)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)
        (color! ink)
        (text! label
                   (+ x (exact (floor (/ (- w (text-width label 2)) 2))))
                   (+ y (exact (floor (/ (- h 14) 2))))
                   2)))

    ;; The web build's waiting update (ruling D14): the mark in the HUD
    ;; while a version waits, the prompt's two boxes above the HUD.
    (define (draw-update-mark g layout)
      (draw-box (cdr (assq 'update (update-controls g layout))) "UPDATE" C-BAR-C C-SELECTED C-SELECTED))

    (define (draw-update-prompt g)
      (let* ((vw (geometry-vw g))
             (top (- (geometry-vh g) (geometry-hud-h g)))
             (title "NEW VERSION READY")
             (tw (text-width title 2)))
        (color-alpha! C-BG 0.9)
        (draw-filled-rect (- (half vw) 150) (- top 74) 300 62)
        (color! C-SELECTED)
        (text! title (- (half vw) (half tw)) (- top 68) 2)
        (draw-box (cdr (assq 'apply (update-controls g 'zones))) "APPLY" C-BAR-C C-SELECTED C-TEXT)
        (draw-box (cdr (assq 'later (update-controls g 'zones))) "NOT NOW" C-BAR-C C-TEXT-DIM C-TEXT)))

    ;; The centred message box. rise: 0..1 slides it in from below and fades
    ;; it up (the cleared sequence); fade: 0..1 slides it up and fades it
    ;; out (a toast leaving). A state message passes 1 and 0.
    (define (draw-message g message top rise fade)
      (draw-message-in (geometry-vw g) message top rise fade))

    (define (draw-message-in vw message top rise fade)
      (let* ((w (text-width message 3))
             (x (exact (floor (/ (- vw w) 2))))
             (k (ease 'out-back rise))
             (y (exact (floor (- (+ (/ top 2) (* 40 (- 1.0 k)))
                                 (* 50 (ease 'in-out-quad fade))))))
             (a (* rise (- 1.0 fade))))
        (color-alpha! C-BG a)
        (draw-filled-rect (- x 8) (- y 16) (+ w 16) 36)
        (color-alpha! C-SELECTED a)
        (text! message x (- y 10) 3)))

    ;; A toast: slides in from the right edge to sit just above the HUD,
    ;; holds, then slides out to the right (David, 2026-09-17: not over the
    ;; tiles; the terminal states keep the middle of the screen). The slide
    ;; in takes the first TOAST-SLIDE of its life, the slide out the last.
    (define TOAST-SLIDE 0.12)

    (define (draw-toast g text top p)
      (draw-toast-in (geometry-vw g) text top p))

    ;; An ICE line is one the ICE speaks ("ICE LOCKED A PAIR.", and the
    ;; lock lines, which are its work too); the bible's section 1 gives it
    ;; C-ICE, every other line C-TEXT, and nothing else exists (Gibson's
    ;; C-GIBSON waits for D17's lines).
    (define (ice-line? text)
      (or (and (>= (string-length text) 4)
               (string=? (substring text 0 4) "ICE "))
          (and (member text (list MSG-LOCKED MSG-LOCK-WEAK MSG-LOCK-BROKEN)) #t)))

    ;; The same toast on any table (the card table's, P2). An ICE toast
    ;; lands with about six ticks of C-ICE around the board's edge (bible
    ;; section 5), so the counter-hack is unmistakable from across the
    ;; room: ICE-FLASH of the toast's life, six ticks of the stack's 160
    ;; and five of the card table's 130.
    (define ICE-FLASH 0.0375)

    (define (draw-toast-in vw text top p)
      (let* ((ice? (ice-line? text))
             (ink (if ice? C-ICE C-TEXT))
             (edge (if ice? C-ICE C-TEXT-DIM))
             (w (+ 16 (text-width text 2)))
             (h 24)
             (slide (cond ((< p TOAST-SLIDE) (- 1.0 (ease 'out-quad (/ p TOAST-SLIDE))))
                          ((> p (- 1.0 TOAST-SLIDE))
                           (ease 'in-out-quad (/ (- p (- 1.0 TOAST-SLIDE)) TOAST-SLIDE)))
                          (else 0.0)))
             (x (exact (floor (+ (- vw w 8) (* slide (+ w 8))))))
             ;; wholly above the bar: the readout now sits under the toast's lane (S8)
             (y (- top 26))
             ;; a short flash as it lands
             (flash (if (and (>= p TOAST-SLIDE) (< p (* 2.5 TOAST-SLIDE)))
                        (if (even? (exact (floor (* p 60)))) 1.0 0.0)
                        0.0)))
        (when (and ice? (>= p TOAST-SLIDE) (< p (+ TOAST-SLIDE ICE-FLASH)))
          (color! C-ICE)
          (draw-filled-rect 0 0 vw 3)
          (draw-filled-rect 0 (- top 3) vw 3)
          (draw-filled-rect 0 0 3 top)
          (draw-filled-rect (- vw 3) 0 3 top))
        (color! (mix C-BG ink (* 0.5 flash)))
        (draw-filled-rect x y w h)
        (color! edge)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)
        (color! (mix ink C-FACE-EDGE flash))
        (text! text (+ x 8) (+ y 5) 2)))

    (define (draw-hud s g x)
      (let* ((b (session-board s))
             (tr (session-trace s))
             (vw (geometry-vw g))
             (vh (geometry-vh g))
             (top (- vh (geometry-hud-h g)))
             (layout (session-hud s))
             (st (session-tools s))
             (tools (session-tools-list s))
             (readout (cached-text *tiles-text* (board-tile-count b) tiles-text))
             (cleared (fx-cleared x))
             (m (meter-rect g layout)))
        (draw-bar-frame vw vh top layout tr st (not (every tool-enabled tools)))
        (draw-meter g layout tr)
        (draw-readout (readout-rect g layout) layout readout C-TEXT)
        ;; beside the meter: the ICE countdown under the ICE, else the seed
        (draw-beside-meter m top layout
                           (and (eq? (trace-phase tr) 'counter) (trace-ice-string tr))
                           (cached-text *seed-text* (session-seed s) seed-text))
        (when (or (eq? (session-update s) 'waiting) (eq? (session-update s) 'prompt))
          (draw-update-mark g layout))
        (draw-keys-button (control-rect g layout 'keys) (session-keys-shown s))
        ;; line 2: the keys line when asked for, else the phase line, else
        ;; the instruction (David, 2026-09-17: centered)
        (let ((line (phase-line tr b)))
          (cond ((session-keys-shown s)
                 (draw-line-2 vw top (if (eq? (session-model s) 'hint) HINT-KEYS-LINE CURSOR-KEYS-LINE) C-TEXT-DIM))
                (line (draw-line-2 vw top line (phase-color tr)))
                (else (draw-line-2 vw top (session-instruction s) C-TEXT-DIM))))
        ;; the typed tag letters, at the meter's left (its right is the ICE's)
        (when (> (string-length (session-typed s)) 0)
          (draw-prompt m top layout (session-typed s)))
        ;; state messages sit; everything else is a toast from (crash fx)
        (let* ((state (cond ((board-cleared? b)
                             (string-append "STACK CRASHED " (trace-clock-string tr)
                                            (cond ((eq? (trace-mode tr) 'clean) "")
                                                  ((eq? (trace-cleared-in tr) 'counter)
                                                   (string-append " " TAG-UNDER-ICE))
                                                  (else (string-append " " TAG-CLEAN-RUN)))))
                            ((trace-severed? tr) "")
                            ((board-no-moves? b) "NO MOVES LEFT - SHUFFLE")
                            ((session-hint-armed s) "HINT: PRESS A FACE KEY")
                            (else "")))
               (toast (fx-toast x)))
          (cond ((not (string=? state ""))
                 (draw-message g state top (if (and (board-cleared? b) cleared)
                                               (min 1.0 (* cleared 5.0))
                                               1.0)
                               0.0))
                ((and toast (not (trace-severed? tr)))
                 (draw-toast g (car toast) top (cdr toast)))))
        ;; the stack over everything of the board, under the update prompt
        (when (tools-open? st)
          (draw-tool-stack vw vh st tools))))

    ;; --- the trace's screens -------------------------------------------------

    ;; The glitch when the trace completes: horizontal slices of the board in
    ;; the hot colours, thinning out as it passes, from the board's own
    ;; random stream seeded by the tick so it flickers.
    (define (draw-glitch g x p)
      (draw-glitch-in (geometry-vw g) (- (geometry-vh g) (geometry-hud-h g)) (fx-ticks x) p))

    ;; ticks: the frame's sim tick, seeding the flicker.
    (define (draw-glitch-in vw top ticks p)
      (let* ((n (exact (floor (* 24 (- 1.0 p)))))
             (a (* 0.7 (- 1.0 p))))
        (let loop ((k 0) (rng (prng-seed (+ 13 ticks))))
          (when (< k n)
            (let* ((r1 (prng-next rng))
                   (r2 (prng-next r1))
                   (r3 (prng-next r2))
                   (y (prng-index r1 top))
                   (h (+ 2 (prng-index r2 6)))
                   (dx (- (prng-index r3 40) 20)))
              ;; bible section 5: band displacement in C-STATIC-A, with the
              ;; hot color David saw in P1 every third band
              (color-alpha! (if (= 0 (modulo k 3)) C-TRACE-HOT C-STATIC-A) a)
              (draw-filled-rect dx y vw h)
              (loop (+ k 1) r3))))))

    ;; The severed connection: static over the board and the three choices.
    (define (draw-severed g x)
      (draw-severed-in (geometry-vw g)
                       (- (geometry-vh g) (geometry-hud-h g))
                       (fx-ticks x)
                       '("RETRY LINK" "NEW STACK" "JACK OUT")
                       (fx-sever x)))

    ;; labels: the three choices, left to right, each a third of the board.
    ;; static: the sever's progress 0..1 while the static decays (bible
    ;; section 5: C-STATIC-A/B over 30 ticks), #f once it has; the overlay
    ;; and the choices fade in as the static fades out.
    (define (draw-severed-in vw top ticks labels static)
      (let ((p (or static 1.0)))
        (color-alpha! C-BG (* 0.75 p))
        (draw-filled-rect 0 0 vw top)
        ;; the static: horizontal bands in the static colors, dense at
        ;; the sever and thinning out
        (when static
          (let loop ((k 0) (rng (prng-seed (+ 29 ticks))))
            (when (< k (exact (floor (* 60 (- 1.0 p)))))
              (let* ((r1 (prng-next rng))
                     (r2 (prng-next r1))
                     (r3 (prng-next r2)))
                (color-alpha! (if (even? k) C-STATIC-A C-STATIC-B) (* 0.9 (- 1.0 p)))
                (draw-filled-rect 0 (prng-index r1 top) vw (+ 1 (prng-index r2 4)))
                (loop (+ k 1) r3)))))
        (let loop ((k 0) (rng (prng-seed (+ 17 ticks))))
          (when (< k 160)
            (let* ((r1 (prng-next rng))
                   (r2 (prng-next r1))
                   (r3 (prng-next r2)))
              (color-alpha! C-TEXT-DIM (* p (+ 0.15 (* 0.5 (/ (prng-index r3 100) 100.0)))))
              (draw-filled-rect (prng-index r1 vw) (prng-index r2 top) 3 2)
              (loop (+ k 1) r3))))
        (let* ((title "LINK SEVERED")
               (tw (text-width title 3)))
          (color-alpha! C-TRACE-HOT p)
          (text! title (exact (floor (/ (- vw tw) 2))) (- (half top) 40) 3))
        (for-each (lambda (choice)
                    (let* ((label (car choice))
                           (cx (cdr choice))
                           (w 180)
                           (h 40)
                           (bx (- cx (half w)))
                           (by (+ (half top) 10)))
                      (color-alpha! C-BAR-C p)
                      (draw-filled-rect bx by w h)
                      (color-alpha! C-SELECTED p)
                      (draw-filled-rect bx by w 1)
                      (draw-filled-rect bx (+ by h -1) w 1)
                      (draw-filled-rect bx by 1 h)
                      (draw-filled-rect (+ bx w -1) by 1 h)
                      (color-alpha! C-TEXT p)
                      (text! label
                                 (- cx (half (text-width label 2)))
                                 (+ by 13)
                                 2)))
                  (let ((third (quotient vw 3)))
                    (list (cons (car labels) (half third))
                          (cons (cadr labels) (+ third (half third)))
                          (cons (caddr labels) (+ (* 2 third) (half third))))))))

    ;; --- the menu -------------------------------------------------------------

    ;; The first screen (P2, ruling D14's placeholder): the title, the
    ;; entries from (crash menu) in their rects, the highlighted one lit.
    ;; The title (P3, S8's placeholder for P4's real one) in the bible's
    ;; hero colors: the wordmark in C-SELECTED over a C-HIGHLIGHT shadow,
    ;; a C-HOT rule under it. version: a short string for the corner, or #f.
    (define (draw-menu m vw vh version . rest)
      (color! C-BG)
      (draw-filled-rect 0 0 vw vh)
      (let loop ((y -36) (i 0))
        (when (< y vh)
          (color! (case (modulo i 3)
                     ((0) C-BAR-A)
                     ((1) C-BAR-B)
                     (else C-BAR-C)))
          (draw-filled-rect 0 y vw 6)
          (loop (+ y 12) (+ i 1))))
      ;; the title (P3d): the ANSI logo and its reveal, from the menu's state
      (draw-title (menu-title m) vw vh (and (pair? rest) (car rest)) (and (pair? rest) (pair? (cdr rest)) (cadr rest)))
      ;; the items (rulings D39 and D40, P3d): plain text, no box, the
      ;; selected one in the hero ramp with a blinking cursor, and only
      ;; once the boot's steps are done; drawn by (crash title draw)
      (draw-menu-items m vw vh)
      (unless (title-covers? (menu-title m))   ; not over the gate or the publisher card (P3d)
        (color! C-TEXT-DIM)
        (text! "ARROWS OR TAP. ENTER PICKS." 8 (- vh 14) 1)   ; through the atlas when on (P3d: the menu's frame is ~150 calls now, not ~2,600)
        (when version
          (color! C-TEXT-DIM)
          (text! version (- vw 8 (text-width version 1)) (- vh 14) 1))))

    ;; Frame-time readout for --log-keys / ?ms, top-right: the last frame's
    ;; wall time in ms, and under it the field's cost this frame, CPU side:
    ;; the step (the CPU rule, or issuing the GPU passes) and the present
    ;; pass (GPU field only), in ms to a tenth.
    ;; line3: the shell's summary of the last window's worst frame and GC
    ;; pauses (the web shell's; "" natively), for the phone's own read.
    ;; The ?diag overlay: the last trace lines drawn on the frame, top-left,
    ;; in the mini font through the rect path (not the atlas: the overlay
    ;; must draw when a texture does not), over a dark band, so a phone
    ;; with no console can screenshot what the trace said (2026-09-20:
    ;; David's phone lost the title's textures where headless kept them).
    (define (draw-diag-lines lines)
      (let ((n (length lines)))
        (color! C-BG)
        (draw-filled-rect 0 0 640 (+ 4 (* 7 n)))
        (let loop ((ls lines) (y 2))
          (when (pair? ls)
            (color! C-TEXT)
            (draw-text-mini (car ls) 2 y 1)
            (loop (cdr ls) (+ y 7))))))

    (define (draw-frame-ms ms step present line3)
      (let ((text (string-append "MS " (number->string (exact (round ms)))))
            (line2 (string-append "STEP " (tenths step) " PRES " (tenths present))))
        (color! C-LABEL-LIT)
        (text! text (- 640 8 (text-width text 2)) 6 2)
        (text! line2 (- 640 8 (text-width line2 1)) 22 1)
        (unless (string=? line3 "")
          (text! line3 (- 640 8 (text-width line3 1)) 32 1))))

    (define (tenths x)
      (let* ((t (exact (round (* 10 x))))
             (whole (quotient t 10))
             (frac (modulo t 10)))
        (string-append (number->string whole) "." (number->string frac))))

    ;; The phosphor probe (?phosphor=probe, the arm's door): a block over
    ;; the board in C-SELECTED on even frames and C-HIGHLIGHT on odd, so
    ;; with persistence on every presented frame carries a mix of the two
    ;; and neither pure color.
    (define (draw-phosphor-probe frame)
      (color! (if (even? frame) C-SELECTED C-HIGHLIGHT))
      (draw-filled-rect PROBE-X PROBE-Y PROBE-W PROBE-H))

    (define PROBE-X 200)
    (define PROBE-Y 120)
    (define PROBE-W 240)
    (define PROBE-H 100)

    ;; --- one frame ------------------------------------------------------------

    ;; --- the editor -----------------------------------------------------------
    ;;
    ;; Blank faces on the canvas geometry, the layers above the cursor's
    ;; drawn per the editor's dim mode, the cursor as a ring (selected color
    ;; where a tile can go, highlight where it cannot), and a status line.

    (define (draw-editor e g)
      (let* ((c (editor-cursor e))
             (cl (car c))
             (dim (editor-dim e))
             (vw (geometry-vw g))
             (vh (geometry-vh g))
             (top (- vh (geometry-hud-h g)))
             (alpha-for (lambda (layer)
                          (cond ((<= layer cl) 1.0)
                                ((eq? dim 'full) 1.0)
                                ((eq? dim 'dim) 0.35)
                                (else 0.0)))))
        (draw-background g 0.0 #f 'roll)
        (let loop ((layer 0))
          (when (< layer CANVAS-LAYERS)
            (let ((a (alpha-for layer))
                  (on-layer (filter (lambda (p) (= (car p) layer)) (editor-slots e))))
              (when (> a 0.0)
                (for-each (lambda (p)
                            (let* ((r (cell-rect g layer (cadr p) (caddr p)))
                                   (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
                                   (side (geometry-side g)))
                              (color-alpha! C-SIDE-DARK a)
                              (draw-filled-rect (- x side) (+ y h) (+ w side) side)
                              (color-alpha! C-SIDE a)
                              (draw-filled-rect (- x side) y side h)))
                          on-layer)
                (for-each (lambda (p)
                            (let* ((r (cell-rect g layer (cadr p) (caddr p)))
                                   (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r)))
                              (color-alpha! (if (= layer cl) C-FACE (mix C-FACE C-BAR-C 0.25)) a)
                              (draw-filled-rect x y w h)
                              (color-alpha! C-FACE-EDGE a)
                              (draw-filled-rect x y w 1)
                              (draw-filled-rect x y 1 h)))
                          on-layer)))
            (loop (+ layer 1))))
        ;; the cursor
        (let* ((r (cell-rect g cl (cadr c) (caddr c)))
               (x (car r)) (y (cadr r)) (w (caddr r)) (h (cadddr r))
               (here? (and (member c (editor-slots e)) #t))
               (ok? (or here? (placeable? e c))))
          (color! (if ok? C-SELECTED C-HIGHLIGHT))
          (draw-filled-rect (- x 1) (- y 1) (+ w 2) 2)
          (draw-filled-rect (- x 1) (+ y h -1) (+ w 2) 2)
          (draw-filled-rect (- x 1) (- y 1) 2 (+ h 2))
          (draw-filled-rect (+ x w -1) (- y 1) 2 (+ h 2)))
        ;; the HUD
        (color! C-BG)
        (draw-filled-rect 0 top vw (geometry-hud-h g))
        (color! C-TEXT-DIM)
        (draw-filled-rect 0 top vw 1)
        (color! C-TEXT)
        (text! (string-append "EDIT  TILES " (number->string (editor-count e))
                                  "  LAYER " (number->string cl)
                                  "  AT " (number->string (cadr c)) "," (number->string (caddr c))
                                  "  ABOVE " (case dim ((full) "FULL") ((dim) "DIM") (else "HIDDEN"))
                                  "  TRACE " (number->string (editor-trace-at e))
                                  "  ICE " (number->string (editor-sever-at e)))
                   8 (+ top 7) 2)
        (color! C-TEXT-DIM)
        (text! "ARROWS/HJKL MOVE  SHIFT HALF  U/D LAYER  SPACE PLACE/REMOVE  TAB DIM  1/2 TRACE  3/4 ICE  ^S SAVE  ^P PLAY  ESC QUIT"
                   8 (+ top 32) 1)
        (unless (string=? (editor-message e) "")
          (draw-message g (editor-message e) top 1.0 0.0))))

    ;; x: the frame's effects from (crash fx), already advanced; bg: the
    ;; living background, already stepped, or #f; copper: when the raster
    ;; draws over the field (draw-background).
    (define (draw-session s g x bg copper)
      (let ((cleared (fx-cleared x))
            (glitch (fx-glitch x)))
        (draw-background g (if cleared (* cleared 400.0) 0.0) bg copper)
        (draw-tiles s g x)
        (when (and (eq? (session-model s) 'hint) (session-labels-shown s))
          (draw-hint-labels s g))
        (when glitch (draw-glitch g x glitch))
        (when (trace-severed? (session-trace s)) (draw-severed g x))
        (draw-hud s g x)
        (when (eq? (session-update s) 'prompt) (draw-update-prompt g))))))
