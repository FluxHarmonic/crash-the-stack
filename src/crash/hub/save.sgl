;;; (crash hub save) - A hub run as a datum, and back: CONTINUE mid-layer.
;;;
;;; Phase 2 step 5 (P5). The layer is a function of (run seed, depth,
;;; attempt), so the datum holds only what moved: the runner, the live
;;; nodes' states and attempts, the daemons' places and hunts, the keys,
;;; what is opened and taken, the dark ICE, the decoys, the bag, the
;;; credits, the trace, the beat, the ledger, the request the shell was
;;; answering, and the memory (the seen vector run-length encoded). The
;;; screen's part is its clock pin and its beat count; its tween and
;;; toasts start fresh. The store key is P4a's "run" (RUN-KEY), one
;;; datum, version 4:
;;;   (crash-run 4 (seed . S) (difficulty . EASY|NORMAL|ELITE) (depth . D) (attempt . A) (runner C F K)
;;;              (nodes (I STATE ATTEMPTS HEAT) ...) (daemons (I C F STEP ALERT HUNTING RET AWAKE) ...)
;;;              (last-seen . C|#f)
;;;              (keys ...) (opened ...) (taken ...) (dark (C . TTL) ...) (decoys (C . TTL) ...)
;;;              (inventory (TOOL . N) ...) (credits . N) (layer-credits . N) (trace . T) (beat . B)
;;;              (ledger CLEARED BEATS MOVES RECONNECTS SEVERED SEEN CREDITS)
;;;              (request . R) (seen RUN ...) (bpm . N) (beats . N))
;;; Anything else is refused (#f), never a half-read run. Rules family
;;; but for the two store verbs; no platform.

(define-library (crash hub save)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (crash store)
          (crash hub world)
          (crash hub gen)
          (crash hub rules)
          (crash hub screen))

  (export RUN-KEY hub-screen->datum datum->hub-screen hub-save! hub-load hub-clear!
          seen->runs runs->seen)

  (begin
    (define RUN-KEY "run")
    (define VERSION 4)   ; 3 (D65): the difficulty, the held nodes' heat; 4: the hunters' wake flag, the last seen cell

    ;; --- the memory, run-length encoded -----------------------------------------
    ;; (N0 N1 N2 ...): N0 unseen cells, then N1 seen, then N2 unseen, and so on.
    (define (seen->runs v)
      (let ((n (vector-length v)))
        (let loop ((i 0) (state #f) (count 0) (acc '()))
          (cond ((= i n) (reverse (cons count acc)))
                ((eq? (and (vector-ref v i) #t) state) (loop (+ i 1) state (+ count 1) acc))
                (else (loop (+ i 1) (not state) 1 (cons count acc)))))))

    (define (runs->seen runs size)
      (let ((v (make-vector size #f)))
        (let loop ((rs runs) (i 0) (state #f))
          (cond ((or (null? rs) (>= i size)) v)
                (else
                 (let ((end (min size (+ i (car rs)))))
                   (when state
                     (let fill ((k i)) (when (< k end) (vector-set! v k #t) (fill (+ k 1)))))
                   (loop (cdr rs) end (not state))))))))

    ;; --- out ------------------------------------------------------------------------

    (define (hub-screen->datum hs)
      (let* ((w (hub-screen-world hs))
             (r (world-runner w))
             (g (world-ledger w)))
        (list 'crash-run VERSION
              (cons 'seed (world-run-seed w))
              (cons 'difficulty (world-difficulty w))
              (cons 'depth (world-depth w))
              (cons 'attempt (world-attempt w))
              (list 'runner (runner-cell r) (runner-facing r) (runner-cloak r))
              (cons 'nodes (map (lambda (n) (list (node-index n) (node-state n) (node-attempts n) (node-heat n))) (world-nodes w)))
              (cons 'daemons (map (lambda (d)
                                    (list (daemon-index d) (daemon-cell d) (daemon-facing d) (daemon-step d)
                                          (daemon-alert d) (daemon-hunting d) (daemon-returning? d) (daemon-awake? d)))
                                  (world-daemons w)))
              (cons 'keys (world-keys w))
              (cons 'opened (world-opened w))
              (cons 'taken (world-taken w))
              (cons 'dark (world-dark w))
              (cons 'decoys (world-decoys w))
              (cons 'inventory (world-inventory w))
              (cons 'credits (world-credits w))
              (cons 'layer-credits (world-layer-credits w))
              (cons 'trace (world-trace w))
              (cons 'beat (world-beat w))
              (list 'ledger (ledger-cleared g) (ledger-beats g) (ledger-moves g) (ledger-reconnects g)
                    (ledger-severed-layers g) (ledger-seen g) (ledger-credits g))
              (cons 'request (world-request w))
              (cons 'last-seen (world-last-seen w))
              (cons 'seen (seen->runs (world-seen w)))
              (cons 'bpm (hub-screen-bpm-pin hs))
              (cons 'beats (hub-screen-beats hs)))))

    ;; --- in ---------------------------------------------------------------------------

    (define (nat? x) (and (integer? x) (exact? x) (>= x 0)))
    (define (field d name)
      (let ((e (assq name (cddr d)))) (and e (cdr e))))
    (define (nat-list? l) (and (list? l) (every nat? l)))
    (define (ttl-alist? l) (and (list? l) (every (lambda (e) (and (pair? e) (nat? (car e)) (integer? (cdr e)))) l)))

    ;; The screen of a datum, or #f for anything that is not one. The layer
    ;; regrows from the seed; the live parts land on it where they fit
    ;; (a node or daemon index the layer does not have is refused).
    (define (datum->hub-screen d)
      (and (pair? d) (eq? (car d) 'crash-run) (pair? (cdr d)) (eqv? (cadr d) VERSION) (list? (cddr d))
           (every pair? (cddr d))
           (let ((seed (field d 'seed))
                 (difficulty (field d 'difficulty))
                 (depth (field d 'depth))
                 (attempt (field d 'attempt))
                 (r (field d 'runner))
                 (nodes (field d 'nodes))
                 (daemons (field d 'daemons))
                 (keys (field d 'keys))
                 (opened (field d 'opened))
                 (taken (field d 'taken))
                 (dark (field d 'dark))
                 (decoys (field d 'decoys))
                 (inventory (field d 'inventory))
                 (credits (field d 'credits))
                 (layer-credits (field d 'layer-credits))
                 (trace (field d 'trace))
                 (beat (field d 'beat))
                 (g (field d 'ledger))
                 (request (field d 'request))
                 (last-seen (field d 'last-seen))
                 (seen (field d 'seen))
                 (bpm (field d 'bpm))
                 (beats (field d 'beats)))
             (and (nat? seed) (>= seed 1)
                  (difficulty? difficulty)
                  (nat? depth) (>= depth 1) (<= depth (layer-count))
                  (nat? attempt)
                  (list? r) (= (length r) 3) (nat? (car r)) (direction? (cadr r)) (nat? (caddr r))
                  (list? nodes) (every list? nodes) (list? daemons) (every list? daemons)   ; assv and length below want proper lists
                  (list? keys) (every (lambda (k) (memq k KEY-COLORS)) keys)
                  (nat-list? opened) (nat-list? taken) (ttl-alist? dark) (ttl-alist? decoys)
                  (list? inventory) (every (lambda (e) (and (pair? e) (tool-known? (car e)) (nat? (cdr e)))) inventory)
                  (nat? credits) (nat? layer-credits) (nat? trace) (nat? beat)
                  (list? g) (= (length g) 7) (every nat? g)
                  (or (not request) (memq request (list 'launch 'market 'descend 'severed 'done)))
                  (or (not last-seen) (nat? last-seen))
                  (nat-list? seen)
                  (or (not bpm) (and (number? bpm) (> bpm 0)))
                  (nat? beats)
                  (let* ((w0 (hub-with-layer (world run-seed: seed difficulty: difficulty) (generate-layer seed depth attempt) depth attempt))
                         (l (world-layer w0))
                         (size (layer-size l))
                         (live-nodes (map (lambda (n)
                                            (let ((e (assv (node-index n) nodes)))
                                              (if (and e (= (length e) 4) (memq (cadr e) (list 'sealed 'cleared 'alerted 'held)) (nat? (caddr e))
                                                       (number? (cadddr e)) (>= (cadddr e) 0) (<= (cadddr e) 1))
                                                  (node n state: (cadr e) attempts: (caddr e) heat: (cadddr e))
                                                  n)))
                                          (world-nodes w0)))
                         (live-daemons (map (lambda (dm)
                                              (let ((e (assv (daemon-index dm) daemons)))
                                                (if (and e (= (length e) 8) (nat? (cadr e)) (< (cadr e) size) (direction? (caddr e))
                                                         (nat? (cadddr e)) (< (cadddr e) (vector-length (daemon-route dm))))
                                                    (daemon dm cell: (cadr e) facing: (caddr e) step: (cadddr e)
                                                            alert: (let ((a (list-ref e 4))) (and (pair? a) (nat? (car a)) (< (car a) size) (integer? (cdr a)) a))
                                                            hunting: (let ((h (list-ref e 5))) (and (memq h (list 'runner 'decoy 'node)) h))
                                                            returning?: (and (list-ref e 6) #t)
                                                            awake?: (and (list-ref e 7) #t))
                                                    dm)))
                                            (world-daemons w0))))
                    (and (< (car r) size)
                         (or (not last-seen) (< last-seen size))
                         (cell-walkable? (layer-cell l (car r)))
                         (every (lambda (c) (< c size)) opened)
                         (every (lambda (c) (< c size)) taken)
                         (let ((w (world w0
                                         runner: (runner cell: (car r) facing: (cadr r) cloak: (caddr r))
                                         nodes: live-nodes
                                         daemons: live-daemons
                                         keys: keys
                                         opened: opened
                                         taken: taken
                                         dark: dark
                                         decoys: decoys
                                         inventory: inventory
                                         credits: credits
                                         layer-credits: layer-credits
                                         trace: trace
                                         beat: beat
                                         ledger: (ledger cleared: (car g) beats: (cadr g) moves: (caddr g) reconnects: (cadddr g)
                                                         severed-layers: (list-ref g 4) seen: (list-ref g 5) credits: (list-ref g 6))
                                         request: request
                                         last-seen: last-seen
                                         seen: (runs->seen seen size)
                                         done?: (eq? request 'done))))
                           (hub-screen-with-bpm (hub-screen world: w prev: w beats: beats
                                                            panel: (cond ((eq? request 'severed) 'severed)
                                                                         ((eq? request 'done) 'done)
                                                                         (else #f))
                                                            ;; a board up: the screen holds on its request as it did (else a
                                                            ;; beat would pass and re-raise it: the shells read the screen's)
                                                            request: (and (eq? request 'launch) 'launch))
                                                bpm))))))))

    ;; --- the store -------------------------------------------------------------------

    (define (hub-load)
      (datum->hub-screen (store-read-datum RUN-KEY)))

    (define (hub-save! hs)
      (store-write-datum! RUN-KEY (hub-screen->datum hs)))

    (define (hub-clear!)
      (store-remove! RUN-KEY))))
