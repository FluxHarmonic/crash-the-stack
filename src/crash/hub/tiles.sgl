;;; (crash hub tiles) - the hub's tile sheet, GENERATED by scripts/art/hub-tiles
;;; from assets/hub/tiles.txt; edit the text, not this file. TILE-RAMP names the
;;; eight palette roles a cell's digit stands for; each tile is sixteen
;;; rows of sixteen cells, . transparent, 1..8 a ramp entry.

(define-library (crash hub tiles)
