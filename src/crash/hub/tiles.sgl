    ;; The tile's index by name, or #f.
    (define (tile-index name)
      (let loop ((i 0))
        (cond ((= i (vector-length TILE-NAMES)) #f)
              ((string=? (vector-ref TILE-NAMES i) name) i)
              (else (loop (+ i 1))))))

    ;; The sixteen rows of a tile by name, or #f.
    (define (tile-rows name)
      (let ((i (tile-index name)))
        (and i (vector-ref TILES i))))))
