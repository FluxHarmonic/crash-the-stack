;;; (crash audio) - The sound, through streaming sinks on both targets.
;;;
;;; (sigil audio sink) is the one door the two targets share: sokol's
;;; ring natively, the WebAudio bridge on the web (an AudioWorklet when
;;; the page is cross-origin isolated, a ScriptProcessorNode otherwise;
;;; [[topics/sigil-wasm-audio-bridge]]). The cues of (crash synth) are
;;; rendered once at the context's rate into a bank, and each frame the
;;; mixer fills the cues' sink with every voice still playing, stereo,
;;; up to TARGET-DEPTH frames ahead of the output: that depth is both the
;;; latency a cue lands within (128 ms at 48 kHz, plus the device's own)
;;; and the stall a frame may take before the output runs dry (P3c),
;;; and the sink's ring (BUFFER-FRAMES) is the headroom for a frame that
;;; runs long, not the latency. A pump that always filled the ring put
;;; every cue 170..190 ms after its tap (the slices 5-7 review). The
;;; music is a SOURCE (M1, D59: motif's player, (crash music live); P3b's
;;; tracker plays its tune the same way) on a sink of its own, deeper
;;; (SOURCE-DEPTH), pumped here too. The OGG tracks of P4 (D50) and the
;;; ambient cache of P3c left with M1: nothing decoded ships.
;;;
;;; The context opens at boot on both targets and must be RESUMED from a
;;; user gesture on the web (the autoplay policy): the shell calls
;;; audio-resume! on the first tap. Every entry point is safe without a
;;; context (the sink missing, the device absent under Kiln): the game
;;; plays silent. The cues' mixer (mix-cues-into, add-voices!) is pure
;;; over a buffer, so the gate can hold it headless.

(define-library (crash audio)
  (import (sigil math)
          (sigil time)
          (sigil audio sink)
          (crash synth))

  (export audio-open! audio-resume! audio-cue! audio-pump!
          audio-render-next! audio-bank-complete?
          audio-open? audio-stream audio-rate audio-muted? audio-set-muted!
          audio-volume audio-set-volume! audio-music? audio-set-music! audio-sfx? audio-set-sfx!
          audio-set-depth! audio-depth
          audio-voices audio-underruns audio-preroll! audio-stall-begin! audio-stall-end! audio-known-starved audio-known-stalls audio-cue-at
          mix-cues-into add-voices!
          audio-set-source! audio-source? audio-source-depth audio-source-underruns audio-source-pump!
          SOURCE-DEPTH SOURCE-BUFFER SOURCE-PUSH-MAX
          audio-state
          CUE-GAIN PUSH-MAX TARGET-DEPTH BUFFER-FRAMES)

  (begin
    (define CUE-GAIN 1.0)
    (define PUSH-MAX 4096)         ; frames per pump at most (85 ms at 48 kHz)
    (define BUFFER-FRAMES 16384)   ; the sink's ring: 341 ms at 48 kHz, the stall headroom (8192 before 2026-09-22)
    ;; TARGET-DEPTH is two things at once: the latency a cue lands within,
    ;; and the stall a frame may take before the output runs dry. At 3072
    ;; (64 ms at 48 kHz) any frame past ~64 ms underran; David heard the
    ;; tap hitch on his phone (2026-09-19, 5f26a45). 6144 rides a 100 ms
    ;; hitch on top of a 30 fps frame at 128 ms of cue latency (139 at
    ;; 44.1 kHz), plus the device's own; ?adepth=N on the web and
    ;; --audio-depth N natively set it for a comparison. 12288 (256 ms at
    ;; 48 kHz) since 2026-09-22 (David's ruling): with the worklet draining
    ;; off the main thread, a tap's frame (its draw and the cue) still ran
    ;; a 128 ms ring dry on his phone in bursts of 1-4k frames; 256 ms of
    ;; cue latency was judged acceptable, the effects still immediate.
    (define TARGET-DEPTH 12288)
    (define *target-depth* TARGET-DEPTH)

    ;; --- state ---------------------------------------------------------------
    (define *ctx* #f)
    (define *stream* #f)
    (define *rate* 44100)
    (define *bank* '())            ; ((cue . float-buffer) ...) at *rate*
    (define *voices* '())          ; ((buffer . position) ...), playing
    (define *muted* #f)
    (define *volume* 1.0)          ; the master, 0..1: folded into the gains (the settings' VOLUME row)
    (define *music-on* #t)         ; the ambient (MUSIC): off keeps its position, silent
    (define *sfx-on* #t)           ; the cues (SFX)
    (define *out* #f)              ; the stereo f32 push buffer, PUSH-MAX frames
    ;; The source's stream (P3b: the tracker's tune; M1: the live soundtrack):
    ;; a procedure (out byte-offset n) -> #t that fills n stereo f32 frames;
    ;; #f from it ends the source. The source renders into a SINK OF ITS OWN
    ;; (M1, D59): SOURCE-DEPTH ahead on a SOURCE-BUFFER ring, deeper than the
    ;; cues' stream, so a frame that stalls (a GC pause of 138 ms and 118 ms
    ;; p95 frames on David's phone, 2026-09-21: DRY 106496 on the shared
    ;; ring) does not run the music dry, while the cues keep their 128 ms
    ;; latency on the main stream. The gain is the sink's own volume (an
    ;; atomic the worklet reads at output time, so a fade is heard at once),
    ;; not a loop over the samples. A refill after a stall is capped at
    ;; SOURCE-PUSH-MAX frames per pump, so the catch-up spreads over a few
    ;; frames instead of one long one. Additive: nothing else in the mixer
    ;; changes when no source is set. The stream opens with the source and
    ;; closes with it (an idle sink counts starved frames).
    (define SOURCE-BUFFER 32768)   ; the ring: 683 ms at 48 kHz
    (define SOURCE-DEPTH 16384)    ; kept ahead: 341 ms at 48 kHz (743 at 22050)
    (define SOURCE-PUSH-MAX 4096)  ; frames per pump at most: ~4 ms of synth at 1 ms per 1024
    (define *source* #f)
    (define *source-gain* 0.0)
    (define *src* #f)              ; the source's buffer, SOURCE-PUSH-MAX frames
    (define *src-stream* #f)       ; the source's sink, open while a source is set
    (define *src-underruns* 0)     ; the starved frames of closed source sinks (the count carries over)

    (define (audio-open?) (and *stream* #t))
    ;; The frames kept ahead of the output: TARGET-DEPTH unless set; a
    ;; value past the ring's headroom is held under BUFFER-FRAMES - 1024.
    (define (audio-depth) *target-depth*)
    (define (audio-set-depth! frames)
      (set! *target-depth* (max 1024 (min (- BUFFER-FRAMES 1024) frames))))
    ;; The context's state: running | suspended | closed, or #f without one.
    (define (audio-state)
      (and *ctx*
           (guard (e (#t #f))
             (audio-context-state *ctx*))))
    (define (audio-stream) *stream*)
    (define (audio-set-source! proc gain)
      (set! *source* proc)
      (set! *source-gain* gain)
      (cond ((and proc (not *src-stream*) *ctx* (not *muted*))
             (set! *src* (or *src* (make-bytevector (* 8 SOURCE-PUSH-MAX) 0)))
             (set! *src-stream* (guard (e (#t #f)) (open-audio-stream channels: 2 buffer-frames: SOURCE-BUFFER)))
             (when *src-stream* (set-audio-stream-volume! *src-stream* (max 0.0 (min 1.0 gain)))))
            ((and proc *src-stream*)
             (set-audio-stream-volume! *src-stream* (max 0.0 (min 1.0 gain))))
            ((and (not proc) *src-stream*)
             (close-source-stream!))))
    (define (close-source-stream!)
      (when *src-stream*
        (set! *src-underruns* (+ *src-underruns* (audio-stream-underruns *src-stream*)))
        (close-audio-stream! *src-stream*)
        (set! *src-stream* #f)))
    (define (audio-source?) (and *source* #t))
    ;; The frames between the source's render position and the device: what
    ;; its sink still holds. A clock over the source subtracts it.
    (define (audio-source-depth) (if *src-stream* (audio-stream-depth *src-stream*) 0))
    ;; The source sink's cumulative starved frames (the music ran dry).
    (define (audio-source-underruns) (+ *src-underruns* (if *src-stream* (audio-stream-underruns *src-stream*) 0)))
    ;; The source's pump: toward SOURCE-DEPTH, at most SOURCE-PUSH-MAX frames
    ;; per pump, or SOURCE-PUSH-RAMP while the sink holds under SOURCE-RAMP-BELOW
    ;; (a fresh sink, or one that ran dry): the fill then spreads over
    ;; pumps of ~43 ms of audio each instead of four of 85 ms in the first
    ;; frames (David's phone, 2026-09-21: "hangs for half a second right
    ;; when it starts"); at 2048 frames per 12 ms timer tick the sink still
    ;; gains on real time. #f from the source ends it and closes its sink.
    ;; Answers the frames pushed.
    (define SOURCE-PUSH-RAMP 2048)   ; 43 ms of audio a pump: 1024 starved 768-1536 frames at the start on a loaded box (the timer's jitter past 21 ms)
    (define SOURCE-RAMP-BELOW 4096)
    (define (audio-source-pump!) (pump-source!))
    (define (pump-source!)
      (if (and *source* *src-stream*)
          (let* ((depth (audio-stream-depth *src-stream*))
                 (n (min (if (< depth SOURCE-RAMP-BELOW) SOURCE-PUSH-RAMP SOURCE-PUSH-MAX)
                         (audio-stream-room *src-stream*)
                         (- SOURCE-DEPTH depth))))
            (cond ((<= n 0) 0)
                  ((*source* *src* 0 n) (push-audio-samples *src-stream* *src* n))
                  (else (set! *source* #f) (close-source-stream!) 0)))
          0))
    (define (audio-rate) *rate*)
    (define (audio-muted?) *muted*)
    (define (audio-set-muted! m) (set! *muted* m))
    (define (audio-volume) *volume*)
    (define (audio-music?) *music-on*)
    (define (audio-set-music! on?) (set! *music-on* (and on? #t)))
    (define (audio-sfx?) *sfx-on*)
    (define (audio-set-sfx! on?) (set! *sfx-on* (and on? #t)))
    ;; The master volume, 0..1: the cues take it as they are added (the bank
    ;; stays); the music takes it on its own gain ((crash shell) apply-audio-settings!).
    (define (audio-set-volume! v)
      (set! *volume* (max 0.0 (min 1.0 (* 1.0 v)))))
    (define (audio-voices) *voices*)
    ;; The sink's cumulative starved frames (the output ran dry): the
    ;; measure of a stall the pump did not ride out.
    (define (audio-underruns) (if *stream* (audio-stream-underruns *stream*) 0))

    ;; A known stall (a tune's parse and open on the main thread: a tune
    ;; landing): the caller pre-rolls the cues' sink to the ring's full
    ;; capacity first (audio-preroll!: the stall headroom beyond the target
    ;; depth), and brackets the stall so the frames it still starved are
    ;; counted apart (audio-known-starved, and how many stalls): the readout
    ;; then says what was a known event and what was the game's frames.
    (define *known-starved* 0)
    (define *known-stalls* 0)
    (define *stall-mark* #f)
    (define (audio-preroll!)
      (when *stream*
        (let loop ((guard 0))
          (let ((n (min PUSH-MAX (audio-stream-room *stream*))))
            (when (and (> n 0) (< guard 8))
              (set! *voices* (mix-cues-into *out* n *voices*))
              (push-audio-samples *stream* *out* n)
              (loop (+ guard 1)))))))
    (define (audio-stall-begin!)
      (audio-preroll!)
      (set! *stall-mark* (audio-underruns)))
    (define (audio-stall-end!)
      (when *stall-mark*
        (set! *known-starved* (+ *known-starved* (- (audio-underruns) *stall-mark*)))
        (set! *known-stalls* (+ *known-stalls* 1))
        (set! *stall-mark* #f)))
    (define (audio-known-starved) *known-starved*)
    (define (audio-known-stalls) *known-stalls*)
    ;; When the last cue started, ms (the ladder leaves a tap's frame out)
    (define *cue-at* #f)
    (define (audio-cue-at) *cue-at*)

    ;; Open the context and the stream, render the cues the title needs
    ;; first (FIRST-CUES: the reveal's beeps and the gate's dial, short
    ;; ones); the rest of the bank one cue per call to audio-render-next!
    ;; (a boot step, P3d): rendering all nine at once took the second
    ;; frame of a boot to 983 ms on the web (measured 2026-09-19, under
    ;; the reveal's first cells: David's "extremely glitchy at startup").
    ;; #t when sound is possible, #f when it is not (no device, no
    ;; bridge): the game is then silent and nothing else changes.
    (define FIRST-CUES '(modem select match dial card))

    (define (audio-open!)
      (guard (e (#t (set! *stream* #f) #f))
        (let ((ctx (audio-context-open)))
          (set! *ctx* ctx)
          (when ctx
            (set! *rate* (audio-context-sample-rate ctx))

            (set! *stream* (open-audio-stream channels: 2 buffer-frames: BUFFER-FRAMES))
            (set! *out* (make-bytevector (* 8 PUSH-MAX) 0))
            (set! *bank* (map (lambda (name) (cons name (render-cue name *rate*))) FIRST-CUES)))
          (audio-open?))))

    ;; Render one more cue of the bank; #t once every cue is rendered.
    (define (audio-render-next!)
      (if (not *ctx*)
          #t
          (let ((missing (filter (lambda (name) (not (assq name *bank*))) CUES)))
            (if (null? missing)
                #t
                (begin
                  (set! *bank* (cons (cons (car missing) (render-cue (car missing) *rate*)) *bank*))
                  (null? (cdr missing)))))))

    (define (audio-bank-complete?)
      (or (not *ctx*) (every (lambda (name) (assq name *bank*)) CUES)))

    ;; From a user gesture (the web's autoplay policy; a no-op natively).
    (define (audio-resume!)
      (when *ctx*
        (guard (e (#t #f))
          (audio-context-resume *ctx*))))

    ;; Start a cue now (queued into the next pump).
    ;; A cue not yet in the bank (a ?stack boot's first frames, while the
    ;; boot step is still rendering) is rendered on the spot: one stall of
    ;; its own length, once.
    (define (audio-cue! name)
      (when (and *ctx* (memq name CUES) (not (assq name *bank*)))
        (set! *bank* (cons (cons name (render-cue name *rate*)) *bank*)))
      (let ((entry (assq name *bank*)))
        (when (and entry (not *muted*) *sfx-on*)
          (set! *cue-at* (current-milliseconds))
          (set! *voices* (cons (cons (cdr entry) 0) *voices*)))))

    ;; The voices over n frames of out (added, clamped), each advanced by
    ;; n; finished ones leave. Answers the voices left.
    (define (add-voices! out n voices)
      (let loop ((vs voices) (kept '()))
        (if (null? vs)
            kept
            (let* ((cue (car (car vs)))
                   (at (cdr (car vs)))
                   (len (cue-frames cue))
                   (take (min n (- len at))))
              (let add ((i 0))
                (when (< i take)
                  (let* ((o (* 8 i))
                         (v (max -1.0 (min 1.0 (+ (bytevector-ieee-single-ref out o 'little)
                                                   (* CUE-GAIN *volume* (cue-ref cue (+ at i))))))))
                    (bytevector-ieee-single-set! out o v 'little)
                    (bytevector-ieee-single-set! out (+ o 4) v 'little))
                  (add (+ i 1))))
              (loop (cdr vs)
                    (if (>= (+ at n) len) kept (cons (cons cue (+ at n)) kept)))))))

    ;; The cues' mix of n frames into out: silence, then the voices.
    ;; Answers the voices left. (P3c's ambient cache and P4's OGG track
    ;; players lived here until M1 put the music on motif's player, on a
    ;; sink of its own: this sink carries the cues alone.)
    (define ZERO (make-bytevector (* 8 PUSH-MAX) 0))
    (define (mix-cues-into out n voices)
      (bytevector-copy! out 0 ZERO 0 (* 8 n))
      (if (null? voices) voices (add-voices! out n voices)))

    ;; Once a frame (twice on the web: the tick and the page's own timer, M1):
    ;; top the sink up to TARGET-DEPTH frames ahead of the
    ;; output, PUSH-MAX at most. Answers the frames pushed (0 when there is
    ;; no stream, or the depth is already there).
    ;; Both sinks: the main stream (cues, the OGG ambient) toward its depth,
    ;; then the source's own (pump-source!). Answers the main stream's push.
    (define (audio-pump!)
      (if (not *stream*)
          0
          (let ((n (min PUSH-MAX
                        (audio-stream-room *stream*)
                        (- *target-depth* (audio-stream-depth *stream*)))))
            (pump-source!)
            (if (<= n 0)
                0
                (begin
                  (set! *voices* (mix-cues-into *out* n *voices*))
                  (push-audio-samples *stream* *out* n))))))
    ))
