;;; Outcome order for every table's shared end panel. Rows may carry labels.
(define-library (crash panel end)
  (import (sigil list))
  (export end-panel-actions)
  (begin
    (define (end-panel-actions won? new restart rest)
      (append (filter (lambda (row) row)
                      (if won? (list new restart) (list restart new)))
              rest))))
