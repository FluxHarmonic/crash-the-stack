;;; (crash main) - The entry, and the one seam between the two targets.
;;;
;;; Native builds run (crash shell native): a sigil-app window. Web builds run
;;; (crash shell web): one frame per requestAnimationFrame, fed by the browser's
;;; events. The choice is a cond-expand on the import; the two defines below
;;; are plain top-level defines whose bodies cond-expand, because a define
;;; nested inside cond-expand is not registered under native codegen
;;; (investigations/sigil-native-codegen-cond-expand-define-gap).
;;;
;;; sigil-web-dispatch-event is what the generic browser loader calls for
;;; every DOM event and every animation frame; the wasm runtime resolves it
;;; on the package's entry module, which is why it must live here and not in
;;; (crash shell web). On native it is never called.

(define-library (crash main)
  (cond-expand
    (wasm (import (crash shell web)))
    (else (import (crash shell native))))

  (export main sigil-web-dispatch-event)

  (begin
    (define (main . args)
      (cond-expand
        (wasm (web-main))
        (else (apply native-main args))))

    (define (sigil-web-dispatch-event type payload)
      (cond-expand
        (wasm (web-dispatch type payload))
        (else 0)))))
