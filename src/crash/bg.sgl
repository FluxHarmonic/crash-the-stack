;;; (crash bg) - The living background: a dithered field of color behind
;;; the board, every cell always lit, the colors flowing between cells.
;;;
;;; David, 2026-09-17: "pixellated color patches move around, merging and
;;; splitting, almost like a lava lamp effect", with a genetic-algorithm
;;; flavor; and on seeing the first cut (2026-09-18): not discrete disks
;;; on a background but "a continuous surface that has shifting color
;;; areas ... almost like there's a grid of cells and the color is moving
;;; between them like a genetic algorithm or game of life", dithered, and
;;; more colorful than one purple ramp. So: a coarse grid of CELL px
;;; cells over the board area; every cell holds a value in [0, 1) and
;;; the renderer maps it onto a ramp of RAMP palette tones with a 2x2
;;; ordered dither between neighboring tones (four levels per step, so
;;; the surface reads as continuous at 8 px). The rule table,
;;; RULES, holds the CPU reference for REACTION and the STILL rule (a
;;; seeded gradient that never steps, the BACKGROUND setting's calm
;;; choice); GPU-MODES names the six shader-only rules in (crash gpu
;;; rules) that join REACTION in the LIVE pool (BG1, 2026-09-21). The
;;; voter model LIFE, the first cut's rule, left on 2026-09-21.
;;;
;;;   reaction  Gray-Scott reaction-diffusion (two substances per cell, a
;;;             nine-point laplacian, feed and kill rates in the regime
;;;             that grows soft coral fronts) stepped a few times a field
;;;             step, fed every step: REACT-RAIN cells seeded and, every
;;;             other step, one patch cleared, so the fronts keep growing
;;;             and dissolving instead of settling; the value is the
;;;             second substance. (The first cut used the bare four-point
;;;             laplacian at unit diffusion, which is numerically unstable
;;;             at this step: the field flickered as a checkerboard.)
;;;
;;; Phase-driven: calm in TRACE, restless under the ICE (more cells, more
;;; steps), a burst when a counter-hack fires, a collapse once severed
;;; (every value decays toward the ground).
;;;
;;; Two implementations of one rule (P3c, ruling D35). The field's home
;;; is the GPU: (crash gpu bg) runs the field rules as fragment
;;; shaders over a pair of render targets, one step per pass, and the
;;; cell state never touches the CPU. This module is the rule's
;;; definition and the oracle: the CPU field (`?bg=reaction-cpu`, the
;;; fallback) and the GPU field must agree cell for cell after any
;;; number of steps from one seed, and the browser arm holds them to it.
;;; So every rule here is a function each cell can compute alone from the
;;; previous state: no stream of random visits (a shader cannot replay a
;;; sequence), but a hash of (step key, cell) per cell, and the step's own
;;; random choices (the rain and the kill patch of the reaction) drawn
;;; from the key on the CPU and handed to the shader as uniforms. The
;;; REACTION state is stored as two quantities quantized to 1/65535
;;; after every iteration (the 16-bit packing of the RGBA8 target; 8 bits
;;; freeze Gray-Scott). The hash is lowbias32's shape on 31-bit words
;;; with 22-bit multipliers, so no value passes 2^31 and no product
;;; 2^53: the wasm build's small integers are 32-bit signed, and its
;;; doubles are where a product lives.
;;;
;;; Everything is a pure function of the seed, and the arithmetic is the
;;; same on both targets (the determinism leg holds two runs of one seed
;;; to one trajectory). Drawing is (crash render)'s: bg-runs answers
;;; rectangles quantized to the half-cell grid, run-merged along each
;;; row and grouped by tone. Rules family: no platform, no drawing.
;;;
;;; The phone's budget (David, 2026-09-19: "it's killing the CPU on the
;;; phone"): the field steps once every STRIDE ticks (the rule's work
;;; scaled so the motion is the same), the runs are built at that step
;;; and held in the struct until the next, and the runs come grouped by
;;; tone so the renderer sets a color RAMP times a frame. The reaction's
;;; iterations under the ICE are capped (REACT-STEPS-MAX). A GPU field
;;; (gpu?: #t) keeps the schedule here (ticks, steps, phase, burst,
;;; hold) and does none of the cell work: its bg-step is bookkeeping.

(define-library (crash bg)
  (import (sigil struct)
          (sigil list)
          (sigil math)
          (crash stack prng))

  (export bg bg? bg-new bg-tick bg-field bg-sub bg-seed bg-ticks bg-steps bg-mode bg-gpu? bg-hold bg-stride bg-react-steps bg-iterations bg-iterations-at bg-step-agit bg-pending
          bg-agitation bg-burst bg-severed
          bg-with-phase bg-with-burst bg-with-hold bg-step bg-runs bg-canonical bg-dominant bg-mean
          bg-held? bg-agit bg-step-key bg-rain bg-kill bg-shown-value
          bg-cell-tones
          still-params STILL-OFFSET STILL-BAND-MAX STILL-TONES
          hash31 mul31 add31
          CELL GRID-W GRID-H CELLS RAMP MODES GPU-MODES RULES STRIDE
          DOMINANT-CAP
          FIELD-COLLAPSE
          REACT-STEPS REACT-STEPS-MAX REACT-FEED REACT-KILL REACT-DA REACT-DB REACT-DT
          REACT-RAIN REACT-SEED REACT-KILL-EVERY REACT-SHOWN-SCALE REACT-SHOWN-MAX
          AGITATION-TRACE AGITATION-ICE AGITATION-BURST AGITATION-SEVERED
          BURST-TICKS)

  (begin
    ;; --- the numbers David tunes -----------------------------------------------

    (define CELL 16)             ; px per cell; the dither works in half cells
    (define GRID-W 40)           ; cells across at 640 wide
    (define GRID-H 22)           ; cells down over the 352 px board area
    (define RAMP 8)              ; palette tones in the ramp (crash render maps them)
    (define STRIDE 3)            ; ticks between steps of the field (the phone's budget)
    (define DOMINANT-CAP 0.9)    ; no tone may hold more of the half cells than this: a flat field is dead
    (define FIELD-COLLAPSE 0.985) ; per step once severed, every value
    (define REACT-STEPS 2)       ; Gray-Scott iterations per field step at agitation 1
    (define REACT-STEPS-MAX 4)   ; and never more than this under the ICE
    (define REACT-FEED 0.046)    ; the regime measured 2026-09-19: fronts cover 25..50 % and keep moving
    (define REACT-KILL 0.063)
    (define REACT-DA 1.0)
    (define REACT-DB 0.5)
    (define REACT-DT 1.0)
    (define REACT-RAIN 4)        ; cells seeded with the second substance every field step (raised to REACT-SEED)
    (define REACT-SEED 0.5)
    (define REACT-KILL-EVERY 2)  ; field steps between cleared 3x3 patches
    (define REACT-SPOTS 12)      ; 3x3 spots of the second substance at the start
    (define REACT-SHOWN-SCALE 2.2) ; the reaction's values are small (b peaks near 0.4): shown = min(MAX, SCALE * b)
    (define REACT-SHOWN-MAX 0.85)  ; short of the ring's wrap, so a peak is the brightest tone and never the ground
    (define AGITATION-TRACE 1.0)
    (define AGITATION-ICE 2.5)
    (define AGITATION-BURST 6.0)
    (define AGITATION-SEVERED 0.0)
    (define BURST-TICKS 30)

    (define CELLS (* GRID-W GRID-H))
    (define Q16 65535.0)         ; the reaction's quantum: 1/65535

    ;; --- 31-bit words ---------------------------------------------------------------

    ;; The hash works on words under 2^31 and every product stays under
    ;; 2^53: the wasm build's small integers are 32-bit signed (measured
    ;; 2026-09-19: a modulo 2^32 residue of 3040987859 came back as
    ;; -1253979437), so a 32-bit word would wrap negative there and the
    ;; CPU field on the phone would leave the oracle. The GPU masks the
    ;; same way (& 0x7fffffff after each multiply).

    (define TWO31 2147483648)

    (define (add31 a b) (modulo (+ a b) TWO31))

    ;; (a * b) mod 2^31 for a < 2^31 and b < 2^22: the product is exact.
    (define (mul31 a b) (modulo (* a b) TWO31))

    (define (xorshr x n) (bitwise-xor x (arithmetic-shift x (- n))))

    ;; lowbias32's shape (xorshift, multiply, three rounds) on 31-bit
    ;; words with 22-bit odd multipliers: not a bijection, well mixed
    ;; enough for a field. The same three rounds in GLSL, on uint.
    (define (hash31 x)
      (let* ((x (xorshr x 16))
             (x (mul31 x 2921079))    ; 0x2c9277
             (x (xorshr x 15))
             (x (mul31 x 3837701))    ; 0x3a8f05
             (x (xorshr x 16)))
        x))

    ;; --- state ---------------------------------------------------------------------

    ;; field: the value per cell, row-major: the second substance for
    ;; REACTION or a GPU rule's seed; sub: REACTION's first substance.
    ;; steps: field steps taken (the rule's clock,
    ;; and the GPU field's target). hold: a step count the field stops at,
    ;; or #f (the arm's door). gpu?: the cell work is the GPU's; this
    ;; struct keeps the schedule only, and the field holds the seed the
    ;; GPU draws once.
    (define-struct bg
      (mode default: 'reaction)          ; the game's default rule (David, 2026-09-20)
      (gpu? default: #f)
      (field default: (vector))
      (sub default: (vector))
      (seed default: 1)
      (ticks default: 0)
      (steps default: 0)
      (hold default: #f)
      (stride default: STRIDE)         ; ticks between field steps (the tunable behind ?bgstride=)
      (react-steps default: REACT-STEPS) ; Gray-Scott iterations per field step at agitation 1 (?rsteps=)
      (pending default: '())          ; a GPU field: (agit . severed?) of the last PENDING-MAX steps scheduled, oldest first
      (agitation default: AGITATION-TRACE)
      (burst default: 0)
      (severed default: #f)
      (runs-held default: '()))     ; the rectangles of the field as last stepped, grouped by tone

    ;; The share of half cells in the most common tone, from the runs.
    (define (bg-dominant b)
      (let ((counts (make-vector RAMP 0))
            (half (quotient CELL 2)))
        (for-each (lambda (r)
                    (vector-set! counts (car r) (+ (vector-ref counts (car r)) (quotient (cadddr r) half))))
                  (bg-runs b))
        (/ (apply max (vector->list counts)) (* 4.0 CELLS))))

    ;; The mean shown value.
    (define (bg-mean b)
      (let loop ((i 0) (sum 0.0))
        (if (= i CELLS) (/ sum CELLS) (loop (+ i 1) (+ sum (bg-shown-value b (vector-ref (bg-field b) i)))))))

    (define (draw-unit rng)
      (let ((rng (prng-next rng)))
        (cons (/ (prng-index rng 1000000) 1000000.0) rng)))

    ;; A field seeded by the stream, through the rule's own seeder:
    ;; REACTION starts from a full first substance with REACT-SPOTS spots
    ;; of the second; STILL from the seed itself (its parameters); a GPU
    ;; rule from its own seed vector. The CPU runs are built once here
    ;; and then at every step. rest: the mode, then gpu?.
    (define (bg-new seed . rest)
      (let* ((mode (if (and (pair? rest)
                            (memq (car rest) (append MODES GPU-MODES)))
                       (car rest)
                       'reaction))
             (gpu? (or (and (memq mode GPU-MODES) #t)
                       (and (pair? rest) (pair? (cdr rest)) (cadr rest))))
             (b (if (memq mode GPU-MODES)
                    (seed-gpu mode (prng-seed seed))
                    ((rule-seed (rule-ref mode)) mode (prng-seed seed) seed)))   ; the stream, and the seed itself (the still rule's parameters)
             (b (bg b seed: seed gpu?: gpu?)))
        (if gpu? b (bg b runs-held: (build-runs b)))))

    ;; GPU-only additions keep MODES/RULES as the CPU oracle's table.
    ;; Their seed vectors are drawn once by (crash gpu bg). Cyclic starts
    ;; with independent phases; flow starts with smooth scalar islands.
    ;; Signal starts with a few falling heads before its seeded lanes fill.
    (define GPU-MODES
      (list 'cyclic
            'flow
            'signal
            'echo
            'synapse
            'flame))

    (define (seed-gpu mode rng)
      (let ((field (make-vector CELLS 0)))
        (let loop ((i 0) (rng rng))
          (if (= i CELLS)
              (bg mode: mode
                  field: (if (eq? mode 'flow) (smooth (smooth field)) field))
              (let ((u (draw-unit rng)))
                (vector-set! field i
                             (case mode
                               ((cyclic) (exact (floor (* 16 (car u)))))
                               ((signal) (if (< (car u) 0.02) 1 0))
                               (else (car u))))
                (loop (+ i 1) (cdr u)))))))

    ;; REACT-SPOTS 3x3 spots of the second substance in a full first: the
    ;; fronts grow out of them from the first tick (a dozen left the field
    ;; blank for its first seconds; smoothed noise is too thin to take and
    ;; dies). Values quantized to the 16-bit grid, as stored.
    (define (seed-reaction mode rng . rest)
      (let ((field (make-vector CELLS 0.0))
            (sub (make-vector CELLS (q16 1.0)))
            (half (q16 REACT-SEED)))
            (let loop ((k 0) (rng rng))
              (if (= k REACT-SPOTS)
                  (bg mode: mode field: field sub: sub)
                  (let* ((u1 (draw-unit rng))
                         (u2 (draw-unit (cdr u1)))
                         (cx (exact (floor (* (car u1) GRID-W))))
                         (cy (exact (floor (* (car u2) GRID-H)))))
                    (let spot ((dy -1))
                      (when (<= dy 1)
                        (let col ((dx -1))
                          (when (<= dx 1)
                            (let ((x (modulo (+ cx dx) GRID-W))
                                  (y (modulo (+ cy dy) GRID-H)))
                              (vector-set! field (+ x (* y GRID-W)) half)
                              (vector-set! sub (+ x (* y GRID-W)) half))
                            (col (+ dx 1))))
                        (spot (+ dy 1))))
                    (loop (+ k 1) (cdr u2)))))))

    (define (at field x y)
      (vector-ref field (+ (modulo x GRID-W) (* (modulo y GRID-H) GRID-W))))

    ;; A box blur over the four neighbors and the cell (FLOW's seed:
    ;; smooth scalar islands; master dropped it with LIFE, Codex kept it).
    (define (smooth field)
      (let ((out (make-vector CELLS 0.0)))
        (let loop ((i 0))
          (when (< i CELLS)
            (let ((x (modulo i GRID-W)) (y (quotient i GRID-W)))
              (vector-set! out i (/ (+ (at field x y) (at field (- x 1) y) (at field (+ x 1) y)
                                       (at field x (- y 1)) (at field x (+ y 1)))
                                    5.0)))
            (loop (+ i 1))))
        out))

    ;; --- the phase machine's inputs -----------------------------------------------

    (define (bg-with-phase b phase)
      (case phase
        ((counter) (bg b agitation: AGITATION-ICE severed: #f))
        ((severed) (bg b agitation: AGITATION-SEVERED severed: #t))
        (else (bg b agitation: AGITATION-TRACE severed: #f))))

    (define (bg-with-burst b)
      (bg b burst: BURST-TICKS))

    ;; Stop stepping once `steps` field steps are done (the arm compares
    ;; the two implementations at a known step; #f runs forever).
    (define (bg-with-hold b steps)
      (bg b hold: steps))

    ;; Gray-Scott iterations this step: the struct's rate scaled by the
    ;; agitation, at least one, capped (the GPU runs the same count).
    (define PENDING-MAX 8)

    ;; The agitation and severed flag a field step ran (or will run) at:
    ;; for a GPU field, the entry `pending` keeps for step index `step`
    ;; (a slow frame drains two steps, and a burst or a phase can end
    ;; between them: the targets must run each at its own agitation, as
    ;; the CPU field did); otherwise the struct's current values.
    (define (bg-step-agit b step)
      (let* ((pending (bg-pending b))
             (first (- (bg-steps b) (length pending)))
             (i (- step first)))
        (if (and (>= i 0) (< i (length pending)))
            (list-ref pending i)
            (cons (bg-agit b) (bg-severed b)))))

    ;; Gray-Scott iterations at an agitation: the struct's rate scaled,
    ;; at least one, capped (the GPU runs the same count).
    (define (bg-iterations-at b agit)
      (min REACT-STEPS-MAX (max 1 (exact (floor (* agit (bg-react-steps b)))))))

    (define (bg-iterations b)
      (bg-iterations-at b (bg-agit b)))

    (define (bg-held? b)
      (and (bg-hold b) (>= (bg-steps b) (bg-hold b))))

    ;; The agitation this tick: a burst overrides the phase's.
    (define (bg-agit b)
      (if (> (bg-burst b) 0) AGITATION-BURST (bg-agitation b)))

    ;; --- the step's randomness -------------------------------------------------------

    ;; The key of field step T from the seed: every random choice of the
    ;; step hashes from it, on the CPU and in the shader alike.
    (define (bg-step-key seed steps)
      (hash31 (add31 (hash31 (modulo seed TWO31)) (mul31 (modulo steps TWO31) 2047323))))   ; 0x1f3d5b

    ;; The reaction's rain for a step: REACT-RAIN (x . y) cells from the key.
    (define (bg-rain key)
      (let loop ((k 0) (acc '()))
        (if (= k REACT-RAIN)
            (reverse acc)
            (let ((h (hash31 (add31 key (+ 100000 k)))))
              (loop (+ k 1) (cons (cons (modulo h GRID-W) (modulo (arithmetic-shift h -8) GRID-H)) acc))))))

    ;; The center of the patch cleared at a step, or #f on the steps between.
    (define (bg-kill key steps)
      (and (= 0 (modulo steps REACT-KILL-EVERY))
           (let ((h (hash31 (add31 key 200000))))
             (cons (modulo h GRID-W) (modulo (arithmetic-shift h -8) GRID-H)))))

    ;; --- one step: reaction -------------------------------------------------------------

    (define (clamp v) (max 0.0 (min 1.0 v)))

    ;; Onto the 16-bit grid, as the target stores it.
    (define (q16 v) (/ (floor (+ (* (clamp v) Q16) 0.5)) Q16))

    ;; The nine-point laplacian with the usual weights (0.2 on the four
    ;; sides, 0.05 on the corners, the cell itself -1), which is stable at
    ;; unit diffusion and a unit step.
    (define (laplacian f x y v)
      (- (+ (* 0.2 (+ (at f (- x 1) y) (at f (+ x 1) y) (at f x (- y 1)) (at f x (+ y 1))))
            (* 0.05 (+ (at f (- x 1) (- y 1)) (at f (+ x 1) (- y 1)) (at f (- x 1) (+ y 1)) (at f (+ x 1) (+ y 1)))))
         v))

    ;; The stream's touch on the reaction: the rain cells raised to
    ;; REACT-SEED and the kill patch (when there is one) cleared, in the
    ;; second substance. Measured 2026-09-19 over four seeds and 1200
    ;; ticks: without the rain a seed's fronts die out within two seconds
    ;; on two seeds of four and the field stays blank.
    (define (react-feed field rain kill)
      (let ((out (vector-copy field))
            (half (q16 REACT-SEED)))
        (for-each (lambda (c)
                    (let ((i (+ (car c) (* (cdr c) GRID-W))))
                      (vector-set! out i (max (vector-ref out i) half))))
                  rain)
        (when kill
          (let spot ((dy -1))
            (when (<= dy 1)
              (let col ((dx -1))
                (when (<= dx 1)
                  (vector-set! out (+ (modulo (+ (car kill) dx) GRID-W) (* (modulo (+ (cdr kill) dy) GRID-H) GRID-W)) 0.0)
                  (col (+ dx 1))))
              (spot (+ dy 1)))))
        out))

    (define (react-step a b)
      (let ((na (make-vector CELLS 0.0))
            (nb (make-vector CELLS 0.0)))
        (let loop ((i 0))
          (when (< i CELLS)
            (let* ((x (modulo i GRID-W))
                   (y (quotient i GRID-W))
                   (av (vector-ref a i))
                   (bv (vector-ref b i))
                   (la (laplacian a x y av))
                   (lb (laplacian b x y bv))
                   (abb (* av bv bv)))
              (vector-set! na i (q16 (+ av (* REACT-DT (+ (* REACT-DA la) (- abb) (* REACT-FEED (- 1.0 av)))))))
              (vector-set! nb i (q16 (+ bv (* REACT-DT (+ (* REACT-DB lb) abb (- (* (+ REACT-KILL REACT-FEED) bv))))))))
            (loop (+ i 1))))
        (cons na nb)))

    ;; --- one step -------------------------------------------------------------------------

    ;; Severed: REACTION's second substance decays on the 16-bit grid.
    (define (collapse b)
      (let* ((f (bg-field b))
             (out (make-vector CELLS 0)))
        (let loop ((i 0))
          (when (< i CELLS)
            (vector-set! out i
                         (q16 (* FIELD-COLLAPSE (vector-ref f i))))
            (loop (+ i 1))))
        (bg b field: out)))

    ;; One field step of the reaction: the feed, then REACT-STEPS Gray-
    ;; Scott iterations scaled by the agitation and capped.
    (define (step-reaction b key)
      (let ((fed (react-feed (bg-field b) (bg-rain key) (bg-kill key (bg-steps b))))
            (steps (bg-iterations b)))
        (let loop ((k 0) (a (bg-sub b)) (bb fed))
          (if (= k steps)
              (bg b field: bb sub: a)
              (let ((r (react-step a bb)))
                (loop (+ k 1) (car r) (cdr r)))))))

    ;; --- the rule table ---------------------------------------------------------------

    ;; (name seed step shown): seed builds the field from a mode and the
    ;; stream; step advances one field step from the step's key; shown
    ;; maps a cell's stored state to the value in [0, 1) the dither maps.
    ;; Built with list, not quoted (the web build's literal hazard, see
    ;; (crash menu)).
    (define (shown-reaction v) (min REACT-SHOWN-MAX (* REACT-SHOWN-SCALE v)))

    ;; --- the still background (BACKGROUND: STILL, David 2026-09-21) -----------------
    ;;
    ;; No automaton: the field is a radial gradient in the dark ramp, drawn
    ;; once at deal from the board's seed (so a share code reproduces it)
    ;; and never stepped. The parameters come from the seed's stream, all
    ;; bounded: the center (off the board by up to STILL-OFFSET of the
    ;; grid either way), the radius and its falloff, a second smaller
    ;; focus for asymmetry, a squash and a rotation (elliptical), and the
    ;; band of two or three ramp tones the dither runs between. The
    ;; values are stored so that the reaction's shown mapping (the view
    ;; shader's, and shown-reaction's) lands them in that band: v =
    ;; level / REACT-SHOWN-SCALE, level in [lo, lo + span) tones over RAMP.
    (define STILL-OFFSET 0.3)
    (define STILL-BAND-MAX 3)   ; tones in a band, two or three
    (define STILL-TONES 4)      ; the band lies in the ramp's dark first four (C-BG, C-BAR-A, C-BAR-C, C-ARCHIVE): the bars' ramp, not the moss accent
    (define (still-params seed)
      (let* ((rng (prng-seed seed))
             (u (lambda (rng) (draw-unit rng)))
             (a (u rng))
             (b (u (cdr a)))
             (c (u (cdr b)))
             (d (u (cdr c)))
             (e (u (cdr d)))
             (f (u (cdr e)))
             (g (u (cdr f)))
             (h (u (cdr g)))
             (i (u (cdr h)))
             (j (u (cdr i)))
             (cx (* GRID-W (+ (- STILL-OFFSET) (* (car a) (+ 1.0 (* 2 STILL-OFFSET))))))
             (cy (* GRID-H (+ (- STILL-OFFSET) (* (car b) (+ 1.0 (* 2 STILL-OFFSET))))))
             (radius (* GRID-W (+ 0.5 (* 0.7 (car c)))))
             (falloff (+ 1.2 (* 1.3 (car d))))
             (cx2 (* GRID-W (car e)))
             (cy2 (* GRID-H (car f)))
             (radius2 (* radius (+ 0.3 (* 0.3 (car g)))))
             (squash (+ 0.6 (* 0.8 (car h))))
             (angle (* 3.141592653589793 (car i)))
             (span (if (< (car j) 0.5) 2 3))
             (lo (modulo (exact (floor (* (car j) 2 (- STILL-TONES span)))) (- STILL-TONES span))))
        (list (cons 'center (cons cx cy))
              (cons 'radius radius)
              (cons 'falloff falloff)
              (cons 'focus (list cx2 cy2 radius2))
              (cons 'squash squash)
              (cons 'angle angle)
              (cons 'band (cons lo span)))))

    (define (still-param ps key) (cdr (assq key ps)))

    ;; The gradient's intensity in 0..1 at a cell: the main focus'
    ;; elliptical falloff, lifted by the second focus at half weight.
    (define (still-intensity ps x y)
      (let* ((c (still-param ps 'center))
             (dx (- (+ x 0.5) (car c)))
             (dy (- (+ y 0.5) (cdr c)))
             (angle (still-param ps 'angle))
             (rx (+ (* dx (cos angle)) (* dy (sin angle))))
             (ry (/ (- (* dy (cos angle)) (* dx (sin angle))) (still-param ps 'squash)))
             (d (/ (sqrt (+ (* rx rx) (* ry ry))) (still-param ps 'radius)))
             (main (max 0.0 (- 1.0 (expt (min 1.0 d) (still-param ps 'falloff)))))
             (f (still-param ps 'focus))
             (fx (- (+ x 0.5) (car f)))
             (fy (- (+ y 0.5) (cadr f)))
             (d2 (/ (sqrt (+ (* fx fx) (* fy fy))) (caddr f)))
             (second (max 0.0 (- 1.0 (* d2 d2)))))
        (min 1.0 (+ main (* 0.5 second)))))

    (define (seed-still mode rng . rest)
      (let* ((field (make-vector CELLS 0.0))
             (sub (make-vector CELLS (q16 1.0)))
             (seed (if (pair? rest) (car rest) 1))
             (ps (still-params seed))
             (band (still-param ps 'band))
             (lo (car band))
             (span (cdr band)))
        (let loop ((i 0))
          (when (< i CELLS)
            (let* ((x (modulo i GRID-W))
                   (y (quotient i GRID-W))
                   (level (/ (+ lo (* (still-intensity ps x y) (- span 0.001))) (inexact RAMP))))
              (vector-set! field i (q16 (/ level REACT-SHOWN-SCALE))))
            (loop (+ i 1))))
        (bg mode: mode field: field sub: sub)))

    (define (step-still b key) b)   ; never stepped

    (define RULES
      (list (list 'reaction seed-reaction step-reaction shown-reaction)
            (list 'still seed-still step-still shown-reaction)))

    (define MODES (map car RULES))

    (define (rule-ref mode)
      (let ((entry (assq mode RULES)))
        (if entry (cdr entry) (cdr (car RULES)))))

    (define (rule-seed rule) (car rule))
    (define (rule-step rule) (cadr rule))
    (define (rule-shown rule) (caddr rule))

    ;; A cell's stored state as the value the dither maps.
    (define (bg-shown-value b state)
      (case (bg-mode b)
        ((cyclic) (/ 32.0 256.0))
        ((flow) (/ (floor (+ (* state state 255.0) 0.5)) 256.0))
        ((signal) (/ (if (> state 0) 200.0 16.0) 256.0))
        ((echo synapse flame) (/ (floor (* state 32.0)) 256.0))
        (else ((rule-shown (rule-ref (bg-mode b))) state))))

    ;; One tick of the clock: the burst counts down every tick; the field
    ;; steps (and its runs are rebuilt) once every STRIDE ticks, collapsing
    ;; instead once severed; a held field keeps its schedule but takes no
    ;; step; a GPU field takes the schedule and none of the cell work.
    (define (bg-step b)
      (let* ((ticks (+ 1 (bg-ticks b)))
             (b0 (bg b ticks: ticks burst: (max 0 (- (bg-burst b) 1)))))
        (cond ((not (= 0 (modulo ticks (bg-stride b0)))) b0)
              ((bg-held? b0) b0)
              ((bg-gpu? b0)
               ;; the entry is what the CPU path would step at: b0, the burst counted down
               (let ((pending (append (bg-pending b0) (list (cons (bg-agit b0) (bg-severed b0))))))
                 (bg b0
                     steps: (+ 1 (bg-steps b0))
                     pending: (if (> (length pending) PENDING-MAX) (cdr pending) pending))))
              (else
               (let* ((key (bg-step-key (bg-seed b0) (bg-steps b0)))
                      (stepped (if (bg-severed b0)
                                   (collapse b0)
                                   ((rule-step (rule-ref (bg-mode b0))) b0 key)))
                      (stepped (bg stepped steps: (+ 1 (bg-steps stepped)))))
                 (bg stepped runs-held: (build-runs stepped)))))))

    (define (bg-tick b n)
      (if (<= n 0) b (bg-tick (bg-step b) (- n 1))))

    ;; --- reading it back ------------------------------------------------------------

    ;; A 2x2 ordered dither of the value onto RAMP tones, the ramp a
    ;; ring: the tone index of each of a cell's four half cells (top-left,
    ;; top-right, bottom-left, bottom-right).
    (define (dither v)
      (let* ((level (* v RAMP))
             (base (modulo (exact (floor level)) RAMP))
             (frac (- level (floor level)))
             (up (modulo (+ base 1) RAMP)))
        (cond ((< frac 0.25) (list base base base base))
              ((< frac 0.5) (list up base base base))
              ((< frac 0.75) (list up base base up))
              (else (list up up base up)))))

    ;; The half-cell tone map of the field as stored: a vector of
    ;; (2 GRID-W) x (2 GRID-H) tones, row-major.
    (define (bg-cell-tones b)
      (let ((f (bg-field b))
            (tones (make-vector (* 2 GRID-W 2 GRID-H) 0))
            (w2 (* 2 GRID-W)))
        (let loop ((i 0))
          (when (< i CELLS)
            (let* ((x (modulo i GRID-W))
                   (y (quotient i GRID-W))
                   (d (dither (bg-shown-value b (vector-ref f i))))
                   (row0 (* 2 y))
                   (col0 (* 2 x)))
              (vector-set! tones (+ col0 (* row0 w2)) (car d))
              (vector-set! tones (+ col0 1 (* row0 w2)) (cadr d))
              (vector-set! tones (+ col0 (* (+ row0 1) w2)) (caddr d))
              (vector-set! tones (+ col0 1 (* (+ row0 1) w2)) (cadddr d)))
            (loop (+ i 1))))
        tones))

    ;; The rectangles of the field as last stepped, (tone x y w h) in px
    ;; on the half-cell grid, same-tone runs merged along each half-cell
    ;; row and the list grouped by tone (ascending), so the renderer sets
    ;; one color per group. A GPU field has none.
    (define (bg-runs b) (bg-runs-held b))

    (define (build-runs b)
      (let* ((half (quotient CELL 2))
             (tones (bg-cell-tones b)))
        ;; runs, one accumulator per tone, newest first, joined in tone order
        (let ((groups (make-vector RAMP '()))
              (w2 (* 2 GRID-W)))
          (define (keep! tone start r c)
            (vector-set! groups tone
                         (cons (list tone (* half start) (* half r) (* half (- c start)) half)
                               (vector-ref groups tone))))
          (let rows ((r 0))
            (when (< r (* 2 GRID-H))
              (let run ((c 0) (start 0) (tone (vector-ref tones (* r w2))))
                (cond ((= c w2) (keep! tone start r c))
                      ((= (vector-ref tones (+ c (* r w2))) tone) (run (+ c 1) start tone))
                      (else
                       (keep! tone start r c)
                       (run (+ c 1) c (vector-ref tones (+ c (* r w2)))))))
              (rows (+ r 1))))
          (let join ((t (- RAMP 1)) (acc '()))
            (if (< t 0)
                acc
                (join (- t 1) (append (reverse (vector-ref groups t)) acc)))))))

    ;; A plain datum of the field, for the determinism leg.
    (define (bg-canonical b)
      (list (bg-mode b) (bg-ticks b) (bg-steps b) (vector->list (bg-field b))))))
