;;; (crash bg) - The living background: a dithered field of color behind
;;; the board, every cell always lit, the colors flowing between cells.
;;;
;;; David, 2026-09-17: "pixellated color patches move around, merging and
;;; splitting, almost like a lava lamp effect", with a genetic-algorithm
;;; flavor; and on seeing the first cut (2026-09-18): not discrete disks
;;; on a background but "a continuous surface that has shifting color
;;; areas ... almost like there's a grid of cells and the color is moving
;;; between them like a genetic algorithm or game of life", dithered, and
;;; more colorful than one purple ramp. So: a coarse grid of CELL px
;;; cells over the board area; every cell holds a value in [0, 1) and
;;; the renderer maps it onto a ramp of RAMP palette tones with a 2x2
;;; ordered dither between neighboring tones (four levels per step, so
;;; the surface reads as continuous at 8 px). The rules are a table,
;;; RULES, one entry per rule (its name, how it seeds a field, how it
;;; steps one), so a new rule is one entry and a name in the switch;
;;; David, 2026-09-19: "the current pattern is very close to what I had
;;; in mind", keep both selectable and leave room for more. Two so far:
;;;
;;;   life      the voter model with mutation: every tick RATE cells
;;;             (chosen by the stream) copy one random neighbor's value, or
;;;             once in LIFE-MUTATE visits drift a little instead; values
;;;             live on a ring, so the ramp is cyclic and domains of one
;;;             color grow, shrink, split and drift without ever settling.
;;;   reaction  Gray-Scott reaction-diffusion (two substances per cell, a
;;;             nine-point laplacian, feed and kill rates in the regime
;;;             that grows soft coral fronts) stepped a few times a tick,
;;;             fed by the stream: one cell seeded and one patch cleared
;;;             every so many ticks, so the fronts keep growing and
;;;             dissolving instead of settling; the value is the second
;;;             substance. (The first cut used the bare four-point
;;;             laplacian at unit diffusion, which is numerically unstable
;;;             at this step: the field flickered as a checkerboard.)
;;;
;;; Phase-driven: calm in TRACE, restless under the ICE (more cells, more
;;; steps), a burst when a counter-hack fires, a collapse once severed
;;; (every value decays toward the ground). Everything is a pure function
;;; of the seed through the field's own MINSTD stream, and the arithmetic
;;; is the same on both targets (the determinism leg holds two runs of
;;; one seed to one trajectory). Drawing is (crash render)'s: bg-runs
;;; answers rectangles quantized to the half-cell grid, run-merged along
;;; each row and grouped by tone. Rules family: no platform, no drawing.
;;;
;;; The phone's budget (David, 2026-09-19: "it's killing the CPU on the
;;; phone", the music choppy and the tweens stuttering). Measured in
;;; bytecode on the desktop, per frame: the life step 0.10 ms (0.24
;;; under the ICE), the reaction step 4.4 ms (10.2 under the ICE), and
;;; paid by both every frame before this: 2.6 ms to build the run list
;;; and about 1900 rectangles drawn. So the field steps once every
;;; STRIDE ticks (the rule's work scaled so the motion is the same), the
;;; runs are built at that step and held in the struct until the next,
;;; and the runs come grouped by tone so the renderer sets a color RAMP
;;; times a frame instead of 1900. The reaction's steps under the ICE
;;; are capped (REACT-STEPS-MAX). The shader path was weighed and
;;; declined with a number: sigil-graphics caps a shader at 16 scalar or
;;; vec4 uniforms with no arrays and no texture upload, so an 880-cell
;;; field cannot reach the GPU; only a procedural field could, and that
;;; is not this pattern.

(define-library (crash bg)
  (import (sigil struct)
          (sigil list)
          (sigil math)
          (crash stack prng))

  (export bg bg? bg-new bg-tick bg-field bg-rng bg-ticks bg-mode bg-agitation bg-burst
          bg-with-phase bg-with-burst bg-step bg-runs bg-canonical bg-dominant bg-mean bg-flow
          CELL GRID-W GRID-H RAMP MODES RULES STRIDE
          DOMINANT-CAP
          AGITATION-TRACE AGITATION-ICE AGITATION-BURST AGITATION-SEVERED
          BURST-TICKS)

  (begin
    ;; --- the numbers David tunes -----------------------------------------------

    (define CELL 16)             ; px per cell; the dither works in half cells
    (define GRID-W 40)           ; cells across at 640 wide
    (define GRID-H 22)           ; cells down over the 352 px board area
    (define RAMP 8)              ; palette tones in the ramp (crash render maps them)
    (define STRIDE 3)            ; ticks between steps of the field (the phone's budget)
    (define DOMINANT-CAP 0.9)    ; no tone may hold more of the half cells than this: a flat field is dead
    (define LIFE-RATE 60)        ; cells visited per tick at agitation 1
    (define LIFE-MUTATE 12)      ; one visit in this many mutates instead of copying
    (define LIFE-DRIFT 0.06)     ; a mutation moves the value this far at most, on the ring
    (define REACT-STEPS 2)       ; Gray-Scott steps per field step at agitation 1
    (define REACT-STEPS-MAX 4)   ; and never more than this under the ICE
    (define REACT-FEED 0.046)    ; the regime measured 2026-09-19: fronts cover 25..50 % and keep moving
    (define REACT-KILL 0.063)
    (define REACT-DA 1.0)
    (define REACT-DB 0.5)
    (define REACT-DT 1.0)
    (define REACT-RAIN 4)        ; cells seeded with the second substance every tick (raised to REACT-SEED)
    (define REACT-SEED 0.5)
    (define REACT-KILL-EVERY 2)  ; ticks between cleared 3x3 patches
    (define REACT-SPOTS 12)      ; 3x3 spots of the second substance at the start
    (define AGITATION-TRACE 1.0)
    (define AGITATION-ICE 2.5)
    (define AGITATION-BURST 6.0)
    (define AGITATION-SEVERED 0.0)
    (define BURST-TICKS 30)
    (define COLLAPSE 0.985)      ; per tick once severed, every value

    (define CELLS (* GRID-W GRID-H))

    ;; --- state ---------------------------------------------------------------------

    ;; field: the value per cell, row-major; sub: the reaction's first
    ;; substance (life keeps it unused).
    (define-struct bg
      (mode default: 'life)
      (field default: (vector))
      (sub default: (vector))
      (rng default: 1)
      (ticks default: 0)
      (agitation default: AGITATION-TRACE)
      (burst default: 0)
      (severed default: #f)
      (runs-held default: '()))     ; the rectangles of the field as last stepped, grouped by tone

    ;; The share of half cells in the most common tone, from the runs.
    (define (bg-dominant b)
      (let ((counts (make-vector RAMP 0))
            (half (quotient CELL 2)))
        (for-each (lambda (r)
                    (vector-set! counts (car r) (+ (vector-ref counts (car r)) (quotient (cadddr r) half))))
                  (bg-runs b))
        (/ (apply max (vector->list counts)) (* 4.0 CELLS))))

    ;; The share of cells whose value equals a right or lower neighbor's
    ;; exactly: the mark of the voter model's copies (a mutation-only field
    ;; from smoothed noise has none), so the gate can tell flow from noise.
    (define (bg-flow b)
      (let ((f (bg-field b)))
        (let loop ((i 0) (n 0))
          (if (= i CELLS)
              (/ n (* 1.0 CELLS))
              (let* ((x (modulo i GRID-W))
                     (y (quotient i GRID-W))
                     (v (vector-ref f i))
                     (r (vector-ref f (+ (modulo (+ x 1) GRID-W) (* y GRID-W))))
                     (d (vector-ref f (+ x (* (modulo (+ y 1) GRID-H) GRID-W)))))
                (loop (+ i 1) (if (or (= v r) (= v d)) (+ n 1) n)))))))

    (define (bg-mean b)
      (let loop ((i 0) (sum 0.0))
        (if (= i CELLS) (/ sum CELLS) (loop (+ i 1) (+ sum (vector-ref (bg-field b) i))))))

    (define (draw-unit rng)
      (let ((rng (prng-next rng)))
        (cons (/ (prng-index rng 1000000) 1000000.0) rng)))

    ;; A field seeded by the stream, through the rule's own seeder: life
    ;; starts from smooth-ish noise (each cell a draw, then two smoothing
    ;; passes); reaction from a full first substance with REACT-SPOTS
    ;; spots of the second. The runs are built once here and then at
    ;; every step.
    (define (bg-new seed . rest)
      (let* ((mode (if (and (pair? rest) (memq (car rest) MODES)) (car rest) 'life))
             (b ((rule-seed (rule-ref mode)) mode (prng-seed seed))))
        (bg b runs-held: (build-runs b))))

    (define (seed-life mode rng)
      (let ((field (make-vector CELLS 0.0))
            (sub (make-vector CELLS 1.0)))
        (let loop ((i 0) (rng rng))
          (if (= i CELLS)
              (bg mode: mode field: (smooth (smooth field)) sub: sub rng: rng)
              (let ((u (draw-unit rng)))
                (vector-set! field i (car u))
                (loop (+ i 1) (cdr u)))))))

    ;; REACT-SPOTS 3x3 spots of the second substance in a full first: the
    ;; fronts grow out of them from the first tick (a dozen left the field
    ;; blank for its first seconds; smoothed noise is too thin to take and
    ;; dies)
    (define (seed-reaction mode rng)
      (let ((field (make-vector CELLS 0.0))
            (sub (make-vector CELLS 1.0)))
            (let loop ((k 0) (rng rng))
              (if (= k REACT-SPOTS)
                  (bg mode: mode field: field sub: sub rng: rng)
                  (let* ((u1 (draw-unit rng))
                         (u2 (draw-unit (cdr u1)))
                         (cx (exact (floor (* (car u1) GRID-W))))
                         (cy (exact (floor (* (car u2) GRID-H)))))
                    (let spot ((dy -1))
                      (when (<= dy 1)
                        (let col ((dx -1))
                          (when (<= dx 1)
                            (let ((x (modulo (+ cx dx) GRID-W))
                                  (y (modulo (+ cy dy) GRID-H)))
                              (vector-set! field (+ x (* y GRID-W)) REACT-SEED)
                              (vector-set! sub (+ x (* y GRID-W)) REACT-SEED))
                            (col (+ dx 1))))
                        (spot (+ dy 1))))
                    (loop (+ k 1) (cdr u2)))))))

    (define (at field x y)
      (vector-ref field (+ (modulo x GRID-W) (* (modulo y GRID-H) GRID-W))))

    ;; A box blur over the four neighbors and the cell.
    (define (smooth field)
      (let ((out (make-vector CELLS 0.0)))
        (let loop ((i 0))
          (when (< i CELLS)
            (let ((x (modulo i GRID-W)) (y (quotient i GRID-W)))
              (vector-set! out i (/ (+ (at field x y) (at field (- x 1) y) (at field (+ x 1) y)
                                       (at field x (- y 1)) (at field x (+ y 1)))
                                    5.0)))
            (loop (+ i 1))))
        out))

    ;; --- the phase machine's inputs -----------------------------------------------

    (define (bg-with-phase b phase)
      (case phase
        ((counter) (bg b agitation: AGITATION-ICE severed: #f))
        ((severed) (bg b agitation: AGITATION-SEVERED severed: #t))
        (else (bg b agitation: AGITATION-TRACE severed: #f))))

    (define (bg-with-burst b)
      (bg b burst: BURST-TICKS))

    ;; --- one tick: life ------------------------------------------------------------------

    (define (clamp v) (max 0.0 (min 0.999 v)))
    (define (wrap v) (- v (floor v)))

    ;; visits cells: each copies one random neighbor, or mutates.
    (define (life-step field rng visits)
      (let ((out (vector-copy field)))
        (let loop ((k 0) (rng rng))
          (if (= k visits)
              (cons out rng)
              (let* ((rng (prng-next rng))
                     (i (prng-index rng CELLS))
                     (rng (prng-next rng))
                     (dir (prng-index rng 4))
                     (rng (prng-next rng))
                     (roll (prng-index rng LIFE-MUTATE))
                     (x (modulo i GRID-W))
                     (y (quotient i GRID-W))
                     (j (case dir
                          ((0) (+ (modulo (+ x 1) GRID-W) (* y GRID-W)))
                          ((1) (+ (modulo (- x 1) GRID-W) (* y GRID-W)))
                          ((2) (+ x (* (modulo (+ y 1) GRID-H) GRID-W)))
                          (else (+ x (* (modulo (- y 1) GRID-H) GRID-W)))))
                     (own (vector-ref out i))
                     (other (vector-ref out j)))
                (if (= roll 0)
                    (let ((rng (prng-next rng)))
                      (vector-set! out i (wrap (+ own (* LIFE-DRIFT (- (/ (prng-index rng 2000) 1000.0) 1.0)))))
                      (loop (+ k 1) rng))
                    (begin
                      (vector-set! out i other)
                      (loop (+ k 1) rng))))))))

    ;; --- one tick: reaction -------------------------------------------------------------

    ;; The nine-point laplacian with the usual weights (0.2 on the four
    ;; sides, 0.05 on the corners, the cell itself -1), which is stable at
    ;; unit diffusion and a unit step.
    (define (laplacian f x y v)
      (- (+ (* 0.2 (+ (at f (- x 1) y) (at f (+ x 1) y) (at f x (- y 1)) (at f x (+ y 1))))
            (* 0.05 (+ (at f (- x 1) (- y 1)) (at f (+ x 1) (- y 1)) (at f (- x 1) (+ y 1)) (at f (+ x 1) (+ y 1)))))
         v))

    ;; The stream's touch on the reaction: REACT-RAIN cells seeded with
    ;; the second substance every tick, and every REACT-KILL-EVERY ticks
    ;; a 3x3 patch cleared. Measured 2026-09-19 over four seeds and 1200
    ;; ticks: without the rain a seed's fronts die out within two seconds
    ;; on two seeds of four and the field stays blank; with it the ground
    ;; never holds more than 0.75 of the cells after the first half
    ;; second. Returns (cons field rng).
    (define (react-feed field rng ticks)
      (let* ((out (vector-copy field))
             (rng (let rain ((k 0) (rng rng))
                    (if (= k REACT-RAIN)
                        rng
                        (let* ((u1 (draw-unit rng))
                               (u2 (draw-unit (cdr u1)))
                               (i (+ (exact (floor (* (car u1) GRID-W)))
                                     (* (exact (floor (* (car u2) GRID-H))) GRID-W))))
                          (vector-set! out i (max (vector-ref out i) REACT-SEED))
                          (rain (+ k 1) (cdr u2))))))
             (u2 (cons 0.0 rng)))
        (if (= 0 (modulo ticks REACT-KILL-EVERY))
            (let* ((u3 (draw-unit (cdr u2)))
                   (u4 (draw-unit (cdr u3)))
                   (kx (exact (floor (* (car u3) GRID-W))))
                   (ky (exact (floor (* (car u4) GRID-H)))))
              (let spot ((dy -1))
                (when (<= dy 1)
                  (let col ((dx -1))
                    (when (<= dx 1)
                      (vector-set! out (+ (modulo (+ kx dx) GRID-W) (* (modulo (+ ky dy) GRID-H) GRID-W)) 0.0)
                      (col (+ dx 1))))
                  (spot (+ dy 1))))
              (cons out (cdr u4)))
            (cons out (cdr u2)))))

    (define (react-step a b)
      (let ((na (make-vector CELLS 0.0))
            (nb (make-vector CELLS 0.0)))
        (let loop ((i 0))
          (when (< i CELLS)
            (let* ((x (modulo i GRID-W))
                   (y (quotient i GRID-W))
                   (av (vector-ref a i))
                   (bv (vector-ref b i))
                   (la (laplacian a x y av))
                   (lb (laplacian b x y bv))
                   (abb (* av bv bv)))
              (vector-set! na i (clamp (+ av (* REACT-DT (+ (* REACT-DA la) (- abb) (* REACT-FEED (- 1.0 av)))))))
              (vector-set! nb i (clamp (+ bv (* REACT-DT (+ (* REACT-DB lb) abb (- (* (+ REACT-KILL REACT-FEED) bv))))))))
            (loop (+ i 1))))
        (cons na nb)))

    ;; The reaction's values are small (b peaks near 0.4); the field
    ;; shown is b scaled onto [0, 0.85], short of the ring's wrap so a
    ;; peak is the brightest tone and never the ground.
    (define (react-field b)
      (let ((out (make-vector CELLS 0.0)))
        (let loop ((i 0))
          (when (< i CELLS)
            (vector-set! out i (min 0.85 (* 2.2 (vector-ref b i))))
            (loop (+ i 1))))
        out))

    ;; --- one tick -------------------------------------------------------------------------

    (define (collapse field)
      (let ((out (vector-copy field)))
        (let loop ((i 0))
          (when (< i CELLS)
            (vector-set! out i (* COLLAPSE (vector-ref out i)))
            (loop (+ i 1))))
        out))

    ;; One field step of the life rule: STRIDE ticks' worth of visits.
    (define (step-life b agit)
      (let ((r (life-step (bg-field b) (bg-rng b) (exact (floor (* agit LIFE-RATE STRIDE))))))
        (bg b field: (car r) rng: (cdr r))))

    ;; One field step of the reaction: the feed, then REACT-STEPS Gray-
    ;; Scott steps scaled by the agitation and capped.
    (define (step-reaction b agit)
      (let ((fed (react-feed (bg-field b) (bg-rng b) (bg-ticks b)))
            (steps (min REACT-STEPS-MAX (max 1 (exact (floor (* agit REACT-STEPS)))))))
        (let loop ((k 0) (a (bg-sub b)) (bb (car fed)))
          ;; the reaction keeps b at its own scale in field; the renderer's
          ;; scale is react-field's
          (if (= k steps)
              (bg b field: bb sub: a rng: (cdr fed))
              (let ((r (react-step a bb)))
                (loop (+ k 1) (car r) (cdr r)))))))

    ;; --- the rule table ---------------------------------------------------------------

    ;; (name seed step): seed builds the field from a mode and the
    ;; stream, step advances one field step at an agitation. Built with
    ;; list, not quoted (the web build's literal hazard, see (crash menu)).
    (define RULES
      (list (list 'life seed-life step-life)
            (list 'reaction seed-reaction step-reaction)))

    (define MODES (map car RULES))

    (define (rule-ref mode)
      (let ((entry (assq mode RULES)))
        (if entry (cdr entry) (cdr (car RULES)))))

    (define (rule-seed rule) (car rule))
    (define (rule-step rule) (cadr rule))

    ;; One tick of the clock: the burst counts down every tick; the field
    ;; steps (and its runs are rebuilt) once every STRIDE ticks, collapsing
    ;; instead once severed.
    (define (bg-step b)
      (let* ((agit (if (> (bg-burst b) 0) AGITATION-BURST (bg-agitation b)))
             (ticks (+ 1 (bg-ticks b)))
             (b (bg b ticks: ticks burst: (max 0 (- (bg-burst b) 1)))))
        (if (not (= 0 (modulo ticks STRIDE)))
            b
            (let ((stepped (if (bg-severed b)
                               (bg b field: (collapse (bg-field b)))
                               ((rule-step (rule-ref (bg-mode b))) b agit))))
              (bg stepped runs-held: (build-runs stepped))))))

    (define (bg-tick b n)
      (if (<= n 0) b (bg-tick (bg-step b) (- n 1))))

    ;; --- reading it back ------------------------------------------------------------

    ;; The value the renderer maps: [0, 1) per cell, mode-scaled.
    (define (shown b)
      (if (eq? (bg-mode b) 'reaction) (react-field (bg-field b)) (bg-field b)))

    ;; A 2x2 ordered dither of the value onto RAMP tones, the ramp a
    ;; ring: the tone index of each of a cell's four half cells (top-left,
    ;; top-right, bottom-left, bottom-right).
    (define (dither v)
      (let* ((level (* v RAMP))
             (base (modulo (exact (floor level)) RAMP))
             (frac (- level (floor level)))
             (up (modulo (+ base 1) RAMP)))
        (cond ((< frac 0.25) (list base base base base))
              ((< frac 0.5) (list up base base base))
              ((< frac 0.75) (list up base base up))
              (else (list up up base up)))))

    ;; The rectangles of the field as last stepped, (tone x y w h) in px
    ;; on the half-cell grid, same-tone runs merged along each half-cell
    ;; row and the list grouped by tone (ascending), so the renderer sets
    ;; one color per group.
    (define (bg-runs b) (bg-runs-held b))

    (define (build-runs b)
      (let* ((field (shown b))
             (half (quotient CELL 2))
             (tones (make-vector (* 2 GRID-W 2 GRID-H) 0)))
        ;; the half-cell tone map
        (let loop ((i 0))
          (when (< i CELLS)
            (let* ((x (modulo i GRID-W))
                   (y (quotient i GRID-W))
                   (d (dither (vector-ref field i)))
                   (row0 (* 2 y))
                   (col0 (* 2 x))
                   (w2 (* 2 GRID-W)))
              (vector-set! tones (+ col0 (* row0 w2)) (car d))
              (vector-set! tones (+ col0 1 (* row0 w2)) (cadr d))
              (vector-set! tones (+ col0 (* (+ row0 1) w2)) (caddr d))
              (vector-set! tones (+ col0 1 (* (+ row0 1) w2)) (cadddr d)))
            (loop (+ i 1))))
        ;; runs, one accumulator per tone, newest first, joined in tone order
        (let ((groups (make-vector RAMP '()))
              (w2 (* 2 GRID-W)))
          (define (keep! tone start r c)
            (vector-set! groups tone
                         (cons (list tone (* half start) (* half r) (* half (- c start)) half)
                               (vector-ref groups tone))))
          (let rows ((r 0))
            (when (< r (* 2 GRID-H))
              (let run ((c 0) (start 0) (tone (vector-ref tones (* r w2))))
                (cond ((= c w2) (keep! tone start r c))
                      ((= (vector-ref tones (+ c (* r w2))) tone) (run (+ c 1) start tone))
                      (else
                       (keep! tone start r c)
                       (run (+ c 1) c (vector-ref tones (+ c (* r w2)))))))
              (rows (+ r 1))))
          (let join ((t (- RAMP 1)) (acc '()))
            (if (< t 0)
                acc
                (join (- t 1) (append (reverse (vector-ref groups t)) acc)))))))

    ;; A plain datum of the field, for the determinism leg.
    (define (bg-canonical b)
      (list (bg-mode b) (bg-ticks b) (bg-rng b) (vector->list (bg-field b))))))
