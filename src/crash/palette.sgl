;;; (crash palette) - The colors, all of them, in one place.
;;;
;;; At most 32 colors for the Amiga feel, so David retunes the look here
;;; (design decision 7). Both drawing modules, (crash render) for the
;;; Mahjongg table and (crash cards render) for the card table, take
;;; their colors from this list and set none of their own; the palette
;;; moved out of (crash render) unchanged when the second table arrived
;;; (P2). color! and color-alpha! are the only calls to set-color in the
;;; game.

(define-library (crash palette)
  (import (sigil graphics))

  (export C-BG C-BAR-A C-BAR-B C-BAR-C
          C-FACE C-FACE-EDGE C-SIDE C-SIDE-DARK
          C-SELECTED C-HIGHLIGHT C-TEXT C-TEXT-DIM
          C-SUIT-0 C-SUIT-1 C-SUIT-2 C-SUIT-3
          C-LABEL-LIT C-LOCKED C-LOCK-WEAK C-TRACE C-TRACE-HOT
          C-HOT C-COLD
          C-DAEMON C-GIBSON C-ICE C-STATIC-A C-STATIC-B
          C-WIRE-LIT C-WIRE-DARK C-ARCHIVE C-MOSS
          C-FACE-1 C-FACE-2
          PALETTE
          C-TEX-PLAIN C-TEX-SELECTED
          color! color-alpha! mix)

  (begin
    ;; (r g b) in 0..1. The hex of each (round half up, times 255) is the
    ;; entry of the same name in assets/palette.sgl, the style bible's
    ;; section 1 as a datum, which the art pipeline snaps every generated
    ;; asset to; test/test-palette.sgl holds the two together. 28 distinct
    ;; colors of 32; three in hand, not to be spent before P5.

    (define C-BG        '(0.05 0.04 0.10))
    (define C-BAR-A     '(0.09 0.07 0.18))
    (define C-BAR-B     '(0.13 0.09 0.24))
    (define C-BAR-C     '(0.18 0.11 0.30))
    (define C-FACE      '(0.86 0.88 0.90))
    (define C-FACE-EDGE '(0.98 0.99 1.00))
    (define C-SIDE      '(0.42 0.44 0.52))
    (define C-SIDE-DARK '(0.24 0.25 0.32))
    (define C-SELECTED  '(0.30 0.95 0.85))
    (define C-HIGHLIGHT '(1.00 0.35 0.85))
    (define C-TEXT      '(0.80 0.90 1.00))
    (define C-TEXT-DIM  '(0.45 0.50 0.65))
    (define C-SUIT-0    '(0.10 0.45 0.85))   ; digits 0-8
    (define C-SUIT-1    '(0.80 0.20 0.25))   ; 9-h
    (define C-SUIT-2    '(0.10 0.55 0.30))   ; i-q
    (define C-SUIT-3    '(0.55 0.25 0.70))   ; r-z
    (define C-LABEL-LIT '(1.00 0.80 0.20))
    ;; The card table's two classes (ruling D16, then David from the phone
    ;; 2026-09-18: two colors, not four, and the amber was unreadable on a
    ;; small screen): hot packets orange, cold ones blue, a pair that also
    ;; survives the common color blindness.
    (define C-HOT       '(0.95 0.45 0.10))   ; PWR and TX (hearts, diamonds)
    (define C-COLD      '(0.10 0.45 0.85))   ; MEM and DSK (spades, clubs)
    (define C-LOCKED    '(0.62 0.34 0.38))   ; a strong lock's face
    (define C-LOCK-WEAK '(0.72 0.62 0.36))   ; a weak lock's face
    (define C-TRACE     '(0.30 0.95 0.85))   ; the meter, low
    (define C-TRACE-HOT '(1.00 0.35 0.35))   ; the meter, near the lock
    ;; P3, from the bible: the daemons, Gibson, the ICE, the static and the
    ;; wires and the seal of later modes. Three decimals where two would
    ;; round to the wrong hex.
    (define C-DAEMON    '(0.941 0.941 0.941))   ; the four wildcard daemon glyphs
    (define C-GIBSON    '(0.702 0.420 1.000))   ; Gibson's lines, sentence case (D17)
    (define C-ICE       '(1.000 0.624 0.102))   ; ICE toasts, the counter-hack flash
    (define C-STATIC-A  '(0.541 0.561 0.627))   ; severed screen static, light
    (define C-STATIC-B  '(0.165 0.176 0.227))   ; static, dark; the packet back noise
    (define C-WIRE-LIT  C-SELECTED)                ; live wire (PATCH, INTERCEPT later)
    (define C-WIRE-DARK '(0.122 0.227 0.302))   ; dead wire
    (define C-ARCHIVE   '(0.361 0.302 0.549))   ; CHECKSUM seal tint (later)
    (define C-MOSS      '(0.290 0.353 0.169))   ; the living background's yellow-green accent
    ;; D48's B2 (David, 2026-09-20: "a faint hue in addition to the
    ;; lightness ... it'd be clear which tiles are on the same layer"): the
    ;; faces of the layers above the base, lightness rising with the layer,
    ;; a faint hue each. The last two slots in hand: layer 1 cool, layer 3
    ;; warm; layer 2 reuses C-SIDE-DARK (neutral, between them in
    ;; lightness) and layer 4 is B's plain lightness step, no slot.
    (define C-FACE-1    '(0.180 0.212 0.314))   ; layer 1: cool
    (define C-FACE-2    '(0.353 0.290 0.251))   ; layer 3: warm
    ;; Every role by name, in the bible's order, for the gate that holds this
    ;; file to assets/palette.sgl. The tints below are not colors of the
    ;; palette: a texture is multiplied by them, never drawn in them.
    (define PALETTE
      (list (cons 'C-BG C-BG)
            (cons 'C-BAR-A C-BAR-A)
            (cons 'C-BAR-B C-BAR-B)
            (cons 'C-BAR-C C-BAR-C)
            (cons 'C-FACE C-FACE)
            (cons 'C-FACE-EDGE C-FACE-EDGE)
            (cons 'C-SIDE C-SIDE)
            (cons 'C-SIDE-DARK C-SIDE-DARK)
            (cons 'C-SELECTED C-SELECTED)
            (cons 'C-HIGHLIGHT C-HIGHLIGHT)
            (cons 'C-TEXT C-TEXT)
            (cons 'C-TEXT-DIM C-TEXT-DIM)
            (cons 'C-SUIT-0 C-SUIT-0)
            (cons 'C-SUIT-1 C-SUIT-1)
            (cons 'C-SUIT-2 C-SUIT-2)
            (cons 'C-SUIT-3 C-SUIT-3)
            (cons 'C-HOT C-HOT)
            (cons 'C-COLD C-COLD)
            (cons 'C-LABEL-LIT C-LABEL-LIT)
            (cons 'C-LOCKED C-LOCKED)
            (cons 'C-LOCK-WEAK C-LOCK-WEAK)
            (cons 'C-TRACE C-TRACE)
            (cons 'C-TRACE-HOT C-TRACE-HOT)
            (cons 'C-DAEMON C-DAEMON)
            (cons 'C-GIBSON C-GIBSON)
            (cons 'C-ICE C-ICE)
            (cons 'C-STATIC-A C-STATIC-A)
            (cons 'C-STATIC-B C-STATIC-B)
            (cons 'C-WIRE-LIT C-WIRE-LIT)
            (cons 'C-WIRE-DARK C-WIRE-DARK)
            (cons 'C-ARCHIVE C-ARCHIVE)
            (cons 'C-MOSS C-MOSS)
            (cons 'C-FACE-1 C-FACE-1)
            (cons 'C-FACE-2 C-FACE-2)))

    ;; Tints for a drawn texture (the title's targets): white leaves the art as drawn.
    (define C-TEX-PLAIN     '(1.00 1.00 1.00))
    (define C-TEX-SELECTED  '(0.50 1.00 0.95))

    (define (color! c)
      (set-color (car c)
                 (cadr c)
                 (caddr c)
                 1.0))

    (define (color-alpha! c a)
      (set-color (car c)
                 (cadr c)
                 (caddr c)
                 a))

    ;; c0 at t = 0, c1 at t = 1.
    (define (mix c0 c1 t)
      (map (lambda (a b)
             (+ a (* (- b a) t)))
           c0
           c1))
))
