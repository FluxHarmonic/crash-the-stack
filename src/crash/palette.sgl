;;; (crash palette) - The colors, all of them, in one place.
;;;
;;; At most 32 colors for the Amiga feel, so David retunes the look here
;;; (design decision 7). Both drawing modules, (crash render) for the
;;; Mahjongg table and (crash cards render) for the card table, take
;;; their colors from this list and set none of their own; the palette
;;; moved out of (crash render) unchanged when the second table arrived
;;; (P2). color! and color-alpha! are the only calls to set-color in the
;;; game.

(define-library (crash palette)
  (import (sigil graphics))

  (export C-BG C-BAR-A C-BAR-B C-BAR-C
          C-FACE C-FACE-EDGE C-SIDE C-SIDE-DARK
          C-SELECTED C-HIGHLIGHT C-TEXT C-TEXT-DIM
          C-SUIT-0 C-SUIT-1 C-SUIT-2 C-SUIT-3
          C-LABEL-LIT C-LOCKED C-LOCK-WEAK C-TRACE C-TRACE-HOT
          C-HOT C-COLD
          C-TEX-PLAIN C-TEX-SELECTED
          color! color-alpha! mix)

  (begin
    ;; (r g b) in 0..1. Sixteen used; sixteen in hand.

    (define C-BG        '(0.05 0.04 0.10))
    (define C-BAR-A     '(0.09 0.07 0.18))
    (define C-BAR-B     '(0.13 0.09 0.24))
    (define C-BAR-C     '(0.18 0.11 0.30))
    (define C-FACE      '(0.86 0.88 0.90))
    (define C-FACE-EDGE '(0.98 0.99 1.00))
    (define C-SIDE      '(0.42 0.44 0.52))
    (define C-SIDE-DARK '(0.24 0.25 0.32))
    (define C-SELECTED  '(0.30 0.95 0.85))
    (define C-HIGHLIGHT '(1.00 0.35 0.85))
    (define C-TEXT      '(0.80 0.90 1.00))
    (define C-TEXT-DIM  '(0.45 0.50 0.65))
    (define C-SUIT-0    '(0.10 0.45 0.85))   ; digits 0-8
    (define C-SUIT-1    '(0.80 0.20 0.25))   ; 9-h
    (define C-SUIT-2    '(0.10 0.55 0.30))   ; i-q
    (define C-SUIT-3    '(0.55 0.25 0.70))   ; r-z
    (define C-LABEL-LIT '(1.00 0.80 0.20))
    ;; The card table's two classes (ruling D16, then David from the phone
    ;; 2026-09-18: two colors, not four, and the amber was unreadable on a
    ;; small screen): hot packets orange, cold ones blue, a pair that also
    ;; survives the common color blindness.
    (define C-HOT       '(0.95 0.45 0.10))   ; PWR and TX (hearts, diamonds)
    (define C-COLD      '(0.10 0.45 0.85))   ; MEM and DSK (spades, clubs)
    (define C-LOCKED    '(0.62 0.34 0.38))   ; a strong lock's face
    (define C-LOCK-WEAK '(0.72 0.62 0.36))   ; a weak lock's face
    (define C-TRACE     '(0.30 0.95 0.85))   ; the meter, low
    (define C-TRACE-HOT '(1.00 0.35 0.35))   ; the meter, near the lock
    ;; Tints for the test-tile texture: white leaves the art as drawn.
    (define C-TEX-PLAIN     '(1.00 1.00 1.00))
    (define C-TEX-SELECTED  '(0.50 1.00 0.95))

    (define (color! c)
      (set-color (car c)
                 (cadr c)
                 (caddr c)
                 1.0))

    (define (color-alpha! c a)
      (set-color (car c)
                 (cadr c)
                 (caddr c)
                 a))

    ;; c0 at t = 0, c1 at t = 1.
    (define (mix c0 c1 t)
      (let loop ((c0 c0) (c1 c1) (acc '()))
        (if (null? c0)
            (reverse acc)
            (loop (cdr c0)
                  (cdr c1)
                  (cons (+ (car c0) (* (- (car c1) (car c0)) t)) acc)))))
))
