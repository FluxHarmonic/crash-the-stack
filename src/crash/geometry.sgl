;;; (crash geometry) - Where a tile lands on the screen, and which tile a
;;; point lands on.
;;;
;;; Pure arithmetic over a layout and a virtual viewport: tile size, board
;;; origin, the per-layer stacking offset, each slot's rectangle, the draw
;;; order that makes the stack read as a stack, the hit-test the mouse and
;;; touch use, and the row/column labels the coordinate keyboard model uses.
;;; Both (crash render) and (crash input) come here, so what is drawn and
;;; what is clicked cannot disagree.
;;;
;;; Sizes are derived from the viewport at runtime; nothing here bakes 640
;;; wide in (decision D3). The knobs David may want to turn are at the top.

(define-library (crash geometry)
  (import (sigil struct)
          (sigil list)
          (sigil math)
          (crash stack layout)
          (crash stack rules))

  (export geometry geometry?
          geometry-layout geometry-vw geometry-vh
          geometry-tile-w geometry-tile-h geometry-side
          geometry-origin-x geometry-origin-y geometry-hud-h
          geometry-draw-order
          make-geometry make-canvas-geometry cell-rect
          TILE-RATIO LAYER-OFFSET HUD-HEIGHT
          CONTROL-NAMES CONTROL-H METER-W METER-H READOUT-W BUTTON-SIZE
          slot-rect slot-x slot-y slot-extent slot-centre rect-contains? hit-slot
          column-x row-y
          geometry-controls control-rect hit-control
          meter-rect readout-rect meter-box readout-box bar-controls
          update-controls hit-update-control
          frame->virtual)

  (begin
    ;; Tile width as a fraction of its height. GNOME's tiles are taller than
    ;; wide; 0.8 is the P0 starting point for David to rule on.
    (define TILE-RATIO 0.8)
    ;; Pixels a layer shifts up and to the right over the one below (the
    ;; Mesche prototype's +3/-3), which is also the width of the side face.
    (define LAYER-OFFSET 3)
    ;; Band at the bottom of the viewport (ruling D33: status only). The
    ;; tool button at its left end is (crash hud)'s; the rest is the trace
    ;; meter, the readouts and the instruction line, in the one layout,
    ;; zones (the meter centered on the first row, the readout at the
    ;; right; the strip layout left on 2026-09-21, D51).
    (define HUD-HEIGHT 48)
    ;; The tappable controls: keys (the ? button at the bar's right end,
    ;; showing the keys line), tool (the stack's button, which (crash hud)
    ;; handles; listed so the web shell can say where it is), menu (its
    ;; peer beside it). The meter and the TILES readout are drawn, not
    ;; tapped (the polish row took the mode flip and the look step).
    (define CONTROL-NAMES '(keys tool menu))
    (define METER-W 200)
    ;; the meter's box: 7-px text at scale 2, a pixel of padding above and
    ;; below it, and the 1-px border (David's phone read, 2026-09-20)
    (define METER-H 18)
    (define READOUT-W 112)
    ;; the readouts' right edge: a cell short of the ? button's left (David's
    ;; laptop read, 2026-09-20: the button sat over the DEFRAG bar's
    ;; bounty row and crowded the balance); nothing draws under the button
    (define READOUT-RIGHT-INSET 32)
    (define CONTROL-H 20)
    (define CONTROL-Y 4)
    ;; the three square bar buttons (the wrench, MENU, ?): 24 px, their top
    ;; this far above the viewport's bottom edge
    (define BUTTON-SIZE 24)
    (define BUTTON-RISE 28)
    ;; Space around the board for the tags on the top row and breathing room.
    (define GUTTER 22)

    (define-struct geometry
      (layout default: #f)
      (vw default: 640)
      (vh default: 400)
      (tile-w default: 30)
      (tile-h default: 38)
      (side default: LAYER-OFFSET)
      (origin-x default: 0)
      (origin-y default: 0)
      (hud-h default: HUD-HEIGHT)
      (draw-order default: '()))      ; slot ids, bottom layer first

    (define (even-down n)
      (if (odd? n) (- n 1) n))

    ;; so each tile's left and bottom side faces are covered by the tiles
    ;; drawn after it, as a real stack seen from below-left would be.
    (define (compute-draw-order lay)
      (let ((less? (lambda (a b)
                     (let ((sa (layout-slot lay a)) (sb (layout-slot lay b)))
                       (or (< (slot-layer sa) (slot-layer sb))
                           (and (= (slot-layer sa) (slot-layer sb))
                                (or (< (slot-hy sa) (slot-hy sb))
                                    (and (= (slot-hy sa) (slot-hy sb))
                                         (> (slot-hx sa) (slot-hx sb))))))))))
        (list-sort less? (iota (layout-slot-count lay)))))

    (define (make-geometry lay vw vh)
      (let* ((offset LAYER-OFFSET)
             (layers (layout-layer-count lay))
             (stack-w (* offset (max 0 (- layers 1))))
             ;; spans are even for any layout whose extreme tiles sit on whole
             ;; columns; an odd span rounds down and centres half a tile off.
             (tiles-across (+ 1 (half (- (layout-max-hx lay) (layout-min-hx lay)))))
             (tiles-down (+ 1 (half (- (layout-max-hy lay) (layout-min-hy lay)))))
             (avail-w (- vw (* 2 GUTTER) stack-w))
             (avail-h (- vh HUD-HEIGHT (* 2 GUTTER) stack-w))
             (tile-h (even-down (exact (floor (/ avail-h tiles-down)))))
             (tile-w (even-down (min (exact (floor (* tile-h TILE-RATIO)))
                                     (exact (floor (/ avail-w tiles-across))))))
             (board-w (+ (* tile-w tiles-across) stack-w))
             (board-h (+ (* tile-h tiles-down) stack-w))
             (origin-x (+ (exact (floor (/ (- vw board-w) 2))) 0))
             (origin-y (+ (exact (floor (/ (- vh HUD-HEIGHT board-h) 2))) stack-w)))
        (geometry layout: lay vw: vw vh: vh
                  tile-w: tile-w tile-h: tile-h side: offset
                  origin-x: origin-x origin-y: origin-y hud-h: HUD-HEIGHT
                  draw-order: (compute-draw-order lay))))

    ;; A geometry for a fixed canvas of half-units and layers, for the editor:
    ;; the tiles it draws are not in any layout yet, so the bounds come from
    ;; four sentinel slots at the canvas corners (the draw order is theirs,
    ;; and nothing draws it).
    (define (make-canvas-geometry vw vh min-hx max-hx min-hy max-hy layers)
      (make-geometry (slots->layout (list (slot layer: 0 hx: min-hx hy: min-hy)
                                          (slot layer: 0 hx: max-hx hy: max-hy)
                                          (slot layer: (- layers 1) hx: min-hx hy: min-hy)
                                          (slot layer: (- layers 1) hx: max-hx hy: max-hy)))
                     vw
                     vh))

    ;; (x y w h) of the face a tile at (layer hx hy) would have.
    (define (cell-rect g layer hx hy)
      (let ((shift (* (geometry-side g) layer)))
        (list (+ (column-x g hx) shift)
              (- (row-y g hy) shift)
              (geometry-tile-w g)
              (geometry-tile-h g))))

    ;; The x of the left edge of a tile centered at hx (origin-x is the left edge
    ;; of the leftmost tile, centered at min-hx), and likewise the y of the top
    ;; edge of a tile centered at hy; both on layer 0.
    (define (column-x g hx)
      (+ (geometry-origin-x g)
         (* (- hx (layout-min-hx (geometry-layout g))) (half (geometry-tile-w g)))))

    (define (row-y g hy)
      (+ (geometry-origin-y g)
         (* (- hy (layout-min-hy (geometry-layout g))) (half (geometry-tile-h g)))))

    ;; (x y w h) of a slot's face, layer offset applied.
    (define (slot-rect g id)
      (let* ((s (layout-slot (geometry-layout g) id))
             (shift (* (geometry-side g) (slot-layer s))))
        (list (+ (column-x g (slot-hx s)) shift)
              (- (row-y g (slot-hy s)) shift)
              (geometry-tile-w g)
              (geometry-tile-h g))))

    ;; The face's x and y alone, for the walks that fill a buffer a frame
    ;; (slot-rect's list is 128 bytes a call in the native codegen).
    (define (slot-x g id)
      (let ((s (layout-slot (geometry-layout g) id)))
        (+ (column-x g (slot-hx s)) (* (geometry-side g) (slot-layer s)))))

    (define (slot-y g id)
      (let ((s (layout-slot (geometry-layout g) id)))
        (- (row-y g (slot-hy s)) (* (geometry-side g) (slot-layer s)))))

    (define (slot-centre g id)
      (let ((r (slot-rect g id)))
        (cons (+ (car r) (half (caddr r)))
              (+ (cadr r) (half (cadddr r))))))

    (define (rect-contains? r x y)
      (and (>= x (car r)) (< x (+ (car r) (caddr r)))
           (>= y (cadr r)) (< y (+ (cadr r) (cadddr r)))))

    ;; (x y w h) of everything a slot paints: the face plus its side faces, one
    ;; layer offset to the left and below.
    (define (slot-extent g id)
      (let ((r (slot-rect g id)) (side (geometry-side g)))
        (list (- (car r) side) (cadr r) (+ (caddr r) side) (+ (cadddr r) side))))

    ;; The topmost present tile under a point, or #f. Walks the draw order
    ;; from the last-drawn tile back, so a tile drawn over another wins; tests
    ;; the drawn extent, side faces included, so a click on the visible side of
    ;; a top tile lands on that tile and not the one it covers.
    (define (hit-slot g b x y)
      (let loop ((ids (reverse (geometry-draw-order g))))
        (cond ((null? ids) #f)
              ((and (tile-present? b (car ids))
                    (rect-contains? (slot-extent g (car ids)) x y))
               (car ids))
              (else (loop (cdr ids))))))

    ;; --- the HUD controls -----------------------------------------------------

    ;; ((name x y w h) ...) for every control, in the HUD band, for the
    ;; layout named. Drawing and hit-testing both read this list, so a
    ;; control is tapped where it is seen.
    ;; The controls of a geometry and layout, three (name x y w h) lists,
    ;; kept for the pair last asked about: the HUD asks for a control's
    ;; rect several times a frame and a fresh list of lists is 960 bytes
    ;; in the native codegen (2026-09-20). A geometry is a value (a
    ;; resize makes a new one).
    (define *controls-g* #f)
    (define *controls-layout* #f)
    (define *controls* '())

    (define (geometry-controls g layout)
      (unless (and (eq? g *controls-g*) (eq? layout *controls-layout*))
        (set! *controls* (build-controls g layout))
        (set! *controls-g* g)
        (set! *controls-layout* layout))
      *controls*)

    (define (build-controls g layout)
      (bar-controls (geometry-vw g) (geometry-vh g)))

    ;; The three square buttons of a bar, ((name x y w h) ...), in the
    ;; order the tables list them: the wrench, MENU beside it, ? at the
    ;; right end. Both tables' bars share these (the card table adds its
    ;; own readouts in front).
    (define (bar-controls vw vh)
      (list (list 'keys (- vw BUTTON-SIZE 4) (- vh BUTTON-RISE) BUTTON-SIZE BUTTON-SIZE)
            (list 'tool 4 (- vh BUTTON-RISE) BUTTON-SIZE BUTTON-SIZE)
            ;; the menu's peer button beside the wrench (David, 2026-09-19)
            (list 'menu 32 (- vh BUTTON-RISE) BUTTON-SIZE BUTTON-SIZE)))

    ;; (x y w h) of the trace meter, top the band's top: a METER-W x
    ;; METER-H box centered on the first row (layout: zones, the one layout).
    (define (meter-box vw top layout)
      (list (- (half vw) (half METER-W)) (+ top CONTROL-Y) METER-W METER-H))

    ;; (x y w h) of the readout (TILES, or the card table's score): the
    ;; right of the first row.
    (define (readout-box vw top layout)
      (list (- vw READOUT-RIGHT-INSET READOUT-W) (+ top CONTROL-Y) READOUT-W CONTROL-H))

    (define (meter-rect g layout)
      (meter-box (geometry-vw g) (- (geometry-vh g) (geometry-hud-h g)) layout))

    (define (readout-rect g layout)
      (readout-box (geometry-vw g) (- (geometry-vh g) (geometry-hud-h g)) layout))

    ;; (x y w h) of a named control, or #f.
    (define (control-rect g layout name)
      (let ((entry (assq name (geometry-controls g layout))))
        (and entry (cdr entry))))

    ;; The control under a point, by name, or #f.
    (define (hit-control g layout x y)
      (let loop ((cs (geometry-controls g layout)))
        (cond ((null? cs) #f)
              ((rect-contains? (cdr (car cs)) x y) (car (car cs)))
              (else (loop (cdr cs))))))

    ;; The update prompt's two boxes above the HUD and the UPDATE mark at
    ;; the HUD's right end, before the readout, for the web build's waiting update:
    ;; ((apply x y w h) (later x y w h) (update x y w h)).
    (define (update-controls g layout)
      (let* ((vw (geometry-vw g))
             (top (- (geometry-vh g) (geometry-hud-h g)))
             (mid (half vw)))
        (list (list 'apply (- mid 130) (- top 44) 120 26)
              (list 'later (+ mid 10) (- top 44) 120 26)
              (list 'update (- vw READOUT-RIGHT-INSET READOUT-W 8 110) (+ top CONTROL-Y) 110 CONTROL-H))))

    (define (hit-update-control g layout x y)
      (let loop ((cs (update-controls g layout)))
        (cond ((null? cs) #f)
              ((rect-contains? (cdr (car cs)) x y) (car (car cs)))
              (else (loop (cdr cs))))))

    ;; --- the window, and where the viewport sits in it --------------------

    ;; A pixel of the frame (window natively, canvas buffer on the web) to a
    ;; virtual pixel, undoing the centered letterbox sigil-graphics applies
    ;; when it fits vw x vh into fw x fh by min(fw/vw, fh/vh). Both shells
    ;; convert their pointer through this one definition. The forward map
    ;; lives in sigil-graphics (graphics.c), which exports no inverse; if it
    ;; ever grows one, this is the procedure to delete.
    (define (frame->virtual fw fh vw vh x y)
      (let* ((scale (min (/ fw vw) (/ fh vh)))
             (ox (/ (- fw (* vw scale)) 2))
             (oy (/ (- fh (* vh scale)) 2)))
        (cons (/ (- x ox) scale)
              (/ (- y oy) scale))))))
