;;; (crash menu) - The menu: its screens, their rows, and what a choice is.
;;;
;;; The real menu (P4, rulings D14 and D19): a DOOM-style list of items
;;; set in the block alphabet, one highlighted, on a stack of screens.
;;; The top screen is JACK IN / FREE PLAY / SETTINGS / CREDITS, with
;;; CONTINUE first when a board or a run is live and UPDATE last when
;;; the page says a version is waiting. FREE PLAY lists the games
;;; (STACK, DEFRAG), a share code and the high scores; a
;;; game's own screen (D66) offers NEW BOARD, DAILY BOARD and the
;;; VERSION to deal (HACKER, the trace on; CLASSIC, the classic with its
;;; timer), remembered per game; SETTINGS holds (crash settings)' rows;
;;; CREDITS and SCORES are screens the draw fills; CODE takes a share
;;; code from the keyboard or a keypad.
;;;
;;; The shell decides which top entries are shown and what a choice does;
;;; this module holds every screen's entries as data, moves the
;;; highlight on keys, steps a value row on left/right, Enter or a tap,
;;; picks on Enter, Space or a tap, opens and closes the sub-screens,
;;; and says where each row and keypad cell is drawn so (crash title
;;; draw) and the tap agree. A frame answers (cons menu choice); a
;;; choice is a symbol the shell acts on (continue, jack-in, stack,
;;; cards, daily-stack, daily-cards, update, copy, code-refused),
;;; (set ID . VALUE) when a setting stepped (the shell stores and
;;; applies it), (version TABLE . VALUE) when a game's VERSION row
;;; stepped (the shell stores it), or (code . SPEC) when a share code
;;; was entered and read. Nothing here reads a platform.
;;;
;;; The title (P3d, ruling D38) lives here too: the menu carries a
;;; (crash title) state, steps it once per frame, and while its reveal
;;; runs any tap or key skips the reveal instead of reaching the entries.
;;; The reveal plays once per boot: the shell hands the first menu a seed
;;; (?seed=N on the web, the clock otherwise) and every later menu none,
;;; which opens it settled.

(define-library (crash menu)
  (import (sigil struct)
          (sigil math)
          (crash input)
          (crash title)
          (crash settings)
          (crash credits)
          (crash code))

  (export menu menu? menu-new menu-screen menu-entries menu-highlight menu-frames menu-ms menu-cursor-on? menu-y-offset OVERLAY-PAD CODE-LINE-H UNDER-ROW-GAP NOTE-H
          menu-title menu-with-title menu-settings menu-with-settings
          menu-version menu-versions menu-with-version menu-with-versions menu-scan-size menu-with-scan-size menu-code-line menu-with-code-line menu-copy menu-code menu-page
          menu-scores menu-with-scores menu-run menu-open-run-done
          menu-news menu-news-seen menu-with-news menu-news-unread? menu-news-newest-date menu-post menu-row-label
          menu-new-overlay menu-new-layer-done menu-home menu-table menu-row-note
          menu-step menu-entry-rect menu-heading-y menu-hit menu-cues menu-live?
          menu-label menu-row-value menu-row-kind menu-heading menu-code-display
          code-line-rect now-playing-rect menu-now-playing keypad-cells keypad-rect keypad-hit
          MENU-ENTRIES MENU-TITLE SCREENS
          ENTRY-W ENTRY-H ENTRY-GAP ENTRIES-Y SUB-ENTRIES-Y HEADING-Y CODE-LINE-Y VALUE-ROW-W TEXT-ROWS-Y TEXT-SCREENS
          menu-credits menu-with-credits menu-scroll menu-crawl-rows menu-crawl-height)

  (begin
    (define MENU-TITLE "CRASH THE STACK")

    ;; Every entry any screen can show, with its label. Built with list,
    ;; not quoted: on the web build (2026-09-19, S8) a quoted literal came
    ;; out of module load with its first four entries overwritten by
    ;; symbol-table garbage while a list built at init was intact (a
    ;; sigil wasm runtime bug in how literal constants are rooted).
    (define MENU-ENTRIES
      (list (list 'continue "CONTINUE")
            (list 'jack-in "JACK IN")
            (list 'free-play "FREE PLAY")
            (list 'settings "SETTINGS")
            (list 'credits "CREDITS")
            (list 'update "UPDATE")
            (list 'news "NEWS")   ; P4b (D20): the news posts, beside UPDATE; NEW while unread
            (list 'stack "STACK")
            (list 'cards "DEFRAG")
            (list 'scan "SCAN")               ; 0.1.3: SCAN, the third game (CLASSIC)
            (list 'size "SIZE")               ; SCAN's preset: LAN | WAN | BACKBONE (D72), remembered
            (list 'new-board "NEW BOARD")     ; a game's screen (D66): the next board of the game
            (list 'daily-board "DAILY BOARD")  ; the game's daily
            (list 'code "ENTER CODE")     ; (David, 2026-09-22: the two-word items)
            (list 'scores "HIGH SCORES")
            (list 'version "VERSION")
            (list 'back "BACK")
            ;; the table's overlay (ruling D51)
            (list 'resume "RESUME")
            (list 'game-settings "GAME SETTINGS")
            (list 'share "CODE")
            (list 'disconnect "DISCONNECT")
            (list 'back-to-menu "BACK TO MENU")
            (list 'next-layer "NEXT LAYER")
            ;; JACK IN's pick (D65): the run's difficulty, the daemons' pace
            (list 'easy "EASY")
            (list 'normal "NORMAL")
            (list 'elite "ELITE")
            (list 'exit "EXIT")))   ; the native build's last row: it quits the process (David, 2026-09-21); not on the web

    ;; The screens: each with its entries in order and its heading (the
    ;; top screen has the logo instead).
    (define SCREENS
      (list (list 'top #f 'continue 'jack-in 'free-play 'settings 'credits 'update 'news 'exit)
            ;; NEWS (P4b, D20): the posts as rows (post-N ids, filled by open-screen
            ;; from the menu's news), each opening the post outside the game
            (list 'news "NEWS" 'back)
            ;; FREE PLAY (D66): the games first, each opening its own screen
            (list 'free "FREE PLAY" 'stack 'cards 'scan 'code 'scores 'back)
            ;; a game's screen: its next board, its daily, its version (a
            ;; value row the shell remembers per game), BACK to FREE PLAY
            (list 'free-stack "STACK" 'new-board 'daily-board 'version 'back)
            (list 'free-cards "DEFRAG" 'new-board 'daily-board 'version 'back)
            ;; SCAN is CLASSIC only until HACKER's trace lands (P6c): SIZE in
            ;; place of VERSION
            (list 'free-scan "SCAN" 'new-board 'daily-board 'size 'back)
            (list 'settings "SETTINGS" 'back)   ; the general rows (D51), filled from (crash settings)' group by open-screen
            (list 'credits "CREDITS")   ; the crawl: no rows; Escape, Backspace or a tap leaves
            (list 'scores "HIGH SCORES" 'back)
            (list 'code "ENTER CODE" 'back)
            (list 'run-done "RUN COMPLETE" 'back)
            ;; JACK IN (D65): the difficulty picked before the run, NORMAL preselected
            (list 'jack-in "JACK IN" 'easy 'normal 'elite 'back)
            ;; the table's overlay (D51): its own home screen over the paused
            ;; table; the exit row is disconnect in a run, back-to-menu else
            (list 'pause "PAUSED" 'resume 'game-settings 'settings 'disconnect 'back-to-menu)   ; the code is a line under the rows, not a row (David, 2026-09-21)
            ;; GAME SETTINGS: the table's rows, filled per table by open-screen
            (list 'pause-game "GAME SETTINGS" 'back)
            ;; a run's layer cleared (David, 2026-09-21): the ledger so far
            ;; over the cleared table, NEXT LAYER the one action (the shell
            ;; pulls it itself after a few seconds)
            (list 'run-layer "LAYER CLEARED" 'next-layer)))


    (define (screen-entries screen)
      (let ((e (assq screen SCREENS)))
        (if e (cddr e) '())))

    ;; The overlay's home rows for a table in or out of a run: the exit
    ;; row by context, and GAME SETTINGS only where the table has rows
    ;; (DEFRAG; the stack has none).
    (define (pause-entries table run?)
      (filter (lambda (id)
                (and (not (eq? id (if run? 'back-to-menu 'disconnect)))
                     (or (not (eq? id 'game-settings)) (pair? (settings-group table)))))
              (screen-entries 'pause)))

    (define (menu-heading m)
      (let ((e (assq (menu-screen m) SCREENS)))
        (and e (cadr e))))

    ;; The entries sit under the logo (TITLE-Y + TITLE-H is 120 on the
    ;; 14-row grid) with the backdrop's tower showing between (ruling D39:
    ;; no boxes, plain text, the selected one in the hero ramp with a
    ;; blinking cursor at its left; D41: set in the block alphabet at 4 px
    ;; cells, 24 px tall plus the shadow): six of them at 28 + 4 from y 168
    ;; end at 356, above the bottom band (BAND-Y, 376). A sub-screen
    ;; replaces the logo with its heading, HEADING-Y over SUB-ENTRIES-Y as
    ;; the base, and the pair slides down so the first row lands where the
    ;; main menu's does (David, 2026-09-22: the sub-screens sat too high),
    ;; as far as the rows fit above the band: rows-y. The rects are the tap targets;
    ;; 440 wide fits the longest centered label (CONNECTING 0/6 is 14
    ;; glyphs, 444 px, so it overhangs by 2); a value row spans the width
    ;; less the gutters, its name left and its value right.
    (define ENTRY-W 440)
    (define ENTRY-H 28)
    (define ENTRY-GAP 4)
    (define ENTRIES-Y 168)
    (define SUB-ENTRIES-Y 56)
    (define BAND-Y 376)
    (define ROWS-MIN-Y 124)   ; the logo's foot (120) plus air: a top screen of eight rows starts here
    (define HEADING-Y 16)
    (define VALUE-ROW-W 600)
    ;; the live board's share code under the top screen's items
    (define CODE-LINE-Y 360)
    ;; the text screens (CREDITS, SCORES, CODE) keep their rows at the bottom, under their content
    (define TEXT-ROWS-Y 340)
    (define TEXT-SCREENS (list 'credits 'scores 'code 'run-done 'run-layer))

    (define-struct menu
      (screen default: 'top)     ; top | free | settings | credits | scores | code
      (entries default: '())     ; the ids shown, in order
      (highlight default: 0)     ; index into entries
      (top-entries default: '()) ; the top screen's ids, kept while a sub-screen is up
      (settings default: '())    ; the settings in force, (crash settings)' alist
      (versions default: '())    ; the version to deal per game, ((stack . V) (cards . V)), V hacker | original; absent means hacker (D66)
      (scan-size default: 'lan)  ; SCAN's SIZE row: lan | wan | backbone (D72), remembered by the shell
      (code-line default: #f)    ; the live board's share code (ten characters), or #f
      (copy default: #f)         ; the code line offers COPY (the web: the page writes the clipboard)
      (now-playing default: #f)  ; the soundtrack's title under the code line (M1: the note glyph and the title), or #f
      (code default: "")         ; the CODE screen's typed characters
      (page default: 0)          ; unused since the crawl (kept for the datum's shape)
      (credits default: '())     ; the CREDITS crawl's items, (crash credits)' parse, set by the shell
      (crawl default: #f)        ; the crawl laid out once: (height . rows), or #f until the items are in
      (scroll default: 0.0)      ; the crawl's offset, px
      (scores default: #f)       ; the scoreboard for the SCORES screen, or #f
      (run default: #f)          ; the finished run for the RUN COMPLETE screen (ledger, seed), or #f
      (title default: #f)        ; the title's reveal state, (crash title)
      (home default: 'top)       ; the screen a sub-screen closes to: top, or pause for the table's overlay
      (table default: #f)        ; the overlay's table (stack | cards): its GAME SETTINGS rows
      (y-offset default: 0)      ; the overlay's rows and heading shifted down to center its panel on the table
      (news default: '())        ; P4b: the news posts, newest first, each (title date url); '() until the page hands them over
      (news-seen default: "")    ; the newest post's date the player has seen (the store's news-seen key); "" for none
      (frames default: 0)        ; menu frames so far
      (ms default: 0.0))         ; milliseconds so far: the cursor's blink (the same at 60 and 120 Hz)

    (define (menu-with-title m t) (menu m title: t))
    (define (menu-with-settings m s) (menu m settings: s))
    (define (menu-with-code-line m code . rest)
      (menu m code-line: code copy: (and (pair? rest) (car rest) #t)))
    (define (menu-with-scores m s) (menu m scores: s))

    ;; --- the version per game (D66) ------------------------------------------
    ;; hacker (the trace on) or original (the classic, CLASSIC on the row),
    ;; remembered per game: the shell stores a step and hands the pairs
    ;; back through menu-with-versions at the next menu.
    (define (menu-version m table)
      (let ((e (assq table (menu-versions m))))
        (if e (cdr e) 'hacker)))
    (define (menu-with-version m table v)
      (menu m versions: (cons (cons table v)
                              (filter (lambda (e) (not (eq? (car e) table))) (menu-versions m)))))
    (define (menu-with-versions m pairs) (menu m versions: pairs))
    ;; SCAN's preset (D72), the SIZE row: the shell stores a step (size . P)
    ;; and hands it back through menu-with-scan-size at the next menu.
    (define SCAN-SIZES (list 'lan 'wan 'backbone))
    (define (menu-with-scan-size m p)
      (menu m scan-size: (if (memq p SCAN-SIZES) p 'lan)))
    (define (scan-size-label p)
      (case p ((wan) "WAN") ((backbone) "BACKBONE") (else "LAN")))
    ;; Windows' names beside ours, in the row's note
    (define (scan-size-note p)
      (case p ((wan) "INTERMEDIATE. 16X16, 40 ICE.") ((backbone) "EXPERT. 30X16, 99 ICE.") (else "BEGINNER. 9X9, 10 ICE.")))
    (define (next-scan-size p delta)
      (let* ((n (length SCAN-SIZES))
             (i (let loop ((ps SCAN-SIZES) (i 0))
                  (cond ((null? ps) 0) ((eq? (car ps) p) i) (else (loop (cdr ps) (+ i 1)))))))
        (list-ref SCAN-SIZES (modulo (+ i delta) n))))
    ;; The game a screen belongs to: the game screens' table, else #f.
    (define (screen-table m)
      (case (menu-screen m)
        ((free-stack) 'stack)
        ((free-cards) 'cards)
        ((free-scan) 'scan)
        (else #f)))

    ;; --- NEWS (P4b, ruling D20) -------------------------------------------------
    ;; The posts the page read from the site's JSON Feed (newest first) and
    ;; the last seen date; the row shows NEW while the newest post's date is
    ;; later than the seen one. A post's row id is post-N.
    (define (menu-with-news m posts seen)
      (menu m news: posts news-seen: (or seen "")))
    (define (menu-news-unread? m)
      (and (pair? (menu-news m))
           (date-after? (cadr (car (menu-news m))) (menu-news-seen m))))
    ;; a later than b, comparing the ISO dates character by character (they
    ;; sort lexicographically). Written here rather than taken from (sigil
    ;; string): this module is in the rules family, whose imports are
    ;; (sigil struct), (sigil math), (sigil list) and its own kin, and
    ;; test-imports holds that line.
    (define (date-after? a b)
      (let ((la (string-length a))
            (lb (string-length b)))
        (let loop ((i 0))
          (cond ((>= i la) #f)
                ((>= i lb) #t)
                ((char<? (string-ref b i) (string-ref a i)) #t)
                ((char<? (string-ref a i) (string-ref b i)) #f)
                (else (loop (+ i 1)))))))
    (define (menu-news-newest-date m)
      (if (pair? (menu-news m)) (cadr (car (menu-news m))) ""))
    (define (post-id i) (string->symbol (string-append "post-" (number->string i))))
    (define (post-ids posts)
      (let loop ((i 0) (acc '()))
        (if (>= i (length posts)) (reverse acc) (loop (+ i 1) (cons (post-id i) acc)))))
    ;; The post a row id names, (title date url), or #f.
    (define (menu-post m id)
      (let ((text (symbol->string id)))
        (and (> (string-length text) 5)
             (string=? (substring text 0 5) "post-")
             (let ((i (string->number (substring text 5 (string-length text)))))
               (and i (< i (length (menu-news m))) (list-ref (menu-news m) i))))))
    ;; The NEWS screen opened: every post's date is seen now (the shell
    ;; writes the store's key from menu-news-newest-date).
    (define (menu-news-seen! m)
      (menu m news-seen: (menu-news-newest-date m)))
    (define (menu-with-credits m items)
      (menu m credits: items crawl: (cons (credits-height items) (credits-layout items))))
    (define (menu-crawl-height m) (if (menu-crawl m) (car (menu-crawl m)) 0))
    (define (menu-crawl-rows m) (if (menu-crawl m) (cdr (menu-crawl m)) '()))

    ;; The RUN COMPLETE screen over the top screen, showing r (the shell
    ;; opens it when the last layer is cleared and NEXT is asked for).
    (define (menu-open-run-done m r)
      (menu (open-screen m (quote run-done)) run: r))

    (define (menu-label id)
      (let ((entry (assq id MENU-ENTRIES)))
        (cond (entry (cadr entry))
              ((setting-ref id) (setting-name (setting-ref id)))
              (else "?"))))

    ;; A row's label with the menu in hand: a post's row is its title (the
    ;; small font on the NEWS screen draws it), anything else menu-label.
    (define (menu-row-label m id)
      (let ((post (and (eq? (menu-screen m) 'news) (menu-post m id))))
        (if post (car post) (menu-label id))))

    ;; item (a choice) or value (a row that steps). The overlay's exit row
    ;; and its CODE row show a value but pick as items.
    (define (menu-row-kind m id)
      (if (or (eq? id 'version) (eq? id 'size) (setting-ref id)) 'value 'item))   ; NEWS shows a value (NEW) but is an item: Enter opens it

    ;; The value a row shows, as text, or #f for a plain item.
    (define (menu-row-value m id)
      (cond ((eq? id 'version) (if (eq? (menu-version m (or (screen-table m) 'stack)) 'original) "CLASSIC" "HACKER"))
            ((eq? id 'size) (scan-size-label (menu-scan-size m)))
            ((eq? id 'news) (and (menu-news-unread? m) "NEW"))   ; P4b: the unread mark
            ((and (eq? (menu-screen m) 'news) (menu-post m id)) (cadr (menu-post m id)))   ; a post's date
            ((setting-ref id) (setting-value-label id (settings-value (menu-settings m) id)))
            (else #f)))

    ;; The note on a row, in the small font: beside a GAME SETTINGS value,
    ;; when the change takes; on the overlay's exit row, what leaving
    ;; keeps, so DISCONNECT never reads as loss (D51; a block-font value
    ;; beside BACK TO MENU would not fit the row).
    (define (menu-row-note m id)
      (cond ((eq? id 'disconnect) "RUN HELD. CONTINUE RESUMES THE LAYER.")
            ((eq? id 'back-to-menu) "BOARD SAVED. CONTINUE RESUMES IT.")
            ((eq? id 'size) (scan-size-note (menu-scan-size m)))
            ((and (eq? (menu-screen m) 'pause-game) (setting-ref id))
             (if (eq? (setting-when id) 'next-deal) "NEXT DEAL" "NOW"))
            (else #f)))

    (define (dashed code)
      (if (> (string-length code) 5)
          (string-append (substring code 0 5) "-" (substring code 5 (string-length code)))
          code))

    ;; The CODE screen's text as shown: the typed characters with a dash
    ;; after the fifth.
    (define (menu-code-display m) (dashed (menu-code m)))

    ;; The table's overlay (ruling D51): RESUME, GAME SETTINGS, SETTINGS,
    ;; CODE and the context's exit row over a paused table. No title; the
    ;; settings in force; the live board's code (copy? on the web).
    ;; A run's layer cleared: the ledger over the table with NEXT LAYER.
    ;; r: the run as advanced by the clear (its layer is the next one).
    (define (menu-new-layer-done table r code)
      (menu screen: 'run-layer
            entries: (screen-entries 'run-layer)
            top-entries: (screen-entries 'run-layer)
            highlight: 0
            home: 'run-layer
            table: table
            run: (cons r code)))

    ;; rest: the soundtrack's title for the title line (M1: a note glyph then the title), or nothing
    (define (menu-new-overlay table run? settings code-line copy? . rest)
      (let ((ids (pause-entries table run?)))
        (overlay-centered
         (menu screen: 'pause
               entries: ids
               top-entries: ids
               highlight: 0
               home: 'pause
               table: table
               settings: settings
               code-line: code-line
               copy: copy?
               now-playing: (and (pair? rest) (car rest))))))

    ;; The top screen over the ids that are shown (unknown ids dropped,
    ;; the canonical order kept), highlighting the first of them, or the
    ;; id asked for when it is shown. seed: a number opens the title with
    ;; its reveal running from that seed; none (or #f) opens it settled.
    (define (menu-new shown . rest)
      (let* ((ids (filter (lambda (id) (memq id shown)) (screen-entries 'top)))
             (want (and (pair? rest) (car rest)))
             (seed (and (pair? rest) (pair? (cdr rest)) (cadr rest)))
             (at (index-of want ids))
             (t (title-new (or seed 1) (title-default-baud) (not seed))))
        (menu entries: ids
              top-entries: ids
              highlight: at
              settings: (settings-defaults)
              title: t)))

    (define (index-of want ids)
      (let loop ((ids ids) (i 0))
        (cond ((null? ids) 0)
              ((eq? (car ids) want) i)
              (else (loop (cdr ids) (+ i 1))))))

    ;; --- geometry ------------------------------------------------------------------

    ;; Where the top screen's and a sub-screen's first row sits: ENTRIES-Y,
    ;; pulled up only as far as the rows need to end above the band (a
    ;; top screen of seven or eight rows, NEWS with its posts, SETTINGS'
    ;; seven), never above the logo's foot.
    (define (rows-y m)
      (let ((n (length (menu-entries m))))
        (max ROWS-MIN-Y
             (min ENTRIES-Y (- (+ BAND-Y ENTRY-GAP) (* n (+ ENTRY-H ENTRY-GAP)))))))

    ;; The overlay's sub-screens and the text screens keep their rows in
    ;; their own places; the rest sit at rows-y.
    (define (own-rows? m)
      (or (memq (menu-screen m) TEXT-SCREENS) (eq? (menu-home m) 'pause)))

    ;; A sub-screen's heading: HEADING-Y over the rows' base, sliding with
    ;; them (the overlay and the text screens keep HEADING-Y).
    (define (menu-heading-y m)
      (+ HEADING-Y
         (if (own-rows? m) 0 (- (rows-y m) SUB-ENTRIES-Y))
         (menu-y-offset m)))

    ;; (x y w h) of the index-th row of the menu's screen.
    (define (menu-entry-rect m index vw vh)
      (let* ((ids (menu-entries m))
             (id (and (< index (length ids)) (list-ref ids index)))
             (value? (and id (menu-row-value m id) #t))
             (w (if value? VALUE-ROW-W ENTRY-W)))
        (list (quotient (- vw w) 2)
              (+ (cond ((memq (menu-screen m) TEXT-SCREENS) TEXT-ROWS-Y)
                       ((eq? (menu-home m) 'pause) (+ SUB-ENTRIES-Y PAUSE-HEADING-GAP))   ; a row of air under the heading (David)
                       (else (rows-y m)))
                 (* index (+ ENTRY-H ENTRY-GAP))
                 (menu-y-offset m))
              w
              ENTRY-H)))

    ;; The overlay's panel centered on the table (David, 2026-09-21): the
    ;; rows' block (the heading to the last row, plus the code line on the
    ;; home screen) shifted so its middle is the board area's middle.
    (define OVERLAY-AREA-H 352)   ; the viewport above the HUD bar
    (define PAUSE-HEADING-GAP (quotient ENTRY-H 2))   ; half a row of air under PAUSED (David: a full row was too much with the small rows)
    (define OVERLAY-PAD 12)
    (define CODE-LINE-H 16)
    (define (overlay-centered m)
      (let* ((n (length (menu-entries m)))
             (top (- HEADING-Y OVERLAY-PAD))
             (last-bottom (+ SUB-ENTRIES-Y PAUSE-HEADING-GAP (* n (+ ENTRY-H ENTRY-GAP)) (- ENTRY-GAP)))
             (bottom (+ last-bottom
                        (if (eq? (menu-screen m) 'pause) (+ UNDER-ROW-GAP NOTE-H (if (menu-code-line m) CODE-LINE-H 0) (if (menu-now-playing m) CODE-LINE-H 0)) 0)
                        OVERLAY-PAD))
             (h (- bottom top)))
        (menu m y-offset: (- (quotient (- OVERLAY-AREA-H h) 2) top))))

    (define (rect-contains? r x y)
      (and (>= x (car r)) (< x (+ (car r) (caddr r)))
           (>= y (cadr r)) (< y (+ (cadr r) (cadddr r)))))

    ;; The index of the row under a point, or #f.
    (define (menu-hit m vw vh x y)
      (let loop ((i 0))
        (cond ((= i (length (menu-entries m))) #f)
              ((rect-contains? (menu-entry-rect m i vw vh) x y) i)
              (else (loop (+ i 1))))))

    ;; The live board's code line: (x y w h) under the items, or #f.
    ;; The live board's code line: on the overlay's home screen only
    ;; (David, 2026-09-21: not on the main menu), a full row's height under
    ;; the last row and its note, inside the panel.
    (define (code-line-rect m vw vh)
      (and (menu-code-line m)
           (eq? (menu-screen m) 'pause)
           (let* ((n (length (menu-entries m)))
                  (last (menu-entry-rect m (- n 1) vw vh)))
             (list (quotient (- vw 400) 2) (+ (cadr last) (cadddr last) UNDER-ROW-GAP NOTE-H) 400 CODE-LINE-H))))

    ;; The title line (M1; a note glyph then the title): the soundtrack's title under the code
    ;; line (under the note when there is no code line), the code line's
    ;; height; on the pause screen only. (x y w h) or #f.
    (define (now-playing-rect m vw vh)
      (and (menu-now-playing m)
           (eq? (menu-screen m) 'pause)
           (let* ((n (length (menu-entries m)))
                  (last (menu-entry-rect m (- n 1) vw vh))
                  (code (code-line-rect m vw vh)))
             (list (quotient (- vw 400) 2)
                   (if code (+ (cadr code) (cadddr code)) (+ (cadr last) (cadddr last) UNDER-ROW-GAP NOTE-H))
                   400 CODE-LINE-H))))

    ;; the small lines under the last row: a row's height of air first, then
    ;; the exit row's note, then the code line
    (define UNDER-ROW-GAP ENTRY-H)
    (define NOTE-H 12)

    ;; The CODE screen's keypad: the alphabet in four rows of eight under
    ;; the typed line, then DEL and GO. Cells 56 wide at a 64 pitch (the
    ;; row is 8 * 64 - 8 = 504), 28 tall at a 32 pitch, from y 124.
    (define KEYPAD-X 68)
    (define KEYPAD-Y 124)
    (define KEYPAD-CELL-W 56)
    (define KEYPAD-CELL-H 28)
    (define KEYPAD-PITCH-X 64)
    (define KEYPAD-PITCH-Y 32)

    ;; ((label x y w h) ...): one per character of the alphabet, then DEL and GO.
    (define (keypad-cells vw vh)
      (let loop ((i 0) (acc '()))
        (if (= i 32)
            (reverse (cons (list "GO" (+ KEYPAD-X (* 4 KEYPAD-PITCH-X)) (+ KEYPAD-Y (* 4 KEYPAD-PITCH-Y)) (- (* 4 KEYPAD-PITCH-X) 8) KEYPAD-CELL-H)
                           (cons (list "DEL" KEYPAD-X (+ KEYPAD-Y (* 4 KEYPAD-PITCH-Y)) (- (* 4 KEYPAD-PITCH-X) 8) KEYPAD-CELL-H)
                                 acc)))
            (loop (+ i 1)
                  (cons (list (string (string-ref ALPHABET i))
                              (+ KEYPAD-X (* (modulo i 8) KEYPAD-PITCH-X))
                              (+ KEYPAD-Y (* (quotient i 8) KEYPAD-PITCH-Y))
                              KEYPAD-CELL-W
                              KEYPAD-CELL-H)
                        acc)))))

    (define (keypad-rect label vw vh)
      (let ((cell (assoc label (keypad-cells vw vh))))
        (and cell (cdr cell))))

    ;; The keypad label under a point, or #f.
    (define (keypad-hit vw vh x y)
      (let loop ((cells (keypad-cells vw vh)))
        (cond ((null? cells) #f)
              ((rect-contains? (cdr (car cells)) x y) (car (car cells)))
              (else (loop (cdr cells))))))

    ;; --- stepping ----------------------------------------------------------------

    (define (pressed? f key) (and (memq key (input-frame-pressed f)) #t))
    (define (held? f key) (and (memq key (input-frame-held f)) #t))

    (define (move m delta)
      (let ((n (length (menu-entries m))))
        (if (= n 0)
            m
            (menu m highlight: (modulo (+ (menu-highlight m) delta) n)))))

    (define (highlighted m)
      (let ((ids (menu-entries m)))
        (and (pair? ids) (list-ref ids (menu-highlight m)))))

    ;; Is the menu live: the reveal settled and every boot step done
    ;; (ruling D40)? Until then the items are not drawn and no input
    ;; reaches them.
    (define (menu-live? m)
      (let ((t (menu-title m)))
        (and (or (not t) (title-settled? t))
             (boot-done?))))

    ;; A sub-screen opened over the home screen, its first row highlighted;
    ;; GAME SETTINGS takes the overlay's table's rows.
    (define (open-screen m screen)
      (let ((o (open-screen* m screen)))
        (if (eq? (menu-home m) 'pause) (overlay-centered o) o)))   ; the overlay's sub-screens are centered too

    (define (open-screen* m screen)
      (menu m screen: screen
              entries: (cond ((eq? screen 'pause-game)
                              (append (settings-group (or (menu-table m) 'stack)) (list 'back)))
                             ((eq? screen 'settings)
                              (append (settings-group 'general) (list 'back)))
                             ;; NEWS (P4b): a row per post, newest first, then BACK
                             ((eq? screen 'news)
                              (append (post-ids (menu-news m)) (list 'back)))
                             (else (screen-entries screen)))
              highlight: 0
              code: ""
              page: 0
              scroll: 0.0
              y-offset: 0))

    ;; Back to the home screen, the item that opened the sub-screen highlighted.
    (define (close-screen m)
      (let ((opener (case (menu-screen m)
                      ((free-stack free-cards free-scan) #f)   ; below: a game's screen closes to FREE PLAY
                      ((free) 'free-play)
                      ((settings) 'settings)
                      ((credits) 'credits)
                      ((news) 'news)
                      ((scores code) 'free-play)
                      ((run-done jack-in) 'jack-in)
                      ((pause-game) 'game-settings)
                      (else #f))))
        (if (screen-table m)
            (let ((f (open-screen m 'free)))   ; the game's row highlighted
              (menu f highlight: (index-of (screen-table m) (menu-entries f))))
            (let ((c (menu m screen: (menu-home m)
                             entries: (menu-top-entries m)
                             highlight: (index-of opener (menu-top-entries m))
                             y-offset: 0)))
              (if (eq? (menu-home m) 'pause) (overlay-centered c) c)))))

    ;; A value row stepped by delta: the game's version flips and the
    ;; choice says so (the shell stores it per game); a setting steps and
    ;; the choice says so.
    (define (step-value m id delta)
      (cond ((eq? id 'version)
             (let ((table (or (screen-table m) 'stack)))
               (let ((v (if (eq? (menu-version m table) 'hacker) 'original 'hacker)))
                 (cons (menu-with-version m table v) (cons 'version (cons table v))))))
            ((eq? id 'size)
             (let ((p (next-scan-size (menu-scan-size m) delta)))
               (cons (menu m scan-size: p) (cons 'size p))))
            ((setting-ref id)
             (let ((s (settings-step (menu-settings m) id delta)))
               (cons (menu m settings: s) (cons 'set (cons id (settings-value s id))))))
            (else (cons m #f))))

    ;; The highlighted row picked (Enter, Space, a tap): an item is the
    ;; choice, a screen opener opens it, BACK closes, a value row steps.
    (define (pick m)
      (let ((id (highlighted m)))
        (cond ((not id) (cons m #f))
              ((eq? (menu-row-kind m id) 'value) (step-value m id 1))
              ((eq? id 'free-play) (cons (open-screen m 'free) #f))
              ((eq? id 'jack-in) (cons (menu (open-screen m 'jack-in) highlight: 1) #f))   ; NORMAL preselected (D65)
              ;; a game's row on FREE PLAY opens its screen (D66); its rows are the choices
              ((and (eq? (menu-screen m) 'free) (eq? id 'stack)) (cons (open-screen m 'free-stack) #f))
              ((and (eq? (menu-screen m) 'free) (eq? id 'cards)) (cons (open-screen m 'free-cards) #f))
              ((and (eq? (menu-screen m) 'free) (eq? id 'scan)) (cons (open-screen m 'free-scan) #f))
              ((eq? id 'new-board) (cons m (or (screen-table m) 'stack)))
              ((eq? id 'daily-board) (cons m (case (screen-table m) ((cards) 'daily-cards) ((scan) 'daily-scan) (else 'daily-stack))))
              ((eq? id 'settings) (cons (open-screen m 'settings) #f))
              ((eq? id 'game-settings) (cons (open-screen m 'pause-game) #f))
              ((eq? id 'credits) (cons (open-screen m 'credits) #f))
              ((and (eq? id 'news) (null? (menu-news m))) (cons m 'news))   ; no posts in hand: the shell opens the news page itself (the native build)
              ((eq? id 'news) (cons (menu-news-seen! (open-screen m 'news)) 'news-seen))   ; the shell stores the seen date
              ((and (eq? (menu-screen m) 'news) (menu-post m id))
               (cons m (cons 'open (caddr (menu-post m id)))))   ; the shell opens the post outside the game
              ((eq? id 'scores) (cons (open-screen m 'scores) #f))
              ((eq? id 'code) (cons (open-screen m 'code) #f))
              ((eq? id 'back) (cons (close-screen m) #f))
              (else (cons m id)))))

    ;; The CODE screen's own keys: a character of the alphabet appends
    ;; (ten at most), Backspace deletes, Enter reads the code (a valid
    ;; one is the choice; an invalid one is refused: the text stays, the
    ;; shell may say so), Escape closes. Keys are sigil-app's names:
    ;; a..z and 0..9 as one-character symbols.
    (define (code-key m f)
      (let ((code (menu-code m)))
        (cond ((pressed? f 'escape) (cons (close-screen m) #f))
              ((pressed? f 'backspace)
               (cons (menu m code: (if (> (string-length code) 0) (substring code 0 (- (string-length code) 1)) code)) #f))
              ((pressed? f 'return) (code-go m))
              (else
               (let ((typed (find-typed (input-frame-pressed f))))
                 (if (and typed (< (string-length code) CODE-LENGTH))
                     (cons (menu m code: (string-append code typed)) #f)
                     (cons m #f)))))))

    ;; The first pressed key that is a character of the alphabet, as an
    ;; upper-case string, or #f.
    (define (find-typed pressed)
      (let loop ((ks pressed))
        (cond ((null? ks) #f)
              ((symbol? (car ks))
               (let ((text (symbol->string (car ks))))
                 (if (and (= (string-length text) 1)
                          (alphabet-char? (char-upcase (string-ref text 0))))
                     (string (char-upcase (string-ref text 0)))
                     (loop (cdr ks)))))
              (else (loop (cdr ks))))))

    (define (alphabet-char? c)
      (let loop ((i 0))
        (cond ((= i (string-length ALPHABET)) #f)
              ((char=? (string-ref ALPHABET i) c) #t)
              (else (loop (+ i 1))))))

    ;; GO: the typed code read; a valid one is the choice.
    (define (code-go m)
      (let ((spec (decode (menu-code m))))
        (if spec
            (cons m (cons 'code spec))
            (cons m 'code-refused))))

    ;; A tap on the CODE screen: the keypad first, then the rows.
    (define (code-tap m vw vh x y)
      (let ((label (keypad-hit vw vh x y)))
        (cond ((not label) (tap-rows m vw vh x y))
              ((string=? label "DEL") (code-key m (make-input-frame '(backspace) '() #f)))
              ((string=? label "GO") (code-go m))
              ((< (string-length (menu-code m)) CODE-LENGTH)
               (cons (menu m code: (string-append (menu-code m) label)) #f))
              (else (cons m #f)))))

    ;; A tap on a row picks it (a value row steps forward); on the live
    ;; board's code line, COPY; elsewhere nothing.
    (define (tap-rows m vw vh x y)
      (let ((i (menu-hit m vw vh x y))
            (line (code-line-rect m vw vh)))
        (cond (i (pick (menu m highlight: i)))
              ((and line (rect-contains? line x y)) (cons m 'copy))
              (else (cons m #f)))))

    ;; One frame: (cons menu choice). The title ticks first; while its
    ;; reveal runs, a tap or any key skips it and the frame ends there (a
    ;; tap meant to skip must not start a game); while the boot's steps
    ;; are still running, input reaches nothing. Then the CODE screen
    ;; takes its keys; else up/down (or k/j) move, left/right (or h/l)
    ;; step a value row, Enter or Space pick, Escape or Backspace close a
    ;; sub-screen (on the top screen Escape is CONTINUE when a board is
    ;; live: the pause menu closes), a tap on a row picks it at once.
    ;; The menu's cursor blinks on time, not frames (David, 2026-09-21: a
    ;; frame count blinked twice as fast on a 120 Hz display): the FT2/DOS
    ;; cadence, on for BLINK-ON of every BLINK-PERIOD milliseconds.
    (define BLINK-PERIOD 1060.0)
    (define BLINK-ON 530.0)
    (define (menu-cursor-on? m)
      (< (- (menu-ms m) (* BLINK-PERIOD (floor (/ (menu-ms m) BLINK-PERIOD)))) BLINK-ON))

    ;; rest: the frame's milliseconds (the shells' dt; 16.7 when not given).
    (define (menu-step m f vw vh . rest)
      (let* ((t (menu-title m))
             (running? (and t (title-running? t)))
             (t (and t (title-step t)))
             (dt-ms (if (pair? rest) (car rest) 16.7))
             (m (menu m title: t frames: (+ 1 (menu-frames m)) ms: (+ (menu-ms m) dt-ms)))
             (click (input-frame-click f))
             (top? (eq? (menu-screen m) (menu-home m))))   ; the home screen: top, or the overlay's pause
        (cond ((and t (title-gated? t) (or click (pair? (input-frame-pressed f))))
               ;; the gate (D42): the first tap or key opens the line, nothing else
               (cons (menu m title: (title-ungate t)) #f))
              ;; DIALING (D45): the boot's steps run under the meter; a tap does nothing
              ((and t (title-dialing? t)) (cons m #f))
              ((and t (title-in-card? t) (or click (pair? (input-frame-pressed f))))
               ;; the publisher card (D43): a tap or a key skips it, nothing else
               (cons (menu m title: (title-skip-card t)) #f))
              ((and running? (or click (pair? (input-frame-pressed f))))
               (cons (menu m title: (title-skip t)) #f))
              ((not (menu-live? m)) (cons m #f))
              ((eq? (menu-screen m) 'code)
               (if click (code-tap m vw vh (car click) (cdr click)) (code-key m f)))
              ((eq? (menu-screen m) 'credits) (credits-step m f dt-ms))
              (click (tap-rows m vw vh (car click) (cdr click)))
              ((or (pressed? f 'up) (pressed? f 'k)) (cons (move m -1) #f))
              ((or (pressed? f 'down) (pressed? f 'j)) (cons (move m 1) #f))
              ((or (pressed? f 'left) (pressed? f 'h)) (step-highlighted m -1))
              ((or (pressed? f 'right) (pressed? f 'l)) (step-highlighted m 1))
              ((or (pressed? f 'return) (pressed? f 'space)) (pick m))
              ((or (pressed? f 'escape) (and (pressed? f 'backspace) (not top?)))
               ;; on the home screen Escape is CONTINUE (the pause menu, D14) or
               ;; RESUME (the table's overlay, D51)
               (cond ((not top?) (cons (close-screen m) #f))
                     ((memq 'continue (menu-entries m)) (cons m 'continue))
                     ((memq 'resume (menu-entries m)) (cons m 'resume))
                     ((memq 'next-layer (menu-entries m)) (cons m 'next-layer))
                     (else (cons m #f))))
              (else (cons m #f)))))

    ;; The CREDITS crawl's frame: the offset climbs at the crawl's pace
    ;; (faster with Down held, backwards with Up held) and wraps past the
    ;; end; Escape, Backspace, Enter or a tap leaves.
    (define (credits-step m f dt-ms)
      (let* ((click (input-frame-click f))
             (speed (cond ((or (held? f 'down) (held? f 'j)) CRAWL-FAST)
                          ((or (held? f 'up) (held? f 'k)) CRAWL-BACK)
                          (else CRAWL-SPEED)))
             (span (+ (menu-crawl-height m) CRAWL-VH))
             (next (+ (menu-scroll m) (* speed (/ dt-ms 1000.0))))
             (next (cond ((>= next span) (- next span))
                         ((< next 0.0) (+ next span))
                         (else next))))
        (if (or click (pressed? f 'escape) (pressed? f 'backspace) (pressed? f 'return))
            (cons (close-screen m) #f)
            (cons (menu m scroll: next) #f))))

    ;; the crawl's visible span, px: the panel from under the heading to the bottom
    (define CRAWL-VH 336)

    ;; left/right on a value row steps it; on an item, nothing.
    (define (step-highlighted m delta)
      (let ((id (highlighted m)))
        (if (and id (eq? (menu-row-kind m id) 'value))
            (step-value m id delta)
            (cons m #f))))

    ;; The title's cues between two menu frames (a line began, a glitch
    ;; came on, the reveal settled) as the bank's cue names, for the shell
    ;; to play: modem for a line, the select blip for a glitch, the match
    ;; pings for the settle.
    ;; The menu's own cues (David, 2026-09-21: the menu never had them):
    ;; the select blip on a cursor move, the match cue on a pick or a
    ;; screen opening (rest: the frame's choice, or #f), the mismatch
    ;; buzz on BACK or Escape closing a screen. The title's reveal cues
    ;; first, while it runs.
    (define (menu-cues before after . rest)
      (let ((choice (and (pair? rest) (car rest)))
            (title (if (and (menu-title before) (menu-title after))
                       (map (lambda (c) (case c ((glitch) 'select) ((settle) 'match) (else c)))
                            (title-cues (menu-title before) (menu-title after)))
                       '())))
        (append title
                (cond ((not (eq? (menu-screen before) (menu-screen after)))
                       ;; a screen closed (to home, or a game's screen to FREE PLAY, D66) is
                       ;; the mismatch cue; one opened the match cue
                       (list (if (or (eq? (menu-screen after) (menu-home after))
                                     (and (screen-table before) (eq? (menu-screen after) 'free)))
                                 'mismatch
                                 'match)))
                      (choice (list (if (memq choice (list 'resume 'continue)) 'mismatch 'match)))
                      ((not (= (menu-highlight before) (menu-highlight after))) (list 'select))
                      (else '())))))))
