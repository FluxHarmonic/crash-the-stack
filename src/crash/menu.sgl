;;; (crash menu) - The first screen: which table, and the update.
;;;
;;; A menu is a list of entries, each an id and its label, with one
;;; highlighted. The shell decides which entries are shown (CONTINUE only
;;; when a saved game exists, UPDATE only when the page says one is
;;; waiting) and what a choice does; this module holds the entries as
;;; data, moves the highlight on keys, picks on Enter, Space or a tap, and
;;; says where each entry is drawn so (crash render) and the tap agree.
;;; Plain primitives look; P4 restyles it into the DOOM/Quake-style menu
;;; (ruling D14) without changing this shape. Nothing here reads a
;;; platform.
;;;
;;; The title (P3d, ruling D38) lives here too: the menu carries a
;;; (crash title) state, steps it once per frame, and while its reveal
;;; runs any tap or key skips the reveal instead of reaching the entries.
;;; The reveal plays once per boot: the shell hands the first menu a seed
;;; (?seed=N on the web, the clock otherwise) and every later menu none,
;;; which opens it settled.

(define-library (crash menu)
  (import (sigil struct)
          (sigil math)
          (crash input)
          (crash title))

  (export menu menu? menu-new menu-entries menu-highlight menu-frames
          menu-title menu-with-title
          menu-step menu-entry-rect menu-hit menu-cues menu-live?
          menu-label MENU-ENTRIES MENU-TITLE
          ENTRY-W ENTRY-H ENTRY-GAP ENTRIES-Y)

  (begin
    (define MENU-TITLE "CRASH THE STACK")

    ;; Every entry the menu can show, in order, with its label: the
    ;; tables, and UPDATE when the page says a version is waiting. P4's
    ;; menu (rulings D19, D14) extends this list; the prototype entries
    ;; that stepped a setting without leaving the menu (LOOK, HUD) went
    ;; with the polish row once their rulings landed (D32, D34).
    ;; Built with list, not quoted: on the web build (2026-09-19, S8) the
    ;; quoted literal came out of module load with its first four entries
    ;; overwritten by symbol-table garbage ("kept-length", "game-won?",
    ;; ...) while a list built at init was intact: a sigil wasm runtime
    ;; bug in how literal constants are rooted, reported to the leader.
    (define MENU-ENTRIES
      (list (list 'continue "CONTINUE")
            (list 'stack "STACK")
            (list 'cards "DEFRAG")
            (list 'update "UPDATE")))

    ;; The entries sit under the logo (TITLE-Y + TITLE-H is 120 on the
    ;; 14-row grid) with the backdrop's tower showing between (ruling D39:
    ;; no boxes, plain text, the selected one in the hero ramp with a
    ;; blinking cursor at its left; D41: set in the block alphabet at 4 px
    ;; cells, 24 px tall plus the shadow): four of them at 28 + 4 from y 168 reach
    ;; 292, above the footer. The rects are the tap targets; 440 wide fits
    ;; the longest label (CONNECTING 0/6 is 14 glyphs, 444 px, so it overhangs by 2).
    (define ENTRY-W 440)
    (define ENTRY-H 28)
    (define ENTRY-GAP 4)
    (define ENTRIES-Y 168)

    (define-struct menu
      (entries default: '())     ; the ids shown, in order
      (highlight default: 0)     ; index into entries
      (title default: #f)        ; the title's reveal state, (crash title)
      (frames default: 0))       ; menu frames so far, for the cursor's blink

    (define (menu-with-title m t)
      (menu m title: t))

    (define (menu-label id)
      (let ((entry (assq id MENU-ENTRIES)))
        (if entry (cadr entry) "?")))

    ;; The menu over the ids that are shown (unknown ids dropped, the
    ;; canonical order kept), highlighting the first of them, or the id
    ;; asked for when it is shown. seed: a number opens the title with its
    ;; reveal running from that seed; none (or #f) opens it settled.
    (define (menu-new shown . rest)
      (let* ((ids (filter (lambda (e) (memq (car e) shown)) MENU-ENTRIES))
             (ids (map car ids))
             (want (and (pair? rest) (car rest)))
             (seed (and (pair? rest) (pair? (cdr rest)) (cadr rest)))
             (at (let loop ((ids ids) (i 0))
                   (cond ((null? ids) 0)
                         ((eq? (car ids) want) i)
                         (else (loop (cdr ids) (+ i 1))))))
             (t (title-new (or seed 1) (title-default-baud) (not seed))))
        (menu entries: ids highlight: at title: t)))

    ;; (x y w h) of the index-th entry, centered on the viewport.
    (define (menu-entry-rect index vw vh)
      (list (quotient (- vw ENTRY-W) 2)
            (+ ENTRIES-Y (* index (+ ENTRY-H ENTRY-GAP)))
            ENTRY-W
            ENTRY-H))

    (define (rect-contains? r x y)
      (and (>= x (car r)) (< x (+ (car r) (caddr r)))
           (>= y (cadr r)) (< y (+ (cadr r) (cadddr r)))))

    ;; The index of the entry under a point, or #f.
    (define (menu-hit m vw vh x y)
      (let loop ((i 0))
        (cond ((= i (length (menu-entries m))) #f)
              ((rect-contains? (menu-entry-rect i vw vh) x y) i)
              (else (loop (+ i 1))))))

    (define (pressed? f key) (and (memq key (input-frame-pressed f)) #t))

    (define (move m delta)
      (let ((n (length (menu-entries m))))
        (if (= n 0)
            m
            (menu m highlight: (modulo (+ (menu-highlight m) delta) n)))))

    (define (highlighted m)
      (let ((ids (menu-entries m)))
        (and (pair? ids) (list-ref ids (menu-highlight m)))))

    ;; Is the menu live: the reveal settled and every boot step done
    ;; (ruling D40)? Until then the items are not drawn and no input
    ;; reaches them.
    (define (menu-live? m)
      (let ((t (menu-title m)))
        (and (or (not t) (title-settled? t))
             (boot-done?))))

    ;; One frame: (cons menu choice), choice the chosen id or #f. The
    ;; title ticks first; while its reveal runs, a tap or any key skips it
    ;; and the frame ends there (a tap meant to skip must not start a
    ;; game); while the boot's steps are still running, input reaches
    ;; nothing. Then up/down (or k/j) move, Enter or Space pick the
    ;; highlight, a tap on an entry picks it at once.
    (define (menu-step m f vw vh)
      (let* ((t (menu-title m))
             (running? (and t (title-running? t)))
             (t (and t (title-step t)))
             (m (menu m title: t frames: (+ 1 (menu-frames m))))
             (click (input-frame-click f)))
        (cond ((and t (title-gated? t) (or click (pair? (input-frame-pressed f))))
               ;; the gate (D42): the first tap or key opens the line, nothing else
               (cons (menu m title: (title-ungate t)) #f))
              ;; DIALING (D45): the boot's steps run under the meter; a tap does nothing
              ((and t (title-dialing? t)) (cons m #f))
              ((and t (title-in-card? t) (or click (pair? (input-frame-pressed f))))
               ;; the publisher card (D43): a tap or a key skips it, nothing else
               (cons (menu m title: (title-skip-card t)) #f))
              ((and running? (or click (pair? (input-frame-pressed f))))
               (cons (menu m title: (title-skip t)) #f))
              ((not (menu-live? m)) (cons m #f))
              ((and click (menu-hit m vw vh (car click) (cdr click)))
               => (lambda (i)
                    (let ((m (menu m highlight: i)))
                      (cons m (highlighted m)))))
              ((or (pressed? f 'up) (pressed? f 'k)) (cons (move m -1) #f))
              ((or (pressed? f 'down) (pressed? f 'j)) (cons (move m 1) #f))
              ((or (pressed? f 'return) (pressed? f 'space)) (cons m (highlighted m)))
              (else (cons m #f)))))

    ;; The title's cues between two menu frames (a line began, a glitch
    ;; came on, the reveal settled) as the bank's cue names, for the shell
    ;; to play: modem for a line, the select blip for a glitch, the match
    ;; pings for the settle.
    (define (menu-cues before after)
      (if (and (menu-title before) (menu-title after))
          (map (lambda (c) (case c ((glitch) 'select) ((settle) 'match) (else c)))
               (title-cues (menu-title before) (menu-title after)))
          '()))))
