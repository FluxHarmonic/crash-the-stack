;;; (crash credits) - The CREDITS / ABOUT screen's text, as data.
;;;
;;; Ruling D44: the licenses go where people look for them. This screen
;;; is the GPLv3 "appropriate legal notice": the code's license
;;; (GPL-3.0-or-later), the assets' (CC-BY-4.0), the reserved marks (the
;;; name, the logo, the title art, the Flux Harmonic mark), the AI
;;; content disclosure BYTE FOR BYTE as the design note approved it
;;; (test/test-credits holds DISCLOSURE to test/fixtures/disclosure.txt;
;;; the same text goes on the site and the repo, P4b), the engine and
;;; library credits per their licenses, and the version with the build's
;;; commit. Two pages: NOTICES and ABOUT. The draw wraps a paragraph to
;;; the screen; a line here is one line as written.
;;;
;;; The 5x7 font is one case, so the text shows in capitals; the strings
;;; here keep the approved case, which is what the gate compares.
;;; Rules family: no platform.

(define-library (crash credits)
  (import (sigil math))

  (export VERSION DISCLOSURE NOTICES-PAGE ABOUT-PAGE credits-page credits-lines wrap-text)

  (begin
    (define VERSION "0.1.0")

    ;; The design note's adapted in-game text ([[topics/cyber-casual-games-design]],
    ;; "Disclosure language"), verbatim.
    (define DISCLOSURE
      "I designed this game and I direct every part of how it's built. AI agents write most of the code from my direction; I review all of it, I play every build, and I decide what stays. The design, the art direction and the opinions are mine. If that's a dealbreaker for you, I understand! The source and the commit history are public, so you can see exactly how it was made.")

    ;; A page is a list of entries: (heading "TEXT") a heading line,
    ;; (line "TEXT") one line as written, (para "TEXT") a paragraph the
    ;; draw wraps, (gap) a blank line.
    (define NOTICES-PAGE
      (list (list 'heading "CRASH THE STACK")
            (list 'line "(C) 2026 DAVID WILSON - FLUX HARMONIC")
            (list 'gap)
            (list 'heading "LICENSES")
            (list 'para "Code: GPL-3.0-or-later. You can run, study, share and change it; a version you ship stays under the same license.")
            (list 'para "Art, audio and content packs: CC-BY-4.0. Reuse them with credit to David Wilson / Flux Harmonic.")
            (list 'para "Reserved, not licensed for reuse: the name Crash The Stack, the logo, the title art and the Flux Harmonic mark.")
            (list 'gap)
            (list 'heading "MADE WITH")
            (list 'line "SIGIL (BSD-3-CLAUSE) - SOKOL (ZLIB) - GLFW (ZLIB)")
            (list 'line "MINIAUDIO (MIT-0) - STB (MIT)")))

    (define ABOUT-PAGE
      (list (list 'heading "ABOUT")
            (list 'para DISCLOSURE)
            (list 'gap)
            (list 'line "SOURCE: CODEBERG.ORG/FLUXHARMONIC/CRASH-THE-STACK")
            (list 'line "PLAY: CRASHTHESTACK.COM")))

    (define (credits-page n)
      (if (= n 0) NOTICES-PAGE ABOUT-PAGE))

    ;; A paragraph wrapped at spaces into lines of at most width
    ;; characters (a word longer than the width stands alone).
    (define (wrap-text text width)
      (let loop ((words (split-words text)) (line "") (acc '()))
        (cond ((null? words)
               (reverse (if (string=? line "") acc (cons line acc))))
              ((string=? line "")
               (loop (cdr words) (car words) acc))
              ((<= (+ (string-length line) 1 (string-length (car words))) width)
               (loop (cdr words) (string-append line " " (car words)) acc))
              (else
               (loop words "" (cons line acc))))))

    (define (split-words text)
      (let loop ((cs (string->list text)) (word '()) (acc '()))
        (cond ((null? cs)
               (reverse (if (null? word) acc (cons (list->string (reverse word)) acc))))
              ((char=? (car cs) #\space)
               (loop (cdr cs) '() (if (null? word) acc (cons (list->string (reverse word)) acc))))
              (else (loop (cdr cs) (cons (car cs) word) acc)))))

    ;; The page's lines for a draw: ((style . "TEXT") ...), style heading
    ;; | line | gap, paragraphs wrapped at width characters. stamp: the
    ;; build's commit for the version line at the end of the ABOUT page.
    (define (credits-lines n width stamp)
      (let loop ((entries (credits-page n)) (acc '()))
        (if (null? entries)
            (reverse (if (= n 1)
                         (cons (cons 'line (string-append "VERSION " VERSION " (" stamp ")"))
                               (cons (cons 'gap "") acc))
                         acc))
            (let ((e (car entries)))
              (loop (cdr entries)
                    (case (car e)
                      ((heading) (cons (cons 'heading (cadr e)) acc))
                      ((line) (append (reverse (map (lambda (l) (cons 'line l)) (wrap-text (cadr e) width))) acc))
                      ((gap) (cons (cons 'gap "") acc))
                      ((para) (append (reverse (map (lambda (l) (cons 'line l)) (wrap-text (cadr e) width))) acc))
                      (else acc)))))))))
