;;; (crash glyphs) - The glyph sheets: 36 faces of 5x7 each, by name.
;;;
;;; The bible's section 3: four suits of eight pictograms (MEM blocks, PWR
;;; signals, TX links, DSK keys) and the four daemons, one glyph per face
;;; index, in the font's row format so (crash render) draws a face the way
;;; it draws a letter. Every sheet is a generated data module under
;;; (crash glyphs <sheet>) from assets/src/glyphs/<sheet>.txt (hand-drawn
;;; or shaped from a generator reference); this module is the registry
;;; the looks name sheets through. Data only: no platform, no drawing.

(define-library (crash glyphs)
  (import (sigil math)
          (crash stack rules)
          (crash glyphs a))

  (export SHEETS sheet-ref sheet-glyph sheet-name
          FACE-COUNT SUIT-SIZE DAEMON-FIRST
          face-suit daemon-face?)

  (begin
    ;; DAEMON-FIRST and daemon-face? are (crash stack rules)'s: the match
    ;; rule owns where the daemons start; this module only draws them.
    (define FACE-COUNT 36)
    (define SUIT-SIZE 8)

    ;; (name . vector-of-36-row-lists), the candidates in the tree.
    (define SHEETS
      (list (cons 'a SHEET-A)))

    (define SHEET-NAMES
      (list (cons 'a SHEET-A-NAMES)))

    (define (sheet-ref name)
      (let ((entry (assq name SHEETS)))
        (and entry (cdr entry))))

    ;; The seven rows of face on the sheet, or #f for an unknown sheet.
    (define (sheet-glyph name face)
      (let ((sheet (sheet-ref name)))
        (and sheet (vector-ref sheet face))))

    (define (sheet-name name face)
      (let ((entry (assq name SHEET-NAMES)))
        (and entry (vector-ref (cdr entry) face))))

    ;; 0..3 for a suit face, 4 for a daemon.
    (define (face-suit face)
      (if (daemon-face? face) 4 (quotient face SUIT-SIZE)))))
