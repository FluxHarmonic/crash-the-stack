;;; (crash store) - Crash's key-value store: Substratic's, named for Crash.
;;;
;;; The store was Crash's own module and is the ancestor of (substratic
;;; store kv); since t-90ec6b Crash uses Substratic's (the same code, plus
;;; set-store-app! and set-store-prefix!). This module is the one place
;;; Crash names itself to it: loading it sets the app to "crash-the-stack",
;;; so native saves stay in $XDG_DATA_HOME/crash-the-stack (or
;;; ~/.local/share/crash-the-stack, or %APPDATA%\crash-the-stack) whatever
;;; imports the store first. Without that, Substratic's default,
;;; "sigil-game", would move the directory and every native save would look
;;; lost (topics/substratic-adoption-survey, "Store"). No web prefix: every
;;; localStorage key stays where players' saves already are.
;;; test-store-root pins the directory and the key names.
;;;
;;; The verbs are Substratic's, re-exported unchanged; STORE-KEYS is Crash's.

(define-library (crash store)
  (import (substratic store kv))

  (export store-root set-store-root!
          store-get store-set! store-remove!
          store-read-datum store-write-datum!
          datum->text text->datum
          STORE-KEYS STORE-APP)

  (begin
    (define STORE-KEYS '("board" "settings"))

    ;; the data directory's name (native): Crash's since 0.1
    (define STORE-APP "crash-the-stack")
    (set-store-app! STORE-APP)))
