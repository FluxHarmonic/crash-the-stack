;;; (crash settings) - The SETTINGS screen's rows, and where they live.
;;;
;;; Eight settings (P4, ruled 2026-09-20; the HUD layout and the FIELD
;;; rule left the list on 2026-09-21, D51: layout A alone, the field
;;; picked at deal; BACKGROUND LIVE/STILL joined the same day), each a
;;; row of a screen with a name on the left and
;;; its value on the right, stepped by Enter, a tap, or left/right: the
;;; card table's PULL (draw one or three) and SCORING (BOUNTY is Vegas,
;;; AUDIT is Standard; the scoring is the setting in both versions of the
;;; game, the trace and the timer stay the version's), MUSIC (the tunes)
;;; and SFX (the cues) with VOLUME the master (David, 2026-09-20), and
;;; the two D36 cosmetics SCANLINES and VEIL (both on by default since
;;; David's phone read of 2026-09-21).
;;;
;;; Every setting is its own store key holding a plain datum:
;;; "draw" 1|3, "scoring" vegas|standard, "music" on|off, "sfx" on|off,
;;; "volume" 0..10, "scanlines" on|off, "field" live|still (BACKGROUND),
;;; "veil" on|off (symbols, not booleans: a missing key reads as #f from
;;; the store, which a boolean row could not tell from OFF). A missing or
;;; unreadable key is the default. The
;;; settings in force are an alist of (id . value); (crash shell) loads it
;;; at boot and writes one key when a row steps (the store verbs live
;;; there: this module is pure, the menu imports it).
;;;
;;; Rules family: no platform.

(define-library (crash settings)
  (import (sigil struct))

  (export setting setting? setting-id setting-name setting-values setting-default setting-key
          SETTINGS SETTING-IDS setting-ref setting-value-label setting-value?
          SETTING-GROUPS settings-group setting-when
          SETTINGS-VERSION SETTINGS-VERSION-KEY RETIRED-KEYS
          settings-defaults settings-value settings-with settings-step
          VOLUME-MAX)

  (begin
    (define VOLUME-MAX 10)

    (define-struct setting
      (id default: #f)
      (name default: "")           ; the row's label, in the block alphabet
      (values default: '())        ; the values in stepping order
      (default default: #f)
      (key default: ""))           ; the store key

    (define (volume-values)
      (let loop ((v VOLUME-MAX) (acc '()))
        (if (< v 0) acc (loop (- v 1) (cons v acc)))))

    ;; Built with list, not quoted (the wasm literal hazard, see (crash menu)).
    (define SETTINGS
      (list (setting id: 'draw name: "PULL" values: (list 1 3) default: 1 key: "draw")
            (setting id: 'scoring name: "SCORING" values: (list 'vegas 'standard) default: 'vegas key: "scoring")
            (setting id: 'music name: "MUSIC" values: (list 'on 'off) default: 'on key: "music")
            (setting id: 'sfx name: "SFX" values: (list 'on 'off) default: 'on key: "sfx")
            (setting id: 'volume name: "VOLUME" values: (volume-values) default: VOLUME-MAX key: "volume")
            (setting id: 'scanlines name: "SCANLINES" values: (list 'on 'off) default: 'on key: "scanlines")   ; on by default (David's phone read, 2026-09-21: "subtle but still noticeable")
            (setting id: 'veil name: "VEIL" values: (list 'on 'off) default: 'on key: "veil")   ; on by default too (David, 2026-09-21)
            ;; BACKGROUND (David, 2026-09-21): LIVE is the field's rule picked at deal
            ;; (D55); STILL a gradient seeded by the deal and never stepped, for
            ;; players who dislike the motion. The key is the old "field" (the
            ;; schema reset cleared the old values)
            (setting id: 'background name: "BACKGROUND" values: (list 'live 'still) default: 'live key: "field")))

    (define SETTING-IDS (map setting-id SETTINGS))

    ;; The settings' schema version (David, 2026-09-21: players who
    ;; already have a store get the new defaults once). The store holds
    ;; it under SETTINGS-VERSION-KEY; (crash shell)'s settings-load clears
    ;; every setting key (the retired ones too) and writes the version
    ;; when the stored one is missing or different, and leaves the board,
    ;; the scores, the run and the daily alone. Bump it when a default
    ;; changes and every player should see the new one.
    ;;   1: P4a's nine rows (implicit: no key was written)
    ;;   2: P4c: the split, HUD and FIELD gone, SCANLINES and VEIL on
    (define SETTINGS-VERSION 2)
    (define SETTINGS-VERSION-KEY "settings-version")
    (define RETIRED-KEYS (list "hud"))   ; "field" came back as BACKGROUND's key (the reset at version 2 clears it either way)

    ;; The split (ruling D51): the general rows live on the main menu's
    ;; SETTINGS; a table's rows live in its own overlay's GAME SETTINGS
    ;; (DEFRAG's two; the stack has none). Built with list, not quoted
    ;; (the wasm literal hazard).
    (define SETTING-GROUPS
      (list (cons 'general (list 'music 'sfx 'volume 'scanlines 'veil 'background))
            (cons 'stack '())
            (cons 'cards (list 'draw 'scoring))))

    (define (settings-group name)
      (let ((e (assq name SETTING-GROUPS))) (if e (cdr e) '())))

    ;; When a change takes: the deal's rows on the next deal, the rest at once.
    (define (setting-when id)
      (if (memq id (list 'draw 'scoring)) 'next-deal 'now))

    (define (setting-ref id)
      (let loop ((ss SETTINGS))
        (cond ((null? ss) #f)
              ((eq? (setting-id (car ss)) id) (car ss))
              (else (loop (cdr ss))))))

    (define (setting-value? st v)
      (and (member v (setting-values st)) #t))

    ;; The value as the row shows it.
    (define (setting-value-label id v)
      (case id
        ((scoring) (if (eq? v 'vegas) "BOUNTY" "AUDIT"))
        ((draw volume) (number->string v))
        (else (string-upcase-symbol v))))

    (define (string-upcase-symbol v)
      (list->string (map char-upcase (string->list (symbol->string v)))))

    ;; --- the settings in force -----------------------------------------------

    (define (settings-defaults)
      (map (lambda (st) (cons (setting-id st) (setting-default st))) SETTINGS))

    (define (settings-value s id)
      (let ((e (assq id s)))
        (if e (cdr e) (let ((st (setting-ref id))) (and st (setting-default st))))))

    ;; s with id at v (v must be one of the row's values; else s).
    (define (settings-with s id v)
      (let ((st (setting-ref id)))
        (if (and st (setting-value? st v))
            (map (lambda (e) (if (eq? (car e) id) (cons id v) e)) s)
            s)))

    ;; s with id stepped by delta (+1 forward, -1 back), wrapping.
    (define (settings-step s id delta)
      (let ((st (setting-ref id)))
        (if (not st)
            s
            (let* ((vs (setting-values st))
                   (n (length vs))
                   (at (let loop ((l vs) (i 0))
                         (cond ((null? l) 0)
                               ((equal? (car l) (settings-value s id)) i)
                               (else (loop (cdr l) (+ i 1)))))))
              (settings-with s id (list-ref vs (modulo (+ at delta) n)))))))
))
