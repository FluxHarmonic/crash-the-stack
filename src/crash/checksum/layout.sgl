;;; Pyramid's coverage topology over STACK's half-unit occlusion grid.
;;; Slot ids are in reading order: apex 0, leaves 21..27.

(define-library (crash checksum layout)
  (import (sigil struct)
          (sigil math)
          (crash stack layout))

  (export PYRAMID-SIZE pyramid-layout pyramid-id)

  (begin
    (define PYRAMID-SIZE 28)
    (define *layout* #f)

    (define (pyramid-id row column)
      (+ (quotient (* row (+ row 1)) 2) column))

    (define (pyramid-layout)
      (unless *layout*
        (let ((lay
               (slots->layout
                (apply append
                       (map (lambda (row)
                              (map (lambda (column)
                                     (slot layer: row
                                           hx: (+ (- 6 row) (* 2 column))
                                           hy: row))
                                   (iota (+ row 1))))
                            (iota 7))))))
          ;; Pyramid has no free-side condition. Keep STACK's computed
          ;; coverage cells, removing only this layout's side constraints.
          (set! *layout*
                (layout lay
                        neighborhoods:
                        (list->vector
                         (map (lambda (id)
                                (neighborhood (layout-neighborhood lay id)
                                              left: '()
                                              right: '()))
                              (iota PYRAMID-SIZE)))))))
      *layout*)))
