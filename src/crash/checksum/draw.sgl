;;; CHECKSUM's sealed archive, using DEFRAG's actual packet faces and the
;;; shared end panel. All geometry comes from the table's hit-test API.

(define-library (crash checksum draw)
  (import (sigil graphics)
          (sigil math)
          (crash stack rules)
          (crash checksum rules)
          (crash checksum table)
          (crash checksum trace)
          (crash trace)
          (crash font)
          (crash atlas)
          (crash palette)
          (only (crash cards render) draw-packet)
          (only (crash render) draw-board-background draw-end-panel draw-meter-in))

  (export draw-checksum)

  (begin
    (define (text! text x y scale)
      (if (atlas-on?)
          (atlas-text text x y scale)
          (draw-text text x y scale)))

    (define (outline rect color)
      (let ((x (car rect))
            (y (cadr rect))
            (w (caddr rect))
            (h (cadddr rect)))
        (color! color)
        (draw-filled-rect x y w 1)
        (draw-filled-rect x (+ y h -1) w 1)
        (draw-filled-rect x y 1 h)
        (draw-filled-rect (+ x w -1) y 1 h)))

    (define (button rect label)
      (outline rect C-TEXT-DIM)
      (color! C-TEXT)
      (text! label (+ (car rect) 8) (+ (cadr rect) 7) 1))

    (define (integrity-line b)
      (string-append "CHECKSUM " (number->string (checksum-count b)) "/28"))

    (define (draw-checksum t portraits bg copper)
      (if (checksum-table-board t)
          (draw-checksum-board t portraits bg copper)
          (begin
            (draw-board-background 640 400 330 0.0 bg copper)
            (color! C-ARCHIVE)
            (text! "SEALED ARCHIVE" 230 8 1)
            (color! C-TEXT)
            (text! "ARCHIVE UNAVAILABLE" 184 180 2)
            (color! C-TEXT-DIM)
            (text! "[ESC] JACK OUT" 248 224 1)
            (when (checksum-table-outcome t)
              (draw-end-panel (checksum-panel-title t) C-TEXT #f
                              (map cadr (checksum-panel-rows t)) (checksum-table-panel t) 1.0)))))

    (define (draw-checksum-board t portraits bg copper)
      (let* ((b (checksum-table-board t))
             (pyramid (cboard-pyramid b))
             (feed (checksum-place-rect 'pull))
             (buffer (checksum-place-rect 'waste))
             (tr (checksum-table-trace t))
             (ticks (trace-ticks tr)))
        (draw-board-background 640 400 274 0.0 bg copper)
        (color-alpha! C-BG 0.35)
        (draw-filled-rect 0 0 640 274)
        (color! C-BAR-A)
        (draw-filled-rect 0 274 640 126)
        (color! C-ARCHIVE)
        (text! "SEALED ARCHIVE" 230 8 1)
        (color! C-TEXT)
        (text! "PULL" (car feed) 360 1)
        (text! "BUFFER" (car buffer) 360 1)
        (color! C-TEXT-DIM)
        (text! "PAIR TO 13." 16 44 1)
        (text! "ROOT ALONE." 16 58 1)
        (text! "[P] PULL." 16 72 1)
        (text! "ARROWS + SPACE." 16 86 1)
        (if (pair? (cboard-stock b))
            (draw-packet feed #f #f portraits #f ticks)
            (begin
              (outline feed C-TEXT-DIM)
              (color! C-TEXT-DIM)
              (text! (if (checksum-rollback? b) "ROLL" "EMPTY")
                     (+ (car feed) 6) (+ (cadr feed) 32) 1)))
        (if (pair? (cboard-waste b))
            (draw-packet buffer (car (cboard-waste b))
                         (eq? (cboard-selected b) 'waste) portraits #f ticks)
            (outline buffer C-TEXT-DIM))
        (for-each
         (lambda (id)
           (when (tile-present? pyramid id)
             (let ((rect (checksum-place-rect id)))
               (draw-packet rect (tile-face pyramid id)
                            (eqv? (cboard-selected b) id) portraits
                            (tile-scrambled? pyramid id) ticks)
               (when (covered? pyramid id)
                 (color-alpha! C-BG 0.22)
                 (draw-filled-rect (car rect) (cadr rect) (caddr rect) (cadddr rect)))
               (when (tile-locked? pyramid id)
                 (color-alpha! C-LOCKED 0.4)
                 (draw-filled-rect (car rect) (cadr rect) (caddr rect) 18)
                 (color! C-ICE)
                 (text! (if (checksum-lock-weak? b id ticks) "WEAK" "LOCK")
                        (+ (car rect) 4) (+ (cadr rect) 4) 1)))))
         (iota 28))
        (when (checksum-table-cursor-shown t)
          (outline (checksum-place-rect (checksum-table-cursor t)) C-HIGHLIGHT))
        (color! C-SELECTED)
        (text! (integrity-line b) 16 304 2)
        (color! C-TEXT)
        (text! (string-append "PASS " (number->string (cboard-passes b)) "/3") 16 328 1)
        (text! (if (eq? (checksum-table-mode t) 'twist) "HACKER" "CLASSIC") 16 282 1)
        (draw-meter-in (checksum-meter-rect) tr)
        (button CHECKSUM-PAUSE-RECT "PAUSE")
        (button CHECKSUM-UNDO-RECT "UNDO [U]")
        (when (and (checksum-table-toast t)
                   (< (- (checksum-table-ms t) (checksum-table-toast-at t)) 1600))
          (color! C-ICE)
          (text! (checksum-table-toast t) 16 263 1))
        (when (or (checksum-table-paused t) (checksum-table-outcome t))
          (draw-end-panel (checksum-panel-title t)
                          (if (eq? (checksum-table-outcome t) 'cleared) C-SELECTED C-TEXT)
                          (integrity-line b)
                          (map cadr (checksum-panel-rows t))
                          (checksum-table-panel t)
                          (if (checksum-table-paused t)
                              1.0
                              (max 0.05
                                   (min 1.0
                                        (/ (- (checksum-table-ms t)
                                              (checksum-table-panel-at t))
                                           200.0))))))))))
