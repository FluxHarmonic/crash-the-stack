;;; Untouched Fisher-Yates deals, rejected until the runtime solver proves
;;; a legal three-pass clear and a suitably difficult found line. No packet
;;; is reordered to fit a witness. Budget exhaustion discards a candidate.
;;; Shells own the clock and slice these units across frames, as SCAN does.

(define-library (crash checksum generate)
  (import (sigil struct)
          (sigil list)
          (crash stack prng)
          (crash cards deck)
          (crash checksum rules)
          (crash checksum solve))
  (export checksum-deal checksum-deal/stats replay-checksum-solution
          CHECKSUM-GEN-BUDGET-MS CHECKSUM-GEN-NODES
          checksum-gen-start checksum-gen-step! checksum-gen-run!
          checksum-gen-status checksum-gen-result checksum-gen-attempts
          checksum-gen-nodes checksum-gen-inconclusive checksum-gen-easy
          checksum-gen-unsolvable checksum-gen-solver)
  (begin
    (define CHECKSUM-GEN-BUDGET-MS 2)
    (define CHECKSUM-GEN-NODES 100000)
    (define MAX-CANDIDATES 1000)

    (define-struct gen
      (seed default: 1)
      (rng default: 1 mutable: #t)
      (attempts default: 0 mutable: #t)
      (pyramid default: #f mutable: #t)
      (feed default: '() mutable: #t)
      (solver default: #f mutable: #t)
      (nodes default: 0 mutable: #t)
      (inconclusive default: 0 mutable: #t)
      (easy default: 0 mutable: #t)
      (unsolvable default: 0 mutable: #t)
      (status default: 'running mutable: #t)
      (result default: #f mutable: #t))

    (define checksum-gen-status gen-status)
    (define checksum-gen-result gen-result)
    (define checksum-gen-attempts gen-attempts)
    (define checksum-gen-nodes gen-nodes)
    (define checksum-gen-inconclusive gen-inconclusive)
    (define checksum-gen-easy gen-easy)
    (define checksum-gen-unsolvable gen-unsolvable)
    (define checksum-gen-solver gen-solver)

    (define (checksum-gen-start seed)
      (gen seed: (prng-seed seed) rng: (prng-seed seed)))

    ;; The measured provisional filter: at most 55% of draws immediately
    ;; useful, plus 20 failed search states. Require eight draws so a tiny
    ;; no-feed line cannot satisfy the ratio by accident. These are metrics
    ;; of this search order, not claims about intrinsic minimum passes.
    (define (difficult-enough? s)
      (and (>= (checksum-solve-draws s) 8)
           (>= (checksum-solve-failed s) 20)
           (<= (* 100 (checksum-solve-needed s)) (* 55 (checksum-solve-draws s)))))

    (define (candidate! g)
      (let* ((deck (shuffled-deck (gen-rng g)))
             (cards (car deck))
             (pyramid (list->vector (take cards 28)))
             (feed (list-tail cards 28)))
        (set-gen-rng! g (cdr deck))
        (set-gen-attempts! g (+ 1 (gen-attempts g)))
        (set-gen-pyramid! g pyramid)
        (set-gen-feed! g feed)
        (set-gen-solver! g (checksum-solve-start pyramid feed CHECKSUM-GEN-NODES PASS-LIMIT))))

    (define (settle! g s)
      (set-gen-nodes! g (+ (gen-nodes g) (checksum-solve-nodes s)))
      (cond ((and (eq? (checksum-solve-status s) 'solved) (difficult-enough? s))
             (set-gen-result! g (cboard (checksum-board (gen-pyramid g) (gen-feed g))
                                       seed: (gen-seed g) solution: (checksum-solve-line s)))
             (set-gen-status! g 'done))
            (else
             (case (checksum-solve-status s)
               ((solved) (set-gen-easy! g (+ 1 (gen-easy g))))
               ((inconclusive) (set-gen-inconclusive! g (+ 1 (gen-inconclusive g))))
               ((unsolvable) (set-gen-unsolvable! g (+ 1 (gen-unsolvable g)))))
             (set-gen-solver! g #f)
             (when (>= (gen-attempts g) MAX-CANDIDATES) (set-gen-status! g 'failed)))))

    (define (checksum-gen-step! g)
      (when (eq? (gen-status g) 'running)
        (let ((s (gen-solver g)))
          (cond ((not s) (candidate! g))
                ((eq? (checksum-solve-status s) 'running) (checksum-solve-step! s))
                (else (settle! g s)))))
      g)

    (define (checksum-gen-run! g more?)
      (let loop ()
        (when (and (eq? (gen-status g) 'running) (more?))
          (checksum-gen-step! g)
          (loop)))
      g)

    ;; Synchronous door for offline proofs only. Gameplay uses the stepper.
    (define (checksum-deal/stats seed)
      (let ((g (checksum-gen-run! (checksum-gen-start seed) (lambda () #t))))
        (cons (gen-result g) (gen-attempts g))))

    (define (checksum-deal seed) (car (checksum-deal/stats seed)))

    (define (replay-checksum-solution b)
      (let loop ((b b) (moves (cboard-solution b)))
        (cond ((null? moves) (checksum-won? b))
              ((memq (car moves) '(pull rollback))
               (let ((after (checksum-select b 'pull)))
                 (and (not (eq? b after)) (loop after (cdr moves)))))
              (else
               (let* ((move (car moves))
                      (selected (checksum-select b (car move)))
                      (after (if (cdr move) (checksum-select selected (cdr move)) selected)))
                 (and (= (+ 1 (cboard-moves b)) (cboard-moves after))
                      (loop after (cdr moves))))))))))
