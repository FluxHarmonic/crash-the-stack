;;; (crash trace) - Being traced, in three phases.
;;;
;;; GNOME Mahjongg scores a board by elapsed time, adds 30 s for a hint
;;; and 60 s for a shuffle, and never shows you the penalties land. Twist
;;; mode makes that number the TRACE: a bar filling toward TRACE-AT while
;;; you try to clear the board first. When it fills you are traced and
;;; the ICE is on you: COUNTER-HACK, a countdown of SEVER-AT seconds
;;; during which a counter-hack fires on its own timer (the first after
;;; ICE-FIRST, then every ICE-INTERVAL), picked with the board's random
;;; stream from the applicable members of a set: lock a pair (a STRONG
;;; lock cannot be selected at all; it turns WEAK after LOCK-DECAY or when
;;; it blocks the last legal match, and a weak lock breaks on one tap;
;;; never placed where it would be weak on arrival: D15), or remap the
;;; remaining tiles (every lock dropped, then the solvable generator, so
;;; the board stays winnable). Hints and shuffles now eat into the countdown. When
;;; it reaches zero the connection is SEVERED: the board is lost, no move
;;; or undo is accepted, and the player gets the same seed again or a new
;;; board. Clearing the board wins in any phase; the score is GNOME's
;;; number (elapsed + 30 per hint + 60 per shuffle) with a phase tag.
;;; Ruled by David 2026-09-17 from P1 play (D13 in the phase plan).
;;;
;;; Clean mode is GNOME's game: the TRACE formula shown as a clock, no
;;; phases, no fail. The mode may be flipped only while a twist game is
;;; still in TRACE (and a clean one still below TRACE-AT).
;;;
;;; Time comes in sim ticks from the fixed clock of (crash tween), one at
;;; a time inside trace-advance, so a chunk of ticks fires exactly the
;;; counter-hacks its seconds cover. The counter-hack set is a list of
;;; members (name, applicable?, apply); P3's face scramble is one more
;;; entry and its art. This module is in the rules family: no platform,
;;; no drawing. The numbers David tunes are the block at the top.

(define-library (crash trace)
  (import (sigil struct)
          (sigil math)
          (crash stack rules)
          (crash stack generate)
          (crash stack prng)
          (crash tween))

  (export trace trace? trace-new
          trace-mode trace-phase trace-ticks trace-hints trace-shuffles
          trace-trace-at trace-sever-at trace-with-thresholds
          trace-countdown trace-ice-timer trace-ice-count trace-last-ice
          trace-cleared-in trace-severed?
          trace-value trace-fraction trace-clock-string
          trace-countdown-string trace-ice-string
          trace-add-ticks trace-hint trace-shuffle trace-charge trace-with-mode trace-flip-allowed?
          trace-advance trace-advance* trace-finish trace-extra
          lock-weak? lock-strong? safe-lock-pairs
          ice-member ice-member? ice-member-name ice-member-applicable? ice-member-apply
          ICE-SET ice-applicable
          TRACE-AT HINT-COST SHUFFLE-COST
          ICE-FIRST ICE-INTERVAL SEVER-AT HINT-SEVER-COST SHUFFLE-SEVER-COST
          LOCK-DECAY SCRAMBLE-COUNT MODES PHASES
          MSG-JACKED-IN MSG-TRACED MSG-LOCKED-PAIR MSG-LOCKED MSG-LOCK-WEAK MSG-LOCK-BROKEN
          MSG-REMAPPED MSG-NOTHING MSG-SEVERED MSG-TOO-LATE MSG-NO-MENU
          TAG-CLEAN-RUN TAG-UNDER-ICE)

  (begin
    ;; --- the numbers David tunes (seconds unless said otherwise) --------------

    (define TRACE-AT 180)            ; the trace completes here: COUNTER-HACK begins (300 ruled; 200 then 180 by David from play, 2026-09-17)
    (define HINT-COST 30)            ; on the trace, per hint (GNOME's)
    (define SHUFFLE-COST 60)         ; on the trace, per shuffle (GNOME's)
    (define ICE-FIRST 10)            ; after the trace completes, the first counter-hack
    (define ICE-INTERVAL 30)         ; then one every this often
    (define SEVER-AT 220)            ; the countdown: the connection is cut at zero (360 ruled; 180 then 220 by David from play, 2026-09-17)
    (define HINT-SEVER-COST 15)      ; off the countdown, per hint
    (define SHUFFLE-SEVER-COST 30)   ; off the countdown, per shuffle
    (define LOCK-DECAY 45)           ; a strong lock turns weak this long after it lands
    (define SCRAMBLE-COUNT 6)        ; P3's face scramble: free tiles it hits

    ;; The in-world wording (design note, 2026-09-17; D15), one verb per
    ;; counter-hack, never reused.
    (define MSG-JACKED-IN "JACKED IN. TRACE RUNNING.")
    (define MSG-TRACED "TRACED. ICE INBOUND.")
    (define MSG-LOCKED-PAIR "ICE LOCKED A PAIR.")
    (define MSG-LOCKED "LOCKED.")
    (define MSG-LOCK-WEAK "LOCK WEAK. TAP TO BREAK.")
    (define MSG-LOCK-BROKEN "LOCK BROKEN.")
    (define MSG-REMAPPED "ICE REMAPPED THE STACK.")
    (define MSG-NOTHING "ICE PROBED. NOTHING TO HIT.")
    (define MSG-SEVERED "LINK SEVERED.")
    (define MSG-TOO-LATE "TOO LATE TO SWITCH.")
    (define MSG-NO-MENU "JACK OUT: NO MENU YET.")
    (define TAG-CLEAN-RUN "CLEAN RUN")
    (define TAG-UNDER-ICE "UNDER ICE")

    (define MODES '(twist clean))
    (define PHASES '(trace counter severed cleared))

    ;; Whole seconds of the constants above as ticks (TICKS-PER-SECOND is
    ;; (crash tween)'s, the one clock).
    (define (ticks-of seconds) (* seconds TICKS-PER-SECOND))

    ;; --- state ---------------------------------------------------------------

    ;; ticks, hints, shuffles: the whole game's, for GNOME's number.
    ;; countdown: ticks left before the sever (COUNTER-HACK only).
    ;; ice-timer: ticks until the next counter-hack. ice-count: fired so far.
    ;; last-ice: the last member's name, or #f. cleared-in: the phase a
    ;; cleared board was cleared in. trace-at, sever-at: this board's
    ;; thresholds in seconds, the constants unless the layout's header
    ;; says otherwise (ruled 2026-09-17).
    (define-struct trace
      (mode default: 'twist)
      (phase default: 'trace)
      (trace-at default: TRACE-AT)
      (sever-at default: SEVER-AT)
      (ticks default: 0)
      (hints default: 0)
      (shuffles default: 0)
      (countdown default: 0)
      (ice-timer default: 0)
      (ice-count default: 0)
      (last-ice default: #f)
      (cleared-in default: #f)
      (extra default: 0))              ; seconds-equivalent a game adds on its own (the card table's passes, undos, scrambles)

    (define (trace-new mode)
      (trace mode: (if (memq mode MODES) mode 'twist)))

    ;; A trace with this board's thresholds (a layout's header may set them).
    (define (trace-with-thresholds tr trace-at sever-at)
      (trace tr trace-at: trace-at sever-at: sever-at))

    (define (trace-severed? tr)
      (eq? (trace-phase tr) 'severed))

    ;; --- the numbers on the HUD --------------------------------------------------

    ;; GNOME's number: elapsed + 30 per hint + 60 per shuffle, all phases,
    ;; plus whatever the game charged on its own (extra; 0 for the stack).
    (define (trace-value tr)
      (+ (/ (trace-ticks tr) TICKS-PER-SECOND)
         (* HINT-COST (trace-hints tr))
         (* SHUFFLE-COST (trace-shuffles tr))
         (trace-extra tr)))

    ;; The bar: 0..1 filling toward the trace, then 1..0 counting down.
    (define (trace-fraction tr)
      (case (trace-phase tr)
        ((trace) (min 1.0 (/ (trace-value tr) (trace-trace-at tr))))
        ((counter) (/ (trace-countdown tr) (ticks-of (trace-sever-at tr))))
        ((severed) 0.0)
        (else (if (eq? (trace-cleared-in tr) 'counter)
                  (/ (trace-countdown tr) (ticks-of (trace-sever-at tr)))
                  (min 1.0 (/ (trace-value tr) (trace-trace-at tr)))))))

    (define (two-digits n)
      (if (< n 10)
          (string-append "0" (number->string n))
          (number->string n)))

    (define (clock-string seconds)
      (let* ((total (max 0 (exact (floor seconds))))
             (minutes (quotient total 60))
             (rest (- total (* minutes 60))))
        (string-append (number->string minutes) ":" (two-digits rest))))

    ;; The clean face and the score: mm:ss of GNOME's number.
    (define (trace-clock-string tr)
      (clock-string (trace-value tr)))

    (define (trace-countdown-string tr)
      (clock-string (/ (trace-countdown tr) TICKS-PER-SECOND)))

    (define (trace-ice-string tr)
      (clock-string (/ (trace-ice-timer tr) TICKS-PER-SECOND)))

    ;; --- the player's inputs -------------------------------------------------------

    (define (trace-add-ticks tr n)
      (trace tr ticks: (+ (trace-ticks tr) n)))

    ;; A hint: on the trace it adds HINT-COST; under the ICE it also takes
    ;; HINT-SEVER-COST off the countdown.
    (define (trace-hint tr)
      (charge (trace tr hints: (+ 1 (trace-hints tr))) HINT-SEVER-COST))

    (define (trace-shuffle tr)
      (charge (trace tr shuffles: (+ 1 (trace-shuffles tr))) SHUFFLE-SEVER-COST))

    (define (charge tr seconds)
      (if (eq? (trace-phase tr) 'counter)
          (trace tr countdown: (max 0 (- (trace-countdown tr) (ticks-of seconds))))
          tr))

    ;; A game's own cost (the card table's pass, undo or scramble): on the
    ;; trace it adds trace-seconds to the value; under the ICE it takes
    ;; sever-seconds off the countdown instead, like a hint does.
    (define (trace-charge tr trace-seconds sever-seconds)
      (if (eq? (trace-phase tr) 'counter)
          (charge tr sever-seconds)
          (trace tr extra: (+ (trace-extra tr) trace-seconds))))

    ;; The flip between faces is allowed only while the game is still a
    ;; TRACE game from either side: twist in phase trace, clean below TRACE-AT.
    (define (trace-flip-allowed? tr)
      (if (eq? (trace-mode tr) 'twist)
          (eq? (trace-phase tr) 'trace)
          (< (trace-value tr) (trace-trace-at tr))))

    (define (trace-with-mode tr mode)
      (if (and (memq mode MODES) (trace-flip-allowed? tr))
          (trace tr mode: mode)
          tr))

    ;; --- the counter-hack set ---------------------------------------------------------

    ;; name: a symbol for the HUD and the trace lines. applicable?: board ->
    ;; bool. apply: board, now -> board (the board's own rng is advanced
    ;; inside; now is the game's tick, for a lock's decay).
    (define-struct ice-member
      (name default: 'none)
      (applicable? default: #f)
      (apply default: #f))

    ;; A lock is WEAK when LOCK-DECAY has elapsed since it landed, or when
    ;; the board has no legal match free of locked tiles (the lock would
    ;; strand the player). Derived, never stored: an undo or a remap that
    ;; brings back an unlocked match makes it strong again.
    (define (lock-weak? b id now)
      (and (tile-locked? b id)
           (or (>= (- now (tile-lock-tick b id)) (ticks-of LOCK-DECAY))
               (null? (unlocked-matches b)))))

    (define (lock-strong? b id now)
      (and (tile-locked? b id) (not (lock-weak? b id now))))

    ;; Lock: one unlocked legal pair, chosen by the board's random stream
    ;; among the pairs that leave another unlocked legal match standing, so
    ;; a fresh lock is never weak on arrival (D15; David: "if lock comes up
    ;; while there's only one pair left, a different counter-hack is
    ;; used"). Counting matches is not enough: three free tiles of one face
    ;; give three matches that all share tiles, and locking any of them
    ;; leaves none (the adversarial review's probe).
    (define (disjoint? m o)
      (not (or (= (car m) (car o)) (= (car m) (cdr o))
               (= (cdr m) (car o)) (= (cdr m) (cdr o)))))

    (define (safe-lock-pairs b)
      (let ((matches (unlocked-matches b)))
        (filter (lambda (m)
                  (any (lambda (o) (disjoint? m o)) matches))
                matches)))

    (define (lock-applicable? b)
      (pair? (safe-lock-pairs b)))

    (define (lock-apply b now)
      (let* ((pairs (safe-lock-pairs b))
             (rng (prng-next (board-rng b)))
             (pair (list-ref pairs (prng-index rng (length pairs))))
             (nx (board-lock-pair b (car pair) (cdr pair) now)))
        (set-board-rng! nx rng)
        nx))

    ;; Remap: every lock dropped, then the remaining tiles re-dealt by the
    ;; solvable generator, so the board stays winnable and the player's
    ;; read of it is gone. Applicable when at least two pairs remain; a
    ;; remainder the generator cannot re-deal (it answers unchanged) is
    ;; reported as nothing happening, locks kept.
    (define (remap-applicable? b)
      (>= (board-tile-count b) 4))

    (define (remap-apply b now)
      (let* ((broken (board-break-locks b))
             (dealt (reshuffle broken)))
        (and (not (eq? dealt broken)) dealt)))

    (define ICE-SET
      (list (ice-member name: 'lock
                        applicable?: lock-applicable?
                        apply: lock-apply)
            (ice-member name: 'remap
                        applicable?: remap-applicable?
                        apply: remap-apply)))

    (define (ice-applicable b)
      (filter (lambda (m) ((ice-member-applicable? m) b)) ICE-SET))

    ;; One counter-hack: a uniform pick over the applicable members with
    ;; the board's random stream; none applicable, or a member that could
    ;; do nothing after all (apply answers #f) -> the interval passes with
    ;; no effect. The undo history is cut at the event: a counter-hack the
    ;; player could undo would have no teeth (ruled 2026-09-17); the
    ;; player's own moves after it are undoable as usual. Returns
    ;; (cons board name-or-#f).
    (define (fire-ice b now)
      (let ((members (ice-applicable b)))
        (if (null? members)
            (cons b #f)
            (let* ((rng (prng-next (board-rng b)))
                   (m (list-ref members (prng-index rng (length members))))
                   (copy (board-copy b)))
              (set-board-rng! copy rng)
              (let ((hit ((ice-member-apply m) copy now)))
                (if (not hit)
                    (cons b #f)
                    (begin
                      (set-board-history! hit '())
                      (set-board-selected! hit #f)
                      (cons hit (ice-member-name m)))))))))

    ;; --- the phase machine ----------------------------------------------------------

    ;; The trace and board after n sim ticks. Returns (list trace board
    ;; events), events being the names of counter-hacks that fired plus
    ;; 'traced when the trace completed and 'severed when the countdown
    ;; ran out, oldest first. Nothing moves once the board is cleared or
    ;; severed, or in clean mode beyond the clock.
    (define (trace-advance tr b n)
      (trace-advance* tr b n fire-ice))

    ;; The same machine over any table: fire is (table now) -> (cons
    ;; table name-or-#f), the counter-hack of that game (fire-ice for the
    ;; stack; the card table brings its own in (crash cards trace)).
    (define (trace-advance* tr b n fire)
      (let loop ((k 0) (tr tr) (b b) (events '()))
        (cond ((= k n) (list tr b (reverse events)))
              ((memq (trace-phase tr) '(severed cleared)) (list tr b (reverse events)))
              (else
               (let ((tr (trace-add-ticks tr 1)))
                 (cond
                   ((eq? (trace-mode tr) 'clean)
                    (loop (+ k 1) tr b events))
                   ((eq? (trace-phase tr) 'trace)
                    (if (>= (trace-value tr) (trace-trace-at tr))
                        (loop (+ k 1)
                              (trace tr
                                     phase: 'counter
                                     countdown: (ticks-of (trace-sever-at tr))
                                     ice-timer: (ticks-of ICE-FIRST))
                              b
                              (cons 'traced events))
                        (loop (+ k 1) tr b events)))
                   (else ; counter
                    (let ((countdown (- (trace-countdown tr) 1))
                          (ice-timer (- (trace-ice-timer tr) 1)))
                      (cond ((<= countdown 0)
                             (list (trace tr phase: 'severed countdown: 0 ice-timer: 0)
                                   b
                                   (reverse (cons 'severed events))))
                            ((<= ice-timer 0)
                             (let ((fired (fire b (trace-ticks tr))))
                               (loop (+ k 1)
                                     (trace tr
                                            countdown: countdown
                                            ice-timer: (ticks-of ICE-INTERVAL)
                                            ice-count: (+ 1 (trace-ice-count tr))
                                            last-ice: (cdr fired))
                                     (car fired)
                                     (cons (or (cdr fired) 'nothing) events))))
                            (else
                             (loop (+ k 1)
                                   (trace tr countdown: countdown ice-timer: ice-timer)
                                   b
                                   events)))))))))))

    ;; The board was cleared: the score freezes with the phase it was
    ;; cleared in (trace or counter; clean games are tagged trace).
    (define (trace-finish tr)
      (if (memq (trace-phase tr) '(cleared severed))
          tr
          (trace tr
                 phase: 'cleared
                 cleared-in: (if (eq? (trace-phase tr) 'counter) 'counter 'trace))))))
