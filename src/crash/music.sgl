;;; (crash music) - Which track plays where (P4, ruling D50).
;;;
;;; Three tunes from P3b (motif, the tracker): SPY is the menu theme and
;;; the stack's rest track, GROOVE is DEFRAG's rest track, BREAKER is the
;;; energy track under the ICE (the counter-hack phase) on both tables.
;;; Later tunes join per-table pools picked at deal, never the same as
;;; the last (P3b's live playback); today each pool is one tune.
;;;
;;; The transitions, as ruled: menu -> board a ~1 s cross-fade; board ->
;;; MENU the board's track fades in ~0.5 s and the theme resumes from
;;; where it left off; CONTINUE resumes the board's track; a new deal
;;; starts it from the top; traced, a cross-fade to BREAKER and back to
;;; the rest track on escape; STACK CRASHED / a won deal fades the track
;;; under the cascade; a severed link fades it too. (crash audio) plays;
;;; this module only names the track and the mode for a state, pure, so
;;; the tests can hold the table. Rules family: no platform.

(define-library (crash music)
  (import (sigil list))
  (export TRACKS TRACK-FILES music-rest-track music-track-for music-file
          POOLS MENU-THEME music-pool music-pick music-section music-tune-path)

  (begin
    ;; name -> the file under assets/audio/ (OGG Vorbis, mono 22050, q4)
    (define TRACK-FILES
      (list (cons 'spy "assets/audio/spy.ogg")
            (cons 'groove "assets/audio/groove.ogg")
            (cons 'breaker "assets/audio/breaker.ogg")))

    (define TRACKS (map car TRACK-FILES))

    (define (music-file name)
      (let ((e (assq name TRACK-FILES))) (and e (cdr e))))

    ;; The rest track of a table (the menu's is the stack's).
    (define (music-rest-track table)
      (if (eq? table 'cards) 'groove 'spy))

    ;; What should play on a screen: (name . mode) or #f for silence
    ;; (the cascade after a clear, the severed screen). screen: menu |
    ;; stack | cards; phase: the trace's phase on a table (trace |
    ;; counter | severed | cleared), #f on the menu; fresh?: the board
    ;; was just dealt (its rest track from the top) rather than
    ;; continued or returned to (resumed).
    (define (music-track-for screen phase fresh?)
      (cond ((eq? screen 'menu) (cons 'spy 'resume))
            ((memq phase '(cleared severed)) #f)
            ((eq? phase 'counter) (cons 'breaker 'top))
            (else (cons (music-rest-track screen) (if fresh? 'top 'resume)))))

    ;; --- the live soundtrack (M1, ruling D59) -------------------------------------
    ;;
    ;; The .cts tunes under assets/tunes/ play live on motif's player ((crash
    ;; music live) runs it; this is the data). Each table has a POOL, one
    ;; obvious place David re-sorts by ear; a deal picks from its table's
    ;; pool by the board seed, never the last one played when the pool
    ;; allows; the daily's seed makes its pick fixed. The menu has its theme.
    ;; A track's sections are its marks (calm, fill, tense): CALM while the
    ;; trace runs, the fill then TENSE (looping) once the trace crosses the
    ;; ICE threshold (phase counter), back to CALM when it falls (a return
    ;; with a short dip: no track has a composed return fill yet).
    (define POOLS
      (list (list 'stack 'blind-spot 'shadow-protocol 'quiet-array 'obsidian-index 'cold-boot 'relay-ghost 'breach-vector)
            (list 'cards 'sector-drift 'dirty-cache 'basement-circuit 'glass-current 'closed-loop 'black-glass 'breach-vector)))
    ;; reserved for their modes, in no pool yet: dead-sector (Minesweeper), clock-edge (rhythm)
    (define MENU-THEME 'black-glass-title)

    (define (music-pool table)
      (let ((e (assq table POOLS))) (if e (cdr e) '())))

    (define (music-tune-path name)
      (string-append "assets/tunes/" (symbol->string name) ".cts"))

    ;; The pick for a deal: the seed's hash over the pool; if that is the
    ;; last one played and the pool has more, the next one along.
    (define (music-pick table seed last)
      (let* ((pool (music-pool table))
             (n (length pool)))
        (cond ((= n 0) #f)
              (else
               (let* ((i (modulo (* (or seed 0) 2654435761) n))
                      (name (list-ref pool i)))
                 (if (and (eq? name last) (> n 1))
                     (list-ref pool (modulo (+ i 1) n))
                     name))))))

    ;; The section a phase asks for: the trace running is CALM, the
    ;; counter-hack (the trace crossed the ICE threshold) is TENSE; the
    ;; cascade and the severed screen are silence (music-track-for says so).
    (define (music-section phase)
      (if (eq? phase 'counter) 'tense 'calm))

    ))
