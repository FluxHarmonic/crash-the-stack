;;; (crash music) - Which tune plays where (P4's ruling D50, live since M1's D59).
;;;
;;; The soundtrack is the .cts tunes under assets/tunes/, played live on
;;; motif's player by (crash music live); this module is the data and
;;; the one function that couples the trace to the music, pure, so the
;;; tests can hold the table. Rules family: no platform.
;;;
;;; The transitions, as ruled: menu -> board a ~1 s cross-fade; board ->
;;; MENU the board's track fades in ~0.5 s and the theme resumes from
;;; where it left off; CONTINUE resumes the board's track; a new deal
;;; starts it from the top; the trace crossing the ICE threshold asks
;;; the track for its fill and tense sections at the next bar; STACK
;;; CRASHED / a won deal fades the track under the cascade; a severed
;;; link fades it too. (P4's three OGG tracks and their table left with
;;; M1: nothing decoded ships.)

(define-library (crash music)
  (import (sigil list))
  (export POOLS CANDIDATES MENU-THEME music-pool music-pick music-section music-tune-path)

  (begin

    ;; --- the live soundtrack (M1, ruling D59) -------------------------------------
    ;;
    ;; The .cts tunes under assets/tunes/ play live on motif's player ((crash
    ;; music live) runs it; this is the data). Each table has a POOL, one
    ;; obvious place David re-sorts by ear; a deal picks from its table's
    ;; pool by the board seed, never the last one played when the pool
    ;; allows; the daily's seed makes its pick fixed. The menu has its theme.
    ;; A track's sections are its marks (calm, fill, tense): CALM while the
    ;; trace runs, the fill then TENSE (looping) once the trace crosses the
    ;; ICE threshold (phase counter), back to CALM when it falls (a return
    ;; with a short dip: no track has a composed return fill yet).
    (define POOLS
      (list (list 'stack 'blind-spot 'quiet-array 'obsidian-index 'cold-boot 'relay-ghost 'breach-vector)
            (list 'cards 'sector-drift 'dirty-cache 'basement-circuit 'glass-current 'closed-loop 'black-glass 'breach-vector)
            ;; the hub (P5 phase 2; David's cut 2026-09-22): calm = sneaking, tense = an alerted layer;
            ;; shadow-protocol was the original sneaking track
            (list 'hub 'blind-spot 'shadow-protocol 'dead-sector 'quiet-array)))
    ;; tunes David has not heard in context yet: in no pool until he does
    (define CANDIDATES '(clock-edge))

    (define MENU-THEME 'black-glass-title)

    (define (music-pool table)
      (let ((e (assq table POOLS))) (if e (cdr e) '())))

    (define (music-tune-path name)
      (string-append "assets/tunes/" (symbol->string name) ".cts"))

    ;; The pick for a deal: the seed's hash over the pool; if that is the
    ;; last one played and the pool has more, the next one along.
    (define (music-pick table seed last)
      (let* ((pool (music-pool table))
             (n (length pool)))
        (cond ((= n 0) #f)
              (else
               (let* ((i (modulo (* (or seed 0) 2654435761) n))
                      (name (list-ref pool i)))
                 (if (and (eq? name last) (> n 1))
                     (list-ref pool (modulo (+ i 1) n))
                     name))))))

    ;; The section a phase asks for: the trace running is CALM, the
    ;; counter-hack (the trace crossed the ICE threshold) is TENSE; the
    ;; cascade and the severed screen are silence ((crash music live) fades out).
    (define (music-section phase)
      (if (eq? phase 'counter) 'tense 'calm))

    ))
