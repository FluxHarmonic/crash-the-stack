;;; (crash scan table) - A SCAN board in play: the session and what is
;;; around it.
;;;
;;; (crash scan input) turns a frame into actions on the segment. This
;;; module is the rest of a table both shells share, so each shell's hook
;;; stays small: the clock (it starts at the uplink and stops at the end,
;;; as Windows' did), the end of a board (SEGMENT MAPPED, or ICE TRIPPED on
;;; CLASSIC) and its panel (RETRY LINK or NEW SEGMENT, and JACK OUT), the scan's
;;; ripple (each newly scanned host shows a ring at a time, from the host
;;; the action was on), a refusal's shake, the moves, the cues and the
;;; requests the shell acts on, and the datum CONTINUE stores.
;;;
;;; The shell calls, per frame:
;;;   (scan-table-step t frame)       the frame's input, clock and effects
;;;   (scan-table-deal! t more?)      the deal's slice, while dealing (D81)
;;; and reads scan-table-cues / scan-table-requests after it. Requests:
;;;   menu      the pause overlay (Escape, or the panel's JACK OUT is `quit`)
;;;   new       a new segment (ctrl+n, or the panel's NEW SEGMENT after a win)
;;;   retry     a FRESH segment of the same size after a loss (RETRY LINK):
;;;             never the lost board, whose ICE the loss has just shown
;;;   quit      back to the menu (the panel's JACK OUT)
;;;   won lost  the board ended this frame (the shell records the score)
;;;   buzz      the page's vibrate (a long press flagged)
;;;   tools     ctrl+Space (CLASSIC has no tools; the shell ignores it)
;;;   severed   HACKER: the countdown ran out this frame (the link is cut)
;;;
;;; HACKER (P6c, (crash scan trace)): the table carries the trace. It runs
;;; from the uplink's deal on the frame's dt (60 ticks a second, the
;;; remainder carried), charges each trip and probe the frame's news
;;; reports (a probe from the hub's bag charges nothing and is counted in
;;; `consumed`), fires the counter-hacks through trace-advance*, keeps the
;;; firewalls' weakness current, and says what happened in a toast. A
;;; cleared board freezes the trace with its phase (CLEAN RUN or UNDER
;;; ICE); a severed one ends the board with LINK SEVERED.
;;;
;;; Rules family: no platform, no clock of its own (the frame carries dt).

(define-library (crash scan table)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (crash trace)
          (crash scan rules)
          (crash scan input)
          (only (crash scan generate) deal-marks)
          (only (crash geometry) panel-row-rect panel-row-hit panel-keys panel-key?)   ; the shared end panel (t-6a2d35)
          (crash scan trace))

  (export RING-MS SHAKE-MS TOAST-MS PANEL-WAIT-MS PANEL-ROWS
          scan-table scan-table?
          scan-table-session scan-table-ms scan-table-over scan-table-over-ms
          scan-table-moves scan-table-daily scan-table-cues scan-table-requests
          scan-table-panel scan-table-shake scan-table-flash scan-table-flag-hint scan-table-toast scan-table-toast-ms
          scan-table-new scan-table-retry-seed
          scan-table-step scan-table-deal! scan-table-dealing?
          scan-table-segment scan-table-seconds scan-table-ticks scan-table-counter scan-table-demo-near-cleared
          scan-table-revealed? scan-table-reveal-age
          scan-table-panel-rows scan-table-panel-rect scan-table-panel-hit
          scan-table-won? scan-table-lost? scan-table-cursor?
          scan-table-trace scan-table-elite? scan-table-probes scan-table-consumed
          scan-table-marks scan-table-mark-count scan-table-extracted scan-table-severed? scan-table-with-launch
          scan-table->datum datum->scan-table trace->datum datum->trace)

  (begin
    (define RING-MS 33)       ; a ripple ring every two ticks (the design's section 6)
    (define SHAKE-MS 240)
    (define FLASH-MS 360)      ; a refused sweep's hosts show pressed this long
    (define MSG-SWEEP-FLAGS "SWEEP NEEDS ITS FLAGS.")
    (define TOAST-MS 1600)
    (define TABLE-SAVE-VERSION 2)

    ;; The end panel's rows. After a trip (CLASSIC's lost board) RETRY LINK
    ;; deals a fresh segment of the same size; a mapped segment offers the
    ;; next one (NEW SEGMENT). JACK OUT goes to the menu either way.
    (define PANEL-ROWS
      (list (list 'retry "RETRY LINK")
            (list 'new "NEW SEGMENT")
            (list 'quit "JACK OUT")))

    (define-struct scan-table
      (session default: #f)
      (ms default: 0)            ; the clock: ms of play since the uplink, frozen at the end
      (over default: #f)         ; #f | won | lost
      (over-ms default: 0)       ; ms since the end
      (moves default: 0)         ; actions that changed the segment
      (daily default: #f)        ; the UTC day of a daily board, or #f
      (reveal default: #f)       ; host -> the ms (on the table's clock) its ring shows, or #f
      (now default: 0)           ; ms since the board opened (the ripple's clock; runs before the uplink too)
      (panel default: 0)         ; the end panel's highlight
      (shake default: #f)        ; (host . ms left) of a refusal
      (flash default: #f)        ; (reading . ms left): a refused sweep's hosts flash pressed
      (toast default: #f)        ; the line a refusal says, or #f
      (toast-ms default: 0)
      (cues default: '())        ; this frame's, for the shell
      (requests default: '())    ; this frame's, for the shell
      (cursor? default: #f)      ; the keyboard cursor shows: a key moved or acted since the last pointer press
      ;; HACKER
      (trace default: #f)        ; the board's trace ((crash trace)), #f on CLASSIC
      (acc default: 0)           ; ms x 60 not yet a whole tick
      (elite? default: #f)       ; an ELITE run's board: a hit in TRACE completes the trace
      (probes default: 0)        ; probes carried in from the hub's bag (free)
      (consumed default: '())    ; bag tools this board used, for the hub's return
      (mark-count default: 0)    ; a node board's K (D74): hosts to extract, from the launch
      (marks default: '()))      ; the marked hosts, dealt from the recorded line at the uplink; '() elsewhere

    ;; A board: HACKER's trace at its preset's thresholds ((crash scan
    ;; trace)), none on CLASSIC. A node's launch sets its own
    ;; (scan-table-with-launch).
    (define (scan-table-new session daily)
      (scan-table session: session
                  daily: daily
                  trace: (and (scan-session-hacker? session)
                              (let ((th (scan-thresholds (scan-session-preset session))))
                                (scan-trace-new (car th) (cdr th))))))

    ;; A node board's launch (JACK IN): its thresholds, the run's ELITE rule,
    ;; the bag's probes, the node's marks.
    (define (scan-table-with-launch t trace-at sever-at elite? probes mark-count)
      (scan-table t
                  trace: (scan-trace-new trace-at sever-at)
                  elite?: elite?
                  probes: probes
                  mark-count: mark-count))

    ;; D74: how many marks are extracted now (every clean host of the
    ;; mark's 3x3 scanned). Derived from the board, never stored: a wipe can
    ;; take one back, and the player scans it again.
    (define (scan-table-extracted t)
      (let ((seg (scan-table-segment t)))
        (if seg
            (length (filter (lambda (m) (segment-extracted? seg m)) (scan-table-marks t)))
            0)))

    (define (scan-table-severed? t) (eq? (scan-table-over t) 'severed))

    ;; RETRY LINK's seed (David, 2026-09-26: re-dealing the SAME board after
    ;; a loss was trivial, since the loss shows every ICE). next-seed is the
    ;; shell's FREE PLAY seed source, a thunk; it is asked again until it
    ;; answers a seed other than the lost board's (at most TRIES times, a
    ;; bound for a source that keeps repeating), so the retry is a different
    ;; deal. A daily lost is retried the same way: its day is spent, and the
    ;; retry is a free board of the daily's size that counts for its best
    ;; time, not the streak (the shell opens it with no day).
    (define RETRY-SEED-TRIES 8)
    (define (scan-table-retry-seed t next-seed)
      (let ((lost (scan-session-seed (scan-table-session t))))
        (let loop ((k 0))
          (let ((s (next-seed)))
            (if (or (not (eqv? s lost)) (>= k RETRY-SEED-TRIES))
                (if (eqv? s lost) (+ 1 (modulo s 4194303)) s)
                (loop (+ k 1)))))))

    (define (scan-table-segment t) (scan-session-segment (scan-table-session t)))

    ;; ?demo=cleared (the arms): one scan from mapped ((crash scan rules)).
    (define (scan-table-demo-near-cleared t)
      (let* ((s (scan-table-session t))
             (seg (scan-session-segment s))
             (marks (scan-table-marks t))
             ;; a node board: leave a host in a mark's sector, so the marks are
             ;; not all extracted (which maps the segment at the next step, D74)
             (seg2 (and seg (if (pair? marks)
                                (segment-demo-near-cleared seg (apply append (map (lambda (m) (segment-sector seg m)) marks)))
                                (segment-demo-near-cleared seg)))))
        (if (eq? seg seg2) t (scan-table t session: (scan-session s segment: seg2)))))

    (define (scan-table-dealing? t) (scan-session-dealing? (scan-table-session t)))
    (define (scan-table-won? t) (eq? (scan-table-over t) 'won))
    (define (scan-table-lost? t) (eq? (scan-table-over t) 'lost))
    (define (scan-table-seconds t) (quotient (scan-table-ms t) 1000))
    ;; The clock at 60 a second, the scores' unit (the other tables' ticks).
    (define (scan-table-ticks t) (quotient (* (scan-table-ms t) 60) 1000))

    ;; The ICE counter: total less flags less tripped; the segment's own
    ;; once dealt, the preset's total before the uplink.
    (define (scan-table-counter t)
      (let ((seg (scan-table-segment t)))
        (if seg (segment-counter seg) (scan-session-m (scan-table-session t)))))

    ;; Has host i's ripple ring reached it (always, when no ripple runs)?
    (define (scan-table-revealed? t i)
      (let ((r (scan-table-reveal t)))
        (or (not r)
            (let ((at (vector-ref r i)))
              (or (not at) (>= (scan-table-now t) at))))))

    ;; ms since host i's ring showed, or #f when it has no ring.
    (define (scan-table-reveal-age t i)
      (let ((r (scan-table-reveal t)))
        (and r
             (let ((at (vector-ref r i)))
               (and at (- (scan-table-now t) at))))))

    ;; --- a frame -------------------------------------------------------------------

    (define (scan-table-step t f)
      (let* ((dt (max 0 (scan-frame-dt f)))
             (t (scan-table t cues: '() requests: '()
                            now: (+ (scan-table-now t) dt)
                            toast-ms: (max 0 (- (scan-table-toast-ms t) dt))
                            shake: (let ((sh (scan-table-shake t)))
                                     (and sh (> (cdr sh) dt) (cons (car sh) (- (cdr sh) dt))))
                            flash: (let ((fl (scan-table-flash t)))
                                     (and fl (> (cdr fl) dt) (cons (car fl) (- (cdr fl) dt)))))))
        (if (scan-table-over t)
            (panel-step (scan-table t over-ms: (+ (scan-table-over-ms t) dt)) f)
            (play-step t f dt))))

    (define (play-step t f dt)
      (let* ((before (scan-table-session t))
             (seg0 (scan-session-segment before))
             (after (scan-step before f))
             (seg1 (scan-session-segment after))
             (news (scan-session-news after))
             (changed? (and seg0 seg1 (not (eq? seg0 seg1)) (not (equal? (segment-cells seg0) (segment-cells seg1)))))
             ;; the clock runs from the uplink's deal on, and not while dealing
             (ms (if (and seg0 (not (segment-over? seg0))) (+ (scan-table-ms t) dt) (scan-table-ms t)))
             (t (scan-table t
                            session: after
                            ms: ms
                            moves: (if changed? (+ 1 (scan-table-moves t)) (scan-table-moves t))
                            reveal: (if changed?
                                        (ripple (scan-table-reveal t) seg0 seg1 (origin before after f) (scan-table-now t))
                                        (scan-table-reveal t))
                            requests: (map-requests (scan-session-requests after))
                            cues: (news-cues news seg1 (origin before after f))
                            cursor?: (cursor-shown? (scan-table-cursor? t) f)))
             (t (refusals t news))
             (t (hacker-step t news dt changed?))
             (t (extract-step t (origin before after f)))
             ;; the pause overlay swallows the releases that follow: let go now
             (t (if (memq 'menu (scan-table-requests t))
                    (scan-table t session: (scan-session-release (scan-table-session t)))
                    t)))
        (ended t)))

    ;; --- what the flags say is off (David, 2026-09-28) ----------------------------

    ;; A board that would not end with every host flagged read as a bug.
    ;; Flags never count toward the map, so an unfinished board with every
    ;; unscanned host flagged always has more flags than ICE: at least as
    ;; many flags are on clean hosts as the counter is below 0. #f, or
    ;;   over-flagged  the counter is below 0 (its negation is the least
    ;;                 number of wrong flags)
    ;;   counted       the counter reads 0 and the board is not mapped: the
    ;;                 unflagged hosts are clean, or a flag is wrong
    (define (scan-table-flag-hint t)
      (let ((seg (scan-table-segment t)))
        (and seg
             (not (scan-table-over t))
             (not (segment-over? seg))
             (let ((c (segment-counter seg)))
               (cond ((< c 0) 'over-flagged)
                     ((= c 0) 'counted)
                     (else #f))))))

    ;; --- the node objective (D74) ------------------------------------------------

    ;; EXTRACT n OF K: once every mark is extracted at once, the rest of the
    ;; segment scans itself as the clear (a ripple from the host acted on),
    ;; and the board ends mapped. o: the frame's host.
    (define (extract-step t o)
      (let ((seg (scan-table-segment t))
            (marks (scan-table-marks t)))
        (if (and seg
                 (pair? marks)
                 (not (segment-over? seg))
                 (every (lambda (m) (segment-extracted? seg m)) marks))
            (let ((seg2 (segment-map-all seg)))
              (cue (scan-table t
                               session: (scan-session (scan-table-session t) segment: seg2)
                               reveal: (ripple (scan-table-reveal t) seg seg2 (or o (car marks)) (scan-table-now t)))
                   'cleared))
            t)))

    ;; --- HACKER: the trace ---------------------------------------------------------

    (define (toast t line)
      (scan-table t toast: line toast-ms: TOAST-MS))

    (define (cue t c)
      (scan-table t cues: (append (scan-table-cues t) (list c))))

    ;; The frame's charges and the ICE's own clock, on a dealt HACKER board
    ;; still in play. changed?: the frame changed the board, so the
    ;; firewalls' weakness is asked of the solver again.
    (define (hacker-step t news dt changed?)
      (let ((seg (scan-table-segment t)))
        (if (or (not (scan-table-trace t)) (not seg) (segment-over? seg))
            t
            (advance (charges t news) dt changed?))))

    ;; Each trip charges a hit, each probe a probe (a bag probe nothing).
    (define (charges t news)
      (let loop ((ns news) (t t))
        (if (null? ns)
            t
            (let ((n (car ns)))
              (loop (cdr ns)
                    (cond ((not (pair? n)) t)
                          ((eq? (car n) 'trip)
                           (let ((r (scan-trace-hit (scan-table-trace t) (scan-table-elite? t))))
                             (toast (scan-table t trace: (car r))
                                    (if (memq 'traced (cdr r)) MSG-TRACED MSG-TRIPPED))))
                          ((eq? (car n) 'probed)
                           (let ((t (if (> (scan-table-probes t) 0)
                                        (scan-table t
                                                    probes: (- (scan-table-probes t) 1)
                                                    consumed: (cons 'probe (scan-table-consumed t)))
                                        (scan-table t trace: (scan-trace-probe (scan-table-trace t))))))
                             (toast t (if (eq? (caddr n) 'ice) MSG-PROBED-ICE MSG-PROBED-CLEAN))))
                          ((eq? (car n) 'broke) (cue (toast t MSG-FIREWALL-BROKEN) 'match))
                          (else t)))))))

    ;; dt ms of the ICE's clock: whole ticks through trace-advance* with
    ;; SCAN's counter-hacks, the remainder carried; then the firewalls'
    ;; weakness at the new tick, and a line for what the ICE did.
    (define (advance t dt recheck?)
      (let* ((s (scan-table-session t))
             (seg (scan-session-segment s))
             (acc (+ (scan-table-acc t) (* 60 dt)))
             (n (quotient acc 1000))
             (r (trace-advance* (scan-table-trace t) seg n fire-scan-ice))
             (tr (car r))
             (seg2 (cadr r))
             (seg3 (scan-refresh-firewalls seg2 (trace-ticks tr) (or recheck? (not (eq? seg2 seg)))))
             (t (scan-table t
                            trace: tr
                            acc: (- acc (* n 1000))
                            session: (if (eq? seg3 seg) s (scan-session s segment: seg3))))
             (t (if (turned-weak? seg2 seg3) (toast t MSG-FIREWALL-WEAK) t)))
        (events t (caddr r))))

    ;; Did a firewall turn weak between the two segments?
    (define (turned-weak? a b)
      (any (lambda (fw)
             (and (caddr fw)
                  (let ((was (assv (car fw) (segment-firewalls a))))
                    (and was (not (caddr was))))))
           (segment-firewalls b)))

    (define (events t es)
      (let loop ((es es) (t t))
        (if (null? es)
            t
            (loop (cdr es)
                  (case (car es)
                    ((traced) (toast t MSG-TRACED))
                    ((firewall) (cue (toast t MSG-FIREWALLED) 'lock))
                    ((mask) (cue (toast t MSG-MASKED) 'scramble))
                    ((wipe) (cue (toast t MSG-WIPED) 'shuffle))
                    ((nothing) (toast t MSG-NOTHING))
                    ((severed) (cue (toast t MSG-SEVERED) 'severed))
                    (else t))))))

    ;; The keyboard cursor shows once a cursor key is used, and hides at the
    ;; next pointer press: a mouse or touch player never sees a ring they
    ;; did not put there.
    (define CURSOR-KEYS (list 'left 'right 'up 'down 'h 'j 'k 'l 'return 'space 'f 'n))
    (define (cursor-shown? was f)
      (cond ((let loop ((es (scan-frame-pointer f)))
               (and (pair? es) (or (eq? (car (car es)) 'down) (loop (cdr es)))))
             #f)
            ((let loop ((ks (scan-frame-pressed f)))
               (and (pair? ks) (or (and (memq (car ks) CURSOR-KEYS) #t) (loop (cdr ks)))))
             #t)
            (else was)))

    ;; The host an action was on: a pointer event's host, else the cursor.
    (define (origin before after f)
      (let loop ((es (scan-frame-pointer f)) (last #f))
        (if (null? es)
            (or last (scan-session-cursor after))
            (let ((e (car es)))
              (loop (cdr es)
                    (or (and (memq (car e) '(up down))
                             (scan-host-at before (cadr e) (caddr e)))
                        last))))))

    ;; Every host newly scanned (or shown) gets its ring's time: RING-MS a
    ;; ring of Chebyshev distance from the origin.
    (define (ripple old seg0 seg1 o now)
      (let* ((n (segment-size seg1))
             (w (segment-w seg1))
             (r (if old (vector-copy old) (make-vector n #f)))
             (ox (modulo o w))
             (oy (quotient o w)))
        (let loop ((i 0))
          (when (< i n)
            (unless (eq? (segment-state seg0 i) (segment-state seg1 i))
              (when (eq? (segment-state seg1 i) 'scanned)
                (vector-set! r i (+ now (* RING-MS (max (abs (- (modulo i w) ox))
                                                         (abs (- (quotient i w) oy))))))))
            (loop (+ i 1))))
        r))

    (define (map-requests rs)
      (filter (lambda (r) (memq r '(menu new tools buzz failed))) rs))

    (define (refusals t news)
      (let loop ((ns news) (t t))
        (if (null? ns)
            t
            (let ((n (car ns)))
              (loop (cdr ns)
                    (cond ((not (and (pair? n) (eq? (car n) 'refused))) t)
                          ;; a sweep whose flags do not match its reading: the
                          ;; hosts it would take flash pressed, and the toast
                          ;; says why (David, 2026-09-28: it read as a dead click)
                          ((eq? (cadr n) 'sweep)
                           (scan-table t
                                       flash: (cons (caddr n) FLASH-MS)
                                       toast: MSG-SWEEP-FLAGS
                                       toast-ms: TOAST-MS
                                       cues: (append (scan-table-cues t) (list 'mismatch))))
                          (else
                           (scan-table t
                                       shake: (and (caddr n) (cons (caddr n) SHAKE-MS))
                                       toast: (case (cadr n) ((flagged) "FLAGGED. UNFLAG FIRST.") ((firewall) MSG-FIREWALL) (else "PICK AN UPLINK FIRST."))
                                       toast-ms: TOAST-MS
                                       cues: (append (scan-table-cues t) (list 'mismatch))))))))))

    ;; The frame's cues from what the segment did (the design's section 7,
    ;; P6c): an opening of two or more hosts is one sweep, never a ping per
    ;; host; a single host pings at its reading's pitch; a flag ticks, its
    ;; removal ticks back; a trip trips; a probe sonars (its echo drops a
    ;; fifth on ICE) and makes no ping of its own scan; the map clears. o:
    ;; the host the action was on (its reading is the ping's).
    (define PINGS (vector 'select 'ping-1 'ping-2 'ping-3 'ping-4 'ping-5 'ping-6 'ping-7 'ping-8))
    (define (ping-of seg o)
      (if (and seg o (eq? (segment-state seg o) 'scanned))
          (vector-ref PINGS (segment-reading seg o))
          'select))
    (define (news-cues news seg1 o)
      (let ((probed? (any (lambda (n) (and (pair? n) (eq? (car n) 'probed))) news)))
        (let loop ((ns news) (acc '()))
          (if (null? ns)
              (reverse acc)
              (let ((n (car ns)))
                (loop (cdr ns)
                      (cond ((not (pair? n)) acc)
                            ((eq? (car n) 'uplink) (cons 'sweep acc))
                            ((eq? (car n) 'probed) (cons (if (eq? (caddr n) 'ice) 'probe-ice 'probe) acc))
                            ((eq? (car n) 'scanned)
                             (cond (probed? acc)
                                   ((> (cadr n) 1) (cons 'sweep acc))
                                   ((= (cadr n) 1) (cons (ping-of seg1 o) acc))
                                   (else acc)))
                            ((memq (car n) '(flagged suspect)) (cons 'flag acc))
                            ((eq? (car n) 'hidden) (cons 'unflag acc))
                            ((eq? (car n) 'trip) (cons 'trip acc))
                            ((eq? (car n) 'mapped) (cons 'cleared acc))
                            (else acc))))))))

    ;; The board's end this frame: mapped (HACKER's trace freezes with its
    ;; phase), tripped on CLASSIC, or severed on HACKER.
    (define (ended t)
      (let ((seg (scan-table-segment t))
            (tr (scan-table-trace t)))
        (define (end how)
          (scan-table t
                      over: how
                      over-ms: 0
                      panel: 0
                      trace: (if (and tr (eq? how 'won)) (trace-finish tr) tr)
                      requests: (append (scan-table-requests t) (list how))))
        (cond ((not seg) t)
              ((segment-won? seg) (end 'won))
              ((segment-lost? seg) (end 'lost))
              ((and tr (trace-severed? tr)) (end 'severed))
              (else t))))

    ;; The deal's slice (D81): the shell's budget as more?.
    (define (scan-table-deal! t more?)
      (let* ((s (scan-session-deal! (scan-table-session t) more?))
             (seg (scan-session-segment s))
             (dealt? (and seg (not (scan-table-segment t))))
             ;; HACKER: the counter-hacks' stream, a function of the board's seed
             (s (if (and dealt? (scan-session-hacker? s))
                    (scan-session s segment: (segment seg rng: (scan-rng-seed (scan-session-seed s))))
                    s))
             ;; a node board's marks (D74), from the deal's own line
             (marks (if (and dealt? (> (scan-table-mark-count t) 0) (scan-session-dealt s))
                        (deal-marks (scan-session-dealt s) (scan-table-mark-count t))
                        (scan-table-marks t))))
        (scan-table t
                    session: s
                    marks: marks
                    requests: (append (scan-table-requests t)
                                      (if (memq 'failed (scan-session-requests s)) (list 'failed) '()))
                    reveal: (if dealt?
                                (ripple #f (blank seg) seg (scan-session-first s) (scan-table-now t))
                                (scan-table-reveal t))
                    cues: (if dealt? (append (scan-table-cues t) (list 'sweep)) (scan-table-cues t)))))

    ;; A segment of the same grid with every host hidden: what the uplink's
    ;; opening is compared against for its ripple.
    (define (blank seg)
      (segment seg cells: (make-vector (segment-size seg) 'hidden)))

    ;; --- the end panel ---------------------------------------------------------------

    (define (scan-table-panel-rows t)
      (cond ((scan-table-lost? t) (list 'retry 'quit))
            ((scan-table-severed? t) (list 'retry 'new 'quit))
            (else (list 'new 'quit))))

    (define (panel-label id) (cadr (assq id PANEL-ROWS)))

    ;; (x y w h) of the index-th row: the shared end panel's ((crash
    ;; geometry), t-6a2d35), so every table's rows sit and hit alike.
    (define (scan-table-panel-rect t index)
      (panel-row-rect index))

    (define (scan-table-panel-hit t x y)
      (panel-row-hit (length (scan-table-panel-rows t)) x y))

    ;; The panel takes a tap on a row (on release, as the board does), the
    ;; arrows and Return or Space, r for RETRY LINK, n for NEW SEGMENT,
    ;; Escape for the menu. It waits PANEL-WAIT-MS first, so the click that
    ;; ended the board never picks a row too.
    (define PANEL-WAIT-MS 400)
    (define (panel-step t f)
      (let* ((rows (scan-table-panel-rows t))
             (n (length rows))
             (ready? (>= (scan-table-over-ms t) PANEL-WAIT-MS))
             (tap (and ready?
                       (let loop ((es (scan-frame-pointer f)) (hit #f))
                         (if (null? es)
                             hit
                             (let ((e (car es)))
                               (loop (cdr es)
                                     (or (and (eq? (car e) 'up)
                                              (memq (cadddr e) (list 'left 'touch))   ; not a right or middle release
                                              (scan-table-panel-hit t (cadr e) (caddr e)))
                                         hit)))))))
             (pressed (scan-frame-pressed f)))
        (define (pick id) (scan-table t requests: (list id) cues: (list 'match)))
        (cond (tap (pick (list-ref rows tap)))
              ((not ready?) t)
              ((memq 'escape pressed) (scan-table t requests: (list 'menu)))
              ((and (memq 'r pressed) (memq 'retry rows)) (pick 'retry))
              ((memq 'n pressed) (pick 'new))
              ;; the arrows and Return: the shared panel's keys ((crash geometry)
              ;; panel-keys, every table's end panel since t-6a2d35)
              ((panel-key? pressed)
               (let ((r (panel-keys (scan-table-panel t) n pressed)))
                 (if (cdr r)
                     (pick (list-ref rows (cdr r)))
                     (scan-table t panel: (car r) cues: (list 'select)))))
              (else t))))

    ;; --- the datum (CONTINUE) ------------------------------------------------------------

    ;; (scan-table 2 MS MOVES DAILY SESSION TRACE ACC ELITE? PROBES CONSUMED MARKS MARK-COUNT)
    ;; with SESSION (crash scan save)'s datum and TRACE trace->datum's (#f on
    ;; CLASSIC); the shell's save module converts the session (this module
    ;; stays out of the store). An ended board is never stored: CONTINUE
    ;; offers a board still in play. Version 1 (0.1.3, CLASSIC only) is the
    ;; first six fields and still loads.
    (define (scan-table->datum t session-datum)
      (list 'scan-table
            TABLE-SAVE-VERSION
            (scan-table-ms t)
            (scan-table-moves t)
            (scan-table-daily t)
            session-datum
            (and (scan-table-trace t) (trace->datum (scan-table-trace t)))
            (scan-table-acc t)
            (scan-table-elite? t)
            (scan-table-probes t)
            (scan-table-consumed t)
            (scan-table-marks t)
            (scan-table-mark-count t)))

    (define (count? x) (and (integer? x) (exact? x) (>= x 0)))

    ;; The table from a datum, given the session it names (or #f).
    (define (datum->scan-table d session)
      (and session
           (list? d)
           (>= (length d) 6)
           (eq? (car d) 'scan-table)
           (count? (list-ref d 2))
           (count? (list-ref d 3))
           (or (not (list-ref d 4)) (integer? (list-ref d 4)))
           (let ((seg (scan-session-segment session))
                 (base (scan-table session: session
                                   ms: (list-ref d 2)
                                   moves: (list-ref d 3)
                                   daily: (list-ref d 4))))
             (and (not (and seg (segment-over? seg)))
                  (case (cadr d)
                    ((1) (and (= (length d) 6)
                              (not (scan-session-hacker? session))
                              base))
                    ((2) (and (= (length d) 13)
                              (count? (list-ref d 12))
                              (let ((tr (and (list-ref d 6) (datum->trace (list-ref d 6)))))
                                (and (eq? (and tr #t) (scan-session-hacker? session))
                                     (count? (list-ref d 7))
                                     (< (list-ref d 7) 1000)
                                     (boolean? (list-ref d 8))
                                     (count? (list-ref d 9))
                                     (list? (list-ref d 10))
                                     (every symbol? (list-ref d 10))
                                     (list? (list-ref d 11))
                                     (every (lambda (i) (and (count? i) (< i (* (scan-session-w session) (scan-session-h session)))))
                                            (list-ref d 11))
                                     (refresh-loaded
                                      (scan-table base
                                                 trace: tr
                                                 acc: (list-ref d 7)
                                                 elite?: (list-ref d 8)
                                                 probes: (list-ref d 9)
                                                 consumed: (list-ref d 10)
                                                 marks: (list-ref d 11)
                                                 mark-count: (list-ref d 12)))))))
                    (else #f))))))

    ;; A loaded board's firewalls: their weakness is derived, never saved.
    (define (refresh-loaded t)
      (let ((seg (scan-table-segment t))
            (tr (scan-table-trace t)))
        (if (and seg tr (pair? (segment-firewalls seg)))
            (scan-table t session: (scan-session (scan-table-session t)
                                                 segment: (scan-refresh-firewalls seg (trace-ticks tr) #t)))
            t)))

    ;; A trace as a datum and back: every field, in the struct's order.
    ;; Anything malformed is #f.
    (define (trace->datum tr)
      (list (trace-mode tr) (trace-phase tr) (trace-trace-at tr) (trace-sever-at tr)
            (trace-ticks tr) (trace-hints tr) (trace-shuffles tr) (trace-countdown tr)
            (trace-ice-timer tr) (trace-ice-count tr) (trace-last-ice tr) (trace-cleared-in tr)
            (trace-extra tr)))

    (define (datum->trace d)
      (and (list? d)
           (= (length d) 13)
           (memq (list-ref d 0) MODES)
           (memq (list-ref d 1) PHASES)
           (every count? (list (list-ref d 2) (list-ref d 3) (list-ref d 4) (list-ref d 5)
                               (list-ref d 6) (list-ref d 7) (list-ref d 8) (list-ref d 9)
                               (list-ref d 12)))
           (> (list-ref d 2) 0)
           (> (list-ref d 3) 0)
           (or (not (list-ref d 10)) (symbol? (list-ref d 10)))
           (or (not (list-ref d 11)) (memq (list-ref d 11) '(trace counter)))
           (trace mode: (list-ref d 0)
                  phase: (list-ref d 1)
                  trace-at: (list-ref d 2)
                  sever-at: (list-ref d 3)
                  ticks: (list-ref d 4)
                  hints: (list-ref d 5)
                  shuffles: (list-ref d 6)
                  countdown: (list-ref d 7)
                  ice-timer: (list-ref d 8)
                  ice-count: (list-ref d 9)
                  last-ice: (list-ref d 10)
                  cleared-in: (list-ref d 11)
                  extra: (list-ref d 12))))))
