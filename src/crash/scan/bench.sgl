;;; (crash scan bench) - What dealing a SCAN segment costs (D81).
;;;
;;; The deal lands on the first click, and on the web the game's own main
;;; thread refills the audio rings (256 ms of cues and 341 ms of music
;;; ahead, (crash audio)), so a frame long enough to outlast them is a
;;; dropout. This runs the generator the way the shell will: sliced into
;;; frames of BUDGET-MS of generation plus at most one unit (a frame steps
;;; until the budget is spent, then yields), and reports per preset, over
;;; a run of seeds with an uplink drawn per seed:
;;;   tries      dealt-try plus one: 1 when placement 0 cleared as dealt,
;;;              else perturbations and placements past the first, plus one;
;;;   ms           the deal's generation time, unsliced;
;;;   collections  units during which a minor GC ran;
;;;   step-ms      the longest single scan-gen-step! (the slicing grain: no
;;;                frame can be shorter than its longest step);
;;;   step-quiet   the longest step with no GC inside it: what splitting a
;;;                unit can shorten (a pause it cannot);
;;;   nursery      how much of the young generation the deal fills, as a
;;;                fraction of its trigger: under 1.0, a deal that starts on
;;;                an empty nursery (the `collect` option, or a shell that
;;;                collects when the board opens) runs no collection;
;;;   frames       how many frames the deal takes at BUDGET-MS;
;;;   frame-ms     the longest frame's generation time at BUDGET-MS.
;;; Each as median, p95 and max. Then one line per kind of unit
;;; (scan-gen-phase) over every unsliced deal: count, mean ms, max ms, max
;;; ms of a quiet unit, mean KB allocated, and how many ran a GC.
;;;
;;; The probes are the caller's: `now` returns milliseconds, and `gc`
;;; returns (bytes-allocated . young-occupancy), which cost microseconds
;;; to read ((sigil gc)'s gc-allocated-bytes and gc-young-occupancy; the
;;; full gc-stats costs ~34 ms a read). So the native bench and the web
;;; door (?scanbench=) run this same code, and the module reads no
;;; platform.

(define-library (crash scan bench)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (crash stack prng)
          (crash scan rules)
          (crash scan generate))

  (export BUDGET-MS scan-bench scan-bench-lines scan-bench-run)

  (begin
    ;; The shell's budget, measured as the shell will use it.
    (define BUDGET-MS GEN-BUDGET-MS)

    (define (first-of seed w h)
      (prng-index (prng-next (prng-seed (* seed 7919))) (* w h)))

    (define (quantiles xs)
      (let* ((s (list-sort < xs))
             (n (length s))
             (at (lambda (p) (list-ref s (min (- n 1) (exact (floor (* p n))))))))
        (list (at 0.5) (at 0.95) (list-ref s (- n 1)))))

    ;; Per kind of unit: (kind count total-ms max-ms max-quiet-ms bytes
    ;; collections), over every unsliced deal of a run. A unit is QUIET when
    ;; no minor collection ran inside it (the young generation's occupancy
    ;; did not drop). A kind whose max is far above its max-quiet is being
    ;; paused by GC, which splitting cannot shorten.
    (define *units* '())

    (define (note-unit! kind dt bytes collected?)
      (let ((e (assq kind *units*))
            (quiet (if collected? 0 dt))
            (c (if collected? 1 0)))
        (if e
            (set-cdr! e (list (+ 1 (list-ref e 1))
                              (+ dt (list-ref e 2))
                              (max dt (list-ref e 3))
                              (max quiet (list-ref e 4))
                              (+ bytes (list-ref e 5))
                              (+ c (list-ref e 6))))
            (set! *units* (cons (list kind 1 dt dt quiet bytes c) *units*)))))

    ;; One deal, unsliced, timing every step:
    ;; (tries ms collections step-ms step-quiet-ms). `gc` returns
    ;; (bytes-allocated . young-occupancy); both reads cost microseconds
    ;; (gc-stats costs ~34 ms a read on the bytecode build, which is why
    ;; it is not used per unit).
    (define (time-whole preset seed first now gc)
      (let ((g (scan-gen-start preset seed first 'original #f)))
        (let loop ((worst 0) (worst-quiet 0) (total 0) (collections 0) (young 0))
          (let* ((kind (scan-gen-phase g))
                 (m0 (gc))
                 (t0 (now))
                 (status (scan-gen-step! g))
                 (dt (- (now) t0))
                 (m1 (gc))
                 (collected? (< (cdr m1) (cdr m0)))
                 (quiet (if collected? 0 dt))
                 ;; the nursery this unit filled: its rise, or after a
                 ;; collection inside it, what it filled since
                 (rise (if collected? (cdr m1) (- (cdr m1) (cdr m0)))))
            (note-unit! kind dt (max 0 (- (car m1) (car m0))) collected?)
            (let ((worst (max worst dt))
                  (worst-quiet (max worst-quiet quiet))
                  (total (+ total dt))
                  (collections (+ collections (if collected? 1 0)))
                  (young (+ young rise)))
              (if (eq? status 'running)
                  (loop worst worst-quiet total collections young)
                  ;; a deal that gave up (#f) counts as GEN-TRIES + 1
                  (let ((d (scan-gen-result g)))
                    (list (+ 1 (if d (dealt-try d) GEN-TRIES))
                          total
                          collections
                          worst
                          worst-quiet
                          young))))))))

    ;; The same deal sliced at BUDGET-MS: (frames worst-frame-ms).
    (define (time-sliced preset seed first now)
      (let ((g (scan-gen-start preset seed first 'original #f)))
        (let loop ((frames 0) (worst 0))
          (let* ((t0 (now))
                 (status (scan-gen-run! g (lambda () (< (- (now) t0) BUDGET-MS))))
                 (dt (- (now) t0)))
            (if (eq? status 'running)
                (loop (+ frames 1) (max worst dt))
                (list (+ frames 1) (max worst dt)))))))

    ;; (unit-KIND count mean-ms max-ms max-quiet-ms mean-kb collections),
    ;; in a fixed order.
    (define (unit-entries)
      (filter (lambda (e) e)
              (map (lambda (kind)
                     (let ((e (assq kind *units*)))
                       (and e
                            (list (string->symbol (string-append "unit-" (symbol->string kind)))
                                  (list-ref e 1)
                                  (/ (list-ref e 2) (list-ref e 1))
                                  (list-ref e 3)
                                  (list-ref e 4)
                                  (/ (list-ref e 5) (* 1024.0 (list-ref e 1)))
                                  (list-ref e 6)))))
                   (list 'place 'build 'start 'flood 'worklist 'dry 'search 'perturb))))

    ;; An alist of quantile triples for one preset over seeds 1..n, then
    ;; the per-kind unit lines. `prep`, when given, runs before each deal,
    ;; outside the timing: the door passes a minor collection for the
    ;; `collect` option, which stands for the shell collecting when a board
    ;; opens, so the first click's deal starts on an empty nursery (D81).
    (define (scan-bench preset n now gc prep)
      (set! *units* '())
      (let* ((d (preset-dims preset))
             (rows (map (lambda (seed)
                          (let ((first (first-of seed (car d) (cadr d))))
                            (when prep (prep))
                            (let ((whole (time-whole preset seed first now gc)))
                              (when prep (prep))
                              (append whole (time-sliced preset seed first now)))))
                        (iota n 1)))
             (col (lambda (k) (quantiles (map (lambda (r) (list-ref r k)) rows)))))
        (append (list (cons 'tries (col 0))
                      (cons 'ms (col 1))
                      (cons 'collections (col 2))
                      (cons 'step-ms (col 3))
                      (cons 'step-quiet (col 4))
                      (cons 'nursery (col 5))
                      (cons 'frames (col 6))
                      (cons 'frame-ms (col 7)))
                (unit-entries))))

    ;; x to two decimals, as text: exact arithmetic on hundredths, so no
    ;; float tail ("218.95", not "218.94591503590345").
    (define (fmt x)
      (let* ((c (exact (round (* 100 x))))
             (sign (if (< c 0) "-" ""))
             (c (abs c))
             (frac (remainder c 100)))
        (string-append sign
                       (number->string (quotient c 100))
                       (if (< frac 10) ".0" ".")
                       (number->string frac))))

    ;; The doors' entry: "PRESET[:N][:collect]" (seeds 1..N, 200 by
    ;; default; `collect` runs `collect` before each deal) to the printable
    ;; lines, or a one-line refusal. `gc` returns (bytes . young-occupancy).
    (define (scan-bench-run arg now gc collect)
      (let* ((parts (split-colons arg))
             (preset (string->symbol (car parts)))
             (n (if (and (pair? (cdr parts)) (string->number (cadr parts)))
                    (string->number (cadr parts))
                    200))
             (prep (and (member "collect" parts) collect)))
        (if (and (preset-dims preset) (integer? n) (> n 0))
            (scan-bench-lines preset n (scan-bench preset n now gc prep))
            (list (string-append "refused " arg " (want lan, wan or backbone, optionally :N and :collect)")))))

    (define (split-colons s)
      (let loop ((i 0) (start 0) (acc '()))
        (cond ((= i (string-length s))
               (reverse (cons (substring s start i) acc)))
              ((char=? (string-ref s i) #\:)
               (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
              (else (loop (+ i 1) start acc)))))

    ;; One printable line per measure: "backbone 200 tries 5.00 12.00 25.00".
    (define (scan-bench-lines preset n result)
      (map (lambda (e)
             (string-join (cons (symbol->string preset)
                                (cons (number->string n)
                                      (cons (symbol->string (car e))
                                            (map fmt (cdr e)))))
                          " "))
           result))))
