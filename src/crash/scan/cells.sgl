;;; (crash scan cells) - How each SCAN cell state is drawn, as data.
;;;
;;; One entry per member of (crash scan rules)'s CELL-STATES, the design
;;; note's section 6 table: (STATE GLYPH PATTERN FG GROUND MIN-CONTRAST).
;;; GLYPH and PATTERN are what tells a state apart (the accessibility rule
;;; from 0.1.2: never colour alone, glyph first), so every (GLYPH . PATTERN)
;;; pair is unique. FG and GROUND name palette roles ((crash palette)'s
;;; PALETTE), never colours; MIN-CONTRAST is the WCAG ratio the pair must
;;; clear in normal vision and under simulated protanopia, deuteranopia and
;;; tritanopia (4.5 for a reading's digit, 3 for a glyph or a state's edge).
;;; FG #f: nothing is drawn on the ground that needs a ratio.
;;;
;;; The draw ((crash scan draw), after 0.1.2) takes its glyphs, patterns
;;; and colours from here; test-scan-cells holds the table to CELL-STATES
;;; (the same keys, no more, no fewer), to unique glyphs, and to the
;;; contrasts. C-SCAN-1 and C-SCAN-2 are D77's digit 1 blue and digit 2
;;; green: the palette's last two slots, added to (crash palette) once
;;; 0.1.2's retune ships, and until then the only roles allowed to be
;;; missing from PALETTE.
;;;
;;; Rules family: data, no platform.

(define-library (crash scan cells)
  (import (sigil struct))

  (export CELL-LOOK cell-look)

  (begin
    (define CELL-LOOK
      (list
       ;; state            glyph              pattern        fg             ground        min
       (list 'hidden       'block             'bevel         'C-SIDE        'C-BG         3)    ; the rim carries hidden against revealed
       (list 'pressed      'block             'flat          #f            'C-STATIC-B   0)
       (list 'zero         'floor             'wires         #f            'C-BG         0)
       (list 'reading-1    'digit-1           'none          'C-SCAN-1      'C-BG         4.5)
       (list 'reading-2    'digit-2           'none          'C-SCAN-2      'C-BG         4.5)
       (list 'reading-3    'digit-3           'none          'C-TRACE-HOT   'C-BG         4.5)
       (list 'reading-4    'digit-4           'none          'C-HIGHLIGHT   'C-BG         4.5)
       (list 'reading-5    'digit-5           'none          'C-HOT         'C-BG         4.5)
       (list 'reading-6    'digit-6           'none          'C-SELECTED    'C-BG         4.5)
       (list 'reading-7    'digit-7           'none          'C-DAEMON      'C-BG         4.5)
       (list 'reading-8    'digit-8           'none          'C-STATIC-A    'C-BG         4.5)
       (list 'flagged      'pennant           'bevel         'C-ICE         'C-STATIC-B   3)
       (list 'suspect      'question          'bevel         'C-TEXT        'C-STATIC-B   3)
       (list 'tripped      'crystal           'inverted      'C-BG          'C-TRACE-HOT  3)
       (list 'ice          'crystal           'none          'C-ICE         'C-BG         3)
       (list 'defused      'crystal           'brackets      'C-ICE         'C-BG         3)
       (list 'wrong-flag   'pennant           'struck        'C-ICE         'C-STATIC-B   3)
       (list 'firewall-strong 'block          'cross-hatch   'C-TRACE-HOT   'C-STATIC-B   3)
       (list 'firewall-weak   'block          'single-hatch  'C-LABEL-LIT   'C-STATIC-B   3)
       (list 'masked       'noise             'none          'C-TEXT-DIM    'C-BG         3)
       (list 'marked       'notch             'ring          'C-LABEL-LIT   'C-STATIC-B   3)
       (list 'cursor       'ring              'solid         'C-SELECTED    'C-BG         3)
       (list 'cursor-flag  'ring              'dashed        'C-SELECTED    'C-BG         3)))

    ;; The entry of a state, or #f.
    (define (cell-look state)
      (assq state CELL-LOOK))))
