;;; (crash scan generate) - Deal a SCAN segment that never needs a guess.
;;;
;;; A segment is a function of (seed, first click): the ICE is placed after
;;; the uplink, never in its clipped 3x3, so the uplink reads zero and opens
;;; an area. Try k places the ICE uniformly over the other hosts with the
;;; game's MINSTD stream ((crash stack prng)) seeded from `hub-mix seed k 0`
;;; (the hub generator's sub-seed scheme), a partial Fisher-Yates over those
;;; hosts in index order. The solver in (crash scan solve) then plays it
;;; from the uplink; a segment it declines is re-dealt from try k + 1, up to
;;; GEN-TRIES. The deal keeps the solver's recorded line and the try that
;;; built it (D68; the design note's section 3).
;;;
;;; The work is a stepper so a shell can slice it by milliseconds per frame
;;; and never starve the audio (D81): scan-gen-step! does one unit (one
;;; placement, or one solver pass), and scan-gen-run! steps while the
;;; shell's (more?) thunk says yes. The rules family cannot read a clock,
;;; so the budget lives in the thunk. Slicing never changes the result:
;;; the tries run in the same order from the same sub-seeds.
;;;
;;; Rules family: no platform.

(define-library (crash scan generate)
  (import (sigil struct)
          (sigil math)
          (crash stack prng)
          (crash hub gen)
          (crash scan rules)
          (crash scan solve)
          (sigil list))

  (export GEN-TRIES
          dealt dealt? dealt-segment dealt-line dealt-try dealt-seed dealt-first
          place-ice
          scan-gen-start scan-gen-node-start scan-gen-step! scan-gen-run!
          scan-gen-status scan-gen-result scan-gen-try scan-gen-steps
          deal-segment deal-node
          extraction-steps deal-marks)

  (begin
    ;; At EXPERT's 5% first-try rate a deal needs more than 1000 tries with
    ;; probability 0.95^1000, about 5e-23. The sweep in the gate counts.
    (define GEN-TRIES 1000)

    ;; A dealt segment: the uplink already scanned, the recorded line from
    ;; it, and the try that built it.
    (define-struct dealt
      (segment default: #f)
      (line default: '())
      (try default: 0)
      (seed default: 0)
      (first default: 0))

    ;; The ICE vector of try k: m ICE over the hosts outside first's clipped
    ;; 3x3.
    (define (place-ice w h m first seed try)
      (let* ((fx (modulo first w))
             (fy (quotient first w))
             (cands (list->vector
                     (filter (lambda (i)
                               (not (and (<= (abs (- (modulo i w) fx)) 1)
                                         (<= (abs (- (quotient i w) fy)) 1))))
                             (iota (* w h)))))
             (n (vector-length cands))
             (ice (make-vector (* w h) #f)))
        (when (> m n)
          (error "scan generate: more ICE than hosts outside the uplink" m n))
        (let loop ((k 0) (s (prng-seed (hub-mix seed try 0))))
          (when (< k m)
            (let* ((s (prng-next s))
                   (j (+ k (prng-index s (- n k))))
                   (a (vector-ref cands k)))
              (vector-set! cands k (vector-ref cands j))
              (vector-set! cands j a)
              (vector-set! ice (vector-ref cands k) #t)
              (loop (+ k 1) s))))
        ice))

    (define-struct gen
      (w default: 9)
      (h default: 9)
      (m default: 10)
      (preset default: 'lan)
      (version default: 'original)
      (suspects? default: #f)
      (seed default: 0)
      (first default: 0)
      (try default: 0 mutable: #t)
      (seg default: #f mutable: #t)
      (solver default: #f mutable: #t)
      (status default: 'running mutable: #t)   ; running | done | failed
      (result default: #f mutable: #t)
      (steps default: 0 mutable: #t))

    (define (scan-gen-start preset seed first version suspects?)
      (let ((d (preset-dims preset)))
        (unless d (error "scan generate: unknown preset" preset))
        (gen w: (car d)
             h: (cadr d)
             m: (caddr d)
             preset: preset
             version: version
             suspects?: suspects?
             seed: seed
             first: first)))

    ;; A node board (JACK IN): the grid and ICE count from the launch.
    (define (scan-gen-node-start w h m seed first)
      (gen w: w h: h m: m preset: 'node version: 'hacker seed: seed first: first))

    (define (scan-gen-status g) (gen-status g))
    (define (scan-gen-result g) (gen-result g))
    (define (scan-gen-try g) (gen-try g))
    (define (scan-gen-steps g) (gen-steps g))

    ;; One unit of work.
    (define (scan-gen-step! g)
      (when (eq? (gen-status g) 'running)
        (set-gen-steps! g (+ 1 (gen-steps g)))
        (cond ((not (gen-solver g))
               (if (>= (gen-try g) GEN-TRIES)
                   (set-gen-status! g 'failed)
                   (let ((seg (segment-new (gen-w g)
                                           (gen-h g)
                                           (place-ice (gen-w g) (gen-h g) (gen-m g) (gen-first g) (gen-seed g) (gen-try g))
                                           (gen-preset g)
                                           (gen-version g)
                                           (gen-suspects? g))))
                     (set-gen-seg! g seg)
                     (set-gen-solver! g (solve-start seg (gen-first g))))))
              (else
               (case (solve-pass! (gen-solver g))
                 ((solved)
                  (set-gen-result! g (dealt segment: (segment-scan (gen-seg g) (gen-first g))
                                            line: (reverse (solver-line (gen-solver g)))
                                            try: (gen-try g)
                                            seed: (gen-seed g)
                                            first: (gen-first g)))
                  (set-gen-status! g 'done))
                 ((stuck)
                  (set-gen-solver! g #f)
                  (set-gen-seg! g #f)
                  (set-gen-try! g (+ 1 (gen-try g))))
                 (else #f)))))
      (gen-status g))

    ;; Step at least once, then while (more?) says yes and the deal runs.
    (define (scan-gen-run! g more?)
      (let loop ()
        (when (and (eq? (scan-gen-step! g) 'running) (more?))
          (loop)))
      (gen-status g))

    (define (always) #t)

    ;; The whole deal at once (tests and the headless tools), or #f.
    (define (deal-segment preset seed first version suspects?)
      (let ((g (scan-gen-start preset seed first version suspects?)))
        (scan-gen-run! g always)
        (gen-result g)))

    (define (deal-node w h m seed first)
      (let ((g (scan-gen-node-start w h m seed first)))
        (scan-gen-run! g always)
        (gen-result g)))

    ;; --- marks (the node objective, D74) -------------------------------------

    ;; The step of the recorded line at which each host is first extracted
    ;; (every clean host of its 3x3 scanned), replaying from the dealt
    ;; segment; 0 means extracted by the uplink. A vector over the hosts;
    ;; hosts never extracted (ICE) hold #f.
    (define (extraction-steps d)
      (let* ((s0 (dealt-segment d))
             (n (segment-size s0))
             (at (make-vector n #f)))
        (let loop ((s s0) (steps (cdr (dealt-line d))) (k 0))
          (let mark ((i 0))
            (when (< i n)
              (when (and (not (vector-ref at i))
                         (not (segment-ice? s i))
                         (segment-extracted? s i))
                (vector-set! at i k))
              (mark (+ i 1))))
          (unless (null? steps)
            (let ((step (car steps)))
              (loop (if (eq? (car step) 'scan)
                        (segment-scan s (cadr step))
                        (segment-flag s (cadr step)))
                    (cdr steps)
                    (+ k 1)))))
        at))

    ;; K marked hosts: clean hosts with at least one ICE neighbor whose 3x3
    ;; is first extracted in the middle third of the line (the window
    ;; STACK's marks use), drawn by the deal's seed. Fewer when fewer
    ;; qualify. In index order.
    (define (deal-marks d k)
      (let* ((s0 (dealt-segment d))
             (steps (- (length (dealt-line d)) 1))
             (at (extraction-steps d))
             (cands (filter (lambda (i)
                              (let ((t (vector-ref at i)))
                                (and t
                                     (> (segment-reading s0 i) 0)
                                     (>= (* 3 t) steps)
                                     (< (* 3 t) (* 2 steps)))))
                            (iota (segment-size s0)))))
        (let loop ((cands cands) (k k) (s (prng-seed (hub-mix (dealt-seed d) 7 1))) (acc '()))
          (if (or (= k 0) (null? cands))
              (list-sort < acc)
              (let* ((s (prng-next s))
                     (pick (list-ref cands (prng-index s (length cands)))))
                (loop (filter (lambda (c) (not (= c pick))) cands)
                      (- k 1)
                      s
                      (cons pick acc)))))))))
