;;; (crash scan generate) - Deal a SCAN segment that never needs a guess.
;;;
;;; A segment is a function of (seed, first click): the ICE is placed after
;;; the uplink, never in its clipped 3x3, so the uplink reads zero and opens
;;; an area (D68; the design note's section 3).
;;;
;;; Placement 0 puts the ICE uniformly over the other hosts with the game's
;;; MINSTD stream ((crash stack prng)) seeded from `hub-mix seed 0 0` (the
;;; hub generator's sub-seed scheme), a partial Fisher-Yates over those
;;; hosts in index order. The solver in (crash scan solve) plays it from the
;;; uplink. Where it gets stuck, the deal is PERTURBED rather than re-dealt
;;; (Simon Tatham's approach in mines.c): the ICE around one stuck frontier
;;; reading is moved so that reading settles, and the solver carries on.
;;; Re-dealing until the solver cleared a fresh placement cost BACKBONE a
;;; median of 17 placements and p95 63 (measured 2026-09-24 on the web
;;; release build: p95 0.7 s on a desktop, 3.2 s at a 4x CPU throttle),
;;; which D81's first click cannot afford.
;;;
;;; A run that saw a perturbation ends on a segment its own knowledge may
;;; not be derivable on (the moved ICE changed readings it had used), so it
;;; proves nothing: the deal is played again from the uplink, and only the
;;; line of a run that saw no perturbation is dealt. That run's line is a
;;; pure derivation, the same guarantee as a placement cleared first time,
;;; and (crash scan check) re-proves it in the gate. When nothing can be
;;; moved, the next placement (`hub-mix seed k 0`) is dealt. `dealt-try`
;;; counts the perturbations and placements past the first; a deal with
;;; try 0 is exactly the reroll generator's first placement.
;;;
;;; The work is a stepper so a shell can slice it by milliseconds per frame
;;; and never starve the audio (D81): scan-gen-step! does one unit (a
;;; placement, a solver unit, or a perturbation), and scan-gen-run! steps
;;; while the shell's (more?) thunk says yes. The rules family cannot read
;;; a clock, so the budget lives in the thunk. Slicing never changes the
;;; result: the units run in the same order from the same streams.
;;;
;;; Rules family: no platform.

(define-library (crash scan generate)
  (import (sigil struct)
          (sigil math)
          (crash stack prng)
          (crash hub gen)
          (crash scan rules)
          (crash scan solve)
          (sigil list))

  (export GEN-TRIES GEN-BUDGET-MS
          dealt dealt? dealt-segment dealt-line dealt-try dealt-perturbs dealt-placements
          dealt-seed dealt-first
          place-ice
          scan-gen-start scan-gen-node-start scan-gen-step! scan-gen-run!
          scan-gen-status scan-gen-result scan-gen-try scan-gen-steps
          deal-segment deal-node
          extraction-steps deal-marks)

  (begin
    ;; Perturbations and placements past the first before a deal gives up
    ;; (#f). The sweep in the gate counts what a deal takes.
    (define GEN-TRIES 1000)

    ;; Generation per frame, in ms, for the shell's (more?) thunk: half a 60 fps
    ;; frame (the leader, 2026-09-24, after David's flagship read), so a slow
    ;; device takes more frames rather than longer ones. A frame is this plus
    ;; at most one unit; the audio rings hold 256 ms (cues) and 341 ms (music).
    (define GEN-BUDGET-MS 8)

    ;; A dealt segment: the uplink already scanned, the recorded line from
    ;; it, and what it took: `try` is perturbations plus placements past the
    ;; first (0: placement 0 cleared as dealt), counted apart in `perturbs`
    ;; and `placements`.
    (define-struct dealt
      (segment default: #f)
      (line default: '())
      (try default: 0)
      (perturbs default: 0)
      (placements default: 0)          ; placements past the first
      (seed default: 0)
      (first default: 0))

    ;; The ICE vector of placement k: m ICE over the hosts outside first's
    ;; clipped 3x3, a partial Fisher-Yates from `hub-mix seed k 0`.
    (define (place-ice w h m first seed try)
      (place-from (candidates w h first) (* w h) m seed try))

    (define (place-from cands0 n m seed try)
      (let* ((cands (vector-copy cands0))
             (c (vector-length cands))
             (ice (make-vector n #f)))
        (let loop ((k 0) (s (prng-seed (hub-mix seed try 0))))
          (when (< k m)
            (let* ((s (prng-next s))
                   (j (+ k (prng-index s (- c k))))
                   (a (vector-ref cands k)))
              (vector-set! cands k (vector-ref cands j))
              (vector-set! cands j a)
              (vector-set! ice (vector-ref cands k) #t)
              (loop (+ k 1) s))))
        ice))

    ;; The hosts outside first's clipped 3x3, in index order: the only
    ;; hosts ICE may occupy. The same for every try of a deal.
    (define (candidates w h first)
      (let ((fx (modulo first w))
            (fy (quotient first w)))
        (list->vector
         (filter (lambda (i)
                   (not (and (<= (abs (- (modulo i w) fx)) 1)
                             (<= (abs (- (quotient i w) fy)) 1))))
                 (iota (* w h))))))

    (define-struct gen
      (w default: 9)
      (h default: 9)
      (m default: 10)
      (preset default: 'lan)
      (version default: 'original)
      (suspects? default: #f)
      (seed default: 0)
      (first default: 0)
      (cands default: (vector))
      (try default: 0 mutable: #t)             ; placements dealt so far, minus one
      (perturbs default: 0 mutable: #t)        ; perturbations so far
      (rng default: 1 mutable: #t)             ; the perturbation stream's state
      (placed default: #f mutable: #t)         ; a placement's ICE vector, its segment not built yet
      (fresh default: #f mutable: #t)          ; a placement's segment, its solver not started yet
      (stuck? default: #f mutable: #t)         ; the solver is stuck: the next unit perturbs
      (solver default: #f mutable: #t)
      (pure? default: #t mutable: #t)          ; the solver's run has seen no perturbation
      (status default: 'running mutable: #t)   ; running | done | failed
      (result default: #f mutable: #t)
      (steps default: 0 mutable: #t))

    (define (scan-gen-start preset seed first version suspects?)
      (let ((d (preset-dims preset)))
        (unless d (error "scan generate: unknown preset" preset))
        (gen-new (car d)
                 (cadr d)
                 (caddr d)
                 preset
                 version
                 suspects?
                 seed
                 first)))

    ;; A node board (JACK IN): the grid and ICE count from the launch.
    (define (scan-gen-node-start w h m seed first)
      (gen-new w
               h
               m
               'node
               'hacker
               #f
               seed
               first))

    (define (gen-new w h m preset version suspects? seed first)
      (let ((cands (candidates w h first)))
        (when (> m (vector-length cands))
          (error "scan generate: more ICE than hosts outside the uplink"
                 m
                 (vector-length cands)))
        (gen w: w
             h: h
             m: m
             preset: preset
             version: version
             suspects?: suspects?
             seed: seed
             first: first
             cands: cands
             rng: (prng-seed (hub-mix seed 0 1)))))

    (define (scan-gen-status g) (gen-status g))
    (define (scan-gen-result g) (gen-result g))
    (define (scan-gen-try g) (+ (gen-try g) (gen-perturbs g)))
    (define (scan-gen-steps g) (gen-steps g))

    (define (gen-segment g ice)
      (segment-new (gen-w g)
                   (gen-h g)
                   ice
                   (gen-preset g)
                   (gen-version g)
                   (gen-suspects? g)))

    ;; Deal placement k (gen-try), a pure run on it to come. A placement
    ;; comes in three units of its own (D81: the grain): the
    ;; shuffle, the segment built from it, the solver started on it.
    (define (deal-placement! g)
      (set-gen-placed! g (place-from (gen-cands g)
                                     (* (gen-w g) (gen-h g))
                                     (gen-m g)
                                     (gen-seed g)
                                     (gen-try g)))
      (set-gen-solver! g #f)
      (set-gen-pure?! g #t))

    (define (build-placed! g)
      (set-gen-fresh! g (gen-segment g (gen-placed g)))
      (set-gen-placed! g #f))

    (define (start-fresh! g)
      (set-gen-solver! g (solve-start (gen-fresh g) (gen-first g)))
      (set-gen-fresh! g #f))

    ;; A stuck solver's perturbation, a unit after the one that found it
    ;; stuck; with nothing to move, the next placement, unless that would
    ;; pass GEN-TRIES (no placement dealt to be dropped).
    (define (unstick! g st)
      (set-gen-stuck?! g #f)
      (unless (perturb! g st)
        (set-gen-try! g (+ 1 (gen-try g)))
        (if (>= (scan-gen-try g) GEN-TRIES)
            (set-gen-status! g 'failed)
            (deal-placement! g))))

    ;; One unit of work.
    (define (scan-gen-step! g)
      (when (eq? (gen-status g) 'running)
        (set-gen-steps! g (+ 1 (gen-steps g)))
        (let ((st (gen-solver g)))
          (cond ((gen-placed g) (build-placed! g))
                ((gen-fresh g) (start-fresh! g))
                ((gen-stuck? g) (unstick! g st))
                ((not st) (deal-placement! g))
                ((>= (scan-gen-try g) GEN-TRIES) (set-gen-status! g 'failed))
                (else
                 (case (solve-pass! st)
                   ((solved)
                    (if (gen-pure? g)
                        (begin
                          (set-gen-result! g (dealt segment: (segment-scan (solver-seg st) (gen-first g))
                                                    line: (reverse (solver-line st))
                                                    try: (scan-gen-try g)
                                                    perturbs: (gen-perturbs g)
                                                    placements: (gen-try g)
                                                    seed: (gen-seed g)
                                                    first: (gen-first g)))
                          (set-gen-status! g 'done))
                        ;; a run that saw a perturbation proves nothing about
                        ;; the segment it ended on: play it again from the uplink
                        (begin
                          (set-gen-solver! g (solve-start (solver-seg st) (gen-first g)))
                          (set-gen-pure?! g #t))))
                   ((stuck) (set-gen-stuck?! g #t))
                   (else #f))))))
      (gen-status g))

    ;; Step at least once, then while (more?) says yes and the deal runs.
    (define (scan-gen-run! g more?)
      (let loop ()
        (when (and (eq? (scan-gen-step! g) 'running) (more?))
          (loop)))
      (gen-status g))

    (define (always) #t)

    ;; The whole deal at once (tests and the headless tools), or #f.
    (define (deal-segment preset seed first version suspects?)
      (let ((g (scan-gen-start preset seed first version suspects?)))
        (scan-gen-run! g always)
        (gen-result g)))

    (define (deal-node w h m seed first)
      (let ((g (scan-gen-node-start w h m seed first)))
        (scan-gen-run! g always)
        (gen-result g)))

    ;; --- the perturbation (Tatham's, mines.c) ---------------------------------

    ;; An index in [0, n) from the perturbation stream.
    (define (draw! g n)
      (let ((s (prng-next (gen-rng g))))
        (set-gen-rng! g s)
        (prng-index s n)))

    ;; k distinct members of a list, drawn in order.
    (define (pick! g xs k)
      (let loop ((xs xs) (k k) (acc '()))
        (if (= k 0)
            (reverse acc)
            (let ((x (list-ref xs (draw! g (length xs)))))
              (loop (filter (lambda (y) (not (= y x))) xs) (- k 1) (cons x acc))))))

    ;; A stuck solver: pick a frontier reading R (drawn), and make every
    ;; hidden neighbor of R clean, moving their ICE to hidden hosts that
    ;; touch nothing open (so no reading the solver has seen changes there);
    ;; or, failing that, make them all ICE, taking ICE from such hosts; and
    ;; failing both, the same with any hidden host outside R's set. Then R
    ;; settles under rule (a) or (b). The solver continues on the new
    ;; segment. #f when there is no frontier or nothing to move.
    (define (perturb! g st)
      (let* ((seg (solver-seg st))
             (n (segment-size seg))
             (open (solver-open st))
             (flag (solver-flag st))
             (around (solver-around st))
             (frontier (solver-frontier st)))
        (and (pair? frontier)
             (let* ((r (list-ref frontier (draw! g (length frontier))))
                    (set (filter (lambda (i) (not (or (vector-ref open i) (vector-ref flag i))))
                                 (segment-neighbors seg r)))
                    (pools (classify seg
                                     open
                                     flag
                                     around
                                     set
                                     n))
                    (set-ice (filter (lambda (i) (segment-ice? seg i)) set))
                    (set-clean (filter (lambda (i) (not (segment-ice? seg i))) set))
                    (far-clean (list-ref pools 0))
                    (far-ice (list-ref pools 1))
                    (any-clean (append far-clean (list-ref pools 2)))
                    (any-ice (append far-ice (list-ref pools 3)))
                    (move (or (plan g set-ice far-clean 'clear)
                              (plan g set-clean far-ice 'fill)
                              (plan g set-ice any-clean 'clear)
                              (plan g set-clean any-ice 'fill))))
               (and move
                    (begin
                      (set-gen-perturbs! g (+ 1 (gen-perturbs g)))
                      (set-gen-pure?! g #f)
                      (solve-perturbed! st
                                        (segment-move-ice seg (car move) (cadr move))
                                        (append (car move) (cadr move)))
                      #t))))))

    ;; The hidden hosts outside `set`, in one pass, as four lists in index
    ;; order: far clean, far ICE (far: no open neighbor, so no reading the
    ;; solver has seen touches them), near clean, near ICE.
    (define (classify seg open flag around set n)
      (let loop ((i (- n 1)) (fc '()) (fi '()) (nc '()) (ni '()))
        (cond ((< i 0) (list fc fi nc ni))
              ((or (vector-ref open i) (vector-ref flag i) (memv i set))
               (loop (- i 1) fc fi nc ni))
              ((= 0 (vector-ref around i))
               (if (segment-ice? seg i)
                   (loop (- i 1) fc (cons i fi) nc ni)
                   (loop (- i 1) (cons i fc) fi nc ni)))
              ((segment-ice? seg i) (loop (- i 1) fc fi nc (cons i ni)))
              (else (loop (- i 1) fc fi (cons i nc) ni)))))

    ;; 'clear: the ICE of `hosts` moves to as many of `pool` (clean hosts).
    ;; 'fill: `hosts` (clean) take the ICE of as many of `pool` (ICE hosts).
    ;; #f when the pool is too small.
    ;; An empty `hosts` is no plan: a move of nothing must never count as a
    ;; perturbation.
    (define (plan g hosts pool kind)
      (and (pair? hosts)
           (>= (length pool) (length hosts))
           (let ((picked (pick! g pool (length hosts))))
             (if (eq? kind 'clear)
                 (list hosts picked)
                 (list picked hosts)))))

    ;; --- marks (the node objective, D74) -------------------------------------

    ;; The step of the recorded line at which each host is first extracted
    ;; (every clean host of its 3x3 scanned), replaying from the dealt
    ;; segment; 0 means extracted by the uplink. A vector over the hosts;
    ;; hosts never extracted (ICE) hold #f.
    (define (extraction-steps d)
      (let* ((s0 (dealt-segment d))
             (n (segment-size s0))
             (at (make-vector n #f)))
        (let loop ((s s0) (steps (cdr (dealt-line d))) (k 0))
          (let mark ((i 0))
            (when (< i n)
              (when (and (not (vector-ref at i))
                         (not (segment-ice? s i))
                         (segment-extracted? s i))
                (vector-set! at i k))
              (mark (+ i 1))))
          (unless (null? steps)
            (let ((step (car steps)))
              (loop (if (eq? (car step) 'scan)
                        (segment-scan s (cadr step))
                        (segment-flag s (cadr step)))
                    (cdr steps)
                    (+ k 1)))))
        at))

    ;; K marked hosts: clean hosts with at least one ICE neighbor whose 3x3
    ;; is first extracted in the middle third of the line (the window
    ;; STACK's marks use), drawn by the deal's seed. Fewer when fewer
    ;; qualify. In index order.
    (define (deal-marks d k)
      (let* ((s0 (dealt-segment d))
             (steps (- (length (dealt-line d)) 1))
             (at (extraction-steps d))
             (cands (filter (lambda (i)
                              (let ((t (vector-ref at i)))
                                (and t
                                     (> (segment-reading s0 i) 0)
                                     (>= (* 3 t) steps)
                                     (< (* 3 t) (* 2 steps)))))
                            (iota (segment-size s0)))))
        (let loop ((cands cands) (k k) (s (prng-seed (hub-mix (dealt-seed d) 7 1))) (acc '()))
          (if (or (= k 0) (null? cands))
              (list-sort < acc)
              (let* ((s (prng-next s))
                     (pick (list-ref cands (prng-index s (length cands)))))
                (loop (filter (lambda (c) (not (= c pick))) cands)
                      (- k 1)
                      s
                      (cons pick acc)))))))))
