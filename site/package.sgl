;; The crashthestack.com site (P4b, ruling D20): a Press site beside the
;; game, built to site/public and deployed by scripts/publish-web with the
;; game under /jack-in/ and the tracker under /tracker/.
;;
;;   cd site && sigil deps install && sigil run -- build     -> public/
;;   cd site && sigil run -- serve                            a dev server
(package
  name: "crash-site"
  version: "0.1.0"
  sigil: "0.22"
  description: "crashthestack.com: the landing, About, the news with its feeds, the docs"
  license: "GPL-3.0-or-later"
  authors: (list "David Wilson <david@daviwil.com>")

  entry: '(crash-site main)

  dependencies: (list
    ;; Press 0.1.6: the first release with (press feeds)
    (from-git url: "codeberg:sigil/press" package: "press" version: "^0.1.6"))

  dev-dependencies: (list
    (from-git url: "codeberg:sigil/sigil" package: "sigil-test" version: ">=0.22")
    (from-git url: "codeberg:sigil/sigil" package: "sigil-test-runner" version: ">=0.22")))
