;;; (crash-site theme) - The HTML shell every page of crashthestack.com
;;; gets: the logo, the nav (PLAY, ABOUT, NEWS, DOCS, SOURCE), the
;;; article, the footer with the licences line and the feed links. The
;;; landing page (landing-page, a complete document built in main.sgl
;;; with the newest post's title) skips the theme; everything else (About,
;;; the news posts and their index, the tracker doc) comes through here.
;;;
;;; The look is the game's: the palette's ground and text roles
;;; (assets/palette.sgl), a monospace face, no web fonts and no scripts
;;; of the site's own (two exceptions, both on the landing: the redirect
;;; for the game's old URLs and the screenshot rotation), and Plausible's
;;; analytics tag in every page's head.

(define-library (crash-site theme)
  (import (sigil core)
          (sigil list)
          (sigil string)
          (press scan))
  (export crash-theme
          landing-page
          not-found-page
          news-listing
          page-description)

  (begin
    (define SITE-URL "https://crashthestack.com")

    ;; Plausible Analytics (David, 2026-09-30): his snippet, byte for byte,
    ;; in every page's head, as raw HTML so the renderer leaves it alone.
    ;; No cookies and no personal data, which the footer says. verify-site's
    ;; analytics leg (scripts/plausible-check.mjs) checks every staged page
    ;; carries it exactly once with this site's script ID.
    (define PLAUSIBLE-SNIPPET
      (string-append
        "<!-- Privacy-friendly analytics by Plausible -->\n"
        "<script async src=\"https://plausible.io/js/pa-5iTMFNFjYxMn3THin-cwJ.js\"></script>\n"
        "<script>\n"
        "  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};\n"
        "  plausible.init()\n"
        "</script>"))

    (define (analytics)
      `(*raw* ,PLAUSIBLE-SNIPPET))
    (define GITHUB-URL "https://github.com/FluxHarmonic/crash-the-stack")
    ;; the Linux and Windows builds (and the browser one) on itch.io: the nav's DOWNLOAD (David, 2026-10-12)
    (define ITCH-URL "https://fluxharmonic.itch.io/crash-the-stack")

    ;; The site's one line, David's (2026-10-12): the landing's tagline and the
    ;; start of every description. One string, so a new wording is one edit.
    ;; His rule for the site's copy: no game names and no count of games,
    ;; since both change over time (the screenshot captions name their own
    ;; game; that is labelling, not copy).
    (define TAGLINE "Cyberpunk takes on classic casual games, linked by a network you can hack.")

    ;; The <meta name="description"> for a page: its front matter's
    ;; summary:, else the site's one line.
    (define (page-description item)
      (let ((summary (dict-ref (item-metadata item) summary: #f)))
        (if summary
            (format "~a" summary)
            (string-append TAGLINE " Free to play in the browser."))))

    ;; A post's date: the front matter's date:, shown as its day (the time
    ;; part orders same-day posts in the feeds and the index).
    (define (item-date item)
      (let ((date (dict-ref (item-metadata item) date: #f)))
        (and date (let ((text (format "~a" date)))
                    (if (> (string-length text) 10) (substring text 0 10) text)))))

    ;; The link preview (0.1.3): Open Graph and Twitter's large card, with a
    ;; shot of a real board rather than the app icon (the promotion review,
    ;; 2026-09-25: a shared link showed the icon). OG-IMAGE is a 1200x630
    ;; frame of a fresh STACK board, taken from the game, in assets/.
    (define OG-IMAGE (string-append SITE-URL "/og-image.png"))
    (define OG-IMAGE-ALT "A board of Crash The Stack: circuit-glyph tiles stacked in layers, the trace meter and the tile count in the bar below.")
    (define (social-meta title description url)
      `((meta (@ (property "og:type") (content "website")))
        (meta (@ (property "og:site_name") (content "Crash The Stack")))
        (meta (@ (property "og:title") (content ,title)))
        (meta (@ (property "og:description") (content ,description)))
        (meta (@ (property "og:url") (content ,url)))
        (meta (@ (property "og:image") (content ,OG-IMAGE)))
        (meta (@ (property "og:image:width") (content "1200")))
        (meta (@ (property "og:image:height") (content "630")))
        (meta (@ (property "og:image:alt") (content ,OG-IMAGE-ALT)))
        (meta (@ (name "twitter:card") (content "summary_large_image")))
        (meta (@ (name "twitter:title") (content ,title)))
        (meta (@ (name "twitter:description") (content ,description)))
        (meta (@ (name "twitter:image") (content ,OG-IMAGE)))
        (meta (@ (name "twitter:image:alt") (content ,OG-IMAGE-ALT)))))

    ;; /404.html (0.1.3): Cloudflare Pages answers a missing path with the
    ;; nearest 404.html and status 404; with none anywhere it answers the
    ;; landing page with 200, so every missing file (a stale link, a
    ;; /version.json that is not there) looked present (topics/
    ;; cloudflare-pages-serves-index-for-a-missing-path). A complete
    ;; document, absolute links (it answers at any depth), no index.
    (define (not-found-page)
      `(html (@ (lang "en"))
         (head
           (meta (@ (charset "utf-8")))
           (meta (@ (name "viewport") (content "width=device-width, initial-scale=1")))
           (meta (@ (name "robots") (content "noindex")))
           (title "Not found / Crash The Stack")
           (link (@ (rel "icon") (href "/favicon-32.png") (sizes "32x32") (type "image/png")))
           (link (@ (rel "stylesheet") (href "/style.css")))
           ,(analytics))
         (body
           ,(header)
           (main (@ (class "wrap"))
             (article (@ (class "page not-found"))
               (h1 "404: link severed")
               (p "There's nothing at this address. The page may have moved, or the link was mistyped.")
               (p (a (@ (href "/jack-in/") (class "cta")) "JACK IN") " to play, or head back to the " (a (@ (href "/")) "front page") ".")))
           ,(footer))))

    (define (nav)
      `(nav (@ (class "nav"))
         (a (@ (href "/jack-in/") (class "play")) "PLAY")
         (a (@ (href ,ITCH-URL) (class "download")) "DOWNLOAD")
         (a (@ (href "/about/")) "ABOUT")
         (a (@ (href "/news/")) "NEWS")
         (a (@ (href "/soundtrack/")) "SOUNDTRACK")   ; the album's listening page (its own bundle, staged beside the site)
         (a (@ (href "/docs/")) "DOCS")   ; the docs landing: How to Play, the tracker manual
         (a (@ (href ,GITHUB-URL)) "SOURCE")))

    (define (header)
      `(header (@ (class "top"))
         (a (@ (href "/") (class "logo-link"))
            (img (@ (src "/logo.png") (alt "Crash The Stack") (width "640") (height "112") (class "logo"))))
         ,(nav)))

    ;; The footer on every page (the landing, the themed pages, the 404).
    ;; Since 2026-10-12 it opens with the Flux Harmonic mark linking the
    ;; studio, as harkfell.com's and phantomburn.net's do: the same file
    ;; (assets/mark.png, 380x188, byte for byte theirs), drawn at 190 px
    ;; wide so it is sharp at 2x, and the same "Made by" line under it.
    ;; Loaded lazily: it is 33 KB and below the fold on every page.
    (define (footer)
      `(footer (@ (class "foot"))
         (a (@ (class "mark") (href "https://fluxharmonic.com/"))
            (img (@ (src "/mark.png") (width "380") (height "188") (loading "lazy") (alt "Flux Harmonic"))))
         (p "Made by David Wilson at Flux Harmonic. Written in " (a (@ (href "https://usesigil.org/")) "Sigil") ".")
         (p "Code GPL-3.0-or-later. Art, audio and content CC-BY-4.0, credit David Wilson / Flux Harmonic. The name, the logo, the title art and the Flux Harmonic mark are reserved.")
         (p (a (@ (href "/news/feed.xml")) "RSS")
            " / "
            (a (@ (href "/news/feed.json")) "JSON Feed")
            " / "
            (a (@ (href ,GITHUB-URL)) "Source on GitHub")
            " / "
            (a (@ (href "https://fluxharmonic.com")) "Flux Harmonic"))
         (p "Also from Flux Harmonic: " (a (@ (href "https://harkfell.com/")) "Harkfell") " and " (a (@ (href "https://phantomburn.net/")) "Phantom Burn"))
         (p "Privacy-friendly analytics by " (a (@ (href "https://plausible.io/data-policy")) "Plausible") ": no cookies, no personal data.")
         (p "(C) 2026 David Wilson")))

    ;; The theme: (config state item body) -> a page.
    (define (crash-theme config state item body)
      (let* ((title (item-title item))
             (site-title (dict-ref config title: "Crash The Stack"))
             (date (item-date item))
             (path (item-output-path item))
             (canonical (string-append SITE-URL (output-path->url path)))
             (post? (string-contains? path "/news/"))
             (description (page-description item)))
        `(html (@ (lang "en"))
           (head
             (meta (@ (charset "utf-8")))
             (meta (@ (name "viewport") (content "width=device-width, initial-scale=1")))
             (title ,(string-append title " / " site-title))
             (meta (@ (name "description") (content ,description)))
             ,@(social-meta title description canonical)
             (link (@ (rel "canonical") (href ,canonical)))
             (link (@ (rel "icon") (href "/favicon-32.png") (sizes "32x32") (type "image/png")))
             (link (@ (rel "icon") (href "/icon-192.png") (sizes "192x192") (type "image/png")))
             (link (@ (rel "apple-touch-icon") (href "/icon-192.png")))
             (link (@ (rel "alternate") (type "application/rss+xml") (title "Crash The Stack news") (href "/news/feed.xml")))
             (link (@ (rel "alternate") (type "application/feed+json") (title "Crash The Stack news") (href "/news/feed.json")))
             (link (@ (rel "stylesheet") (href "/style.css")))
             ,(analytics))
           (body
             ,(header)
             (main (@ (class "wrap"))
               (article (@ (class ,(if post? "post" "page")))
                 (h1 ,title)
                 ,@(if (and post? date)
                       `((p (@ (class "date")) (time (@ (datetime ,date)) ,date)))
                       '())
                 ,@(strip-leading-h1 body)))
             ,(footer)))))

    ;; A Markdown page's first heading is its title, which the theme
    ;; already set; keep the body from repeating it.
    (define (strip-leading-h1 body)
      (if (and (pair? body) (pair? (car body)) (eq? (caar body) 'h1))
          (cdr body)
          body))

    (define (output-path->url path)
      (if (string-ends-with? path "/index.html")
          (substring path 0 (- (string-length path) 10))
          path))

    ;; The landing: a complete document (Press emits it as is). Its head
    ;; script is the URL move's redirect (P4b): the game lived at the root
    ;; until 0.1, so a root URL with a query is a game link (a share code,
    ;; ?stack, ?daily, a dev door) and goes to /jack-in/ with the query
    ;; intact, and the old installed PWA (start_url "/", fullscreen) lands
    ;; on the game too. Cloudflare Pages' _redirects cannot match a query,
    ;; so the page does it, before anything paints.
    (define REDIRECT-SCRIPT
      (string-append
        "(function () {\n"
        "  var q = location.search, h = location.hash;\n"
        "  var app = matchMedia('(display-mode: fullscreen)').matches || matchMedia('(display-mode: standalone)').matches;\n"
        "  if (q.length > 1 || app) location.replace('/jack-in/' + q + h);\n"
        "})();"))

    ;; The landing's screenshots (2026-10-12, after Harkfell's): one store
    ;; shot per game (flux-harmonic games/crash-the-stack/store/, SHOTS.md says how
    ;; each was taken) at the game's own 640x400, recovered exactly from the
    ;; 2x captures (every other pixel; scaled back up, no pixel differs) and
    ;; saved as lossless palette PNGs in assets/shots/. The page draws them
    ;; with nearest-neighbor scaling, so they stay crisp at any whole scale.
    ;; Each: the file, the alt text, the dot's label, and the caption
    ;; (the game's name and the classic it keeps, as FREE PLAY's tiles say).
    (define SHOTS
      '(("stack.png"
         "A Mahjongg-style board of stacked tiles mid-game, each tile a colorful circuit symbol with a yellow two-letter tag above it; a small raised pyramid sits in the middle, and the bar below reads TRACE 354 and TILES 112."
         "STACK" "STACK / MAHJONGG SOLITAIRE")
        ("decrypt.png"
         "A match-3 board of colorful glyphs (red rings, yellow diamonds, purple plus signs, blue squares, green triangles, orange crosses) mid-cascade: a column is falling into an empty gap, two star WILDCARDs have just appeared, a \"250\" score floats up, and \"WILDCARD COMPILED.\" shows above the board; SCORE 2580 on the left."
         "DECRYPT" "DECRYPT / MATCH-3")
        ("intercept.png"
         "A rhythm game: blue and orange bars fall down four lanes toward keys labeled D, F, J and K, with SYNC hits flashing near the bottom, a combo of 51 at x4 in the middle, and the song \"Black Glass\" on Elite at the top."
         "INTERCEPT" "INTERCEPT / FOUR-LANE RHYTHM")
        ("defrag.png"
         "A solitaire table of white cards marked with blue and orange data symbols: two foundation cards up top, a draw pile and a face-up 6 beside it, and five columns below with runs like 5, 4, 3, 2 in alternating colors; each card has a yellow letter tag."
         "DEFRAG" "DEFRAG / KLONDIKE SOLITAIRE")
        ("scan.png"
         "A wide Minesweeper grid half cleared, with blue, green, red and pink number readings and dozens of orange flags along the edge of the cleared area, gray unscanned squares filling the left side, and ICE 61 in the bar below."
         "SCAN" "SCAN / MINESWEEPER")
        ("jack-in-hub.png"
         "A dim top-down cyberspace map: a small cyan runner stands at a room's doorway after crossing a glowing link, a gray drone below him sweeps a cone of orange dots across the room, and a green terminal marked 2 sits by the wall; the bar reads LAYER 1/6 and QUIET 90 BPM."
         "The JACK IN hub" "JACK IN / THE HUB")))

    ;; The rotation: one shot at a time, crossfading every data-interval ms;
    ;; a dot picks one; the pointer over the picture or focus on a dot
    ;; pauses it; a reader who asked for reduced motion gets no automatic
    ;; change. Without the script the first shot and its caption stay and
    ;; the dots stay hidden. Written without < > & so the page's text
    ;; escaping cannot touch it.
    (define SHOTS-SCRIPT
      (string-append
        "(function () {\n"
        "  var c = document.querySelector('.shots');\n"
        "  if (!c) return;\n"
        "  var imgs = c.querySelectorAll('.frames img'), dots = c.querySelectorAll('.dots button');\n"
        "  var cap = c.querySelector('.caption');\n"
        "  var every = Number(c.getAttribute('data-interval')) || 5000;\n"
        "  var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n"
        "  var at = 0, timer = null, held = false;\n"
        "  function show(n) {\n"
        "    at = (n + imgs.length) % imgs.length;\n"
        "    Array.prototype.forEach.call(imgs, function (img, k) {\n"
        "      img.classList.toggle('shown', k === at);\n"
        "      if (k === at) img.removeAttribute('aria-hidden'); else img.setAttribute('aria-hidden', 'true');\n"
        "      if (k === at) dots[k].setAttribute('aria-current', 'true'); else dots[k].removeAttribute('aria-current');\n"
        "    });\n"
        "    cap.textContent = imgs[at].getAttribute('data-caption');\n"
        "  }\n"
        "  function start() { if (!still) if (!timer) if (!held) if (!document.hidden) timer = setInterval(function () { show(at + 1); }, every); }\n"
        "  function stop() { clearInterval(timer); timer = null; }\n"
        "  function hold(on) { held = on; if (on) stop(); else start(); }\n"
        "  Array.prototype.forEach.call(dots, function (d, k) {\n"
        "    d.addEventListener('click', function () { stop(); show(k); start(); });\n"
        "  });\n"
        "  var f = c.querySelector('.frames');\n"
        "  f.addEventListener('mouseenter', function () { hold(true); });\n"
        "  f.addEventListener('mouseleave', function () { hold(false); });\n"
        "  c.addEventListener('focusin', function () { hold(true); });\n"
        "  c.addEventListener('focusout', function () { hold(false); });\n"
        "  document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else start(); });\n"
        "  c.classList.add('live');\n"
        "  start();\n"
        "})();"))

    (define (showcase)
      `(section (@ (class "shots") (aria-label "Screenshots") (data-interval "5000"))
         (div (@ (class "frames"))
           ,@(let loop ((shots SHOTS) (first? #t) (out '()))
               (if (null? shots)
                   (reverse out)
                   (let* ((s (car shots))
                          (img `(img (@ (class ,(if first? "shot shown" "shot"))
                                        (src ,(string-append "/shots/" (car s)))
                                        (width "640") (height "400")
                                        ,@(if first? '() '((aria-hidden "true")))
                                        (data-caption ,(list-ref s 3))
                                        (alt ,(cadr s))))))
                     (loop (cdr shots) #f (cons img out))))))
         (p (@ (class "caption") (aria-hidden "true")) ,(list-ref (car SHOTS) 3))
         (div (@ (class "dots") (role "group") (aria-label "Pick a screenshot"))
           ,@(let loop ((shots SHOTS) (first? #t) (out '()))
               (if (null? shots)
                   (reverse out)
                   (loop (cdr shots) #f
                         (cons `(button (@ (type "button") (aria-label ,(list-ref (car shots) 2))
                                           ,@(if first? '((aria-current "true")) '())))
                               out)))))))

    (define (landing-page newest)
      (let ((description (string-append TAGLINE " Free to play in the browser, by David Wilson / Flux Harmonic.")))
        `(html (@ (lang "en"))
           (head
             (meta (@ (charset "utf-8")))
             (meta (@ (name "viewport") (content "width=device-width, initial-scale=1")))
             (title "Crash The Stack")
             (meta (@ (name "description") (content ,description)))
             ,@(social-meta "Crash The Stack" description (string-append SITE-URL "/"))
             (link (@ (rel "canonical") (href ,(string-append SITE-URL "/"))))
             (link (@ (rel "icon") (href "/favicon-32.png") (sizes "32x32") (type "image/png")))
             (link (@ (rel "icon") (href "/icon-192.png") (sizes "192x192") (type "image/png")))
             (link (@ (rel "apple-touch-icon") (href "/icon-192.png")))
             (link (@ (rel "alternate") (type "application/rss+xml") (title "Crash The Stack news") (href "/news/feed.xml")))
             (link (@ (rel "alternate") (type "application/feed+json") (title "Crash The Stack news") (href "/news/feed.json")))
             (script ,REDIRECT-SCRIPT)
             (link (@ (rel "stylesheet") (href "/style.css")))
             ,(analytics))
           (body
             (header (@ (class "hero"))
               (img (@ (src "/logo.png") (alt "Crash The Stack") (width "640") (height "112") (class "logo")))
               (p (@ (class "tag")) ,TAGLINE)
               ;; the screenshots between the description and the button, as harkfell.com has them (David, 2026-10-12)
               ,(showcase)
               ;; JACK IN first (verify-site's landing leg reads the first a.cta), DOWNLOAD beside it (David, 2026-10-12)
               (p (@ (class "ctas"))
                  (a (@ (href "/jack-in/") (class "cta")) "JACK IN")
                  " "
                  (a (@ (href ,ITCH-URL) (class "cta-alt")) "DOWNLOAD"))
               (p (@ (class "hint")) "Free to play in the browser. Installs as an app on your phone. Linux and Windows downloads on itch.io."))
             ,(nav)
             (main (@ (class "wrap"))
               (section (@ (class "blurb"))
                 (p "You're Crash, a hacker on a mission to bring down Gibson, an AI that has grown past anyone's control. Every system you break into is guarded by a game, and you beat it to get through. Each one is a classic casual game you already know, with the rules you remember and the network's colors on top. Jack in to hack your way through the network one system at a time, or jump straight into any game you like.")
                 (p "Learn how the game was made on the " (a (@ (href "/about/")) "About page") "; the " (a (@ (href "https://github.com/FluxHarmonic/crash-the-stack")) "source is public") "."))
               ,@(if newest
                     `((section (@ (class "latest"))
                         (h2 "Latest from the news")
                         (p (time (@ (datetime ,(or (item-date newest) ""))) ,(or (item-date newest) ""))
                            " "
                            (a (@ (href ,(output-path->url (item-output-path newest)))) ,(item-title newest)))
                         (p (a (@ (href "/news/")) "All posts") " / " (a (@ (href "/news/feed.xml")) "RSS") " / " (a (@ (href "/news/feed.json")) "JSON Feed"))))
                     '()))
             ,(footer)
             (script ,SHOTS-SCRIPT)))))

    ;; The news index's listing: (title items) -> sxml, for collection-page.
    (define (news-listing title items)
      `((p (@ (class "lede")) "The story of how Crash The Stack was built. Follow along via the feeds: "
           (a (@ (href "/news/feed.xml")) "RSS") " and " (a (@ (href "/news/feed.json")) "JSON Feed") ".")
        (ul (@ (class "posts"))
          ,@(map (lambda (item)
                   `(li
                      (time (@ (datetime ,(or (item-date item) ""))) ,(or (item-date item) ""))
                      (a (@ (href ,(output-path->url (item-output-path item)))) ,(item-title item))
                      ,@(let ((summary (dict-ref (item-metadata item) summary: #f)))
                          (if summary `((p (@ (class "summary")) ,(format "~a" summary))) '()))))
                 items))))))
