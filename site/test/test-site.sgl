;;; test-site.sgl - The site's own checks: the disclosure paragraph on the
;;; About page is the approved text byte for byte (D58: it moved here from
;;; CREDITS), every news post carries a title and a date, no page uses an
;;; em dash (content/anti-patterns), and the theme renders a page with the
;;; nav, the feed links and the licences line.

(import (sigil core)
        (sigil string)
        (sigil fs)
        (sigil io)
        (sigil list)
        (sigil test)
        (press core)
        (press scan)
        (press model)
        (sigil sxml)
        (crash-site theme))

(define (read-trimmed path)
  (let ((text (read-file-string path)))
    (string-trim text)))

;; Every post the site publishes. This read "content/devlog" literally
;; until 2026-09-25, which meant the checks below (the front-matter shape,
;; the em-dash ban, the spelling rule) were blind to every post written
;; after the rename, and one of those posts carries the summary line the
;; GAME draws in its HUD. A gate that cannot see the newest file is not
;; much of a gate. It reads the directory that exists now, and tolerates
;; it being absent so the suite says "no posts" rather than dying.
(define (posts-in dir)
  (if (file-exists? dir)
      (filter (lambda (p) (string-ends-with? p ".md"))
              (map (lambda (name) (string-append dir "/" name))
                   (directory-list dir)))
      '()))

(define (post-files)
  (posts-in "content/news"))

(test-group "site"
  (test "the About page carries the approved disclosure verbatim"
    (let ((disclosure (read-trimmed "../test/fixtures/disclosure.txt"))
          (about (read-file-string "content/about.md")))
      (assert-true (> (string-length disclosure) 100))
      (assert-true (string-contains? about disclosure))))
  (test "every news post has front matter with a title and an ISO date"
    (let ((posts (post-files)))
      (assert-true (pair? posts))
      (for-each (lambda (path)
                  (let ((text (read-file-string path)))
                    (assert-true (string-starts-with? text "---\ntitle: "))
                    (assert-true (string-contains? text "\ndate: 20"))))
                posts)))
  (test "no page or post uses an em dash"
    (for-each (lambda (path)
                (assert-false (string-contains? (read-file-string path) "—")))
              (cons "content/about.md" (post-files))))
  ;; American spelling in everything a reader sees (David, 2026-09-25, now in
  ;; the voice guide): color, license, center, behavior, gray. This sits beside
  ;; the em-dash ban because it is the same kind of rule, a house style that is
  ;; invisible to the writer and obvious to the reader.
  ;;
  ;; One named test per offence rather than one test that hides them all: a
  ;; failure has to say which file and which word, or someone has to go
  ;; hunting. A clean tree emits the single line below instead.
  ;;
  ;; Only the site's prose is checked. Code identifiers and comments are not
  ;; reader-facing, and one comment in cards/geometry.sgl quotes David saying
  ;; "just a grey line" -- a real person's words, which stay as spoken.
  (let* ((british (list "colour" "licence" "centre" "behaviour" "favourite"
                        "honour" "organis" "realis" "analys" "defence"
                        "offence" "catalogue" "programme" "travelling"))
         (found (apply append
                       (map (lambda (path)
                              (let ((text (string-downcase (read-file-string path))))
                                (map (lambda (w) (cons path w))
                                     (filter (lambda (w) (string-contains? text w)) british))))
                            (cons "content/about.md" (post-files))))))
    (if (null? found)
        (test "no page or post uses a British spelling" (assert-true #t))
        (for-each (lambda (o)
                    (test (string-append (car o) " uses the British \"" (cdr o) "\"")
                      (assert-true #f)))
                  found)))
  (test "the theme renders the nav, the feed links and the licences line around a body"
    (let* ((item #{source-path: "content/about.md" output-path: "/about/index.html" title: "About"
                   metadata: #{summary: "What it is"} format: 'markdown
                   body-loader: (lambda () (document metadata: #{} children: '((h1 "About") (p "body"))))})
           (page (crash-theme #{title: "Crash The Stack"} (initial-state) item '((h1 "About") (p "body"))))
           (html (sxml->html page)))
      (assert-true (string-contains? html "<title>About / Crash The Stack</title>"))
      (assert-true (string-contains? html "href=\"/jack-in/\""))
      (assert-true (string-contains? html "href=\"/news/feed.xml\""))
      (assert-true (string-contains? html "href=\"/news/feed.json\""))
      (assert-true (string-contains? html "GPL-3.0-or-later"))
      (assert-true (string-contains? html "<meta name=\"description\" content=\"What it is\""))
      ;; the body's own h1 is the title already: not repeated
      (assert-equal 2 (length (string-split html "<h1>")))))
  (test "the landing is a complete document with the redirect script and the newest post"
    (let* ((newest #{source-path: "content/news/x.md" output-path: "/news/x/index.html" title: "Newest"
                     metadata: #{date: "2026-09-22"} format: 'markdown})
           (html (sxml->html (landing-page newest))))
      (assert-true (string-starts-with? html "<html"))
      (assert-true (string-contains? html "location.replace('/jack-in/' + q + h)"))
      (assert-true (string-contains? html "display-mode: fullscreen"))
      (assert-true (string-contains? html "href=\"/news/x/\">Newest</a>")))))
