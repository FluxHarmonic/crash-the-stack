;;; test-site.sgl - The site's own checks: the disclosure paragraph on the
;;; About page is the approved text byte for byte (D58: it moved here from
;;; CREDITS), every news post carries a title and a date, no page uses an
;;; em dash (content/anti-patterns), and the theme renders a page with the
;;; nav, the feed links and the licences line.

(import (sigil core)
        (sigil string)
        (sigil fs)
        (sigil io)
        (sigil list)
        (sigil test)
        (press core)
        (press scan)
        (press model)
        (sigil sxml)
        (crash-site theme))

(define (read-trimmed path)
  (let ((text (read-file-string path)))
    (string-trim text)))

;; Every post the site publishes. This read "content/devlog" literally
;; until 2026-09-25, which meant the checks below (the front-matter shape,
;; the em-dash ban, the spelling rule) were blind to every post written
;; after the rename, and one of those posts carries the summary line the
;; GAME draws in its HUD. A gate that cannot see the newest file is not
;; much of a gate. It reads the directory that exists now, and tolerates
;; it being absent so the suite says "no posts" rather than dying.
(define (posts-in dir)
  (if (file-exists? dir)
      (filter (lambda (p) (string-ends-with? p ".md"))
              (map (lambda (name) (string-append dir "/" name))
                   (directory-list dir)))
      '()))

(define (post-files)
  (posts-in "content/news"))

(test-group "site"
  (test "the About page carries the approved disclosure verbatim"
    (let ((disclosure (read-trimmed "../test/fixtures/disclosure.txt"))
          (about (read-file-string "content/about.md")))
      (assert-true (> (string-length disclosure) 100))
      (assert-true (string-contains? about disclosure))))
  (test "every news post has front matter with a title and an ISO date"
    (let ((posts (post-files)))
      (assert-true (pair? posts))
      (for-each (lambda (path)
                  (let ((text (read-file-string path)))
                    (assert-true (string-starts-with? text "---\ntitle: "))
                    (assert-true (string-contains? text "\ndate: 20"))))
                posts)))
  (test "no page or post uses an em dash"
    (for-each (lambda (path)
                (assert-false (string-contains? (read-file-string path) "—")))
              (cons "content/about.md" (post-files))))
  ;; American spelling in everything a reader sees (David, 2026-09-25, now in
  ;; the voice guide): color, license, center, behavior, gray. This sits beside
  ;; the em-dash ban because it is the same kind of rule, a house style that is
  ;; invisible to the writer and obvious to the reader.
  ;;
  ;; One named test per offence rather than one test that hides them all: a
  ;; failure has to say which file and which word, or someone has to go
  ;; hunting. A clean tree emits the single line below instead.
  ;;
  ;; Only the site's prose is checked. Code identifiers and comments are not
  ;; reader-facing, and one comment in cards/geometry.sgl quotes David saying
  ;; "just a grey line" -- a real person's words, which stay as spoken.
  (let* ((british (list "colour" "licence" "centre" "behaviour" "favourite"
                        "honour" "organis" "realis" "analys" "defence"
                        "offence" "catalogue" "programme" "travelling"))
         (found (apply append
                       (map (lambda (path)
                              (let ((text (string-downcase (read-file-string path))))
                                (map (lambda (w) (cons path w))
                                     (filter (lambda (w) (string-contains? text w)) british))))
                            (cons "content/about.md" (post-files))))))
    (if (null? found)
        (test "no page or post uses a British spelling" (assert-true #t))
        (for-each (lambda (o)
                    (test (string-append (car o) " uses the British \"" (cdr o) "\"")
                      (assert-true #f)))
                  found)))
  (test "the theme renders the nav, the feed links and the licences line around a body"
    (let* ((item #{source-path: "content/about.md" output-path: "/about/index.html" title: "About"
                   metadata: #{summary: "What it is"} format: 'markdown
                   body-loader: (lambda () (document metadata: #{} children: '((h1 "About") (p "body"))))})
           (page (crash-theme #{title: "Crash The Stack"} (initial-state) item '((h1 "About") (p "body"))))
           (html (sxml->html page)))
      (assert-true (string-contains? html "<title>About / Crash The Stack</title>"))
      (assert-true (string-contains? html "href=\"/jack-in/\""))
      (assert-true (string-contains? html "href=\"/news/feed.xml\""))
      (assert-true (string-contains? html "href=\"/news/feed.json\""))
      (assert-true (string-contains? html "GPL-3.0-or-later"))
      (assert-true (string-contains? html "<meta name=\"description\" content=\"What it is\""))
      ;; the body's own h1 is the title already: not repeated
      (assert-equal 2 (length (string-split html "<h1>")))))
  (test "the landing is a complete document with the redirect script and the newest post"
    (let* ((newest #{source-path: "content/news/x.md" output-path: "/news/x/index.html" title: "Newest"
                     metadata: #{date: "2026-09-22"} format: 'markdown})
           (html (sxml->html (landing-page newest))))
      (assert-true (string-starts-with? html "<html"))
      (assert-true (string-contains? html "location.replace('/jack-in/' + q + h)"))
      (assert-true (string-contains? html "display-mode: fullscreen"))
      (assert-true (string-contains? html "href=\"/news/x/\">Newest</a>"))))
  ;; Plausible Analytics (2026-09-30): each kind of document (a themed page,
  ;; the landing, the 404) carries the tag once, in its head, with this
  ;; site's script ID, and the footer's privacy line
  (test "every kind of page carries the Plausible tag once, in its head, and the privacy line"
    (let* ((item #{source-path: "content/about.md" output-path: "/about/index.html" title: "About"
                   metadata: #{} format: 'markdown
                   body-loader: (lambda () (document metadata: #{} children: '((p "body"))))})
           (pages (list (sxml->html (crash-theme #{title: "Crash The Stack"} (initial-state) item '((p "body"))))
                        (sxml->html (landing-page #f))
                        (sxml->html (not-found-page)))))
      (for-each (lambda (html)
                  (assert-equal 2 (length (string-split html "https://plausible.io/js/pa-5iTMFNFjYxMn3THin-cwJ.js")))
                  (assert-equal 2 (length (string-split html "plausible.init()")))
                  (assert-true (string-contains? (car (string-split html "</head>")) "plausible.init()"))
                  (assert-true (string-contains? html "Privacy-friendly analytics by <a href=\"https://plausible.io/data-policy\">Plausible</a>: no cookies, no personal data.")))
                pages))))

;; The landing's screenshots (2026-10-12): one shot per game, six, each a file in
;; assets/shots/ with real alt text and a caption, the first shown and the
;; rest hidden from assistive tech until the rotation shows them; a dot
;; for each; the rotation's script after the footer.
(test-group "landing screenshots"
  (let* ((html (sxml->html (landing-page #f)))
         (frames (car (string-split (cadr (string-split html "<div class=\"frames\">")) "</div>")))
         (imgs (cdr (string-split frames "<img "))))
    (test "six shots, one per game, each a file in assets/shots/"
      (assert-equal 6 (length imgs))
      (for-each (lambda (img)
                  (let ((src (car (string-split (cadr (string-split img "src=\"/shots/")) "\""))))
                    (assert-true (file-exists? (string-append "assets/shots/" src)))))
                imgs))
    (test "every shot has 640x400, a caption and alt text of a sentence or more"
      (for-each (lambda (img)
                  (assert-true (string-contains? img "width=\"640\" height=\"400\""))
                  (assert-true (string-contains? img "data-caption=\""))
                  (let ((alt (car (string-split (cadr (string-split img "alt=\"")) "\""))))
                    (assert-true (> (string-length alt) 80))))
                imgs))
    (test "the first is shown, the other five are hidden until shown"
      (assert-true (string-starts-with? (car imgs) "class=\"shot shown\""))
      (assert-false (string-contains? (car imgs) "aria-hidden"))
      (for-each (lambda (img)
                  (assert-true (string-starts-with? img "class=\"shot\""))
                  (assert-true (string-contains? img "aria-hidden=\"true\"")))
                (cdr imgs)))
    ;; David, 2026-10-12: the logo, the short description, the screenshots,
    ;; then the button, as harkfell.com has them
    (test "the shots sit between the description and the JACK IN button"
      (let ((before-shots (car (string-split html "<section class=\"shots\"")))
            (after-shots (cadr (string-split html "<section class=\"shots\""))))
        (assert-true (string-contains? before-shots "<p class=\"tag\">"))
        (assert-false (string-contains? before-shots "class=\"cta\""))
        (assert-true (string-contains? after-shots "class=\"cta\">JACK IN</a>"))))
    (test "a dot per shot, the first current, and the script after the footer"
      (assert-equal 7 (length (string-split html "<button type=\"button\"")))
      (assert-equal 2 (length (string-split html "aria-current=\"true\"")))
      (assert-true (string-contains? (cadr (string-split html "</footer>")) "querySelector('.shots')")))))

;; The Flux Harmonic mark (2026-10-12): every kind of page's footer opens
;; with it, linking the studio, as harkfell.com's and phantomburn.net's do;
;; the album's hand-written page carries the same footer.
(test-group "footer mark"
  (test "the mark is in assets/ and every kind of page's footer links it to the studio"
    (assert-true (file-exists? "assets/mark.png"))
    (let* ((item #{source-path: "content/about.md" output-path: "/about/index.html" title: "About"
                   metadata: #{} format: 'markdown
                   body-loader: (lambda () (document metadata: #{} children: '((p "body"))))})
           (pages (list (sxml->html (crash-theme #{title: "Crash The Stack"} (initial-state) item '((p "body"))))
                        (sxml->html (landing-page #f))
                        (sxml->html (not-found-page))
                        (read-file-string "../docs/music/album/listen/index.html"))))
      (for-each (lambda (html)
                  (let ((foot (cadr (string-split html "<footer class=\"foot\">"))))
                    (assert-true (string-contains? foot "<a class=\"mark\" href=\"https://fluxharmonic.com/\"><img src=\"/mark.png\" width=\"380\" height=\"188\" loading=\"lazy\" alt=\"Flux Harmonic\"></a>"))
                    (assert-true (string-contains? foot "the Flux Harmonic mark are reserved."))
                    (assert-true (string-contains? foot "<p>Also from Flux Harmonic: <a href=\"https://harkfell.com/\">Harkfell</a> and <a href=\"https://phantomburn.net/\">Phantom Burn</a></p>"))))
                pages))))

;; The site's copy (David, 2026-10-12): his tagline, one string, in the
;; landing's hero and at the start of every description; and no game names
;; and no count of games anywhere outside the screenshots' own labels, since
;; both change over time.
(test-group "copy"
  (let* ((tag "Cyberpunk takes on classic casual games, linked by a network you can hack.")
         (landing (sxml->html (landing-page #f)))
         (item #{source-path: "content/x.md" output-path: "/x/index.html" title: "X"
                 metadata: #{} format: 'markdown
                 body-loader: (lambda () (document metadata: #{} children: '((p "body"))))})
         (page (sxml->html (crash-theme #{title: "Crash The Stack"} (initial-state) item '((p "body")))))
         (outside-shots (string-append (car (string-split landing "<section class=\"shots\""))
                                       (apply string-append (cdr (string-split landing "</section>"))))))
    (test "the tagline is the hero's line and starts the landing's and a page's descriptions"
      (assert-true (string-contains? landing (string-append "<p class=\"tag\">" tag "</p>")))
      (for-each (lambda (html)
                  (for-each (lambda (meta)
                              (assert-true (string-contains? html (string-append meta " content=\"" tag))))
                            '("<meta name=\"description\"" "<meta property=\"og:description\"" "<meta name=\"twitter:description\"")))
                (list landing page)))
    (test "no game names or counts in the landing's copy or a page's default description"
      (for-each (lambda (html)
                  (for-each (lambda (word) (assert-false (string-contains? html word)))
                            '("STACK" "DEFRAG" "SCAN" "INTERCEPT" "DECRYPT" "Mahjongg" "Klondike" "Minesweeper"
                              "two games" "three games" "four games" "five games" "six games")))
                ;; "Crash The Stack" is the name: its "Stack" is not STACK
                (list outside-shots page)))))
