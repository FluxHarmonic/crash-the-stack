#!/bin/sh
# Put the two wasm files where the deploy expects them, and point the pages at
# them by content hash (P4b + P5, 2026-09-23).
#
#   scripts/wasm-to-r2 DIR            --local: copy into DIR (the default)
#   scripts/wasm-to-r2 DIR --local
#   scripts/wasm-to-r2 DIR --upload   send to R2 and leave no wasm in DIR
#   scripts/wasm-to-r2 DIR --upload --dry-run
#                                     everything but the upload; with the
#                                     credentials set, a read-only HEAD of
#                                     each key shows the token reaches the
#                                     bucket (a refusal fails the run)
#
# --upload goes through R2's S3 API (scripts/r2-s3) with CLOUDFLARE_API_TOKEN
# and CLOUDFLARE_ACCOUNT_ID (eval "$(~/Ops/scripts/cf-env crash)"). The token
# holds Bucket Item Read/Write on Crash's buckets only; wrangler's `r2 object`
# REST path refuses such a token, so nothing here uses it. Each key is read
# first: present means compared byte for byte against the file (and refused if
# different, never overwritten); absent means put, read back and compared; a
# refused or failed read stops the run. Nothing is ever deleted.
#
# CRASH_WEB_DIR=build/remote-web-<sha> scripts/wasm-to-r2 DIR --upload
#     read the wasm from that built tree instead of build/web: publish exactly
#     the tree the gate ran
#
# Cloudflare Pages refuses a file over 25 MiB. The game's wasm is 41,921,264
# bytes on master (sigil 0.22.5), so `wrangler pages deploy` will not take the
# tree at all; the tracker's 16,698,428 still fits but sits at 67% of the cap.
# Both therefore live in an R2 bucket and are served by a Pages Function at the
# SAME ORIGIN (functions/jack-in/w, functions/tracker/w; the reason for
# same-origin is in web/r2-wasm.js: the page is cross-origin isolated and an
# r2.dev URL would break the AudioWorklet path).
#
# The paths carry the hash of the bytes:
#   /jack-in/w/<sha256[0:16]>/crash-the-stack.wasm
#   /tracker/w/<sha256[0:16]>/crash-tracker.wasm
# so a page can only ever fetch the wasm it was built against, and every object
# is immutable.
#
# TWO MODES, ONE SET OF PATHS. Nothing local runs a Pages Function: host-site
# serves the staged tree with `sigil serve --dir` and verify-site.mjs with its
# own Node server. So --local copies the files into the tree at exactly the
# paths production serves, and --upload sends them to R2 and then refuses if
# any .wasm is left in the tree. The page is byte-identical either way: the
# local tree proves the rewrite, the upload proves the bucket.
#
# It rewrites three things in DIR, which is why it must run AFTER the tree is
# otherwise staged:
#   jack-in/index.html   data-wasm="crash-the-stack" -> the hashed path
#   jack-in/sw.js        the "crash-the-stack.wasm" precache entry -> the same
#   tracker/index.html   data-wasm="crash-tracker"   -> the hashed path
# The loader needs no change: sigil-web-app.js fetches assetUrl(data-wasm +
# ".wasm") and data-wasm takes a path.
set -eu
cd "$(dirname "$0")/.." || exit 1

DIR=""; MODE=local; DRY=0
for a in "$@"; do
  case "$a" in
    --local) MODE=local ;;
    --upload) MODE=upload ;;
    --dry-run) DRY=1 ;;
    -*) echo "wasm-to-r2: unknown flag $a"; exit 2 ;;
    *) [ -z "$DIR" ] || { echo "wasm-to-r2: one directory, not two"; exit 2; }; DIR="$a" ;;
  esac
done
[ -n "$DIR" ] || { echo "wasm-to-r2: give the staged directory"; exit 2; }
[ -d "$DIR" ] || { echo "wasm-to-r2: $DIR is not a directory"; exit 2; }

BUCKET="${CRASH_WASM_BUCKET:-crashthestack-wasm}"
# CRASH_WEB_DIR names the built tree to read the wasm from, so a publish can
# ship EXACTLY THE TREE THE GATE RAN: build-remote fetches its result to
# build/remote-web-<sha>, and publishing from there rather than from build/web
# means a fresh checkout's output goes out, with no stale directory to survive
# in. (build/web is never cleaned between builds: M1's retired OGGs sat in two
# workers' copies for days, 3.1 MB nobody would have fetched, and only a
# refusal in stage-web caught them. A runner-built tree cannot have that class
# of fault at all.) stage-web and publish-web take the same variable.
WEB="${CRASH_WEB_DIR:-build/web}"
[ -d "$WEB" ] || { echo "wasm-to-r2: $WEB is not a directory (CRASH_WEB_DIR)"; exit 1; }
GAME="$WEB/crash-the-stack.wasm"
TRACKER="$WEB/tracker/crash-tracker.wasm"
for f in "$GAME" "$TRACKER"; do
  [ -f "$f" ] || { echo "wasm-to-r2: $f missing; build --config web first"; exit 1; }
done
for f in "$DIR/jack-in/index.html" "$DIR/jack-in/sw.js" "$DIR/tracker/index.html"; do
  [ -f "$f" ] || { echo "wasm-to-r2: $f missing; stage the tree before this runs (it rewrites the pages)"; exit 1; }
done

hash16() { sha256sum "$1" | cut -c1-16; }
GSHA="$(hash16 "$GAME")"
TSHA="$(hash16 "$TRACKER")"
GKEY="jack-in/w/$GSHA/crash-the-stack.wasm"
TKEY="tracker/w/$TSHA/crash-tracker.wasm"

# The rewrites, the same in both modes. A page that still says the bare name
# after this is a page that will 404, so each one is checked rather than hoped.
rewrite() {   # file, what to find, what to put there
  if ! grep -q "$2" "$1"; then
    if grep -q 'w/[0-9a-f]\{16\}/crash-' "$1"; then
      echo "wasm-to-r2: $1 is already rewritten; this runs once on a freshly staged tree (stage it again)"
    else
      echo "wasm-to-r2: $1 does not contain $2; the page or the worker changed shape"
    fi
    exit 1
  fi
  sed -i "s|$2|$3|g" "$1"
  grep -q "$3" "$1" || { echo "wasm-to-r2: rewrote $1 but $3 is not in it"; exit 1; }
}
rewrite "$DIR/jack-in/index.html" 'data-wasm="crash-the-stack"' "data-wasm=\"w/$GSHA/crash-the-stack\""
rewrite "$DIR/jack-in/sw.js" '"crash-the-stack.wasm"' "\"w/$GSHA/crash-the-stack.wasm\""
rewrite "$DIR/tracker/index.html" 'data-wasm="crash-tracker"' "data-wasm=\"w/$TSHA/crash-tracker\""

if [ "$MODE" = local ]; then
  mkdir -p "$DIR/jack-in/w/$GSHA" "$DIR/tracker/w/$TSHA"
  cp "$GAME" "$DIR/jack-in/w/$GSHA/crash-the-stack.wasm"
  cp "$TRACKER" "$DIR/tracker/w/$TSHA/crash-tracker.wasm"
  # exactly the two, and nothing else: a third wasm in the tree means something
  # is staging a file this script does not know about
  LEFT="$(find "$DIR" -name '*.wasm' | sort)"
  WANT="$(printf '%s\n%s\n' "$DIR/tracker/w/$TSHA/crash-tracker.wasm" "$DIR/jack-in/w/$GSHA/crash-the-stack.wasm" | sort)"
  [ "$LEFT" = "$WANT" ] || { echo "wasm-to-r2: the staged tree's wasm files are not the two expected:"; echo "$LEFT" | sed 's/^/  /'; exit 1; }
  echo "wasm-to-r2: local. /jack-in/w/$GSHA/crash-the-stack.wasm ($(stat -c%s "$GAME") bytes), /tracker/w/$TSHA/crash-tracker.wasm ($(stat -c%s "$TRACKER") bytes)"
  exit 0
fi

# --upload from here: the tree must carry no wasm at all, because that is what
# the 25 MiB cap refuses.
LEFT="$(find "$DIR" -name '*.wasm' | sort)"
[ -z "$LEFT" ] || { echo "wasm-to-r2: .wasm files left in the tree; Pages caps a file at 25 MiB and will refuse the deploy:"; echo "$LEFT" | sed 's/^/  /'; exit 1; }

R2W="$(mktemp -d "${TMPDIR:-/tmp}/wasm-to-r2-XXXXXX")"
trap 'rm -rf "$R2W"' EXIT
HAVE_CREDS=0; [ -n "${CLOUDFLARE_API_TOKEN:-}" ] && [ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ] && HAVE_CREDS=1
put() {   # local file, bucket key
  if [ "$DRY" = 1 ]; then
    if [ "$HAVE_CREDS" = 1 ]; then
      set +e; scripts/r2-s3 head "$BUCKET" "$2" 2> "$R2W/log"; hrc=$?; set -e
      case "$hrc" in
        0) echo "wasm-to-r2: R2 read-only check: $2 is already in $BUCKET (the token reads the bucket)" ;;
        3) echo "wasm-to-r2: R2 read-only check: $2 is absent from $BUCKET (the token reads the bucket)" ;;
        *) cat "$R2W/log"; echo "wasm-to-r2: REFUSED: the token cannot read $BUCKET (r2-s3 rc $hrc); a publish would fail"; exit 1 ;;
      esac
    else
      echo "wasm-to-r2: CLOUDFLARE_API_TOKEN/CLOUDFLARE_ACCOUNT_ID not set, so R2 was not checked"
    fi
    echo "wasm-to-r2: would put $2 ($(stat -c%s "$1") bytes) in $BUCKET (scripts/r2-s3), read it back and compare"
    return 0
  fi
  # r2-s3 exits 3 only for an absent key: a refused or failed read is never
  # taken as "absent, put it". Content-addressed keys, but a key that is
  # already there is still compared, not trusted.
  rm -f "$R2W/back"
  set +e; scripts/r2-s3 get "$BUCKET" "$2" "$R2W/back" 2> "$R2W/log"; grc=$?; set -e
  case "$grc" in
    0) cmp -s "$1" "$R2W/back" || { echo "wasm-to-r2: REFUSED: $BUCKET/$2 holds other bytes than $1; not overwritten"; exit 1; }
       echo "wasm-to-r2: $2 is already in $BUCKET (read back, identical)"; return 0 ;;
    3) ;;
    *) cat "$R2W/log"; echo "wasm-to-r2: REFUSED: could not read $BUCKET/$2 (r2-s3 rc $grc: refused or failed, not absent)"; exit 1 ;;
  esac
  scripts/r2-s3 put "$BUCKET" "$2" "$1" application/wasm 2> "$R2W/log" || { cat "$R2W/log"; echo "wasm-to-r2: the R2 upload of $2 failed"; exit 1; }
  scripts/r2-s3 get "$BUCKET" "$2" "$R2W/back" 2> "$R2W/log" || { cat "$R2W/log"; echo "wasm-to-r2: the R2 read-back of $2 failed"; exit 1; }
  cmp -s "$1" "$R2W/back" || { echo "wasm-to-r2: REFUSED: the read-back of $BUCKET/$2 is not $1"; exit 1; }
  echo "wasm-to-r2: put $2 ($(stat -c%s "$1") bytes; read back, identical)"
}
[ "$DRY" = 1 ] || [ "$HAVE_CREDS" = 1 ] || { echo "wasm-to-r2: CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID must be set (eval \"\$(~/Ops/scripts/cf-env crash)\")"; exit 1; }
put "$GAME" "$GKEY"
put "$TRACKER" "$TKEY"
echo "wasm-to-r2: upload. /jack-in/w/$GSHA/crash-the-stack.wasm, /tracker/w/$TSHA/crash-tracker.wasm, bucket $BUCKET"
