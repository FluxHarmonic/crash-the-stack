#!/bin/sh
# Host build/web for play over the VPN.
#
#   scripts/serve-web            start in the background, PID in build/web-serve-8770.pid
#   scripts/serve-web --stop     stop the server started by this script, by that PID
#
# Binds to the box's WireGuard address only (decision D10: this machine is
# also on the home LAN, and `sigil serve` defaults to 0.0.0.0, which would
# expose the dev build there). The address is read from wg0 at run time,
# never hardcoded; an empty or wildcard address is a refusal, not a
# fallback. scripts/check-bind confirms what actually got bound.
set -eu
cd "$(dirname "$0")/.." || exit 1

PORT="${PORT:-8770}"
DIR="${DIR:-build/web}"
PIDFILE="build/web-serve-$PORT.pid"
LOGFILE="build/web-serve-$PORT.log"

if [ "${1:-}" = "--stop" ]; then
  [ -f "$PIDFILE" ] || { echo "serve-web: no $PIDFILE"; exit 1; }
  pid="$(cat "$PIDFILE")"
  # Only ever kill the process we started: it must still be a sigil binary
  # whose cwd is this repo.
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
  case "$exe" in *sigil*) ;; *) echo "serve-web: pid $pid is not sigil ($exe); not killing"; exit 1 ;; esac
  [ "$cwd" = "$(pwd)" ] || { echo "serve-web: pid $pid cwd is $cwd, not $(pwd); not killing"; exit 1; }
  kill "$pid" && rm -f "$PIDFILE" && echo "serve-web: stopped $pid"
  exit 0
fi

HOST="$(ip -4 -o addr show wg0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
case "$HOST" in
  ""|0.0.0.0|"*") echo "serve-web: refusing to bind to '${HOST:-<empty>}' (wg0 has no IPv4 address?)"; exit 1 ;;
esac
[ -f "$DIR/index.html" ] || { echo "serve-web: $DIR/index.html missing; build --config web first"; exit 1; }

sigil serve --dir "$DIR" --host "$HOST" --port "$PORT" > "$LOGFILE" 2>&1 &
echo $! > "$PIDFILE"
echo "serve-web: pid $(cat "$PIDFILE") on http://$HOST:$PORT/ (log $LOGFILE)"
