#!/bin/sh
# The tool icons from their text: the data module the game draws from and
# the PNG the manifest and David see.
#
#   scripts/art/icons             assets/src/glyphs/tools.txt
#                                 -> src/crash/glyphs/tools.sgl, assets/glyphs/tools.png
#
# The text holds any number of named 12x12 icons (see its header); the
# game draws them with the font's draw-rows, like the class marks. The PNG
# is the icons at scale 2 with a 2 px gap in C-TEXT on C-BG: 2 palette
# colors, checked here against assets/palette.sgl.
set -eu
# An absent ImageMagick is SETUP-FAILED, never a result: without it each art
# test failed on the azoth runners with "cannot open ...png" (t-b7ac83).
command -v convert >/dev/null 2>&1 || { echo "SETUP-FAILED: ImageMagick's convert is not on PATH (manifest.scm has imagemagick; run through scripts/dev)" >&2; exit 125; }
export LC_ALL=C
cd "$(dirname "$0")/../.." || exit 1
src="assets/src/glyphs/tools.txt"
[ -f "$src" ] || { echo "icons: no $src"; exit 1; }
mod="src/crash/glyphs/tools.sgl"
png="assets/glyphs/tools.png"
mkdir -p src/crash/glyphs assets/glyphs
# 1. parse: names and rows, refusing anything off the 12x12 grid
awk '
  /^[#.][#.][#.][#.][#.][#.][#.][#.][#.][#.][#.][#.]$/ { if (n == 0) { print "icons: rows before the first = NAME" > "/dev/stderr"; exit 1 }
                rows[n]++; g[n, rows[n]] = $0; next }
  /^#/ { next }
  /^= [a-z][a-z0-9-]*$/ { n++; name[n] = substr($0, 3); rows[n] = 0; next }
  /^= / { print "icons: bad name at line " NR " (kebab-case only): " $0 > "/dev/stderr"; exit 1 }
  /^[ \t]*$/ { next }
  { print "icons: bad line " NR ": " $0 > "/dev/stderr"; exit 1 }
  END {
    if (n < 1) { print "icons: no icons" > "/dev/stderr"; exit 1 }
    for (i = 1; i <= n; i++) if (rows[i] != 12) { print "icons: " name[i] " has " rows[i] " rows" > "/dev/stderr"; exit 1 }
    for (i = 1; i <= n; i++) { printf "%s", name[i]; for (r = 1; r <= 12; r++) printf " %s", g[i, r]; printf "\n" }
  }' "$src" > "$mod.rows"
count="$(wc -l < "$mod.rows" | tr -d ' ')"
# 2. the data module: an alist by name, built with list (the web build's
#    literal hazard: see (crash menu))
{
  echo ";;; (crash glyphs tools) - the tool icons, GENERATED by scripts/art/icons"
  echo ";;; from $src; edit the text, not this file. Each icon is twelve"
  echo ";;; rows of twelve cells, # lit (the font's draw-rows format), by name."
  echo ""
  echo "(define-library (crash glyphs tools)"
  echo "  (export ICONS ICON-W ICON-H)"
  echo ""
  echo "  (begin"
  echo "    (define ICON-W 12)"
  echo "    (define ICON-H 12)"
  echo ""
  echo "    (define ICONS"
  printf "      (list"
  awk '{ printf "%s(list (quote %s)", (NR > 1 ? "\n            " : " "), $1; for (r = 2; r <= 13; r++) printf " \"%s\"", $r; printf ")" }' "$mod.rows"
  echo "))))"
} > "$mod"
# 3. the PNG
hex_of() { awk -v role="$1" '$0 ~ "^ *\\(?\\(" role " " { l = $0; sub(/^[^"]*"/, "", l); sub(/".*/, "", l); print l; exit }' assets/palette.sgl; }
BG="$(hex_of C-BG)"; INK="$(hex_of C-TEXT)"
awk -v bg="$BG" -v ink="$INK" -v n="$count" '
  function hex2(h, i) { return (index("0123456789ABCDEF", substr(h, i, 1)) - 1) * 16 + index("0123456789ABCDEF", substr(h, i + 1, 1)) - 1 }
  function rgb(h) { return sprintf("%c%c%c", hex2(h, 2), hex2(h, 4), hex2(h, 6)) }
  BEGIN { SCALE = 2; GAP = 2; CW = 12 * SCALE; CH = 12 * SCALE; W = n * CW + (n + 1) * GAP; H = CH + 2 * GAP }
  { for (r = 2; r <= 13; r++) row[NR - 1, r - 2] = $r }
  END {
    printf "P6\n%d %d\n255\n", W, H
    for (y = 0; y < H; y++) {
      for (x = 0; x < W; x++) {
        c = bg
        i = int((x - GAP) / (CW + GAP)); cx = (x - GAP) - i * (CW + GAP)
        if (x >= GAP && i < n && cx < CW && y >= GAP && y < GAP + CH) {
          col = int(cx / SCALE); rr = int((y - GAP) / SCALE)
          if (substr(row[i, rr], col + 1, 1) == "#") c = ink
        }
        printf "%s", rgb(c)
      }
    }
  }' "$mod.rows" > "$mod.ppm"
convert "$mod.ppm" -type TrueColor +set date:create +set date:modify +set date:timestamp -define png:exclude-chunks=date,time,tIME,tEXt,zTXt "PNG24:$png"
rm -f "$mod.ppm" "$mod.rows"
echo "icons: $count icons, $mod, $png $(identify -format '%wx%h %k colors' "$png")"
