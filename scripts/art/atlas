#!/bin/sh
# Pack frames into one strip and write its coordinate table.
#
#   scripts/art/atlas OUT.png TABLE.txt [--key ROLE] [--mask ROLE] NAME=FRAME.png [NAME=FRAME.png ...]
#
# Frames go left to right, each at its own size, top-aligned; the table
# has one line per frame: NAME X Y W H. The game reads the table's
# numbers as constants (a data module or a literal), the manifest gets one
# row for the PNG and one for the table. --key ROLE makes that palette
# color transparent in the strip; --mask ROLE turns that color pure white
# (a C-DAEMON-on-C-BG portrait becomes a white tint mask on nothing, so
# the game's class color multiplies it exactly rather than by 0.94).
set -eu
# An absent ImageMagick is SETUP-FAILED, never a result: without it each art
# test failed on the azoth runners with "cannot open ...png" (t-b7ac83).
command -v convert >/dev/null 2>&1 || { echo "SETUP-FAILED: ImageMagick's convert is not on PATH (manifest.scm has imagemagick; run through scripts/dev)" >&2; exit 125; }
cd "$(dirname "$0")/../.." || exit 1
out="${1:?out.png}"; table="${2:?table.txt}"; shift 2
hex_of() { awk -v role="$1" '$0 ~ "^ *\\(?\\(" role " " { l = $0; sub(/^[^"]*"/, "", l); sub(/".*/, "", l); print l; exit }' assets/palette.sgl; }
key=""; mask=""
while [ $# -gt 0 ]; do
  case "$1" in
    --key) key="$(hex_of "${2:?role}")"; [ -n "$key" ] || { echo "atlas: unknown --key role $2"; exit 1; }; shift 2 ;;
    --mask) mask="$(hex_of "${2:?role}")"; [ -n "$mask" ] || { echo "atlas: unknown --mask role $2"; exit 1; }; shift 2 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "atlas: no frames"; exit 1; }
x=0
frames=""
: > "$table.tmp"
for spec in "$@"; do
  name="${spec%%=*}"; frame="${spec#*=}"
  [ -f "$frame" ] || { echo "atlas: no $frame"; exit 1; }
  w="$(identify -format '%w' "$frame")"; h="$(identify -format '%h' "$frame")"
  printf '%s %d %d %d %d\n' "$name" "$x" 0 "$w" "$h" >> "$table.tmp"
  frames="$frames $frame"
  x=$((x + w))
done
# shellcheck disable=SC2086
convert $frames -background none -gravity NorthWest +append +repage ${key:+-transparent "$key"} ${mask:+-fill white -opaque "$mask"} +set date:create +set date:modify +set date:timestamp -define png:exclude-chunks=date,time,tIME,tEXt,zTXt "PNG32:$out"
mv "$table.tmp" "$table"
echo "atlas: $out $(identify -format '%wx%h' "$out"), $(wc -l < "$table") frames in $table"
