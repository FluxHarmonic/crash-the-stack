#!/bin/sh
# Pack frames into one strip and write its coordinate table.
#
#   scripts/art/atlas OUT.png TABLE.txt NAME=FRAME.png [NAME=FRAME.png ...]
#
# Frames go left to right, each at its own size, top-aligned; the table
# has one line per frame: NAME X Y W H. The game reads the table's
# numbers as constants (a data module or a literal), the manifest gets one
# row for the PNG and one for the table.
set -eu
cd "$(dirname "$0")/../.." || exit 1
out="${1:?out.png}"; table="${2:?table.txt}"; shift 2
[ $# -gt 0 ] || { echo "atlas: no frames"; exit 1; }
x=0
frames=""
: > "$table.tmp"
for spec in "$@"; do
  name="${spec%%=*}"; frame="${spec#*=}"
  [ -f "$frame" ] || { echo "atlas: no $frame"; exit 1; }
  w="$(identify -format '%w' "$frame")"; h="$(identify -format '%h' "$frame")"
  printf '%s %d %d %d %d\n' "$name" "$x" 0 "$w" "$h" >> "$table.tmp"
  frames="$frames $frame"
  x=$((x + w))
done
# shellcheck disable=SC2086
convert $frames -background none -gravity NorthWest +append +set date:create +set date:modify +set date:timestamp -define png:exclude-chunks=date,time,tIME,tEXt,zTXt "PNG32:$out"
mv "$table.tmp" "$table"
echo "atlas: $out $(identify -format '%wx%h' "$out"), $(wc -l < "$table") frames in $table"
