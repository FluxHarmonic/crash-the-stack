#!/bin/sh
# A glyph sheet from its text: the data module the game draws from and
# the PNG the manifest and the color gate cover.
#
#   scripts/art/glyphs SHEET      assets/src/glyphs/SHEET.txt
#                                 -> src/crash/glyphs/SHEET.sgl, assets/glyphs/SHEET.png
#
# The text holds 36 glyphs of 5x7 in face order (see the header of any
# sheet); a generated candidate is shaped into the same text by
# scripts/art/cells, so every sheet enters the game through this one
# door and is drawn by the same code. The PNG is the 36 cells at scale 2
# with a 2 px gap, each in its suit color (the daemons in C-DAEMON) on
# C-BG: 6 palette colors, checked here against assets/palette.sgl.
set -eu
cd "$(dirname "$0")/../.." || exit 1
sheet="${1:?sheet}"
src="assets/src/glyphs/$sheet.txt"
[ -f "$src" ] || { echo "glyphs: no $src"; exit 1; }
mod="src/crash/glyphs/$sheet.sgl"
png="assets/glyphs/$sheet.png"
mkdir -p src/crash/glyphs assets/glyphs
SHEET="$(echo "$sheet" | tr 'a-z' 'A-Z')"
# 1. parse: names and rows, refusing anything off the 5x7 grid
awk -v sheet="$sheet" '
  # a glyph row is exactly five cells; anything else starting with # is a comment
  /^[#.][#.][#.][#.][#.]$/ { if (n == 0) { print "glyphs: rows before the first = NAME" > "/dev/stderr"; exit 1 }
                rows[n]++; g[n, rows[n]] = $0; next }
  /^#/ { next }
  /^= / { n++; name[n] = substr($0, 3); rows[n] = 0; next }
  /^[ \t]*$/ { next }
  { print "glyphs: bad line " NR ": " $0 > "/dev/stderr"; exit 1 }
  END {
    if (n != 36) { print "glyphs: " n " glyphs, want 36" > "/dev/stderr"; exit 1 }
    for (i = 1; i <= n; i++) if (rows[i] != 7) { print "glyphs: " name[i] " has " rows[i] " rows" > "/dev/stderr"; exit 1 }
    for (i = 1; i <= n; i++) { printf "%s", name[i]; for (r = 1; r <= 7; r++) printf " %s", g[i, r]; printf "\n" }
  }' "$src" > "$mod.rows"
# 2. the data module
{
  echo ";;; (crash glyphs $sheet) - glyph sheet $SHEET, GENERATED by scripts/art/glyphs"
  echo ";;; from $src; edit the text, not this file. 36 faces in"
  echo ";;; face order, each seven rows of five cells, # lit (the font's format)."
  echo ""
  echo "(define-library (crash glyphs $sheet)"
  echo "  (export SHEET-$SHEET SHEET-$SHEET-NAMES)"
  echo ""
  echo "  (begin"
  printf "    (define SHEET-$SHEET-NAMES\n      '#("
  awk '{ printf "%s\"%s\"", (NR > 1 ? "\n         " : ""), $1 }' "$mod.rows"
  echo "))"
  echo ""
  printf "    (define SHEET-$SHEET\n      '#("
  awk '{ printf "%s(", (NR > 1 ? "\n         " : ""); for (r = 2; r <= 8; r++) printf "%s\"%s\"", (r > 2 ? " " : ""), $r; printf ")" }' "$mod.rows"
  echo "))))"
} > "$mod"
# 3. the PNG: cells at scale 2, gap 2, on C-BG, in the suit colors, as a
#    PPM from awk (the way assets/src/build-test-tile.sh does it), then PNG
hex_of() { awk -v role="$1" '$0 ~ "^ *\\(?\\(" role " " { l = $0; sub(/^[^"]*"/, "", l); sub(/".*/, "", l); print l; exit }' assets/palette.sgl; }
BG="$(hex_of C-BG)"; S0="$(hex_of C-SUIT-0)"; S1="$(hex_of C-SUIT-1)"; S2="$(hex_of C-SUIT-2)"; S3="$(hex_of C-SUIT-3)"; DM="$(hex_of C-DAEMON)"
awk -v bg="$BG" -v s0="$S0" -v s1="$S1" -v s2="$S2" -v s3="$S3" -v dm="$DM" '
  function hex2(h, i) { return (index("0123456789ABCDEF", substr(h, i, 1)) - 1) * 16 + index("0123456789ABCDEF", substr(h, i + 1, 1)) - 1 }
  function rgb(h) { return sprintf("%c%c%c", hex2(h, 2), hex2(h, 4), hex2(h, 6)) }
  BEGIN { SCALE = 2; GAP = 2; CW = 5 * SCALE; CH = 7 * SCALE; W = 36 * CW + 37 * GAP; H = CH + 2 * GAP }
  { for (r = 2; r <= 8; r++) row[NR - 1, r - 2] = $r }
  END {
    printf "P6\n%d %d\n255\n", W, H
    for (y = 0; y < H; y++) {
      for (x = 0; x < W; x++) {
        c = bg
        i = int((x - GAP) / (CW + GAP)); cx = (x - GAP) - i * (CW + GAP)
        if (x >= GAP && i < 36 && cx < CW && y >= GAP && y < GAP + CH) {
          col = int(cx / SCALE); rr = int((y - GAP) / SCALE)
          if (substr(row[i, rr], col + 1, 1) == "#") c = (i < 8) ? s0 : (i < 16) ? s1 : (i < 24) ? s2 : (i < 32) ? s3 : dm
        }
        printf "%s", rgb(c)
      }
    }
  }' "$mod.rows" > "$mod.ppm"
convert "$mod.ppm" -type TrueColor +set date:create +set date:modify +set date:timestamp -define png:exclude-chunks=date,time,tIME,tEXt,zTXt "PNG24:$png"
rm -f "$mod.ppm"
rm -f "$mod.rows"
echo "glyphs: $mod, $png $(identify -format '%wx%h %k colors' "$png")"
