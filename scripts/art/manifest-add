#!/bin/sh
# Append one row to assets/MANIFEST.
#
#   scripts/art/manifest-add PATH LICENCE ORIGIN PROMPT-ID MODEL DATE SHAPED-BY NOTES...
#
# PATH is relative to assets/ and must exist there; a second row for the
# same path is refused (edit the existing one). The columns are checked
# against their closed vocabularies so a typo cannot pass the gate as a
# provenance claim.
set -eu
cd "$(dirname "$0")/../.." || exit 1
[ $# -ge 8 ] || { echo "manifest-add: PATH LICENCE ORIGIN PROMPT-ID MODEL DATE SHAPED-BY NOTES..."; exit 2; }
path="$1"; licence="$2"; origin="$3"; prompt="$4"; model="$5"; date="$6"; shaped="$7"; shift 7
notes="$*"
[ -f "assets/$path" ] || { echo "manifest-add: assets/$path does not exist"; exit 1; }
case "$licence" in CC-BY-4.0|reserved) ;; *) echo "manifest-add: licence must be CC-BY-4.0 or reserved"; exit 1 ;; esac
case "$origin" in hand-made|generated-and-shaped|generated-raw) ;; *) echo "manifest-add: origin must be hand-made | generated-and-shaped | generated-raw"; exit 1 ;; esac
case "$shaped" in hand|pipeline|David) ;; *) echo "manifest-add: shaped-by must be hand | pipeline | David"; exit 1 ;; esac
echo "$date" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || { echo "manifest-add: date must be YYYY-MM-DD"; exit 1; }
if grep -v '^#' assets/MANIFEST | awk -F' \\| ' '{ print $1 }' | grep -qx "$path"; then
  echo "manifest-add: $path already has a row"; exit 1
fi
case "$notes" in *"|"*) echo "manifest-add: notes must not contain |"; exit 1 ;; esac
printf '%s | %s | %s | %s | %s | %s | %s | %s\n' "$path" "$licence" "$origin" "$prompt" "$model" "$date" "$shaped" "$notes" >> assets/MANIFEST
echo "manifest-add: $path"
