#!/bin/sh
# The hub's tile sheet from its text: the data module the game bakes its
# tiles from and the PNG the manifest and the color gate cover.
#
#   scripts/art/hub-tiles       assets/hub/tiles.txt
#                               -> src/crash/hub/tiles.sgl, assets/hub/tiles.png
#
# The text holds a "ramp:" line naming eight palette roles and then
# tiles of 16x16 cells, each opened by "= NAME": . transparent, 1..8 a
# ramp entry. The module carries the ramp as role names (strings) and the
# rows as quoted vectors of strings, the shape (crash title alphabet)
# ships; no symbols, no #f cells: the wasm literal hazards, CLAUDE.md); (crash hub draw) bakes them
# into one render target at run time and draws a cell as one texture
# region. The PNG is the tiles at scale 2 with a 2 px gap in their ramp
# colors on C-BG, checked against assets/palette.sgl by the color gate.
set -eu
export LC_ALL=C
cd "$(dirname "$0")/../.." || exit 1
src="assets/hub/tiles.txt"
[ -f "$src" ] || { echo "hub-tiles: no $src"; exit 1; }
mod="src/crash/hub/tiles.sgl"
png="assets/hub/tiles.png"
mkdir -p src/crash/hub assets/hub
# 1. parse: the ramp, the names and rows, refusing anything off the 16x16 grid
awk '
  /^ramp:/ { if (NF != 9) { print "hub-tiles: ramp needs eight roles" > "/dev/stderr"; exit 1 }
             for (i = 2; i <= NF; i++) ramp[i - 1] = $i; next }
  /^[.1-8]+$/ { if (n == 0) { print "hub-tiles: rows before the first = NAME" > "/dev/stderr"; exit 1 }
                if (length($0) != 16) { print "hub-tiles: " name[n] " row " rows[n] + 1 " is " length($0) " cells, want 16" > "/dev/stderr"; exit 1 }
                rows[n]++; g[n, rows[n]] = $0; next }
  /^#/ { next }
  /^= [a-z][a-z0-9-]*$/ { n++; name[n] = substr($0, 3); rows[n] = 0; next }
  /^= / { print "hub-tiles: bad name at line " NR " (kebab-case only): " $0 > "/dev/stderr"; exit 1 }
  /^[ \t]*$/ { next }
  { print "hub-tiles: bad line " NR ": " $0 > "/dev/stderr"; exit 1 }
  END {
    if (!(8 in ramp)) { print "hub-tiles: no ramp: line" > "/dev/stderr"; exit 1 }
    if (n == 0) { print "hub-tiles: no tiles" > "/dev/stderr"; exit 1 }
    for (i = 1; i <= n; i++) if (rows[i] != 16) { print "hub-tiles: " name[i] " has " rows[i] " rows" > "/dev/stderr"; exit 1 }
    printf "ramp"; for (i = 1; i <= 8; i++) printf " %s", ramp[i]; printf "\n"
    for (i = 1; i <= n; i++) { printf "%s", name[i]; for (r = 1; r <= 16; r++) printf " %s", g[i, r]; printf "\n" }
  }' "$src" > "$mod.rows"
# 2. the data module
{
  echo ";;; (crash hub tiles) - the hub's tile sheet, GENERATED by scripts/art/hub-tiles"
  echo ";;; from $src; edit the text, not this file. TILE-RAMP names the"
  echo ";;; eight palette roles a cell's digit stands for; each tile is sixteen"
  echo ";;; rows of sixteen cells, . transparent, 1..8 a ramp entry."
  echo ""
  echo "(define-library (crash hub tiles)"
  echo "  (export TILE-SIZE TILE-RAMP TILE-NAMES TILES tile-index tile-rows)"
  echo ""
  echo "  (begin"
  echo "    (define TILE-SIZE 16)"
  printf "    (define TILE-RAMP\n      '#("
  awk 'NR == 1 { for (i = 2; i <= 9; i++) printf "%s\"%s\"", (i > 2 ? " " : ""), $i }' "$mod.rows"
  echo "))"
  printf "    (define TILE-NAMES\n      '#("
  awk 'NR > 1 { printf "%s\"%s\"", (NR > 2 ? "\n         " : ""), $1 }' "$mod.rows"
  echo "))"
  echo ""
  printf "    (define TILES\n      '#("
  awk 'NR > 1 { printf "%s(", (NR > 2 ? "\n         " : ""); for (r = 2; r <= 17; r++) printf "%s\"%s\"", (r > 2 ? " " : ""), $r; printf ")" }' "$mod.rows"
  echo "))"
  echo ""
  echo "    ;; The tile's index by name, or #f."
  echo "    (define (tile-index name)"
  echo "      (let loop ((i 0))"
  echo "        (cond ((= i (vector-length TILE-NAMES)) #f)"
  echo "              ((string=? (vector-ref TILE-NAMES i) name) i)"
  echo "              (else (loop (+ i 1))))))"
  echo ""
  echo "    ;; The sixteen rows of a tile by name, or #f."
  echo "    (define (tile-rows name)"
  echo "      (let ((i (tile-index name)))"
  echo "        (and i (vector-ref TILES i))))))"
} > "$mod"
# 3. the PNG: the tiles in a row at scale 2, gap 2, on C-BG, as a PPM from awk
hex_of() { awk -v role="$1" '$0 ~ "^ *\\(?\\(" role " " { l = $0; sub(/^[^"]*"/, "", l); sub(/".*/, "", l); print l; exit }' assets/palette.sgl; }
BG="$(hex_of C-BG)"
RAMP=""
for role in $(awk 'NR == 1 { for (i = 2; i <= 9; i++) print $i }' "$mod.rows"); do
  hex="$(hex_of "$role")"
  [ -n "$hex" ] || { echo "hub-tiles: $role is not in assets/palette.sgl"; exit 1; }
  RAMP="$RAMP $hex"
done
awk -v bg="$BG" -v ramp="$RAMP" '
  function hex2(h, i) { return (index("0123456789ABCDEF", substr(h, i, 1)) - 1) * 16 + index("0123456789ABCDEF", substr(h, i + 1, 1)) - 1 }
  function rgb(h) { return sprintf("%c%c%c", hex2(h, 2), hex2(h, 4), hex2(h, 6)) }
  BEGIN { split(ramp, tone, " "); SCALE = 2; GAP = 2; CW = 16 * SCALE }
  NR > 1 { n++; for (r = 2; r <= 17; r++) row[n - 1, r - 2] = $r }
  END {
    W = n * CW + (n + 1) * GAP; H = CW + 2 * GAP
    printf "P6\n%d %d\n255\n", W, H
    for (y = 0; y < H; y++) {
      for (x = 0; x < W; x++) {
        c = bg
        i = int((x - GAP) / (CW + GAP)); cx = (x - GAP) - i * (CW + GAP)
        if (x >= GAP && i < n && cx < CW && y >= GAP && y < GAP + CW) {
          col = int(cx / SCALE); rr = int((y - GAP) / SCALE)
          d = substr(row[i, rr], col + 1, 1)
          if (d != ".") c = tone[d + 0]
        }
        printf "%s", rgb(c)
      }
    }
  }' "$mod.rows" > "$mod.ppm"
convert "$mod.ppm" -type TrueColor +set date:create +set date:modify +set date:timestamp -define png:exclude-chunks=date,time,tIME,tEXt,zTXt "PNG24:$png"
rm -f "$mod.ppm" "$mod.rows"
echo "hub-tiles: $mod, $png $(identify -format '%wx%h %k colors' "$png")"
