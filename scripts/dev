#!/bin/sh
# Run a sigil command inside the guix environment the native build needs.
#   scripts/dev sigil build
#   scripts/dev sigil test
#   scripts/dev ./build/dev/bin/crash-the-stack
cd "$(dirname "$0")/.." || exit 1
exec guix shell -m manifest.scm -- sh -c 'CPATH=$GUIX_ENVIRONMENT/include LIBRARY_PATH=$GUIX_ENVIRONMENT/lib LD_LIBRARY_PATH=$GUIX_ENVIRONMENT/lib exec "$@"' sh "$@"
