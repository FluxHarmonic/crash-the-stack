#!/bin/sh
# Publish crashthestack.com to Cloudflare Pages (project crashthestack; the
# Pages URL is https://crashthestack.pages.dev/): the site and the game.
#
#   scripts/publish-web "<row>: <one line>"     deploy the current site/public + build/web
#   scripts/publish-web --dry-run                stage and list only; nothing leaves the box
#
# What leaves the box is the tree scripts/stage-web builds (P4b, D20): the
# Press site at the root (site/public), the game under /jack-in/ (the
# page, the stylesheet, the wasm, the bridge loader and its manifest,
# assets/; bin/ and native/ are build intermediates and stay home), the
# tracker under /tracker/, and the root's _headers, _redirects and the
# worker tombstone, and the soundtrack under /soundtrack/. stage-web
# refuses when any part is missing (a link pointing at a 404 is the
# failure this guards). The deploy is tagged with the current commit so
# the site says which tree it is.
#
# wrangler must be on PATH and logged in (it is, on this box). This script
# never touches DNS or the project's settings.
set -eu
cd "$(dirname "$0")/.." || exit 1

DRY=0; if [ "${1:-}" = "--dry-run" ]; then DRY=1; shift; fi
MESSAGE="${1:-}"
[ -n "$MESSAGE" ] || [ "$DRY" = 1 ] || { echo "publish-web: give the deploy a message: publish-web \"<row>: <one line>\""; exit 1; }
[ "$DRY" = 1 ] || command -v wrangler > /dev/null || { echo "publish-web: wrangler not on PATH"; exit 1; }

# Require the external soundtrack bundle so later publishes preserve the album.
SOUNDTRACK="${CRASH_SOUNDTRACK_DIR:-build/web/soundtrack}"
for f in index.html style.css player.js album.json; do
  [ -f "$SOUNDTRACK/$f" ] || { echo "publish-web: soundtrack missing; set CRASH_SOUNDTRACK_DIR to the generated soundtrack/ directory"; exit 1; }
done

STAGE="$(mktemp -d /tmp/crash-publish-XXXXXX)"
trap 'rm -rf "$STAGE"' EXIT
scripts/stage-web "$STAGE"

if [ "$DRY" = 1 ]; then echo "publish-web: dry run, nothing deployed"; exit 0; fi
SHA="$(git rev-parse HEAD)"
wrangler pages deploy "$STAGE" \
  --project-name crashthestack \
  --branch master \
  --commit-hash "$SHA" \
  --commit-message "$MESSAGE"
