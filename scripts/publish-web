#!/bin/sh
# Publish crashthestack.com to Cloudflare Pages (project crashthestack; the
# Pages URL is https://crashthestack.pages.dev/): the site and the game.
#
#   scripts/publish-web "<row>: <one line>"     deploy the current site/public + build/web
#   scripts/publish-web --dry-run                stage and list only; nothing leaves the box
#
# What leaves the box is the tree scripts/stage-web builds (P4b, D20): the
# Press site at the root (site/public), the game under /jack-in/ (the
# page, the stylesheet, the wasm, the bridge loader and its manifest,
# assets/; bin/ and native/ are build intermediates and stay home), the
# tracker under /tracker/, and the root's _headers, _redirects and the
# worker tombstone, and the album's listening page under /soundtrack/
# (built from the tree by stage-web, never from what is already live).
# stage-web refuses when any part is missing or stale (a link pointing at
# a 404, or a page reverted to an older style, are the failures this
# guards). The deploy is tagged with the current commit so the site says
# which tree it is.
#
# wrangler must be on PATH and logged in (it is, on this box). This script
# never touches DNS or the project's settings.
set -eu
cd "$(dirname "$0")/.." || exit 1

DRY=0; if [ "${1:-}" = "--dry-run" ]; then DRY=1; shift; fi
MESSAGE="${1:-}"
[ -n "$MESSAGE" ] || [ "$DRY" = 1 ] || { echo "publish-web: give the deploy a message: publish-web \"<row>: <one line>\""; exit 1; }
[ "$DRY" = 1 ] || command -v wrangler > /dev/null || { echo "publish-web: wrangler not on PATH"; exit 1; }

# The game's tree. build/web is this box's own build; the release path sets
# CRASH_WEB_DIR to a runner's fresh checkout (build/remote-web-<sha>), so the
# published bytes are the gated bytes and nothing stale can survive in a
# directory a build never cleans. A named tree must say which commit it was
# built at, and that commit must be HEAD: the log then proves what shipped.
WEB="${CRASH_WEB_DIR:-build/web}"
[ -f "$WEB/index.html" ] || { echo "publish-web: $WEB/index.html missing; build --config web (or point CRASH_WEB_DIR at a built tree)"; exit 1; }
STAMP="$(grep -o 'version: "[^"]*"' "$WEB/index.html" | head -1 | cut -d'"' -f2)"
HEAD_SHA="$(git rev-parse --short=12 HEAD)"
# Whichever tree it is: a deploy is tagged with HEAD, so a tree built from
# a dirty working copy, or built at another commit, would publish bytes the
# tag does not describe. The default path is the one that needs this most:
# build/web is the directory someone reaches for in a hurry.
case "$STAMP" in
  *-dirty-*) echo "publish-web: $WEB was built from a dirty tree (stamp $STAMP); publish a tree built from a commit"; exit 1 ;;
esac
[ "$STAMP" = "$HEAD_SHA" ] || { echo "publish-web: $WEB was built at $STAMP, HEAD is $HEAD_SHA; build the commit you are publishing"; exit 1; }
echo "publish-web: source tree $WEB, built at $STAMP (= HEAD)"

STAGE="$(mktemp -d /tmp/crash-publish-XXXXXX)"
trap 'rm -rf "$STAGE"' EXIT
# the upload mode: the two wasm go to R2 and no wasm may be left in the tree
# (Cloudflare Pages refuses a file over 25 MiB, and the game's is past it)
WASM_MODE=--upload
[ "$DRY" = 0 ] || WASM_MODE=--local
CRASH_WEB_DIR="$WEB" WASM_MODE="$WASM_MODE" scripts/stage-web "$STAGE"

# /version.json, generated into the tree being published and never written by
# hand: the version from package.sgl, the stamp of THIS tree, and the date and
# summary of that version's News post. The game fetches it to find out whether
# a newer version exists and what to say about it. It is generated here, after
# staging, so it describes the staged bytes rather than whatever was last
# built; a dry run generates it too, so the check runs before a real publish.
node scripts/make-version-json.mjs "$STAGE" "$STAMP" || exit 1

if [ "$DRY" = 1 ]; then echo "publish-web: dry run, nothing deployed"; exit 0; fi
SHA="$(git rev-parse HEAD)"
wrangler pages deploy "$STAGE" \
  --project-name crashthestack \
  --branch master \
  --commit-hash "$SHA" \
  --commit-message "$MESSAGE"
