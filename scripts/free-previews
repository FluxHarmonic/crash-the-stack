#!/usr/bin/env bash
# Make FREE PLAY's tile previews (0.3, t-beb409) from a web build: one
# 640x400 shot of each table through scripts/shot-web.mjs, each halved to
# 320x200 by a box filter, joined left to right in FREE-TILES' order
# (stack cards scan intercept decrypt checksum) into assets/free/previews.png.
#
#   scripts/free-previews BUILD-DIR [OUT.png]
#
# BUILD-DIR is a served web tree (build/web, or build/remote-web-<sha>).
# Each table opens through its door with a fixed seed, so the strip is the
# same boards every time the build draws them the same way:
#   STACK      ?stack&seed=3                    the Turtle, dealt
#   DEFRAG     ?cards&seed=3                    the deal
#   SCAN       ?scan=lan&seed=5, a tap mid-board the first scan opened
#   INTERCEPT  ?intercept=clock-edge&autoplay   eight seconds in
#   DECRYPT    ?decrypt=endless&seed=3          the deal
# Needs node, google-chrome and ImageMagick (convert); refuses when a shot
# is missing or not 640x400, and when the strip is not 1920x200.
set -euo pipefail
cd "$(dirname "$0")/.."
BUILD=${1:?usage: scripts/free-previews BUILD-DIR [OUT.png]}
OUT=${2:-assets/free/previews.png}
[ -f "$BUILD/index.html" ] || { echo "free-previews: no index.html under $BUILD" >&2; exit 2; }
command -v convert >/dev/null || { echo "free-previews: ImageMagick's convert is not on PATH (guix shell imagemagick -- $0 ...)" >&2; exit 2; }
WORK=$(mktemp -d /tmp/crash-free-previews.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

shot() {   # name query actions...
  local name=$1 query=$2; shift 2
  local acts=()
  for a in "$@"; do acts+=(--do "$a"); done
  node scripts/shot-web.mjs "$BUILD" "$WORK/$name.png" --query "$query" --port 8191 --cdp 9291 "${acts[@]}" >"$WORK/$name.log" 2>&1 \
    || { echo "free-previews: the $name shot failed:" >&2; cat "$WORK/$name.log" >&2; exit 1; }
  local size
  size=$(convert "$WORK/$name.png" -format '%wx%h' info:)
  [ "$size" = 640x400 ] || { echo "free-previews: the $name shot is $size, not 640x400" >&2; exit 1; }
  convert "$WORK/$name.png" -filter box -resize 320x200! "PNG24:$WORK/$name-half.png"
  echo "free-previews: $name ($(tail -1 "$WORK/$name.log"))"
}

shot stack "stack&seed=3" "wait:2500"
shot cards "cards&seed=3" "wait:3000"
shot scan "scan=lan&seed=5" "line:^crash: scan open" "press:320,200" "wait:2500"
shot intercept "intercept=clock-edge&autoplay" "line:^crash: intercept start" "wait:8000"
shot decrypt "decrypt=endless&seed=3" "wait:2500"
shot checksum "checksum=classic&seed=3" "line:^crash: checksum open" "wait:2500"

mkdir -p "$(dirname "$OUT")"
convert "$WORK/stack-half.png" "$WORK/cards-half.png" "$WORK/scan-half.png" \
        "$WORK/intercept-half.png" "$WORK/decrypt-half.png" "$WORK/checksum-half.png" +append "PNG24:$OUT"
size=$(convert "$OUT" -format '%wx%h' info:)
[ "$size" = 1920x200 ] || { echo "free-previews: the strip is $size, not 1920x200" >&2; exit 1; }
echo "free-previews: $OUT ($size, sha256 $(sha256sum "$OUT" | cut -c1-16))"
