#!/bin/sh
# Assert the served build is bound to the WireGuard address and nothing wider.
#
#   scripts/check-bind [PORT]     default 8770
#
# Reads the listening sockets, finds the one on PORT, prints its line, and
# exits 0 only if its local address equals wg0's IPv4 address. 0.0.0.0, *,
# [::], the LAN address, or no listener at all are all failures, each named.
set -u
PORT="${1:-8770}"
WG="$(ip -4 -o addr show wg0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
[ -n "$WG" ] || { echo "FAIL bind: wg0 has no IPv4 address"; exit 1; }

line="$(ss -ltnp 2>/dev/null | awk -v p=":$PORT" '$4 ~ p"$" {print; exit}')"
[ -n "$line" ] || { echo "FAIL bind: nothing is listening on port $PORT"; exit 1; }
echo "$line"
addr="$(echo "$line" | awk '{print $4}' | sed "s/:$PORT\$//")"
if [ "$addr" = "$WG" ]; then
  echo "PASS bind: $addr:$PORT is the wg0 address"
  exit 0
else
  echo "FAIL bind: $addr:$PORT is not the wg0 address $WG"
  exit 1
fi
