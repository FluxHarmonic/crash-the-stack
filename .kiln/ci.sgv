(pipeline ci
  on: #[ (push) (manual) ]

  (job ci
    steps: #[
      (shell name: deps  "guix shell -m manifest.scm -- sh -c 'CPATH=$GUIX_ENVIRONMENT/include LIBRARY_PATH=$GUIX_ENVIRONMENT/lib sigil deps install'")
      (shell name: build "guix shell -m manifest.scm -- sh -c 'CPATH=$GUIX_ENVIRONMENT/include LIBRARY_PATH=$GUIX_ENVIRONMENT/lib sigil build'")
      (shell name: test  "guix shell -m manifest.scm -- sh -c 'CPATH=$GUIX_ENVIRONMENT/include LIBRARY_PATH=$GUIX_ENVIRONMENT/lib LD_LIBRARY_PATH=$GUIX_ENVIRONMENT/lib sigil test'")
    ]))
