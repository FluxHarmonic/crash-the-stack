;;; A SCAN board opens with an empty nursery (D81): (crash scan open) runs a
;;; minor collection after making the session, so the first click's deal
;;; does not start on a young generation someone else nearly filled.
;;;
;;; The nursery is filled first (garbage until occupancy passes 0.3), so the
;;; assertion can fail: a scan-open that did not collect leaves it there.

(import (sigil test)
        (sigil gc)
        (crash scan input)
        (crash scan open))

;; Allocate garbage until the young generation is at least `level` full,
;; or give up (a runtime without a young generation reads 0.0 always).
(define (fill-nursery! level)
  (let loop ((k 0) (keep '()))
    (cond ((>= (gc-young-occupancy) level) #t)
          ((> k 2000000) #f)
          (else (loop (+ k 1) (if (= 0 (modulo k 1000)) '() (cons (make-vector 8 k) keep)))))))

(test-group "scan open: the board opens on an empty nursery"
  (test "a FREE PLAY board"
    (assert-true (fill-nursery! 0.3))
    (let ((before (gc-young-occupancy))
          (s (scan-open 'backbone 7 'original #f #t)))
      (assert-true (> before 0.3))
      (assert-true (< (gc-young-occupancy) 0.05))
      (assert-false (scan-session-segment s))
      (assert-equal 'backbone (scan-session-preset s))))
  (test "a node board"
    (assert-true (fill-nursery! 0.3))
    (let ((s (scan-open-node 16 10 20 99 #f)))
      (assert-true (< (gc-young-occupancy) 0.05))
      (assert-equal 'node (scan-session-preset s)))))
