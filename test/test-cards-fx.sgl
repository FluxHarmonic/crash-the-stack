;;; P2 - the card table's effects on the fixed clock.
;;;
;;; A frame with nothing to show is idle; the win starts the cascade,
;;; which launches one card per CASCADE-GAP ticks from the foundations,
;;; every flying card obeys gravity and bounces off the board's bottom
;;; edge, the trail never exceeds TRAIL positions, and every card is gone
;;; once the launched count reaches 52; the trace completing starts the
;;; glitch, which runs GLITCH-TICKS and stops; a new message becomes a
;;; toast that lasts TOAST-TICKS. (The one frame path no rules leg
;;; reaches: this file exists because a wrong accessor here once reddened
;;; every browser sub-arm while the rules legs stayed green.)

(import (sigil test)
        (sigil math)
        (crash input)
        (crash trace)
        (crash tween)
        (crash geometry)
        (crash cards deck)
        (crash cards rules)
        (crash cards geometry)
        (crash cards input)
        (crash cards fx))

(define geom (make-card-geometry 640 400))

(define (card-fx-frame* x dt) (card-fx-frame x dt geom))
(define (frames* x n)
  (if (= n 0) x (frames* (card-fx-frame* x (/ 1.0 60.0)) (- n 1))))

(define (won-deal)
  (let ((won (game (game-new 1 1)
                   tableau: (make-vector PILES '())
                   stock: '()
                   waste: '()
                   foundations: (list->vector
                                  (map (lambda (s) (reverse (map (lambda (r) (make-card s r)) (iota 13 1))))
                                       (iota 4))))))
    (deal-restore 1 won #t (trace-new 'twist))))

(test-group "idle and the frame"
  (test "a new fx is idle and a frame of it stays idle"
    (let* ((x (card-fx-new))
           (d (deal-new 1 1))
           (x1 (card-fx-frame* x 0.02))
           (x2 (card-fx-observe x1 d d geom)))
      (assert-true (card-fx-idle? x))
      (assert-true (card-fx-idle? x2))
      (assert-false (card-fx-glitch x2))
      (assert-false (card-fx-toast x2)))))

(test-group "the cascade"
  (let* ((before (deal-new 1 1))
         (after (won-deal))
         (x (card-fx-observe (card-fx-new) before after geom)))
    (test "the win starts it"
      (assert-true (card-fx-cascading? x))
      (assert-false (card-fx-idle? x)))
    (test "one launch per CASCADE-GAP ticks, cycling the foundations"
      (let ((x1 (frames* x CASCADE-GAP))
            (x4 (frames* x (* 4 CASCADE-GAP))))
        (assert-equal 1 (length (card-fx-flying x1)))
        (assert-equal '(1 0 0 0) (vector->list (card-fx-launched x1)))
        (assert-equal '(1 1 1 1) (vector->list (card-fx-launched x4)))))
    (test "a card falls, bounces off the board's bottom edge, and never overruns it"
      (let* ((floor-y (- 400 HUD-HEIGHT CARD-H))
             (x1 (frames* x (* 30 CASCADE-GAP))))
        (assert-true (every (lambda (f) (<= (flyer-y f) (+ floor-y 0.001))) (card-fx-flying x1)))
        (assert-true (pair? (card-fx-flying x1)))))
    (test "the trail is bounded by TRAIL"
      (let ((x1 (frames* x 200)))
        (assert-true (every (lambda (f) (<= (length (flyer-trail f)) TRAIL)) (card-fx-flying x1)))))
    (test "every card is launched and, in time, gone"
      (let ((x1 (frames* x 3000)))
        (assert-equal '(13 13 13 13) (vector->list (card-fx-launched x1)))
        (assert-false (card-fx-cascading? x1))
        (assert-equal '() (card-fx-flying x1))))
    (test "a new deal stops it"
      (let ((x1 (card-fx-observe (frames* x 50) after (deal-next after) geom)))
        (assert-false (card-fx-cascading? x1))
        (assert-equal '() (card-fx-flying x1))))))

(test-group "the glitch and the toasts"
  (test "the trace completing starts the glitch, which runs GLITCH-TICKS"
    (let* ((d (deal-new 1 1))
           (traced (deal-advance d (* 60 TRACE-AT)))
           (x (card-fx-observe (card-fx-new) d traced geom)))
      (assert-equal 'counter (trace-phase (deal-trace traced)))
      (assert-true (and (card-fx-glitch x) #t))
      (assert-true (and (card-fx-glitch (frames* x (- GLITCH-TICKS 1))) #t))
      (assert-false (card-fx-glitch (frames* x GLITCH-TICKS)))))
  (test "a new message is a toast for TOAST-TICKS"
    (let* ((d (deal-new 1 1))
           (d1 (deal d message: "HELLO."))
           (x (card-fx-observe (card-fx-new) d d1 geom)))
      (assert-equal "HELLO." (car (card-fx-toast x)))
      (assert-true (and (card-fx-toast (frames* x (- TOAST-TICKS 1))) #t))
      (assert-false (card-fx-toast (frames* x TOAST-TICKS))))))

(test-group "card slides"
  (let* ((d0 (deal-restore 1 (game-from-deck (deck-string->cards FIXTURE-DECK) 1) #t (trace-new 'twist)))
         (g0 (deal-game d0))
         (d1 (deal-restore 1 (game-select (game-select g0 '(pile 0 0)) '(pile 2)) #t (deal-trace d0)))
         (x (card-fx-observe (card-fx-new) d0 d1 geom)))
    (test "the moved card slides from its old rect to its new one"
      (let ((movers (card-fx-movers x)))
        (assert-equal 1 (length movers))
        (assert-equal "S2" (card-string (car (car movers))))
        (assert-equal (list (make-card 0 2)) (card-fx-moving-cards x))
        ;; at the start it sits where pile 0's top was
        (assert-equal (pile-card-rect geom g0 0 0) (cadr (car movers)))
        (assert-true (caddr (car movers)))))
    (test "after MOVE-TICKS it has arrived and is gone from the slides"
      (let* ((x1 (frames* x (- MOVE-TICKS 1)))
             (x2 (frames* x MOVE-TICKS)))
        (assert-equal 1 (length (card-fx-movers x1)))
        (assert-equal '() (card-fx-movers x2))
        (assert-true (card-fx-idle? x2))))
    (test "the slide survives frames on which the deal did not change (the shell observes every frame)"
      ;; each frame: advance, then observe d1 against itself, as cards-tick does
      (let loop ((x x) (n 1))
        (if (< n MOVE-TICKS)
            (let ((x (card-fx-observe (card-fx-frame* x (/ 1.0 60.0)) d1 d1 geom)))
              (assert-equal 1 (length (card-fx-movers x)))
              ;; and it has left its old rect
              (assert-false (equal? (pile-card-rect geom g0 0 0) (cadr (car (card-fx-movers x)))))
              (loop x (+ n 1)))
            (assert-equal '() (card-fx-movers (card-fx-observe (card-fx-frame* x (/ 1.0 60.0)) d1 d1 geom))))))
    (test "a card pulled from the stock does not slide (it turns over in place)"
      (let* ((d2 (deal-restore 1 (game-select g0 '(stock)) #t (deal-trace d0)))
             (x (card-fx-observe (card-fx-new) d0 d2 geom)))
        (assert-equal '() (card-fx-movers x))))
    (test "a card from the waste to a pile slides from the waste"
      (let* ((g8 (fold (lambda (g _) (game-draw! g)) g0 (iota 8)))         ; CA on top of the waste
             (g9 (game-select (game-select g8 '(waste)) '(waste)))          ; CA to a foundation
             (x (card-fx-observe (card-fx-new)
                                 (deal-restore 1 g8 #t (deal-trace d0))
                                 (deal-restore 1 g9 #t (deal-trace d0))
                                 geom))
             (m (car (card-fx-movers x))))
        (assert-equal 1 (length (card-fx-movers x)))
        (assert-equal "CA" (card-string (car m)))
        (assert-equal (waste-card-rect geom g8 0) (cadr m))))
    (test "a turn of the waste (24 cards) is not a slide"
      (let* ((g24 (fold (lambda (g _) (game-draw! g)) g0 (iota 24)))
             (g25 (game-draw! g24))
             (x (card-fx-observe (card-fx-new)
                                 (deal-restore 1 g24 #t (deal-trace d0))
                                 (deal-restore 1 g25 #t (deal-trace d0))
                                 geom)))
        (assert-equal '() (card-fx-movers x))))))

(test-group "the ICE's hits"
  (let* ((d0 (deal-restore 1 (game-from-deck (deck-string->cards FIXTURE-DECK) 1) #t (trace-new 'twist)))
         (g (game-select (game-select (game-select (deal-game d0) '(pile 0 0)) '(pile 2)) '(stock)))
         (d (deal-restore 1 g #t (deal-trace d0)))
         (tr-hit (lambda (name) (trace (deal-trace d) ice-count: 1 last-ice: name))))
    (test "corrupt: the waste's top shakes and flashes for HIT-TICKS"
      (let* ((c (game-corrupt-waste g 3))
             (dc (deal-restore 1 c #t (tr-hit 'corrupt)))
             (x (card-fx-observe (card-fx-new) d dc geom))
             (hit (card-fx-hit x '(waste 0))))
        (assert-true (and hit #t))
        (assert-true (<= (abs (car hit)) HIT-SHAKE))
        (assert-true (= 1 (cdr hit)))
        (assert-false (card-fx-hit x '(pile 2 1)))
        (assert-false (card-fx-hit (frames* x HIT-TICKS) '(waste 0)))))
    (test "encrypt: the packet that went face down shakes and flashes"
      (let* ((e (game-encrypt g '(pile 2 1) 600))
             (de (deal-restore 1 e #t (tr-hit 'encrypt)))
             (x (card-fx-observe (card-fx-new) d de geom)))
        (assert-true (and (card-fx-hit x '(pile 2 1)) #t))
        (assert-false (card-fx-hit x '(pile 2 0)))
        (assert-false (card-fx-hit x '(waste 0)))))))
