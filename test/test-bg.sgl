;;; Gate (P3) leg 5 - the living background, a field of color.
;;;
;;; Determinism from a seed: two runs of one seed over 600 ticks are the
;;; same field, cell for cell, and different seeds differ. A live, bounded
;;; field, for REACTION over 3600 ticks (a minute) on seeds 1..4: the
;;; field never freezes (it changes between ticks), the tones the runs
;;; draw are spread (at least four of the ramp's eight present at the
;;; end: a field gone one flat color is dead) and no tone ever holds
;;; more than DOMINANT-CAP of the half cells (sampled every 60 ticks: the
;;; runs are the renderer's cost). The phase inputs take effect: the ICE
;;; increases REACTION iterations, a burst reaches the cap and passes,
;;; severed collapses every value and changes nothing else. bg-runs
;;; answers rectangles on the half-cell grid inside the board area,
;;; and under 3000 of them (sokol_gp's frame budget shared with the
;;; tiles).

(import (sigil test)
        (sigil list)
        (sigil math)
        (crash bg))

(define TICKS 3600)
(define SEEDS 4)
(define RECORDED-SEED 7)
(define RECORDED-TICKS 600)

(define (tones-present runs)
  (let ((seen (make-vector RAMP #f)))
    (for-each (lambda (r) (vector-set! seen (car r) #t)) runs)
    (length (filter (lambda (x) x) (vector->list seen)))))

(define (cells-changed a b)
  (let loop ((i 0) (n 0))
    (if (= i (vector-length (bg-field a)))
        n
        (loop (+ i 1) (if (= (vector-ref (bg-field a) i) (vector-ref (bg-field b) i)) n (+ n 1))))))

;; the dominant tone's largest share (sampled every 60 ticks), whether
;; the field ever froze between two field steps (STRIDE ticks apart: the
;; field steps once every STRIDE ticks and holds between, the phone's
;; budget), over ticks
(define (run-stats b ticks)
  (let loop ((b b) (k 0) (dominant 0.0) (frozen 0))
    (if (>= k ticks)
        (list dominant frozen b)
        (let* ((next (bg-tick b STRIDE))
               (d (if (= 0 (modulo (+ k STRIDE) 60)) (bg-dominant next) 0.0)))
          (loop next (+ k STRIDE) (max dominant d) (if (= 0 (cells-changed b next)) (+ frozen 1) frozen))))))

(test-group "bg: determinism from a seed"
  (for-each (lambda (mode)
              (test (string-append (symbol->string mode) ": two runs of one seed are one field")
                (assert-equal (bg-canonical (bg-tick (bg-new RECORDED-SEED mode) RECORDED-TICKS))
                              (bg-canonical (bg-tick (bg-new RECORDED-SEED mode) RECORDED-TICKS))))
              (test (string-append (symbol->string mode) ": a different seed is a different field")
                (assert-false (equal? (bg-canonical (bg-tick (bg-new 1 mode) 120))
                                      (bg-canonical (bg-tick (bg-new 2 mode) 120))))))
            MODES))

(test-group "bg: a live, bounded field, the CPU reference"
  (for-each (lambda (mode)
              (let loop ((seed 1))
                (when (<= seed SEEDS)
                  (let* ((r (run-stats (bg-new seed mode) TICKS))
                         (dominant (car r)) (frozen (cadr r)) (b (caddr r))
                         (label (string-append (symbol->string mode) " seed " (number->string seed))))
                    (test (string-append label ": no tone over " (number->string DOMINANT-CAP) " of the field in "
                                         (number->string TICKS) " ticks (largest share " (number->string dominant) ")")
                      (assert-true (<= dominant DOMINANT-CAP)))
                    (test (string-append label ": the field changes at every step (frozen steps: " (number->string frozen) ")")
                      (assert-equal 0 frozen))
                    (test (string-append label ": the runs are held between steps and grouped by tone")
                      (let ((held (bg-tick b 1)))
                        (assert-true (eq? (bg-runs b) (bg-runs held)))
                        (let sorted ((rs (bg-runs b)))
                          (when (pair? (cdr rs))
                            (assert-true (<= (car (car rs)) (car (cadr rs))))
                            (sorted (cdr rs))))))
                    (test (string-append label ": at least four tones after a minute (saw " (number->string (tones-present (bg-runs b))) ")")
                      (assert-true (>= (tones-present (bg-runs b)) 4))))
                  (loop (+ seed 1)))))
            MODES))

(test-group "bg: the phase inputs"
  (test "ICE and burst increase REACTION iterations up to the cap, then the burst passes"
    (let* ((b (bg (bg-new 3 'reaction) react-steps: 1))
           (ice (bg-with-phase b 'counter))
           (burst (bg-with-burst ice)))
      (assert-equal 1 (bg-iterations b))
      (assert-equal 2 (bg-iterations ice))
      (assert-equal REACT-STEPS-MAX (bg-iterations burst))
      (assert-false (equal? (bg-canonical (bg-tick b STRIDE))
                            (bg-canonical (bg-tick ice STRIDE))))
      (assert-false (equal? (bg-canonical (bg-tick ice STRIDE))
                            (bg-canonical (bg-tick burst STRIDE))))
      (assert-equal BURST-TICKS (bg-burst burst))
      (assert-equal 0 (bg-burst (bg-tick burst BURST-TICKS)))))
  (test "severed: every value falls toward the ground, and keeps falling"
    (let* ((b (bg-with-phase (bg-tick (bg-new 5 'reaction) 300) 'severed))
           (after (bg-tick b 120)))
      (assert-true (< (bg-mean after) (bg-mean b)))
      (assert-true (< (bg-mean (bg-tick after 120)) (bg-mean after))))))

(test-group "bg: the runs"
  (for-each (lambda (mode)
              (let* ((b (bg-tick (bg-new 11 mode) 200))
                     (runs (bg-runs b))
                     (half (quotient CELL 2)))
                (test (string-append (symbol->string mode) ": every run is a half-cell rectangle inside the board area, with a tone")
                  (assert-true (pair? runs))
                  (assert-true (every (lambda (r)
                                        (and (= 5 (length r))
                                             (>= (car r) 0) (< (car r) RAMP)
                                             (= 0 (modulo (cadr r) half))
                                             (= 0 (modulo (caddr r) half))
                                             (= 0 (modulo (cadddr r) half))
                                             (= half (list-ref r 4))
                                             (>= (cadr r) 0)
                                             (<= (+ (cadr r) (cadddr r)) (* CELL GRID-W))
                                             (>= (caddr r) 0)
                                             (< (caddr r) (* CELL GRID-H))))
                                      runs)))
                (test (string-append (symbol->string mode) ": the runs cover every half-cell row exactly once")
                  (assert-equal (* 2 GRID-H (* 2 GRID-W))
                                (fold + 0 (map (lambda (r) (quotient (cadddr r) half)) runs))))
                (test (string-append (symbol->string mode) ": under 3000 rectangles")
                  (assert-true (< (length runs) 3000)))))
            MODES))

;; A GPU field keeps the schedule and none of the cell work (P3c): its
;; steps count with the stride, its field stays the seed, and it records
;; each step's agitation so the targets run a step the CPU would have
;; run at that agitation, a burst ending between two steps of one frame
;; included (the leader's review, 2026-09-19).
(test-group "bg: a GPU field's schedule"
  (test "steps count, the field is the seed, no runs"
    (let* ((b (bg-new 1 'reaction #t))
           (after (bg-tick b (* 4 STRIDE))))
      (assert-true (bg-gpu? after))
      (assert-equal 4 (bg-steps after))
      (assert-equal (vector->list (bg-field b)) (vector->list (bg-field after)))
      (assert-equal '() (bg-runs after))))
  (test "each step remembers the agitation it ran at across a burst's end"
    (let* ((b (bg-with-burst (bg-new 1 'reaction #t)))
           (after (bg-tick b (+ BURST-TICKS STRIDE))))
      ;; the burst counts down every tick and a step at the tick it reaches 0
      ;; is already calm (b0, the CPU path's struct too): steps 0..8 at the
      ;; burst, step 9 (tick 30) and after at the phase's
      (assert-equal (cons AGITATION-BURST #f) (bg-step-agit after (- (quotient BURST-TICKS STRIDE) 2)))
      (assert-equal (cons AGITATION-TRACE #f) (bg-step-agit after (- (quotient BURST-TICKS STRIDE) 1)))
      ;; a step no longer remembered answers the struct's current values
      (assert-equal (cons AGITATION-TRACE #f) (bg-step-agit after 0))
      (assert-true (<= (length (bg-pending after)) 8))))
  (test "the CPU field steps at the same agitation the GPU schedule records"
    (let* ((cpu (bg-with-burst (bg-new 2 'reaction)))
           (gpu (bg-with-burst (bg-new 2 'reaction #t)))
           (cpu1 (bg-tick cpu STRIDE))
           (gpu1 (bg-tick gpu STRIDE)))
      ;; Both stepped once at the burst, with the same capped iteration count.
      (assert-equal 1 (bg-steps cpu1))
      (assert-equal (bg-steps cpu1) (bg-steps gpu1))
      (assert-equal (bg-iterations cpu1)
                    (bg-iterations-at gpu1 (car (bg-step-agit gpu1 0))))
      (assert-true (> (cells-changed cpu cpu1) 0)))))
