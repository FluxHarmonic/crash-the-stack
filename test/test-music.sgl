;;; The music model (M1, ruling D59; P4's OGG table before it): which
;;; tune plays where, pure, so the tests can hold the table without a
;;; player. The pools are data (David re-sorts by ear); the pick is the
;;; seed's hash over the table's pool, never the last pick when the pool
;;; allows, so a share code or the daily always gets the same tune; the
;;; section a phase asks for is the one function that couples the trace
;;; to the music: CALM while the trace runs, TENSE once it completes.
;;; Every pooled tune and the menu theme is a .cts under assets/tunes/
;;; with its marks. Then the page's base64 delivery ((crash native)).

(import (sigil test)
        (sigil math)
        (sigil list)
        (sigil fs)
        (sigil io)
        (sigil string)
        (crash music)
        (crash native)
        (only (sigil io) string->utf8))

;; the test's own encoder (the game never encodes)
(define B64-DIGITS "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
(define (b64-encode bytes)
  (let* ((n (bytevector-length bytes))
         (out (make-string (* 4 (quotient (+ n 2) 3)) #\=)))
    (let loop ((i 0) (o 0))
      (when (< i n)
        (let* ((b0 (bytevector-u8-ref bytes i))
               (b1 (if (< (+ i 1) n) (bytevector-u8-ref bytes (+ i 1)) 0))
               (b2 (if (< (+ i 2) n) (bytevector-u8-ref bytes (+ i 2)) 0))
               (v (+ (* b0 65536) (* b1 256) b2)))
          (string-set! out o (string-ref B64-DIGITS (quotient v 262144)))
          (string-set! out (+ o 1) (string-ref B64-DIGITS (modulo (quotient v 4096) 64)))
          (when (< (+ i 1) n) (string-set! out (+ o 2) (string-ref B64-DIGITS (modulo (quotient v 64) 64))))
          (when (< (+ i 2) n) (string-set! out (+ o 3) (string-ref B64-DIGITS (modulo v 64))))
          (loop (+ i 3) (+ o 4)))))
    out))


(define (tune-text name) (read-file-string (music-tune-path name)))
(define (has-marks? name) (string-find (tune-text name) "(marks calm:"))

(test-group "music: the pools and the theme"
  (test "three pools, stack, cards and the hub, each with tunes; BREACH VECTOR is in the two tables' pools"
    (assert-equal '(stack cards hub) (map car POOLS))
    (assert-true (> (length (music-pool 'hub)) 1))
    (assert-true (> (length (music-pool 'stack)) 1))
    (assert-true (> (length (music-pool 'cards)) 1))
    (assert-true (and (memq 'breach-vector (music-pool 'stack)) #t))
    (assert-true (and (memq 'breach-vector (music-pool 'cards)) #t))
    (assert-equal '() (music-pool 'nothing)))
  (test "the hub's pool is David's three, exactly (2026-09-22: \"Shadow Protocol, Dead Sector and Blind Spot are the ones I have in mind for hub\")"
    ;; exactly, and in his order: a later data edit that adds a fourth or
    ;; drops one goes red here rather than drifting the hub's room silently
    (assert-equal '(shadow-protocol dead-sector blind-spot) (music-pool 'hub))
    (assert-false (memq 'quiet-array (music-pool 'hub))))
  (test "DEAD SECTOR is the hub's, on neither table; SHADOW PROTOCOL (the original sneaking track) moved to the hub; CLOCK EDGE is a candidate in no pool until David hears it"
    (for-each (lambda (name)
                (assert-false (memq name (music-pool 'stack)))
                (assert-false (memq name (music-pool 'cards)))
                (assert-true (and (memq name (music-pool 'hub)) #t)))
              '(dead-sector shadow-protocol))
    (assert-equal '(clock-edge) CANDIDATES)
    (for-each (lambda (name) (assert-false (memq name (music-pool 'stack))) (assert-false (memq name (music-pool 'cards))) (assert-false (memq name (music-pool 'hub)))) CANDIDATES))
  (test "every pooled tune and the theme is a .cts under assets/tunes/ with its marks"
    (for-each (lambda (name)
                (assert-true (file-exists? (music-tune-path name)))
                (assert-true (and (has-marks? name) #t)))
              (append (music-pool 'stack) (music-pool 'cards) (music-pool 'hub) CANDIDATES (list MENU-THEME))))
  (test "the menu theme is Black Glass (David's commissioned main theme)"
    (assert-equal 'black-glass-title MENU-THEME)
    (assert-equal "assets/tunes/black-glass-title.cts" (music-tune-path MENU-THEME))))

(test-group "music: the pick"
  (test "the same seed on the same table picks the same tune; the pick is in the pool"
    (for-each (lambda (seed)
                (let ((a (music-pick 'stack seed #f)) (b (music-pick 'stack seed #f)))
                  (assert-equal a b)
                  (assert-true (and (memq a (music-pool 'stack)) #t))))
              '(0 1 7 175561140 277501568 4294967295)))
  (test "seeds spread over the pool (no seed-blind pick)"
    (let ((picks (let loop ((seeds (iota 64)) (acc '())) (if (null? seeds) acc (let ((p (music-pick 'stack (car seeds) #f))) (loop (cdr seeds) (if (memq p acc) acc (cons p acc))))))))
      (assert-true (> (length picks) 1))))
  (test "never the last pick when the pool allows"
    (for-each (lambda (seed)
                (let* ((first (music-pick 'stack seed #f))
                       (again (music-pick 'stack seed first)))
                  (assert-false (eq? first again))
                  (assert-true (and (memq again (music-pool 'stack)) #t))))
              (iota 32)))
  (test "an empty pool picks nothing; a seed of #f reads as 0"
    (assert-false (music-pick 'nothing 5 #f))
    (assert-equal (music-pick 'cards 0 #f) (music-pick 'cards #f #f))))

(test-group "music: the section the trace asks for (the trace -> music coupling)"
  (test "the counter-hack phase is TENSE, whatever the trace's remaining time, window or current section"
    (assert-equal 'tense (music-section 'counter #f #f 'calm))
    (assert-equal 'tense (music-section 'counter 5000.0 8000.0 'fill))
    (assert-equal 'tense (music-section 'counter 50000.0 8000.0 'tense)))
  (test "the fill runs up to the trace: FILL once the remaining ms are within the window, CALM before"
    (assert-equal 'calm (music-section 'trace 50000.0 8000.0 'calm))
    (assert-equal 'calm (music-section 'trace 8000.1 8000.0 'calm))
    (assert-equal 'fill (music-section 'trace 8000.0 8000.0 'calm))
    (assert-equal 'fill (music-section 'trace 100.0 8000.0 'calm)))
  ;; the window's queue term moves on its own (a ladder step or an underrun
  ;; drains the sink): a predicate would answer CALM mid-run-up and jump the
  ;; music out of the fill with a dip. The fill latches (the reviewer's M1).
  (test "the fill is latched: a window that shrinks under the remaining time does not leave it"
    (assert-equal 'fill (music-section 'trace 7000.0 8000.0 'fill))
    (assert-equal 'fill (music-section 'trace 7000.0 3000.0 'fill))    ; the window lost 4 s of queue
    (assert-equal 'fill (music-section 'trace 7000.0 #f 'fill))        ; and the whole window with it
    (assert-equal 'fill (music-section 'trace 50000.0 8000.0 'fill)))  ; even far from the trace
  ;; the latch holds on the window, never on the landing itself: a flip to
  ;; clean mode during the run-up (the trace allows it while the phase is
  ;; trace) takes the landing away, and a latched fill would otherwise run
  ;; into a tense that loops for a game that has no ICE
  (test "the latch is released when the landing goes away (a twist -> clean flip mid-run-up)"
    (assert-equal 'calm (music-section 'trace #f 8000.0 'fill))
    (assert-equal 'calm (music-section 'trace #f #f 'fill))
    (assert-equal 'fill (music-section 'trace 0.0 8000.0 'fill)))   ; but zero is a landing: the strike is the next frame
  (test "the latch is the fill's alone: tense and calm re-decide every frame"
    (assert-equal 'calm (music-section 'trace 50000.0 8000.0 'tense))
    (assert-equal 'fill (music-section 'trace 1000.0 8000.0 'tense))
    (assert-equal 'calm (music-section 'trace 50000.0 8000.0 'calm)))
  ;; a hint or a shuffle adds its seconds to the trace's value a frame before
  ;; trace-advance flips the phase: no run-up is left, so no fill starts
  (test "a trace already past its threshold (remaining <= 0) starts no fill: the next frame is the strike"
    (assert-equal 'calm (music-section 'trace 0.0 8000.0 'calm))
    (assert-equal 'calm (music-section 'trace -12000.0 8000.0 'calm))
    (assert-equal 'tense (music-section 'counter -12000.0 8000.0 'calm)))
  (test "no window (a tune without a fill) or no landing ahead (clean mode) is CALM until the strike"
    (assert-equal 'calm (music-section 'trace 100.0 #f 'calm))
    (assert-equal 'calm (music-section 'trace #f 8000.0 'calm))
    (assert-equal 'calm (music-section 'trace #f #f 'calm)))
  (test "the cascade and the severed screen ask CALM (the live model fades out instead)"
    (assert-equal 'calm (music-section #f #f #f 'calm))
    (assert-equal 'calm (music-section 'cleared 100.0 8000.0 'fill))
    (assert-equal 'calm (music-section 'severed 100.0 8000.0 'fill))))

;; The page hands a tune's text over as base64 (the only payload the
;; bridge carries); the decode is (crash native)'s C. RFC 4648's vectors,
;; then padding absent, whitespace between the digits, and a run long
;; enough to cross a chunk.
(test-group "music: the base64 decode (the page's delivery)"
  (test "RFC 4648's vectors"
    (assert-equal (bytevector) (%b64-decode ""))
    (assert-equal (string->utf8 "f") (%b64-decode "Zg=="))
    (assert-equal (string->utf8 "fo") (%b64-decode "Zm8="))
    (assert-equal (string->utf8 "foo") (%b64-decode "Zm9v"))
    (assert-equal (string->utf8 "foob") (%b64-decode "Zm9vYg=="))
    (assert-equal (string->utf8 "fooba") (%b64-decode "Zm9vYmE="))
    (assert-equal (string->utf8 "foobar") (%b64-decode "Zm9vYmFy")))
  (test "no padding and whitespace both read"
    (assert-equal (string->utf8 "foob") (%b64-decode "Zm9vYg"))
    (assert-equal (string->utf8 "foobar") (%b64-decode "Zm9v\nYmFy ")))
  (test "every byte value round-trips through a long run"
    (let* ((n 700000)
           (bytes (make-bytevector n 0)))
      (let loop ((i 0)) (when (< i n) (bytevector-u8-set! bytes i (modulo (* i 7) 256)) (loop (+ i 1))))
      (let ((text (b64-encode bytes)))
        (assert-equal n (bytevector-length (%b64-decode text)))
        (assert-equal bytes (%b64-decode text))))))

;; The tense region loops because every tune's last tense pattern ends with
;; a Bxx position jump to its own tense mark, not because the player wraps
;; it: the region's end is the order's length, which the walk never reaches
;; (motif ends the walk there instead). A tune shipped without that jump
;; would play tense once and fall back to its loop point (position 0, calm)
;; with the model still in tense, and a later strike would find nothing to
;; jump to. Nothing in the format or in `motif tune check` requires the
;; jump, so the invariant is asserted here (the reviewer's re-read, 2026-09-22).
(define (hex->int s)
  (let loop ((i 0) (n 0))
    (if (>= i (string-length s)) n
        (let* ((c (char-upcase (string-ref s i)))
               (d (cond ((and (char>=? c #\0) (char<=? c #\9)) (- (char->integer c) 48))
                        ((and (char>=? c #\A) (char<=? c #\F)) (+ 10 (- (char->integer c) 65)))
                        (else #f))))
          (and d (loop (+ i 1) (+ (* 16 n) d)))))))

;; the last "Bxx" of the text: the trailing jump of the last tense pattern
;; (a character scan: string-find takes no start index)
(define (last-position-jump text)
  (let ((n (string-length text)))
    (let loop ((i 0) (found #f))
      (if (>= i (- n 4))
          found
          (loop (+ i 1)
                (if (and (char=? (string-ref text i) #\")
                         (char=? (string-ref text (+ i 1)) #\B)
                         (char=? (string-ref text (+ i 4)) #\"))
                    (or (hex->int (substring text (+ i 2) (+ i 4))) found)
                    found))))))

(define (tense-mark-of text)
  (let* ((marks (string-find text "(marks "))
         (rest (and marks (substring text marks (min (string-length text) (+ marks 120)))))
         (at (and rest (string-find rest "tense: "))))
    (and at (let loop ((i (+ at 7)) (n #f))
              (let ((c (string-ref rest i)))
                (if (and (char>=? c #\0) (char<=? c #\9))
                    (loop (+ i 1) (+ (* 10 (or n 0)) (- (char->integer c) 48)))
                    n))))))

(test-group "music: every pooled tune's tense region loops on itself"
  (for-each
   (lambda (name)
     (let* ((text (tune-text name))
            (tense (tense-mark-of text))
            (jump (last-position-jump text)))
       (test (string-append (symbol->string name) ": the last position jump is to its tense mark ("
                            (if jump (number->string jump) "none") " against " (if tense (number->string tense) "no tense mark") ")")
         (assert-true (and tense #t))
         (assert-true (and jump #t))
         (assert-equal tense jump))))
   (append (music-pool 'stack) (music-pool 'cards) (music-pool 'hub) CANDIDATES)))
