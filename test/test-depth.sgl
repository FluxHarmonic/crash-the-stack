;;; (crash depth), ruling D48: the candidates as data, and E's free-side
;;; predicate, which is the rules' occlusion rule and flips when the
;;; neighbour leaves the board.

(import (sigil test)
        (sigil list)
        (crash stack layout)
        (crash stack rules)
        (crash stack turtle)
        (crash stack generate)
        (crash depth))

(test-group "depth: the candidates"
  (test "E is the default (ruled from abdce9f); NONE the first entry; every entry has a label; after wraps"
    (assert-equal 'e DEFAULT-DEPTH)
    (assert-true (depth-edges (depth-ref DEFAULT-DEPTH)))
    (assert-equal '(none b b2 e abe abc b2e) DEPTH-NAMES)
    (assert-true (every (lambda (n) (string? (depth-label (depth-ref n)))) DEPTH-NAMES))
    (assert-equal 'b (depth-after 'none))
    (assert-equal 'none (depth-after 'b2e))
    (assert-equal DEFAULT-DEPTH (depth-name (depth-ref 'abd)))   ; an old store's name reads as the default
    (assert-false (depth-name? 'abd)))
  (test "the parts: B2 is B with a hue, E edges alone, B2E both; no entry moves the offset"
    (assert-true (and (depth-shade (depth-ref 'b2)) (depth-hue (depth-ref 'b2)) (not (depth-edges (depth-ref 'b2)))))
    (assert-true (and (depth-edges (depth-ref 'e)) (not (depth-shade (depth-ref 'e)))))
    (assert-true (and (depth-shade (depth-ref 'b2e)) (depth-hue (depth-ref 'b2e)) (depth-edges (depth-ref 'b2e))))
    (assert-true (every (lambda (n) (= 3 (depth-offset (depth-ref n)))) DEPTH-NAMES)))
  (test "A's side depth grows with the layer and caps; the flat depth is the offset"
    (assert-equal 3 (depth-side (depth-ref 'none) 4))
    (assert-equal '(3 4 5 6 6) (map (lambda (l) (depth-side (depth-ref 'abe) l)) '(0 1 2 3 4))))
  (test "C's shadow falls only for raised tiles and only with C"
    (assert-equal 0 (depth-shadow-fall (depth-ref 'abc) 0))
    (assert-equal 4 (depth-shadow-fall (depth-ref 'abc) 1))
    (assert-equal 0 (depth-shadow-fall (depth-ref 'b2e) 3))))

(test-group "depth: E's free-side predicate is the rules' and flips with the neighbour"
  (let* ((lay (turtle-layout))
         (b (generate lay 1))
         (ids (iota (layout-slot-count lay)))
         (present (filter (lambda (id) (tile-present? b id)) ids)))
    (test "free on a side is exactly not blocked on that side, four sides"
      (for-each (lambda (id)
                  (assert-equal (not (blocked-right? b id)) (side-free? b id 'right))
                  (assert-equal (not (blocked-left? b id)) (side-free? b id 'left))
                  (assert-equal (not (blocked-up? b id)) (side-free? b id 'up))
                  (assert-equal (not (blocked-down? b id)) (side-free? b id 'down)))
                present))
    (test "up and down are same-layer neighbours two half-units off: the Turtle has tiles with a tile below and tiles without"
      (let ((with (filter (lambda (id) (not (side-free? b id 'down))) present))
            (without (filter (lambda (id) (side-free? b id 'down)) present)))
        (assert-true (pair? with))
        (assert-true (pair? without))
        ;; a tile with one below is blocked down; the one below is blocked up
        (for-each (lambda (id)
                    (let* ((s (layout-slot lay id))
                           (below (filter (lambda (o)
                                            (let ((t (layout-slot lay o)))
                                              (and (= (slot-layer t) (slot-layer s))
                                                   (= (slot-hy t) (+ (slot-hy s) 2))
                                                   (<= (abs (- (slot-hx t) (slot-hx s))) 1))))
                                          present)))
                      (assert-true (pair? below))
                      (for-each (lambda (o) (assert-false (side-free? b o 'up))) below)))
                  with)))
    (test "a bottom edge appears on the tile above when the tile below leaves"
      (let* ((pair (car (board-solution b)))
             (after (board-select (board-select b (car pair)) (cdr pair)))
             ;; the tiles whose only same-layer tile below is one of the pair
             (same-layer-below (lambda (id)
                                 (let ((s (layout-slot lay id)))
                                   (filter (lambda (o)
                                             (let ((t (layout-slot lay o)))
                                               (and (tile-present? b o)
                                                    (= (slot-layer t) (slot-layer s))
                                                    (= (slot-hy t) (+ (slot-hy s) 2))
                                                    (<= (abs (- (slot-hx t) (slot-hx s))) 1))))
                                           ids))))
             (uncovered (filter (lambda (id)
                                  (let ((below (same-layer-below id)))
                                    (and (tile-present? after id)
                                         (pair? below)
                                         (every (lambda (o) (or (= o (car pair)) (= o (cdr pair)))) below))))
                                present)))
        (assert-false (tile-present? after (car pair)))
        (for-each (lambda (id)
                    (assert-false (side-free? b id 'down))
                    (assert-true (side-free? after id 'down)))
                  uncovered)))
    (test "a tile blocked on the right becomes free there when the pair to its right leaves"
      ;; the first solution pair is a legal match; some tile is blocked on
      ;; its right by one of the two: after the match it is free
      (let* ((pair (car (board-solution b)))
             (after (board-select (board-select b (car pair)) (cdr pair)))
             (flipped (filter (lambda (id)
                                (and (tile-present? after id)
                                     (not (side-free? b id 'right))
                                     (side-free? after id 'right)))
                              present)))
        (assert-false (tile-present? after (car pair)))
        (assert-true (pair? flipped))
        (for-each (lambda (id) (assert-true (side-free? after id 'right))) flipped)))))
