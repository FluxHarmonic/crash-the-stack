;;; Device-independent table behavior with hand-derived packet fixtures.

(import (sigil test)
        (crash cards deck)
        (crash stack rules)
        (crash trace)
        (crash checksum rules)
        (crash checksum table)
        (crash checksum trace)
        (only (substratic time clock) clock-new clock-steps))

(define (table-fixture ranks stock)
  (let ((packets (make-vector 28 (make-card 0 2))))
    (for-each (lambda (edit)
                (vector-set! packets (car edit) (make-card 0 (cdr edit))))
              ranks)
    (checksum-table trace: (trace-new 'clean) clock: (clock-new)
                    board: (checksum-board packets
                                           (map (lambda (rank) (make-card 1 rank)) stock)))))

(define (table-key t key now)
  (checksum-step t (make-checksum-frame (list key) '() now)))

(define (table-tap t place now)
  (let ((r (checksum-place-rect place (checksum-table-dock t))))
    (checksum-step t
                   (make-checksum-frame '()
                                        (list (list 'down (+ (car r) 28) (+ (cadr r) 38) 0))
                                        now))))

(test-group "checksum: table controls"
  (test "archive preparation holds clocks and play input; Escape still requests JACK OUT"
    (let* ((opened (checksum-open 1 'twist))
           (held (checksum-step opened (make-checksum-frame '(p space) '((down 284 342 0)) 500)))
           (held (checksum-table-deal! held (lambda () #f)))
           (quit (table-key held 'escape 750)))
      (assert-true (checksum-table-dealing? held))
      (assert-false (checksum-table-board held))
      (assert-equal 0.0 (checksum-table-ms held))
      (assert-equal 0 (trace-ticks (checksum-table-trace held)))
      (assert-equal 0 (clock-steps (checksum-table-clock held)))
      (assert-equal 21 (checksum-table-cursor held))
      (assert-equal '(quit) (checksum-table-requests quit))))
  (test "both horizontal docks keep packet-sized targets below the base and real taps draw then select"
    (for-each
     (lambda (option)
       (let* ((dock (car option))
              (pull-x (cadr option))
              (waste-x (caddr option))
              (t (checksum-table (table-fixture '() '(5 8 3)) dock: dock))
              (pull (checksum-place-rect 'pull dock))
              (waste (checksum-place-rect 'waste dock))
              (one (checksum-step t (make-checksum-frame '() (list (list 'down pull-x 342 0)) 0)))
              (selected (checksum-step one (make-checksum-frame '() (list (list 'down waste-x 342 0)) 16))))
         (assert-equal (cadr pull) (cadr waste))
         (assert-true (>= (cadr pull) 300))
         (assert-true (>= (caddr pull) 56))
         (assert-true (>= (cadddr pull) 76))
         (assert-equal (cddr pull) (cddr waste))
         (assert-true (>= (car waste) (+ (car pull) (caddr pull) 8)))
         (assert-equal '(5) (map card-rank (cboard-waste (checksum-table-board one))))
         (assert-equal 'waste (cboard-selected (checksum-table-board selected)))))
     '((center 284 356) (right 468 540))))
  (test "tap-click pairs and ROOTs go through the same table selection"
    (let* ((t (table-fixture '((21 . 5) (22 . 8) (23 . 13)) '(3)))
           (one (table-tap t 21 0))
           (pair (table-tap one 22 16))
           (root (table-tap pair 23 32)))
      (assert-equal 21 (cboard-selected (checksum-table-board one)))
      (assert-equal 2 (checksum-count (checksum-table-board pair)))
      (assert-equal 3 (checksum-count (checksum-table-board root)))
      (assert-false (checksum-table-cursor-shown root))))
  (test "a tap in overlap hits the visible child, and covered packets cannot be selected"
    (let* ((t (table-fixture '((0 . 13)) '(3)))
           (b (checksum-table-board t)))
      ;; Row 5 packet 15 lies behind row 6 packet 21 here.
      (assert-equal 21 (checksum-hit b 140 230))
      (assert-equal 0 (checksum-count (checksum-table-board (table-tap t 0 0))))
      (assert-false (cboard-selected (checksum-table-board (table-tap t 0 0))))))
  (test "arrows plus Space and Enter perform a packet pair"
    (let* ((t (table-fixture '((21 . 5) (22 . 8)) '(3)))
           (one (table-key t 'space 0))
           (right (table-key one 'right 16))
           (after (table-key right 'return 32)))
      (assert-equal 22 (checksum-table-cursor right))
      (assert-true (checksum-table-cursor-shown right))
      (assert-equal 2 (checksum-count (checksum-table-board after)))))
  (test "PULL by key or tap permits a selected buffer-to-next-pull pair"
    (let* ((t (table-fixture '() '(5 8 3)))
           (one (table-key t 'p 0))
           (selected (table-tap one 'waste 16))
           (after (table-tap selected 'pull 32)))
      (assert-equal '(5) (map card-rank (cboard-waste (checksum-table-board one))))
      (assert-equal 'waste (cboard-selected (checksum-table-board selected)))
      (assert-equal '(3) (map card-rank (cboard-stock (checksum-table-board after))))
      (assert-equal '() (cboard-waste (checksum-table-board after)))))
  (test "U undoes a move; a no-op undo never charges the trace"
    (let* ((t (table-fixture '((21 . 13)) '(3)))
           (after (table-tap t 21 0))
           (undone (table-key after 'u 16))
           (hacker (checksum-open 1 'twist))
           (noop (table-key hacker 'u 0)))
      (assert-equal 0 (checksum-count (checksum-table-board undone)))
      (assert-equal 0 (trace-extra (checksum-table-trace noop)))))
  (test "pause clears selection, holds both clocks, and Escape resumes"
    (let* ((t (table-fixture '() '(3)))
           (selected (table-key t 'space 0))
           (paused (table-key selected 'escape 16))
           (held (checksum-step paused (make-checksum-frame '() '() 216)))
           (resumed (table-key held 'escape 232)))
      (assert-true (checksum-table-paused held))
      (assert-false (cboard-selected (checksum-table-board held)))
      (assert-equal (checksum-table-ms paused) (checksum-table-ms held))
      (assert-equal (trace-ticks (checksum-table-trace paused))
                    (trace-ticks (checksum-table-trace held)))
      (assert-equal 0 (clock-steps (checksum-table-clock held)))
      (assert-false (checksum-table-paused resumed)))))

(test-group "checksum: panels and trace"
  (test "a win defaults to NEW ARCHIVE and Return requests a fresh board"
    (let* ((t (table-fixture '() '(3)))
           (b (checksum-table-board t))
           (t (checksum-table t board: (cboard b pyramid: (board-extract (cboard-pyramid b)))))
           (over (checksum-step t (make-checksum-frame '() '() 0))))
      (assert-equal "NEW ARCHIVE" (cadar (checksum-panel-rows over)))
      (assert-equal '(new) (checksum-table-requests (table-key over 'return 250)))))
  (test "a loss defaults to RESTART and Return retries its seed"
    (let* ((t (table-fixture '() '()))
           (over (checksum-step t (make-checksum-frame '() '() 0)))
           (picked (table-key over 'return 250)))
      (assert-equal "RESTART" (cadar (checksum-panel-rows over)))
      (assert-equal '(retry) (checksum-table-requests picked))
      (assert-equal (checksum-table-seed t) (checksum-table-seed picked))))
  (test "clear freezes trace, keeps the panel fade clock running and offers retry/new/quit"
    (let* ((t (table-fixture '() '(3)))
           (b (checksum-table-board t))
           (empty (checksum-table t
                                  board: (cboard b pyramid: (board-extract (cboard-pyramid b)))))
           (over (checksum-step empty (make-checksum-frame '() '() 0)))
           (faded (checksum-step over (make-checksum-frame '() '() 250))))
      (assert-equal 'cleared (checksum-table-outcome over))
      (assert-equal "SEAL BROKEN" (checksum-panel-title over))
      (assert-equal '(new retry quit) (map car (checksum-panel-rows over)))
      (assert-equal 250.0 (- (checksum-table-ms faded) (checksum-table-panel-at faded)))
      (assert-equal (trace-ticks (checksum-table-trace over))
                    (trace-ticks (checksum-table-trace faded)))
      (assert-equal '(new) (checksum-table-requests (table-key faded 'return 266)))))
  (test "no legal removals at the final feed shows SEAL HOLDS"
    (let* ((t (table-fixture '() '()))
           (after (checksum-step t (make-checksum-frame '() '() 0))))
      (assert-equal 'stalled (checksum-table-outcome after))
      (assert-equal "SEAL HOLDS" (checksum-panel-title after))
      (assert-equal '(retry new quit) (map car (checksum-panel-rows after)))
      (assert-equal "RESTART" (cadar (checksum-panel-rows after)))
      (assert-equal '(retry) (checksum-table-requests (table-key after 'return 266)))))
  (test "HACKER runs the shared trace phases and severs; CLASSIC never severs"
    (let* ((t (checksum-table (table-fixture '() '(3)) mode: 'twist trace: (trace-new 'twist)))
           (t (checksum-table t trace: (trace-with-thresholds (checksum-table-trace t) 1 1)))
           (t (checksum-step t (make-checksum-frame '() '() 0)))
           (after (let loop ((t t) (frame 1))
                    (if (> frame 22)
                        t
                        (loop (checksum-step t (make-checksum-frame '() '() (* frame 100)))
                              (+ frame 1)))))
           (clean (table-fixture '() '(3)))
           (clean (checksum-table clean
                                  trace: (trace-with-thresholds (checksum-table-trace clean) 0 0)))
           (clean (checksum-step clean (make-checksum-frame '() '() 0)))
           (clean (checksum-step clean (make-checksum-frame '() '() 100))))
      (assert-equal 'severed (checksum-table-outcome after))
      (assert-equal "LINK SEVERED" (checksum-panel-title after))
      (assert-false (checksum-table-outcome clean))))
  (test "HACKER rollback uses the shared pass charge"
    (let* ((t (table-fixture '() '(5)))
           (t (checksum-table t mode: 'twist trace: (trace-new 'twist)))
           (one (table-key t 'p 0))
           (two (table-key one 'p 0)))
      (assert-equal 2 (cboard-passes (checksum-table-board two)))
      (assert-equal 30 (trace-extra (checksum-table-trace two)))))
  (test "existing LOCK and SCRAMBLE members only; arithmetic lock leaves a disjoint move"
    (let* ((t (table-fixture '((21 . 5) (22 . 8) (23 . 4) (24 . 9)) '()))
           (b (checksum-table-board t))
           (locked ((ice-member-apply (car CHECKSUM-ICE-SET)) b 0)))
      (assert-equal '(lock scramble) (map ice-member-name CHECKSUM-ICE-SET))
      (assert-equal 2 (length (board-locked-slots (cboard-pyramid locked))))
      (assert-true (pair? (checksum-moves locked)))
      (assert-false (checksum-lost? locked))
      (let ((id (car (board-locked-slots (cboard-pyramid locked)))))
        (assert-false (checksum-lock-weak? locked id 0))
        (assert-true (checksum-lock-weak? locked id 2700))
        (assert-equal '() (board-locked-slots
                          (cboard-pyramid (checksum-break-lock locked id 2700)))))))
  (test "shared SCRAMBLE preserves packets; selecting a marked face clears its glitch"
    (let* ((t (table-fixture '() '(3)))
           (b (checksum-table-board t))
           (scrambled ((ice-member-apply (cadr CHECKSUM-ICE-SET)) b 0))
           (ids (board-scrambled-slots (cboard-pyramid scrambled)))
           (selected (checksum-select scrambled (car ids))))
      (assert-equal 6 (length ids))
      (assert-equal (board-faces (cboard-pyramid b)) (board-faces (cboard-pyramid scrambled)))
      (assert-false (tile-scrambled? (cboard-pyramid selected) (car ids)))))
  (test "ICE cuts undo history; temporary locks cannot cause an immediate loss"
    (let* ((t (table-fixture '((21 . 5) (22 . 8) (23 . 4) (24 . 9)) '(3)))
           (b (checksum-pull (checksum-table-board t)))
           (fired (car (fire-checksum-ice b 0)))
           (bad (checksum-table-board (table-fixture '() '())))
           (locked (cboard bad pyramid: (board-lock-pair (cboard-pyramid bad) 21 22 0))))
      (assert-true (pair? (cboard-history b)))
      (assert-equal '() (cboard-history fired))
      (assert-false (checksum-lost? locked))
      (assert-true (checksum-lock-weak? locked 21 0)))))
