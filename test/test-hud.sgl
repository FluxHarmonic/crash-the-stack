;;; Gate (P3, S8) - the tool stack and the bar's layouts (ruling D33).
;;;
;;; The widget alone first: where the button and the entries sit (the
;;; column stands on the button, never reaches the meter's row, and a
;;; touch screen gets taller entries), how it opens, what chooses, what
;;; closes, that a disabled tool refuses, and that the slide's timing is
;;; the note's (8 ticks, 2 of stagger from the bottom up).
;;;
;;; Then the tables: each tag fires the tool the note names and nothing
;;; else (sabotage S8, ruled: a tag firing the wrong tool, H made to
;;; shuffle, reddens "H is HINT"); a digit fires the n-th; while the
;;; stack is open a tag letter never reaches the board (the hint model's
;;; tile tags share the alphabet); under SEVERED only NEXT and MENU
;;; fire; MENU comes out as a request the shell reads; and the layout
;;; setting steps and round-trips.

(import (sigil test)
        (sigil struct)
        (sigil list)
        (sigil math)
        (crash hud)
        (crash stack layout)
        (crash stack rules)
        (crash stack turtle)
        (crash geometry)
        (crash input)
        (crash trace)
        (crash cards deck)
        (crash cards rules)
        (crash cards geometry)
        (crash cards input)
        (crash render)
        (crash cards render))

(define VW 640)
(define VH 400)

(define LIST
  (list (make-tool 'undo "UNDO" 'u)
        (make-tool 'shuf "SHUFFLE" 's 60)
        (make-tool 'hint "HINT" 'h 30)
        (make-tool 'next "NEXT" 'n)
        (make-tool 'jam "JAM" 'j #f #f #f)))

(define (frame keys . rest)
  (cons keys (and (pair? rest) (car rest))))

(define (open-stack)
  (car (tools-step (tools-new) (frame '(space)) LIST VW VH)))

(test-group "hud: the widget's geometry"
  (test "the button is 24x24 at the bar's left end, 28 above the bottom"
    (assert-equal (list 4 (- VH 28) 24 24) (tool-button-rect VH)))
  (test "the column stands on the button: the last entry ends a gap above it, the first is highest"
    (let ((rects (tool-entry-rects VH 5 #f)))
      (assert-equal 5 (length rects))
      (assert-equal (- VH 28 4) (+ (cadr (list-ref rects 4)) (cadddr (list-ref rects 4))))
      (assert-true (< (cadr (car rects)) (cadr (list-ref rects 4))))
      (assert-true (every (lambda (r) (and (= (car r) 4) (= (caddr r) ENTRY-W) (= (cadddr r) 24))) rects))))
  (test "entries are 4 apart and never overlap"
    (let loop ((rects (tool-entry-rects VH 6 #f)))
      (when (pair? (cdr rects))
        (assert-equal (+ (cadr (car rects)) (cadddr (car rects)) 4) (cadr (cadr rects)))
        (loop (cdr rects)))))
  (test "a touch screen gets 32-tall entries"
    (assert-equal 32 (cadddr (tool-entry-rect VH 0 3 #t))))
  (test "six entries with the touch height still start below the top of the board"
    (assert-true (> (cadr (tool-entry-rect VH 0 6 #t)) 40)))
  (test "the column never covers the meter (the bar's middle) even at full height"
    (let ((col (tool-column-rect VH 8 #t)))
      (assert-true (< (+ (car col) (caddr col)) (- (half VW) 100)))))
  (test "hit-tool-entry names the entry under a point and nothing beside the column"
    (let ((r (tool-entry-rect VH 2 5 #f)))
      (assert-equal 2 (hit-tool-entry VH 5 #f (+ (car r) 3) (+ (cadr r) 3)))
      (assert-equal #f (hit-tool-entry VH 5 #f 300 (+ (cadr r) 3)))))
  (test "the slide: the bottom entry runs 0..1 over 8 ticks, the one above starts 2 later"
    (assert-equal 0.0 (entry-progress 0 4 5))
    (assert-equal 1.0 (entry-progress 8 4 5))
    (assert-equal 0.5 (entry-progress 4 4 5))
    (assert-equal 0.0 (entry-progress 2 3 5))
    (assert-equal 1.0 (entry-progress 10 3 5))
    (assert-equal 1.0 (entry-progress 16 0 5))))

(test-group "hud: opening, choosing, closing"
  (test "closed, an ordinary key passes and nothing opens"
    (let ((r (tools-step (tools-new) (frame '(h)) LIST VW VH)))
      (assert-false (tools-open? (car r)))
      (assert-equal #f (cdr r))))
  (test "Space opens; a tap on the button opens"
    (assert-true (tools-open? (open-stack)))
    (assert-true (tools-open? (car (tools-step (tools-new) (frame '() (cons 10 (- VH 20))) LIST VW VH)))))
  (test "open, a tag chooses its tool and the stack closes with the button lit"
    (let ((r (tools-step (open-stack) (frame '(h)) LIST VW VH)))
      (assert-equal 'hint (cdr r))
      (assert-false (tools-open? (car r)))
      (assert-equal FLASH-TICKS (tools-flash (car r)))))
  (test "open, a digit chooses the n-th tool in order"
    (assert-equal 'undo (cdr (tools-step (open-stack) (frame '(|1|)) LIST VW VH)))
    (assert-equal 'next (cdr (tools-step (open-stack) (frame '(|4|)) LIST VW VH)))
    (assert-equal #f (cdr (tools-step (open-stack) (frame '(|9|)) LIST VW VH))))
  (test "open, nothing is highlighted: Return alone fires nothing (a finger expecting deselect must not undo)"
    (let ((r (tools-step (open-stack) (frame '(return)) LIST VW VH)))
      (assert-equal #f (tools-highlight (open-stack)))
      (assert-equal #f (cdr r))
      (assert-true (tools-open? (car r)))))
  (test "open, arrows move the highlight (down from nothing is the first, up the last) and Return chooses it"
    (let* ((st (car (tools-step (open-stack) (frame '(down)) LIST VW VH)))
           (st (car (tools-step st (frame '(down)) LIST VW VH)))
           (st (car (tools-step st (frame '(down)) LIST VW VH))))
      (assert-equal 2 (tools-highlight st))
      (assert-equal 'hint (cdr (tools-step st (frame '(return)) LIST VW VH)))
      (assert-equal 4 (tools-highlight (car (tools-step (open-stack) (frame '(up)) LIST VW VH))))))
  (test "open, a tap on an entry chooses it"
    (let ((r (tool-entry-rect VH 1 5 #f)))
      (assert-equal 'shuf (cdr (tools-step (open-stack) (frame '() (cons (+ (car r) 5) (+ (cadr r) 5))) LIST VW VH)))))
  (test "open, Space, Escape, a tap on the button or outside the column close without a choice"
    (for-each (lambda (f)
                (let ((r (tools-step (open-stack) f LIST VW VH)))
                  (assert-false (tools-open? (car r)))
                  (assert-equal #f (cdr r))))
              (list (frame '(space))
                    (frame '(escape))
                    (frame '() (cons 10 (- VH 20)))
                    (frame '() (cons 400 200)))))
  (test "a disabled tool refuses: the stack stays open, the entry becomes the highlight"
    (let ((r (tools-step (open-stack) (frame '(j)) LIST VW VH)))
      (assert-true (tools-open? (car r)))
      (assert-equal #f (cdr r))
      (assert-equal 4 (tools-highlight (car r)))))
  (test "open, a key that names no tool changes nothing and reaches nobody"
    (let ((r (tools-step (open-stack) (frame '(x)) LIST VW VH)))
      (assert-true (tools-open? (car r)))
      (assert-equal #f (cdr r))))
  (test "the clock: the age grows, the flash fades"
    (let ((st (tools-advance (car (tools-step (open-stack) (frame '(u)) LIST VW VH)) 10)))
      (assert-equal (- FLASH-TICKS 10) (tools-flash st)))
    (assert-equal 5 (tools-open (tools-advance (open-stack) 5)))))

(test-group "hud: the layout"
  (test "one layout, zones (A; B left with its setting, D51 2026-09-21), stepping stays on it"
    (assert-equal '(zones) HUD-LAYOUTS)
    (assert-equal 'zones DEFAULT-LAYOUT)
    (assert-equal 'zones (layout-after 'zones))
    (assert-true (layout-name? 'zones))
    (assert-false (layout-name? 'strip))
    (assert-false (layout-name? 'c))))

;; --- the stack table -------------------------------------------------------------

(define (stack-session)
  (session-new (turtle-layout) 1))

(define (geom) (make-geometry (turtle-layout) VW VH))

(define (step s keys . rest)
  (session-step s (make-input-frame keys '() (and (pair? rest) (car rest))) (geom)))

(test-group "hud: the stack table's tools"
  (test "the list is the note's less MENU (David, 2026-09-19) and less LOOK (the polish row): UNDO U, SHUFFLE S (60), HINT H (30), NEXT N"
    (let ((tools (session-tools-list (stack-session))))
      (assert-equal '(undo shuf hint next) (map tool-name tools))
      (assert-equal '(u s h n) (map tool-tag tools))
      (assert-equal (list #f 60 30 #f) (map tool-price tools))))
  (test "Space opens the stack; a tag letter then never reaches a tile"
    (let* ((s0 (stack-session))
           (s1 (step s0 '(space))))
      (assert-true (tools-open? (session-tools s1)))
      ;; every hint tag starts with a letter; the first tile's tag is 'a' something
      (let ((s2 (step s1 '(a))))
        (assert-true (tools-open? (session-tools s2)))
        (assert-equal (board-selected (session-board s0)) (board-selected (session-board s2)))
        (assert-equal "" (session-typed s2)))))
  (test "H is HINT: the pair hint rings a tile and charges the trace"
    (let* ((s1 (step (stack-session) '(space)))
           (s2 (step s1 '(h))))
      (assert-false (tools-open? (session-tools s2)))
      (assert-true (and (session-hint s2) #t))
      (assert-equal 1 (session-hints s2))
      (assert-equal (board-faces (session-board s1)) (board-faces (session-board s2)))))
  (test "S is SHUFFLE: the faces move and the trace is charged, no hint"
    (let* ((s1 (step (stack-session) '(space)))
           (s2 (step s1 '(s))))
      (assert-false (equal? (board-faces (session-board s1)) (board-faces (session-board s2))))
      (assert-equal 0 (session-hints s2))
      (assert-equal 1 (trace-shuffles (session-trace s2)))))
  (test "the digits fire in order: 3 is HINT"
    (assert-equal 1 (session-hints (step (step (stack-session) '(space)) '(|3|)))))
  (test "N is NEXT: the seed advances"
    (assert-equal 2 (session-seed (step (step (stack-session) '(space)) '(n)))))
  (test "L is nothing now: the look does not step and the stack stays open"
    (let* ((s (stack-session))
           (after (step (step s '(space)) '(l))))
      (assert-equal (session-look s) (session-look after))
      (assert-true (tools-open? (session-tools after)))))
  (test "Escape is MENU (David, 2026-09-19): the session carries the request for the shell, which clears it; M is nothing"
    (let ((s (step (stack-session) '(escape))))
      (assert-equal 'menu (session-request s))
      (assert-equal #f (session-request (session-clear-request s))))
    (assert-equal #f (session-request (step (step (stack-session) '(space)) '(m))))
    (assert-true (tools-open? (session-tools (step (step (stack-session) '(space)) '(m))))))
  (test "the bar's MENU button beside the wrench asks for the menu too"
    (let* ((r (control-rect (geom) 'zones 'menu))
           (s (step (stack-session) '() (cons (+ (car r) 12) (+ (cadr r) 12)))))
      (assert-equal (list 32 (- VH 28) 24 24) r)
      (assert-equal 'menu (session-request s))))
  (test "the ? button is the wrench's peer at the bar's right end (the polish row): a square, toggling the keys line"
    (let* ((r (control-rect (geom) 'zones 'keys))
           (s (step (stack-session) '() (cons (+ (car r) 12) (+ (cadr r) 12)))))
      (assert-equal (list (- VW 28) (- VH 28) 24 24) r)
      (assert-true (session-keys-shown s))
      (assert-false (session-keys-shown (step s '() (cons (+ (car r) 12) (+ (cadr r) 12)))))))
  (test "the controls are the three buttons; the meter and the readout are not tapped"
    (assert-equal '(keys tool menu) (map car (geometry-controls (geom) 'zones)))
    (for-each (lambda (layout)
                (let ((m (meter-rect (geom) layout))
                      (r (readout-rect (geom) layout)))
                  (assert-false (hit-control (geom) layout (+ (car m) 10) (+ (cadr m) 3)))
                  (assert-false (hit-control (geom) layout (+ (car r) 4) (+ (cadr r) 4)))))
              HUD-LAYOUTS))
  (test "the meter's box grew by the padding: 18 tall (David's phone read, 2026-09-20)"
    (assert-equal METER-H (cadddr (meter-rect (geom) 'zones)))
    (assert-equal 18 METER-H))
  (test "Escape with the stack open closes it and asks for nothing"
    (let ((s (step (step (stack-session) '(space)) '(escape))))
      (assert-false (tools-open? (session-tools s)))
      (assert-equal #f (session-request s))))
  (test "Tab toggles the tags now; shift+Tab switches the model"
    (let* ((s0 (stack-session))
           (s1 (step s0 '(tab))))
      (assert-equal (not (session-labels-shown s0)) (session-labels-shown s1))
      (assert-equal (session-model s0) (session-model s1))
      (assert-equal 'cursor (session-model (session-step s0 (make-input-frame '(tab) '(shift) #f) (geom))))))
  (test "? toggles the keys line"
    (let ((s0 (stack-session)))
      (assert-false (session-keys-shown s0))
      (assert-true (session-keys-shown (step s0 '(?))))))
  (test "the ctrl chords still fire directly with the stack closed"
    (assert-equal 1 (session-hints (session-step (session-step (stack-session) (make-input-frame '(h) '(ctrl) #f) (geom))
                                                 (make-input-frame '(h) '(ctrl) #f)
                                                 (geom)))))
  (test "under SEVERED every tool but NEXT is disabled"
    (let* ((s (session-advance (session-advance (stack-session) (* 60 (+ 1 SEVER-AT))) (* 60 (+ 1 SEVER-AT))))
           (tools (session-tools-list s)))
      (assert-true (trace-severed? (session-trace s)))
      (assert-equal '(#f #f #f #t) (map tool-enabled tools))
      (let ((s2 (step (step s '(space)) '(h))))
        (assert-true (tools-open? (session-tools s2)))
        (assert-equal 0 (session-hints s2)))))
  (test "the session carries the layout name: zones"
    (let ((s (stack-session)))
      (assert-equal 'zones (session-hud s))
      (assert-equal 'zones (session-hud (session-with-hud s 'zones)))))
  ;; the S8 review: the meter once shadowed the readout, and the bar's
  ;; rewrite of a tap ran before the stack saw it, so a tap on the bar
  ;; with the stack open fired nothing and closed nothing
  (test "the readout's rect is clear of the meter's, and a tap on either changes nothing"
    (let* ((s (stack-session))
           (r (readout-rect (geom) 'zones))
           (m (meter-rect (geom) 'zones))
           (center (cons (+ (car r) (quotient (caddr r) 2)) (+ (cadr r) (quotient (cadddr r) 2)))))
      (assert-true (<= (+ (car m) (caddr m)) (car r)))
      (let ((after (step s '() center)))
        (assert-equal (session-look s) (session-look after))
        (assert-equal (trace-mode (session-trace s)) (trace-mode (session-trace after)))
        (assert-equal (session-board s) (session-board after)))))
  (test "ctrl+m and a tap on the meter no longer flip the trace's face (ruling D19; the polish row)"
    (for-each (lambda (layout)
                (let* ((s (session-with-hud (stack-session) layout))
                       (m (meter-rect (geom) layout))
                       (by-key (session-step s (make-input-frame '(m) '(ctrl) #f) (geom)))
                       (by-tap (step s '() (cons (+ (car m) 10) (+ (cadr m) 3)))))
                  (assert-equal 'twist (trace-mode (session-trace by-key)))
                  (assert-equal 'twist (trace-mode (session-trace by-tap)))
                  (assert-equal (session-message s) (session-message by-key))
                  (assert-equal (session-board s) (session-board by-tap))))
              HUD-LAYOUTS))
  (test "both layouts: with the stack open a tap on every entry fires it, and a tap on the bar closes the stack"
    (for-each (lambda (layout)
                (let* ((s (session-with-hud (stack-session) layout))
                       (tools (session-tools-list s))
                       (n (length tools)))
                  (let loop ((i 0))
                    (when (< i n)
                      (let* ((r (tool-entry-rect VH i n #f))
                             (open (step s '(space)))
                             (after (step open '() (cons (+ (car r) 4) (+ (cadr r) (- (cadddr r) 2))))))
                        (assert-false (tools-open? (session-tools after)))
                        (when (eq? (tool-name (list-ref tools i)) 'next)
                          (assert-equal 2 (session-seed after))))
                      (loop (+ i 1))))
                  (let* ((m (meter-rect (geom) layout))
                         (open (step s '(space)))
                         (after (step open '() (cons (+ (car m) 10) (+ (cadr m) 3)))))
                    (assert-false (tools-open? (session-tools after)))
                    (assert-equal (trace-mode (session-trace s)) (trace-mode (session-trace after))))))
              HUD-LAYOUTS)))

;; --- the card table -------------------------------------------------------------

(define (card-deal)
  (deal-restore 1 (game-from-deck (deck-string->cards FIXTURE-DECK) 1) #t (trace-new 'twist)))

(define (cgeom) (make-card-geometry VW VH))

(define (cstep d keys . rest)
  (deal-step d (make-input-frame keys '() (and (pair? rest) (car rest))) (cgeom)))

(test-group "hud: the card table's tools"
  (test "the list is the note's less MENU: PULL P, ROLLBACK R, PROBE O, SCRAMBLE C, NEXT N"
    (let ((tools (deal-tools-list (card-deal))))
      (assert-equal '(draw undo probe scram next) (map tool-name tools))
      (assert-equal '(p r o c n) (map tool-tag tools))))
  (test "in clean mode SCRAMBLE and PROBE are absent, not disabled"
    (assert-equal '(draw undo next) (map tool-name (deal-tools-list (deal-with-mode (card-deal) 'clean)))))
  (test "Space opens; a pile key then never picks a pile"
    (let* ((d1 (cstep (card-deal) '(space)))
           (d2 (cstep d1 '(a))))
      (assert-true (tools-open? (deal-tools d2)))
      (assert-equal (game-selected (deal-game d1)) (game-selected (deal-game d2)))))
  (test "P is PULL: the draw count flips"
    (let ((d (card-deal)))
      (assert-equal 3 (game-draw (deal-game (cstep (cstep d '(space)) '(p)))))))
  (test "R is ROLLBACK: a move comes back"
    (let* ((d (card-deal))
           (moves (legal-moves (deal-game d)))
           (moved (deal-restore 1 (game-move (deal-game d) (car (car moves)) (cdr (car moves))) #t (deal-trace d))))
      (assert-equal (game-moves (deal-game d))
                    (game-moves (deal-game (cstep (cstep moved '(space)) '(r)))))))
  (test "Escape and the bar's MENU button are the menu on this table too"
    (assert-equal 'menu (deal-request (cstep (card-deal) '(escape))))
    (let ((r (card-control-rect (cgeom) 'zones 'menu)))
      (assert-equal 'menu (deal-request (cstep (card-deal) '() (cons (+ (car r) 12) (+ (cadr r) 12)))))))
  (test "? toggles the keys line on this table too"
    (assert-true (deal-keys-shown (cstep (card-deal) '(?))))))

;; --- the prompt follows the last input device (David's laptop read, 2026-09-20) --

(test-group "hud: the prompt follows the last input device"
  (test "the stack: a key makes it the keyboard's line, a click the tap line; touch opens on touch"
    (let* ((s (stack-session))
           (by-key (step s '(shift)))
           (by-click (step by-key '() (cons 1 1))))
      (assert-equal 'mouse (session-device s))
      (assert-equal "TAP TWO MATCHING TILES." (session-instruction s))
      (assert-equal 'keyboard (session-device by-key))
      (assert-equal "PRESS THE LETTERS OF TWO MATCHING TILES." (session-instruction by-key))
      (assert-equal 'mouse (session-device by-click))
      (assert-equal "TAP TWO MATCHING TILES." (session-instruction by-click))
      (assert-equal 'touch (session-device (session-with-tools-touch s #t)))
      (assert-equal 'touch (session-device (step (session-with-tools-touch s #t) '() (cons 1 1))))
      (assert-equal 'keyboard (frame-device (make-input-frame '(a) '() #f) #t))
      (assert-false (frame-device (make-input-frame '() '() #f) #t))))
  (test "the card table: F PULLS for the keyboard, the feed's tap otherwise"
    (let* ((d (card-deal))
           (by-key (cstep d '(shift)))
           (by-click (cstep by-key '() (cons 1 1))))
      (assert-equal "STACK THE PACKETS BY CLASS. TAP THE FEED TO PULL." (deal-instruction d))
      (assert-equal "STACK THE PACKETS BY CLASS. F PULLS." (deal-instruction by-key))
      (assert-equal 'keyboard (deal-device by-key))
      (assert-equal 'mouse (deal-device by-click))
      (assert-equal "STACK THE PACKETS BY CLASS. TAP THE FEED TO PULL." (deal-instruction by-click)))))

;; --- the phase line never repeats a time the bar carries (David, 2026-09-20) --

;; Does the string hold a clock, a digit before a colon before a digit?
(define (has-clock? text)
  (let loop ((i 1))
    (cond ((>= (+ i 1) (string-length text)) #f)
          ((and (char=? (string-ref text i) #\:)
                (char-numeric? (string-ref text (- i 1)))
                (char-numeric? (string-ref text (+ i 1))))
           #t)
          (else (loop (+ i 1))))))

(test-group "hud: the phase lines carry no clock (the meter has LINK, the readout ICE IN)"
  (test "the stack, under the ICE and severed, with and without locks"
    (let* ((traced (session-advance (stack-session) (* 60 (+ 1 TRACE-AT))))
           (tr (session-trace traced))
           (severed (session-advance traced (* 60 (+ 1 SEVER-AT)))))
      (assert-equal 'counter (trace-phase tr))
      (assert-true (has-clock? (trace-ice-string tr)))          ; the readout does show one
      (assert-false (has-clock? (phase-line tr (session-board traced))))
      (assert-true (and (phase-line tr (session-board traced)) #t))
      (assert-equal 'severed (trace-phase (session-trace severed)))
      (assert-false (has-clock? (phase-line (session-trace severed) (session-board severed))))
      (assert-true (has-clock? "TRACED. ICE IN 0:16."))))     ; the detector can fire
  (test "the card table, under the ICE and severed"
    (let* ((d (card-deal))
           (traced (deal-advance d (* 60 (+ 1 TRACE-AT))))
           (tr (deal-trace traced)))
      (assert-equal 'counter (trace-phase tr))
      (assert-false (has-clock? (card-phase-line tr (deal-game traced))))
      (assert-true (and (card-phase-line tr (deal-game traced)) #t))
      (let ((severed (deal-advance traced (* 60 (+ 1 SEVER-AT)))))
        (assert-equal 'severed (trace-phase (deal-trace severed)))
        (assert-false (has-clock? (card-phase-line (deal-trace severed) (deal-game severed))))))))
