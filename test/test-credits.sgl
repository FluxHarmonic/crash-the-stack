;;; Gate leg 5 (P4): the AI content disclosure in the credits matches the
;;; approved text byte for byte (the fixture is the design note's adapted
;;; in-game text; P4b holds the site and the repo to the same file), the
;;; notices are all there, every character of every page has a glyph in
;;; the 5x7 font, and the wrap never exceeds its width.

(import (sigil test)
        (sigil fs)
        (sigil string)
        (crash credits)
        (crash font))

(define FIXTURE "test/fixtures/disclosure.txt")

;; does text contain part?
(define (string-contains text part)
  (let ((n (string-length text)) (m (string-length part)))
    (let loop ((i 0))
      (cond ((> (+ i m) n) #f)
            ((string=? (substring text i (+ i m)) part) #t)
            (else (loop (+ i 1)))))))

(define (has-glyph? c)
  (or (char=? c #\space) (and (glyph-rows-of c) #t)))

(define (page-text n)
  (apply string-append (map (lambda (e) (if (pair? (cdr e)) (cadr e) "")) (credits-page n))))

(test-group "credits: the disclosure"
  (test "DISCLOSURE is the fixture byte for byte"
    (let ((fixture (read-file-string FIXTURE)))
      (assert-equal (string-length fixture) (string-length DISCLOSURE))
      (assert-true (string=? fixture DISCLOSURE))))
  (test "the four beats are in it: the disclosure, the provenance, the review, the out"
    (assert-true (string-contains DISCLOSURE "AI agents write most of the code"))
    (assert-true (string-contains DISCLOSURE "I review all of it"))
    (assert-true (string-contains DISCLOSURE "the opinions are mine"))
    (assert-true (string-contains DISCLOSURE "I understand!")))
  (test "the ABOUT page carries it whole, and the version line ends the page"
    (assert-true (string-contains (page-text 1) DISCLOSURE))
    (let ((lines (credits-lines 1 50 "abc123")))
      (assert-equal (cons 'line "VERSION 0.1.0 (abc123)") (car (reverse lines)))
      (assert-true (string-contains (apply string-append (map (lambda (l) (string-append (cdr l) " ")) lines)) "I understand! The source")))))

(test-group "credits: the notices (D44)"
  (test "GPL-3.0-or-later, CC-BY-4.0, the reserved marks, the copyright line, the libraries"
    (let ((text (page-text 0)))
      (assert-true (string-contains text "GPL-3.0-or-later"))
      (assert-true (string-contains text "CC-BY-4.0"))
      (assert-true (string-contains text "Reserved"))
      (assert-true (string-contains text "the name Crash The Stack, the logo, the title art and the Flux Harmonic mark"))
      (assert-true (string-contains text "(C) 2026 DAVID WILSON - FLUX HARMONIC"))
      (for-each (lambda (lib) (assert-true (string-contains text lib)))
                '("SIGIL" "SOKOL" "GLFW" "MINIAUDIO" "STB"))))
  (test "every character of both pages has a glyph (the font gained ' , ; ! for this screen)"
    (for-each (lambda (n)
                (for-each (lambda (c) (assert-true (has-glyph? c))) (string->list (page-text n))))
              '(0 1))))

(test-group "credits: the wrap"
  (test "no wrapped line exceeds the width, words are kept whole, nothing is lost"
    (for-each (lambda (width)
                (let ((lines (wrap-text DISCLOSURE width)))
                  (for-each (lambda (l) (assert-true (<= (string-length l) width))) lines)
                  (assert-true (string=? DISCLOSURE (join-lines lines)))))
              '(30 50 100)))
  (test "a word longer than the width stands alone"
    (assert-equal '("abcdefghij" "k") (wrap-text "abcdefghij k" 5)))
  (test "both pages fit the screen at 50 characters: at most 19 rows each (the screen has 20 at scale 2)"
    (for-each (lambda (n) (assert-true (<= (length (credits-lines n 50 "0123456789ab")) 19)))
              '(0 1)))
  (test "the detector: a width of 20 needs more rows than 50"
    (assert-true (> (length (credits-lines 1 20 "x")) (length (credits-lines 1 50 "x"))))))

(define (join-lines lines)
  (let loop ((ls lines) (acc ""))
    (cond ((null? ls) acc)
          ((string=? acc "") (loop (cdr ls) (car ls)))
          (else (loop (cdr ls) (string-append acc " " (car ls)))))))
