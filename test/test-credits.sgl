;;; The credits crawl (D44 as amended 2026-09-21): assets/credits.txt
;;; parses into headings, lines and gaps in the file's order; the eight
;;; sections are there with the notices (GPL-3.0-or-later, CC-BY-4.0,
;;; the reserved marks, the copyright line, the libraries); every heading
;;; is in the block alphabet's characters and every line's character has
;;; a glyph in the 5x7; the layout places the rows in order and the
;;; height is their sum; the gaps count their words.

(import (sigil test)
        (sigil fs)
        (crash credits)
        (crash font)
        (crash title alphabet))

(define TEXT (read-file-string CREDITS-PATH))
(define ITEMS (credits-parse TEXT))

(define (has-glyph? c)
  (or (char=? c #\space) (and (glyph-rows-of c) #t)))

(define (block-char? c)
  (or (char=? c #\space)
      (let loop ((i 0))
        (cond ((= i (vector-length ALPHABET)) #f)
              ((string=? (car (vector-ref ALPHABET i)) (string c)) #t)
              (else (loop (+ i 1)))))))

(define (has-line? text)
  (and (member text (credits-lines-of ITEMS)) #t))

(test-group "credits: the file"
  (test "the eight sections, in order"
    (assert-equal '("DESIGN AND DIRECTION" "CODE" "ART DIRECTION" "MUSIC AND SOUND" "SPECIAL THANKS" "MADE WITH" "LICENSES" "FIND IT")
                  (credits-headings ITEMS)))
  (test "the notices: GPL-3.0-or-later, CC-BY-4.0, the reserved marks, the copyright, the libraries"
    (assert-true (has-line? "CODE: GPL-3.0-OR-LATER"))
    (assert-true (has-line? "ART, AUDIO AND CONTENT: CC-BY-4.0"))
    (assert-true (has-line? "RESERVED: THE NAME CRASH THE STACK,"))
    (assert-true (has-line? "AND THE FLUX HARMONIC MARK"))
    (assert-true (has-line? "(C) 2026 DAVID WILSON"))
    (assert-true (has-line? "THIRD-PARTY NOTICES IN THE SOURCE"))
    (for-each (lambda (lib) (assert-true (has-line? lib)))
              '("SIGIL" "SOKOL" "GLFW" "MINIAUDIO" "STB" "MOTIF" "SOUNDPIPE")))
  (test "the disclosure is the CODE and ART DIRECTION sections: who wrote, who reviewed, what was generated"
    (assert-true (has-line? "WRITTEN BY CLAUDE OPUS AND FABLE"))
    (assert-true (has-line? "UNDER DAVID'S DIRECTION"))
    (assert-true (has-line? "REVIEWED, PLAYED AND CURATED"))
    (assert-true (has-line? "GENERATED BY GPT"))
    (assert-true (has-line? "SHAPED BY CLAUDE")))
  (test "the version line is the module's VERSION"
    (assert-true (has-line? (string-append "VERSION " VERSION))))
  (test "every heading is set in the block alphabet's characters; every line's character has a 5x7 glyph (# was added for #SYSTEMCRAFTERS)"
    (for-each (lambda (h) (for-each (lambda (c) (assert-true (block-char? c))) (string->list h)))
              (credits-headings ITEMS))
    (for-each (lambda (l) (for-each (lambda (c) (assert-true (has-glyph? c))) (string->list l)))
              (credits-lines-of ITEMS))
    (assert-true (has-line? "#SYSTEMCRAFTERS ON IRC")))
  (test "the file starts with its two-gap marker and ends with its three"
    (assert-equal '(gap 2) (car ITEMS))
    (assert-true (member '(gap 3) ITEMS))))

(test-group "credits: the parse and the layout"
  (test "headings, lines, gap markers, and a blank line is a blank row (runs kept)"
    (assert-equal '((gap 2) (gap 1) (heading "T") (line "A LINE") (gap 1) (gap 1) (gap 1) (line "B") (gap 3))
                  (credits-parse "[gap gap]\n\n## T\nA LINE\n[gap]\n\n\nB  \n[gap gap gap]")))
  (test "the layout places the rows in order at their heights; the height is the sum"
    (let* ((items (credits-parse "## T\nA\n[gap gap]\nB\n"))
           (rows (credits-layout items)))
      (assert-equal (list (list 'heading "T" 0)
                          (list 'line "A" HEADING-H)
                          (list 'line "B" (+ HEADING-H LINE-H (* 2 GAP-H))))
                    rows)
      (assert-equal (+ HEADING-H LINE-H (* 2 GAP-H) LINE-H) (credits-height items))))
  (test "the real file's rows climb, and its height is over a screen (it scrolls)"
    (let loop ((rows (credits-layout ITEMS)) (last -1))
      (unless (null? rows)
        (assert-true (> (caddr (car rows)) last))
        (loop (cdr rows) (caddr (car rows)))))
    (assert-true (> (credits-height ITEMS) 400)))
  (test "the pace: 20 px a second forward, faster with Down, backwards with Up"
    (assert-equal 20.0 CRAWL-SPEED)
    (assert-true (> CRAWL-FAST CRAWL-SPEED))
    (assert-true (< CRAWL-BACK 0.0))))
