;;; Gate: the font can draw every string the game draws.
;;;
;;; draw-glyph answers a blank for a character it has no entry for, and a
;;; blank is silent -- the text just has a hole in it, and nobody notices
;;; until someone looks at that screen. It nearly happened twice in one
;;; day: the Gibson's toast was ruled to use "* " when the font had no
;;; asterisk, and the update readout was specified with the characters
;;; U+25B8 and U+00B7, neither of which existed. Both would have shipped
;;; as gaps.
;;;
;;; So: every string below is one the game can put on screen, and every
;;; character in it must have a glyph. A failure names the string and the
;;; character, because "some text is missing" is not a bug report.
;;;
;;; The list is curated rather than scraped, and that is a real weakness --
;;; a string added elsewhere is not covered until someone adds it here. It
;;; is still worth having: it covers the constants that carry the game's
;;; fixed vocabulary, which is where a missing glyph has historically come
;;; from. Add a line when you add a drawable constant.

(import (sigil test)
        (sigil list)
        (sigil string)
        (crash font))

;; Every string the game can draw, with a name for the failure message.
(define DRAWABLE
  (list
   (cons "the title's copyright line" "(C) 2026 DAVID WILSON - FLUX HARMONIC")
   (cons "the publisher card" "PRESENTS")
   (cons "STACK's keys line" "TAGS: TYPE ONE  TAB HIDE  ENTER DESELECT  SHIFT+TAB CURSOR  BKSP UNDO  SPACE TOOLS  ^S ^H ^N")
   (cons "STACK's cursor keys line" "CURSOR: ARROWS MOVE  ENTER PICK  SHIFT+TAB TAGS  BKSP UNDO  SPACE TOOLS  ^S ^H ^N")
   (cons "DEFRAG's tags line" "TAGS: TYPE ONE  F PULL  J BUFFER  TAB HIDE  ENTER CLEAR  SPACE TOOLS  ? KEYS")
   (cons "DEFRAG's tags-hidden line" "TAGS HIDDEN: TAB SHOWS THEM  F PULL  J BUFFER  SPACE TOOLS")
   (cons "DEFRAG's jammed line" "STACK JAMMED: NO MOVE HELPS. ROLLBACK, SCRAMBLE OR DUMP")
   (cons "the severed readout" "SEVERED")
   (cons "the bounty readout" "BOUNTY")
   (cons "the audit readout" "AUDIT")
   ;; the hub's toasts, prefixes included: "! " is ICE, "# " is the Gibson
   (cons "the ICE pulse toast" "! ICE PULSE. TRACE SPIKED.")
   (cons "the severed-link toast" "! LINK SEVERED.")
   (cons "the Gibson's toast" "# Gibson noticed you.")
   (cons "the reconnected toast" "RECONNECTED. THE LAYER HAS CHANGED.")
   (cons "the seen toast" "! SEEN. TRACE SPIKED.")
   (cons "the contact toast" "! CONTACT. TRACE SPIKED.")
   (cons "the gate-open toast" "GATE OPEN.")
   (cons "the node-crashed toast" "NODE CRASHED.")
   (cons "the board-held toast" "BOARD HELD. ENTER THE NODE TO RESUME.")
   (cons "the board-severed toast" "! BOARD SEVERED. ICE ALERTED.")
   (cons "the hub's reconnect row" "> RECONNECT   (RETURN)")
   (cons "the hub's menu row" "> MENU   (RETURN)")
   (cons "the hub's jack-out row" "  JACK OUT    (ESC)")
   (cons "the tool stack's labels" "UNDO SHUFFLE HINT NEXT")
   (cons "the update prompt" "NEW VERSION READY")
   ;; the update readout (2026-09-25): the triangle and the middle dot are
   ;; the reason the font grew, so they are the reason this file exists
   (cons "the update mark" (string-append "UPDATE " (string TRI) " 0.1.2"))
   (cons "the update stamp" (string-append (string MIDDOT) " update ready"))))

(define (missing-chars s)
  (filter (lambda (c) (not (assv (char-downcase c) GLYPHS)))
          (filter (lambda (c) (not (char=? c #\space)))
                  (string->list s))))

(test-group "font: every drawable string is drawable"
  (for-each
   (lambda (entry)
     (let ((missing (missing-chars (cdr entry))))
       (test (string-append (car entry)
                            (if (null? missing)
                                " uses only characters the font has"
                                (string-append " is missing a glyph for "
                                               (list->string missing))))
         (assert-equal '() missing))))
   DRAWABLE))

;; The special glyphs -- the note, the triangle, the middle dot -- are
;; mapped onto low codes for the baked atlas. Those codes must be ones
;; TEXT CANNOT CONTAIN, i.e. below 32. The tempting slots are 126 and 125,
;; which look free only because the font has no '~' or '}' entry yet: put a
;; special glyph on one and the day that character is drawn, or gains a
;; glyph, it silently renders as a triangle. Sabotage: move TRI to 126 and
;; this names it.
(test-group "font: a special glyph never shares a code with printable text"
  (for-each
   (lambda (named)
     (let ((code (glyph-code (cdr named))))
       (test (string-append (car named) " sits below 32, where text cannot reach (code "
                            (number->string code) ")")
         (assert-true (< code 32)))))
   (list (cons "the triangle" TRI)
         (cons "the middle dot" MIDDOT)))
  ;; the note is the exception that proves the rule: 127 is DEL, which is
  ;; also unreachable by text, and it was there before this rule was written
  (test "the note sits on DEL, which text cannot reach either"
    (assert-equal 127 (glyph-code NOTE))))
