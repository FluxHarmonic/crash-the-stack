;;; Gate leg 4 (native) - the store round trip.
;;;
;;; A played session (a match, a hint, a shuffle, a lock, a selection, a
;;; setting changed) goes through (crash save) to a datum, through (crash
;;; store) to a file under a temporary root, and back: the board is
;;; structurally equal (locks and selection included), the trace and the
;;; settings match. A missing key is #f; text that is not one save datum
;;; is #f and never traps. The web half of this leg is verify.mjs's
;;; reload sub-arm.

(import (sigil test)
        (sigil fs)
        (sigil math)
        (crash stack layout)
        (crash stack rules)
        (crash stack turtle)
        (crash geometry)
        (crash input)
        (crash trace)
        (crash save)
        (crash store)
        (crash look))

(define lay (turtle-layout))
(define geom (make-geometry lay 640 400))

(define (frame pressed . rest)
  (make-input-frame pressed (if (pair? rest) (car rest) '()) #f))

;; A session with something of everything in it.
(define (played)
  (let* ((s (session-new lay 9))
         (pair (car (board-solution (session-board s))))
         (s (session-pick (session-pick s (car pair)) (cdr pair)))   ; a match
         (s (session-step s (frame '(pair-hint)) geom))              ; a hint (30)
         (s (session-step s (frame '(s) '(ctrl)) geom))              ; a shuffle (60)
         (s (session-advance s (* 60 (- TRACE-AT 90))))              ; to TRACE-AT: traced
         (s (session-advance s (* 60 (+ ICE-FIRST 1))))              ; the first ICE
         (s (session-pick s (car (car (unlocked-matches (session-board s)))))) ; a selection
         (s (session-step s (frame '(tab)) geom))                    ; cursor model
         (s (session-step s (frame '(m) '(ctrl)) geom))              ; clean face
         (s (session-step s (frame '(t) '(ctrl)) geom)))             ; the next look (P3)
    s))

(define root (string-append (make-temp-directory) "/crash-store"))
(set-store-root! root)

(test-group "store: a session survives the round trip"
  (let* ((s (played))
         (d (session->datum s)))
    (test "the played session is what the leg says it is"
      (assert-equal 142 (board-tile-count (session-board s)))
      (assert-equal 'counter (trace-phase (session-trace s)))
      (assert-equal 1 (trace-ice-count (session-trace s)))
      (assert-true (and (board-selected (session-board s)) #t))
      (assert-equal 'cursor (session-model s))
      ;; the flip to clean was refused: the game is already under the ICE
      (assert-equal 'twist (trace-mode (session-trace s)))
      (assert-equal MSG-TOO-LATE (session-message s)))
    (test "nothing is stored yet"
      (assert-false (store-get "board"))
      (assert-false (store-read-datum "board")))
    (test "the write lands as a file under the root"
      (assert-true (store-write-datum! "board" d))
      (assert-true (file-exists? (string-append root "/board.sgl"))))
    (test "the datum reads back equal"
      (assert-equal d (store-read-datum "board")))
    (test "the restored board is structurally equal, locks and selection included"
      (let ((r (datum->session (store-read-datum "board"))))
        (assert-true (and r #t))
        (assert-true (board-equal? (session-board s) (session-board r)))
        (assert-equal (board-locked-slots (session-board s))
                      (board-locked-slots (session-board r)))
        (assert-equal (vector->list (board-locked (session-board s)))
                      (vector->list (board-locked (session-board r))))
        (assert-equal (board-selected (session-board s))
                      (board-selected (session-board r)))
        (assert-equal (board-rng (session-board s)) (board-rng (session-board r)))))
    (test "the trace and the settings come back"
      (let* ((r (datum->session (store-read-datum "board")))
             (t0 (session-trace s))
             (t1 (session-trace r)))
        (assert-equal (trace-ticks t0) (trace-ticks t1))
        (assert-equal (trace-hints t0) (trace-hints t1))
        (assert-equal (trace-shuffles t0) (trace-shuffles t1))
        (assert-equal (trace-phase t0) (trace-phase t1))
        (assert-equal (trace-countdown t0) (trace-countdown t1))
        (assert-equal (trace-ice-timer t0) (trace-ice-timer t1))
        (assert-equal (trace-ice-count t0) (trace-ice-count t1))
        (assert-equal (trace-last-ice t0) (trace-last-ice t1))
        (assert-equal (trace-mode t0) (trace-mode t1))
        (assert-equal (session-seed s) (session-seed r))
        (assert-equal (session-model s) (session-model r))
        (assert-equal (session-labels-shown s) (session-labels-shown r))
        (assert-equal (session-look s) (session-look r))))
    (test "the restored session plays on under the ICE: the countdown keeps running"
      (let* ((r (datum->session (store-read-datum "board")))
             (later (session-advance r 60)))
        (assert-equal (- (trace-countdown (session-trace r)) 60)
                      (trace-countdown (session-trace later)))))
    (test "history is not saved: the restored session has nothing to undo"
      (let ((r (datum->session (store-read-datum "board"))))
        (assert-equal '() (board-history (session-board r)))))
    (test "remove empties the key"
      (assert-true (store-remove! "board"))
      (assert-false (store-get "board"))
      (assert-true (store-remove! "board")))))

(test-group "store: what does not read back"
  (test "a missing key is #f, not an error"
    (assert-false (store-get "nothing-here"))
    (assert-false (store-read-datum "nothing-here")))
  (test "text that is not a datum is #f"
    (assert-true (store-set! "junk" "(this is (not"))
    (assert-false (store-read-datum "junk"))
    (assert-true (store-set! "junk" ""))
    (assert-false (store-read-datum "junk"))
    (assert-true (store-set! "junk" "(a) (b)"))
    (assert-false (store-read-datum "junk")))
  (test "a datum that is not a save is #f from datum->session"
    (assert-false (datum->session '(something else)))
    (assert-false (datum->session '(crash-save 99 (seed . 1))))
    (assert-false (datum->session 42))
    (let ((d (session->datum (session-new lay 1))))
      ;; the right shape with a wrong face
      (assert-false (datum->session
                      (map (lambda (e)
                             (if (and (pair? e) (eq? (car e) 'faces))
                                 (cons 'faces (cons 99 (cdr (cdr e))))
                                 e))
                           d)))))
  (test "a selection that is no longer playable is dropped, not trusted"
    (let* ((s (session-new lay 1))
           (b (session-board s))
           (pair (car (board-solution b)))
           (played (session-pick (session-pick s (car pair)) (cdr pair)))
           (d (session->datum played))
           (crafted (map (lambda (e)
                           (if (and (pair? e) (eq? e (assq 'selected d)))
                               (cons 'selected (car pair))   ; a removed tile
                               e))
                         d))
           (r (datum->session crafted)))
      (assert-true (and r #t))
      (assert-false (board-selected (session-board r)))))
  (test "a P0..P2 save's render mode reads back as a look; an unknown look is refused"
    (let* ((d (session->datum (session-new lay 1)))
           (with-settings (lambda (st)
                            (map (lambda (e)
                                   (if (and (pair? e) (eq? (car e) 'settings))
                                       (cons 'settings st)
                                       e))
                                 d))))
      (assert-equal 'test-tile (session-look (datum->session (with-settings '(hint #t texture)))))
      (assert-equal DEFAULT-LOOK (session-look (datum->session (with-settings '(hint #t primitives)))))
      (assert-false (datum->session (with-settings '(hint #t no-such-look))))))
  (test "odd face counts are refused, so a restored board can always shuffle"
    (let* ((d (session->datum (session-new lay 1)))
           (crafted (map (lambda (e)
                           (if (and (pair? e) (eq? (car e) 'present))
                               (cons 'present (cons #f (cdr (cdr e))))   ; one tile missing
                               e))
                         d)))
      (assert-false (datum->session crafted))))
  (test "a fresh session round-trips too"
    (let* ((s (session-new lay 1))
           (r (datum->session (text->datum (datum->text (session->datum s))))))
      (assert-true (board-equal? (session-board s) (session-board r)))
      (assert-equal 144 (board-tile-count (session-board r))))))
