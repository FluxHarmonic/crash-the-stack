;;; Positive control for test/test-imports.sgl: a "rules" module with a
;;; rendering import planted in it, a second import form hidden after the
;;; export list, and a cond-expand import. Never compiled; only read.
(define-library (crash stack planted)
  (import (sigil core) (sigil graphics) (crash stack helper))
  (export x)
  (import (only (sigil random) random))
  (cond-expand (sigil (import (sigil io))) (else))
  (begin (define x 1)))
