;;; Positive control for test-imports.sgl's tracker family gate: three
;;; plants a tracker module must never carry, one inside cond-expand.
(define-library (crash tracker planted)
  (import (sigil struct)
          (crash tracker model)
          (crash render))
  (export nothing)
  (import (crash stack rules))
  (cond-expand
    (wasm (import (crash cards rules)))
    (else))
  (begin (define nothing #f)))
