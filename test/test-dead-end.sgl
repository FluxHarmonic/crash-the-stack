;;; Positive control for leg 1 - a board that cannot be cleared.
;;;
;;; Sabotage proves the generation gate can go red; this proves the checker
;;; and the generator can say NO on a board where no is the right answer.
;;; Four tiles in one column: only the top tile is ever free, so no pair is
;;; ever playable together.

(import (sigil test)
        (crash stack layout)
        (crash stack rules)
        (crash stack generate)
        (crash stack fixtures))

(test-group "dead end: the four-tile column"
  (let ((lay (column-4-layout)))
    (test "generator refuses it for seeds 1..50"
      (let loop ((seed 1))
        (cond ((> seed 50) (assert-true #t))
              ((generate lay seed) (assert-fail (string-append "seed " (number->string seed) " produced a board")))
              (else (loop (+ seed 1))))))
    (test "generator reports zero backtracks: nothing to rewind from"
      (assert-equal 0 (cdr (generate/stats lay 1))))
    (let ((b (board-new lay (vector 0 0 1 1))))
      (test "only the top tile is playable"
        (assert-equal '(3) (playable-slots b)))
      (test "no legal match"
        (assert-equal '() (legal-matches b)))
      (test "replay checker rejects the hand-written solution at step 1"
        (assert-equal 1 (replay-solution b '((3 . 2) (1 . 0)))))
      (test "replay checker rejects a solution that stops early"
        (assert-equal 1 (replay-solution b '((0 . 1))))))))
