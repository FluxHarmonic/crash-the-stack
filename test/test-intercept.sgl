;;; INTERCEPT (the rhythm game): the chart generated from a song and the
;;; judging of presses against it. David's rulings, 2026-09-28: windows
;;; SYNC 35 / CLEAN 70 / LOSSY 110 ms, else DROP; SIGNAL at 0 fails the
;;; song; taps only; after his first play, ALWAYS FOUR LANES (D F J K, or
;;; four pads on touch), the tier scaling density, speed and patterns.

(import (sigil test)
        (sigil math)
        (sigil list)
        (sigil io)
        (sigil fs)
        (motif tune)
        (crash music)
        (crash intercept source)
        (crash intercept chart)
        (crash intercept rules)
        (crash intercept clock)
        (crash intercept table)
        (only (crash store) set-store-root!)
        (only (crash music live) live-music-set-loader!))

(define (tune-of name) (read-tune-string (read-file-string (music-tune-path name))))

;; name -> #(length-ms onsets sections), one walk per song
(define *walks* '())
(define (walk-of name)
  (let ((e (assq name *walks*)))
    (if e
        (cdr e)
        (let ((w (tune-walk (tune-of name))))
          (set! *walks* (cons (cons name w) *walks*))
          w))))
(define (source-of name) (cons (vector-ref (walk-of name) 0) (vector-ref (walk-of name) 1)))

(define *charts* '())
(define (chart-of name d)
  (let* ((key (list name d))
         (e (assoc key *charts*)))
    (if e
        (cdr e)
        (let ((c (make-chart (cdr (source-of name)) d)))
          (set! *charts* (cons (cons key c) *charts*))
          c))))

(define SONGS '(black-glass blind-spot sector-drift clock-edge glass-current))

(define (max-in-window chart ms)
  ;; the most notes within any 1000 ms centred on a note
  ;; (the chart is in time order: two pointers bracket the window)
  (let ((n (vector-length chart))
        (at (lambda (i) (vector-ref (vector-ref chart i) 0)))
        (half (/ ms 2)))
    (let loop ((i 0) (lo 0) (hi 0) (best 0))
      (if (= i n)
          best
          (let* ((t (at i))
                 (lo (let adv ((lo lo)) (if (<= (at lo) (- t half)) (adv (+ lo 1)) lo)))
                 (hi (let adv ((hi hi)) (if (and (< hi n) (< (at hi) (+ t half))) (adv (+ hi 1)) hi))))
            (loop (+ i 1) lo hi (max best (- hi lo))))))))

;; the most notes at one instant (within 1 ms) anywhere in the chart
(define (max-chord chart)
  (let ((n (vector-length chart)))
    (let loop ((i 0) (best 0))
      (if (= i n)
          best
          (let count ((j i) (k 0))
            (if (and (< j n) (< (- (vector-ref (vector-ref chart j) 0) (vector-ref (vector-ref chart i) 0)) 1.0))
                (count (+ j 1) (+ k 1))
                (loop (+ i 1) (max best k))))))))

(test-group "intercept: the song's onsets and sections"
  (test "every INTERCEPT song has the shared layout: a kick on ch1 and notes on ch6"
    (for-each (lambda (name)
                (let ((os (cdr (source-of name))))
                  (assert-true (> (length (filter (lambda (o) (= 1 (vector-ref o 1))) os)) 50))
                  (assert-true (> (length (filter (lambda (o) (= 6 (vector-ref o 1))) os)) 20))))
              SONGS))
  (test "onsets are in time order, and Black Glass's first kick is on a beat"
    (let* ((os (cdr (source-of 'black-glass)))
           (kick (list-find (lambda (o) (= 1 (vector-ref o 1))) os)))
      (assert-true (let loop ((os os)) (or (null? os) (null? (cdr os)) (and (<= (vector-ref (car os) 0) (vector-ref (cadr os) 0)) (loop (cdr os))))))
      (assert-equal 0 (vector-ref kick 3))))
  (test "a song runs its whole order list: 150 to 180 s"
    (for-each (lambda (name)
                (let ((len (car (source-of name))))
                  (assert-true (> len 150000.0))
                  (assert-true (< len 180000.0))))
              SONGS))
  (test "the sections (the progress bar's ticks): in time order inside the song, at least one marked section each"
    (for-each (lambda (name)
                (let* ((w (walk-of name))
                       (ss (vector-ref w 2)))
                  (assert-true (> (length ss) 2))
                  (assert-true (and (list-find cdr ss) #t))
                  (assert-true (let loop ((ss ss) (prev -1.0))
                                 (or (null? ss)
                                     (and (> (car (car ss)) prev) (< (car (car ss)) (vector-ref w 0))
                                          (loop (cdr ss) (car (car ss)))))))))
              SONGS)))

(test-group "intercept: charts"
  (test "four lanes on every tier, D F J K; every note in them"
    (assert-equal '(4 4 4) (map chart-lanes DIFFICULTIES))
    (assert-equal '(d f j k) (chart-keys 'elite))
    (for-each (lambda (name)
                (for-each (lambda (d)
                            (let ((c (chart-of name d)))
                              (assert-true (> (vector-length c) 100))
                              (vector-for-each (lambda (note) (assert-true (and (>= (vector-ref note 1) 0) (< (vector-ref note 1) 4)))) c)))
                          DIFFICULTIES))
              SONGS))
  (test "the density rises with the tier, and every tier uses all four lanes"
    (for-each (lambda (name)
                (let ((ns (map (lambda (d) (vector-length (chart-of name d))) DIFFICULTIES)))
                  (assert-true (< (car ns) (cadr ns)))
                  (assert-true (< (cadr ns) (caddr ns))))
                (for-each (lambda (d)
                            (let ((c (chart-of name d)))
                              (let loop ((lane 0))
                                (when (< lane 4)
                                  (assert-true (and (list-find (lambda (n) (= lane (vector-ref n 1))) (vector->list c)) #t))
                                  (loop (+ lane 1))))))
                          DIFFICULTIES))
              SONGS))
  (test "the limits hold: the tier's chord size, the cap per second, the lane gap"
    (for-each (lambda (name)
                (for-each (lambda (d)
                            (let* ((c (chart-of name d))
                                   (t (cdr (assq d TIERS)))
                                   (lane-gap (list-ref t 1))
                                   (cap (list-ref t 3))
                                   (chord (list-ref t 4)))
                              (assert-true (<= (max-in-window c 1000) cap))
                              (assert-true (<= (max-chord c) chord))
                              (let loop ((lane 0))
                                (when (< lane 4)
                                  (let ((ts (filter (lambda (x) x) (map (lambda (n) (and (= lane (vector-ref n 1)) (vector-ref n 0))) (vector->list c)))))
                                    (let gaps ((ts ts))
                                      (when (and (pair? ts) (pair? (cdr ts)))
                                        (assert-true (>= (- (cadr ts) (car ts)) lane-gap))
                                        (gaps (cdr ts)))))
                                  (loop (+ lane 1))))))
                          DIFFICULTIES))
              SONGS))
  (test "the patterns by tier: SCRIPT KID has no chords, RUNNER has some, ELITE crosses the melody onto D and F"
    (for-each (lambda (name)
                (assert-equal 1 (max-chord (chart-of name 'script-kid))))
              SONGS)
    (assert-equal 2 (max-chord (chart-of 'black-glass 'runner)))
    ;; ELITE puts melody notes on the left hand's lanes: more notes on D and F than RUNNER has there
    (let ((left (lambda (c) (length (filter (lambda (n) (< (vector-ref n 1) 2)) (vector->list c))))))
      (assert-true (> (left (chart-of 'black-glass 'elite)) (left (chart-of 'black-glass 'runner))))))
  (test "lane balance: every lane of every chart used, none over REPAIR-SHARE (David on Clock Edge: \"98% of the taps fall on the second lane\")"
    ;; the per-lane shares, printed for the record
    (for-each (lambda (name)
                (for-each (lambda (d)
                            (let ((shares (lane-shares (chart-of name d))))
                              (display "  ") (display name) (display " ") (display d) (display " ")
                              (display (map (lambda (s) (exact (round (* 100 s)))) shares)) (display " %") (newline)
                              ;; the gate's own line, not the product's constant: a raised REPAIR-SHARE must go red here
                              (assert-true (<= (fold-left max 0.0 shares) 0.70))
                              (assert-true (>= (fold-left min 1.0 shares) 0.02))))
                          DIFFICULTIES))
              SONGS))
  (test "generation is reproducible: the same hash twice from fresh walks"
    (let ((a (chart-hash (make-chart (tune-onsets (tune-of 'black-glass)) 'runner)))
          (b (chart-hash (make-chart (tune-onsets (tune-of 'black-glass)) 'runner))))
      (assert-equal a b)
      (assert-false (= a (chart-hash (chart-of 'black-glass 'elite)))))))

(define chart (vector (vector 1000.0 0) (vector 1500.0 1) (vector 2000.0 0) (vector 2000.0 1)))

;; Every chart pinned: (song tier notes hash). One chart per tier since the four-lane ruling
;; (keys and touch play the same). A change to the generator, the songs or motif's walk moves
;; a hash here first; re-pin only when the change is meant.
(define PINNED
  '(
    (black-glass script-kid 219 2172806)
    (black-glass runner 483 3062157)
    (black-glass elite 852 7809115)
    (blind-spot script-kid 222 452273)
    (blind-spot runner 358 6057529)
    (blind-spot elite 526 10161227)
    (sector-drift script-kid 234 9001811)
    (sector-drift runner 463 11133682)
    (sector-drift elite 719 12607253)
    (clock-edge script-kid 211 8995239)    ; repaired 2026-09-28 (was 222 16729818: 214 of 222 on F)
    (clock-edge runner 399 1261879)        ; repaired 2026-09-28 (was 417 13263469: 76 % on F)
    (clock-edge elite 665 11476362)
    (glass-current script-kid 236 4458704)
    (glass-current runner 530 148316)
    (glass-current elite 862 4455922)
    ))

(test-group "intercept: pinned charts (the gate: generated reproducibly)"
  (test "15 charts, 5 songs x 3 tiers, each its pinned note count and hash"
    (assert-equal 15 (length PINNED))
    (for-each (lambda (p)
                (let ((c (chart-of (list-ref p 0) (list-ref p 1))))
                  (assert-equal (list-ref p 2) (vector-length c))
                  (assert-equal (list-ref p 3) (chart-hash c))))
              PINNED)))

;; The table, headless: no audio context, so the song clock runs on the
;; frames' wall time, which the test sets. Its store goes to a temp root.
(set-store-root! (string-append (make-temp-directory) "/crash-store"))
(live-music-set-loader! (lambda (name)
                          (let ((p (music-tune-path name)))
                            (and (file-exists? p) (read-file-string p)))))
(define (frame keys presses wall) (make-intercept-frame keys presses '() wall))
(define (repeat n x) (if (= n 0) '() (cons x (repeat (- n 1) x))))

(test-group "intercept: the song screen's keys keep the chosen song"
  (let* ((t (intercept-open #f 'black-glass))
         (t1 (intercept-step t (frame '(tab down down) '() 1.0)))   ; to CALIBRATE
         (t2 (intercept-step t (frame '(right) '() 1.0)))           ; right on the song row
         (t3 (intercept-step t (frame '(down down) '() 1.0))))
    (test "Tab and down through the settings leave Black Glass chosen (the walk down the list chose Glass Current)"
      (assert-equal 'black-glass (car (intercept-song t1)))
      (assert-equal 7 (intercept-focus t1)))
    (test "right on a song row steps DIFFICULTY; down moves the chosen song"
      (assert-equal 'elite (intercept-difficulty t2))
      (assert-equal 'sector-drift (car (intercept-song t3))))))

(test-group "intercept: the table judges on the player's clock (OFFSET, the review's H1)"
  (let* ((w0 1000000.0)
         (t (intercept-open #f 'black-glass))
         ;; Tab to the settings rows, down to OFFSET, then 30 steps of +5 ms
         (t (intercept-step t (frame (append '(tab down) (repeat 30 'right)) '() w0)))
         (offset (intercept-offset t))
         (t (intercept-step t (frame '(return) '() w0)))   ; the song's text asked for
         (t (intercept-step t (frame '() '() w0)))         ; it lands (natively, at once): the song, its clock -LEAD-MS at w0
         (note (vector-ref (intercept-chart t) 0))
         (key (list-ref '(d f j k) (vector-ref note 1)))
         ;; the raw clock reaches the note + OFFSET when the player hears it
         (heard (+ w0 LEAD-MS (vector-ref note 0) 150))
         (t (intercept-step t (frame '() '() (- heard 1.0))))
         (still (run-judgment (intercept-run t) 0))
         (t (intercept-step t (frame '() (list (cons key heard)) heard))))
    (test "OFFSET +150 set from the song screen; the song opened"
      (assert-equal 150 offset)
      (assert-equal 'play (intercept-phase t)))
    (test "a frame 149 ms past the note on the raw clock has not dropped it (it is 1 ms early for the ear)"
      (assert-false still))
    (test "the press on time for the ear is SYNC"
      (assert-equal 'sync (run-judgment (intercept-run t) 0)))))

;; A simulated sink for the song clock: at wall w the ear hears song ms
;; (w - w0 - LEAD-MS); the sink holds DEPTH frames not yet played and the
;; device LATENCY ms more, so the frames delivered by then are those heard
;; plus both. The reader answers as (crash intercept audio) does: audible-ms,
;; with the latency subtracted or (the control) not.
(define SIM-RATE 48000)
(define SIM-DEPTH 16384)
(define SIM-LATENCY 150.0)
(define *sim-wall* (vector 0.0))
(define (sim-reader w0 subtract?)
  (lambda ()
    (let* ((heard (- (vector-ref *sim-wall* 0) w0 LEAD-MS))
           (delivered (+ (* (/ (+ heard LEAD-MS SIM-LATENCY) 1000.0) SIM-RATE) SIM-DEPTH)))
      (audible-ms delivered SIM-DEPTH (* SIM-RATE (/ LEAD-MS 1000.0)) SIM-RATE (if subtract? SIM-LATENCY 0.0)))))

;; A song on a fresh store (OFFSET 0), stepped at 16 ms frames to wall `until`,
;; then one frame at `until` carrying `presses`. Answers the table.
(define (sim-song w0 reader until-wall presses)
  (set-store-root! (string-append (make-temp-directory) "/crash-store"))
  (intercept-set-audio-reader! reader)
  (vector-set! *sim-wall* 0 w0)
  (let* ((t (intercept-open #f 'black-glass))
         (t (intercept-step t (frame '(return) '() w0)))
         (t (intercept-step t (frame '() '() w0))))
    (let loop ((w (+ w0 16.0)) (t t))
      (if (>= w until-wall)
          (begin (vector-set! *sim-wall* 0 until-wall)
                 (intercept-step t (frame '() presses until-wall)))
          (begin (vector-set! *sim-wall* 0 w)
                 (loop (+ w 16.0) (intercept-step t (frame '() '() w))))))))

(test-group "intercept: the audible clock (David: \"I have to tap earlier than the beat\")"
  (let* ((w0 2000000.0)
         (probe (sim-song w0 (sim-reader w0 #t) (+ w0 16.0) '()))
         (note (vector-ref (intercept-chart probe) 0))
         (key (list-ref '(d f j k) (vector-ref note 1)))
         ;; the tap exactly when the note's sound reaches the ear
         (on-beat (+ w0 LEAD-MS (vector-ref note 0)))
         (heard-clock (sim-song w0 (sim-reader w0 #t) on-beat (list (cons key on-beat))))
         (render-clock (sim-song w0 (sim-reader w0 #f) on-beat (list (cons key on-beat)))))
    (test "a tap on the beat the player hears is SYNC when the clock subtracts the device's latency"
      (assert-equal 'sync (run-judgment (intercept-run heard-clock) 0)))
    (test "control: the same tap, the latency not subtracted (the clock 150 ms ahead of the ear), is DROP"
      (assert-equal 'drop (run-judgment (intercept-run render-clock) 0)))))

(test-group "intercept: CALIBRATE on the click track: from the first tap, the median, outliers out"
  ;; no audio: the clock runs on the frames' wall time
  (set-store-root! (string-append (make-temp-directory) "/crash-store"))
  (intercept-set-audio-reader! (lambda () #f))
  (let* ((w0 3000000.0)
         (clicks (map (lambda (o) (vector-ref o 0))
                      (filter (lambda (o) (= 1 (vector-ref o 1))) (vector-ref (walk-of CALIBRATE-TUNE) 1))))
         (t (intercept-open #f 'black-glass))
         (t (intercept-step t (frame '(tab down down) '() w0)))    ; Tab to the settings, down twice: CALIBRATE
         (t (intercept-step t (frame '(return) '() w0)))
         (t (intercept-step t (frame '() '() w0)))                 ; the click track lands: calibrating, clock -CALIBRATE-LEAD-MS at w0
         (phase (intercept-phase t))
         ;; the first tap starts it (far off, 190 ms late: it must not count);
         ;; then taps 60 ms late, one of them an outlier 200 ms late
         (lates (append '(190.0) '(60.0 60.0 60.0 200.0 60.0 60.0 60.0 60.0)))
         (t (let loop ((cs (cdr clicks)) (ls lates) (t t))
              (if (or (null? cs) (null? ls) (not (eq? (intercept-phase t) 'calibrate)))
                  t
                  (let ((w (+ w0 CALIBRATE-LEAD-MS (car cs) (car ls))))
                    (loop (cdr cs) (cdr ls) (intercept-step t (frame '() (list (cons 'f w)) w))))))))
    (test "a click a beat at 120 BPM: the track's clicks are 500 ms apart"
      (assert-equal 500.0 (- (cadr clicks) (car clicks))))
    (test "the eighth row starts a calibration"
      (assert-equal 'calibrate phase))
    (test "the first tap and the 200 ms outlier left out: OFFSET +60, back on the song screen"
      (assert-equal 'select (intercept-phase t))
      (assert-equal 60 (intercept-offset t)))))

(test-group "intercept: PAUSE, by Escape and by a tap on the top-left button"
  (set-store-root! (string-append (make-temp-directory) "/crash-store"))
  (intercept-set-audio-reader! (lambda () #f))
  (let* ((w0 4000000.0)
         (tap (lambda (x y w) (make-intercept-frame '() '() (list (list x y w)) w)))
         (t (intercept-open #t 'black-glass))                       ; touch
         (t (intercept-step t (frame '(return) '() w0)))
         (t (intercept-step t (frame '() '() w0)))                  ; playing
         (t1 (intercept-step t (tap 20 10 (+ w0 500.0))))           ; the pause button
         (now1 (intercept-now t1))
         (t2 (intercept-step t1 (frame '() '() (+ w0 5000.0))))     ; 4.5 s paused: nothing moves
         (t3 (intercept-step t2 (tap 320 165 (+ w0 5100.0))))       ; RESUME
         (t4 (intercept-step t3 (frame '(escape) '() (+ w0 5200.0))))  ; Escape pauses too
         (t5 (intercept-step t4 (tap 320 245 (+ w0 5300.0)))))      ; SONGS
    (test "a tap on the top-left button pauses; the song clock stands while paused"
      (assert-equal 'paused (intercept-phase t1))
      (assert-equal 'paused (intercept-phase t2))
      (assert-equal now1 (intercept-now t2)))
    (test "RESUME plays on from where it stood, not from where the wall clock went"
      (assert-equal 'play (intercept-phase t3))
      (assert-true (< (abs (- (intercept-now t3) now1)) 1.0)))
    (test "Escape pauses; SONGS goes back to the song screen (a touch player's way out)"
      (assert-equal 'paused (intercept-phase t4))
      (assert-equal 'select (intercept-phase t5)))))

(test-group "intercept: judging"
  (test "the windows: 35 SYNC, 70 CLEAN, 110 LOSSY, both sides; past 110 nothing"
    (assert-equal 'sync (judge-delta 35))
    (assert-equal 'sync (judge-delta -35))
    (assert-equal 'clean (judge-delta 36))
    (assert-equal 'clean (judge-delta -70))
    (assert-equal 'lossy (judge-delta 110))
    (assert-false (judge-delta 111))
    (assert-false (judge-delta -111)))
  (test "a hit scores, builds combo and SIGNAL; a stray press costs nothing"
    (let* ((r (make-run chart 2))
           (r (run-advance r 1010.0 (list (cons 0 1010.0))))
           (r (run-advance r 1200.0 (list (cons 1 1200.0)))))
      (assert-equal '(sync 0 0 0) (list (run-judgment r 0) 0 0 0))
      (assert-equal 300 (run-score r))
      (assert-equal 1 (run-combo r))
      (assert-equal 53 (run-signal r))
      (assert-false (run-judgment r 1))
      (assert-equal 'press (vector-ref (car (run-events r)) 0))))
  (test "a note whose window passes is a DROP: combo reset, SIGNAL -6"
    (let* ((r (make-run chart 2))
           (r (run-advance r 1010.0 (list (cons 0 1010.0))))
           (r (run-advance r 1611.0 '())))
      (assert-equal 'drop (run-judgment r 1))
      (assert-equal 0 (run-combo r))
      (assert-equal 47 (run-signal r))
      (assert-equal '(1 0 0 1) (run-counts r))))
  (test "a chord takes a press in each lane; the multiplier steps every 10"
    (let* ((r (make-run chart 2))
           (r (run-advance r 2100.0 (list (cons 0 1000.0) (cons 1 1560.0) (cons 0 2080.0) (cons 1 1990.0)))))
      (assert-equal '(sync clean lossy sync) (map (lambda (i) (run-judgment r i)) '(0 1 2 3)))
      (assert-true (run-done? r))
      (assert-equal 4 (run-max-combo r))
      (assert-equal 1 (run-multiplier r))))
  (test "SIGNAL at 0 fails the run (ruling c)"
    (let* ((n 12)
           (c (list->vector (map (lambda (i) (vector (* 200.0 (+ i 1)) 0)) (iota n))))
           (r (run-advance (make-run c 1) 5000.0 '())))
      (assert-true (run-failed? r))
      (assert-equal 0 (run-signal r))))
  (test "a press nearer the lane's next note takes it; the head is dropped (the review's M3)"
    ;; two notes 100 ms apart in one lane: their windows overlap
    (let* ((c (vector (vector 1000.0 0) (vector 1100.0 0)))
           (r (run-advance (make-run c 1) 1100.0 (list (cons 0 1100.0)))))
      (assert-equal 'drop (run-judgment r 0))
      (assert-equal 'sync (run-judgment r 1))
      ;; and a press nearer the head still takes the head
      (let ((r2 (run-advance (make-run c 1) 1040.0 (list (cons 0 1040.0)))))
        (assert-equal 'clean (run-judgment r2 0))
        (assert-false (run-judgment r2 1)))))
  (test "accuracy and grade"
    (let* ((r (make-run chart 2))
           (r (run-advance r 2200.0 (list (cons 0 1000.0) (cons 1 1500.0) (cons 0 2000.0) (cons 1 2000.0)))))
      (assert-equal 100.0 (run-accuracy r))
      (assert-equal "S" (run-grade r)))))

(test-group "intercept: the clock"
  (test "follows wall time without audio; never runs backwards; snaps past 50 ms"
    (let* ((c (make-clock -2000 0))
           (c (clock-tick c 16 #f)))
      (assert-equal -1984.0 (clock-ms c))
      (let* ((c (clock-tick c 32 -1900.0)))   ; audio 68 ms ahead: snap
        (assert-equal -1900.0 (clock-ms c))
        (let ((c2 (clock-tick c 48 -1990.0)))   ; audio far behind: hold, never back
          (assert-true (>= (clock-ms c2) -1900.0))))))
  (test "steers a small error a tenth of the way"
    (let* ((c (make-clock 0 0))
           (c (clock-tick c 10 20.0)))
      ;; est 10, audio 20: 10 + 0.1 * 10
      (assert-equal 11.0 (clock-ms c))))
  (test "holds while the audio stalls, then gives the audio up after a second and runs on wall time"
    (let* ((c (make-clock 0 0))
           (c (clock-tick c 10 5.0))
           (c1 (clock-tick c 600 5.0))       ; stalled 590 ms: held (the audio is the truth)
           (c2 (clock-tick c1 1200 5.0))     ; stalled 1190 ms: given up, wall time from the hold
           (c3 (clock-tick c2 1300 5.0)))
      (assert-true (< (clock-ms c1) 20.0))
      (assert-true (clock-audio? c1))
      (assert-false (clock-audio? c2))
      (assert-true (> (clock-ms c2) 600.0))
      (assert-equal 100.0 (- (clock-ms c3) (clock-ms c2)))
      ;; the review's M2: when the audio moves again the clock follows it again,
      ;; holding (never backwards) while the sound catches up, then in step
      (let* ((c4 (clock-tick c3 1400 400.0))     ; the device resumed, 309 ms behind the clock
             (c5 (clock-tick c4 1700 700.0))
             (c6 (clock-tick c5 1800 800.0)))
        (assert-true (clock-audio? c4))
        (assert-true (>= (clock-ms c4) (clock-ms c3)))
        (assert-true (< (abs (- (clock-ms c6) 800.0)) 10.0))))))   ; 808.55: in step, converging
