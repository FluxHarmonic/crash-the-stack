;;; Gate: every playable tile is reachable by the cursor model from every
;;; playable highlight, on a sample of boards and positions.
;;;
;;; The reviewer found a position (seed 6, 48 pairs in) where one playable
;;; tile could never become the highlight under the first distance metric.
;;; No local "nearest in a direction" metric guarantees reachability, so
;;; this gate builds the move graph with the model's own step (four arrow
;;; presses from each playable highlight), then checks every playable tile
;;; is reachable from every other, on seeds 1..6 at every fourth step of the
;;; recorded solution. A tile the keyboard cannot reach is a tile the
;;; keyboard player cannot match.

(import (sigil test)
        (sigil list)
        (crash stack layout)
        (crash stack rules)
        (crash stack generate)
        (crash stack turtle)
        (crash geometry)
        (crash input))

(define lay (turtle-layout))
(define geom (make-geometry lay 640 400))
(define DIRS '(left right up down))

(define (frame key) (make-input-frame (list key) '() #f))

(define (with-highlight s id) (session s highlight: id))

;; Where each arrow press lands from highlight h: a list of slot ids.
(define (moves-from s h)
  (map (lambda (d) (session-highlight (session-step (with-highlight s h) (frame d) geom))) DIRS))

;; Nodes reachable from start over the move graph (an alist node -> targets).
(define (reachable graph start)
  (let loop ((todo (list start)) (seen '()))
    (cond ((null? todo) seen)
          ((memv (car todo) seen) (loop (cdr todo) seen))
          (else (loop (append (cdr todo) (cdr (assv (car todo) graph)))
                      (cons (car todo) seen))))))

;; Returns '() when every playable tile reaches every other, else a list of
;; (from . unreachable-tile) pairs.
(define (unreachable-pairs s)
  (let* ((b (session-board s))
         (playable (playable-slots b))
         (graph (map (lambda (h) (cons h (moves-from s h))) playable)))
    (apply append
           (map (lambda (from)
                  (let ((r (reachable graph from)))
                    (map (lambda (t) (cons from t))
                         (filter (lambda (t) (not (memv t r))) playable))))
                playable))))

;; Play the next n pairs of the board's recorded solution, skipping the
;; ones already gone.
(define (play s n)
  (let loop ((pairs (board-solution (session-board s))) (s s) (i 0))
    (cond ((or (= i n) (null? pairs)) s)
          ((not (tile-present? (session-board s) (car (car pairs)))) (loop (cdr pairs) s i))
          (else (loop (cdr pairs)
                      (session-pick (session-pick s (car (car pairs))) (cdr (car pairs)))
                      (+ i 1))))))

(test-group "cursor: every playable tile reachable from every highlight"
  (let seeds ((seed 1))
    (when (<= seed 6)
      (let steps ((n 0) (s (session-with-model (session-new lay seed) (quote cursor))))
        (when (<= n 68)
          (test (string-append "seed " (number->string seed) " after " (number->string n) " pairs")
            (assert-equal (quote ()) (unreachable-pairs s)))
          (steps (+ n 4) (play s 4))))
      (seeds (+ seed 1)))))

(test-group "cursor: direction semantics"
  (let* ((s (session-with-model (session-new lay 1) (quote cursor)))
         (b (session-board s))
         (apex (let loop ((id 0)) (if (= (slot-layer (layout-slot lay id)) 4) id (loop (+ id 1)))))
         (from-apex (lambda (d) (session-highlight (session-step (with-highlight s apex) (frame d) geom)))))
    (test "the apex is playable on a fresh board" (assert-true (playable? b apex)))
    (test "right from the apex lands on a tile to its right"
      (assert-true (> (slot-hx (layout-slot lay (from-apex 'right))) 0)))
    (test "left from the apex lands on a tile to its left"
      (assert-true (< (slot-hx (layout-slot lay (from-apex 'left))) 0)))
    (test "up from the apex lands on a tile above it"
      (assert-true (< (slot-hy (layout-slot lay (from-apex 'up))) 0)))
    (test "down from the apex lands on a tile below it"
      (assert-true (> (slot-hy (layout-slot lay (from-apex 'down))) 0)))
    (test "right from the apex prefers the same row (the (7.5,0) end tile) over the nearer diagonal"
      (assert-equal 0 (slot-hy (layout-slot lay (from-apex 'right)))))
    (test "right from the last tile in reading order wraps to the first"
      (let* ((order (list-sort (lambda (a b) (let ((sa (layout-slot lay a)) (sb (layout-slot lay b)))
                                                     (or (< (slot-hy sa) (slot-hy sb))
                                                         (and (= (slot-hy sa) (slot-hy sb)) (< (slot-hx sa) (slot-hx sb))))))
                                    (playable-slots b)))
             (last (car (reverse order))))
        (assert-equal (car order)
                      (session-highlight (session-step (with-highlight s last) (frame (quote right)) geom)))))
    (test "up from a top-row tile, with nothing above, keeps the highlight"
      (let ((top (let loop ((id 0)) (if (= (slot-hy (layout-slot lay id)) -7) id (loop (+ id 1))))))
        (assert-true (playable? b top))
        (assert-equal top
                      (session-highlight (session-step (with-highlight s top) (frame (quote up)) geom)))))))
