;;; The menu (P2's list, P4's screens: rulings D14, D19).
;;;
;;; The top screen's entries are data; the shown set keeps the canonical
;;; order and drops unknown ids, the highlight lands where asked, up/down
;;; wrap, Enter and Space pick the highlight, a tap on an entry's rect
;;; picks that entry at once and a tap elsewhere picks nothing. The
;;; sub-screens: FREE PLAY, SETTINGS (a value row steps on left/right,
;;; Enter and a tap, and the choice names the setting), CREDITS (pages),
;;; SCORES, CODE (typed and tapped, GO reads it, a bad code is refused),
;;; BACK and Escape close them; Escape on the pause menu is CONTINUE.

(import (sigil test)
        (sigil math)
        (crash input)
        (crash code)
        (crash settings)
        (crash credits)
        (crash menu))

(define VW 640)
(define VH 400)

(define (frame pressed) (make-input-frame pressed '() #f))
(define (click-frame xy) (make-input-frame '() '() xy))
(define (step m pressed) (menu-step m (frame pressed) VW VH))
(define (step* m . keys) (let loop ((m m) (ks keys)) (if (null? ks) m (loop (car (step m (list (car ks)))) (cdr ks)))))

(define (center m i)
  (let ((r (menu-entry-rect m i VW VH)))
    (cons (+ (car r) (quotient (caddr r) 2))
          (+ (cadr r) (quotient (cadddr r) 2)))))

(define TOP '(continue jack-in free-play settings credits update))

(test-group "the top screen"
  (test "the canonical order is kept whatever order the ids come in"
    (assert-equal TOP (menu-entries (menu-new '(update credits settings free-play jack-in continue)))))
  (test "unknown ids and the sub-screens' ids are dropped from the top screen"
    (assert-equal '(jack-in free-play) (menu-entries (menu-new '(free-play bogus stack cards jack-in)))))
  (test "the highlight starts on the entry asked for when it is shown, else the first"
    (assert-equal 1 (menu-highlight (menu-new '(jack-in free-play) 'free-play)))
    (assert-equal 0 (menu-highlight (menu-new '(jack-in free-play) 'continue)))
    (assert-equal 0 (menu-highlight (menu-new '(continue jack-in free-play) 'continue))))
  (test "labels, in the block alphabet's characters"
    (assert-equal "CONTINUE" (menu-label 'continue))
    (assert-equal "JACK IN" (menu-label 'jack-in))
    (assert-equal "FREE PLAY" (menu-label 'free-play))
    (assert-equal "DEFRAG" (menu-label 'cards))
    (assert-equal "PULL" (menu-label 'draw))
    (assert-equal "?" (menu-label 'look))
    (for-each (lambda (e)
                (for-each (lambda (c) (assert-true (or (char-upper-case? c) (char-numeric? c) (char=? c #\space))))
                          (string->list (cadr e))))
              MENU-ENTRIES))
  (test "the removed prototype entries are not entries any more (rulings D32, D34, D48)"
    (assert-equal '(jack-in) (menu-entries (menu-new '(look hud depth jack-in))))
    (assert-equal 21 (length MENU-ENTRIES)))
  (test "EXIT is the top screen's last row when the shell asks for it (the native build), absent otherwise"
    (assert-equal '(jack-in credits exit) (menu-entries (menu-new '(exit jack-in credits))))
    (assert-equal 'exit (cdr (step (step* (menu-new '(jack-in exit)) 'down) '(return))))
    (assert-false (memq 'exit (menu-entries (menu-new TOP)))))
  (test "the top screen opens with no code line and the settings' defaults"
    (let ((m (menu-new TOP)))
      (assert-equal 'top (menu-screen m))
      (assert-false (menu-code-line m))
      (assert-false (menu-heading m))
      (assert-equal (settings-defaults) (menu-settings m))
      (assert-equal 'hacker (menu-version m)))))

(test-group "keys"
  (let ((m (menu-new '(jack-in free-play settings))))
    (test "down moves, up moves back, both wrap"
      (assert-equal 1 (menu-highlight (car (step m '(down)))))
      (assert-equal 2 (menu-highlight (car (step m '(up)))))
      (assert-equal 0 (menu-highlight (step* m 'j 'j 'j))))
    (test "a move picks nothing"
      (assert-false (cdr (step m '(down)))))
    (test "Enter picks the highlight; Space too"
      (assert-equal 'jack-in (cdr (step m '(return))))
      (assert-equal 'jack-in (cdr (step m '(space)))))
    (test "a frame with nothing relevant changes nothing"
      (let ((r (step m '(x))))
        (assert-false (cdr r))
        (assert-equal 0 (menu-highlight (car r)))))
    (test "Escape on the top screen with no board live picks nothing; with CONTINUE shown it is CONTINUE"
      (assert-false (cdr (step m '(escape))))
      (assert-equal 'continue (cdr (step (menu-new '(continue jack-in)) '(escape)))))))

(test-group "taps"
  (let ((m (menu-new '(continue jack-in free-play))))
    (test "a tap on an entry picks it and moves the highlight there"
      (let ((r (menu-step m (click-frame (center m 1)) VW VH)))
        (assert-equal 'jack-in (cdr r))
        (assert-equal 1 (menu-highlight (car r)))))
    (test "the hit-test agrees with the rects"
      (assert-equal 0 (menu-hit m VW VH (car (center m 0)) (cdr (center m 0))))
      (assert-equal 1 (menu-hit m VW VH (car (center m 1)) (cdr (center m 1)))))
    (test "a tap between entries or off to the side picks nothing"
      (assert-false (menu-hit m VW VH 320 (+ ENTRIES-Y ENTRY-H 2)))
      (assert-false (cdr (menu-step m (click-frame (cons 10 10)) VW VH))))
    (test "the main menu carries no code line, even with a live board's code (David, 2026-09-21: the overlay's alone)"
      (let ((p (menu-with-code-line m "0123456789")))
        (assert-false (code-line-rect p VW VH))
        (assert-false (code-line-rect m VW VH))
        (assert-false (cdr (menu-step p (click-frame (cons 320 CODE-LINE-Y)) VW VH)))))))

(test-group "FREE PLAY"
  (let* ((m (menu-new TOP 'free-play))
         (f (car (step m '(return)))))
    (test "opens with its rows, its heading, the first row highlighted; the rows sit under the heading"
      (assert-equal 'free (menu-screen f))
      (assert-equal "FREE PLAY" (menu-heading f))
      (assert-equal '(stack cards daily-stack daily-cards code scores version back) (menu-entries f))
      (assert-equal 0 (menu-highlight f))
      (assert-equal SUB-ENTRIES-Y (cadr (menu-entry-rect f 0 VW VH)))
      (assert-true (<= (+ (cadr (menu-entry-rect f 7 VW VH)) ENTRY-H) 376)))
    (test "STACK, DEFRAG and the dailies are choices"
      (assert-equal 'stack (cdr (step f '(return))))
      (assert-equal 'cards (cdr (step (step* f 'down) '(return))))
      (assert-equal 'daily-stack (cdr (step (step* f 'down 'down) '(return))))
      (assert-equal 'daily-cards (cdr (step (step* f 'down 'down 'down) '(return)))))
    (test "VERSION is a value row: HACKER by default, ORIGINAL after a step, back after another; left steps too; no choice"
      (let* ((v (step* f 'up 'up))   ; wraps to version
             (r1 (step v '(return)))
             (r2 (step (car r1) '(left))))
        (assert-equal 'version (list-ref (menu-entries v) (menu-highlight v)))
        (assert-equal "HACKER" (menu-row-value v 'version))
        (assert-equal 'value (menu-row-kind v 'version))
        (assert-false (cdr r1))
        (assert-equal 'original (menu-version (car r1)))
        (assert-equal "ORIGINAL" (menu-row-value (car r1) 'version))
        (assert-equal 'hacker (menu-version (car r2)))
        (assert-true (> (caddr (menu-entry-rect v (menu-highlight v) VW VH)) ENTRY-W))))
    (test "BACK closes to the top screen with FREE PLAY highlighted; Escape and Backspace too"
      (let ((b (step (step* f 'up) '(return))))
        (assert-false (cdr b))
        (assert-equal 'top (menu-screen (car b)))
        (assert-equal 'free-play (list-ref (menu-entries (car b)) (menu-highlight (car b)))))
      (assert-equal 'top (menu-screen (car (step f '(escape)))))
      (assert-equal 'top (menu-screen (car (step f '(backspace))))))
    (test "a tap on a row picks it; on the version row it steps it"
      (assert-equal 'cards (cdr (menu-step f (click-frame (center f 1)) VW VH)))
      (let ((r (menu-step f (click-frame (center f 6)) VW VH)))
        (assert-false (cdr r))
        (assert-equal 'original (menu-version (car r)))))))

(test-group "SETTINGS (the general five, D51)"
  (let* ((m (menu-new TOP 'settings))
         (s (car (step m '(return)))))
    (test "seven rows under the heading: the general six as value rows showing their defaults, BACK last"
      (assert-equal 'settings (menu-screen s))
      (assert-equal (append (settings-group 'general) '(back)) (menu-entries s))
      (assert-equal '(music sfx volume scanlines veil background back) (menu-entries s))
      (for-each (lambda (id)
                  (assert-equal 'value (menu-row-kind s id))
                  (assert-false (menu-row-note s id))   ; no NOW/NEXT DEAL note on the main menu
                  (assert-equal (setting-value-label id (settings-value (settings-defaults) id)) (menu-row-value s id)))
                (settings-group 'general))
      (assert-equal 'item (menu-row-kind s 'back))
      (assert-true (<= (+ (cadr (menu-entry-rect s 6 VW VH)) ENTRY-H) 376)))
    (test "PULL and SCORING are not on it (they live in DEFRAG's overlay)"
      (assert-false (memq 'draw (menu-entries s)))
      (assert-false (memq 'scoring (menu-entries s))))
    (test "Enter on MUSIC steps it and the choice is (set music . off); right steps, left steps back; the row shows the value"
      (let* ((r1 (step s '(return)))
             (r2 (step (car r1) '(right)))
             (r3 (step (car r2) '(left))))
        (assert-equal '(set music . off) (cdr r1))
        (assert-equal "OFF" (menu-row-value (car r1) 'music))
        (assert-equal '(set music . on) (cdr r2))
        (assert-equal '(set music . off) (cdr r3))))
    (test "VOLUME steps down and wraps; the cosmetics step from their defaults"
      (let ((vol (step* s 'down 'down))
            (scan (step* s 'up 'up 'up 'up)))
        (assert-equal 'volume (list-ref (menu-entries vol) (menu-highlight vol)))
        (assert-equal '(set volume . 9) (cdr (step vol '(left))))
        (assert-equal '(set volume . 0) (cdr (step vol '(right))))
        (assert-equal 'scanlines (list-ref (menu-entries scan) (menu-highlight scan)))
        (assert-equal '(set scanlines . off) (cdr (step scan '(return))))))
    (test "a tap on a value row steps it forward"
      (let ((r (menu-step s (click-frame (center s 1)) VW VH)))
        (assert-equal '(set sfx . off) (cdr r))))
    (test "BACK closes to the top screen with SETTINGS highlighted"
      (let ((b (step (step* s 'up) '(return))))
        (assert-equal 'top (menu-screen (car b)))
        (assert-equal 'settings (list-ref (menu-entries (car b)) (menu-highlight (car b))))))))

(test-group "the table's overlay (ruling D51)"
  (let ((o (menu-new-overlay 'cards #f (settings-defaults) "3800008R8B" #t))
        (r (menu-new-overlay 'stack #t (settings-defaults) "19DHXVNFNW" #f)))
    (test "free play on DEFRAG: RESUME, GAME SETTINGS, SETTINGS, CODE, BACK TO MENU; a run on the stack: no GAME SETTINGS (the stack has no rows), DISCONNECT instead"
      (assert-equal 'pause (menu-screen o))
      (assert-equal 'pause (menu-home o))
      (assert-equal '(resume game-settings settings back-to-menu) (menu-entries o))
      (assert-equal '(resume settings disconnect) (menu-entries r))
      (assert-equal "PAUSED" (menu-heading o))
      (assert-true (menu-live? o)))
    (test "the exit row's note says what leaving keeps; the code is a line under the rows, inside the centered panel"
      (assert-false (menu-row-value o 'back-to-menu))
      (assert-equal "BOARD SAVED. CONTINUE RESUMES IT." (menu-row-note o 'back-to-menu))
      (assert-equal "RUN HELD. CONTINUE RESUMES THE LAYER." (menu-row-note r 'disconnect))
      (assert-equal 'item (menu-row-kind r 'disconnect))
      (let ((line (code-line-rect o VW VH))
            (last (menu-entry-rect o 3 VW VH)))
        (assert-true (and line #t))
        ;; a row's height of air under the last row, then the note, then the code
        (assert-equal (+ (cadr last) (cadddr last) UNDER-ROW-GAP NOTE-H) (cadr line))
        (assert-true (>= (- (cadr line) (+ (cadr last) (cadddr last))) ENTRY-H))
        (assert-true (> (menu-y-offset o) 0))))
    (test "Enter on RESUME resumes; Escape on the home screen resumes; Enter on the exit row is the exit choice"
      (assert-equal 'resume (cdr (step o '(return))))
      (assert-equal 'resume (cdr (step o '(escape))))
      (assert-equal 'back-to-menu (cdr (step (step* o 'up) '(return))))
      (assert-equal 'disconnect (cdr (step (step* r 'up) '(return)))))
    (test "a tap on the code line is COPY (the page writes the clipboard)"
      (let ((line (code-line-rect o VW VH)))
        (assert-equal 'copy (cdr (menu-step o (click-frame (cons (+ (car line) 10) (+ (cadr line) 5))) VW VH)))))
    (test "GAME SETTINGS on DEFRAG: PULL and SCORING with their NEXT DEAL note, BACK; a step is the (set ...) choice; BACK returns to the overlay"
      (let ((g (car (step (step* o 'down) '(return)))))
        (assert-equal 'pause-game (menu-screen g))
        (assert-equal '(draw scoring back) (menu-entries g))
        (assert-equal "NEXT DEAL" (menu-row-note g 'draw))
        (assert-equal "NEXT DEAL" (menu-row-note g 'scoring))
        (assert-equal '(set draw . 3) (cdr (step g '(return))))
        (let ((b (step (step* g 'up) '(return))))
          (assert-equal 'pause (menu-screen (car b)))
          (assert-equal 'game-settings (list-ref (menu-entries (car b)) (menu-highlight (car b)))))
        (assert-equal 'pause (menu-screen (car (step g '(escape)))))))
    (test "SETTINGS from the overlay is the general five and closes to the overlay"
      (let ((s (car (step (step* r 'down) '(return)))))
        (assert-equal 'settings (menu-screen s))
        (assert-equal '(music sfx volume scanlines veil background back) (menu-entries s))
        (assert-equal 'pause (menu-screen (car (step s '(escape)))))))
    (test "the rows sit at the sub-screen pitch shifted by the panel's centering offset, the panel's block centered on the board area"
      (assert-equal (+ SUB-ENTRIES-Y (menu-y-offset o)) (cadr (menu-entry-rect o 0 VW VH)))
      (assert-equal ENTRY-W (caddr (menu-entry-rect o 0 VW VH)))
      (let* ((top (+ HEADING-Y (- OVERLAY-PAD) (menu-y-offset o)))
             (line (code-line-rect o VW VH))
             (bot (+ (cadr line) (cadddr line) OVERLAY-PAD)))
        (assert-true (<= (abs (- (- 352 bot) top)) 1))))))

(test-group "CREDITS and SCORES"
  (let* ((c (car (step (menu-new TOP 'credits) '(return)))))
    (test "CREDITS: the crawl, no rows; it climbs at the crawl's pace, Down speeds it, Up backs it; Escape, Enter or a tap leaves"
      (assert-equal 'credits (menu-screen c))
      (assert-equal '() (menu-entries c))
      (assert-equal 0.0 (menu-scroll c))
      (let* ((c (menu-with-credits c (credits-parse "## T\nA\n[gap gap]\nB\n")))
             (a (car (menu-step c (frame '()) VW VH 1000.0)))
             (fast (car (menu-step c (make-input-frame '() '(down) #f) VW VH 1000.0)))
             (back (car (menu-step c (make-input-frame '() '(up) #f) VW VH 1000.0))))
        (assert-equal CRAWL-SPEED (menu-scroll a))
        (assert-equal CRAWL-FAST (menu-scroll fast))
        (assert-true (> (menu-scroll back) 0.0))   ; backwards from the start wraps to the end
        (assert-equal 'top (menu-screen (car (step c '(escape)))))
        (assert-equal 'top (menu-screen (car (step c '(return)))))
        (assert-equal 'top (menu-screen (car (menu-step c (click-frame (cons 320 200)) VW VH))))))
    (test "SCORES opens from FREE PLAY, BACK returns to the top screen"
      (let ((sc (car (step (step* (car (step (menu-new TOP 'free-play) '(return))) 'down 'down 'down 'down 'down) '(return)))))
        (assert-equal 'scores (menu-screen sc))
        (assert-equal "SCORES" (menu-heading sc))
        (assert-equal 'top (menu-screen (car (step sc '(escape)))))))))

(test-group "CODE"
  (let* ((f (car (step (menu-new TOP 'free-play) '(return))))
         (c (car (step (step* f 'down 'down 'down 'down) '(return))))
         (code (encode (spec-new 'cards 'original 3 'standard 'turtle 280))))
    (test "opens empty; typed letters and digits append in upper case, up to ten; the display dashes after five"
      (assert-equal 'code (menu-screen c))
      (assert-equal "" (menu-code c))
      (let ((typed (let loop ((m c) (cs (string->list (string-downcase code))))
                     (if (null? cs) m (loop (car (step m (list (string->symbol (string (car cs)))))) (cdr cs))))))
        (assert-equal code (menu-code typed))
        (assert-equal (code-display code) (menu-code-display typed))
        (assert-equal code (menu-code (car (step typed '(a)))))   ; full: nothing more
        (assert-equal (substring code 0 9) (menu-code (car (step typed '(backspace)))))
        ;; GO reads it
        (let ((r (step typed '(return))))
          (assert-true (pair? (cdr r)))
          (assert-equal 'code (car (cdr r)))
          (assert-true (spec-equal? (spec-new 'cards 'original 3 'standard 'turtle 280) (cdr (cdr r)))))))
    (test "a letter outside the alphabet (I, L, O, U) and the navigation keys type nothing"
      (assert-equal "" (menu-code (car (step c '(i)))))
      (assert-equal "" (menu-code (car (step c '(o)))))
      (assert-equal "" (menu-code (car (step c '(down)))))
      (assert-equal "" (menu-code (car (step c '(space))))))
    (test "a corrupted code is refused: the choice is code-refused and the text stays"
      (let* ((bad (string-append (substring code 0 9) (if (char=? (string-ref code 9) #\0) "1" "0")))
             (typed (let loop ((m c) (cs (string->list bad)))
                      (if (null? cs) m (loop (car (step m (list (string->symbol (string (char-downcase (car cs))))))) (cdr cs)))))
             (r (step typed '(return))))
        (assert-equal 'code-refused (cdr r))
        (assert-equal bad (menu-code (car r)))))
    (test "the keypad: 34 cells (the alphabet, DEL, GO) inside the screen, none overlapping; a tap types, DEL deletes, GO reads"
      (let ((cells (keypad-cells VW VH)))
        (assert-equal 34 (length cells))
        (for-each (lambda (cell)
                    (let ((r (cdr cell)))
                      (assert-true (>= (car r) 0))
                      (assert-true (<= (+ (car r) (caddr r)) VW))
                      (assert-true (<= (+ (cadr r) (cadddr r)) TEXT-ROWS-Y))))
                  cells)
        (let loop ((cs cells))
          (unless (null? cs)
            (for-each (lambda (o)
                        (let ((a (cdr (car cs))) (b (cdr o)))
                          (assert-true (or (>= (car b) (+ (car a) (caddr a))) (>= (car a) (+ (car b) (caddr b)))
                                           (>= (cadr b) (+ (cadr a) (cadddr a))) (>= (cadr a) (+ (cadr b) (cadddr b)))))))
                      (cdr cs))
            (loop (cdr cs))))
        (let* ((tap (lambda (m label)
                      (let ((r (keypad-rect label VW VH)))
                        (menu-step m (click-frame (cons (+ (car r) 3) (+ (cadr r) 3))) VW VH))))
               (m1 (car (tap c "7")))
               (m2 (car (tap m1 "Z")))
               (m3 (car (tap m2 "DEL"))))
          (assert-equal "7Z" (menu-code m2))
          (assert-equal "7" (menu-code m3))
          (assert-equal 'code-refused (cdr (tap m3 "GO")))
          (let ((full (let loop ((m c) (cs (string->list code)))
                        (if (null? cs) m (loop (car (tap m (string (car cs)))) (cdr cs))))))
            (assert-equal 'code (car (cdr (tap full "GO"))))))))
    (test "Escape closes the CODE screen to the top screen"
      (assert-equal 'top (menu-screen (car (step c '(escape))))))))
