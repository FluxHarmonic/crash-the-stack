;;; Gate leg 7 (P2) - input parity on the card table.
;;;
;;; One known move on the fixture deal (S2 from pile 0 onto D3 on pile
;;; 2), made two ways: a tap at each place's center, and the tags (the
;;; tag of each place, typed letter by letter). Both must leave the game
;;; in the same state after the first pick (S2 selected, nothing moved)
;;; and after the second (the move made), and the same as two direct
;;; game-select calls. A second scenario picks S2 and then an illegal
;;; destination (H6 on pile 1), where the right answer is a changed
;;; selection and no move. A third draws from the stock both ways. (A
;;; third way, Cybersol's pile letters, was dropped on 2026-09-18.)

(import (sigil test)
        (sigil math)
        (crash input)
        (crash cards deck)
        (crash cards rules)
        (crash cards geometry)
        (crash cards input))

(define VW 640)
(define VH 400)
(define geom (make-card-geometry VW VH))

(define (frame pressed) (make-input-frame pressed '() #f))
(define (click-frame xy) (make-input-frame '() '() xy))

(define (fresh)
  (deal-restore 1 (game-from-deck (deck-string->cards FIXTURE-DECK) 1) #t))

(define (canon d) (game-canonical (deal-game d)))

;; --- the three ways of tapping one place -------------------------------------

(define (by-tap d place)
  (deal-step d (click-frame (place-center geom (deal-game d) place)) geom))

(define (by-tags d place)
  (case (car place)
    ((stock) (deal-step d (frame (list STOCK-KEY)) geom))
    ((waste) (deal-step d (frame (list WASTE-KEY)) geom))
    (else
     (let ((entry (find (lambda (e) (equal? (car e) place)) (deal-labels d))))
       (unless entry (error "no tag for place" place))
       (let loop ((chars (string->list (cdr entry))) (d d))
         (if (null? chars)
             d
             (loop (cdr chars)
                   (deal-step d (frame (list (string->symbol (string (car chars))))) geom))))))))


(define SRC '(pile 0 0))
(define DST '(pile 2 0))

(define direct-1 (game-select (deal-game (fresh)) SRC))
(define direct-2 (game-select direct-1 DST))

(test-group "the direct calls are the reference"
  (test "S2 is selected, then moved onto D3"
    (assert-equal SRC (game-selected direct-1))
    (assert-equal '() (game-pile direct-2 0))
    (assert-equal "S2" (card-string (pile-card (car (game-pile direct-2 2)))))
    (assert-equal 1 (game-moves direct-2))))

(define (parity name way)
  (test-group (string-append "parity: " name)
    (let* ((d0 (fresh))
           (d1 (way d0 SRC))
           (d2 (way d1 DST)))
      (test "the first pick selects S2 and moves nothing"
        (assert-equal (game-canonical direct-1) (canon d1))
        (assert-equal 0 (game-moves (deal-game d1))))
      (test "the second makes the move"
        (assert-equal (game-canonical direct-2) (canon d2))
        (assert-equal 1 (game-moves (deal-game d2)))))))

(parity "tap" by-tap)
(parity "tags" by-tags)

(test-group "an illegal destination changes the selection, not the table"
  (let ((direct (game-select direct-1 '(pile 1 0))))
    (test "the reference: H6 becomes the selection, no move"
      (assert-equal '(pile 1 0) (game-selected direct))
      (assert-equal 0 (game-moves direct)))
    (for-each (lambda (entry)
                (let* ((name (car entry)) (way (cadr entry))
                       (d (way (way (fresh) SRC) '(pile 1 0))))
                  (test (string-append name ": the same")
                    (assert-equal (game-canonical direct) (canon d)))))
              (list (list "tap" by-tap)
                    (list "tags" by-tags)))))

(test-group "the stock three ways"
  (let ((direct (game-select (deal-game (fresh)) '(stock))))
    (for-each (lambda (entry)
                (let* ((name (car entry)) (way (cadr entry))
                       (d (way (fresh) '(stock))))
                  (test (string-append name ": one card drawn")
                    (assert-equal (game-canonical direct) (canon d))
                    (assert-equal '("S7") (map card-string (game-waste (deal-game d)))))))
              (list (list "tap" by-tap)
                    (list "tags" by-tags)))))

(test-group "the keys"
  (test "Tab changes nothing (there is one key model now)"
    (let* ((d (fresh))
           (d1 (deal-step d (frame '(tab)) geom)))
      (assert-equal (canon d) (canon d1))
      (assert-equal (deal-labels d) (deal-labels d1))))
  (test "Enter deselects"
    (let ((d (by-tags (fresh) SRC)))
      (assert-false (game-selected (deal-game (deal-step d (frame '(return)) geom))))))
  (test "Space hides the tags, and a tag typed while hidden does nothing"
    (let* ((d (deal-step (fresh) (frame '(space)) geom))
           (d1 (by-tags d SRC)))
      (assert-false (deal-labels-shown d))
      (assert-false (game-selected (deal-game d1)))))
  (test "Backspace undoes when nothing is typed"
    (let* ((d (by-tags (by-tags (fresh) SRC) DST))
           (d1 (deal-step d (frame '(backspace)) geom)))
      (assert-equal 1 (game-moves (deal-game d)))
      (assert-equal 0 (game-moves (deal-game d1)))))
  (test "the stock and the waste keep their index-finger keys; no tag starts with them"
    (let* ((d (by-tags (fresh) '(stock)))
           (labels (deal-labels d)))
      (assert-equal 1 (length (game-waste (deal-game d))))
      (assert-equal 'f STOCK-KEY)
      (assert-equal 'j WASTE-KEY)
      (assert-false (assoc '(stock) labels))
      (assert-false (assoc '(waste) labels))
      (assert-true (every (lambda (e) (not (memv (string-ref (cdr e) 0) '(#\f #\j)))) labels))
      (assert-equal '(waste) (game-selected (deal-game (by-tags d '(waste)))))))
  (test "every place has a distinct tag"
    (let* ((labels (deal-labels (fresh)))
           (tags (map cdr labels)))
      (assert-equal (length (deal-places (deal-game (fresh)))) (length labels))
      (assert-true (let loop ((ts tags))
                     (cond ((null? ts) #t)
                           ((member (car ts) (cdr ts)) #f)
                           (else (loop (cdr ts)))))))))
