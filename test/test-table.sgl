;;; The table record (t-90ec6b): tables-check, which the shells say at
;;; boot and the arm asserts, answers '() for a complete set and names
;;; every unwired field and every missing table (the design's S13: a field
;;; left unwired is red before any play).

(import (sigil test)
        (sigil list)
        (crash table))

(define (noop . args) #f)

;; A record with every field wired to a procedure.
(define (complete name)
  (table-kind name: name
              board?: noop live?: noop tick: noop draw: noop hud-h: noop
              ticks: noop trace: noop seed: noop bar-hit: noop code: noop
              open: noop hold!: noop deselect!: noop prepare!: noop cascading?: noop))

(define ALL (map complete TABLE-NAMES))

(test-group "the table record"
  (test "the three tables, every field wired: complete"
    (assert-equal '() (tables-check ALL)))
  (test "every field is checked: unwiring each one alone is named"
    (for-each (lambda (f)
                (let* ((k (complete 'stack))
                       (broken (cond ((eq? (car f) 'board?) (table-kind k board?: #f))
                                     ((eq? (car f) 'live?) (table-kind k live?: #f))
                                     ((eq? (car f) 'tick) (table-kind k tick: #f))
                                     ((eq? (car f) 'draw) (table-kind k draw: #f))
                                     ((eq? (car f) 'hud-h) (table-kind k hud-h: #f))
                                     ((eq? (car f) 'ticks) (table-kind k ticks: #f))
                                     ((eq? (car f) 'trace) (table-kind k trace: #f))
                                     ((eq? (car f) 'seed) (table-kind k seed: #f))
                                     ((eq? (car f) 'bar-hit) (table-kind k bar-hit: #f))
                                     ((eq? (car f) 'code) (table-kind k code: #f))
                                     ((eq? (car f) 'open) (table-kind k open: #f))
                                     ((eq? (car f) 'hold!) (table-kind k hold!: #f))
                                     ((eq? (car f) 'deselect!) (table-kind k deselect!: #f))
                                     ((eq? (car f) 'prepare!) (table-kind k prepare!: #f))
                                     ((eq? (car f) 'cascading?) (table-kind k cascading?: #f))
                                     (else k))))
                  (assert-equal (list (list 'stack (car f)))
                                (tables-check (cons broken (cdr ALL))))))
              TABLE-FIELDS))
  (test "a table with no record is named"
    (assert-equal (list (list 'missing 'scan)) (tables-check (list (complete 'stack) (complete 'cards)))))
  (test "table-of finds a record by name, and #f for a screen that is not a table"
    (assert-eq 'cards (table-kind-name (table-of ALL 'cards)))
    (assert-false (table-of ALL 'hub))))
