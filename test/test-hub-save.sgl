;;; A hub run as a datum (P5 phase 2, step 5): the round trip through the
;;; store, a run mid-layer with a board up, the memory's run-length
;;; encoding, and what is refused.

(import (sigil test)
        (sigil fs)
        (sigil math)
        (sigil time)
        (sigil process)
        (crash input)
        (crash store)
        (crash hub world)
        (crash hub gen)
        (crash hub rules)
        (crash hub text)
        (crash hub screen)
        (crash hub save))

(define ROOT (string-append "/tmp/crash-hub-save-test-" (number->string (exact (floor (current-second))))))
(set-store-root! ROOT)
(when (directory-exists? ROOT) (process-run "rm" "-rf" ROOT))

(define IDLE (make-input-frame '() '() #f))
(define (frame . pressed) (make-input-frame pressed '() #f))
(define (idle hs dt n) (if (= n 0) hs (idle (hub-screen-tick hs dt IDLE) dt (- n 1))))

(define (same-world? a b)
  (and (= (world-run-seed a) (world-run-seed b))
       (= (world-depth a) (world-depth b))
       (= (world-attempt a) (world-attempt b))
       (= (runner-cell (world-runner a)) (runner-cell (world-runner b)))
       (equal? (map (lambda (n) (list (node-index n) (node-state n) (node-attempts n))) (world-nodes a))
               (map (lambda (n) (list (node-index n) (node-state n) (node-attempts n))) (world-nodes b)))
       (equal? (map (lambda (d) (list (daemon-cell d) (daemon-facing d) (daemon-step d) (daemon-alert d) (daemon-hunting d))) (world-daemons a))
               (map (lambda (d) (list (daemon-cell d) (daemon-facing d) (daemon-step d) (daemon-alert d) (daemon-hunting d))) (world-daemons b)))
       (equal? (world-keys a) (world-keys b))
       (equal? (world-opened a) (world-opened b))
       (equal? (world-taken a) (world-taken b))
       (equal? (world-inventory a) (world-inventory b))
       (= (world-credits a) (world-credits b))
       (= (world-layer-credits a) (world-layer-credits b))
       (= (world-trace a) (world-trace b))
       (= (world-beat a) (world-beat b))
       (eq? (world-request a) (world-request b))
       (equal? (vector->list (world-seen a)) (vector->list (world-seen b)))
       (equal? (layer->text (world-layer a)) (layer->text (world-layer b)))))

(test-group "hub save: the memory's runs"
  (test "a seen vector round-trips through its runs, edges included"
    (for-each (lambda (l)
                (let ((v (list->vector l)))
                  (assert-equal l (vector->list (runs->seen (seen->runs v) (length l))))))
              (list '() '(#f) '(#t) '(#t #t #f) '(#f #f #t #t #f #t) '(#t #f #t #f #t)))
    (assert-equal '(0 3) (seen->runs (vector #t #t #t)))
    (assert-equal '(2 1 2) (seen->runs (vector #f #f #t #f #f)))))

(test-group "hub save: the round trip"
  (test "a run twelve beats in, walked and hunting, comes back the same through the store"
    (let* ((hs (hub-screen-with-bpm (hub-screen-new 5) 120))
           (hs (hub-screen-tick hs 500.0 (frame 'right)))
           (hs (idle hs 500.0 11))
           (hs (hub-screen hs world: (world (hub-screen-world hs) inventory: (list (cons 'cloak 2) (cons 'peek 1)) credits: 40 layer-credits: 15))))
      (hub-save! hs)
      (let ((back (hub-load)))
        (assert-true (and back #t))
        (assert-true (same-world? (hub-screen-world hs) (hub-screen-world back)))
        (assert-equal 120 (hub-screen-bpm-pin back))
        (assert-equal (hub-screen-beats hs) (hub-screen-beats back))
        (assert-false (hub-screen-panel back))
        ;; and it runs on: the same beat stepped twice from either side agrees
        (assert-true (same-world? (hub-screen-world (idle hs 500.0 3)) (hub-screen-world (idle back 500.0 3)))))))
  (test "a run with a board up keeps the launch request; a severed layer comes back on its panel; the end on its"
    (let* ((hs (hub-screen-with-bpm (hub-screen-new 7) 120))
           (n (car (world-nodes (hub-screen-world hs))))
           (w (world (hub-screen-world hs) runner: (runner cell: (node-cell n))))
           (hs (hub-screen hs world: w prev: w))
           (hs (hub-screen-tick hs 500.0 (frame 'return))))
      (assert-equal 'launch (hub-screen-request hs))
      (hub-save! (cdr (hub-screen-take-request hs)))
      (let ((back (hub-load)))
        (assert-equal 'launch (world-request (hub-screen-world back)))
        (assert-false (hub-screen-request back))
        (assert-true (and (hub-launch (hub-screen-world back) 1 'vegas) #t))))
    (let* ((hs (hub-screen-with-bpm (hub-screen-new 7) 120))
           (budget (descriptor-budget (descriptor-at 1)))
           (hs (hub-screen hs world: (world (hub-screen-world hs) trace: (- budget 1))))
           (hs (hub-screen-tick hs 500.0 IDLE)))
      (assert-equal 'severed (hub-screen-panel hs))
      (hub-save! hs)
      (let ((back (hub-load)))
        (assert-equal 'severed (hub-screen-panel back))
        (assert-equal 'severed (world-request (hub-screen-world back))))))
  (test "what is refused: no run, another version, a runner off the layer, a key that is no color"
    (hub-clear!)
    (assert-false (hub-load))
    (store-write-datum! RUN-KEY (list 'crash-run 1 (cons 'seed 3)))
    (assert-false (hub-load))
    (let* ((hs (hub-screen-new 5))
           (d (hub-screen->datum hs))
           (patch (lambda (name value)
                    (map (lambda (e) (if (and (pair? e) (eq? (car e) name)) (cons name value) e)) d))))
      (store-write-datum! RUN-KEY (patch 'runner (list 999999 'up 0)))
      (assert-false (hub-load))
      (store-write-datum! RUN-KEY (patch 'keys (list 'mauve)))
      (assert-false (hub-load))
      (store-write-datum! RUN-KEY (patch 'depth 9))
      (assert-false (hub-load))
      (store-write-datum! RUN-KEY d)
      (assert-true (and (hub-load) #t)))))
