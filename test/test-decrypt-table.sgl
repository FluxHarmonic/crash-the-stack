;;; DECRYPT's table ((crash decrypt table)): the controls (swipe, tap then
;;; tap, mouse click-click and drag, the keyboard cursor with Space then an
;;; arrow), a refused swap, a whole move to rest, the DAILY's 40 moves and
;;; its record, the pause, REKEY, and the chains' heat.

(import (sigil test)
        (sigil list)
        (crash decrypt rules)
        (crash decrypt record)
        (crash decrypt table))

(define (fr now pressed events) (make-decrypt-frame pressed events now))

;; a cell's center in virtual pixels
(define (cx i) (+ BOARD-X (* CELL (modulo i 8)) (quotient CELL 2)))
(define (cy i) (+ BOARD-Y (* CELL (quotient i 8)) (quotient CELL 2)))

;; step frames of 16 ms from `now` until the table is idle (or over), at most n
(define (settle t now n)
  (let loop ((t t) (now now) (k 0))
    (if (or (>= k n) (and (> k 0) (memq (decrypt-table-phase t) '(idle over))))
        (cons t now)
        (loop (decrypt-step t (fr now '() '())) (+ now 16.0) (+ k 1)))))

(define (open) (decrypt-step (decrypt-open 'endless 7 #f #f) (fr 1000.0 '() '())))
(define (a-move t) (find-move (dboard-cells (decrypt-table-board t))))

;; the frame after a gesture: did a swap of (i j) start?
(define (swapping? t i j)
  (and (eq? (decrypt-table-phase t) 'swap)
       (let ((s (decrypt-table-swap t)))
         (or (and (= (car s) i) (= (cadr s) j)) (and (= (car s) j) (= (cadr s) i))))))

(define (direction i j)
  (cond ((= j (+ i 1)) (cons 20 0)) ((= j (- i 1)) (cons -20 0))
        ((= j (+ i 8)) (cons 0 20)) (else (cons 0 -20))))

(test-group "decrypt table: the controls"
  (test "a swipe toward a neighbor swaps (touch)"
    (let* ((t (open)) (m (a-move t)) (i (car m)) (j (cdr m)) (d (direction i j))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx i) (cy i) 'touch)
                                                  (list 'move (+ (cx i) (car d)) (+ (cy i) (cdr d))))))))
      (assert-true (swapping? t i j))))
  (test "a mouse drag swaps the same way"
    (let* ((t (open)) (m (a-move t)) (i (car m)) (j (cdr m)) (d (direction i j))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx i) (cy i) 'left)))))
           (t (decrypt-step t (fr 1032.0 '() (list (list 'move (+ (cx i) (quotient (car d) 2)) (+ (cy i) (quotient (cdr d) 2)))))))
           (_ (assert-equal 'idle (decrypt-table-phase t)))   ; 10 px: not yet a swipe
           (t (decrypt-step t (fr 1048.0 '() (list (list 'move (+ (cx i) (car d)) (+ (cy i) (cdr d))))))))
      (assert-true (swapping? t i j))))
  (test "tap then tap on a neighbor swaps (touch, and mouse click-click)"
    (for-each
     (lambda (button)
       (let* ((t (open)) (m (a-move t)) (i (car m)) (j (cdr m))
              (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx i) (cy i) button) (list 'up (cx i) (cy i) button)))))
              (_ (assert-equal i (decrypt-table-sel t)))
              (t (decrypt-step t (fr 1032.0 '() (list (list 'down (cx j) (cy j) button) (list 'up (cx j) (cy j) button))))))
         (assert-true (swapping? t i j))
         (assert-false (decrypt-table-sel t))))
     '(touch left)))
  (test "a tap on a cell that is not a neighbor moves the selection; a tap on the selected cell clears it"
    (let* ((t (open))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx 0) (cy 0) 'touch) (list 'up (cx 0) (cy 0) 'touch)))))
           (t (decrypt-step t (fr 1032.0 '() (list (list 'down (cx 20) (cy 20) 'touch) (list 'up (cx 20) (cy 20) 'touch))))))
      (assert-equal 'idle (decrypt-table-phase t))
      (assert-equal 20 (decrypt-table-sel t))
      (let ((t (decrypt-step t (fr 1048.0 '() (list (list 'down (cx 20) (cy 20) 'touch) (list 'up (cx 20) (cy 20) 'touch))))))
        (assert-false (decrypt-table-sel t)))))
  (test "the keyboard: arrows (and h j k l) move the cursor; Space then an arrow swaps"
    (let* ((t (open)) (m (a-move t)) (i (car m)) (j (cdr m))
           ;; walk the cursor from 27 to i with arrows
           (walk (lambda (t from to)
                   (let* ((dx (- (modulo to 8) (modulo from 8)))
                          (dy (- (quotient to 8) (quotient from 8)))
                          (keys (append (make-list (abs dx) (if (> dx 0) 'l 'h))
                                        (make-list (abs dy) (if (> dy 0) 'down 'up)))))
                     (decrypt-step t (fr 1016.0 keys '())))))
           (t (walk t 27 i))
           (_ (assert-equal i (decrypt-table-cursor t)))
           (key (cond ((= j (+ i 1)) 'right) ((= j (- i 1)) 'left) ((= j (+ i 8)) 'j) (else 'k)))
           (t (decrypt-step t (fr 1032.0 (list 'space) '())))
           (_ (assert-true (decrypt-table-armed t)))
           (t (decrypt-step t (fr 1048.0 (list key) '()))))
      (assert-true (swapping? t i j))
      (assert-equal j (decrypt-table-cursor t))))
  (test "Space and the arrow in one frame (Space held as the arrow goes down) swap too"
    (let* ((t (open)) (m (a-move t)) (i (car m)) (j (cdr m))
           (t (decrypt-table t cursor: i))
           (key (cond ((= j (+ i 1)) 'right) ((= j (- i 1)) 'left) ((= j (+ i 8)) 'down) (else 'up)))
           (t (decrypt-step t (fr 1016.0 (list 'space key) '()))))
      (assert-true (swapping? t i j)))))

(test-group "decrypt table: moves"
  (test "a refused swap swaps back, costs no move and sounds a mismatch"
    ;; the diagonal board has no move at all
    (let* ((t (open))
           (diag (list->vector (map (lambda (i) (modulo (+ (modulo i 8) (quotient i 8)) 6)) (iota 64))))
           (t (decrypt-table t board: (dboard-with-cells (decrypt-table-board t) diag)))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx 9) (cy 9) 'touch) (list 'move (+ (cx 9) 20) (cy 9))))))
           (t (decrypt-step t (fr (+ 1016.0 SWAP-MS 1) '() '()))))
      (assert-equal 'unswap (decrypt-table-phase t))
      (assert-true (assoc 'mismatch (decrypt-cues t)))
      (let ((r (settle t 1200.0 100)))
        (assert-equal 'idle (decrypt-table-phase (car r)))
        (assert-equal 0 (decrypt-table-moves (car r)))
        (assert-equal diag (dboard-cells (decrypt-table-board (car r)))))))
  (test "a move runs to rest: a move counted, points scored, the board settled with a move, a ping on the beat"
    (let* ((t (open)) (m (a-move t)) (i (car m)) (j (cdr m)) (d (direction i j))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx i) (cy i) 'touch) (list 'move (+ (cx i) (car d)) (+ (cy i) (cdr d)))))))
           ;; collect every cue on the way
           (r (let loop ((t t) (now 1032.0) (cues '()) (k 0))
                (if (or (> k 400) (and (> k 2) (eq? (decrypt-table-phase t) 'idle)))
                    (list t cues)
                    (let ((t (decrypt-step t (fr now '() '()))))
                      (loop t (+ now 16.0) (append cues (decrypt-cues t)) (+ k 1))))))
           (t (car r)) (cues (cadr r)))
      (assert-equal 1 (decrypt-table-moves t))
      (assert-true (> (decrypt-table-score t) 0))
      (assert-true (has-move? (dboard-cells (decrypt-table-board t))))
      (assert-false (board-matches? (dboard-cells (decrypt-table-board t))))
      (assert-equal (cons 'ping-1 #t) (car cues)))))

(test-group "decrypt table: the DAILY, the pause, REKEY, the heat"
  (test "the DAILY ends after 40 moves: the panel, the record's day, best and streak"
    (let* ((rec (drecord day: 99 day-best: 10 streak: 3))
           (t (decrypt-step (decrypt-open 'daily 555 100 rec) (fr 1000.0 '() '()))))
      (let loop ((t t) (now 1016.0) (k 0) (saved #f))
        (if (or (= k 60) (eq? (decrypt-table-phase t) 'over))
            (begin
              (assert-equal 'over (decrypt-table-phase t))
              (assert-equal 40 (decrypt-table-moves t))
              (assert-equal 0 (decrypt-moves-left t))
              (assert-true saved)
              (assert-equal 100 (drecord-day (decrypt-table-record t)))
              (assert-equal 4 (drecord-streak (decrypt-table-record t)))
              (assert-equal (decrypt-table-score t) (drecord-day-best (decrypt-table-record t)))
              (assert-equal '("RETRY DAILY" "TIMED" "JACK OUT") (map cadr (decrypt-panel-rows t)))
              ;; the panel's fade runs on the table clock: it must go on after the end
              (let ((t2 (decrypt-step (decrypt-step t (fr (+ now 16.0) '() '())) (fr (+ now 300.0) '() '()))))
                (assert-true (>= (- (decrypt-table-ms t2) (decrypt-table-panel-at t2)) 200))))
            (let* ((m (a-move t)) (i (car m)) (j (cdr m)) (d (direction i j))
                   (t (decrypt-step t (fr now '() (list (list 'down (cx i) (cy i) 'touch) (list 'move (+ (cx i) (car d)) (+ (cy i) (cdr d)))))))
                   (r (let run ((t t) (now (+ now 16.0)) (n 0) (saved saved))
                        (if (or (> n 400) (memq (decrypt-table-phase t) '(idle over)))
                            (list t now saved)
                            (let ((t (decrypt-step t (fr now '() '()))))
                              (run t (+ now 16.0) (+ n 1) (or saved (and (memq 'save (decrypt-requests t)) #t))))))))
              (loop (car r) (cadr r) (+ k 1) (caddr r)))))))
  (test "Escape pauses: the clock holds, a tap does nothing to the board, RESUME by keys"
    (let* ((t (open))
           (t (decrypt-step t (fr 1016.0 (list 'escape) '())))
           (ms (decrypt-table-ms t)))
      (assert-true (decrypt-table-paused t))
      (let* ((t (decrypt-step t (fr 5000.0 '() (list (list 'down (cx 0) (cy 0) 'touch))))))
        (assert-equal ms (decrypt-table-ms t))
        (assert-false (decrypt-table-sel t))
        (let ((t (decrypt-step t (fr 5016.0 (list 'return) '()))))   ; row 0 is RESUME
          (assert-false (decrypt-table-paused t))))))
  (test "a press held through a pause does not swipe after it (the review's MED 2)"
    (let* ((t (open))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx 20) (cy 20) 'left)))))
           (t (decrypt-step t (fr 1032.0 (list 'escape) '())))
           (t (decrypt-step t (fr 1048.0 '() (list (list 'up (cx 20) (cy 20) 'left)))))
           (t (decrypt-step t (fr 1064.0 (list 'escape) '())))
           ;; native order: the move before the next press
           (t (decrypt-step t (fr 1080.0 '() (list (list 'move (cx 22) (cy 22)) (list 'down (cx 22) (cy 22) 'left))))))
      (assert-false (decrypt-table-paused t))
      (assert-equal 'idle (decrypt-table-phase t))
      (assert-equal 22 (decrypt-table-sel t))))
  (test "ENDLESS: a new best is saved as the move comes to rest"
    (let* ((t (open)) (m (a-move t)) (i (car m)) (j (cdr m)) (d (direction i j))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx i) (cy i) 'touch) (list 'move (+ (cx i) (car d)) (+ (cy i) (cdr d)))))))
           (r (let loop ((t t) (now 1032.0) (saved #f) (k 0))
                (if (or (> k 400) (and (> k 2) (eq? (decrypt-table-phase t) 'idle)))
                    (cons t saved)
                    (let ((t (decrypt-step t (fr now '() '()))))
                      (loop t (+ now 16.0) (or saved (and (memq 'save (decrypt-requests t)) #t)) (+ k 1)))))))
      (assert-true (cdr r))
      (assert-equal (decrypt-table-score (car r)) (drecord-best (decrypt-table-record (car r))))))
  (test "the PAUSE button pauses on a tap; JACK OUT asks for the menu"
    (let* ((t (open))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down 20 12 'touch)))))
           (_ (assert-true (decrypt-table-paused t)))
           (t (decrypt-step t (fr 1032.0 (list 'down 'down 'return) '()))))
      (assert-true (memq 'quit (decrypt-requests t)))))
  (test "a settled board with no move REKEYs: the same glyphs, a move, a toast and the shuffle cue"
    (let* ((t (open))
           (diag (dboard-with-cells (decrypt-table-board t)
                                    (list->vector (map (lambda (i) (modulo (+ (modulo i 8) (quotient i 8)) 6)) (iota 64)))))
           (t (decrypt-table t phase: 'fall phase-ms: (decrypt-table-ms t) level: 1 fall: (dfall board: diag drops: '())))
           (t (decrypt-step t (fr 1200.0 '() '()))))
      (assert-equal 'rekey (decrypt-table-phase t))
      (assert-true (assoc 'shuffle (decrypt-cues t)))
      (assert-equal "REKEY." (decrypt-table-toast t))
      (assert-true (has-move? (dboard-cells (decrypt-table-board t))))
      (assert-equal (list-sort < (vector->list (dboard-cells diag)))
                    (list-sort < (vector->list (dboard-cells (decrypt-table-board t)))))))
  (test "the heat: tense from 5, calm again under 1.5, cooling a unit a second"
    (let* ((t (decrypt-table (open) heat: 5.2))
           (t (decrypt-step t (fr 1016.0 '() '()))))
      (assert-true (decrypt-hot? t))
      (let ((r (let loop ((t t) (now 1032.0)) (if (> now 4200.0) t (loop (decrypt-step t (fr now '() '())) (+ now 16.0))))))
        (assert-true (decrypt-hot? r))                   ; 3.2 s later: 2.0, still above COOL
        (let ((r (let loop ((t r) (now 4216.0)) (if (> now 5000.0) t (loop (decrypt-step t (fr now '() '())) (+ now 16.0))))))
          (assert-false (decrypt-hot? r)))))))

(test-group "decrypt record"
  (test "the streak: the next day grows it, a gap resets it, the same day keeps the best"
    (let* ((r (record-daily (empty-record) 10 500)))
      (assert-equal 1 (drecord-streak r))
      (assert-equal 2 (drecord-streak (record-daily r 11 100)))
      (assert-equal 1 (drecord-streak (record-daily r 13 100)))
      (assert-equal 700 (drecord-day-best (record-daily r 10 700)))
      (assert-equal 500 (drecord-day-best (record-daily r 10 300)))
      (assert-equal 1 (record-streak-on r 11))
      (assert-equal 0 (record-streak-on r 12))))
  (test "the record round-trips as a datum; junk reads empty"
    (let ((r (drecord best: 900 day: 12 day-best: 300 streak: 2)))
      (assert-equal (record->datum r) (record->datum (datum->record (record->datum r))))
      (assert-equal 0 (drecord-best (datum->record '(junk))))))
  (test "ENDLESS keeps its best"
    (assert-equal 900 (drecord-best (record-endless (drecord best: 900) 400)))
    (assert-equal 950 (drecord-best (record-endless (drecord best: 900) 950)))))

;; a board with no run: kinds 4 and 5 in a checkerboard, row 3 replaced
(define (checker-board row3)
  (list->vector (map (lambda (i)
                       (if (and (= (quotient i 8) 3) (< (modulo i 8) (length row3)))
                           (list-ref row3 (modulo i 8))
                           (+ 4 (modulo (+ (modulo i 8) (quotient i 8)) 2))))
                     (iota 64))))

(define (open-timed) (decrypt-step (decrypt-open 'timed 7 #f #f) (fr 1000.0 '() '())))
(define (run-frames t from to)
  (let loop ((t t) (now from)) (if (> now to) t (loop (decrypt-step t (fr now '() '())) (+ now 16.0)))))

(test-group "decrypt table: TIMED (David, 2026-09-29)"
  (test "TIMED opens with 90 s; the clock runs on the table clock and a pause holds it"
    (let* ((t (open-timed))
           (_ (assert-true (= TIMED-MS (decrypt-table-time-left t))))   ; numerically: the first frame makes it a float
           (t (run-frames t 1016.0 2000.0)))
      (assert-true (< (decrypt-table-time-left t) (- TIMED-MS 900)))
      (let* ((left (decrypt-table-time-left t))
             (t (decrypt-step t (fr 2016.0 (list 'escape) '())))
             (t (run-frames t 2032.0 6000.0)))
        (assert-true (decrypt-table-paused t))
        ;; only the Escape frame itself (24 ms after the last) runs; nothing while paused
        (assert-true (<= (abs (- left (decrypt-table-time-left t))) 30)))))
  (test "out of time on a still board: TIME'S UP, the best recorded and saved, PLAY AGAIN first"
    (let* ((t (decrypt-table (open-timed) time-left: 50 score: 1234))
           (r (let loop ((t t) (now 1016.0) (saved #f) (k 0))
                (if (or (= k 20) (eq? (decrypt-table-phase t) 'over))
                    (cons t saved)
                    (let ((t (decrypt-step t (fr now '() '()))))
                      (loop t (+ now 16.0) (or saved (and (memq 'save (decrypt-requests t)) #t)) (+ k 1))))))
           (t (car r)))
      (assert-equal 'over (decrypt-table-phase t))
      (assert-true (cdr r))
      (assert-equal 1234 (drecord-timed-best (decrypt-table-record t)))
      (assert-equal "TIME'S UP" (decrypt-panel-title t))
      (assert-equal '("PLAY AGAIN" "DAILY BOARD" "JACK OUT") (map cadr (decrypt-panel-rows t)))
      (assert-true (memq 'timed (decrypt-requests (decrypt-step t (fr 2000.0 (list 'return) '())))))))
  (test "out of time mid-move: no new swap starts; the move in play settles and scores, then the end"
    (let* ((t (open-timed)) (m (a-move t)) (i (car m)) (j (cdr m)) (d (direction i j))
           (t (decrypt-step t (fr 1016.0 '() (list (list 'down (cx i) (cy i) 'touch) (list 'move (+ (cx i) (car d)) (+ (cy i) (cdr d)))))))
           (t (decrypt-table t time-left: 30))
           (t (run-frames t 1032.0 4000.0)))
      (assert-equal 'over (decrypt-table-phase t))
      (assert-equal 1 (decrypt-table-moves t))
      (assert-true (> (decrypt-table-score t) 0))
      ;; and a swap after the end is refused: nothing moves
      (let ((t2 (decrypt-step (decrypt-table t phase: 'idle) (fr 4100.0 '() (list (list 'down (cx i) (cy i) 'touch) (list 'move (+ (cx i) (car d)) (+ (cy i) (cdr d))))))))
        (assert-false (eq? (decrypt-table-phase t2) 'swap)))))
  (test "a cascade's second link buys a second, a special made two: +3 s for a BURST at level 2"
    (let* ((t (open-timed))
           ;; by hand: 1000 x (2 - 1) for the link + 2000 for the BURST = 3000
           (b (dboard-with-cells (decrypt-table-board t) (checker-board (list 1 1 1 1)))))
      (let* ((t (decrypt-table t phase: 'fall phase-ms: (decrypt-table-ms t) level: 1 time-left: 50000
                               fall: (dfall board: b drops: '())))
             (t (decrypt-step t (fr 1200.0 '() '()))))
        (assert-equal 'clear (decrypt-table-phase t))
        (assert-equal 2 (decrypt-table-level t))
        ;; 50000 - the frame's 200 ms + 3000
        (assert-equal 52800.0 (* 1.0 (decrypt-table-time-left t))))))
  (test "the last ten seconds push the music tense; ENDLESS and DAILY have no clock"
    (assert-true (decrypt-hot? (decrypt-table (open-timed) time-left: 9000)))
    (assert-false (decrypt-hot? (decrypt-table (open-timed) time-left: 30000)))
    (assert-false (decrypt-table-time-left (open))))
  (test "the record: version 1 (no TIMED best) loads with 0; version 2 round-trips"
    (assert-equal 0 (drecord-timed-best (datum->record '(decrypt-record 1 900 12 300 2))))
    (assert-equal 900 (drecord-best (datum->record '(decrypt-record 1 900 12 300 2))))
    (let ((r (drecord best: 1 day: 2 day-best: 3 streak: 4 timed-best: 5)))
      (assert-equal 5 (drecord-timed-best (datum->record (record->datum r)))))))
