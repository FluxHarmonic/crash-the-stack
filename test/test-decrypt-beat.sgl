;;; DECRYPT's beat ((crash music beat)): a collision's cue is held until the
;;; next 16th note of the tune playing, as the ear hears it.
;;;
;;; The pure cases use a timeline laid out by hand (row r starts at sample
;;; 1000 r). The player case renders a real soundtrack tune on motif's
;;; player, models the two sinks' depths, and checks that the moment the
;;; delayed cue is heard is exactly the start sample of a walked row whose
;;; index is a multiple of the 16th step: the tune's own clock, not a
;;; wall-clock estimate of it.

(import (sigil test)
        (sigil list)
        (sigil io)
        (sigil fs)
        (motif tune)
        (motif tune player)
        (crash music beat))

;; rows 0..n-1 at sample 1000 r, newest first
(define (timeline n)
  (reverse (map (lambda (r) (vector 0 r (* 1000 r))) (iota n))))

(test-group "beat: the slot on a hand-built timeline"
  (test "the soundtrack's meter (8 rows a beat) makes a 16th 2 rows; 4 rows a beat makes it 1"
    (assert-equal 2 (sixteenth-rows 8))
    (assert-equal 1 (sixteenth-rows 4))
    (assert-equal 1 (sixteenth-rows 3)))
  (test "the next even row at or after now"
    (assert-equal 4000 (beat-slot 3500 0 (timeline 16) 2 1000 #f))
    (assert-equal 4000 (beat-slot 4000 0 (timeline 16) 2 1000 #f)))
  (test "the cue sink's latency pushes the slot past it: now 3500 + 2600 ahead -> row 8"
    (assert-equal 8000 (beat-slot 3500 2600 (timeline 16) 2 1000 #f)))
  (test "a slot is always after the last one taken, so a cascade runs up the grid"
    (assert-equal 10000 (beat-slot 3500 2600 (timeline 16) 2 1000 8000))
    (assert-equal 12000 (beat-slot 3500 2600 (timeline 16) 2 1000 10000)))
  (test "past the walked rows the grid is extrapolated at the row length"
    ;; newest row 15 at 15000: the next even row, 16, is 16000; 20000 is row 20
    (assert-equal 20000 (beat-slot 15000 4500 (timeline 16) 2 1000 #f))
    (assert-equal 16000 (beat-slot 15000 500 (timeline 16) 2 1000 #f)))
  (test "a run of cues faster than the grid stops RUN-STEPS 16ths past the natural slot"
    ;; natural 6100; the last slot 12000 is further than 2 x 2000 ahead: the floor is 10100 -> 12000, shared
    (assert-equal 2 RUN-STEPS)
    (assert-equal 12000 (beat-slot 3500 2600 (timeline 16) 2 1000 12000)))
  (test "no timeline, no slot (the cue plays at once)"
    (assert-false (beat-slot 0 0 '() 2 1000 #f)))
  (test "the delay in device frames: (slot - now) / ratio - cue depth, never negative"
    (assert-equal 1000 (beat-delay-frames 8000 3500 1.0 3500))
    (assert-equal 2000 (beat-delay-frames 8000 4000 0.5 6000))   ; the player at half the device rate
    (assert-equal 0 (beat-delay-frames 4000 3500 1.0 900))))

(define (read-file path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((acc '()))
        (let ((l (read-line port)))
          (if (eof-object? l) (string-join (reverse acc) "\n") (loop (cons l acc))))))))

(test-group "beat: on a real tune's clock"
  (test "Clock Edge: every scheduled cue is heard on the start of a 16th row the player walked"
    (let* ((t (read-tune-string (read-file "assets/tunes/clock-edge.cts")))
           (rate 48000)
           (p (open-tune-player t rate start: (cons 0 0) loop: #t))
           (bv (make-bytevector (* 8 1024) 0))
           (step (sixteenth-rows (car (tune-meter t))))
           (row-frames (/ (* rate 2.5 (tune-speed t)) (tune-tempo t)))
           (music-depth 16384)     ; SOURCE-DEPTH: the ear is this far behind the render
           (cue-depth 12288))      ; TARGET-DEPTH: a cue is heard this far after it is added
      (assert-equal 2 step)
      ;; render ~4 s in 1024-frame pulls; after each pull past the first
      ;; second, ask for a slot and note when that cue is heard
      (let loop ((k 0) (last #f) (heards '()) (negative 0))
        (if (< k 190)
            (begin
              (player-pull! p bv 0 1024)
              (if (< k 48)
                  (loop (+ k 1) last heards negative)
                  (let* ((now (- (player-rendered p) music-depth))
                         (slot (beat-slot now cue-depth (player-timeline p) step row-frames last))
                         (delay (beat-delay-frames slot now 1.0 cue-depth)))
                    (loop (+ k 1)
                          (if (= 0 (modulo k 4)) slot last)   ; a cue every fourth pull keeps its slot (a cascade's run)
                          (cons (+ now cue-depth delay) heards)
                          (+ negative (if (< (- slot now cue-depth) -0.5) 1 0))))))
            ;; render on a second so every slot has been walked, then find each
            (let more ((j 0))
              (if (< j 48)
                  (begin (player-pull! p bv 0 1024) (more (+ j 1)))
                  (let* ((tl (player-timeline p))
                         (bad (filter (lambda (h)
                                        (not (list-find (lambda (e)
                                                          (and (<= (abs (- (vector-ref e 2) h)) 1)
                                                               (= 0 (modulo (exact (vector-ref e 1)) step))))
                                                        tl)))
                                      heards)))
                    (display (list 'beat-checked (length heards) 'off-grid (length bad))) (newline)
                    (assert-equal 142 (length heards))
                    (assert-equal 0 negative)
                    (assert-equal '() bad))))))))
  (test "the player's rendered count and its render position agree (the clock's frame of reference)"
    (let* ((t (read-tune-string (read-file "assets/tunes/clock-edge.cts")))
           (p (open-tune-player t 48000 start: (cons 0 0) loop: #t))
           (bv (make-bytevector (* 8 1024) 0)))
      (let loop ((k 0)) (when (< k 20) (player-pull! p bv 0 1024) (loop (+ k 1))))
      ;; player-position (motif's own) at depth 0 names the row whose start is the
      ;; newest timeline sample at or before the render position
      (let* ((now (player-rendered p))
             (e (list-find (lambda (e) (<= (vector-ref e 2) now)) (player-timeline p))))
        (assert-equal (cons (vector-ref e 0) (vector-ref e 1)) (player-position p 0))))))

;; (crash audio)'s delayed voice: a voice at position -d mixes nothing for d
;; frames of the push, then the cue from its first sample.
(import (only (crash audio) add-voices! CUE-GAIN))
(test-group "beat: a delayed voice"
  (test "a voice at -100 is silent for 100 frames, then plays its cue from sample 0; it carries its lead across pushes"
    (let* ((cue (let ((b (make-bytevector (* 4 50) 0)))
                  (let loop ((i 0)) (when (< i 50) (bytevector-ieee-single-set! b (* 4 i) 0.25 'little) (loop (+ i 1))))
                  b))
           (out (make-bytevector (* 8 256) 0))
           (left (add-voices! out 256 (list (cons cue -100))))
           (at (lambda (i) (bytevector-ieee-single-ref out (* 8 i) 'little))))
      (assert-equal 0.0 (at 99))
      (assert-true (> (at 100) 0.2))
      (assert-true (> (at 149) 0.2))
      (assert-equal 0.0 (at 150))
      (assert-equal '() left))
    ;; a lead longer than the push: nothing mixed, the voice kept with its lead shortened
    (let* ((cue (make-bytevector (* 4 50) 0))
           (out (make-bytevector (* 8 64) 0))
           (left (add-voices! out 64 (list (cons cue -100)))))
      (assert-equal -36 (cdr (car left))))))
