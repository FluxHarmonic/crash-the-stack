;;; The live soundtrack's sequencing (M1, D59; David's ruling 2026-09-22):
;;; (crash music live) driven without a sink, the walker pulled by hand a
;;; frame at a time, the trace's remaining time counted down alongside.
;;; The fill starts in the run-up to the trace (asked a fill-length ahead,
;;; landing on a bar row) and ENDS within a bar of the trace landing; it
;;; runs on into tense, which then loops (David's phone, 2026-09-22: the
;;; fill looped and tense never came: motif's mark jump set the region to
;;; the fill's own range); tense begins at the strike whether the fill ran
;;; into it or is cut short; a strike with no run-up (a shuffle jumping the
;;; trace past its threshold) goes to tense at the next bar with no fill.

(import (sigil test)
        (sigil math)
        (sigil io)
        (sigil fs)
        (sigil list)
        (crash music)
        (crash music live)
        (crash audio)
        (motif tune))

(define RATE (audio-rate))           ; (crash audio)'s rate with no sink open is the device's default; the music renders at it here
(define FRAME 1024)                  ; frames pulled per simulated frame
(define FRAME-MS (/ (* 1000.0 FRAME) RATE))
(define SEED 3)

(define (tune-text name) (read-file-string (music-tune-path name)))
(live-music-set-loader! tune-text)
(live-music-set-rate! 22050 #t)      ; pinned at the ladder's floor: the render is the test's cost, and no ladder step reopens mid-run

;; the lines the model says, as ("section" "fill" "asked" "at" P R) lists, with the frame they came at
(define *lines* '())
(define *frame* 0)
(live-music-set-say! (lambda parts (set! *lines* (cons (cons *frame* parts) *lines*))))
(define (lines-matching prefix)   ; prefix: the first words after "music"
  (filter (lambda (l) (let ((words (cddr l))) (and (>= (length words) (length prefix)) (equal? (list-head words (length prefix)) prefix))))
          (reverse *lines*)))
(define (list-head l n) (if (= n 0) '() (cons (car l) (list-head (cdr l) (- n 1)))))
(define (line-frame l) (car l))
(define (line-pos l) (list-ref l (- (length l) 2)))
(define (line-row l) (list-ref l (- (length l) 1)))

;; The tune's timing, as the arm computes it from the file
(define (timing-of name)
  (let* ((t (read-tune-string (tune-text name)))
         (row-ms (/ (* 2500.0 (tune-speed t)) (tune-tempo t)))
         (m (tune-meter t))
         (bar-rows (* (car m) (cdr m)))
         (rs (tune-mark-regions t))
         (fill (assq 'fill rs))
         (tense (assq 'tense rs))
         (rows-of (lambda (from to)
                    (let loop ((i from) (n 0))
                      (if (>= i to) n
                          (let ((pat (list-find (lambda (p) (= (tune-pattern-id p) (list-ref (tune-order t) i))) (tune-patterns t))))
                            (loop (+ i 1) (+ n (tune-pattern-rows pat)))))))))
    (list (* bar-rows row-ms)                              ; bar ms
          (* (rows-of (cadr fill) (cddr fill)) row-ms)     ; fill ms
          (cadr fill) (cadr tense) bar-rows)))
(define (bar-ms tm) (list-ref tm 0))
(define (fill-ms tm) (list-ref tm 1))
(define (fill-pos tm) (list-ref tm 2))
(define (tense-pos tm) (list-ref tm 3))
(define (bar-rows tm) (list-ref tm 4))

;; One simulated frame: the model told the trace's state, then FRAME frames pulled
(define out (make-bytevector (* 8 FRAME) 0))
(define (frame! phase remaining)
  (set! *frame* (+ *frame* 1))
  (live-music-frame! 'stack phase remaining 'stack SEED)
  (live-music-pull! out 0 FRAME))

;; Run a trace: `ms` of trace phase counting down from `from` ms remaining
;; (a strike at 0), then `after` ms of the counter phase. Answers the frame
;; the strike came at.
(define (run-trace! from after)
  (let loop ((remaining from))
    (if (> remaining 0)
        (begin (frame! 'trace remaining) (loop (- remaining FRAME-MS)))
        (let ((strike *frame*))
          (let loop2 ((left after))
            (when (> left 0)
              (frame! 'counter #f)
              (loop2 (- left FRAME-MS))))
          strike))))

(define (fresh-deal!)
  (set! *lines* '())
  (live-music-stop!)   ; the playing track closed at once (a real deal fades it over 500 ms of wall clock)
  (live-music-fresh!)
  ;; the pick opens on the first frame; a few frames of calm settle it
  (let loop ((i 0)) (when (< i 8) (frame! 'trace 600000.0) (loop (+ i 1)))))

(define (ms->frames ms) (* ms (/ RATE 1000.0)))
(define (within-frames? a b tolerance) (<= (abs (- a b)) tolerance))
(define (close? a b) (< (abs (- a b)) 1e-6))

(test-group "music live: the fill runs up to the trace and runs on into tense"
  (fresh-deal!)
  (let* ((name (live-music-name))
         (tm (timing-of name))
         (strike (run-trace! (+ (fill-ms tm) 6000.0) (+ (* 2 (bar-ms tm)) 2000.0)))
         (asked (lines-matching '("section" "fill" "asked")))
         (landed (lines-matching '("section" "fill" "at")))
         (tense (lines-matching '("section" "tense" "at")))
         (tense-asked (lines-matching '("section" "tense" "asked")))
         (final (live-music-position)))   ; read now: a test body runs after every group's setup
    (test "the fill was asked once and landed once, on a bar row at the fill mark"
      (assert-equal 1 (length asked))
      (assert-equal 1 (length landed))
      (assert-equal (fill-pos tm) (line-pos (car landed)))
      (assert-equal 0 (modulo (line-row (car landed)) (bar-rows tm))))
    ;; the model's claim is HALF a bar either way (the ask fires at a bar row
    ;; with the slack in [0, bar)); a full-bar tolerance is a test that agrees
    ;; with whatever happens (the reviewer's MEDIUM 3, 2026-09-22)
    (test "the fill ends within half a bar of the trace landing (the strike)"
      (let ((end (+ (* FRAME (line-frame (car landed))) (ms->frames (fill-ms tm))))
            (at (* FRAME strike)))
        (assert-true (within-frames? end at (+ (ms->frames (* 0.5 (bar-ms tm))) (* 2 FRAME))))))
    (test "tense began: once, at the tense mark on a bar row, within half a bar of the strike"
      (assert-equal 1 (length tense))
      (assert-equal (tense-pos tm) (line-pos (car tense)))
      (assert-equal 0 (modulo (line-row (car tense)) (bar-rows tm)))
      (assert-true (within-frames? (* FRAME (line-frame (car tense))) (* FRAME strike) (+ (ms->frames (* 0.5 (bar-ms tm))) (* 2 FRAME)))))
    (test "the strike asked for tense (the walk either there already or jumping at the next bar)"
      (assert-equal 1 (length tense-asked)))
    (test (string-append "the walk stays in tense: the fill never plays again (at " (if final (string-append (number->string (car final)) ":" (number->string (cdr final))) "-") ")")
      (let ((p final))
        (assert-true (and p (>= (car p) (tense-pos tm))))))))

(test-group "music live: a strike with no run-up goes to tense at the next bar, no fill"
  (fresh-deal!)
  (let* ((name (live-music-name))
         (tm (timing-of name))
         (strike (run-trace! 0.0 (+ (* 2 (bar-ms tm)) 1000.0)))
         (asked (lines-matching '("section" "fill")))
         (tense (lines-matching '("section" "tense" "at"))))
    (test "no fill was asked"
      (assert-equal 0 (length asked)))
    (test "tense landed at its mark on a bar row within a bar of the strike"
      (assert-equal 1 (length tense))
      (assert-equal (tense-pos tm) (line-pos (car tense)))
      (assert-equal 0 (modulo (line-row (car tense)) (bar-rows tm)))
      (assert-true (within-frames? (* FRAME (line-frame (car tense))) (* FRAME strike) (+ (ms->frames (bar-ms tm)) (* 2 FRAME)))))))

(test-group "music live: a strike during the fill cuts it: tense at the next bar"
  (fresh-deal!)
  (let* ((name (live-music-name))
         (tm (timing-of name))
         ;; the fill asked at the window, then the trace jumps to its landing 2 bars later
         (strike (let loop ((remaining (+ (fill-ms tm) 6000.0)) (fill-seen #f))
                   (cond ((and fill-seen (>= (- *frame* fill-seen) (/ (ms->frames (* 2 (bar-ms tm))) FRAME)))
                          (let ((s *frame*))
                            (let loop2 ((left (+ (* 2 (bar-ms tm)) 1000.0)))
                              (when (> left 0) (frame! 'counter #f) (loop2 (- left FRAME-MS))))
                            s))
                         (else
                          (frame! 'trace remaining)
                          (loop (- remaining FRAME-MS)
                                (or fill-seen (let ((l (lines-matching '("section" "fill" "at")))) (and (pair? l) (line-frame (car l))))))))))
         (tense (lines-matching '("section" "tense" "at")))
         (final (live-music-position)))
    (test "tense landed at its mark on a bar row within a bar after the strike"
      (assert-equal 1 (length tense))
      (assert-equal (tense-pos tm) (line-pos (car tense)))
      (assert-equal 0 (modulo (line-row (car tense)) (bar-rows tm)))
      (assert-true (>= (line-frame (car tense)) strike))
      (assert-true (<= (* FRAME (- (line-frame (car tense)) strike)) (+ (ms->frames (bar-ms tm)) (* 2 FRAME)))))
    (test (string-append "the walk is in tense (at " (if final (string-append (number->string (car final)) ":" (number->string (cdr final))) "-") ")")
      (let ((p final))
        (assert-true (and p (>= (car p) (tense-pos tm))))))))


;; The page's 12 ms timer pumps between frames, so a long frame (the boot)
;; fits more pulls than the ladder's window; the pulls after the window
;; is full are not measured, never an error (7e5178c on the arm: every
;; pump after the 60th failed on the vector's end, 11852 console errors).
(test-group "music live: more pulls than the ladder's window between two frames"
  (fresh-deal!)
  (let ((pulled (let loop ((i 0) (ok #t))
                  (if (= i 200) ok
                      (loop (+ i 1) (and ok (live-music-pull! out 0 FRAME)))))))
    (frame! 'trace 600000.0)
    (let ((playing (live-music-playing?)))   ; read now: the bodies run after every group's setup
    (test "200 pulls with no frame between them all rendered, and the next frame ran"
      (assert-true pulled)
      (assert-true playing)))))

;; The window's arithmetic, every term held by hand (the reviewer's MEDIUM 3,
;; 2026-09-22: the tests drive the model with no sink, so the queue term is
;; identically zero here and a mistake in it could not have been caught).
(test-group "music live: the fill's window, term by term"
  (let ((row-ms 100.0) (bar 16) (fill-rows 64))
    (test "on a bar row the wait is a whole bar: queue + bar + fill + half a bar"
      (assert-true (close? (fill-window-ms 0.0 row-ms bar 0 fill-rows 1.0)
                           (+ (* bar row-ms) (* fill-rows row-ms) (* 0.5 bar row-ms)))))
    (test "one row past a bar row the wait is one row short of a bar"
      (assert-true (close? (fill-window-ms 0.0 row-ms bar 1 fill-rows 1.0)
                           (+ (* (- bar 1) row-ms) (* fill-rows row-ms) (* 0.5 bar row-ms)))))
    (test "the queue's ms are added as they are: the ear is that far behind the walker"
      (assert-true (close? (- (fill-window-ms 341.0 row-ms bar 5 fill-rows 1.0)
                              (fill-window-ms 0.0 row-ms bar 5 fill-rows 1.0))
                           341.0)))
    (test "the window falls by a row for each row the walker takes toward its bar row"
      (let loop ((row 1))
        (when (< row bar)
          (assert-true (close? (- (fill-window-ms 0.0 row-ms bar (- row 1) fill-rows 1.0)
                                  (fill-window-ms 0.0 row-ms bar row fill-rows 1.0))
                               row-ms))
          (loop (+ row 1)))))
    ;; The four terms are real ms; `remaining` is trace ms, and (crash tween)
    ;; drops the ticks it owes past MAX-STEPS-PER-FRAME, so a game that runs
    ;; long frames leaves its trace behind the wall clock for good. The rate
    ;; converts the answer into the trace's own ms (the arm on a loaded box,
    ;; 2026-09-22: the fill ended 5.3 s before the strike, two bars early).
    (test "the rate scales the whole window: at 0.5 the trace covers half as much while the fill plays"
      (assert-true (close? (fill-window-ms 341.0 row-ms bar 7 fill-rows 0.5)
                           (* 0.5 (fill-window-ms 341.0 row-ms bar 7 fill-rows 1.0))))
      (assert-true (close? (fill-window-ms 0.0 row-ms bar 0 fill-rows 1.0)
                           (fill-window-ms 0.0 row-ms bar 0 fill-rows 1.0))))
    (test "a longer fill widens the window by its own length"
      (assert-true (close? (- (fill-window-ms 0.0 row-ms bar 3 128 1.0) (fill-window-ms 0.0 row-ms bar 3 64 1.0))
                           (* 64 row-ms))))
    (test "the window is never shorter than the fill plus half a bar (the jump's own wait aside)"
      (let loop ((row 0))
        (when (< row bar)
          (assert-true (>= (fill-window-ms 0.0 row-ms bar row fill-rows 1.0)
                           (+ (* fill-rows row-ms) (* 0.5 bar row-ms))))
          (loop (+ row 1)))))))

;; The menu theme has `calm` and nothing else (black-glass-title). A tune
;; with no fill or tense mark must never be asked for one, on a table
;; screen as much as on the menu.
(test-group "music live: a tune with no fill or tense mark is never asked for one"
  (live-music-stop!)
  (live-music-set-tune-door! MENU-THEME)
  (fresh-deal!)
  (let* ((name (live-music-name))
         (strike (run-trace! 20000.0 4000.0))
         (fills (lines-matching '("section" "fill")))
         (tense (lines-matching '("section" "tense" "at")))
         (playing (live-music-playing?)))
    (live-music-set-tune-door! #f)
    (test "the markless tune played the whole run-up and the strike"
      (assert-equal MENU-THEME name)
      (assert-true playing))
    (test "no fill was asked or landed"
      (assert-equal 0 (length fills)))
    (test "and no tense landing either: the tune has no tense mark to jump to"
      (assert-equal 0 (length tense)))))

;; A real deal goes through the fade-out -> restart -> open path, not
;; live-music-stop!; the section state must come out of it clean (the
;; reviewer's MEDIUM 3).
(test-group "music live: a fresh deal through the fade, mid-tense"
  (live-music-stop!)
  (set! *lines* '())
  (live-music-fresh!)
  (let loop ((i 0)) (when (< i 8) (frame! 'trace 600000.0) (loop (+ i 1))))
  (let* ((first-name (live-music-name))
         (tm (timing-of first-name)))
    ;; into tense on this deal
    (run-trace! (+ (fill-ms tm) 4000.0) (* 2 (bar-ms tm)))
    (let ((in-tense (live-music-section)))
      ;; a new deal of the other table: the fade runs, then the next track opens
      (live-music-fresh!)
      (let loop ((i 0))
        (when (< i 400)                      ; the 500 ms fade at 1024 frames a frame
          (set! *frame* (+ *frame* 1))
          (live-music-frame! 'cards 'trace 600000.0 'cards 11)
          (live-music-pull! out 0 FRAME)
          (loop (+ i 1))))
      (let ((name (live-music-name))
            (playing (live-music-playing?))   ; read at setup: a body runs after every group's setup
            (section (live-music-section))
            (opens (lines-matching '("open"))))
        (test "the leaving track faded and the new deal's track opened"
          (assert-equal 'tense in-tense)
          (assert-true (>= (length opens) 2))
          (assert-true playing))
        (test "the new track starts in CALM: the section state did not survive the switch"
          (assert-equal 'calm section)
          (assert-true (symbol? name)))))))

;; A ladder step reopens the player mid-run-up: the pending jump and the
;; section must survive it (the reviewer's MEDIUM 3: the rate was pinned in
;; every other case here, so no reopen ran).
(test-group "music live: a ladder step during the fill's run-up"
  (live-music-stop!)
  (live-music-set-rate! #f #t)          ; the device's rate and the pin lifted: the ladder may step
  (live-music-set-budget! 0.0001)       ; every measured window is over budget
  (fresh-deal!)
  (let* ((tm (timing-of (live-music-name)))
         (strike (run-trace! (+ (fill-ms tm) 8000.0) (+ (* 2 (bar-ms tm)) 2000.0)))
         (reopens (lines-matching '("reopen")))
         (fill-landings (lines-matching '("section" "fill" "at")))
         (tense-landings (lines-matching '("section" "tense" "at")))
         (calm-asks (lines-matching '("section" "calm" "asked")))
         (final (live-music-position)))
    (live-music-set-budget! MUSIC-BUDGET-MS)
    (live-music-set-rate! 22050 #t)
    (test "the ladder stepped at least once during the run"
      (assert-true (>= (length reopens) 1)))
    ;; M1: the window's queue term shrinks when a reopen drains the sink; a
    ;; predicate would answer CALM here and dip out of the fill
    (test "the fill still landed once and was never left for CALM"
      (assert-equal 1 (length fill-landings))
      (assert-equal 0 (length calm-asks)))
    (test "tense still began once, and the walk is in it"
      (assert-equal 1 (length tense-landings))
      (assert-true (and final (>= (car final) (tense-pos tm)))))))
(live-music-off!)
