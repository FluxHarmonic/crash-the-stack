;;; Hand-derived Pyramid fixtures. Generator tests live separately so
;;; coverage and legality never depend on a generator's recorded witness.

(import (sigil test)
        (crash cards deck)
        (crash stack rules)
        (crash checksum layout)
        (crash checksum rules))

(define (checksum-fixture)
  (checksum-board (make-vector 28 (make-card 0 2)) '()))

(define (checksum-with-ranks edits stock)
  (let ((packets (make-vector 28 (make-card 0 2))))
    (for-each (lambda (edit)
                (vector-set! packets (car edit) (make-card 0 (cdr edit))))
              edits)
    (checksum-board packets (map (lambda (rank) (make-card 1 rank)) stock))))

(test-group "checksum: coverage"
  (test "all seven leaves are free, all other packets covered"
    (let ((b (checksum-fixture)))
      (assert-equal '(21 22 23 24 25 26 27)
                    (filter (lambda (id) (checksum-free? b id)) (iota 28)))
      (assert-equal 28 (board-tile-count (cboard-pyramid b)))))
  (test "both children must leave; unrelated leaves do not uncover a parent"
    (let* ((b (checksum-with-ranks '((21 . 13) (22 . 13) (27 . 13)) '()))
           (one (checksum-select b 21))
           (other (checksum-select one 27))
           (two (checksum-select other 22)))
      (assert-false (checksum-free? one 15))
      (assert-false (checksum-free? other 15))
      (assert-true (checksum-free? two 15))
      (assert-false (checksum-free? two 16))
      (assert-equal '(21 27 22)
                    (filter (lambda (id) (not (tile-present? (cboard-pyramid two) id)))
                            '(21 27 22)))))
  (test "a covered ROOT cannot be removed"
    (let ((b (checksum-with-ranks '((0 . 13)) '())))
      (assert-eq b (checksum-select b 0))
      (assert-false (checksum-root? b 0))))
  (test "each of the 21 parents is covered exactly by its own two children"
    (for-each
     (lambda (row)
       (for-each
        (lambda (column)
          (let* ((b (checksum-fixture))
                 (parent (pyramid-id row column))
                 (left (pyramid-id (+ row 1) column))
                 (right (+ left 1))
                 (present (make-vector 28 #f)))
            (vector-set! present parent #t)
            (vector-set! present left #t)
            (vector-set! present right #t)
            (let* ((pyramid (board-new (pyramid-layout)
                                       (board-faces (cboard-pyramid b))
                                       present))
                   (one (board-remove-pair pyramid left left))
                   (two (board-remove-pair one right right)))
              (assert-false (playable? pyramid parent))
              (assert-false (playable? one parent))
              (assert-true (playable? two parent)))))
        (iota (+ row 1))))
     (iota 6))))

(test-group "checksum: arithmetic"
  (test "distinct free offsets totaling 13 leave together, preserving the old board"
    (let* ((b (checksum-with-ranks '((21 . 5) (22 . 8)) '()))
           (selected (checksum-select b 21))
           (after (checksum-select selected 22)))
      (assert-true (checksum-pair? b 21 22))
      (assert-equal 21 (cboard-selected selected))
      (assert-equal 2 (checksum-count after))
      (assert-equal 0 (checksum-count b))
      (assert-false (cboard-selected after))
      (assert-equal 1 (cboard-moves after))))
  (test "a wrong sum, a repeated place and a covered partner are refused"
    (let ((b (checksum-with-ranks '((0 . 8) (21 . 5) (22 . 7)) '())))
      (assert-false (checksum-pair? b 21 22))
      (assert-false (checksum-pair? b 21 21))
      (assert-false (checksum-pair? b 21 0))
      (assert-eq b (checksum-remove b 21 22))
      (assert-equal 22 (cboard-selected (checksum-select (checksum-select b 21) 22)))))
  (test "a free ROOT leaves on one tap, an ordinary packet cannot leave alone"
    (let* ((b (checksum-with-ranks '((21 . 13)) '()))
           (after (checksum-select b 21)))
      (assert-equal 1 (checksum-count after))
      (assert-false (tile-present? (cboard-pyramid after) 21))
      (assert-eq b (checksum-remove b 22 #f)))))

(test-group "checksum: feed and buffer"
  (test "PULL moves one packet to the buffer and clears the selection"
    (let* ((b (checksum-with-ranks '() '(5 8 3)))
           (after (checksum-pull (checksum-select b 21))))
      (assert-equal '(8 3) (map card-rank (cboard-stock after)))
      (assert-equal '(5) (map card-rank (cboard-waste after)))
      (assert-false (cboard-selected after))
      (assert-equal '(5 8 3) (map card-rank (cboard-stock b)))))
  (test "only the buffer top pairs with a free pyramid packet"
    (let* ((b (checksum-with-ranks '((21 . 8)) '(5 4)))
           (one (checksum-pull b))
           (two (checksum-pull one))
           (after (checksum-select (checksum-select one 'waste) 21)))
      (assert-true (checksum-pair? one 'waste 21))
      (assert-false (checksum-pair? two 'waste 21))
      (assert-equal 1 (checksum-count after))
      (assert-equal '() (cboard-waste after))))
  (test "selecting the buffer then PULL cancels a complementary next packet"
    (let* ((b (checksum-with-ranks '() '(5 8 3)))
           (one (checksum-pull b))
           (after (checksum-select (checksum-select one 'waste) 'pull)))
      (assert-true (checksum-pair? one 'waste 'pull))
      (assert-false (checksum-pair? b 21 'pull))
      (assert-equal '(3) (map card-rank (cboard-stock after)))
      (assert-equal '() (cboard-waste after))
      (assert-equal 0 (checksum-count after))))
  (test "buffer ROOT verifies alone and exposes the older packet"
    (let* ((b (checksum-with-ranks '() '(5 13)))
           (two (checksum-pull (checksum-pull b)))
           (after (checksum-select two 'waste)))
      (assert-equal '(5) (map card-rank (cboard-waste after)))
      (assert-equal 0 (checksum-count after))))
  (test "ROLLBACK restores original feed order; exactly three passes, never a fourth"
    (let* ((b (checksum-with-ranks '() '(5 8)))
           (empty1 (checksum-pull (checksum-pull b)))
           (pass2 (checksum-pull empty1))
           (empty2 (checksum-pull (checksum-pull pass2)))
           (pass3 (checksum-pull empty2))
           (empty3 (checksum-pull (checksum-pull pass3))))
      (assert-true (checksum-rollback? empty1))
      (assert-equal '(5 8) (map card-rank (cboard-stock pass2)))
      (assert-equal '() (cboard-waste pass2))
      (assert-equal 2 (cboard-passes pass2))
      (assert-equal 3 (cboard-passes pass3))
      (assert-false (checksum-rollback? empty3))
      (assert-eq empty3 (checksum-pull empty3))))
  (test "undo restores removed packets, feed, buffer and pass count"
    (let* ((b (checksum-with-ranks '((21 . 5) (22 . 8)) '(4)))
           (pair (checksum-remove b 21 22))
           (pull (checksum-pull pair))
           (rollback (checksum-pull pull)))
      (assert-equal 2 (checksum-count (checksum-undo pull)))
      (assert-equal (cboard-stock b) (cboard-stock (checksum-undo pull)))
      (assert-equal 0 (checksum-count (checksum-undo pair)))
      (assert-equal 1 (cboard-passes (checksum-undo rollback)))
      (assert-equal (cboard-waste pull) (cboard-waste (checksum-undo rollback))))))

(test-group "checksum: outcome"
  (test "clearing the pyramid wins even with packets left in the feed"
    (let* ((b (checksum-fixture))
           (won (cboard b
                        pyramid: (board-extract (cboard-pyramid b))
                        stock: '(0 1 2))))
      (assert-true (checksum-won? won))
      (assert-equal 28 (checksum-count won))
      (assert-false (checksum-lost? won))
      (assert-false (checksum-won? b))))
  (test "loss requires an exhausted feed, no pass and no legal removal"
    (let* ((b (checksum-fixture))
           (feed (cboard b stock: '(0)))
           (retry (cboard b waste: '(0)))
           (move (cboard (checksum-with-ranks '((21 . 5) (22 . 8)) '())
                        passes: PASS-LIMIT)))
      (assert-true (checksum-lost? b))
      (assert-false (checksum-lost? feed))
      (assert-false (checksum-lost? retry))
      (assert-false (checksum-lost? move))
      (assert-true (checksum-lost? (cboard retry passes: PASS-LIMIT))))))
