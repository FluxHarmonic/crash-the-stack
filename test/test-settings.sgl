;;; Gate leg 4 (P4, native half): settings persist across a restart.
;;;
;;; The rows as data; stepping wraps in both directions; every setting
;;; saved under its own key reads back after the module's memory is
;;; gone (a fresh settings-load under the same store root), a key
;;; holding garbage or a value outside the row reads as the default, and
;;; the hud key keeps the shape ?hud= and --hud write. The store verbs are
;;; (crash shell)'s (the rows module is pure).

(import (sigil test)
        (sigil fs)
        (sigil math)
        (sigil time)
        (sigil process)
        (crash bg)
        (crash settings)
        (crash shell)
        (crash store))

(define ROOT (string-append "/tmp/crash-settings-test-" (number->string (exact (floor (current-second))))))
(set-store-root! ROOT)
(when (directory-exists? ROOT) (process-run "rm" "-rf" ROOT))

(test-group "settings: the rows"
  (test "nine rows in the ruled order, each with a default among its values"
    (assert-equal '(draw scoring hud field music sfx volume scanlines veil) SETTING-IDS)
    (for-each (lambda (st) (assert-true (setting-value? st (setting-default st)))) SETTINGS))
  (test "the defaults: pull 1, BOUNTY, zones, reaction, music and sfx on, volume 10, both cosmetics off (on|off symbols, never booleans)"
    (let ((d (settings-defaults)))
      (assert-equal 1 (settings-value d 'draw))
      (assert-equal 'vegas (settings-value d 'scoring))
      (assert-equal 'zones (settings-value d 'hud))
      (assert-equal 'reaction (settings-value d 'field))
      (assert-equal 'on (settings-value d 'music))
      (assert-equal 'on (settings-value d 'sfx))
      (assert-equal VOLUME-MAX (settings-value d 'volume))
      (assert-equal 'off (settings-value d 'scanlines))
      (assert-equal 'off (settings-value d 'veil))))
  (test "the value labels"
    (assert-equal "BOUNTY" (setting-value-label 'scoring 'vegas))
    (assert-equal "AUDIT" (setting-value-label 'scoring 'standard))
    (assert-equal "ON" (setting-value-label 'music 'on))
    (assert-equal "OFF" (setting-value-label 'veil 'off))
    (assert-equal "3" (setting-value-label 'draw 3))
    (assert-equal "10" (setting-value-label 'volume 10))
    (assert-equal "REACTION" (setting-value-label 'field 'reaction))
    (assert-equal "STRIP" (setting-value-label 'hud 'strip)))
  (test "every label is set in the block alphabet's characters (A-Z, 0-9, space)"
    (for-each (lambda (st)
                (for-each (lambda (c) (assert-true (or (char-alphabetic? c) (char-numeric? c) (char=? c #\space))))
                          (string->list (setting-name st)))
                (for-each (lambda (v)
                            (for-each (lambda (c) (assert-true (or (char-upper-case? c) (char-numeric? c))))
                                      (string->list (setting-value-label (setting-id st) v))))
                          (setting-values st)))
              SETTINGS)))

(test-group "settings: stepping"
  (test "forward wraps, back wraps"
    (let* ((d (settings-defaults))
           (s (settings-step d 'draw 1)))
      (assert-equal 3 (settings-value s 'draw))
      (assert-equal 1 (settings-value (settings-step s 'draw 1) 'draw))
      (assert-equal 3 (settings-value (settings-step d 'draw -1) 'draw))
      (assert-equal 'off (settings-value (settings-step d 'field -1) 'field))
      (assert-equal 'off (settings-value (settings-step d 'field 1) 'field))
      (assert-equal 0 (settings-value (settings-step d 'volume 1) 'volume))
      (assert-equal 9 (settings-value (settings-step d 'volume -1) 'volume))))
  (test "a value outside the row is refused by settings-with; an unknown id changes nothing"
    (let ((d (settings-defaults)))
      (assert-equal d (settings-with d 'draw 2))
      (assert-equal d (settings-with d 'nothing 1))
      (assert-equal d (settings-step d 'nothing 1))
      (assert-equal 'strip (settings-value (settings-with d 'hud 'strip) 'hud)))))

(test-group "settings: the store round trip (gate leg 4, native)"
  (test "a fresh root reads as the defaults"
    (assert-equal (settings-defaults) (settings-load)))
  (test "every setting stepped once and saved reads back after a fresh load"
    (let ((s (let loop ((ids SETTING-IDS) (s (settings-defaults)))
               (if (null? ids)
                   s
                   (let ((s (settings-step s (car ids) 1)))
                     (assert-true (settings-save! s (car ids)))
                     (loop (cdr ids) s))))))
      (assert-false (equal? s (settings-defaults)))
      (assert-equal s (settings-load))
      ;; the hud key holds the plain symbol the ?hud= door writes
      (assert-equal 'strip (store-read-datum "hud"))
      (assert-equal 3 (store-read-datum "draw"))
      (assert-equal 'off (store-read-datum "music"))
      (assert-equal 0 (store-read-datum "volume"))))
  (test "a key holding garbage or a value outside the row reads as the default; the others keep theirs"
    (store-set! "draw" "(not a number")
    (store-write-datum! "field" 'plasma)
    (store-write-datum! "volume" 11)
    (let ((s (settings-load)))
      (assert-equal 1 (settings-value s 'draw))
      (assert-equal 'reaction (settings-value s 'field))
      (assert-equal VOLUME-MAX (settings-value s 'volume))
      (assert-equal 'standard (settings-value s 'scoring))
      (assert-equal 'on (settings-value s 'scanlines))))
  (test "a saved retired LIFE field falls back to REACTION"
    (store-write-datum! "field" 'life)
    (assert-equal 'reaction (settings-value (settings-load) 'field)))
  (test "the detector: a store that loses a write reads the default, not the stepped value"
    (let ((s (settings-step (settings-defaults) 'veil 1)))
      (store-remove! "veil")
      (assert-equal 'on (settings-value s 'veil))
      (assert-equal 'off (settings-value (settings-load) 'veil)))))

(test-group "background selection: seven active modes"
  (test "all seven GPU backgrounds are selectable"
    (for-each (lambda (mode)
                (let ((b (bg-choose mode 7 #f)))
                  (assert-true (bg-gpu? b))
                  (assert-equal mode (bg-mode b))))
              '(reaction cyclic flow signal echo synapse flame)))
  (test "REACTION retains its CPU reference; retired and unsupported names select no field"
    (assert-false (bg-gpu? (bg-choose 'reaction-cpu 7 #f)))
    (for-each (lambda (mode) (assert-false (bg-choose mode 7 #f)))
              '(life life-cpu cyclic-cpu flow-cpu signal-cpu echo-cpu synapse-cpu flame-cpu off))))

(process-run "rm" "-rf" ROOT)
