;;; Gate leg 4 (P4, native half): settings persist across a restart.
;;;
;;; The rows as data; stepping wraps in both directions; every setting
;;; saved under its own key reads back after the module's memory is
;;; gone (a fresh settings-load under the same store root), a key
;;; holding garbage or a value outside the row reads as the default, and
;;; the hud key keeps the shape ?hud= and --hud write. The store verbs are
;;; (crash shell)'s (the rows module is pure).

(import (sigil test)
        (sigil fs)
        (sigil math)
        (sigil time)
        (sigil process)
        (crash settings)
        (crash shell)
        (crash store))

(define ROOT (string-append "/tmp/crash-settings-test-" (number->string (exact (floor (current-second))))))
(set-store-root! ROOT)
(when (directory-exists? ROOT) (process-run "rm" "-rf" ROOT))

(test-group "settings: the rows"
  (test "eight rows in the ruled order, each with a default among its values"
    (assert-equal '(draw scoring music sfx volume scanlines veil background) SETTING-IDS)
    (for-each (lambda (st) (assert-true (setting-value? st (setting-default st)))) SETTINGS))
  (test "the defaults: pull 1, BOUNTY, music and sfx on, volume 10, scanlines and the veil on (David's phone read, 2026-09-21) (on|off symbols, never booleans)"
    (let ((d (settings-defaults)))
      (assert-equal 1 (settings-value d 'draw))
      (assert-equal 'vegas (settings-value d 'scoring))
      (assert-equal 'on (settings-value d 'music))
      (assert-equal 'on (settings-value d 'sfx))
      (assert-equal VOLUME-MAX (settings-value d 'volume))
      (assert-equal 'on (settings-value d 'scanlines))
      (assert-equal 'on (settings-value d 'veil))))
  (test "the value labels"
    (assert-equal "BOUNTY" (setting-value-label 'scoring 'vegas))
    (assert-equal "AUDIT" (setting-value-label 'scoring 'standard))
    (assert-equal "ON" (setting-value-label 'music 'on))
    (assert-equal "OFF" (setting-value-label 'veil 'off))
    (assert-equal "3" (setting-value-label 'draw 3))
    (assert-equal "10" (setting-value-label 'volume 10)))
  (test "the split (D51): the general five on the main menu, DEFRAG's two in its overlay, none for the stack"
    (assert-equal '(music sfx volume scanlines veil background) (settings-group 'general))
    (assert-equal 'live (settings-value (settings-defaults) 'background))
    (assert-equal "STILL" (setting-value-label 'background 'still))
    (assert-equal '(draw scoring) (settings-group 'cards))
    (assert-equal '() (settings-group 'stack))
    (assert-equal '() (settings-group 'nothing))
    (assert-equal 'next-deal (setting-when 'draw))
    (assert-equal 'next-deal (setting-when 'scoring))
    (assert-equal 'now (setting-when 'volume)))
  (test "every label is set in the block alphabet's characters (A-Z, 0-9, space)"
    (for-each (lambda (st)
                (for-each (lambda (c) (assert-true (or (char-alphabetic? c) (char-numeric? c) (char=? c #\space))))
                          (string->list (setting-name st)))
                (for-each (lambda (v)
                            (for-each (lambda (c) (assert-true (or (char-upper-case? c) (char-numeric? c))))
                                      (string->list (setting-value-label (setting-id st) v))))
                          (setting-values st)))
              SETTINGS)))

(test-group "settings: stepping"
  (test "forward wraps, back wraps"
    (let* ((d (settings-defaults))
           (s (settings-step d 'draw 1)))
      (assert-equal 3 (settings-value s 'draw))
      (assert-equal 1 (settings-value (settings-step s 'draw 1) 'draw))
      (assert-equal 3 (settings-value (settings-step d 'draw -1) 'draw))
      (assert-equal 0 (settings-value (settings-step d 'volume 1) 'volume))
      (assert-equal 9 (settings-value (settings-step d 'volume -1) 'volume))))
  (test "a value outside the row is refused by settings-with; an unknown id changes nothing"
    (let ((d (settings-defaults)))
      (assert-equal d (settings-with d 'draw 2))
      (assert-equal d (settings-with d 'nothing 1))
      (assert-equal d (settings-step d 'nothing 1))
      (assert-equal 'standard (settings-value (settings-with d 'scoring 'standard) 'scoring)))))

(test-group "settings: the store round trip (gate leg 4, native)"
  (test "a fresh root reads as the defaults"
    (assert-equal (settings-defaults) (settings-load)))
  (test "every setting stepped once and saved reads back after a fresh load"
    (let ((s (let loop ((ids SETTING-IDS) (s (settings-defaults)))
               (if (null? ids)
                   s
                   (let ((s (settings-step s (car ids) 1)))
                     (assert-true (settings-save! s (car ids)))
                     (loop (cdr ids) s))))))
      (assert-false (equal? s (settings-defaults)))
      (assert-equal s (settings-load))
      ;; each key holds the plain datum
      (assert-equal 'standard (store-read-datum "scoring"))
      (assert-equal 3 (store-read-datum "draw"))
      (assert-equal 'off (store-read-datum "music"))
      (assert-equal 0 (store-read-datum "volume"))))
  (test "a key holding garbage or a value outside the row reads as the default; the others keep theirs"
    (store-set! "draw" "(not a number")
    (store-write-datum! "scoring" 'plasma)
    (store-write-datum! "volume" 11)
    (let ((s (settings-load)))
      (assert-equal 1 (settings-value s 'draw))
      (assert-equal 'vegas (settings-value s 'scoring))
      (assert-equal VOLUME-MAX (settings-value s 'volume))
      ;; the scanlines were stepped off above and the store keeps it: a stored off wins the new default
      (assert-equal 'off (settings-value s 'scanlines))))
  (test "the detector: a store that loses a write reads the default, not the stepped value"
    (let ((s (settings-step (settings-defaults) 'veil 1)))
      (store-remove! "veil")
      (assert-equal 'off (settings-value s 'veil))
      (assert-equal 'on (settings-value (settings-load) 'veil)))))

;; The one-time reset (David, 2026-09-21): a store from before the
;; settings' version key (P4a's) holds scanlines off as its default was;
;; the first load at the new version clears the setting keys, the
;; retired hud and field keys too, writes the version, and reads the new
;; defaults; a store at the version keeps a stored off. The other keys
;; (the scores, the run, the board) are not touched.
(test-group "settings: the schema version and the one-time reset"
  (test "an old store (no version) with scanlines off and a hud key reads the new defaults; the version is written; the scores key stays"
    (process-run "rm" "-rf" ROOT)
    (store-write-datum! "scanlines" 'off)
    (store-write-datum! "veil" 'off)
    (store-write-datum! "hud" 'strip)
    (store-write-datum! "field" 'life)   ; the old FIELD value: outside BACKGROUND's row, and reset anyway
    (store-write-datum! "draw" 3)
    (store-write-datum! "scores" '(crash-scores 1 (best stack hacker 1 2 3)))
    (assert-false (store-read-datum SETTINGS-VERSION-KEY))
    (let ((s (settings-load)))
      (assert-equal 'on (settings-value s 'scanlines))
      (assert-equal 'on (settings-value s 'veil))
      (assert-equal 1 (settings-value s 'draw)))
    (assert-equal SETTINGS-VERSION (store-read-datum SETTINGS-VERSION-KEY))
    (assert-false (store-read-datum "hud"))
    (assert-false (store-read-datum "field"))
    (assert-equal 'live (settings-value (settings-load) 'background))
    (assert-false (store-read-datum "scanlines"))
    (assert-equal '(crash-scores 1 (best stack hacker 1 2 3)) (store-read-datum "scores")))
  (test "a store at the current version with scanlines off keeps off"
    (store-write-datum! "scanlines" 'off)
    (assert-equal 'off (settings-value (settings-load) 'scanlines))
    (assert-equal SETTINGS-VERSION (store-read-datum SETTINGS-VERSION-KEY)))
  (test "a store at an older version number is reset the same way"
    (store-write-datum! SETTINGS-VERSION-KEY (- SETTINGS-VERSION 1))
    (store-write-datum! "scanlines" 'off)
    (assert-equal 'on (settings-value (settings-load) 'scanlines))
    (assert-equal SETTINGS-VERSION (store-read-datum SETTINGS-VERSION-KEY))))

(process-run "rm" "-rf" ROOT)
