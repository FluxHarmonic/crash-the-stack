;;; Gate: the rules modules import nothing from graphics, windowing or any
;;; bridge. Plan guardrail: "Rules/renderer separation is a gate, not a
;;; convention."
;;;
;;; The checker reads each rules module's source, takes its (import ...)
;;; form, follows (crash ...) imports transitively, and reports every import
;;; outside the allowlist. The positive control writes a module with a
;;; planted (sigil graphics) import under /tmp and checks the checker names
;;; it, so a green here has been shown able to go red.

(import (sigil test)
        (sigil io)
        (sigil fs))

;; The rules family: everything that must compile unchanged for the web
;; shell and must never draw or read a platform.
(define RULES-MODULES
  '((crash stack layout)
    (crash stack turtle)
    (crash stack fixtures)
    (crash stack prng)
    (crash stack rules)
    (crash stack generate)
    (crash geometry)
    (crash input)))

(define ALLOWLIST
  '((sigil core)
    (sigil struct)
    (sigil math)))

(define (module-path root name)
  (let loop ((parts name) (path (string-append root "/src")))
    (if (null? (cdr parts))
        (string-append path "/" (symbol->string (car parts)) ".sgl")
        (loop (cdr parts) (string-append path "/" (symbol->string (car parts)))))))

(define (read-file-string path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((lines '()))
        (let ((line (read-line port)))
          (if (eof-object? line)
              (string-join (reverse lines) "\n")
              (loop (cons line lines))))))))

;; The first datum of a module file is its define-library form.
(define (library-imports path)
  (let ((form (read-expr (read-file-string path))))
    (unless (and (pair? form) (eq? (car form) 'define-library))
      (error "not a define-library form" path))
    (let ((import-form (find (lambda (x) (and (pair? x) (eq? (car x) 'import))) (cddr form))))
      (if import-form (cdr import-form) '()))))

(define (crash-module? name) (and (pair? name) (eq? (car name) 'crash)))

;; Walk from the named modules through every (crash ...) import. Returns a
;; list of (module . bad-import) for every import outside the allowlist that
;; is not itself a crash module. A crash module outside the starting set is
;; reported too, so a rules module cannot smuggle an import through a
;; helper.
(define (check-modules root modules allowlist)
  (let loop ((todo modules) (seen '()) (bad '()))
    (cond ((null? todo) (reverse bad))
          ((member (car todo) seen) (loop (cdr todo) seen bad))
          (else
           (let* ((name (car todo))
                  (imports (library-imports (module-path root name)))
                  (violations (filter (lambda (i)
                                        (not (or (member i allowlist)
                                                 (and (crash-module? i) (member i modules)))))
                                      imports))
                  (followups (filter (lambda (i) (and (crash-module? i) (member i modules))) imports)))
             (loop (append (cdr todo) followups)
                   (cons name seen)
                   (append (reverse (map (lambda (v) (cons name v)) violations)) bad)))))))

(test-group "rules modules import only the allowlist"
  (let ((bad (check-modules "." RULES-MODULES ALLOWLIST)))
    (test "no import outside (sigil core) (sigil struct) (sigil math) and the rules family"
      (assert-equal '() bad))
    (test "the real rules.sgl was read: its import list is the known one"
      (assert-equal (quote ((sigil core) (sigil struct) (sigil math) (crash stack layout)))
                    (library-imports (module-path "." (quote (crash stack rules))))))
    (test "every rules module exists and was read"
      (assert-true (every (lambda (m) (file-exists? (module-path "." m))) RULES-MODULES)))))

(test-group "positive control: a planted graphics import is caught"
  (let* ((root "/tmp/crash-import-control")
         (dir (string-append root "/src/crash/stack")))
    (unless (directory-exists? root) (make-directory root))
    (unless (directory-exists? (string-append root "/src")) (make-directory (string-append root "/src")))
    (unless (directory-exists? (string-append root "/src/crash")) (make-directory (string-append root "/src/crash")))
    (unless (directory-exists? dir) (make-directory dir))
    (call-with-output-file (string-append dir "/planted.sgl")
      (lambda (port)
        (write-string
          (string-append
            ";;; a rules module with a rendering import planted in it\n"
            "(define-library (crash stack planted)\n"
            "  (import (sigil core) (sigil graphics) (crash stack helper))\n"
            "  (export x) (begin (define x 1)))\n")
          port)))
    (call-with-output-file (string-append dir "/helper.sgl")
      (lambda (port)
        (write-string
          (string-append
            "(define-library (crash stack helper)\n"
            "  (import (sigil core) (sigil app))\n"
            "  (export y) (begin (define y 2)))\n")
          port)))
    (let ((bad (check-modules root '((crash stack planted) (crash stack helper)) ALLOWLIST)))
      (test "the planted (sigil graphics) import is named against its module"
        (assert-true (and (member '((crash stack planted) . (sigil graphics)) bad) #t)))
      (test "the transitive (sigil app) import through the helper is named too"
        (assert-true (and (member '((crash stack helper) . (sigil app)) bad) #t)))
      (test "nothing else is reported"
        (assert-equal 2 (length bad))))
    (let ((clean (check-modules root '((crash stack helper)) '((sigil core) (sigil app)))))
      (test "with (sigil app) allowed, the helper is clean (the checker can stand down)"
        (assert-equal '() clean)))))
