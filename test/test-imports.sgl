;;; Gate: the rules modules import nothing from graphics, windowing or any
;;; bridge. Plan guardrail: "Rules/renderer separation is a gate, not a
;;; convention."
;;;
;;; The checker reads each rules module's source as data, collects EVERY
;;; import form in the define-library body (including ones after the export
;;; list and ones inside cond-expand clauses), strips only/except/prefix/
;;; rename down to the library name, follows (crash ...) imports transitively
;;; whether or not they were in the starting set, and reports every import
;;; outside the allowlist. The positive control is a committed pair of
;;; modules under test/fixtures/import-control with plants of each kind; the
;;; test writes nothing.

(import (sigil test)
        (sigil io)
        (sigil fs))

;; The rules family: everything that must compile unchanged for the web
;; shell and must never draw or read a platform.
(define RULES-MODULES
  '((crash stack layout)
    (crash stack turtle)
    (crash stack fixtures)
    (crash stack prng)
    (crash stack rules)
    (crash stack generate)
    (crash geometry)
    (crash input)
    (crash tween)
    (crash trace)
    (crash save)
    (crash editor)
    (crash cards deck)
    (crash cards rules)
    (crash menu)))

(define ALLOWLIST
  '((sigil core)   ; implicit in every library, listed so an explicit import is not a red
    (sigil struct)
    (sigil math)
    (sigil list)))

(define CONTROL-ROOT "test/fixtures/import-control")

(define (module-path root name)
  (let loop ((parts name) (path (string-append root "/src")))
    (if (null? (cdr parts))
        (string-append path "/" (symbol->string (car parts)) ".sgl")
        (loop (cdr parts) (string-append path "/" (symbol->string (car parts)))))))

(define (read-file-string path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((lines '()))
        (let ((line (read-line port)))
          (if (eof-object? line)
              (string-join (reverse lines) "\n")
              (loop (cons line lines))))))))

;; (only (lib) ...) / (except ...) / (prefix ...) / (rename ...) -> (lib)
(define (import-set->name set)
  (if (and (pair? set) (memq (car set) '(only except prefix rename)))
      (import-set->name (cadr set))
      set))

;; Every import set anywhere in a library body, cond-expand clauses included.
(define (collect-imports forms)
  (let loop ((forms forms) (acc '()))
    (cond ((null? forms) (reverse acc))
          ((not (pair? (car forms))) (loop (cdr forms) acc))
          ((eq? (car (car forms)) 'import)
           (loop (cdr forms) (append (reverse (map import-set->name (cdr (car forms)))) acc)))
          ((eq? (car (car forms)) 'cond-expand)
           (loop (cdr forms)
                 (append (reverse (collect-imports (apply append (map cdr (cdr (car forms))))))
                         acc)))
          (else (loop (cdr forms) acc)))))

;; The first datum of a module file is its define-library form.
(define (library-imports path)
  (let ((form (read-expr (read-file-string path))))
    (unless (and (pair? form) (eq? (car form) 'define-library))
      (error "not a define-library form" path))
    (collect-imports (cddr form))))

(define (crash-module? name) (and (pair? name) (eq? (car name) 'crash)))

;; Walk from the named modules through every (crash ...) import, visiting
;; each module once. Returns (module . bad-import) for every import that is
;; neither in the allowlist nor a crash module.
(define (check-modules root modules allowlist)
  (let loop ((todo modules) (seen '()) (bad '()))
    (cond ((null? todo) (reverse bad))
          ((member (car todo) seen) (loop (cdr todo) seen bad))
          (else
           (let* ((name (car todo))
                  (imports (library-imports (module-path root name)))
                  (violations (filter (lambda (i) (not (or (member i allowlist) (crash-module? i))))
                                      imports))
                  (followups (filter crash-module? imports)))
             (loop (append (cdr todo) followups)
                   (cons name seen)
                   (append (reverse (map (lambda (v) (cons name v)) violations)) bad)))))))

(test-group "rules modules import only the allowlist"
  (let ((bad (check-modules "." RULES-MODULES ALLOWLIST)))
    (test "no import outside (sigil struct) (sigil math) (sigil list) and the rules family"
      (assert-equal '() bad))
    (test "the real rules.sgl was read: its import list is the known one"
      (assert-equal '((sigil struct) (sigil math) (crash stack layout))
                    (library-imports (module-path "." '(crash stack rules)))))
    (test "every rules module exists"
      (assert-true (every (lambda (m) (file-exists? (module-path "." m))) RULES-MODULES)))))

(test-group "positive control: planted imports are caught"
  (let ((bad (check-modules CONTROL-ROOT '((crash stack planted)) ALLOWLIST)))
    (test "the planted (sigil graphics) import is named against its module"
      (assert-true (and (member '((crash stack planted) . (sigil graphics)) bad) #t)))
    (test "a second import form after the export list is caught"
      (assert-true (and (member '((crash stack planted) . (sigil random)) bad) #t)))
    (test "an import inside cond-expand is caught"
      (assert-true (and (member '((crash stack planted) . (sigil io)) bad) #t)))
    (test "the helper reached only through planted's import is walked and its (sigil app) named"
      (assert-true (and (member '((crash stack helper) . (sigil app)) bad) #t)))
    (test "nothing else is reported"
      (assert-equal 4 (length bad)))
    (test "with (sigil app) allowed the helper is clean: the checker can stand down"
      (assert-equal '() (check-modules CONTROL-ROOT '((crash stack helper)) '((sigil core) (sigil app)))))))
