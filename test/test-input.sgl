;;; Gate leg 4 - input parity.
;;;
;;; One known pair, picked three ways: a pointer click at each tile's centre,
;;; the cursor model (a bounded search over arrow presses using the model's
;;; own step, which also proves the pair is reachable), and the hint model
;;; (the tag on the tile, typed letter by letter). All three must leave the
;;; board in the same state after the FIRST pick (one tile selected, nothing
;;; removed, no history) and after the second (the pair gone), and the same
;;; as two direct board-select calls. A second scenario picks a tile and then
;;; a playable tile of a different face, where the right answer is a changed
;;; selection and no removal: a model that bypasses board-select and removes
;;; directly goes red here.

(import (sigil test)
        (crash stack layout)
        (crash stack rules)
        (crash stack generate)
        (crash stack turtle)
        (crash geometry)
        (crash input)
        (crash look)
        (crash trace)
        (sigil math))

(define SEED 11)
(define VW 640)
(define VH 400)

(define lay (turtle-layout))
(define geom (make-geometry lay VW VH))

(define (frame pressed . rest)
  (make-input-frame pressed (if (pair? rest) (car rest) '()) (if (> (length rest) 1) (cadr rest) #f)))

(define (click-frame xy) (make-input-frame '() '() xy))

(define (fresh model)
  (let ((s (session-new lay SEED)))
    (let loop ((s s))
      (if (eq? (session-model s) model)
          s
          (loop (session-step s (frame '(tab) '(shift)) geom))))))

(define (canon s) (board-canonical (session-board s)))

;; --- the four ways of picking one tile --------------------------------------

(define (pick-by-pointer s id)
  (session-step s (click-frame (slot-centre geom id)) geom))

;; Breadth-first over the four arrow keys from the current highlight until
;; the highlight is id, then space. Fails the test if 40 presses cannot
;; reach it.
(define (pick-by-cursor s id)
  (let loop ((frontier (list s)) (seen (list (session-highlight s))) (depth 0))
    (cond ((null? frontier) (error "cursor cannot reach tile" id))
          ((> depth 40) (error "cursor search exceeded 40 presses" id))
          (else
           (let ((hit (find (lambda (x) (eqv? (session-highlight x) id)) frontier)))
             (if hit
                 (session-step hit (frame '(return)) geom)
                 (let next ((fr frontier) (out '()) (seen seen))
                   (if (null? fr)
                       (loop (reverse out) seen (+ depth 1))
                       (let step ((dirs '(left right up down)) (out out) (seen seen))
                         (if (null? dirs)
                             (next (cdr fr) out seen)
                             (let* ((x (session-step (car fr) (frame (list (car dirs))) geom))
                                    (h (session-highlight x)))
                               (if (memv h seen)
                                   (step (cdr dirs) out seen)
                                   (step (cdr dirs) (cons x out) (cons h seen))))))))))))))

;; Type the label the hint model puts on the tile, one key per letter.
(define (pick-by-hint s id)
  (let ((label (cdr (assv id (hint-labels s)))))
    (let loop ((chars (string->list label)) (s s))
      (if (null? chars)
          s
          (loop (cdr chars) (session-step s (frame (list (string->symbol (string (car chars))))) geom))))))
(define (run-path model pick a c)
  (let* ((s0 (fresh model))
         (s1 (pick s0 a))
         (s2 (pick s1 c)))
    (list (canon s1) (canon s2))))

(define (direct a c)
  (let* ((b0 (generate lay SEED))
         (b1 (board-select b0 a))
         (b2 (board-select b1 c)))
    (list (board-canonical b1) (board-canonical b2))))

;; A playable tile whose face differs from a's, not a itself.
(define (other-face-playable b a)
  (find (lambda (id) (and (not (= id a)) (not (faces-match? b a id))))
        (playable-slots b)))

(define (check-scenario name a c)
  (let ((expected (direct a c))
        (pointer (run-path 'cursor pick-by-pointer a c))
        (cursor (run-path 'cursor pick-by-cursor a c))
        (hint (run-path 'hint pick-by-hint a c)))
    (test (string-append name ": pointer, first pick") (assert-equal (car expected) (car pointer)))
    (test (string-append name ": pointer, second pick") (assert-equal (cadr expected) (cadr pointer)))
    (test (string-append name ": cursor, first pick") (assert-equal (car expected) (car cursor)))
    (test (string-append name ": cursor, second pick") (assert-equal (cadr expected) (cadr cursor)))
    (test (string-append name ": hint, first pick") (assert-equal (car expected) (car hint)))
    (test (string-append name ": hint, second pick") (assert-equal (cadr expected) (cadr hint)))))

(test-group "input parity: a matching pair"
  (let* ((b (generate lay SEED))
         (pair (car (board-solution b)))
         (a (car pair)) (c (cdr pair)))
    (test "the pair is a legal match on the fresh board"
      (assert-true (and (playable? b a) (playable? b c) (faces-match? b a c))))
    (test "direct selection removes exactly the pair"
      (let ((b2 (board-select (board-select b a) c)))
        (assert-equal 142 (board-tile-count b2))
        (assert-false (tile-present? b2 a))
        (assert-false (tile-present? b2 c))
        (assert-false (board-selected b2))
        (assert-equal 1 (length (board-history b2)))))
    (test "direct first pick selects and removes nothing"
      (let ((b1 (board-select b a)))
        (assert-equal a (board-selected b1))
        (assert-equal 144 (board-tile-count b1))
        (assert-equal 0 (length (board-history b1)))))
    (check-scenario "match" a c)))

(test-group "input parity: a mismatch moves the selection"
  (let* ((b (generate lay SEED))
         (a (car (car (board-solution b))))
         (c (other-face-playable b a)))
    (test "a non-matching playable tile exists" (assert-true (and c #t)))
    (test "direct mismatch reselects, removes nothing"
      (let ((b2 (board-select (board-select b a) c)))
        (assert-equal c (board-selected b2))
        (assert-equal 144 (board-tile-count b2))
        (assert-equal 0 (length (board-history b2)))))
    (check-scenario "mismatch" a c)))

(test-group "input: the pointer respects the stack"
  (let* ((s (fresh 'cursor))
         (b (session-board s))
         (covered (find (lambda (id) (and (tile-present? b id) (covered? b id))) (iota 144))))
    (test "a click on a covered tile's centre lands on the tile above it"
      (let* ((xy (slot-centre geom covered))
             (hit (hit-slot geom b (car xy) (cdr xy))))
        (assert-true (and hit (not (= hit covered))))))
    (test "a click on a blocked, uncovered tile changes nothing"
      (let* ((blocked (find (lambda (id) (and (tile-present? b id) (not (covered? b id))
                                              (blocked-left? b id) (blocked-right? b id)))
                            (iota 144)))
             (xy (slot-centre geom blocked))
             (after (session-step s (click-frame xy) geom)))
        (assert-equal blocked (hit-slot geom b (car xy) (cdr xy)))
        (assert-equal (canon s) (canon after))))
    (test "a click on empty board space changes nothing"
      (assert-equal (canon s) (canon (session-step s (click-frame (cons 1 1)) geom))))))

(test-group "input: commands"
  (let* ((s (fresh 'cursor))
         (pair (car (board-solution (session-board s))))
         (matched (pick-by-pointer (pick-by-pointer s (car pair)) (cdr pair))))
    (test "backspace undoes the match"
      (assert-equal (canon s) (canon (session-step matched (frame '(backspace)) geom))))
    (test "ctrl+z undoes the match"
      (assert-equal (canon s) (canon (session-step matched (frame '(z) '(ctrl)) geom))))
    (test "z without ctrl in the hint model is a label key, not undo"
      ;; on a session with something to undo, so the two readings differ
      (let* ((g (fresh 'hint))
             (gp (car (board-solution (session-board g))))
             (gm (pick-by-pointer (pick-by-pointer g (car gp)) (cdr gp)))
             (after (session-step gm (frame '(z)) geom)))
        (assert-equal 142 (board-tile-count (session-board gm)))
        (assert-equal 142 (board-tile-count (session-board after)))
        (assert-equal "z" (session-typed after))
        (assert-equal 144 (board-tile-count (session-board (session-step gm (frame '(z) '(ctrl)) geom))))))
    (test "shift+tab cycles hint -> cursor -> hint (D33: Tab alone toggles the tags)"
      (let* ((h (fresh 'hint))
             (s1 (session-step h (frame '(tab) '(shift)) geom))
             (s2 (session-step s1 (frame '(tab) '(shift)) geom)))
        (assert-equal '(hint cursor hint)
                      (list (session-model h) (session-model s1) (session-model s2)))))
    (test "ctrl+s shuffles and keeps the tile count"
      (let ((sh (session-step matched (frame '(s) '(ctrl)) geom)))
        (assert-equal 142 (board-tile-count (session-board sh)))
        (assert-false (equal? (canon matched) (canon sh)))))
    (test "ctrl+n deals the next seed"
      (let ((n (session-step s (frame '(n) '(ctrl)) geom)))
        (assert-equal (+ SEED 1) (session-seed n))
        (assert-true (board-equal? (generate lay (+ SEED 1)) (session-board n)))))
    (test "the cursor ring is hidden after a pick and shown again by an arrow"
      (let* ((c (fresh 'cursor))
             (moved (session-step c (frame '(right)) geom))
             (cp (car (board-solution (session-board c))))
             (picked (pick-by-pointer moved (car cp)))
             (moved-again (session-step picked (frame '(left)) geom)))
        (assert-false (session-cursor-shown c))
        (assert-true (session-cursor-shown moved))
        (assert-false (session-cursor-shown picked))
        (assert-true (and (session-highlight picked) #t))
        (assert-true (session-cursor-shown moved-again))))
    (test "ctrl+t does nothing (the polish row: one look, ruling D32)"
      (let ((s1 (session-step s (frame '(t) '(ctrl)) geom)))
        (assert-equal DEFAULT-LOOK (session-look s1))
        (assert-equal (session-board s) (session-board s1))
        (assert-equal (session-typed s) (session-typed s1))))
    (test "a tap on the TILES readout is a tap on the bar: nothing"
      (let* ((r (readout-rect geom 'zones))
             (s1 (session-step s
                               (make-input-frame '() '() (cons (+ (car r) 4) (+ (cadr r) 4)))
                               geom)))
        (assert-equal DEFAULT-LOOK (session-look s1))
        (assert-equal (session-board s) (session-board s1))
        (assert-false (hit-control geom 'zones (+ (car r) 4) (+ (cadr r) 4)))))
    (test "an old save's look name reads as the one look"
      (assert-equal DEFAULT-LOOK (session-look (session-with-look s 'test-tile)))
      (assert-equal DEFAULT-LOOK (session-look (session-with-look s 'b))))))

(test-group "hint model: labels and the priced hint"
  (let* ((s (fresh 'hint))
         (b (session-board s))
         (labels (hint-labels s)))
    (test "every uncovered present tile has a label and no covered tile does"
      (assert-equal (uncovered-slots b) (map car labels))
      (assert-true (every (lambda (id) (not (covered? b id))) (map car labels)))
      (assert-equal 84 (length labels)))
    (test "labels are distinct"
      (let loop ((ls (map cdr labels)))
        (cond ((null? ls) (assert-true #t))
              ((member (car ls) (cdr ls)) (assert-fail (string-append "duplicate label " (car ls))))
              (else (loop (cdr ls))))))
    (test "84 tiles need two-letter labels from the 26-letter alphabet"
      (assert-true (every (lambda (l) (= 2 (string-length l))) (map cdr labels))))
    (test "labels are made only of alphabet letters"
      (assert-true (every (lambda (l) (every (lambda (c) (memv c (string->list HINT-ALPHABET)))
                                             (string->list l)))
                          (map cdr labels))))
    (test "typing a blocked tile's label changes nothing but clears the typed text"
      (let* ((blocked (find (lambda (id) (and (tile-present? b id) (not (covered? b id))
                                              (not (playable? b id))))
                            (iota 144)))
             (after (pick-by-hint s blocked)))
        (assert-true (and blocked #t))
        (assert-equal (canon s) (canon after))
        (assert-equal "" (session-typed after))))
    (test "one letter typed shows as the typed prefix"
      (let ((after (session-step s (frame (list (string->symbol (string (string-ref (cdr (car labels)) 0))))) geom)))
        (assert-equal 1 (string-length (session-typed after)))))
    (test "space clears a half-typed label (and opens the tool stack, D33)"
      (let* ((one (session-step s (frame '(a)) geom))
             (cleared (session-step one (frame '(space)) geom)))
        (assert-equal "" (session-typed cleared))))
    (test "labels shift only when a tile leaves: same board, same labels"
      (assert-equal labels (hint-labels (session-step s (frame '(a)) geom))))
    (test "a pick keeps the very same labels (no recompute, P3c); a removal recomputes them"
      (let* ((pair (car (board-solution b)))
             (picked (pick-by-pointer s (car pair)))
             (removed (pick-by-pointer picked (cdr pair))))
        (assert-true (eq? (board-selected (session-board picked)) (car pair)))
        (assert-true (eq? labels (hint-labels picked)))
        (assert-equal 142 (board-tile-count (session-board removed)))
        (assert-false (eq? labels (hint-labels removed)))
        (assert-equal (uncovered-slots (session-board removed)) (map car (hint-labels removed)))))
    (test "the priced hint: ctrl+h then a face key rings a playable tile of that face and counts one"
      (let* ((pair (car (board-solution b)))
             (face (tile-face b (car pair)))
             (armed (session-step s (frame '(h) '(ctrl)) geom))
             (hinted (session-step armed (frame (list (face->key face))) geom)))
        (assert-true (session-hint-armed armed))
        (assert-false (session-hint-armed hinted))
        (assert-equal 1 (session-hints hinted))
        (assert-true (and (session-hint hinted) (playable? b (session-hint hinted))))
        (assert-equal face (tile-face b (session-hint hinted)))
        (assert-equal (canon s) (canon hinted))))
    (test "the priced hint on a face with no free tile counts and rings nothing"
      (let* ((face (find (lambda (f) (not (any (lambda (id) (eqv? (tile-face b id) f)) (playable-slots b))))
                         (iota FACE-COUNT)))
             (hinted (session-step (session-step s (frame '(h) '(ctrl)) geom) (frame (list (face->key face))) geom)))
        (assert-true (and face #t))
        (assert-equal 1 (session-hints hinted))
        (assert-false (session-hint hinted))))
    (test "a pick clears the hint ring"
      (let* ((pair (car (board-solution b)))
             (hinted (session-step (session-step s (frame '(h) '(ctrl)) geom)
                                   (frame (list (face->key (tile-face b (car pair))))) geom))
             (picked (pick-by-pointer hinted (car pair))))
        (assert-false (session-hint picked))
        (assert-equal 1 (session-hints picked))))))

(test-group "hint model: showing, hiding, typing, deselecting"
  (let* ((s (fresh 'hint))
         (b (session-board s))
         (pair (car (board-solution b)))
         (labels (hint-labels s)))
    (test "hint is the model a new session starts in"
      (assert-equal 'hint (session-model (session-new lay SEED))))
    (test "tags are shown by default and Tab hides and shows them"
      (let* ((hidden (session-step s (frame '(tab)) geom))
             (shown (session-step hidden (frame '(tab)) geom)))
        (assert-true (session-labels-shown s))
        (assert-false (session-labels-shown hidden))
        (assert-true (session-labels-shown shown))))
    (test "with tags hidden, tag letters do nothing"
      (let* ((hidden (session-step s (frame '(tab)) geom))
             (after (pick-by-hint hidden (car pair))))
        (assert-equal (canon s) (canon after))
        (assert-equal "" (session-typed after))))
    (test "tags are cached: the same list until the board changes"
      (assert-true (eq? labels (hint-labels (session-step s (frame (list (string->symbol (string (string-ref (cdr (car labels)) 0))))) geom))))
      (assert-false (eq? labels (hint-labels (pick-by-hint (pick-by-hint s (car pair)) (cdr pair))))))
    (test "backspace erases a typed letter, and undoes only when nothing is typed"
      (let* ((matched (pick-by-hint (pick-by-hint s (car pair)) (cdr pair)))
             (one (session-step matched (frame '(a)) geom))
             (erased (session-step one (frame '(backspace)) geom))
             (undone (session-step erased (frame '(backspace)) geom)))
        (assert-equal "a" (session-typed one))
        (assert-equal "" (session-typed erased))
        (assert-equal 142 (board-tile-count (session-board erased)))
        (assert-equal 144 (board-tile-count (session-board undone)))))
    (test "return deselects a selected tile in the hint model"
      (let* ((selected (pick-by-hint s (car pair)))
             (cleared (session-step selected (frame '(return)) geom)))
        (assert-equal (car pair) (board-selected (session-board selected)))
        (assert-false (board-selected (session-board cleared)))
        (assert-equal 144 (board-tile-count (session-board cleared)))))
    (test "return deselects in the cursor model too"
      (let* ((c (fresh 'cursor))
             (selected (pick-by-pointer c (car pair)))
             (cleared (session-step selected (frame '(return)) geom)))
        (assert-equal (car pair) (board-selected (session-board selected)))
        (assert-false (board-selected (session-board cleared)))))
    (test "typing the selected tile's own tag again deselects it"
      (let* ((selected (pick-by-hint s (car pair)))
             (cleared (pick-by-hint selected (car pair))))
        (assert-false (board-selected (session-board cleared)))
        (assert-equal 144 (board-tile-count (session-board cleared)))))))

;; --- the node's objective (P5, D64) -------------------------------------------

(test-group "the objective: marked pairs from the deal's own line"
  (test "mark-slots takes k pairs from the middle third of the solution, evenly spaced; a fresh session has none"
    (let* ((s (session-new lay SEED))
           (b (session-board s))
           (line (board-solution b))
           (n (length line))
           (marks (mark-slots b 3)))
      (assert-equal '() (session-marks s))
      (assert-equal 6 (length marks))
      (assert-equal 72 n)
      ;; every mark is a slot of a pair whose position in the line lies in [n/3, 2n/3)
      (let ((positions (map (lambda (id)
                              (let loop ((l line) (i 0))
                                (cond ((null? l) #f)
                                      ((or (= (car (car l)) id) (= (cdr (car l)) id)) i)
                                      (else (loop (cdr l) (+ i 1))))))
                            marks)))
        (assert-true (every (lambda (p) (and p (>= p (quotient n 3)) (< p (quotient (* 2 n) 3)))) positions))
        (assert-equal '(24 24 32 32 40 40) positions))
      (assert-equal '() (mark-slots b 0))
      (assert-equal (mark-slots b 3) (mark-slots (session-board (session-new lay SEED)) 3))))   ; per seed
  (test "the last mark off extracts: the rest of the board leaves at once, the trace finishes, the session reads extracted"
    (let* ((s0 (session-new lay SEED))
           (b0 (session-board s0))
           (line (board-solution b0))
           (s (session-with-marks s0 (mark-slots b0 2)))
           (last-mark (list-ref (session-marks s) 3))
           ;; play the line until the pair holding the last mark is next
           (upto (let loop ((l line) (acc '()))
                   (if (or (= (car (car l)) last-mark) (= (cdr (car l)) last-mark))
                       (cons (reverse acc) (car l))
                       (loop (cdr l) (cons (car l) acc)))))
           (played (fold-left (lambda (s pair) (session-pick (session-pick s (car pair)) (cdr pair))) s (car upto)))
           (pair (cdr upto)))
      (assert-equal 2 (length (session-marks-left played)))
      (assert-false (session-extracted? played))
      (assert-true (> (board-tile-count (session-board played)) 2))
      (let ((done (session-pick (session-pick played (car pair)) (cdr pair))))
        (assert-true (session-extracted? done))
        (assert-true (board-cleared? (session-board done)))
        (assert-equal '() (session-marks-left done))
        (assert-equal 'cleared (trace-phase (session-trace done)))
        (assert-equal (+ 1 (session-moves played)) (session-moves done))
        ;; undo takes the extraction back: the board after the last pair, the pair itself one more undo back
        (assert-equal (- (board-tile-count (session-board played)) 2) (board-tile-count (board-undo (session-board done))))
        (assert-equal (board-tile-count (session-board played)) (board-tile-count (board-undo (board-undo (session-board done))))))
      ;; a board with no marks clears only when the last tile leaves
      (let ((plain (fold-left (lambda (s pair) (session-pick (session-pick s (car pair)) (cdr pair))) s0 (car upto))))
        (assert-false (board-cleared? (session-board (session-pick (session-pick plain (car pair)) (cdr pair)))))))))
