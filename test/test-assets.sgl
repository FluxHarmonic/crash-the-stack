;;; Gate (P3) legs 1 and 2 - provenance and resolution.
;;;
;;; Leg 1, population-derived in both directions: every file under
;;; assets/ has a row in assets/MANIFEST and every row names a file.
;;; Both sets come from the tree, never from a list in this file. The
;;; population is CLASSIFIED, not filtered: every path under assets/
;;; lands in exactly one bucket (shipped, refs, src, bookkeeping, other),
;;; the counts are printed, and only the shipped bucket is held against
;;; the manifest; anything in `other` is a red, because a file the
;;; classifier does not know is a file nobody accounted for. The positive
;;; control is a scratch copy of the tree with a stray file (run by hand
;;; in the evidence note, and by this file's own probe below against a
;;; temporary directory).
;;;
;;; Leg 2: every "assets/..." string literal in src/**/*.sgl names a file
;;; that exists, so a texture or sample load cannot point at nothing on
;;; the native build; the web half (every fetch the page makes answers
;;; 200) is verify.mjs's assets sub-arm.

(import (sigil test)
        (sigil io)
        (sigil fs)
        (sigil string)
        (sigil list)
        (sigil path))

(define ASSETS "assets")
(define MANIFEST "assets/MANIFEST")
(define BOOKKEEPING '("assets/LICENSE" "assets/RESERVED.md" "assets/MANIFEST"))

;; --- the tree, classified -------------------------------------------------

(define (starts-with? s prefix)
  (and (>= (string-length s) (string-length prefix))
       (string=? (substring s 0 (string-length prefix)) prefix)))

(define (classify path)
  (cond ((member path BOOKKEEPING) 'bookkeeping)
        ((starts-with? path "assets/refs/") 'refs)
        ((starts-with? path "assets/src/") 'src)
        ((starts-with? path "assets/") 'shipped)
        (else 'other)))

(define (bucket paths kind)
  (filter (lambda (p) (eq? (classify p) kind)) paths))

;; The manifest's rows: (path . columns) for every non-comment line.
(define (manifest-rows path)
  (let ((text (read-file-string path)))
    (filter-map (lambda (line)
                  (let ((trimmed (string-trim line)))
                    (and (> (string-length trimmed) 0)
                         (not (char=? (string-ref trimmed 0) #\#))
                         (let ((cols (map string-trim (string-split trimmed "|"))))
                           (cons (string-append "assets/" (car cols)) cols)))))
                (string-split text "\n"))))

(define (report label items)
  (display "  ") (display label) (display " ") (display (length items))
  (unless (null? items) (display " ") (write items))
  (newline))

(define (check-tree root manifest)
  (let* ((all (find-files root))
         (shipped (bucket all 'shipped))
         (rows (manifest-rows manifest))
         (row-paths (map car rows))
         (unmanifested (filter (lambda (p) (not (member p row-paths))) shipped))
         (missing (filter (lambda (p) (not (member p shipped))) row-paths)))
    (display "assets under ") (display root) (display ": ")
    (display (length all)) (newline)
    (report "shipped" shipped)
    (report "refs" (bucket all 'refs))
    (report "src" (bucket all 'src))
    (report "bookkeeping" (bucket all 'bookkeeping))
    (report "other" (bucket all 'other))
    (report "rows" row-paths)
    (report "unmanifested" unmanifested)
    (report "missing" missing)
    (list all shipped rows unmanifested missing (bucket all 'other))))

(define LICENCES '("CC-BY-4.0" "reserved"))
(define ORIGINS '("hand-made" "generated-and-shaped" "generated-raw"))
(define SHAPERS '("hand" "pipeline" "David"))

(test-group "assets: manifest completeness (leg 1)"
  (let* ((r (check-tree ASSETS MANIFEST))
         (all (car r))
         (shipped (cadr r))
         (rows (caddr r))
         (unmanifested (cadddr r))
         (missing (list-ref r 4))
         (other (list-ref r 5)))
    (test "the tree has files"
      (assert-true (pair? all)))
    (test "every path is classified (none in other)"
      (assert-equal '() other))
    (test "every shipped file has a manifest row"
      (assert-equal '() unmanifested))
    (test "every manifest row names a file"
      (assert-equal '() missing))
    (test "the counts agree"
      (assert-equal (length shipped) (length rows)))
    (for-each (lambda (row)
                (let ((cols (cdr row)))
                  (test (string-append (car cols) ": eight columns")
                    (assert-equal 8 (length cols)))
                  (when (= (length cols) 8)
                    (test (string-append (car cols) ": licence")
                      (assert-true (and (member (cadr cols) LICENCES) #t)))
                    (test (string-append (car cols) ": origin")
                      (assert-true (and (member (caddr cols) ORIGINS) #t)))
                    (test (string-append (car cols) ": shaped-by")
                      (assert-true (and (member (list-ref cols 6) SHAPERS) #t)))
                    (test (string-append (car cols) ": date")
                      (assert-equal 10 (string-length (list-ref cols 5)))))))
              rows)))

;; The positive control, run here as well: a temporary tree with the
;; real manifest and one stray file must report the stray by name, and a
;; manifest row with no file must be reported too.
(test-group "assets: the gate can say no (positive control)"
  (call-with-temp-directory
    (lambda (dir)
      (let ((root (string-append dir "/assets")))
        (make-directory root)
        (for-each (lambda (p)
                    (let ((rel (substring p (+ 1 (string-length ASSETS)) (string-length p))))
                      (ensure-directory (string-append root "/" (path-dirname rel)))
                      (copy-file p (string-append root "/" rel))))
                  (find-files ASSETS))
        (write-file-string (string-append root "/stray.png") "not a png")
        (write-file-string (string-append root "/MANIFEST")
                           (string-append (read-file-string MANIFEST)
                                          "ghost.png | CC-BY-4.0 | hand-made | - | - | 2026-09-18 | hand | a row with no file\n"))
        (with-current-directory dir
          (lambda ()
            (let* ((r (check-tree "assets" "assets/MANIFEST"))
                   (unmanifested (cadddr r))
                   (missing (list-ref r 4)))
              (test "a stray file is reported by name"
                (assert-equal '("assets/stray.png") unmanifested))
              (test "a row without a file is reported by name"
                (assert-equal '("assets/ghost.png") missing)))))))))

;; --- leg 2: every asset path in the source resolves ----------------------

;; Every "assets/..." string literal in a file.
(define (asset-literals path)
  (let ((text (read-file-string path)))
    (let loop ((i 0) (acc '()))
      (let ((at (string-index-of text "\"assets/" i)))
        (if (not at)
            (reverse acc)
            (let* ((start (+ at 1))
                   (end (string-index-of text "\"" start)))
              (if (not end)
                  (reverse acc)
                  (loop (+ end 1) (cons (substring text start end) acc)))))))))

(define (string-index-of text needle from)
  (let ((n (string-length needle))
        (len (string-length text)))
    (let loop ((i from))
      (cond ((> (+ i n) len) #f)
            ((string=? (substring text i (+ i n)) needle) i)
            (else (loop (+ i 1)))))))

(test-group "assets: every asset path in src/ resolves (leg 2)"
  (let* ((files (find-files "src" (lambda (p) (string-ends-with? p ".sgl"))))
         (refs (apply append (map (lambda (f)
                                    (map (lambda (lit) (cons f lit)) (asset-literals f)))
                                  files))))
    (display "  asset literals in src: ") (display (length refs)) (display " ")
    (write (map cdr refs)) (newline)
    (test "the source names at least one asset"
      (assert-true (pair? refs)))
    (for-each (lambda (ref)
                (test (string-append (car ref) " -> " (cdr ref) " exists")
                  (assert-true (file-exists? (cdr ref)))))
              refs)))
