;;; Hand-derived controls for the runtime stepper; no generated witnesses.
(import (sigil test)
        (sigil list)
        (crash cards deck)
        (crash checksum rules)
        (crash checksum solve))

(define (root-pyramid) (make-vector 28 12))
(define (root-feed) (make-list 24 12))

(define (solve-control pyramid feed budget limit)
  (checksum-solve-run! (checksum-solve-start pyramid feed budget limit) (lambda () #t)))

(define (replay-control pyramid feed line)
  (let loop ((b (checksum-board pyramid feed)) (line line))
    (cond ((null? line) (checksum-won? b))
          ((memq (car line) '(pull rollback))
           (let ((after (checksum-select b 'pull)))
             (and (not (eq? b after)) (loop after (cdr line)))))
          (else
           (let* ((move (car line))
                  (selected (checksum-select b (car move)))
                  (after (if (cdr move) (checksum-select selected (cdr move)) selected)))
             (and (= (+ 1 (cboard-moves b)) (cboard-moves after))
                  (loop after (cdr line))))))))

(test-group "checksum: runtime search controls"
  (test "runtime ROOTs uncover the complete pyramid; missing complements prove loss"
    (let ((roots (solve-control (root-pyramid) (root-feed) 100 3))
          (lost (solve-control (make-vector 28 0) (make-list 24 0) 100 3)))
      (assert-equal 'solved (checksum-solve-status roots))
      (assert-true (replay-control (root-pyramid) (root-feed) (checksum-solve-line roots)))
      (assert-equal 'unsolvable (checksum-solve-status lost))))
  (test "runtime buffer-to-PULL and buffer-to-pyramid moves replay through player doors"
    (let* ((pyramid (root-pyramid))
           (feed (append '(4 7 11) (make-list 21 12))))
      (vector-set! pyramid 0 0)
      (let* ((s (solve-control pyramid feed 1000 3)) (line (checksum-solve-line s)))
        (assert-equal 'solved (checksum-solve-status s))
        (assert-true (member (cons 'waste 'pull) line))
        (assert-true (member (cons 0 'waste) line))
        (assert-true (replay-control pyramid feed line)))))
  (test "runtime forbids a necessary fourth pass; permitting it is a positive control"
    (let ((pyramid (root-pyramid))
          (feed (append '(11 4 10 4 9 4 8) (make-list 17 4))))
      (for-each (lambda (id offset) (vector-set! pyramid id offset)) '(0 1 3 6) '(0 1 2 3))
      (let ((blocked (solve-control pyramid feed 10000 3))
            (allowed (solve-control pyramid feed 10000 4)))
        (assert-equal 'unsolvable (checksum-solve-status blocked))
        (assert-equal 'solved (checksum-solve-status allowed))
        (assert-equal 3 (length (filter (lambda (x) (eq? x 'rollback)) (checksum-solve-line allowed)))))))
  (test "runtime preserves removed-feed order and clears a chain on exactly the third pass"
    (let ((pyramid (root-pyramid))
          (feed (append '(11 4 10 4 9) (make-list 19 4))))
      (for-each (lambda (id offset) (vector-set! pyramid id offset)) '(0 1 3) '(0 1 2))
      (let ((s (solve-control pyramid feed 10000 3)))
        (assert-equal 'solved (checksum-solve-status s))
        (assert-equal 2 (length (filter (lambda (x) (eq? x 'rollback)) (checksum-solve-line s))))
        (assert-true (replay-control pyramid feed (checksum-solve-line s))))))
  (test "runtime node exhaustion is inconclusive, with no accepted line"
    (let ((pyramid (root-pyramid)))
      (vector-set! pyramid 0 0)
      (let ((s (solve-control pyramid (cons 11 (make-list 23 12)) 0 3)))
        (assert-equal 'inconclusive (checksum-solve-status s))
        (assert-equal '() (checksum-solve-line s))
        (assert-equal 0 (checksum-solve-nodes s)))))
  (test "runtime frame slicing preserves the line, counters and unmodified dealt packets"
    (let* ((pyramid (root-pyramid)) (feed (append '(4 7 11) (make-list 21 12))))
      (vector-set! pyramid 0 0)
      (let ((whole (solve-control pyramid feed 1000 3))
            (sliced (checksum-solve-start pyramid feed 1000 3)))
        (checksum-solve-run! sliced (lambda () #f))
        (assert-equal 0 (checksum-solve-nodes sliced))
        (let loop ()
          (when (eq? 'running (checksum-solve-status sliced))
            (let ((remaining 2))
              (checksum-solve-run! sliced (lambda () (set! remaining (- remaining 1)) (>= remaining 0))))
            (loop)))
        (assert-equal (checksum-solve-line whole) (checksum-solve-line sliced))
        (assert-equal (checksum-solve-nodes whole) (checksum-solve-nodes sliced))
        (assert-equal (checksum-solve-failed whole) (checksum-solve-failed sliced))
        (assert-equal 3 (checksum-solve-draws sliced))
        (assert-equal 2 (checksum-solve-needed sliced))
        (assert-equal 0 (vector-ref pyramid 0))
        (assert-equal 12 (vector-ref pyramid 27))
        (assert-equal '(4 7 11) (take feed 3))))))
