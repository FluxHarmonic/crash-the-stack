;;; Gate (P3) - every glyph sheet obeys the bible's readability rule.
;;;
;;; Section 2 of the style bible, measured not felt: every glyph lives in
;;; the 5x7 cell, and no two glyphs in one suit differ by fewer than 3
;;; cells (the daemons are a suit for this purpose). Plus: 36 glyphs per
;;; sheet, seven rows of five, no glyph blank (a full block is MEM's
;;; first glyph, so full is allowed), and every sheet a look names is in
;;; the registry.
;;; A sabotage: copy one glyph over another in a sheet's text, rebuild the
;;; sheet, and the suit's distance assertion names the pair.

(import (sigil test)
        (sigil list)
        (sigil string)
        (sigil fs)
        (crash stack rules)
        (crash glyphs)
        (crash look))

;; Cells that differ between two glyphs (lists of seven 5-char strings).
(define (distance a b)
  (let loop ((ra a) (rb b) (n 0))
    (if (null? ra)
        n
        (loop (cdr ra)
              (cdr rb)
              (+ n (let cells ((i 0) (k 0))
                     (if (= i 5)
                         k
                         (cells (+ i 1)
                                (if (char=? (string-ref (car ra) i) (string-ref (car rb) i))
                                    k
                                    (+ k 1))))))))))

(define (distance-w a b width)
  (let loop ((ra a) (rb b) (n 0))
    (if (null? ra)
        n
        (loop (cdr ra)
              (cdr rb)
              (+ n (let cells ((i 0) (k 0))
                     (if (= i width)
                         k
                         (cells (+ i 1)
                                (if (char=? (string-ref (car ra) i) (string-ref (car rb) i))
                                    k
                                    (+ k 1))))))))))

(define (lit-cells rows)
  (fold (lambda (n row)
          (+ n (length (filter (lambda (c) (char=? c #\#)) (string->list row)))))
        0
        rows))

(define (well-formed? rows)
  (and (list? rows)
       (= (length rows) 7)
       (every (lambda (r)
                (and (string? r)
                     (= (string-length r) 5)
                     (every (lambda (c) (or (char=? c #\#) (char=? c #\.)))
                            (string->list r))))
              rows)))

(define MIN-DISTANCE 3)

(define (suit-faces suit)
  (let loop ((f (- FACE-COUNT 1)) (acc '()))
    (if (< f 0)
        acc
        (loop (- f 1) (if (= (face-suit f) suit) (cons f acc) acc)))))

(define (check-sheet name)
  (let ((sheet (sheet-ref name)))
    (test (string-append "sheet " (symbol->string name) " has 36 glyphs")
      (assert-true (and (vector? sheet) (= (vector-length sheet) FACE-COUNT))))
    (let loop ((f 0))
      (when (< f FACE-COUNT)
        (let ((rows (vector-ref sheet f))
              (label (string-append (symbol->string name) " " (number->string f)
                                    " " (or (sheet-name name f) "?"))))
          (test (string-append label ": seven rows of five cells")
            (assert-true (well-formed? rows)))
          (test (string-append label ": not blank")
            (assert-true (> (lit-cells rows) 0))))
        (loop (+ f 1))))
    ;; the distance rule, per suit, every pair once
    (let suits ((suit 0))
      (when (<= suit 4)
        (let ((faces (suit-faces suit)))
          (let outer ((fs faces))
            (unless (null? fs)
              (for-each (lambda (g)
                          (let ((d (distance (vector-ref sheet (car fs)) (vector-ref sheet g))))
                            (test (string-append (symbol->string name) " suit " (number->string suit)
                                                 ": " (or (sheet-name name (car fs)) "?")
                                                 " vs " (or (sheet-name name g) "?")
                                                 " differ by " (number->string d) " cells (min "
                                                 (number->string MIN-DISTANCE) ")")
                              (assert-true (>= d MIN-DISTANCE)))))
                        (cdr fs))
              (outer (cdr fs)))))
        (suits (+ suit 1))))))

(test-group "glyphs: the registry and the looks"
  (test "the registry has at least one sheet"
    (assert-true (pair? SHEETS)))
  (test "mem-full is face 0, the first daemon is face 32"
    (assert-equal 0 (face-suit 0))
    (assert-equal 3 (face-suit 31))
    (assert-equal 4 (face-suit 32))
    (assert-true (daemon-face? 35))
    (assert-false (daemon-face? 31)))
  (for-each (lambda (l)
              (test (string-append "look " (symbol->string (look-name l)) " names a sheet in the tree, or keys")
                (assert-true (or (eq? (look-glyphs l) 'keys)
                                 (and (sheet-ref (look-glyphs l)) #t))))
              (when (look-texture l)
                (test (string-append "look " (symbol->string (look-name l)) "'s texture is in the tree, a strip of its frames")
                  (assert-true (file-exists? (look-texture l)))
                  (assert-true (> (look-frames l) 0))
                  (assert-true (< (look-side l) (look-frame-w l))))))
            LOOKS)
  (test "look-textures lists every texture path a look names, once each"
    (assert-true (every (lambda (l) (or (not (look-texture l)) (and (member (look-texture l) (look-textures)) #t))) LOOKS))
    (assert-equal (length (look-textures))
                  (length (let loop ((ps (map look-texture LOOKS)) (acc '()))
                            (cond ((null? ps) acc)
                                  ((or (not (car ps)) (member (car ps) acc)) (loop (cdr ps) acc))
                                  (else (loop (cdr ps) (cons (car ps) acc)))))))))

(test-group "glyphs: the packet class marks"
  (test "four marks of 8x8, none blank, each at least 8 cells from the others"
    (assert-equal 4 (vector-length CLASS-MARKS))
    (let loop ((i 0))
      (when (< i 4)
        (let ((rows (vector-ref CLASS-MARKS i)))
          (assert-equal MARK-H (length rows))
          (assert-true (every (lambda (r) (= (string-length r) MARK-W)) rows))
          (assert-true (> (lit-cells rows) 0))
          (let inner ((j (+ i 1)))
            (when (< j 4)
              (assert-true (>= (distance-w rows (vector-ref CLASS-MARKS j) MARK-W) 8))
              (inner (+ j 1)))))
        (loop (+ i 1))))))

(test-group "glyphs: the readability rule, every sheet"
  (for-each (lambda (entry) (check-sheet (car entry))) SHEETS))

;; The data module is generated from the text; a stale module would draw
;; a sheet nobody edited. Parse the text here (a "= NAME" line opens a
;; glyph, the next seven 5-cell lines are its rows, "#..." otherwise a
;; comment) and hold the registered sheet to it, glyph by glyph.
(define (parse-sheet-text path)
  (let loop ((lines (string-split (read-file-string path) "\n"))
             (names '())
             (glyphs '())
             (rows '()))
    (cond ((null? lines)
           (let ((glyphs (if (pair? rows) (cons (reverse rows) glyphs) glyphs)))
             (cons (list->vector (reverse names)) (list->vector (reverse glyphs)))))
          ((and (= (string-length (car lines)) 5)
                (every (lambda (c) (or (char=? c #\#) (char=? c #\.))) (string->list (car lines))))
           (loop (cdr lines) names glyphs (cons (car lines) rows)))
          ((and (> (string-length (car lines)) 2) (string=? (substring (car lines) 0 2) "= "))
           (loop (cdr lines)
                 (cons (substring (car lines) 2 (string-length (car lines))) names)
                 (if (pair? rows) (cons (reverse rows) glyphs) glyphs)
                 '()))
          (else (loop (cdr lines) names glyphs rows)))))

(test-group "glyphs: every registered sheet is its text"
  (for-each (lambda (entry)
              (let* ((name (car entry))
                     (path (string-append "assets/src/glyphs/" (symbol->string name) ".txt"))
                     (parsed (and (file-exists? path) (parse-sheet-text path))))
                (test (string-append "sheet " (symbol->string name) " has its text in assets/src/glyphs")
                  (assert-true (and parsed #t)))
                (when parsed
                  (test (string-append "sheet " (symbol->string name) ": the module's glyphs are the text's")
                    (assert-equal (vector->list (cdr parsed)) (vector->list (cdr entry))))
                  (test (string-append "sheet " (symbol->string name) ": the module's names are the text's")
                    (assert-equal (vector->list (car parsed))
                                  (let loop ((f 0) (acc '()))
                                    (if (= f FACE-COUNT) (reverse acc) (loop (+ f 1) (cons (sheet-name name f) acc)))))))))
            SHEETS))
