;;; Gate leg 2 - playability on the Turtle.
;;;
;;; The transcription loads to 144 tiles in five layers (87 36 16 4 1). The
;;; apex is playable; both ends of the top row are playable; a bottom-layer
;;; tile with neighbours on both sides and a tile above it is not. The initial
;;; playable count is pinned; its derivation is in the evidence note
;;; (investigations/crash-the-stack-p0a).

(import (sigil test)
        (sigil math)
        (crash stack layout)
        (crash stack rules)
        (crash stack turtle))

;; Slot id of the tile at whole-tile (x, y) on a layer, or #f.
(define (slot-at lay layer x y)
  (let ((hx (exact (round (* 2 x)))) (hy (exact (round (* 2 y)))))
    (let loop ((id 0))
      (cond ((= id (layout-slot-count lay)) #f)
            ((let ((s (layout-slot lay id)))
               (and (= (slot-layer s) layer) (= (slot-hx s) hx) (= (slot-hy s) hy)))
             id)
            (else (loop (+ id 1)))))))

(define TURTLE-INITIAL-PLAYABLE 35)

(test-group "turtle: shape"
  (let ((lay (turtle-layout)))
    (test "144 tiles" (assert-equal 144 (layout-slot-count lay)))
    (test "five layers" (assert-equal 5 (layout-layer-count lay)))
    (test "87 36 16 4 1" (assert-equal '(87 36 16 4 1) (layout-layer-counts lay)))
    (test "bounds in half-units" (assert-equal '(-13 15 -7 7)
                                                (list (layout-min-hx lay) (layout-max-hx lay)
                                                      (layout-min-hy lay) (layout-max-hy lay))))))

(test-group "turtle: playable?"
  (let* ((lay (turtle-layout))
         (faces (make-vector 144 0))
         (b (board-new lay faces)))
    (test "the apex (0,0) on layer 4 is playable"
      (assert-true (playable? b (slot-at lay 4 0 0))))
    (test "the leftmost tile of the top row (-5.5,-3.5) is playable"
      (assert-true (playable? b (slot-at lay 0 -5.5 -3.5))))
    (test "the rightmost tile of the top row (5.5,-3.5) is playable"
      (assert-true (playable? b (slot-at lay 0 5.5 -3.5))))
    (test "an interior top-row tile (0.5,-3.5) is blocked on both sides"
      (assert-false (playable? b (slot-at lay 0 0.5 -3.5))))
    (test "(0.5,-2.5) on layer 0 has both neighbours and a tile above: not playable"
      (let ((id (slot-at lay 0 0.5 -2.5)))
        (assert-true (blocked-left? b id))
        (assert-true (blocked-right? b id))
        (assert-true (covered? b id))
        (assert-false (playable? b id))))
    (test "(2.5,-2.5) on layer 1: free on the right and clear of layer 2: playable"
      (let ((id (slot-at lay 1 2.5 -2.5)))
        (assert-false (covered? b id))
        (assert-true (playable? b id))))
    (test "the far-right end tile (7.5,0) is playable and (6.5,0) is not"
      (assert-true (playable? b (slot-at lay 0 7.5 0)))
      (assert-false (playable? b (slot-at lay 0 6.5 0))))
    (test "the far-left end tile (-6.5,0) is playable"
      (assert-true (playable? b (slot-at lay 0 -6.5 0))))
    (test "the tiles the end tile straddles, (-5.5,-0.5) and (-5.5,0.5), are blocked"
      (assert-false (playable? b (slot-at lay 0 -5.5 -0.5)))
      (assert-false (playable? b (slot-at lay 0 -5.5 0.5))))
    (test "initial playable count (derivation in the evidence note)"
      (assert-equal TURTLE-INITIAL-PLAYABLE (length (playable-slots b))))
    (test "layer-4 corners are covered by the apex"
      (assert-true (covered? b (slot-at lay 3 0.5 -0.5)))
      (assert-false (playable? b (slot-at lay 3 0.5 -0.5))))))
