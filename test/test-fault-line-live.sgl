;;; Exercise the new Defrag track through the actual live player and resampler.
(import (sigil test)
        (sigil math)
        (sigil io)
        (sigil fs)
        (crash music)
        (crash music live)
        (crash audio)
        (motif tune))

(define FRAME 1024)
(define FRAME-MS (/ (* 1000.0 FRAME) (audio-rate)))
(define BAR-MS (/ 240000.0 126))
(define *elapsed* 0.0)
(define *landings* '())
(define *calm-looped* #f)
(define *tense-looped* #f)
(define *tense-started* #f)
(define *tense-left-region* #f)
(define *previous* #f)

(define (advance! out phase remaining)
  (live-music-frame! 'cards phase remaining 'cards 7)
  (live-music-pull! out 0 FRAME)
  (set! *elapsed* (+ *elapsed* FRAME-MS))
  (let ((position (live-music-position)))
    (when (and position *previous*)
      (when (and (= (car *previous*) 1) (= (car position) 0))
        (set! *calm-looped* #t))
      (when (and (= (car *previous*) 9) (= (car position) 3))
        (set! *tense-looped* #t)))
    (when (and position (eq? phase 'counter))
      (when (>= (car position) 3)
        (set! *tense-started* #t))
      (when (and *tense-started* (< (car position) 3))
        (set! *tense-left-region* #t)))
    (set! *previous* position)))

(define (run-for! out milliseconds phase remaining)
  (let loop ((left milliseconds))
    (when (> left 0)
      (advance! out phase (and remaining (+ remaining left)))
      (loop (- left FRAME-MS)))))

(test-group "Fault Line: Defrag live trial"
  (let* ((score (read-tune-file (music-tune-path 'fault-line)))
         (out (make-bytevector (* 8 FRAME) 0)))
    (live-music-stop!)
    (live-music-set-tune-door! #f)
    (live-music-set-loader!
      (lambda (name) (read-file-string (music-tune-path name))))
    (live-music-set-rate! 22050 #t)
    (live-music-set-say!
      (lambda words
        (when (and (= (length words) 6)
                   (equal? (list-ref words 1) "section")
                   (equal? (list-ref words 3) "at"))
          (set! *landings*
            (cons (list (list-ref words 2)
                        (list-ref words 4)
                        *elapsed*)
                  *landings*)))))
    (live-music-fresh!)
    ;; More than the 30.476 s calm loop: prove it does not enter rock by itself.
    (run-for! out 33000.0 'trace 600000.0)
    (let ((picked (live-music-name))
          (calm (live-music-position)))
      (test "seed 7 selects Fault Line in Defrag, with engine section marks"
        (assert-equal 'fault-line picked)
        (assert-equal '((calm . 0) (fill . 2) (tense . 3)) (tune-marks score)))
      (test "the quiet region loops while the trace is still far away"
        (assert-true *calm-looped*)
        (assert-true (and calm (< (car calm) 2)))))
    (let ((strike (+ *elapsed* 8000.0)))
      (run-for! out 8000.0 'trace 0.0)
      ;; Long enough to traverse all seven tense phrases and its B03 return.
      (run-for! out 112000.0 'counter #f)
      (let ((landings (reverse *landings*))
            (position (live-music-position)))
        (test "the entrance fill lands at order 2 and tense at order 3 near the strike"
          (let ((fill (assoc "fill" landings))
                (tense (assoc "tense" landings)))
            (assert-true (and fill tense #t))
            (when (and fill tense)
              (assert-equal 2 (cadr fill))
              (assert-equal 3 (cadr tense))
              (assert-true (<= (abs (- (caddr tense) strike))
                               (+ (* 0.5 BAR-MS) (* 2 FRAME-MS)))))))
        (test "all rock phrases loop back to tense, without replaying the entrance"
          (assert-true *tense-looped*)
          (assert-false *tense-left-region*)
          (assert-true (and position (>= (car position) 3))))))
    (run-for! out 5000.0 'trace 600000.0)
    (let ((position (live-music-position))
          (section (live-music-section)))
      (test "escape returns to the quiet region"
        (assert-equal 'calm section)
        (assert-true (and position (< (car position) 2)))))
    (live-music-stop!)))
