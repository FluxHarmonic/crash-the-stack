;;; Gate leg 4 (P2) - auto-complete.
;;;
;;; Auto-complete arms only when every tableau card is face up, and then
;;; empties the table into the four foundations. A hand-built position
;;; with seven face-up cards on the tableau and the rest in the stock
;;; arms at once and, stepped on the clock, is won with the tableau
;;; empty; the same position with one tableau card turned face down does
;;; not arm however many ticks pass, and a tap still plays normally. The
;;; history is cut at arming, so undo is refused during the run.

(import (sigil test)
        (sigil math)
        (sigil list)
        (crash input)
        (crash cards deck)
        (crash cards rules)
        (crash cards geometry)
        (crash cards input))

(define geom (make-card-geometry 640 400))

(define (c suit rank) (make-card suit rank))

;; Seven face-up tops; everything else in the stock, in deck order.
(define TOPS (list (c 0 1) (c 1 1) (c 2 1) (c 3 1) (c 0 2) (c 1 2) (c 2 2)))

(define (position ups)
  (let ((tableau (list->vector (list-map (lambda (card up?) (list (cons card up?))) TOPS ups))))
    (game tableau: tableau
          foundations: (make-vector FOUNDATIONS '())
          stock: (filter (lambda (card) (not (memv card TOPS))) (fresh-deck))
          draw: 1)))

(define ALL-UP (position '(#t #t #t #t #t #t #t)))
(define ONE-DOWN (position '(#t #t #t #f #t #t #t)))

(define (restore g) (deal-restore 5 g 'tags #t))

(define (advance d ticks)
  (deal-advance d ticks))

(test-group "leg 4: auto-complete arms only with every tableau card face up"
  (test "the all-up position arms on arrival, with its history cut"
    (let ((d (restore ALL-UP)))
      (assert-true (deal-auto d))
      (assert-equal MSG-AUTO (deal-message d))
      (assert-equal 45 (length (game-stock (deal-game d))))
      (assert-true (game-all-up? ALL-UP))))
  (test "one face-down card: not armed, and 6000 ticks move no card (only the trace's clock)"
    (let* ((d (restore ONE-DOWN))
           (d1 (advance d 6000)))
      (assert-false (deal-auto d))
      (assert-false (deal-auto d1))
      (assert-false (game-all-up? ONE-DOWN))
      (assert-equal 1 (game-face-down-count ONE-DOWN))
      (assert-true (game-equal? ONE-DOWN (deal-game d1)))
      (assert-equal 0 (game-moves (deal-game d1)))))
  (test "stepped, the armed position empties the tableau into 4 x 13 and is won"
    (let loop ((d (restore ALL-UP)) (steps 0))
      (cond ((deal-won? d)
             (assert-true (< steps 2000))
             (let ((g (deal-game d)))
               (assert-true (every null? (vector->list (game-tableau g))))
               (assert-equal '() (game-stock g))
               (assert-equal '() (game-waste g))
               (assert-equal '(13 13 13 13) (map length (vector->list (game-foundations g))))
               (assert-equal MSG-WON (deal-message d))))
            ((> steps 2000) (assert-true #f))
            (else (loop (advance d AUTO-TICKS) (+ steps 1))))))
  (test "one step per AUTO-TICKS, none before"
    (let* ((d (restore ALL-UP))
           (d1 (advance d (- AUTO-TICKS 1)))
           (d2 (advance d1 1)))
      (assert-equal 0 (game-moves (deal-game d1)))
      (assert-equal 1 (game-moves (deal-game d2)))))
  (test "while it runs, a tap and undo are refused"
    (let* ((d (advance (restore ALL-UP) (* 3 AUTO-TICKS)))
           (tapped (deal-step d (make-input-frame '() '() (place-center geom (deal-game d) '(stock))) geom))
           (undone (deal-step d (make-input-frame '(backspace) '() #f) geom)))
      (assert-equal 3 (game-moves (deal-game d)))
      (assert-true (game-equal? (deal-game d) (deal-game tapped)))
      (assert-true (game-equal? (deal-game d) (deal-game undone)))
      (assert-equal '() (game-history (deal-game (restore ALL-UP))))))
  (test "the one-down position still plays by hand: its ace goes up on a double tap"
    (let* ((d (restore ONE-DOWN))
           (p '(pile 0 0))
           (d (deal-step d (make-input-frame '() '() (place-center geom (deal-game d) p)) geom))
           (d (deal-step d (make-input-frame '() '() (place-center geom (deal-game d) p)) geom)))
      (assert-equal 1 (length (game-foundation (deal-game d) 0)))
      (assert-false (deal-auto d)))))

(test-group "game-auto-step on its own"
  (test "sends a playable top to a foundation before drawing"
    (let ((g (game-auto-step ALL-UP)))
      (assert-equal 1 (length (game-foundation g 0)))
      (assert-equal 45 (length (game-stock g)))))
  (test "draws when no top fits"
    (let* ((g (game ALL-UP foundations: (vector (list (c 0 1)) '() '() '())
                    tableau: (vector '() (list (cons (c 1 5) #t)) '() '() '() '() '())))
           (g1 (game-auto-step g)))
      (assert-equal 1 (length (game-waste g1)))))
  (test "a won game is left alone"
    (let ((won (game ALL-UP
                     tableau: (make-vector PILES '())
                     stock: '()
                     foundations: (list->vector (map (lambda (s) (reverse (map (lambda (r) (c s r)) (iota 13 1)))) (iota 4))))))
      (assert-true (game-won? won))
      (assert-true (eq? won (game-auto-step won))))))
