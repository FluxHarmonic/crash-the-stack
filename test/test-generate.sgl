;;; Gate leg 1 - generation.
;;;
;;; For seeds 1..200 on the Turtle and on the tower-3 fixture: the generator
;;; succeeds, its recorded solution replays through board-select as a legal
;;; match at every step and empties the board, the fresh board has at least
;;; one legal match, and the same seed produces the same board twice.
;;; Every assertion carries its seed so a red names it.

(import (sigil test)
        (crash stack layout)
        (crash stack rules)
        (crash stack generate)
        (crash stack turtle)
        (crash stack fixtures))

(define SEEDS 200)

(define (seed-label prefix seed)
  (string-append prefix " seed " (number->string seed)))

(define (check-layout name lay)
  (let loop ((seed 1))
    (when (<= seed SEEDS)
      (let ((b (generate lay seed)))
        (test (seed-label (string-append name " generates") seed)
          (assert-true (board? b)))
        (when (board? b)
          (test (seed-label (string-append name " solution replays and clears") seed)
            (assert-equal #t (replay-solution b (board-solution b))))
          (test (seed-label (string-append name " fresh board has a legal match") seed)
            (assert-true (pair? (legal-matches b))))
          (test (seed-label (string-append name " same seed same board") seed)
            (assert-true (board-equal? b (generate lay seed))))))
      (loop (+ seed 1)))))

(test-group "generate: turtle"
  (check-layout "turtle" (turtle-layout)))

(test-group "generate: tower-3"
  (check-layout "tower-3" (tower-3-layout)))

(test-group "generate: faces"
  (let ((b (generate (turtle-layout) 1)))
    (test "every tile has a face"
      (assert-true (every (lambda (f) (and f (>= f 0) (< f FACE-COUNT)))
                          (vector->list (board-faces b)))))
    (test "each face appears four times"
      (let ((counts (make-vector FACE-COUNT 0)))
        (vector-for-each (lambda (f) (vector-set! counts f (+ 1 (vector-ref counts f))))
                         (board-faces b))
        (assert-true (every (lambda (n) (= n 4)) (vector->list counts)))))
    (test "different seeds differ"
      (assert-false (board-equal? b (generate (turtle-layout) 2))))))

;; --- the daemons (P3, the bible's section 3, ruled 2026-09-18) --------------
;; Faces 32..35 match each other and nothing else. The tower-3 fixture's
;; three flat tiles (slots 1, 2, 3 at layer 0, all playable) carry a hand
;; -set face each; the column (slots 0, 4, 5) is out of the way.
(define (flat-board f1 f2 f3)
  (board-new (tower-3-layout) (vector 0 f1 f2 f3 1 1)))

(test-group "generate: daemons"
  (test "the four daemon faces sit at 32..35"
    (assert-equal 32 DAEMON-FIRST)
    (assert-true (daemon-face? 32))
    (assert-true (daemon-face? 35))
    (assert-false (daemon-face? 31))
    (assert-false (daemon-face? #f)))
  (let loop ((seed 1))
    (when (<= seed 20)
      (let* ((b (generate (turtle-layout) seed))
             (faces (vector->list (board-faces b))))
        (test (seed-label "turtle carries every daemon" seed)
          (assert-true (every (lambda (d) (memv d faces)) '(32 33 34 35)))))
      (loop (+ seed 1))))
  (test "two daemons of different faces are a legal match and leave together"
    (let* ((b (flat-board 32 34 5))
           (after (board-select (board-select b 1) 2)))
      (assert-true (faces-match? b 1 2))
      (assert-true (and (member '(1 . 2) (legal-matches b)) #t))
      (assert-false (tile-present? after 1))
      (assert-false (tile-present? after 2))
      (assert-true (tile-present? after 3))))
  (test "a daemon beside a suit face is not a match: the second pick reselects"
    (let* ((b (flat-board 33 5 5))
           (after (board-select (board-select b 1) 2)))
      (assert-false (faces-match? b 1 2))
      (assert-false (member '(1 . 2) (legal-matches b)))
      (assert-true (tile-present? after 1))
      (assert-true (tile-present? after 2))
      (assert-equal 2 (board-selected after))))
  (test "legal-matches lists every cross-daemon pair once"
    (let ((b (flat-board 32 33 35)))
      (assert-equal '((1 . 2) (1 . 3) (2 . 3)) (legal-matches b))))
  (test "a daemon pair replays through the solution checker"
    (let ((b (flat-board 34 34 7)))
      (assert-equal 'not-cleared (replay-solution b '((1 . 2))))
      (assert-equal 1 (replay-solution (flat-board 34 7 7) '((1 . 2)))))))

;; A cross-daemon match leaves two daemon faces at odd counts; the
;; re-deal and the save both count the daemons as one face, so a shuffle
;; after such a match still deals (the hunt of the slice-2 review: it
;; raised "odd face count" before), and the board stays saveable.
(define (cross-daemon-match b)
  (let loop ((ms (legal-matches b)))
    (cond ((null? ms) #f)
          ((and (daemon-face? (tile-face b (car (car ms))))
                (daemon-face? (tile-face b (cdr (car ms))))
                (not (= (tile-face b (car (car ms))) (tile-face b (cdr (car ms))))))
           (car ms))
          (else (loop (cdr ms))))))

(define (first-cross-daemon-seed)
  (let loop ((seed 1))
    (cond ((> seed 200) #f)
          ((cross-daemon-match (generate (turtle-layout) seed)) seed)
          (else (loop (+ seed 1))))))

(test-group "generate: a cross-daemon match, then a shuffle"
  (let ((seed (first-cross-daemon-seed)))
    (test "some Turtle in seeds 1..200 opens with a cross-daemon match"
      (assert-true (and seed #t)))
    (when seed
      (let* ((b (generate (turtle-layout) seed))
             (m (cross-daemon-match b))
             (after (board-select (board-select b (car m)) (cdr m)))
             (dealt (reshuffle after)))
        (test (seed-label "the match leaves both daemon tiles" seed)
          (assert-equal 142 (board-tile-count after)))
        (test (seed-label "reshuffle after it deals a board (no odd-count refusal)" seed)
          (assert-true (board? dealt))
          (assert-false (eq? dealt after))
          (assert-equal 142 (board-tile-count dealt)))
        (test (seed-label "the re-dealt board keeps 14 daemon tiles and replays to empty" seed)
          (let ((daemons (let loop ((id 0) (n 0))
                           (if (= id (layout-slot-count (turtle-layout)))
                               n
                               (loop (+ id 1)
                                     (if (and (tile-present? dealt id) (daemon-face? (tile-face dealt id)))
                                         (+ n 1)
                                         n))))))
            (assert-equal 14 daemons))
          (assert-equal #t (replay-solution dealt (board-solution dealt))))))))
