# The title logo: CRASH / THE STACK in the blocky alphabet, the ramp down
# from the selection cyan to the highlight magenta (the bible's hero
# colors), a one-cell drop shadow in the darkest bar tone.
alphabet blocky
line CRASH
line THE STACK
width 80
align center
gap 1
rows A A 3 2 1 B
color-a C-SELECTED
color-b C-HIGHLIGHT
shadow 1 1
shadow-color C-BAR-C
shadow-glyph 2
