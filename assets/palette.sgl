;; Crash The Stack palette: the 32 slots of the style bible, section 1
;; (topics/crash-the-stack-style-bible, ruled D27). One datum: a list of
;; (ROLE "#RRGGBB" "what it is for"). Roles are the names scripts and the
;; game use; the hex is the truth for the art pipeline (scripts/art/palette
;; renders palette.png from it, scripts/art/shape snaps every generated
;; asset to it); (crash palette) carries the same colors as (r g b)
;; triples and test/test-palette.sgl asserts the two agree, hex-exact.
;; An alias shares a hex with an earlier role and costs no slot. Two
;; slots are in hand: the third became C-MOSS on 2026-09-19 (David, on the
;; living background: a yellow-green accent in the mix, "a new slot if
;; none fits"); the last two were D48's B2 layer tints for one day
;; (2026-09-20) and came back when David ruled E alone the depth cue.
((C-BG         "#0D0A1A" "board and page ground")
 (C-BAR-A      "#17122E" "copper bar, darkest")
 (C-BAR-B      "#21173D" "copper bar, middle")
 (C-BAR-C      "#2E1C4D" "copper bar, lightest; control fill")
 (C-FACE       "#DBE0E6" "tile face")
 (C-FACE-EDGE  "#FAFCFF" "tile top and left edge highlight")
 (C-SIDE       "#6B7085" "tile side face")
 (C-SIDE-DARK  "#3D4052" "tile side shadow")
 (C-SELECTED   "#4DF2D9" "selection ring; trace meter low")
 (C-HIGHLIGHT  "#FF59D9" "cursor ring, match flash")
 (C-TEXT       "#CCE6FF" "HUD text; every system line")
 (C-TEXT-DIM   "#7380A6" "secondary text, borders")
 (C-SUIT-0     "#1A73D9" "MEM glyphs (cold)")
 (C-SUIT-1     "#CC3340" "PWR glyphs (hot)")
 (C-SUIT-2     "#1A8C4D" "TX glyphs (hot)")
 (C-SUIT-3     "#8C40B3" "DSK glyphs (cold)")
 (C-HOT        "#F2731A" "hot packets PWR and TX; the encrypted veil")
 (C-COLD       "#1A73D9" "cold packets MEM and DSK (alias of C-SUIT-0)")
 (C-LABEL-LIT  "#FFCC33" "lit hint tags, STACK CRASHED, SYSTEM ONLINE")
 (C-LOCKED     "#9E5761" "strong lock face")
 (C-LOCK-WEAK  "#B89E5C" "weak lock face")
 (C-TRACE      "#4DF2D9" "meter low (alias of C-SELECTED)")
 (C-TRACE-HOT  "#FF5959" "meter near the threshold, countdown, TRACED")
 (C-DAEMON     "#F0F0F0" "the four wildcard daemon glyphs (P3)")
 (C-GIBSON     "#B36BFF" "Gibson's lines only (P3; reserved for D17)")
 (C-ICE        "#FF9F1A" "ICE toasts and the counter-hack flash (P3)")
 (C-STATIC-A   "#8A8FA0" "severed screen static, light (P3)")
 (C-STATIC-B   "#2A2D3A" "severed screen static, dark; packet back noise (P3)")
 (C-WIRE-LIT   "#4DF2D9" "live wire, PATCH/INTERCEPT later (alias of C-SELECTED)")
 (C-WIRE-DARK  "#1F3A4D" "dead wire, PATCH/INTERCEPT later")
 (C-ARCHIVE    "#5C4D8C" "CHECKSUM seal tint, later")
 (C-MOSS       "#4A5A2B" "the living background's yellow-green accent (P3, David 2026-09-19)")
 (IN-HAND-2    #f        "not to be spent before P5 (spent on D48's B2 tint 2026-09-20, returned when E was ruled)")
 (IN-HAND-3    #f        "not to be spent before P5 (spent on D48's B2 tint 2026-09-20, returned when E was ruled)"))
