;;; Pure bundled-pool export, copied into src only for the runner proof binary.
;;; Export actual player packets and archived difficulty metadata, no witness.

(define-library (crash checksum proof temporary)
  (import (sigil process)
          (sigil io)
          (crash stack rules)
          (crash checksum rules)
          (crash checksum pool))
  (export main checksum-pool-export-seed)
  (begin
    (define (checksum-pool-export-seed argument)
      (let ((seed (string->number argument)))
        (unless (and seed (integer? seed) (<= 1 seed (checksum-pool-size)))
          (error "CHECKSUM pool exporter needs a bundled seed" argument))
        (let ((b (checksum-pool-board seed)))
          (write (list 'deal (cboard-seed b)
                       (vector->list (board-faces (cboard-pyramid b)))
                       (cboard-stock b)))
          (newline)
          (flush-output-port (current-output-port))
          (write (cons 'pool-entry (cons seed (checksum-pool-metrics seed)))
                 (current-error-port))
          (newline (current-error-port))
          (flush-output-port (current-error-port)))))

    (define (main . ignored)
      (let ((arguments (cdr (command-line))))
        (when (null? arguments)
          (error "CHECKSUM pool exporter needs explicit seed arguments"))
        (for-each checksum-pool-export-seed arguments)))))
