;;; Export only deal state for the independent solver (no witness).
;;; Run on the runner with Sigil 0.22.10 and the task's source path.

(import (crash stack rules)
        (crash checksum rules)
        (crash checksum generate)
        (crash checksum solve)
        (sigil time))

;; Diagnostics go to stderr; stdout remains pure dealt states and never
;; includes a witness. Times here measure this evaluator, not web frames.
(define (milliseconds-since start)
  (/ (* 1000.0 (- (current-jiffy) start)) (jiffies-per-second)))

(define (measured-deal seed)
  (let ((g (checksum-gen-start seed)) (started (current-jiffy))
        (candidate-start #f))
    (let loop ()
      (when (eq? (checksum-gen-status g) 'running)
        (let ((s (checksum-gen-solver g)))
          (cond ((not s) (set! candidate-start (current-jiffy)))
                ((not (eq? (checksum-solve-status s) 'running))
                 (write (list 'candidate seed (checksum-gen-attempts g)
                              (checksum-solve-status s) (milliseconds-since candidate-start)
                              (checksum-solve-nodes s) (checksum-solve-failed s)
                              (checksum-solve-draws s) (checksum-solve-needed s))
                        (current-error-port))
                 (newline (current-error-port))))
          (checksum-gen-step! g)
          (loop))))
    (write (list 'accepted seed (milliseconds-since started) (checksum-gen-attempts g)
                 (checksum-gen-nodes g)) (current-error-port))
    (newline (current-error-port))
    (checksum-gen-result g)))

(let loop ((seed 1))
  (when (<= seed 256)
    (let ((b (measured-deal seed)))
      (unless b (error "CHECKSUM: generator failed" seed))
      (display "(deal ")
      (display seed)
      (display " ")
      (write (vector->list (board-faces (cboard-pyramid b))))
      (display " ")
      (write (cboard-stock b))
      (display ")")
      (newline))
    (loop (+ seed 1))))
