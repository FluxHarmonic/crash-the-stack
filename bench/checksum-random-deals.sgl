;;; Raw Fisher-Yates candidates: no construction, solver or witness ordering.
(import (crash cards deck))

(for-each
 (lambda (seed)
   (let ((cards (car (shuffled-deck seed))))
     (display (list 'deal seed
                    (map (lambda (id) (list-ref cards id)) (iota 28))
                    (map (lambda (id) (list-ref cards (+ id 28))) (iota 24))))
     (newline)))
 (map (lambda (id) (+ id 1)) (iota 500)))
