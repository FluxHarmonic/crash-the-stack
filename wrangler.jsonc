{
  // Cloudflare Pages project crashthestack.
  //
  // This file exists for one reason: the R2 binding the wasm Functions need
  // (functions/jack-in/w and functions/tracker/w, via web/r2-wasm.js). Declared
  // here, `wrangler pages deploy` applies it with the deployment, so the binding
  // travels with the code that depends on it instead of living only in a
  // dashboard setting nobody reads. The bucket itself is created once, by hand:
  // scripts/cloudflare-r2-setup (David runs it; a worker cannot).
  //
  // pages_build_output_dir is the tree scripts/stage-web builds, so the deploy
  // takes no directory argument.
  "name": "crashthestack",
  "pages_build_output_dir": "build/hosted-site",
  "compatibility_date": "2026-09-23",
  "r2_buckets": [
    {
      "binding": "WASM",
      "bucket_name": "crashthestack-wasm"
    }
  ]
}
