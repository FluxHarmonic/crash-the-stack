# Cloudflare Pages headers (ruling D12: Pages takes a _headers file). The
# audio bridge's AudioWorklet path needs the page cross-origin isolated;
# sw.js adds the same headers from the second visit on, this file from
# the first. Every resource is same-origin, so require-corp blocks nothing.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
