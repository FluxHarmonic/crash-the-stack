# Cloudflare Pages headers (ruling D12: Pages takes a _headers file). The
# audio bridge's AudioWorklet path needs the page cross-origin isolated;
# sw.js adds the same headers from the second visit on, this file from
# the first. Every resource is same-origin, so require-corp blocks nothing.
# P4b: the game is /jack-in/ and the tracker /tracker/; the site's own
# pages at the root carry no isolation headers (they need none).
/jack-in/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
/tracker/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# /version.json says which version is current and what its News post said
# about it. The game fetches it to decide whether to offer an update, so a
# cached copy would go on announcing an old release after a new one shipped,
# or keep offering an update the player already took. It is small; fetch it
# fresh every time.
/version.json
  Cache-Control: no-cache
